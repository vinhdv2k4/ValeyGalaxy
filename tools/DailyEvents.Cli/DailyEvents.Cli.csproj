<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Runtime/DailyEvents/DailyEventCalendar.cs" Link="DailyEventCalendar.cs" />
    <Compile Include="../../Assets/Scripts/Runtime/Cutscenes/Event*.cs;../../Assets/Scripts/Runtime/Cutscenes/CutsceneRunner.cs"
             Link="Cutscenes/%(Filename)%(Extension)" />
    <Content Include="../../Assets/Resources/DailyEvents/Calendar.json" Link="Calendar.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../Assets/Resources/Cutscenes/Milestones.json" Link="Milestones.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
