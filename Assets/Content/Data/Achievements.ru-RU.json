{
  "0": "\u041D\u043E\u0432\u0438\u0447\u043E\u043A (15 \u0442\u044B\u0441)^\u0417\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C 15 000 \u0437.^true^-1^18",
  "1": "\u0420\u0430\u0431\u043E\u0442\u044F\u0433\u0430 (50 \u0442\u044B\u0441)^\u0417\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C 50 000 \u0437.^true^0^21",
  "2": "\u0412\u043B\u0430\u0434\u0435\u043B\u0435\u0446 \u0445\u043E\u0437\u044F\u0439\u0441\u0442\u0432\u0430 (250 \u0442\u044B\u0441)^\u0417\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C 250 000 \u0437.^true^1^20",
  "3": "\u041C\u0438\u043B\u043B\u0438\u043E\u043D\u0435\u0440 (1 \u043C\u043B\u043D)^\u0417\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C 1 000 000 \u0437.^true^2^1",
  "4": "\u041B\u0435\u0433\u0435\u043D\u0434\u0430 (10 \u043C\u043B\u043D)^\u0417\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C 10 000 000 \u0437.^false^-1^3",
  "5": "\u041F\u043E\u043B\u043D\u0430\u044F \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u044F^\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u044E \u043C\u0443\u0437\u0435\u0439\u043D\u044B\u0445 \u044D\u043A\u0441\u043F\u043E\u043D\u0430\u0442\u043E\u0432.^true^28^0",
  "6": "\u041D\u043E\u0432\u044B\u0439 \u0434\u0440\u0443\u0433^\u0414\u043E\u0441\u0442\u0438\u0433\u043D\u0443\u0442\u044C \u0441 \u043A\u0435\u043C-\u043D\u0438\u0431\u0443\u0434\u044C \u0443\u0440\u043E\u0432\u043D\u044F \u0434\u0440\u0443\u0436\u0431\u044B \u0432 5 \u0441\u0435\u0440\u0434\u0435\u0447\u0435\u043A.^true^-1^14",
  "7": "\u041B\u0443\u0447\u0448\u0438\u0435 \u0434\u0440\u0443\u0437\u044C\u044F^\u0414\u043E\u0441\u0442\u0438\u0433\u043D\u0443\u0442\u044C \u0441 \u043A\u0435\u043C-\u043D\u0438\u0431\u0443\u0434\u044C \u0443\u0440\u043E\u0432\u043D\u044F \u0434\u0440\u0443\u0436\u0431\u044B \u0432 10 \u0441\u0435\u0440\u0434\u0435\u0447\u0435\u043A.^true^6^31",
  "9": "\u041D\u0430\u0448 \u043B\u044E\u0431\u0438\u043C\u044B\u0439 \u0444\u0435\u0440\u043C\u0435\u0440^\u0414\u043E\u0441\u0442\u0438\u0433\u043D\u0443\u0442\u044C \u0443\u0440\u043E\u0432\u043D\u044F \u0434\u0440\u0443\u0436\u0431\u044B \u0432 10 \u0441\u0435\u0440\u0434\u0435\u0447\u0435\u043A \u0441 8 \u043B\u044E\u0434\u044C\u043C\u0438.^true^7^32",
  "11": "\u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043C\u044B \u2014 \u0431\u0430\u043D\u0434\u0430!^\u0414\u043E\u0441\u0442\u0438\u0433\u043D\u0443\u0442\u044C \u0443\u0440\u043E\u0432\u043D\u044F \u0434\u0440\u0443\u0436\u0431\u044B \u0432 5 \u0441\u0435\u0440\u0434\u0435\u0447\u0435\u043A \u0441 4 \u043B\u044E\u0434\u044C\u043C\u0438.^true^6^26",
  "12": "\u0421\u0432\u044F\u0437\u0438^\u0414\u043E\u0441\u0442\u0438\u0433\u043D\u0443\u0442\u044C \u0443\u0440\u043E\u0432\u043D\u044F \u0434\u0440\u0443\u0436\u0431\u044B \u0432 5 \u0441\u0435\u0440\u0434\u0435\u0447\u0435\u043A \u0441 10 \u043B\u044E\u0434\u044C\u043C\u0438.^true^11^25",
  "13": "\u041F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u044C^\u0414\u043E\u0441\u0442\u0438\u0433\u043D\u0443\u0442\u044C \u0443\u0440\u043E\u0432\u043D\u044F \u0434\u0440\u0443\u0436\u0431\u044B \u0432 5 \u0441\u0435\u0440\u0434\u0435\u0447\u0435\u043A \u0441 20 \u043B\u044E\u0434\u044C\u043C\u0438.^true^12^11",
  "15": "\u041F\u043E\u0432\u0430\u0440^\u041F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C 10 \u0440\u0430\u0437\u043D\u044B\u0445 \u0431\u043B\u044E\u0434.^true^18^12",
  "16": "\u0421\u0443-\u0448\u0435\u0444^\u041F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C 25 \u0440\u0430\u0437\u043D\u044B\u0445 \u0431\u043B\u044E\u0434.^true^15^7",
  "17": "\u0428\u0435\u0444-\u043F\u043E\u0432\u0430\u0440^\u041F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u043A\u0430\u0436\u0434\u043E\u0435 \u0438\u0437 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0445 \u0431\u043B\u044E\u0434.^true^16^35",
  "18": "\u0417\u0430\u0436\u0438\u0432\u0435\u043C!^\u0420\u0430\u0441\u0448\u0438\u0440\u0438\u0442\u044C \u0441\u0432\u043E\u0439 \u0434\u043E\u043C.^true^-1^13",
  "19": "\u041A\u0440\u0430\u0441\u0438\u0432\u0430\u044F \u0436\u0438\u0437\u043D\u044C^\u0420\u0430\u0441\u0448\u0438\u0440\u0438\u0442\u044C \u0441\u0432\u043E\u0439 \u0434\u043E\u043C \u0434\u043E \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0440\u0430\u0437\u043C\u0435\u0440\u0430.^true^18^15",
  "20": "\u0421\u0434\u0435\u043B\u0430\u0439 \u0441\u0430\u043C^\u0421\u043C\u0430\u0441\u0442\u0435\u0440\u0438\u0442\u044C 15 \u0440\u0430\u0437\u043D\u044B\u0445 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432.^true^-1^29",
  "21": "\u0423\u043C\u0435\u043B\u0435\u0446^\u0421\u043C\u0430\u0441\u0442\u0435\u0440\u0438\u0442\u044C 30 \u0440\u0430\u0437\u043D\u044B\u0445 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432.^true^20^16",
  "22": "\u0417\u043E\u043B\u043E\u0442\u044B\u0435 \u0440\u0443\u043A\u0438^\u0421\u043C\u0430\u0441\u0442\u0435\u0440\u0438\u0442\u044C \u043A\u0430\u0436\u0434\u044B\u0439 \u0438\u0437 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0445 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432.^true^21^23",
  "24": "\u0420\u044B\u0431\u043E\u043B\u043E\u0432^\u0412\u044B\u043B\u043E\u0432\u0438\u0442\u044C 10 \u0440\u044B\u0431 \u0440\u0430\u0437\u043D\u043E\u0433\u043E \u0432\u0438\u0434\u0430.^true^-1^28",
  "25": "\u0421\u0442\u0430\u0440\u044B\u0439 \u043C\u043E\u0440\u0435\u0445\u043E\u0434^\u0412\u044B\u043B\u043E\u0432\u0438\u0442\u044C 24 \u0440\u044B\u0431\u044B \u0440\u0430\u0437\u043D\u043E\u0433\u043E \u0432\u0438\u0434\u0430.^true^24^5",
  "26": "\u041C\u0430\u0441\u0442\u0435\u0440 \u0440\u044B\u0431\u043D\u043E\u0439 \u043B\u043E\u0432\u043B\u0438^\u0412\u044B\u043B\u043E\u0432\u0438\u0442\u044C \u0432\u0441\u0435 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0435 \u0432\u0438\u0434\u044B \u0440\u044B\u0431.^true^25^24",
  "27": "\u0412\u043E\u0442 \u044D\u0442\u043E \u0443\u043B\u043E\u0432!^\u0412\u044B\u043B\u043E\u0432\u0438\u0442\u044C 100 \u0440\u044B\u0431.^true^64^30",
  "28": "\u0421\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u043D\u0438\u0446\u0430^\u041F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u0432 \u043C\u0443\u0437\u0435\u0439 40 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432.^true^-1^6",
  "29": "\u041A\u0443\u0440\u044C\u0435\u0440^\u0412\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C 10 \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u0439 \u0441 \u0434\u043E\u0441\u043A\u0438 \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u0439.^true^-1^22",
  "30": "\u0414\u043E\u0431\u0440\u0430\u044F \u0434\u0443\u0448\u0430^\u0412\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C 40 \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u0439 \u0441 \u0434\u043E\u0441\u043A\u0438 \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u0439.^true^29^10",
  "31": "\u0421\u0435\u0432\u043E\u043E\u0431\u043E\u0440\u043E\u0442^\u041E\u0442\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u043D\u0430 \u0440\u044B\u043D\u043E\u043A \u043F\u043E 15 \u0435\u0434. \u0443\u0440\u043E\u0436\u0430\u044F \u043A\u0430\u0436\u0434\u043E\u0439 \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u044B.^true^-1^34",
  "32": "\u041C\u043E\u043D\u043E\u043A\u0443\u043B\u044C\u0442\u0443\u0440\u0430^\u041E\u0442\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u043D\u0430 \u0440\u044B\u043D\u043E\u043A 300 \u0435\u0434. \u0443\u0440\u043E\u0436\u0430\u044F \u043E\u0434\u043D\u043E\u0439 \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u044B.^true^-1^33",
  "34": "\u041C\u0430\u0441\u0442\u0435\u0440 \u043F\u043E\u0441\u0442\u0430\u0432\u043E\u043A^\u041E\u0442\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u043D\u0430 \u0440\u044B\u043D\u043E\u043A \u043A\u0430\u0436\u0434\u044B\u0439 \u0438\u0437 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0445 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432.^true^-1^9",
  "40": "\u0414\u0430\u043B\u0435\u043A\u0438\u0439 \u0431\u0435\u0440\u0435\u0433^\u0414\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0434\u043E \u0418\u043C\u0431\u0438\u0440\u043D\u043E\u0433\u043E \u043E\u0441\u0442\u0440\u043E\u0432\u0430.^false^-1^9",
  "35": "\u041A\u043D\u0438\u0436\u043D\u044B\u0439 \u0447\u0435\u0440\u0432\u044C^\u041F\u0440\u043E\u0447\u0435\u0441\u0442\u044C \u0432\u0441\u0435 \u043A\u043D\u0438\u0433\u0438.^true^-1^9",
  "36": "\u0414\u0432\u0430 \u043F\u0430\u043B\u044C\u0446\u0430 \u0432\u0432\u0435\u0440\u0445^\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043A\u0438\u043D\u043E.^false^-1^9",
  "37": "\u0413\u043E\u043B\u0443\u0431\u0430\u044F \u043B\u0435\u043D\u0442\u0430^\u0417\u0430\u043D\u044F\u0442\u044C \u043F\u0435\u0440\u0432\u043E\u0435 \u043C\u0435\u0441\u0442\u043E \u043D\u0430 \u042F\u0440\u043C\u0430\u0440\u043A\u0435 \u0414\u043E\u043B\u0438\u043D\u044B \u0421\u0442\u0430\u0440\u0434\u044C\u044E.^true^-1^9",
  "38": "\u041D\u0435\u0437\u0430\u0431\u044B\u0432\u0430\u0435\u043C\u044B\u0439 \u0441\u0443\u043F^\u041F\u043E\u0440\u0430\u0434\u043E\u0432\u0430\u0442\u044C \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430.^true^-1^9",
  "39": "\u0414\u043E\u0431\u0440\u044B\u0435 \u0441\u043E\u0441\u0435\u0434\u0438^\u041F\u043E\u043C\u043E\u0447\u044C \u0441\u0432\u043E\u0438\u043C \u043B\u0435\u0441\u043D\u044B\u043C \u0441\u043E\u0441\u0435\u0434\u044F\u043C \u0432\u044B\u0440\u0430\u0441\u0442\u0438\u0442\u044C \u0441\u0435\u043C\u044C\u044E.^true^-1^9",
  "41": "\u041E\u043F\u0430\u0441\u043D\u044B\u0435 \u0433\u043B\u0443\u0431\u0438\u043D\u044B^\u0421\u043F\u0443\u0441\u0442\u0438\u0442\u044C\u0441\u044F \u043D\u0430 \u0434\u043D\u043E \u00AB\u043E\u043F\u0430\u0441\u043D\u044B\u0445\u00BB \u0448\u0430\u0445\u0442.^false^-1^9",
  "42": "\u0411\u0435\u0437\u0443\u0434\u0435\u0440\u0436\u043D\u0430\u044F \u0441\u0438\u043B\u0430^\u0417\u0430\u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0441\u0430\u043C\u043E\u0435 \u043C\u043E\u0449\u043D\u043E\u0435 \u043E\u0440\u0443\u0436\u0438\u0435.^true^-1^9",
  "44": "\u0421\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u043E^\u041F\u043E\u0434\u043D\u044F\u0442\u044C\u0441\u044F \u043D\u0430 \u0432\u0435\u0440\u0448\u0438\u043D\u0443.^false^-1^9"
