  "22": "\uC548\uB155\uD558\uC2E0\uAC00, @...^^\uC5B4\uB450\uC6B4 \uD130\uB110\uC5D0 \uC788\uB294 \uB0B4 \u0027\uBE44\uBC00\u0027\uC740 \uCC3E\uC558\uB098?^^\uB9CC\uB098\uB294 \uB0A0\uC744 \uAE30\uB300\uD558\uACE0 \uC788\uB124!^^    -\uCE58",
  "23": "^^^\uC774\uAC70\uC2AC \uC77C\uAE00\uC218 \uC774\uB530\uBA74... \uBE44\uC774\uBBF8\uB808 \uC218\uD504\uB85C \uC640\uB77C. \uBA54\uC774-\uD314 \uC138\uB7FD \uAC00\uC838\uC640\uC8FC\uC0C8\uC694. ^^^",
  "24": "M. \uC7AC\uC2A4\uD37C\uC758 \uCC45 \uD55C \uD398\uC774\uC9C0 \uC785\uB2C8\uB2E4:^^...\u0022\uC232\uC758 \uC815\uB839\u0022 \uD639\uC740 \u0022\uC8FC\uB2C8\uBAA8\u0022\uB77C \uC54C\uB824\uC9C4 \uC0DD\uBA85\uCCB4\uB4E4\uC740 \uBC84\uB824\uC9C0\uACE0 \uD5C8\uB984\uD574\uC9C4 \uAC74\uBB3C\uC5D0 \uCD9C\uBAB0\uD558\uB294 \uAC83\uC73C\uB85C \uC54C\uB824\uC838 \uC788\uB2E4.^^\uC77C\uBC18\uC801\uC73C\uB85C... \uC778\uAC04\uB4E4\uC774 \uB5A0\uB098\uACE0, \uC790\uC5F0\uC774 \uC790\uC2E0\uC758 \uC601\uC5ED\uC744 \uB2E4\uC2DC \uCC28\uC9C0\uD558\uAE30 \uC2DC\uC791\uD560 \uB54C, \uC758\uC2EC\uD560 \uC5EC\uC9C0\uC5C6\uC774 \uC8FC\uB2C8\uBAA8\uB3C4 \uB4F1\uC7A5\uD55C\uB2E4.^^\uBBFC\uC18D \uC0AC\uC0C1\uC5D0 \uC758\uD558\uBA74 \uC8FC\uB2C8\uBAA8\uB294 \uADF8\uB4E4\uC758 \uC791\uC740 \uC624\uB450\uB9C9\uC5D0 \uB193\uC778 \uBCF4\uC11D\uC5D0 \uC5B4\uB5A0\uD55C \uACF5\uBA85\uD558\uB294 \uCE5C\uC5F0\uC131\uC774 \uC788\uB2E4\uACE0 \uD55C\uB2E4...^^\uBB3C\uB860, \uC774 \uBAA8\uB4E0 \uC774\uC57C\uAE30\uB294 \uBBFF\uAE30 \uC5B4\uB824\uC6B4, \uAC80\uC99D\uB418\uC9C0 \uC54A\uC740 \uCD9C\uCC98\uB85C\uBD80\uD130 \uC628\uB2E4... \uB0B4\uAC00 \uC54C\uAE30\uB85C\uB294, \uC774 \uC0DD\uBA85\uCCB4\uB4E4\uC758 \uC874\uC7AC\uC870\uCC28 \uC785\uC99D\uB41C \uC801\uC774 \uC5C6\uB2E4!",
  "25": "^^ \uC5C4\uB9C8\uD55C\uD14C \uBAA9\uAC78\uC774\uB97C \u0027\uBE4C\uB838\uB294\uB370\u0027, \uC628\uCC9C \uADFC\uCC98\uC5D0\uC11C \uC783\uC5B4\uBC84\uB838\uC5B4... \uC5C6\uC5B4\uC84C\uB2E4\uB294 \uC0AC\uC2E4\uC744 \uC54C\uC544\uCC28\uB9AC\uC2DC\uBA74 \uC5C4\uCCAD \uD654\uB0B4\uC2E4\uAC70\uC57C!",
  "26": "\uACE0\uB300 \uB18D\uC791 \uBE44\uBC00, 37\uD589:^^\uAC74\uD3EC\uB3C4\uB97C \uBA39\uC740 \uC8FC\uB2C8\uBAA8\uB9CC\uD07C \uB3C4\uC6C0\uC774 \uB418\uB294 \uAC83\uC740 \uC5C6\uB2E4...^^",
  "27": "\uC0AC\uB791\uD558\uB294 \uB0B4 \uC190\uC8FC\uC5D0\uAC8C,^\uB124\uAC00 \uC774 \uBA54\uBAA8\uB97C \uBC1C\uACAC\uD560 \uB54C\uBA74, \uC774\uBBF8 \uACC4\uACE1\uC5D0\uC11C \uC624\uB798 \uC9C0\uB0C8\uACA0\uAD6C\uB098. \uC798 \uC9C0\uB0B4\uACE0 \uC788\uAE38 \uBC14\uB780\uB2E4!^\uB124\uAC00 \uB18D\uC7A5\uC5D0\uC11C \uC6B0\uB9AC \uAC00\uBB38\uC758 \uC804\uD1B5\uC744 \uC774\uC5B4\uB098\uAC00\uC918\uC11C \uC790\uB791\uC2A4\uB7FD\uB2E4, \uADF8\uB9AC\uACE0 \uADF8 \uB178\uB825\uC744 \uD1B5\uD574 \uB354 \uB9CE\uC740 \uC0DD\uBA85\uACFC \uD48D\uC694\uAC00 \uC2A4\uD0C0\uB4C0 \uBC38\uB9AC \uC804\uC5ED\uC5D0 \uD37C\uC9C0\uACA0\uC9C0... \uB0B4 \uB9C8\uC74C\uC18D \uC18C\uC911\uD55C \uADF8\uACF3\uC5D0.^\uAFB8\uC900\uD788 \uD798\uB0B4\uAC70\uB77C!^^-\uD560\uC544\uBC84\uC9C0^^\uCD94\uC2E0 ...\uB108\uB97C \uC704\uD574 \uD2B9\uBCC4\uD55C \uBE44\uBC00\uC744 \uACC4\uACE1 \uC5B4\uB518\uAC00\uC5D0 \uC228\uACA8\uB1A8\uB2E8\uB2E4. \uB0B4\uAC00 \uBC1C\uACAC\uD55C \uCD5C\uACE0\uC758 \uC9C0\uC2DD\uC744 \uBAA8\uC544\uB193\uC740 \uD558\uB098\uC758 \uC694\uC57D\uBCF8\uC774\uB77C \uD560 \uC218 \uC788\uACA0\uAD6C\uB098. \uC5B8\uC820\uAC00 \uB124\uAC00 \uC900\uBE44\uAC00 \uB41C\uB2E4\uBA74, \uCC3E\uAC8C \uB420 \uAC8C\uB2E4.",
  "1001": "1\uC77C\uC9F8^^...\uBC30\uB97C \uC783\uC5C8\uB2E4... \uC790\uBE44 \uC5C6\uB294 \uBC14\uB2E4\uC758 \uD3ED\uD48D\uC5D0 \uC758\uD574 \uC0B0\uC0B0\uC870\uAC01 \uB098\uBC84\uB838\uB2E4.^^\uD45C\uB958\uD558\uB2E4 \uB0AF\uC120 \uD574\uBCC0\uC5D0 \uB3C4\uCC29\uD588\uB2E4. \uB0B4 \uC120\uC6D0\uB4E4\uC740 \uBE44\uBA85\uD6A1\uC0AC\uD588\uC9C0\uB9CC, \uB098\uB294 \uC0B4\uC544\uB0A8\uC558\uB2E4. \uD589\uC6B4\uC758 \uC5EC\uC2E0\uC774 \uC8C4 \uB9CE\uC740 \uB098\uB97C \uCD95\uBCF5\uD558\uC2E0 \uAC83\uC778\uAC00... \uC544\uB2C8\uBA74 \uB098\uB97C \uC704\uD55C \uADF8\uB140\uB9CC\uC758 \uC124\uACC4\uAC00 \uC788\uB294 \uAC83\uC77C\uAE4C...^^\uC5B4\uCC0C\uB418\uC5C8\uAC74, \uC5EC\uAE30\uC11C \uC0C8 \uC0B6\uC744 \uC0B4\uC544\uC57C \uD55C\uB2E4. \uB2F4\uC218\uAC00 \uD48D\uBD80\uD558\uACE0 \uCC44\uC9D1\uD560 \uBA39\uAC70\uB9AC\uC640 \uBE44\uC625\uD55C \uD1A0\uC9C0\uAC00 \uC788\uC5B4 \uB2E4\uD589\uC774\uC9C0.^^\uC6B0\uC120\uC740 \uC8FC\uAC70\uC9C0\uB97C \uC124\uB9BD\uD574\uC57C\uACA0\uB2E4...^^(\uBA87\uBA87 \uD398\uC774\uC9C0\uAC00 \uBE60\uC838\uC788\uC2B5\uB2C8\uB2E4)",
  "1002": "6\uC77C\uC9F8^^\uAD76\uC744 \uC77C\uC740 \uC5C6\uC744 \uAC83 \uAC19\uB2E4... \uBB3C\uAC00\uC5D0\uB294 \uBA39\uC744\uB9CC\uD55C (\uC544\uB2C8, \uC815\uB9D0 \uB9DB\uC788\uB294!) \uC0DD\uC120\uC73C\uB85C \uAC00\uB4DD\uD558\uB2E4.^^\uB0A8\uB3D9\uCABD \uD574\uBCC0 \uADFC\uCC98 \uB3D9\uAD74\uC5D0\uC11C\uB294 \uC2EC\uC9C0\uC5B4 \uAC00\uC624\uB9AC\uB3C4 \uC7A1\uC558\uB2E4. \uC774\uAC78 \uC5B4\uB5BB\uAC8C \uD574\uC57C \uD560\uC9C0\uB294 \uC798 \uBAA8\uB974\uACA0\uC9C0\uB9CC!^^\uC800\uBC88\uC5D0\uB294 \uD669\uAE08 \uD638\uB450\uB3C4 \uBA87 \uAC1C \uB09A\uC558\uB2E4. \uC628 \uC12C\uC5D0 \uC790\uB77C\uACE0 \uC788\uB358\uB370, \uC575\uBB34\uC0C8\uB4E4\uC774 \uD2B9\uD788 \uC88B\uC544\uD558\uB294 \uAC83 \uAC19\uB2E4!",
  "1003": "14\uC77C\uC9F8^^\uC774 \uC12C\uC5D0\uC11C\uC758 \uC0DD\uD65C\uC744 2\uC8FC\uC529 \uD558\uBA74\uC11C \uD669\uAE08 \uD638\uB450\uB97C \uCC3E\uB294 \uBC95\uC744 \uC880 \uC775\uD78C \uAC83 \uAC19\uB2E4.^^\uC791\uC740 \uB2E8\uC11C\uB3C4 \uB193\uCE58\uC9C0 \uC54A\uB3C4\uB85D \uC8FC\uC758\uB97C \uAE30\uC6B8\uC5EC\uC57C \uD55C\uB2E4. \uBB34\uC5B8\uAC00 \uD2B9\uC774\uD574 \uBCF4\uC778\uB2E4\uBA74 \uADFC\uCC98\uC5D0 \uD638\uB450\uAC00 \uC788\uC744 \uC218 \uC788\uB2E4.^^\uBAA8\uB798\uC5D0\uB3C4 \uB2E8\uC11C\uAC00 \uBCF4\uC774\uACE0, \uB098\uBB47\uC78E\uC5D0\uB3C4 \uB2E8\uC11C\uAC00 \uBCF4\uC778\uB2E4...^^\uC2EC\uC9C0\uC5B4 \uD654\uC0B0 \uADFC\uCC98\uC758 \uB098\uBB34 \uC704\uC5D0 \uC788\uB294 \uD638\uB450\uB3C4 \uBCF4\uC558\uB2E4. \uC3F4\uC11C \uB5A8\uC5B4\uD2B8\uB9B4 \uBC29\uBC95\uB9CC \uC788\uC5C8\uB354\uB77C\uBA74...^^\uC9C0\uAE08\uAE4C\uC9C4 \uD638\uB450\uAC00 \uBCF4\uC774\uBA74 \uC5B4\uB5BB\uAC8C\uB4E0 \uC190\uC5D0 \uB123\uC744 \uC218 \uC788\uC5C8\uB2E4.",
  "1004": "!image 10",
  "1005": "23\uC77C\uC9F8^^\uC774 \uC12C\uC758 \uD654\uC0B0\uC5D0\uB294 \uB9CE\uC740 \uBE44\uBC00\uC774 \uC228\uACA8\uC838\uC788\uB2E4.^^\uC5B4\uB460 \uC18D\uC744 \uD669\uAE09\uD788 \uC6C0\uC9C1\uC774\uB294, \uB208\uC5D0\uC11C \uBE5B\uC774 \uB098\uB294 \uC791\uC740 \uC0AC\uB78C\uB4E4\uC744 \uBCF4\uC558\uB2E4... \uD55C\uBC24\uC911\uC758 \uACE0\uC591\uC774 \uAC19\uB2E4.^^(\uC774\uAC8C M. \uC7AC\uC2A4\uD37C\uC758 \uCC45 \u0027\uC720\uBA85\uD55C \uC5EC\uC815\u0027\uC5D0 \uB4F1\uC7A5\uD55C, \uC598\uAE30\uB85C\uB9CC \uB4E3\uB358 \uB4DC\uC6CC\uD504\uB4E4\uC77C\uAE4C?)^^\uC774\uC0C1\uD55C \uAE30\uACC4\uB4E4\uB3C4 \uBCF4\uC558\uB2E4. \uAE30\uBB18\uD55C \uC77C\uC774\uC57C... \uB4E3\uB3C4 \uBCF4\uB3C4 \uBABB\uD55C \uAE30\uACC4\uB4E4\uC774\uB2E4.^^\uAF2D\uB300\uAE30\uC5D0\uB294 \uD654\uC0B0\uC758 \uCE7C\uB370\uB77C\uB85C \uAC00\uB294 \uD1B5\uB85C\uB97C \uCC3E\uC558\uB2E4. \uBD80\uAE00\uAC70\uB9AC\uB294 \uC6A9\uC554\uC758 \uD55C\uAC00\uC6B4\uB370\uC5D0\uB294 \uC815\uB9D0 \uD2B9\uC774\uD55C... \uBB34\uC2A8 \u0022\uB300\uC7A5\uAC04\u0022 \uAC19\uC740 \uAC8C \uBCF4\uC600\uB2E4. ^^\uB0B4\uC77C \uB354 \uC870\uC0AC\uD574\uBD10\uC57C\uACA0\uB2E4.",
  "1006": "!image 8",
  "1007": "--\uC7AC\uB828 \uBAA9\uB85D--^^\uD1A0\uD30C\uC988 -- \uBC29\uC5B4\uB825^\uC5D0\uBA54\uB784\uB4DC -- \uC18D\uB3C4^\uC625 -- \uCE58\uBA85\uD0C0 \uC704\uB825^\uC544\uCFE0\uC544\uB9C8\uB9B0 -- \uCE58\uBA85\uD0C0 \uD655\uB960^\uC790\uC218\uC815 -- \uBC00\uCE58\uAE30^\uB8E8\uBE44 -- \uD53C\uD574^^\uBB34\uC9C0\uAC2F\uBE5B \uD30C\uD3B8 -- \uC778\uCC48\uD2B8^^\uBA54\uBAA8: \uBB34\uAE30\uB294 3\uBC88\uAE4C\uC9C0 \uC7AC\uB828\uD560 \uC218 \uC788\uACE0, \uBCC4\uB3C4\uB85C \uBB34\uC9C0\uAC2F\uBE5B \uD30C\uD3B8\uC73C\uB85C 1\uBC88 \uC778\uCC48\uD2B8\uD560 \uC218 \uC788\uB2E4.^^\uB3C4\uAD6C\uB294 \uC778\uCC48\uD2B8\uB9CC \uAC00\uB2A5\uD558\uB2E4, \uC7AC\uB828\uC740 \uC548\uB41C\uB2E4.",
  "1008": "--\uBB34\uAE30 \uC778\uCC48\uD2B8--^^\uAE30\uC220\uC790: \u0022\uD2B9\uC218 \uAE30\uC220\u0022\uC744 \uB354 \uBE60\uB974\uAC8C \uC0AC\uC6A9\uD560 \uC218 \uC788\uB2E4.^^\uC0B4\uCDA9: \uBC8C\uB808 \uBAAC\uC2A4\uD130\uC5D0\uAC8C \uB354 \uD070 \uD53C\uD574\uB97C \uC785\uD78C\uB2E4.^^\uD761\uD608: \uAC00\uB054 \uBAAC\uC2A4\uD130\uC5D0\uAC8C \uCCB4\uB825\uC744 \uD6D4\uCCD0 \uC628\uB2E4.^^\uC131\uC804\uC0AC: \u0022\uBD88\uACBD\uD55C\u0022 \uBAAC\uC2A4\uD130\uC5D0\uAC8C \uD53C\uD574\uB97C \uB354 \uB9CE\uC774 \uC785\uD78C\uB2E4.^^\uAC74\uCD08\uAE30: \uC7A1\uCD08\uB97C \uC790\uB97C \uB54C \uC12C\uC720\uB97C \uB354 \uB9CE\uC774 \uD68D\uB4DD\uD558\uACE0, \uAC00\uB054 \uAC74\uCD08\uB3C4 \uD68D\uB4DD\uD55C\uB2E4.^^--\uB3C4\uAD6C \uC778\uCC48\uD2B8--^^\uAC15\uB825: \uB3C4\uAD6C\uAC00 \uB3CC\uACFC \uB098\uBB34\uB97C \uB354 \uC27D\uAC8C \uD30C\uAD34\uD55C\uB2E4.^^\uBC94\uC704 \uC99D\uAC00: \uCDA9\uC804 \uB2A5\uB825\uC744 \uAC15\uD654\uD574\uC11C \uB354 \uB113\uC740 \uBC94\uC704\uC5D0 \uB3C4\uAD6C\uB97C \uC4F8 \uC218 \uC788\uB2E4.^^\uBC8C\uBAA9\uAE30: \uBC8C\uBAA9\uD560 \uB54C \uCD94\uAC00\uC801\uC778 \uB098\uBB34\uB97C \uD68D\uB4DD\uD560 \uC218 \uC788\uB2E4.^^\uBB34\uD55C: \uBB3C\uBFCC\uB9AC\uAC1C\uC758 \uBB3C\uC774 \uB9C8\uB974\uC9C0 \uC54A\uB294\uB2E4.^^\uD48D\uBD80: \uB545\uC744 \uD314 \uB54C \uB354 \uB9CE\uC740 \uAC83\uC744 \uC5BB\uB294\uB2E4.^^\uACE0\uACE0\uD559\uC790: \uC720\uBB3C\uACFC \uBF08\uB97C \uC5BB\uC744 \uD655\uB960\uC774 \uB298\uC5B4\uB09C\uB2E4.^^\uD6A8\uC728: \uC0AC\uC6A9\uD558\uB294\uB370 \uAE30\uB825\uC774 \uC18C\uBAA8\uB418\uC9C0 \uC54A\uB294\uB2E4.^^\uC2E0\uC18D: \uB3C4\uAD6C\uB97C \uB354 \uBE68\uB9AC \uD718\uB450\uB984.^^\uB9C8\uC2A4\uD130: \uB09A\uC2DC \uB808\uBCA8 \uC99D\uAC00.^^\uC790\uB3D9 \uB09A\uC2DC \uBC14\uB298: \uBB3C\uACE0\uAE30\uAC00 \uBB3C\uBA74 \uC790\uB3D9\uC73C\uB85C \uB2F9\uAE40.^^\uBCF4\uC874: \uBBF8\uB07C\uC640 \uB09A\uC2DC\uB3C4\uAD6C\uAC00 50% \uD655\uB960\uB85C \uC18C\uBAA8\uB418\uC9C0 \uC54A\uC74C.",
  "1009": "\uBE44\uAC00 \uC3DF\uC544\uC9C0\uB358 \uC5B4\uB290 \uB0A0, \uC678\uB85C\uC6B4 \uBC14\uC704 \uC704 \uC544\uB984\uB2E4\uC6B4 \uC5EC\uC778\uC744 \uBCF4\uC558\uB2E4^^\uBC14\uB2E4\uC5D0\uC11C \uB09C, \uC138\uC774\uB80C \uB178\uB798\uB97C \uBD80\uB974\uB294 \uC5EC\uC778\uB4E4 \uC774\uC57C\uAE30\uB294 \uB4E4\uC5C8\uC73C\uB098,^\uC774 \uC5EC\uC778\uC740 \uC544\uBB34 \uC18C\uB9AC\uB3C4 \uB0B4\uC9C0 \uBABB\uD588\uB2E4...^^\uB2E4\uC74C\uB0A0 \uBC14\uB2E4 \uAC70\uD488\uC5D0 \uB4A4\uB36E\uC778 \uD574\uBCC0\uC5D0 \uACE0\uC774 \uC815\uB3C8\uB41C \uC870\uC57D\uB3CC \uC5EC\uB7FF\uC744 \uBCF4\uC558\uB2E4...^-----------------^\uADF8\uB807\uB2E4... \uB3D9\uC804\uB9CC \uD55C, \uC190\uD1B1\uB9CC \uD55C \uB3CC\uC774\uC5C8\uC9C0...^-----------------^\uD5C8\uB098, \uC774 \uACE4\uB780\uC5D0 \uBE60\uC9C4 \uBC43\uC0AC\uB78C\uC774 \uB178\uB798 \uD558\uB098 \uC6B8\uBD80\uC9D6\uB294\uB2E4\uBA74, \uAC80\uC740\uAC08\uB9E4\uAE30\uC758 \uBCF4\uBB3C\uB85C \uAC00\uB294 \uAE38\uC744 \uC54C\uB824\uC92C\uC744\uC9C0\uB3C4...",
  "1010": "!image 9",
  "1011": "37\uC77C\uC9F8^^\uB0B4\uAC00 10\uC0B4\uCBE4 \uB418\uC5C8\uC744 \uB54C, \uC544\uBC84\uC9C0\uAED8\uC11C \uBE5B \uBC18\uC9C0\uC640 \uC790\uC11D \uBC18\uC9C0\uB97C \uC8FC\uC168\uC5C8\uB2E4. \uBC1B\uC740 \uD6C4\uB85C \uD55C \uBC88\uB3C4 \uB0B4 \uC190\uC744 \uB5A0\uB09C \uC801\uC774 \uC5C6\uC5C8\uB294\uB370...^^\uADF8\uB7F0\uB370... \uD654\uC0B0 \uAF2D\uB300\uAE30\uC5D0 \uC11C \uC788\uC744 \uB54C \uBB54\uAC00 \uC774\uC0C1\uD55C \uC0DD\uAC01\uC774 \uB4E4\uC5C8\uB2E4.^^\uBC18\uC9C0 \uB450 \uAC1C\uB97C \uADF8\uB300\uB85C \uB300\uC7A5\uAC04\uC5D0 \uB358\uC838 \uB123\uC5C8\uC9C0.^^\uADF8\uB7AC\uB354\uB2C8 \uB450 \uBC18\uC9C0\uAC00 \uD558\uB098\uB85C \uD569\uCCD0\uC84C\uB2E4!^^\uC774\uC81C \uBE5B\uB098\uB294 \uC790\uC11D \uBC18\uC9C0\uAC00 \uC0DD\uACBC\uC9C0... \uC544\uBC84\uC9C0\uAC00 \uBCC4\uB85C \uC2E0\uACBD \uC548 \uC4F0\uC168\uC73C\uBA74 \uC88B\uACA0\uB294\uB370..."
}