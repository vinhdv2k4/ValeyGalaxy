{
  "1": "\uC560\uBE44\uAC8C\uC77C\uC758 \uC77C\uAE30\uC7A5 \uD55C \uD398\uC774\uC9C0\uC785\uB2C8\uB2E4.^^\u0027\uB0B4\uAC00 \uC0AC\uB791\uD558\uB294 \uAC83\uB4E4: \uAE4E\uC544\uB0B8 \uD638\uBC15 \uB0C4\uC0C8, \uBCA0\uAC1C \uBC11\uC5D0 \uB454 \uC790\uC218\uC815, \uCD08\uCF5C\uB9BF \uCF00\uC774\uD06C, \uB9E4\uCF64\uD55C \uC7A5\uC5B4\uC758 \uC2A4\uB9B4, \uADF8\uB9AC\uACE0 \uC5C4\uB9C8\uAC00 \uD574\uC8FC\uC2E0 \uBE14\uB799\uBCA0\uB9AC \uCF54\uBE14\uB7EC\uAC00 \uC8FC\uB294 \uD3B8\uC548\uD568 (\uBA39\uB294 \uAC8C \uC88B\uC740 \uAC78!)\u0027%revealtaste:Abigail:276%revealtaste:Abigail:66%revealtaste:Abigail:220%revealtaste:Abigail:226%revealtaste:Abigail:611",
  "2": "\uC0D8\uC758 \uCD95\uC81C \uAE30\uAC04 \uC1FC\uD551 \uBAA9\uB85D\uC785\uB2C8\uB2E4^^\uAC01\uC790 \uC88B\uC544\uD558\uB294 \uAC83\uB4E4^^\uC138\uBC14\uC2A4\uCC2C: \uC5BC\uC5B4\uBD99\uC740 \uB208\uBB3C, \uD68C^\uD398\uB2C8: \uC5D0\uBA54\uB784\uB4DC, \uC591\uADC0\uBE44^\uBE48\uC13C\uD2B8: \uD3EC\uB3C4, \uD06C\uB79C\uBCA0\uB9AC \uCE94\uB514^\uC5C4\uB9C8: \uB18D\uC5B4 \uD280\uAE40, \uD32C\uCF00\uC774\uD06C^\uC544\uBE60: \uB9AC\uC870\uB610, \uAD6C\uC6B4 \uD5E4\uC774\uC990\uB11B^\uB098: \uC120\uC778\uC7A5, \uBA54\uC774\uD50C \uBC14, \uD53C\uC790%revealtaste:Sebastian:84%revealtaste:Sebastian:227%revealtaste:Penny:60%revealtaste:Penny:376%revealtaste:Vincent:398%revealtaste:Vincent:612%revealtaste:Jodi:214%revealtaste:Jodi:211%revealtaste:Kent:649%revealtaste:Kent:607%revealtaste:Sam:90%revealtaste:Sam:731%revealtaste:Sam:206",
  "3": "\uB808\uC544\uC758 \uAE00\uC528\uCCB4\uC785\uB2C8\uB2E4^^\uB0B4\uAC00 \uC0DD\uAC01\uD558\uB294 \uC644\uBCBD\uD55C \uC800\uB141\uC2DD\uC0AC\uB294 \uC0D0\uB7EC\uB4DC, \uC5FC\uC18C \uCE58\uC988, \uADF8\uB9AC\uACE0 \uC640\uC778\uC774\uC57C. \uB514\uC800\uD2B8\uB85C\uB294 \uC591\uADC0\uBE44\uC528 \uBA38\uD540. \uC74C! \uB204\uAD70\uAC00 \uB0B4\uAC8C \uC774\uB7F0 \uAC83\uB4E4\uC744 \uC900\uB2E4\uBA74, \uB09C \uB179\uC544\uBC84\uB9B4 \uAC70\uC57C.%revealtaste:Leah:196%revealtaste:Leah:426%revealtaste:Leah:430%revealtaste:Leah:348%revealtaste:Leah:651",
  "4": "\uB9C8\uB8E8\uAC00 \uC4F4 \uCABD\uC9C0\uC785\uB2C8\uB2E4^^\uB0B4 \uCD5C\uACE0\uC758 \uBC1C\uBA85\uD488\uC744 \uC704\uD574 \uD544\uC694\uD55C \uAC83\uB4E4!^^*\uAE08\uAD34^*\uC774\uB9AC\uB4D0 \uC8FC\uAD34^*\uBC30\uD130\uB9AC \uD329^*\uB2E4\uC774\uC544\uBAAC\uB4DC^*\uB538\uAE30%revealtaste:Maru:336%revealtaste:Maru:337%revealtaste:Maru:787%revealtaste:Maru:72%revealtaste:Maru:400",
  "5": "\uD398\uB2C8\uC758 \uAE00\uC528\uCCB4\uB85C \uC801\uD600\uC788\uC2B5\uB2C8\uB2E4:^^\uB2E4\uB4E4 \uC0AC\uB791\uD558\uB294 \uAC83\uC744 \uC8FC\uACE0 \uC2F6\uC5B4!^^\uC5C4\uB9C8: \uD30C\uC2A4\uB2D9, \uB9DB\uD0D5. \uB9E5\uC8FC\uB294 \uC548\uB3FC!^\uC7AC\uC2A4: \uC694\uC815\uC7A5\uBBF8, \uC790\uB450 \uD478\uB529^\uBE48\uC13C\uD2B8: \uD551\uD06C \uCF00\uC774\uD06C, \uD3EC\uB3C4^\uBB3C\uB108 \uC544\uC800\uC528: \uB9AC\uD06C, \uBC84\uC12F\uAD6C\uC774^\uBB3C\uB108 \uD560\uBA38\uB2C8: \uC0AC\uD0D5\uBB34, \uD2A4\uB9BD%revealtaste:Pam:24%revealtaste:Pam:208%revealtaste:Pam:346%revealtaste:Jas:595%revealtaste:Jas:604%revealtaste:Vincent:398%revealtaste:Vincent:221%revealtaste:George:20%revealtaste:George:205%revealtaste:Evelyn:284%revealtaste:Evelyn:591",
  "6": "\uBCC4\uBC29\uC6B8 \uC8FC\uC810 \uD2B9\uBCC4 \uC8FC\uBB38^^\uB8E8\uC774\uC2A4 \uC2DC\uC7A5\uB2D8: \uAC00\uC744\uC758 \uC218\uD655^(\uC0AC\uC774\uB4DC\uB85C \uC12C\uC720\uC9C8 \uB9CE\uC740 \uBE75 \uB450 \uBC30\uB85C)^^\uB9C8\uB2C8: \uD638\uBC15 \uD30C\uC774^(\uD718\uD551\uD06C\uB9BC \uCD94\uAC00!)^^\uB4DC\uBBF8\uD2B8\uB9AC\uC6B0\uC2A4: \uCF69 \uC2A4\uD29C^(\uB354 \uB9F5\uAC8C)^^\uCE90\uB864\uB77C\uC778: \uC0DD\uC120 \uD0C0\uCF54^(\uC18C\uC2A4 \uC138\uBC30\uB85C! \uB0C5\uD0A8\uB3C4 \uCD94\uAC00\uD574\uC57C\uACA0\uAD70...)%revealtaste:Lewis:235%revealtaste:Marnie:608%revealtaste:Demetrius:207%revealtaste:Caroline:213",
  "7": "\uB204\uAD70\uAC00\uC758 \uC77C\uAE30\uC7A5 \uD55C \uD398\uC774\uC9C0\uC785\uB2C8\uB2E4...^^...\uB9C8\uC744\uC5D0 \u0027\uB098\uC774 \uC880 \uC788\uB294\u0027 \uC2F1\uAE00 \uB0A8\uC790\uB3C4 \uBA87 \uC548 \uB418\uC9C0\uB9CC, \uC644\uBCBD\uD55C \uC0AC\uB78C\uB3C4 \uC5C6\uC5B4! \uD558\uBE44\uB294 \uC880 \uCD08\uC870\uD558\uACE0 \uC57D\uD574 \uBCF4\uC5EC\uB3C4, \uCDA9\uC2E4\uD558\uACE0 \uB3C5\uC2E4\uD55C \uB0A8\uD3B8\uC774 \uB420 \uAC70\uB780 \uAC74 \uC54C\uC544. \uCEE4\uD53C\uB791 \uD53C\uD074\uC744 \uC88B\uC544\uD55C\uB2E4\uC9C0.^^\uC5D8\uB9AC\uC5C7\uC740 \uC880 \uBA4B \uBD80\uB9AC\uACE0 \uACFC\uC7A5\uB41C \uBA74\uC774 \uC788\uC9C0\uB9CC, \uD131\uC740 \uCC38 \uC88B\uC544. \uAC8C\uC0B4 \uCF00\uC774\uD06C\uB791 \uC11D\uB958\uB97C \uC88B\uC544\uD558\uACE0.^^\uC170\uC778\uC740 \uC9C0\uC800\uBD84\uD558\uACE0 \uBC18\uC0AC\uD68C\uC801\uC774\uC57C. \uD558\uC9C0\uB9CC \uADF8 \uAC70\uCE5C \uBAA8\uC2B5\uC774 \uBC29\uC5B4 \uAE30\uC81C \uAC19\uC544, \uB0B4\uBA74\uC758 \uBD80\uB4DC\uB7EC\uC6C0\uC744 \uC228\uAE30\uB824\uB294. \uB9E5\uC8FC, \uD53C\uC790, \uADF8\uB9AC\uACE0 \uD398\uD37C \uD30C\uD37C\uB97C \uC88B\uC544\uD558\uC9C0.%revealtaste:Harvey:395%revealtaste:Harvey:342%revealtaste:Elliott:732%revealtaste:Elliott:637%revealtaste:Shane:346%revealtaste:Shane:206%revealtaste:Shane:215",
  "8": "^\uD5E4\uC77C\uB9AC\uC640 \uC5D0\uBC00\uB9AC\uC5D0\uAC8C^^\uB458\uC774 \uC798 \uC9C0\uB0B4\uACE0 \uC788\uB2C8? \uB108\uD76C\uB4E4\uC774 \uC81C\uC77C \uC88B\uC544\uD558\uB294 \uC120\uBB3C\uC744 \uBCF4\uB0C8\uB2E8\uB2E4: \uD5E4\uC77C\uB9AC\uB97C \uC704\uD574\uC120 \uD551\uD06C \uCF00\uC774\uD06C\uC640 \uD574\uBC14\uB77C\uAE30, \uC5D0\uBC00\uB9AC\uB97C \uC704\uD574\uC120 \uBCF4\uC11D\uACFC \uC591\uD138!^^-\uC0AC\uB791\uD558\uB294 \uC5C4\uB9C8 \uC544\uBE60\uAC00%revealtaste:Haley:221%revealtaste:Haley:421%revealtaste:Emily:440%revealtaste:Emily:66%revealtaste:Emily:62%revealtaste:Emily:60%revealtaste:Emily:70%revealtaste:Emily:64%revealtaste:Emily:68",
  "9": "\uC54C\uB809\uC2A4\uC758 \uADFC\uB825 \uD2B8\uB808\uC774\uB2DD \uC2DD\uB2E8:^^*\uC644\uBCBD\uD55C \uC544\uCE68^*\uC5F0\uC5B4 \uC815\uCC2C^^(\uC2AC\uC2AC \uC774 \uC74C\uC2DD\uB4E4\uC774 \uC88B\uC544\uC9C0\uB294\uAC78... \uB2E8\uBC31\uC9C8\uC774 \uB290\uAEF4\uC838!!)%revealtaste:Alex:201%revealtaste:Alex:212",
