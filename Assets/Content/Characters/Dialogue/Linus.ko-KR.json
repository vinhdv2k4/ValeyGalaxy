  "Sat": "\uB098 \uD63C\uC790\uC11C\uB3C4 \uCDA9\uBD84\uD788 \uD589\uBCF5\uD558\uB124.#$e#\uC0C8\uB85C\uC6B4 \uCE5C\uAD6C\uB294 \uD544\uC694 \uC5C6\uC5B4.",
  "Sun4": "\uB9C8\uC744 \uC8FC\uBBFC\uB4E4\uC774 \uB098\uB97C \uC788\uB294 \uADF8\uB300\uB85C \uBC1B\uC544\uB4E4\uC600\uC73C\uBA74 \uC88B\uC744 \uD150\uB370.$s#$b#\uB09C \uC774\uB807\uAC8C \uC57C\uC678\uC5D0\uC11C \uC9C0\uB0B4\uB294 \uAC8C \uC88B\uC544. \uADF8\uB4E4\uC774 \uADF8\uAC78 \uC774\uD574\uD558\uC9C0 \uBABB\uD558\uB294 \uAC83 \uAC19\uB124.",
  "Tue4": "\uC57C\uC0DD\uC5D0\uC120 \uC0DD\uC874\uD558\uB294 \uBC95\uC744 \uBC30\uC6B8 \uC218 \uC788\uC9C0. \uB0B4\uAC00 \uADF8\uB7AC\uC5B4.#$e#\uC6B0\uB9AC \uBAA8\uB450 \uC790\uC5F0\uC73C\uB85C \uB3CC\uC544\uAC00\uACE0\uD508 \uC228\uACA8\uC9C4 \uCDA9\uB3D9\uC774 \uC788\uB294 \uAC83 \uAC19\uB124. \uB2E8\uC9C0 \uC774\uD589\uD558\uB294 \uAC83\uC774 \uC5B4\uB824\uC6B8 \uBFD0\uC774\uC9C0.",
  "Wed6": "\uB09C \uC0DD\uAC01\uD558\uB294 \uB370 \uC2DC\uAC04\uC744 \uB9CE\uC774 \uC4F0\uC9C0.#$e#\uB124\uAC00 \uD558\uB294 \uC0DD\uAC01\uC758 \uADFC\uAC70\uB97C \uC644\uC804\uD788 \uC774\uD574\uD560 \uC218 \uC788\uAC8C \uB41C\uB2E4\uBA74, \uC0C8\uB85C\uC6B4 \uC874\uC7AC\uC758 \uC218\uC900\uC5D0 \uB3C4\uB2EC\uD558\uAC8C \uB41C\uAC78\uC138.",
  "Wed2": "\uB09C \uB0AF\uC120 \uC774\uB97C \uACBD\uACC4\uD574\uC57C \uD558\uB124. \uB300\uBD80\uBD84 \uC0AC\uB78C\uB4E4\uC740 \u0027\uC57C\uC0DD \uC0AC\uB78C\u0027\uC744 \uBCC4\uB85C \uB2EC\uAC00\uC6CC\uD558\uC9C4 \uC54A\uAC70\uB4E0.",
  "Thu4": "\uC5EC\uAE30 \uC0AC\uB78C\uB4E4\uC740 \uCC29\uD574 \uBCF4\uC774\uC9C0\uB9CC, \uB098\uB97C \uD53C\uD574 \uB2E4\uB2CC\uB2E4\uB124.#$e#\uC0AC\uB78C\uB4E4\uC740 \uBBF8\uC9C0\uC758 \uAC83\uB4E4\uC744 \uB450\uB824\uC6CC\uD558\uC9C0.$u",
  "Fri4": "\uB098\uBB34\uB85C\uBD80\uD130 \uB9CE\uC740 \uAC83\uC744 \uBC30\uC6B8 \uC218 \uC788\uC9C0.#$b#\uC2DC\uAC04\uC744 \uC880 \uBCF4\uB0B4\uBA74 \uB098\uBB34\uB4E4\uC774 \uB124\uAC8C \uBE44\uBC00\uC744 \uC54C\uB824\uC904 \uC218\uB3C4 \uC788\uC5B4.#$e#\uD3C9\uD654\uB97C \uD488\uACE0 \uAC00\uAC8C\uB098, \uC80A\uC740\uC774\uC5EC.",
  "Sat4": "\uB09C \uC0B4\uC544\uAC00\uAE30 \uC704\uD574 \uD544\uC694\uD55C \uAC83\uB4E4 \uC774\uC0C1\uC73C\uB85C \uAC00\uC9C0\uACE0 \uC788\uC9C0. \uB4E3\uB294 \uBC95\uB9CC \uBC30\uC6B4\uB2E4\uBA74 \uB300\uC790\uC5F0\uC740 \uACBD\uC774\uB85C\uC6B4 \uC120\uC728\uC744 \uB4E4\uB824\uC8FC\uACE0 \uC788\uB2E4\uB124.",
  "Sun": "#$1 linusVandal#\uB204\uAD70\uAC00 \uC5B4\uC82F\uBC24 \uB0B4 \uD150\uD2B8\uC5D0 \uB3CC\uC744 \uB358\uC9C0\uACE0 \uC788\uC5C8\uB124... \uB09C \uADF8\uC800 \uAE30\uB2E4\uB9AC\uB294 \uC218\uBC16\uC5D0 \uC5C6\uC5C8\uC9C0.$s$k#$e#\uD55C \uACF3\uC5D0 \uB108\uBB34 \uC624\uB798 \uBA38\uBB34\uB974\uB294 \uAC74 \uC2EB\uB124. \uC138\uC0C1\uC5D0 \uACBD\uD5D8\uD560 \uAC83\uC774 \uB108\uBB34 \uB9CE\uC544.",
  "summer_Mon4": "\uC5EC\uB7EC \uD574 \uC0B4\uC544\uAC00\uBA70 \uC778\uC0DD\uC758 \uBA87\uBA87 \uBE44\uBC00\uB4E4\uC744 \uBC1C\uACAC\uD588\uB124.#$e#\uC790\uB124\uB3C4 \uC9C1\uC811 \uC54C\uC544\uB0B4\uBD10\uC57C \uD560 \uAC70\uC57C.",
  "summer_Mon": "#$1 LinusHeron#\uD669\uC0C8\uAC00 \uC6B0\uC544\uD558\uAC8C \uC544\uCE68 \uC548\uAC1C\uB97C \uD5E4\uCE58\uACE0 \uB098\uC544\uAC00\uB294 \uAC83\uC744 \uBCF4\uC558\uB124. \uC870\uC6A9\uD55C \uC0B6\uC758 \uBCF4\uBB3C\uB4E4\uC774\uB780 \uC774\uB7F0 \uAC70\uC9C0.$k#$e#\uD604\uB300\uC801\uC778 \uC0B6\uC758 \uC18C\uC74C\uC5D0 \uD729\uC2F8\uC774\uAE30\uB294 \uCC38 \uC26C\uC6CC. \uCD5C\uACE0\uC758 \uC2DC\uAC04\uC744 \uB69C\uB837\uD55C \uD615\uCCB4 \uC5C6\uC774 \uD750\uB9BF\uD558\uAC8C \uBCF4\uB0B4\uBC84\uB9AC\uB294 \uC218\uAC00 \uC788\uC5B4. \uADF8\uB798\uC11C \uB290\uAE0B\uD574\uC9C0\uB294 \uBC95\uC744 \uBC30\uC6CC\uC57C \uD558\uB294 \uAC78\uC138. ",
  "summer_Tue4": "\uC798 \uC9C0\uB0C8\uB294\uAC00, \uB0B4 \uC80A\uC740 \uCE5C\uAD6C?",
  "summer_Wed6": "\uC544... \uC5EC\uB984. \uD0DC\uC591\uC758 \uC5F4\uAE30\uAC00 \uD1B5\uC870\uB9BC\uC744 \uB370\uC6CC\uC8FC\uC9C0.#$b#\uADF8\uB7FC \uBC24\uC5D0\uB3C4 \uB530\uB048\uD55C \uC2DD\uC0AC\uB97C \uAE30\uB300\uD560 \uC218 \uC788\uB124.",
  "summer_Thu4": "\uB0B4\uAC00 \uC774\uB807\uAC8C \uD63C\uC790 \uC0AC\uB294 \uB370\uB294 \uB098\uB9CC\uC758 \uC774\uC720\uAC00 \uC788\uB2E4\uB124.#$e#\uBA87\uBA87 \uC0AC\uC2E4\uC740 \uC598\uAE30\uD558\uC9C0 \uC54A\uB294 \uD3B8\uC774 \uB098\uC544...#$e#\uB09C \uCC44\uC9D1 \uC880 \uD558\uB7EC \uAC00\uC57C\uACA0\uB124.",
  "summer_Fri4": "\uC0DD\uC120\uC744 \uC7A1\uB294\uB2E4\uBA74, \uADF8 \uD76C\uC0DD\uC744 \uACE0\uB9C8\uC6CC\uD560 \uC2DC\uAC04\uC744 \uC7A0\uC2DC \uAC00\uC9C0\uAC8C\uB098.#$b#\uC0DD\uC120\uC758 \uD63C\uC774 \uC874\uC7AC\uD558\uC9C0 \uC54A\uB294\uB2E4 \uBBFF\uC5B4\uB3C4, \uC88B\uC740 \uC815\uC2E0\uC801 \uD6C8\uB828\uC77C\uC138. \uC6B0\uB9AC\uB294 \uC6B0\uB9AC\uAC00 \uD658\uACBD\uC5D0 \uB07C\uCE58\uB294 \uC601\uD5A5\uC5D0 \uB300\uD574 \uC790\uAC01\uD558\uACE0 \uC788\uC5B4\uC57C \uD574.",
  "summer_Sat4": "\uC9C0\uAE08 \uAC1C\uC6B8\uC5D0\uC11C \uBB34\uC9C0\uAC1C \uC1A1\uC5B4\uB97C \uCC3E\uC744 \uC218 \uC788\uB2E4\uB124.",
  "summer_Sun": "\uC77C \uB144 \uC911 \uC694\uC998\uC774 \uB09C \uC880 \uC218\uC6D4\uD558\uB2E4\uB124. \uB530\uB73B\uD558\uAC8C \uC9C0\uB0B4\uB294 \uB370 \uAC71\uC815\uC774 \uC5C6\uC73C\uB2C8.#$e#\uCD94\uAC00\uB85C, \uC57C\uC0DD\uC758 \uACFC\uC77C\uB4E4\uC774 \uC5EC\uAE30\uC800\uAE30 \uC790\uB77C\uACE0 \uC788\uB2E4\uB124.",
  "fall_Mon": "\uB3D9\uAD74 \uAE4A\uC740 \uACF3\uC744 \uD0D0\uD5D8\uD574\uBD24\uB2E4\uB124.#$e#\uC228\uACA8\uC9C4 \uBE44\uBC00\uC744 \uAC04\uC9C1\uD558\uACE0 \uC788\uB354\uAD70.#$e#\uB2E4\uB9CC, \uB4E4\uC5B4\uAC08 \uC0DD\uAC01\uC774\uB77C\uBA74 \uC870\uC2EC\uD558\uAC8C.",
  "fall_Tue4": "#$1 LinusFall1#\uC6C3\uAE30\uB294 \uB140\uC11D\uC774 \uBC24\uC0AC\uC774 \uB0B4 \uC9D1\uC5D0 \uD398\uC778\uD2B8\uB97C \uC794\uB729 \uBFCC\uB838\uB124... \uC544\uCE68\uC5D0 \uB2E6\uC544\uB0B4\uB290\uB77C \uBA87 \uC2DC\uAC04\uC529 \uAC78\uB838\uC5B4.$k#$e#\uACA8\uC6B8\uC744 \uB098\uAE30 \uC704\uD574 \uBAA9\uC7AC\uB97C \uBAA8\uC544\uC57C\uACA0\uB124.#$e#\uC790\uB124\uB294 \uC9D1\uC744 \uB530\uB73B\uD558\uAC8C \uB370\uC6B8 \uB9CC\uD07C \uBAA9\uC7AC\uAC00 \uCDA9\uBD84\uD55C\uAC00?",
  "fall_Wed4": "\uB0B4\uAC00 \uCC45\uC784\uC838\uC57C \uD560 \uAC83\uC774 \uB9CE\uC9C0 \uC54A\uC544\uC11C, \uB9CE\uC740 \uC2DC\uAC04\uC744 \uC0DD\uAC01\uD558\uBA70 \uBCF4\uB0B4\uB124.#$e#\uC6B0\uC120 \uC790\uC2E0\uC758 \uC0DD\uAC01\uC744 \uC774\uD574\uD574\uC57C \uB2E4\uC2A4\uB9B4 \uC218 \uC788\uB294 \uAC78\uC138.",
  "fall_Sun": "\uD55C \uACF3\uC5D0 \uB108\uBB34 \uC624\uB798 \uBA38\uBB34\uB974\uB294 \uAC74 \uC2EB\uB124.",
  "fall_Sun6": "\uAC00\uC744\uCCA0\uC758 \uC57C\uC0DD \uBC84\uC12F\uC73C\uB85C \uCC28\uB9B0 \uB9CC\uCC2C\uB9CC \uD55C \uAC8C \uC5C6\uC9C0.$h",
  "winter_Mon": "\uD150\uD2B8\uC5D0\uC11C \uC9C0\uB0B4\uBCF4\uBA74 \uC815\uB9D0 \uCD94\uC6CC\uC9C0\uB294 \uACBD\uC6B0\uB3C4 \uC788\uB124.$s",
  "winter_Mon4": "\uD604\uB300\uC778\uC758 \uC0B6\uC5D0\uC11C \uC644\uC804\uD788 \uBC97\uC5B4\uB09C\uB2E4\uBA74 \uC791\uC740 \uC77C\uC5D0\uB3C4 \uD070 \uAE30\uC068\uC744 \uB290\uB084 \uC218 \uC788\uC744 \uAC78\uC138... \uD587\uBE5B, \uC798 \uC775\uC740 \uACFC\uC77C \uD558\uB098, \uD639\uC740 \uB531 \uD544\uC694\uD558\uB358 \uBAA8\uC591\uC758 \uB098\uBB47\uAC00\uC9C0\uB97C \uCC3E\uB294 \uC77C\uC774\uB77C\uB358\uAC00.",
  "winter_Tue4": "\uB0A0 \uD53C\uD558\uC9C0 \uC54A\uC544\uC11C \uACE0\uB9D9\uB124, @. \uAE30\uBCF8\uC801\uC778 \uBCF8\uB2A5\uC744 \uADF9\uBCF5\uD558\uB824\uBA74 \uB9CE\uC740 \uC9C0\uD61C\uAC00 \uD544\uC694\uD558\uC9C0.#$e#\uB098\uB3C4 \uB0A8\uB4E4\uACFC \uAC19\uC740 \uC0AC\uB78C\uC77C\uC138. \uADF8\uB0E5 \uC0B6\uC758 \uBC29\uC2DD\uC774 \uB2E4\uB97C \uBFD0\uC774\uC9C0.",
  "winter_Wed4": "\uB0B4\uAC00 \uC65C \uB0AF\uC120 \uC0AC\uB78C\uC744 \uACBD\uACC4\uD558\uB294\uC9C0 \uC790\uB124\uB3C4 \uBD84\uBA85 \uC774\uD574\uD560 \uAC70\uB77C \uBBFF\uB124.#$e#\uD558\uC9C0\uB9CC \uADF8\uAC74 \uACFC\uAC70\uC5D0 \uBB3B\uC5B4\uB450\uC790\uACE0, \uC54C\uACA0\uB098? \uC790\uB124\uC640 \uB09C \uC774\uC81C \uCE5C\uAD6C\uC77C\uC138, \uB0B4\uAC00 \uC0DD\uAC01\uD558\uAE30\uB860.",
  "winter_Thu4": "\uACA8\uC6B8\uC740 \uD798\uB4E0 \uC2DC\uAE30\uC9C0\uB9CC, \uC0B4\uC544\uB0A8\uAE30 \uC704\uD574 \uB09A\uC2DC\uC640 \uCC44\uC9D1\uC744 \uD558\uBA74 \uB418\uB124.#$e#\uD639\uC2DC \uB3D9\uBB3C\uC744 \uAE30\uB974\uACE0 \uC788\uB2E4\uBA74 \uC2E4\uB0B4\uC5D0 \uB450\uAC8C\uB098.",
  "winter_Fri4": "\uACA8\uC6B8\uC5D0\uB294 \uB098\uBB34\uB4E4\uC774 \uC7A0\uC794\uB2E4\uB124. \uADF8\uB798\uC11C \uC774\uACF3\uB3C4 \uC880 \uC678\uB85C\uC6CC\uC9C0\uC9C0.#$e#\uADF8\uB798\uB3C4 \uADF8\uB4E4\uB3C4 \uCDA9\uBD84\uD788 \uC218\uBA74\uC744 \uCDE8\uD574\uC57C \uD558\uB2C8 \uC5B4\uCA4C\uACA0\uB098.$h",
  "winter_Sat4": "\uB4E4\uB7EC\uC918\uC11C \uACE0\uB9D9\uB124. \uC0AC\uC2E4 \uC624\uB298 \uC544\uCE68 \uC880 \uC678\uB85C\uC6B4 \uB290\uB08C\uC774 \uB4E4\uC5C8\uC5C8\uB124.#$e#\uADF8\uB798, \uAD11\uC0B0\uC5D0\uC11C \uD765\uBBF8\uB85C\uC6B4 \uAC74 \uC880 \uBC1C\uACAC\uD588\uB098?",
  "winter_Sun": "\uBC14\uB2E5\uC5D0\uC11C \uC790\uB294 \uAC8C \uB0B4 \uD5C8\uB9AC\uC5D0 \uC544\uC8FC \uC88B\uB2E4\uB124.#$e#\uD56D\uC0C1 \uAE0D\uC815\uC801\uC778 \uCE21\uBA74\uC744 \uBCF4\uB294 \uAC8C \uC88B\uC544.$h"
}