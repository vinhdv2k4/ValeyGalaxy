  "mineArea_80": "\uC790\uB124\uB9CC\uD07C \uD3D0\uAD11\uC5D0 \uAE4A\uC774 \uB4E4\uC5B4\uAC04 \uC0AC\uB78C\uB3C4 \uB4DC\uBB3C\uC9C0.",
  "eventSeen_8357109": "\uC774\uACF3 \uBB3C\uC740 \uB192\uC740 \uC0B0\uC758 \uBE59\uD558\uC5D0\uC11C \uD758\uB7EC\uB0B4\uB824\uC624\uC9C0.#$e#\uC9C1\uC811 \uADF8\uACF3\uAE4C\uC9C0 \uC62C\uB77C\uAC00 \uBCF8 \uC801\uC774 \uC788\uB2E4\uB124, \uBB3C\uC5D0 \uC608\uB97C \uD45C\uD558\uAE30 \uC704\uD574\uC11C.",
