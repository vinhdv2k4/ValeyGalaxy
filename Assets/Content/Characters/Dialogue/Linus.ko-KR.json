  "MovieInvitation": "\uC624... \uB098\uB791? \uC774\uB7F0 \uAC74 \uC548 \uAC00\uB294 \uD3B8\uC774\uC9C0\uB9CC... \uADF8\uB798. \uB0A0 \uC0DD\uAC01\uD574 \uC918\uC11C \uACE0\uB9D9\uB124.#$b#\uC870\uAE08 \uC788\uB2E4 \uAC70\uAE30\uC11C \uBCF4\uC790\uACE0.",
  "DumpsterDiveComment": "\uBB50 \uAD1C\uCC2E\uC740 \uAC70 \uCC3E\uC558\uB098?$h",
