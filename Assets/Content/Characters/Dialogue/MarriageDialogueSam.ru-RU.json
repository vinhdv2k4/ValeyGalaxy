{
  "Rainy_Day_0": "\u0425\u043E\u0440\u043E\u0448\u0438\u0439 \u0434\u0435\u043D\u044C, \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u0438\u0442\u044C\u0441\u044F \u0438 \u043F\u043E\u0431\u0440\u0435\u043D\u0447\u0430\u0442\u044C \u043D\u0430 \u0433\u0438\u0442\u0430\u0440\u0435...#$e#\u042D\u0439, \u0442\u044B \u0442\u043E\u0436\u0435 \u043C\u043E\u0436\u0435\u0448\u044C \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C, \u0435\u0441\u043B\u0438 \u0445\u043E\u0447\u0435\u0448\u044C.",
  "Rainy_Day_1": "\u041A\u0430\u043A \u0434\u0443\u043C\u0430\u0435\u0448\u044C, \u0421\u0435\u0431\u0430\u0441\u0442\u0438\u0430\u043D \u0438 \u0410\u0431\u0438\u0433\u0435\u0439\u043B \u0441\u043E\u0439\u0434\u0443\u0442\u0441\u044F?#$e#\u0425\u0435... \u042F \u0442\u0435\u043F\u0435\u0440\u044C \u0441\u0430\u043C \u0432 \u0431\u0440\u0430\u043A\u0435, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043F\u044B\u0442\u0430\u044E\u0441\u044C \u043F\u043E\u0436\u0435\u043D\u0438\u0442\u044C \u0432\u0441\u0435\u0445 \u0432\u043E\u043A\u0440\u0443\u0433.",
  "Rainy_Day_2": "\u0421\u043B\u0443\u0448\u0430\u0439, \u044F \u0442\u0443\u0442 \u043D\u0430\u0448\u0435\u043B \u0432\u043E\u0442 \u044D\u0442\u043E, \u0437\u0430\u0432\u0430\u043B\u044F\u043B\u043E\u0441\u044C \u0432 \u0441\u0442\u043E\u043B\u0435.[90 88 86 535]#$e#\u042F \u043F\u043E\u0434\u0443\u043C\u0430\u043B, \u043C\u043E\u0436\u0435\u0442, \u0442\u0435\u0431\u0435 \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F.",
  "Rainy_Day_3": "\u041D\u0443 \u0447\u0442\u043E \u0437\u0430 \u0434\u0435\u043B\u0430. \u041F\u0430\u0441\u043C\u0443\u0440\u043D\u044B\u0435 \u0434\u043D\u0438 \u0442\u0430\u043A\u0438\u0435 \u0441\u043A\u0443\u0447\u043D\u044B\u0435...$7",
  "Rainy_Day_4": "\u041A\u0430\u043A \u0441\u043F\u0430\u043B\u043E\u0441\u044C? \u0428\u0443\u043C \u0434\u043E\u0436\u0434\u044F \u043C\u0435\u043D\u044F \u043F\u0440\u044F\u043C\u043E \u0432\u044B\u0440\u0443\u0431\u0430\u0435\u0442.",
  "patio_Sam": "\u042D\u0445... \u0423 \u043C\u0435\u043D\u044F \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F \u044D\u0442\u043E\u0442 \u0442\u0440\u044E\u043A...$s",
  "Rainy_Night_0": "\u041F\u0440\u0438\u0432\u0435\u0442, \u043A\u0430\u043A \u0434\u0435\u043D\u0435\u043A? \u042F \u043F\u0440\u043E\u0441\u0442\u043E \u0432\u0430\u043B\u044F\u043B\u0441\u044F \u0432\u0435\u0441\u044C \u0434\u0435\u043D\u044C \u0438 \u0447\u0438\u0442\u0430\u043B \u043A\u043E\u043C\u0438\u043A\u0441\u044B... \u0411\u044B\u043B\u043E \u043A\u043B\u0435\u0432\u043E.$h",
  "Rainy_Night_1": "\u0414\u0435\u043D\u044C \u0443 \u043C\u0435\u043D\u044F \u0431\u044B\u043B \u043D\u0435 \u0441\u0430\u043C\u044B\u0439 \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0439... \u041A\u043E\u043B\u0430, \u0437\u0430\u043C\u043E\u0440\u043E\u0436\u0435\u043D\u043D\u0430\u044F \u043F\u0438\u0446\u0446\u0430, \u043F\u0430\u0440\u0443 \u0447\u0430\u0441\u043E\u0432 \u0437\u0430 \u0433\u0438\u0442\u0430\u0440\u043E\u0439. \u041D\u0435\u043D\u0430\u043F\u0440\u044F\u0436\u043D\u043E \u0442\u0430\u043A.",
  "Rainy_Night_2": "\u042F \u0442\u0443\u0442 \u043F\u043E\u0441\u043B\u0443\u0448\u0430\u043B \u0437\u0430\u043F\u0438\u0441\u044C \u0441 \u0442\u043E\u0433\u043E \u043D\u0430\u0448\u0435\u0433\u043E \u043A\u043E\u043D\u0446\u0435\u0440\u0442\u0430. \u041F\u043E\u043C\u043D\u0438\u0448\u044C? \u0422\u0430\u043A\u0430\u044F \u043B\u0430\u0436\u0430.#$b#\u042F \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0432\u043E\u043B\u043D\u043E\u0432\u0430\u043B\u0441\u044F \u0438\u0437-\u0437\u0430 \u0442\u0432\u043E\u0435\u0433\u043E \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044F, \u043D\u0435 \u0445\u043E\u0442\u0435\u043B \u043E\u0431\u043B\u0430\u0436\u0430\u0442\u044C\u0441\u044F \u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u0442\u0435\u0431\u0435 \u043D\u0435\u0443\u0434\u0430\u0447\u043D\u0438\u043A\u043E\u043C!$10",
  "Rainy_Night_3": "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0412\u0438\u043D\u0441\u0435\u043D\u0442\u0443 \u0442\u0430\u043C \u0431\u0435\u0437 \u043C\u0435\u043D\u044F \u043D\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043E\u0434\u0438\u043D\u043E\u043A\u043E. \u042F, \u0432\u0440\u043E\u0434\u0435 \u043A\u0430\u043A, \u0431\u044B\u043B \u0437\u0430 \u043D\u0435\u0433\u043E \u0432 \u043E\u0442\u0432\u0435\u0442\u0435.$s#$e#\u041D\u043E \u0432 \u0436\u0438\u0437\u043D\u0438 \u0432\u0435\u0434\u044C \u043D\u0438\u043A\u0430\u043A \u0431\u0435\u0437 \u043F\u0435\u0440\u0435\u043C\u0435\u043D... \u041F\u0440\u0430\u0432\u0434\u0430? \u0414\u0435\u0442\u044F\u043C \u043D\u0443\u0436\u043D\u043E \u043A \u044D\u0442\u043E\u043C\u0443 \u043F\u0440\u0438\u0432\u044B\u043A\u0430\u0442\u044C... \u0418\u043D\u0430\u0447\u0435 \u0432\u043E \u0432\u0437\u0440\u043E\u0441\u043B\u043E\u0439 \u0436\u0438\u0437\u043D\u0438 \u0438\u043C \u043A\u0440\u044B\u0448\u043A\u0430.$7",
  "Rainy_Night_4": "\u042F \u0442\u0443\u0442 \u0437\u0430\u043A\u0438\u043D\u0443\u043B \u043F\u0430\u0440\u0443 \u043F\u0438\u0446\u0446 \u0432 \u043C\u0438\u043A\u0440\u043E\u0432\u043E\u043B\u043D\u043E\u0432\u043A\u0443. \u0414\u0435\u0440\u0436\u0438, \u044D\u0442\u043E \u0442\u0432\u043E\u044F. [206]$h",
  "Indoor_Day_0": "\u0423\u0444... \u041E\u0431 \u043E\u0434\u043D\u043E\u043C \u044F \u0442\u043E\u0447\u043D\u043E \u043D\u0435 \u0441\u043A\u0443\u0447\u0430\u044E \u2014 \u043E \u0440\u0430\u0431\u043E\u0442\u0435 \u0432 \u0414\u0436\u043E\u0434\u0436\u0430\u041C\u0430\u0440\u0442\u0435.",
  "Indoor_Day_1": "\u042F \u0442\u0443\u0442 \u0440\u0430\u0437\u043E\u0433\u0440\u0435\u043B \u0431\u043B\u0438\u043D\u044B. \u041D\u0430\u0441\u043B\u0430\u0436\u0434\u0430\u0439\u0441\u044F.[211]$h#$e#\u0427\u0442\u043E? \u042F \u0442\u0430\u043A \u0438 \u043D\u0435 \u043D\u0430\u0443\u0447\u0438\u043B\u0441\u044F \u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C... \u042D\u0442\u0438\u043C \u0432\u0441\u0435\u0433\u0434\u0430 \u043C\u0430\u043C\u0430 \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0430\u0441\u044C.",
  "Indoor_Day_2": "\u041F\u0440\u0438\u0432\u0435\u0442. \u042F \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0447\u0430\u0441\u0442\u043E \u0434\u0443\u0440\u0430\u0447\u0443\u0441\u044C, \u043D\u043E \u044F \u0445\u043E\u0447\u0443 \u0442\u0435\u0431\u0435 \u0441\u043A\u0430\u0437\u0430\u0442\u044C, \u0447\u0442\u043E \u044F \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043B\u044E\u0431\u043B\u044E \u0442\u0435\u0431\u044F...$l",
  "Indoor_Day_3": "\u0415\u0441\u0442\u044C \u043A\u0430\u043A\u0438\u0435-\u043D\u0438\u0431\u0443\u0434\u044C \u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u043F\u043B\u0430\u043D\u044B \u043D\u0430 \u0434\u0435\u043D\u044C?#$e#\u041D\u0435\u0442, \u0443 \u043C\u0435\u043D\u044F \u043D\u0435\u0442... \u041E\u0431\u044B\u0447\u043D\u043E \u044F \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u044E \u0432\u0441\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u044F \u043F\u0440\u044F\u043C\u043E \u043D\u0430 \u043C\u0435\u0441\u0442\u0435...",
  "Indoor_Day_4": "\u042D\u043C... \u041C\u043E\u0436\u0435\u0442, \u044F \u0442\u0435\u0431\u0435 \u043A\u0430\u043A-\u043D\u0438\u0431\u0443\u0434\u044C \u0432 \u0434\u0440\u0443\u0433\u043E\u0439 \u0440\u0430\u0437 \u043D\u0430 \u0444\u0435\u0440\u043C\u0435 \u043F\u043E\u043C\u043E\u0433\u0443. \u041C\u043D\u0435 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0442\u0430\u043A \u043B\u0435\u043D\u0438\u0432\u043E.$s#$e#\u0422\u044B \u043D\u0435 \u0437\u043B\u0438\u0448\u044C\u0441\u044F?",
  "Indoor_Night_0": "\u042D\u0439, \u0430 \u0442\u044B \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0448\u044C \u0443\u0441\u0442\u0430\u043B\u043E. \u042F \u043F\u043E\u043C\u043E\u0433\u0443 \u0442\u0435\u0431\u0435 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u0438\u0442\u044C\u0441\u044F, \u043B\u0430\u0434\u043D\u043E? \u041C\u043E\u0436\u0435\u0442, \u0441\u0434\u0435\u043B\u0430\u044E \u0442\u0435\u0431\u0435 \u043F\u043E\u043F\u043E\u0437\u0436\u0435 \u043C\u0430\u0441\u0441\u0430\u0436.",
  "Indoor_Night_1": "\u041C\u043E\u0439 \u0434\u0435\u043D\u044C? \u041E\u0439... \u042F \u0438 \u043D\u0435 \u043F\u043E\u043C\u043D\u044E \u043E\u0441\u043E\u0431\u043E. \u041D\u0438\u0447\u0435\u0433\u043E \u0442\u0430\u043A\u043E\u0433\u043E \u044F \u043D\u0435 \u0434\u0435\u043B\u0430\u043B. \u041F\u0440\u043E\u0441\u0442\u043E \u043E\u0442\u0434\u044B\u0445\u0430\u043B \u0438 \u0440\u0430\u0437\u0432\u043B\u0435\u043A\u0430\u043B\u0441\u044F.",
  "Indoor_Night_2": "\u041E\u0439, \u043F\u0440\u043E\u0441\u0442\u0438, \u0447\u0442\u043E \u044F \u043D\u0435 \u0437\u0430\u043F\u0440\u0430\u0432\u0438\u043B \u043A\u0440\u043E\u0432\u0430\u0442\u044C. \u0414\u0430, \u044F \u0437\u043D\u0430\u044E, \u044F \u0431\u0430\u0440\u0434\u0430\u0447\u043D\u0438\u043A... \u0422\u044B \u0432\u0435\u0434\u044C \u043C\u0435\u043D\u044F \u0437\u0430 \u044D\u0442\u043E \u0438 \u043B\u044E\u0431\u0438\u0448\u044C, \u0434\u0430?$h",
  "Indoor_Night_3": "\u0412\u0441\u0435, \u043E \u0447\u0435\u043C \u044F \u0441\u043A\u0443\u0447\u0430\u044E \u0438\u0437 \u0436\u0438\u0437\u043D\u0438 \u0443 \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0435\u0439 \u2014 \u043C\u0430\u043C\u0438\u043D\u0430 \u0440\u044B\u0431\u043D\u0430\u044F \u0437\u0430\u043F\u0435\u043A\u0430\u043D\u043A\u0430.",
  "Indoor_Night_4": "\u041D\u0443 \u0447\u0442\u043E, \u0431\u0443\u0434\u0435\u043C \u0441\u043F\u0430\u0442\u044C? \u042F \u0434\u0430\u0436\u0435 \u043F\u043E\u0441\u0442\u0435\u043B\u044C \u0440\u0430\u0441\u0441\u0442\u0435\u043B\u0438\u043B, \u0432 \u043A\u043E\u0438-\u0442\u043E \u0432\u0435\u043A\u0438...",
  "Outdoor_0": "\u041C\u043E\u0436\u0435\u0442, \u043A\u0443\u043F\u0438\u0442\u044C \u043A \u0441\u043A\u0435\u0439\u0442\u0431\u043E\u0440\u0434\u0443 \u043A\u043E\u043B\u0435\u0441\u0430-\u0432\u043D\u0435\u0434\u043E\u0440\u043E\u0436\u043D\u0438\u043A\u0438... \u0417\u0434\u0435\u0441\u044C \u043C\u0435\u043D\u044F \u043C\u044D\u0440 \u041B\u044C\u044E\u0438\u0441 \u043D\u0435 \u0434\u043E\u0441\u0442\u0430\u043D\u0435\u0442.$h",
  "Outdoor_1": "\u042F \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u043B\u0435\u0436\u0443 \u0437\u0430 \u043D\u0435\u0431\u043E\u043C... \u0417\u0430\u0440\u0430\u043D\u0435\u0435 \u043D\u0435 \u0443\u0433\u0430\u0434\u0430\u0435\u0448\u044C, \u043A\u043E\u0433\u0434\u0430 \u043C\u0438\u043C\u043E \u043F\u0440\u043E\u043B\u0435\u0442\u0438\u0442 \u041D\u041B\u041E.",
  "Outdoor_2": "\u041F\u0440\u0438\u0432\u0435\u0442, @! \u042F \u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u043C\u043D\u043E\u0433\u043E \u0437\u043D\u0430\u044E \u043E \u0440\u0430\u0431\u043E\u0442\u0435 \u043D\u0430 \u0444\u0435\u0440\u043C\u0435, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u0438 \u043F\u043E\u043C\u043E\u0433\u0430\u044E. \u041F\u0440\u043E\u0441\u0442\u0438!#$e#\u042F \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C \u043F\u043E\u043C\u043E\u0447\u044C \u0442\u0435\u0431\u0435 \u043F\u043E\u0437\u0438\u0442\u0438\u0432\u043D\u044B\u043C\u0438 \u043C\u044B\u0441\u043B\u044F\u043C\u0438.$h",
  "Outdoor_3": "\u0427\u0442\u043E-\u0442\u043E \u0432 \u0432\u043E\u0437\u0434\u0443\u0445\u0435 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043F\u0440\u0438\u0431\u0430\u0432\u043B\u044F\u0435\u0442 \u043C\u043D\u0435 \u043E\u043F\u0442\u0438\u043C\u0438\u0437\u043C\u0430... \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u044D\u0442\u043E \u0434\u043E\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u0437\u0430\u043F\u0430\u0445 \u043F\u0438\u0446\u0446\u044B \u0438\u0437 \u043F\u0435\u0447\u0438 \u0413\u0430\u0441\u0430.",
  "Outdoor_4": "\u041E\u0433\u043E... \u0422\u044B \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0437\u0434\u043E\u0440\u043E\u0432\u043E \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0448\u044C, \u0430 \u043A\u0430\u043F\u043B\u0438 \u0433\u0440\u044F\u0437\u0438 \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044E\u0442 \u0448\u0430\u0440\u043C\u0430.$l",
  "OneKid_0": "%kid1... \u041D\u0443\u0436\u043D\u043E \u043F\u043E\u043C\u0435\u043D\u044F\u0442\u044C \u043F\u043E\u0434\u0433\u0443\u0437\u043D\u0438\u043A. \u042F \u044D\u0442\u0438\u043C \u0437\u0430\u0439\u043C\u0443\u0441\u044C. \u0423 \u0442\u0435\u0431\u044F \u0438 \u0431\u0435\u0437 \u0442\u043E\u0433\u043E \u0434\u0435\u043B \u043F\u043E\u043B\u043D\u043E.",
  "OneKid_1": "\u042D\u0442\u043E \u0441\u0442\u0440\u0430\u043D\u043D\u043E, \u043D\u043E \u043C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u0431\u044B\u0442\u044C \u043E\u0442\u0446\u043E\u043C!$h",
  "OneKid_3": "\u0414\u0443\u043C\u0430\u044E, \u043D\u0443\u0436\u043D\u043E \u0437\u0430\u0432\u0435\u0441\u0442\u0438 \u0435\u0449\u0435 \u0440\u0435\u0431\u0435\u043D\u043A\u0430. \u0417\u0430\u0447\u0435\u043C \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u0434\u043E\u0441\u0442\u0438\u0433\u043D\u0443\u0442\u043E\u043C?",
  "TwoKids_0": "\u042F \u0440\u0430\u043D\u043E \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0441\u044F, \u043F\u043E\u043A\u043E\u0440\u043C\u0438\u043B \u0434\u0435\u0442\u0435\u0439 \u0438 \u043F\u043E\u043C\u0435\u043D\u044F\u043B \u0438\u043C \u043F\u043E\u0434\u0433\u0443\u0437\u043D\u0438\u043A\u0438! \u0412\u0441\u0435 \u0433\u043E\u0442\u043E\u0432\u043E. \u041C\u043E\u0436\u0435\u0448\u044C \u043D\u0430\u0447\u0438\u043D\u0430\u0442\u044C \u0433\u0440\u0435\u0441\u0442\u0438 \u0434\u0435\u043D\u044C\u0433\u0438.$h#$e#\u0428\u0443\u0447\u0443... \u042F \u0441 \u0442\u043E\u0431\u043E\u0439 \u043D\u0435 \u0440\u0430\u0434\u0438 \u0434\u0435\u043D\u0435\u0433.",
  "TwoKids_1": "\u041D\u0443\u0436\u043D\u043E, \u0447\u0442\u043E\u0431\u044B %kid1 \u0438 %kid2 \u043F\u043E\u043B\u0443\u0447\u0430\u043B\u0438 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F. \u041D\u0435 \u043D\u0443\u0436\u043D\u043E, \u0447\u0442\u043E\u0431\u044B \u043C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438 \u0431\u044B\u043B\u0430 \u0437\u0430\u0432\u0438\u0441\u0442\u044C.",
  "TwoKids_2": "\u0417\u0430\u0431\u0430\u0432\u043D\u043E \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C, \u043A\u0430\u043A \u0434\u0435\u0442\u0438 \u0438\u0433\u0440\u0430\u044E\u0442 \u0432\u043C\u0435\u0441\u0442\u0435. \u0414\u0443\u043C\u0430\u044E, \u043E\u043D\u0438 \u0432\u044B\u0440\u0430\u0441\u0442\u0443\u0442 \u043E\u0447\u0435\u043D\u044C \u0434\u0440\u0443\u0436\u043D\u044B\u043C\u0438.",
  "TwoKids_3": "\u041D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0434\u0443\u043C\u0430\u043B, \u0447\u0442\u043E \u0441\u0442\u0430\u043D\u0443 \u0441\u0435\u043C\u044C\u044F\u043D\u0438\u043D\u043E\u043C, \u043D\u043E \u043C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u0442\u043E, \u0447\u0442\u043E \u043C\u044B \u0441\u043E\u0437\u0434\u0430\u043B\u0438 \u0432\u043C\u0435\u0441\u0442\u0435. \u0416\u0438\u0437\u043D\u044C \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u043E\u0442\u043B\u0438\u0447\u043D\u043E.$h",
  "Good_1": "\u0422\u044B \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0448\u044C \u043E \u0442\u043E\u0439 \u043D\u043E\u0447\u0438, \u043A\u043E\u0433\u0434\u0430 \u043C\u044B \u0437\u0430\u043B\u0435\u0437\u043B\u0438 \u043A\u043E \u043C\u043D\u0435 \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0443? \u042F \u2014 \u0434\u0430, \u0438 \u0447\u0430\u0441\u0442\u043E...$l",
  "Good_2": "\u0417\u043D\u0430\u0435\u0448\u044C, \u044F \u0434\u0443\u043C\u0430\u044E, \u0443 \u043C\u0435\u043D\u044F \u0441 \u0441\u0430\u043C\u043E\u0433\u043E \u043D\u0430\u0447\u0430\u043B\u0430 \u0431\u044B\u043B\u043E \u0447\u0443\u0432\u0441\u0442\u0432\u043E, \u0447\u0442\u043E \u043C\u044B \u0431\u0443\u0434\u0435\u043C \u0432\u043C\u0435\u0441\u0442\u0435. \u041F\u0440\u043E\u0441\u0442\u043E \u0435\u0441\u0442\u044C \u043C\u0435\u0436\u0434\u0443 \u043D\u0430\u043C\u0438 \u0447\u0442\u043E-\u0442\u043E \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0435.$l",
  "Good_3": "\u041E\u0433\u043E, \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0442\u044B \u043D\u0435\u043E\u0442\u0440\u0430\u0437\u0438\u043C! \u0423 \u0442\u0435\u0431\u044F \u043D\u043E\u0432\u0430\u044F \u043F\u0440\u0438\u0447\u0435\u0441\u043A\u0430?$l^\u041E\u0433\u043E, \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0448\u044C \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u0435\u043B\u0438\u043A\u043E\u043B\u0435\u043F\u043D\u043E. \u0423 \u0442\u0435\u0431\u044F \u043D\u043E\u0432\u0430\u044F \u043F\u0440\u0438\u0447\u0435\u0441\u043A\u0430?$l",
  "Good_6": "\u0411\u0443\u0434\u044C \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u0435\u0439! \u042F \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0442\u044B \u0438\u043D\u043E\u0433\u0434\u0430 \u0445\u043E\u0434\u0438\u0448\u044C \u0432 \u043F\u0435\u0449\u0435\u0440\u044B... \u0422\u0435\u0431\u044F \u0432\u0435\u0434\u044C \u0442\u0430\u043C \u043C\u043E\u0433\u0443\u0442 \u0441\u043E\u0436\u0440\u0430\u0442\u044C \u0437\u0430\u0436\u0438\u0432\u043E!",
  "Good_4": "\u0414\u0435\u0442\u043A\u0430, \u044F \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0441\u044F \u043D\u0430\u043F\u0438\u0441\u0430\u0442\u044C \u0442\u0435\u0431\u0435 \u043F\u0435\u0441\u043D\u044E \u0434\u043B\u044F \u0433\u0438\u0442\u0430\u0440\u044B. \u041D\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u0442\u044B \u0437\u0434\u0435\u0441\u044C, \u0438 \u044F \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u0438\u043B\u0441\u044F.#$e#\u0412 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u043C \u044F \u0438\u0433\u0440\u0430\u044E \u043D\u0430 \u0433\u0438\u0442\u0430\u0440\u0435, \u043A\u043E\u0433\u0434\u0430 \u043C\u043D\u0435 \u043E\u0434\u0438\u043D\u043E\u043A\u043E.",
  "Good_5": "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438 \u0441\u043E \u043C\u043D\u043E\u0439, ${\u043C\u0430\u043B\u044B\u0448^\u043A\u0440\u043E\u0448\u043A\u0430}$! \u041C\u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E \u0443\u0437\u043D\u0430\u0442\u044C, \u043A\u0430\u043A \u043F\u0440\u043E\u0448\u0435\u043B \u0442\u0432\u043E\u0439 \u0434\u0435\u043D\u044C.",
  "funLeave_Sam": "\u042F \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0430\u0432\u0435\u0449\u0443 \u0441\u0435\u043C\u044C\u044E, \u043B\u0430\u0434\u043D\u043E? \u0411\u0443\u0434\u0443 \u0434\u043E\u043C\u0430 \u0432\u0435\u0447\u0435\u0440\u043E\u043C.",
  "funReturn_Sam": "\u0421\u0432\u0438\u0434\u0435\u0442\u044C\u0441\u044F \u0441 \u0441\u0435\u043C\u044C\u0435\u0439 \u043F\u0440\u0438\u044F\u0442\u043D\u043E, \u043D\u043E \u0435\u0449\u0435 \u0438 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0433\u0440\u0443\u0441\u0442\u043D\u043E, \u0447\u0442\u043E \u0441\u0442\u0440\u0430\u043D\u043D\u043E. \u041D\u0443... \u041C\u044B \u0442\u0435\u043F\u0435\u0440\u044C \u0436\u0438\u0432\u0435\u043C \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E \u043F\u043E-\u0440\u0430\u0437\u043D\u043E\u043C\u0443, \u0438 \u0432\u0441\u0435 \u043C\u0435\u0436\u0434\u0443 \u043D\u0430\u043C\u0438 \u0442\u0430\u043A\u043E\u0435 \u0444\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0435... \u0420\u0430\u043D\u044C\u0448\u0435 \u0442\u0430\u043A \u043D\u0435 \u0431\u044B\u043B\u043E.$7",
  "spring_1": "\u0411\u0443... \u0412\u0435\u0441\u043D\u0430... \u041E\u043F\u044F\u0442\u044C \u043F\u043E\u0432\u0441\u044E\u0434\u0443... \u0410\u043B\u043B\u0435\u0440\u0433\u0435\u043D\u044B.$s",
  "spring_12": "\u041D\u0443 \u043A\u0430\u043A, \u0440\u0430\u0434\u0443\u0435\u0448\u044C\u0441\u044F \u0437\u0430\u0432\u0442\u0440\u0430\u0448\u043D\u0435\u043C\u0443 \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A\u0443? \u041A\u0440\u0443\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \u0441\u043D\u043E\u0432\u0430 \u0443\u0432\u0438\u0434\u0435\u0442\u044C\u0441\u044F \u0441 \u0421\u0435\u0431\u0430\u0441\u0442\u0438\u0430\u043D\u043E\u043C.",
  "spring_23": "\u041E\u0439... \u0417\u0430\u0432\u0442\u0440\u0430 \u0432\u0435\u0434\u044C \u0426\u0432\u0435\u0442\u043E\u0447\u043D\u044B\u0435 \u0442\u0430\u043D\u0446\u044B, \u0434\u0430? \u042F \u0434\u0443\u043C\u0430\u043B, \u0440\u0430\u0437 \u043C\u044B \u0442\u0435\u043F\u0435\u0440\u044C \u0436\u0435\u043D\u0430\u0442\u044B, \u043C\u043E\u0436\u043D\u043E \u0442\u0443\u0434\u0430 \u043D\u0435 \u0445\u043E\u0434\u0438\u0442\u044C.#$e#\u041D\u0443 \u0438 \u043B\u0430\u0434\u043D\u043E. \u0412 \u043A\u0430\u043A\u043E\u043C-\u0442\u043E \u0441\u043C\u044B\u0441\u043B\u0435 \u044D\u0442\u043E \u0434\u0430\u0436\u0435 \u0437\u0430\u0431\u0430\u0432\u043D\u043E.",
  "summer_1": "\u041B\u0435\u0442\u043E\u043C \u043F\u044B\u043B\u044C\u0446\u044B \u043F\u043E\u043C\u0435\u043D\u044C\u0448\u0435, \u0442\u0430\u043A \u0447\u0442\u043E \u043C\u043E\u0439 \u043D\u043E\u0441 \u0434\u043E\u0432\u043E\u043B\u0435\u043D.$h",
  "summer_10": "\u041A\u0430\u043A \u0434\u0443\u043C\u0430\u0435\u0448\u044C, \u0447\u0442\u043E \u043C\u044B \u043F\u043E\u043B\u043E\u0436\u0438\u043C \u0432 \u043A\u043E\u0442\u0435\u043B \u043D\u0430 \u043B\u0443\u0430\u0443?#$e#\u0411\u0443\u0434\u0435\u0442 \u043F\u0440\u0438\u043A\u043E\u043B\u044C\u043D\u043E \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C \u0442\u0443\u0434\u0430 \u043A\u0430\u043A\u0443\u044E-\u043D\u0438\u0431\u0443\u0434\u044C \u0433\u0430\u0434\u043E\u0441\u0442\u044C. \u041D\u0443, \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0437\u044B\u0433\u0440\u0430\u0442\u044C \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430!$h#$e#\u041F\u0440\u043E\u0441\u0442\u0438...",
  "summer_27": "\u041B\u0435\u0442\u043E \u2014 \u044D\u0442\u043E \u0437\u0434\u043E\u0440\u043E\u0432\u043E, \u043D\u043E \u044F \u0443\u0436\u0435 \u0433\u043E\u0442\u043E\u0432 \u043A \u043E\u0441\u0435\u043D\u0438.#$e#\u041F\u043E\u0439\u0434\u0435\u043C \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043D\u0430 \u043C\u0435\u0434\u0443\u0437 \u0437\u0430\u0432\u0442\u0440\u0430 \u0432\u0435\u0447\u0435\u0440\u043E\u043C? \u042D\u0442\u043E \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u0440\u0438\u043A\u043E\u043B\u044C\u043D\u043E.",
  "fall_1": "\u0412\u0441\u044F \u0434\u043E\u043B\u0438\u043D\u0430 \u0431\u0443\u0434\u0442\u043E \u043F\u043E\u043C\u0435\u043D\u044F\u043B\u0430\u0441\u044C \u0437\u0430 \u043E\u0434\u043D\u0443 \u043D\u043E\u0447\u044C... \u041E\u0441\u0435\u043D\u044C \u043F\u0440\u0438\u0448\u043B\u0430, \u0432\u0441\u0435-\u0442\u0430\u043A\u0438.",
  "fall_15": "\u042D\u0439, \u0430 \u0437\u0430\u0432\u0442\u0440\u0430 \u0432\u0435\u0434\u044C \u044F\u0440\u043C\u0430\u0440\u043A\u0430. \u041D\u0430\u0434\u043E \u043C\u043D\u0435 \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u0442\u044C, \u043A\u0430\u043A \u0441\u0442\u0440\u0435\u043B\u044F\u0442\u044C \u0438\u0437 \u0440\u043E\u0433\u0430\u0442\u043A\u0438...",
  "fall_26": "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442 \u043B\u0438 \u043C\u0430\u043C\u0430 \u0412\u0438\u043D\u0441\u0435\u043D\u0442\u0430 \u0432 \u043B\u0430\u0431\u0438\u0440\u0438\u043D\u0442 \u0432 \u044D\u0442\u043E\u043C \u0433\u043E\u0434\u0443. \u0421\u043A\u043E\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043E \u2014 \u043D\u0435\u0442.$h#$e#\u0411\u0435\u0434\u043D\u044F\u0436\u043A\u0430. \u041A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u0435\u043C\u0443 \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F \u0432\u044B\u0440\u0430\u0441\u0442\u0438...",
  "winter_1": "\u041E\u0442 \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0433\u043E \u0432\u043E\u0437\u0434\u0443\u0445\u0430 \u0443 \u043C\u0435\u043D\u044F \u0433\u0435\u043B\u044C \u0432 \u0432\u043E\u043B\u043E\u0441\u0430\u0445 \u0437\u0430\u043C\u0435\u0440\u0437\u0430\u0435\u0442. \u042D\u0442\u043E \u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u043F\u0440\u0438\u044F\u0442\u043D\u043E.$s",
  "winter_7": "\u041C\u044B \u0437\u0430\u0432\u0442\u0440\u0430 \u0437\u0430\u0433\u043B\u044F\u043D\u0435\u043C \u043D\u0430 \u043B\u0435\u0434\u043E\u0432\u044B\u0439 \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A? \u0411\u0443\u0434\u0435\u0442 \u0432\u0435\u0441\u0435\u043B\u043E \u0441\u043D\u043E\u0432\u0430 \u0441\u043E \u0432\u0441\u0435\u043C\u0438 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C\u0441\u044F...",
  "winter_28": "\u0413\u043E\u0434 \u0431\u044B\u043B \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u0439, @... \u041D\u0435\u043C\u043D\u043E\u0433\u043E \u0433\u0440\u0443\u0441\u0442\u043D\u043E, \u0447\u0442\u043E \u043E\u043D \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0441\u044F.#$e#\u041D\u0443, \u043C\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u0435\u043C\u0441\u044F, \u0447\u0442\u043E\u0431\u044B \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0433\u043E\u0434 \u0431\u044B\u043B \u0435\u0449\u0435 \u043B\u0443\u0447\u0448\u0435!$h"
}