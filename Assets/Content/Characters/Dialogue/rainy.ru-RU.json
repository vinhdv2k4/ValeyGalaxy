{
  "Abigail": "\u0414\u043E\u043B\u0438\u043D\u0430 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u0435\u0435, \u043A\u043E\u0433\u0434\u0430 \u0438\u0434\u0435\u0442 \u0434\u043E\u0436\u0434\u044C... \u0422\u044B \u0442\u0430\u043A \u043D\u0435 \u0434\u0443\u043C\u0430\u0435\u0448\u044C?",
  "Robin": "\u0414\u043E\u0436\u0434\u044C \u043C\u0435\u043D\u044F \u043D\u0435 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442!$h#$e#\u041F\u0440\u0430\u0432\u0434\u0430, \u0441 \u0441\u044B\u0440\u044B\u043C \u0434\u0435\u0440\u0435\u0432\u043E\u043C \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u043F\u0440\u0438\u044F\u0442\u043D\u043E.$s",
  "Demetrius": "\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E! \u041E\u0441\u0442\u0430\u0432\u0430\u0439\u0441\u044F \u043F\u043E\u043A\u0430 \u0437\u0434\u0435\u0441\u044C, \u0435\u0441\u043B\u0438 \u0445\u043E\u0447\u0435\u0448\u044C \u0441\u043E\u0433\u0440\u0435\u0442\u044C\u0441\u044F.",
  "Maru": "\u041A\u043E\u0433\u0434\u0430 \u0438\u0434\u0435\u0442 \u0434\u043E\u0436\u0434\u044C, \u0443 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u043F\u043E\u0432\u043E\u0434 \u0432\u0435\u0441\u044C \u0434\u0435\u043D\u044C \u0432\u043E\u0437\u0438\u0442\u044C\u0441\u044F \u0441\u043E \u0441\u0432\u043E\u0438\u043C\u0438 \u0438\u0437\u043E\u0431\u0440\u0435\u0442\u0435\u043D\u0438\u044F\u043C\u0438.$h#$e#\u041D\u043E \u0442\u0435\u0431\u0435, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u0431\u044B\u0432\u0430\u0435\u0442 \u0441\u043A\u0443\u0447\u043D\u043E \u0432 \u0442\u0430\u043A\u0438\u0435 \u0434\u043D\u0438.",
  "Sebastian": "\u0415\u0441\u043B\u0438 \u043F\u043E\u0432\u0435\u0437\u0435\u0442, \u0432 \u0442\u0430\u043A\u0443\u044E \u043F\u043E\u0433\u043E\u0434\u0443 \u043C\u043E\u0436\u043D\u043E \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C \u043B\u044F\u0433\u0443\u0448\u0435\u043A.",
  "Linus": "\u041F\u043E\u0434 \u0442\u0435\u043F\u043B\u044B\u043C \u0434\u043E\u0436\u0434\u0435\u043C \u043F\u0440\u0438\u044F\u0442\u043D\u043E \u043F\u043E\u043C\u044B\u0442\u044C\u0441\u044F.$h",
  "Pierre": "\u0412 \u0442\u0430\u043A\u0438\u0435 \u0434\u043D\u0438 \u0432\u0441\u0435 \u0441\u0438\u0434\u044F\u0442 \u043F\u043E \u0434\u043E\u043C\u0430\u043C... \u041F\u0440\u0438\u0431\u044B\u043B\u044C \u043F\u0430\u0434\u0430\u0435\u0442.$s",
  "Caroline": "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043C\u043E\u0439 \u0441\u0430\u0434 \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432.$h#$e#... \u0414\u0430 \u0438 \u0441\u0447\u0435\u0442 \u0437\u0430 \u0432\u043E\u0434\u0443 \u0432 \u044D\u0442\u043E\u043C \u043C\u0435\u0441\u044F\u0446\u0435 \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u043C\u0435\u043D\u044C\u0448\u0435.",
  "Alex": "\u0425\u043C-\u043C\u0444. \u0412 \u0442\u0430\u043A\u0443\u044E \u043F\u043E\u0433\u043E\u0434\u0443 \u0441\u043F\u043E\u0440\u0442\u043E\u043C \u043D\u0435 \u043F\u043E\u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0448\u044C\u0441\u044F.$s#$e#\u041D\u0443 \u043D\u0438\u0447\u0435\u0433\u043E, \u0442\u044F\u0436\u0435\u0441\u0442\u0438 \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0442\u044C \u0438 \u0434\u043E\u043C\u0430.$h",
  "George": "\u0423\u0436\u0430\u0441\u043D\u043E \u0445\u043E\u043B\u043E\u0434\u043D\u043E, \u043F\u0440\u0430\u0432\u0434\u0430? \u041A\u0430\u043A\u043E\u0439 \u0434\u0440\u044F\u043D\u043D\u043E\u0439 \u0434\u0435\u043D\u044C.",
  "Evelyn": "\u042F \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0430\u0441\u044C \u0438 \u0443\u0441\u043B\u044B\u0448\u0430\u043B\u0430, \u043A\u0430\u043A \u0447\u0442\u043E-\u0442\u043E \u0433\u0434\u0435-\u0442\u043E \u043A\u0430\u043F\u0430\u0435\u0442... \u0414\u0443\u043C\u0430\u044E, \u043A\u0440\u044B\u0448\u0430 \u0442\u0435\u0447\u0435\u0442.$s#$e#\u0412 \u0431\u044B\u043B\u044B\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0430 \u0414\u0436\u043E\u0440\u0434\u0436 \u0442\u0443\u0442 \u0436\u0435 \u0437\u0430\u043B\u0435\u0437 \u0431\u044B \u043D\u0430\u0432\u0435\u0440\u0445 \u0438 \u0432\u0441\u0435 \u043F\u043E\u0447\u0438\u043D\u0438\u043B... \u042D\u0445.$s",
  "Lewis": "\u0417\u0434\u043E\u0440\u043E\u0432\u043E, @. \u041E\u0442\u0434\u044B\u0445\u0430\u0435\u0448\u044C?#$e#\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u043F\u0430\u0432\u043E\u0434\u043A\u0430 \u043D\u0435 \u0441\u043B\u0443\u0447\u0438\u0442\u0441\u044F...$s",
  "Clint": "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0434\u0435\u043D\u044C, \u0447\u0442\u043E\u0431\u044B \u0441\u043F\u0443\u0441\u0442\u0438\u0442\u044C\u0441\u044F \u0432 \u0448\u0430\u0445\u0442\u0443... \u041A\u0430\u043A \u0437\u043D\u0430\u0442\u044C, \u0432\u0434\u0440\u0443\u0433 \u0442\u044B \u043D\u0430\u0439\u0434\u0435\u0448\u044C \u0442\u0430\u043C \u0440\u0435\u0434\u043A\u0443\u044E \u0440\u0443\u0434\u0443.",
  "Penny": "\u0414\u043E\u0436\u0434\u044C \u0442\u0430\u043A \u0433\u0440\u043E\u043C\u043A\u043E \u0441\u0442\u0443\u0447\u0438\u0442 \u043F\u043E \u043A\u0440\u044B\u0448\u0435, \u043E\u043D\u0430 \u0432\u0435\u0434\u044C \u0443 \u043D\u0430\u0448\u0435\u0433\u043E \u0444\u0443\u0440\u0433\u043E\u043D\u0430 \u0436\u0435\u043B\u0435\u0437\u043D\u0430\u044F.#$e#... \u041F\u0440\u0430\u0432\u0434\u0430, \u044D\u0442\u043E\u0442 \u0448\u0443\u043C \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E \u0443\u0441\u043F\u043E\u043A\u0430\u0438\u0432\u0430\u0435\u0442.$h",
  "Pam": "\u0417\u0434\u043E\u0440\u043E\u0432\u043E, \u043C\u043E\u043B\u043E\u0434\u0435\u0436\u044C. \u041D\u0435 \u043C\u043E\u043A\u043D\u0435\u0448\u044C?",
  "Emily": "\u0412 \u043F\u0443\u0441\u0442\u044B\u043D\u0435 \u041A\u0430\u043B\u0438\u043A\u043E \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0431\u044B\u0432\u0430\u0435\u0442 \u0434\u043E\u0436\u0434\u044F... \u0422\u0430\u043C \u0436\u0438\u0432\u0435\u0442 \u043C\u043E\u044F \u043F\u043E\u0434\u0440\u0443\u0433\u0430, \u0421\u044D\u043D\u0434\u0438.#$e#\u0425\u043E\u0442\u0435\u043B\u0430 \u0431\u044B \u044F \u0441\u044A\u0435\u0437\u0434\u0438\u0442\u044C \u043A \u043D\u0435\u0439 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0432 \u0433\u043E\u0441\u0442\u0438.$s",
  "Haley": "\u042F \u0432\u0441\u0435 \u0443\u0442\u0440\u043E \u0434\u0435\u043B\u0430\u043B\u0430 \u0441\u0435\u0431\u0435 \u043F\u0440\u0438\u0447\u0435\u0441\u043A\u0443... \u0410 \u0442\u0435\u043F\u0435\u0440\u044C \u0434\u043E\u0436\u0434\u044C \u043C\u043E\u0436\u0435\u0442 \u0435\u0435 \u0438\u0441\u043F\u043E\u0440\u0442\u0438\u0442\u044C.$s#$e#\u042D\u0445... \u0416\u0438\u0437\u043D\u044C \u0438\u043D\u043E\u0433\u0434\u0430 \u0442\u0430\u043A\u0430\u044F \u0442\u044F\u0436\u0435\u043B\u0430\u044F.",
  "Jodi": "\u0422\u044B \u0432\u0435\u0434\u044C \u0432\u044B\u0442\u0438\u0440\u0430\u0435\u0448\u044C \u043D\u043E\u0433\u0438 \u043F\u0435\u0440\u0435\u0434 \u0442\u0435\u043C, \u043A\u0430\u043A \u0432\u043E\u0439\u0442\u0438? \u041F\u0440\u043E\u0441\u0442\u0438... \u042F \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E \u0432\u044B\u043C\u044B\u043B\u0430 \u043F\u043E\u043B.#$e#\u041D\u043E \u0442\u0435\u0431\u0435 \u043C\u044B \u0432\u0441\u0435\u0433\u0434\u0430 \u0440\u0430\u0434\u044B! \u0425\u0435.$h",
  "Sam": "\u0414\u043E\u0436\u0434\u044C \u043F\u0440\u0438\u0433\u043B\u0443\u0448\u0430\u0435\u0442 \u0437\u0432\u0443\u043A\u0438, \u0442\u0430\u043A \u0447\u0442\u043E \u044F \u043C\u043E\u0433\u0443 \u0438\u0433\u0440\u0430\u0442\u044C \u043D\u0430 \u0433\u0438\u0442\u0430\u0440\u0435 \u0433\u0440\u043E\u043C\u0447\u0435, \u0447\u0435\u043C \u043E\u0431\u044B\u0447\u043D\u043E, \u0438 \u043C\u0430\u043C\u0430 \u043D\u0435 \u0440\u0430\u0441\u0441\u0435\u0440\u0434\u0438\u0442\u0441\u044F. \u0425\u0435-\u0445\u0435...$h",
  "Leah": "\u041C\u043E\u0436\u0435\u0442, \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0447\u0442\u043E-\u0442\u043E \u043D\u043E\u0432\u043E\u0435 \u0438 \u0432\u043E\u043B\u043D\u0443\u044E\u0449\u0435\u0435. \u0427\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043E\u0441\u0442\u0440\u0435\u043D\u044C\u043A\u043E\u0435.",
  "Shane": "\u0425\u043C-\u043C... \u0412 \u0442\u0430\u043A\u0443\u044E \u043F\u043E\u0433\u043E\u0434\u0443 \u043C\u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u043F\u0438\u0442\u044C.$s",
  "Marnie": "\u041F\u0440\u0438\u0432\u0435\u0442, @. \u0411\u0435\u0434\u043D\u044F\u0436\u0435\u0447\u043A\u0430, \u0432\u044B\u043C\u043E\u043A\u043D\u0443\u0442\u044C \u0432\u043E\u0442 \u0442\u0430\u043A, \u0434\u043E \u043D\u0438\u0442\u043A\u0438!$h",
  "Elliott": "\u0418\u043D\u043E\u0433\u0434\u0430, \u043A\u043E\u0433\u0434\u0430 \u044F \u043B\u0435\u0436\u0443 \u0432 \u043F\u043E\u0441\u0442\u0435\u043B\u0438, \u044F \u0441\u043B\u044B\u0448\u0443, \u043A\u0430\u043A \u0447\u0435\u0440\u0435\u0437 \u0434\u043E\u0436\u0434\u044C \u043F\u0440\u043E\u0440\u0435\u0437\u0430\u0435\u0442\u0441\u044F \u0437\u0432\u0443\u043A \u0441\u0438\u0440\u0435\u043D\u044B.#$b#\u041D\u043E \u043A\u043E\u0433\u0434\u0430 \u044F \u0432\u044B\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044E \u0432 \u043E\u043A\u043D\u043E, \u043F\u0435\u0440\u0435\u0434\u043E \u043C\u043D\u043E\u0439 \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0435\u0440\u0430\u044F \u043F\u0435\u043B\u0435\u043D\u0430.",
  "Gus": "\u0412 \u0442\u0430\u043A\u043E\u0439 \u0434\u0435\u043D\u044C \u043D\u0435\u0442 \u043D\u0438\u0447\u0435\u0433\u043E \u043B\u0443\u0447\u0448\u0435 \u0431\u043E\u043A\u0430\u043B\u0430 \u043A\u0440\u0430\u0441\u043D\u043E\u0433\u043E \u0441\u0443\u0445\u043E\u0433\u043E \u0432\u0438\u043D\u0430, \u043F\u0440\u0430\u0432\u0434\u0430?#$e#\u041B\u044E\u0431\u043B\u044E \u0441\u0432\u043E\u044E \u0440\u0430\u0431\u043E\u0442\u0443. \u0425\u0435-\u0445\u0435-\u0445\u0435.",
  "Dwarf": "\u0414\u043E\u0436\u0434\u044C... \u0414\u043B\u044F \u043D\u0430\u0441 \u044D\u0442\u043E \u044F\u0432\u043B\u0435\u043D\u0438\u0435 \u2014 \u043F\u043E\u0447\u0442\u0438 \u043C\u0438\u0441\u0442\u0438\u043A\u0430. \u041C\u043D\u043E\u0433\u0438\u0435 \u0438\u0437 \u043D\u0430\u0441 \u0437\u0430 \u0432\u0441\u044E \u0441\u0432\u043E\u044E \u0436\u0438\u0437\u043D\u044C \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0438 \u0434\u043E\u0436\u0434\u044F.",
  "Wizard": "\u0421 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u043C\u0438 \u0441\u0442\u0438\u0445\u0438\u044F\u043C\u0438 \u044F \u043C\u043E\u0433\u0443 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u0442\u0430\u043A\u0438\u0435 \u0434\u043D\u0438.#$e#\u042F \u0438 \u043D\u0435 \u043E\u0436\u0438\u0434\u0430\u044E, \u0447\u0442\u043E \u0442\u044B \u043C\u0435\u043D\u044F \u043F\u043E\u0439\u043C\u0435\u0448\u044C.",
  "Harvey": "\u041F\u0440\u0438\u0432\u0435\u0442, @! \u042D\u044D... \u041D\u0435 \u0447\u0438\u0442\u0430\u0435\u0448\u044C \u043B\u0438 \u0447\u0435\u0433\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E\u0433\u043E \u0438\u0437 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0438?#$e#\u0425\u0435. \u041D\u0443, \u044D\u043C-\u043C... \u0415\u0449\u0435 \u0443\u0432\u0438\u0434\u0438\u043C\u0441\u044F?",
  "Sandy": "\u042F \u0441\u043B\u044B\u0448\u0430\u043B\u0430, \u0431\u0443\u0434\u0442\u043E \u0434\u043E\u043C\u0430 \u0441\u0435\u0439\u0447\u0430\u0441 \u0438\u0434\u0435\u0442 \u0434\u043E\u0436\u0434\u044C. \u0422\u044B \u0432\u0435\u0434\u044C \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0437\u0434\u0435\u0441\u044C?$h#$e#\u041D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435, \u044F \u0434\u0430\u0436\u0435 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0441\u043A\u0443\u0447\u0430\u044E \u043F\u043E \u0434\u043E\u0436\u0434\u044E...$s",
  "Krobus": "\u0410\u0445, \u0441\u0442\u043E\u043A\u0438 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0442\u0435\u043A\u0443\u0442 \u0442\u0430\u043A \u0431\u044B\u0441\u0442\u0440\u043E. \u0417\u0434\u0435\u0441\u044C \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0432\u043B\u0430\u0436\u043D\u043E \u0438 \u043F\u0440\u0438\u044F\u0442\u043D\u043E... \u041F\u0440\u044F\u043C\u043E \u043A\u0430\u043A \u044F \u043B\u044E\u0431\u043B\u044E.",
  "Leo": "\u0412 \u0434\u043E\u043B\u0438\u043D\u0435 \u0442\u0430\u043A \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0434\u043E\u0436\u0434\u044F.#$e#\u0414\u043B\u044F \u043C\u0435\u043D\u044F... \u043F\u0440\u0438\u0440\u043E\u0434\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0442 \u043A\u0435\u043C-\u0442\u043E \u0431\u043B\u0438\u0437\u043A\u0438\u043C, \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u043C, \u043F\u0440\u043E\u0441\u0442\u043E \u0441 \u0440\u0430\u0437\u043D\u044B\u043C\u0438 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F\u043C\u0438."
}