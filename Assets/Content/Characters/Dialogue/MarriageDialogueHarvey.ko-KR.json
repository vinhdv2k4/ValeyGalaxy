{
  "Rainy_Day_0": "\uBE44\uAC00 \uC624\uBA74 \uAC10\uAE30 \uAC78\uB9B0\uB2E4\uB294 \uAC74 \uBBF8\uC2E0\uC774\uC57C. \uADF8\uB798\uB3C4, \uC9C4\uD759\uC5D0 \uBBF8\uB044\uB7EC\uC838\uC11C \uB118\uC5B4\uC9C0\uC9C0 \uC54A\uAC8C \uC870\uC2EC\uD558\uACE0!#$e#\uC790\uAE30 \uAC71\uC815 \uC790\uC8FC \uD55C\uB2E4\uB2C8\uAE4C.",
  "Rainy_Day_1": "\uBCD1\uC6D0 \uC704\uC5D0\uC11C \uD63C\uC790 \uC0AC\uB294 \uAC74 \uC815\uB9D0\uC774\uC9C0 \uB108\uBB34 \uC678\uB85C\uC6E0\uC5B4... \uC9C0\uAE08 \uB09C \uD6E8\uC52C \uD589\uBCF5\uD574.$h",
  "Rainy_Day_2": "\uB098 \uC77C\uCC0D \uC77C\uC5B4\uB0AC\uC744 \uB54C \uC544\uC9C1 \uC790\uACE0 \uC788\uAE38\uB798 \uC548 \uAE68\uC6E0\uC5B4. \uB108\uBB34 \uD3C9\uD654\uB85C\uC6CC \uBCF4\uC600\uAC70\uB4E0.",
  "Rainy_Day_3": "\uC0AC\uC2E4 \uB098 \uBE44\uAC00 \uC2EB\uC740 \uAC74 \uC544\uB0D0. \uBB3C\uB860, \uBE44\uD589\uAE30\uAC00 \uC624\uAC00\uB294 \uAC74 \uBABB \uBCF4\uC9C0\uB9CC, \uBB34\uC120 \uD1B5\uC2E0\uC740 \uB4E4\uC744 \uC218 \uC788\uC73C\uB2C8\uAE4C.#$e#\uC774\uB7EC\uBA74 \uC880 \uB354 \uC2E0\uBE44\uB85C\uC6B4 \uB290\uB08C\uC774 \uB4E4\uC9C0.",
  "Rainy_Day_4": "\uC624\uB298 \uB05D\uB0B4\uACE0 \uC2F6\uC740 \uBC00\uB9B0 \uC9D1\uC548\uC77C\uC774 \uC788\uC5B4. \uC624\uB298 \uC885\uC77C \uBC14\uC058\uACA0\uB294\uAC78!",
  "Rainy_Night_0": "\uC624\uB298 \uD558\uB8E8 \uC5B4\uB560\uC5B4, \uC5EC\uBCF4? \uB09C \uC124\uAC70\uC9C0\uD558\uB824\uB2E4\uAC00 \uBB34\uB98E \uC218\uC220 \uC7A1\uC9C0\uC5D0 \uBE60\uC838\uC11C \uACC4\uC18D \uC77D\uC5C8\uB124.",
  "patio_Harvey": "\uC788\uC9C0, \uC774 \u0027\uAC74 \uC5ED\uD559 \uD559\uC220\uC9C0\u0027\uB3C4 \uBC16\uC5D0 \uB098\uC640\uC11C \uC77D\uC73C\uB2C8\uAE4C \uC880 \uACAC\uB51C\uB9CC\uD558\uB124.",
  "Rainy_Night_1": "\uC778\uC0DD\uC774 \uC990\uAC81\uB2E4\uBA74, \uC880 \uBC18\uBCF5\uC801\uC774\uBA74 \uC5B4\uB54C? \uC801\uC5B4\uB3C4 \uB0B4 \uC0DD\uAC01\uC740 \uADF8\uB798.",
  "Rainy_Night_2": "\uC790\uAE30\uC57C, \uC880 \uCD95\uCD95\uD574 \uBCF4\uC774\uB124. \uB09C\uB85C \uC55E\uC5D0 \uC549\uC544\uC11C \uBAB8 \uC880 \uB370\uC6B0\uC9C0\uADF8\uB798?^\uC5EC\uBCF4, \uC880 \uCD95\uCD95\uD574 \uBCF4\uC774\uB124. \uB09C\uB85C \uC55E\uC5D0 \uC549\uC544\uC11C \uBAB8 \uC880 \uB370\uC6B0\uC9C0\uADF8\uB798?",
  "Rainy_Night_3": "\uBE57\uC18C\uB9AC\uC5D0 \uC815\uC2E0\uC744 \uC9D1\uC911\uD574\uC57C \uD558\uB2C8\uAE4C, \uC7A1\uB2E4\uD55C \uC0DD\uAC01\uC73C\uB85C \uC0B0\uB9CC\uD574\uC9C0\uC9C0 \uC54A\uC744 \uC218 \uC788\uC5B4.#$e#\uC801\uC5B4\uB3C4 \uC65C \uBE57\uC18C\uB9AC\uAC00 \uADF8\uB807\uAC8C \uB9C8\uC74C\uC744 \uCC28\uBD84\uD558\uAC8C \uD574\uC8FC\uB294\uC9C0\uC5D0 \uB300\uD55C \uB0B4 \uC774\uB860\uC740 \uADF8\uB798...",
  "Rainy_Night_4": "\uAC74\uAC15\uD55C \uC800\uB141\uC744 \uCC28\uB824\uBD24\uC5B4. \uACC4\uACE1\uC5D0\uC11C \uB09C \uC2E0\uC120\uD558\uACE0 \uAC74\uAC15\uC5D0 \uC88B\uC740 \uC7AC\uB8CC\uB9CC \uC0AC\uC6A9\uD588\uC9C0! [212 214 225 209 200]$h#$e#\uC5EC\uBCF4, \uADF8\uB807\uB2E4\uACE0 \uB108\uBB34 \uB9CE\uC774 \uBA39\uC9C4 \uB9D0\uACE0.",
  "Indoor_Day_0": "\uC6B0\uB9AC \uBAA8\uB450 \uC778\uC0DD\uC758 \uC5B4\uB5A4 \uADE0\uD615\uC744 \uB9DE\uCD94\uB824\uACE0 \uB178\uB825\uD558\uB294 \uAC83 \uAC19\uC544. \uBCF5\uC7A1\uD568\uC758 \uD3C9\uD615\uC0C1\uD0DC \uAC19\uC740 \uAC70.#$e#\uB098\uD55C\uD14C\uB294 \uC5EC\uAE30 \uC774\uC0AC\uC624\uB294 \uAC8C \uB531 \uB0B4 \uBAB8\uC774 \uD544\uC694\uB85C \uD558\uB358 \uC77C\uC774\uC5C8\uC5B4.$l",
  "Indoor_Day_1": "@, \uC88B\uC740 \uC544\uCE68! \uC601\uC591 \uAC00\uB4DD\uD55C \uC544\uCE68\uC2DD\uC0AC\uB97C \uCC28\uB838\uC5B4.[201]#$e#\uACC4\uB780\uC740 \uD544\uC218 \uC601\uC591\uC18C\uAC00 \uB9CE\uC774 \uB4E4\uC5B4\uC788\uC73C\uB2C8\uAE4C, \uAF2D \uCC59\uACA8 \uBA39\uACE0.",
  "Indoor_Day_2": "\uC624\uB298\uC740 \uC758\uD559 \uC11C\uC801 \uACF5\uBD80\uD558\uB824\uACE0. \uC774\uB7F0 \uAC70 \uD3C9\uC18C\uC5D0 \uAF2C\uBC15\uAF2C\uBC15 \uD574\uB46C\uC57C\uC9C0 \uD658\uC790\uB4E4\uC5D0\uAC8C \uCD5C\uC120\uC758 \uCE58\uB8CC\uB97C \uC81C\uACF5\uD574 \uC904 \uC218 \uC788\uB2E4\uACE0!",
  "Indoor_Day_3": "\uB098 \uC624\uB298\uC740 \uC7AC\uC988 \uC880 \uB4E4\uC73C\uBA74\uC11C \uC9C4\uB8CC \uBCF4\uACE0 \uC791\uC131\uD558\uB294 \uAC70 \uB9C8\uBB34\uB9AC\uD558\uB824\uACE0. \uC790\uAE30\uB294 \uC624\uB298 \uC5B4\uB5A4 \uACC4\uD68D\uC774 \uC788\uC5B4?",
  "Indoor_Day_4": "\uC6B0\uB9AC \uCC98\uC74C \uB9CC\uB0AC\uC744 \uB54C \uB098 \uC0AC\uC2E4 \uC790\uAE30 \uBB34\uC11C\uC6E0\uC5B4. \uC774\uB807\uAC8C\uAE4C\uC9C0 \uC0C1\uD669\uC774 \uB2EC\uB77C\uC84C\uB2E4\uB2C8 \uC7AC\uBC0C\uB124.$h",
  "Indoor_Night_0": "\uC5EC\uBCF4, \uC9C0\uCCD0 \uBCF4\uC5EC. \uB0B4\uAC00 \uB9C8\uC0AC\uC9C0\uD574\uC904\uAC8C. \uADFC\uC721\uC870\uC9C1\uC5D0 \uC788\uB294 \uC5FC\uC99D\uC744 \uC904\uC5EC\uC904 \uAC70\uC57C, \uC7A5\uB2F4\uD560\uAC8C!$l",
  "Indoor_Night_1": "\uC624\uB298\uC740 \uC880 \uD3B8\uD558\uAC8C \uBCF4\uB0C8\uC5B4... \uCC45 \uC880 \uC77D\uACE0, \uB77C\uB514\uC624 \uC880 \uB9CC\uC9C0\uACE0, \uBAA8\uD615 \uBE44\uD589\uAE30 \uC791\uC5C5 \uC880 \uD588\uC9C0.#$e#\uAC00\uB054 \uC26C\uB294 \uAC83\uB3C4 \uC911\uC694\uD558\uC9C0... \uC2A4\uD2B8\uB808\uC2A4\uB294 \uAC74\uAC15\uC5D0 \uC548 \uC88B\uC544.",
  "Indoor_Night_2": "\uC88B\uC740 \uC800\uB141\uC774\uC57C... \uC624\uB298 \uD558\uB824\uB358 \uC77C\uC740 \uB2E4 \uB05D\uB0C8\uC5B4?#$e#\uB09C \uB108\uBB34 \uAC71\uC815\uD558\uC9C0 \uB9D0\uACE0. \uB098 \uC790\uAE09\uC790\uC871 \uC798\uD574. \uD574\uC57C \uD560 \uC77C\uC774 \uB0A8\uC558\uC73C\uBA74 \uD574\uC57C\uC9C0.",
  "Indoor_Night_3": "\uC758\uC0AC\uB294 \uC2A4\uD2B8\uB808\uC2A4\uAC00 \uB9CE\uC740 \uC9C1\uC5C5\uC774\uB77C\uC11C, %farm \uB18D\uC7A5\uCC98\uB7FC \uB9C8\uC74C\uC744 \uB290\uAE0B\uD558\uAC8C \uD574\uC8FC\uB294 \uACF3\uC5D0\uC11C \uC0AC\uB294 \uAC8C \uC815\uB9D0 \uC88B\uC740 \uAC83 \uAC19\uC544.",
  "Indoor_Night_4": "\uC624! \uC21C\uD658\uACC4\uC5D0 \uB300\uD574 \uC0DD\uAC01\uD558\uB2E4\uAC00 \uBB50\uD558\uB824\uACE0 \uD588\uB294\uC9C0 \uAE5C\uBE61\uD588\uB124. \uC758\uC0AC\uB4E4\uC774 \uACAA\uB294 \uACE0\uC804\uC801\uC778 \uBB38\uC81C\uC57C.",
  "Outdoor_0": "\uC5EC\uAE30 \uC815\uB9D0 \uC548\uC804\uD55C \uAE30\uBD84\uC774 \uB4DC\uB124. \uD560 \uC77C \uD558\uB7EC \uAC00\uBD10\uB3C4 \uAD1C\uCC2E\uC544, \uB09C \uAC71\uC815 \uC548 \uD574\uB3C4 \uB3FC.",
  "Outdoor_1": "\uC5EC\uAE34 \uC544\uC774\uB97C \uD0A4\uC6B0\uAE30 \uC815\uB9D0 \uC774\uC0C1\uC801\uC778 \uACF3\uC774\uB77C \uC0DD\uAC01\uD574, \uACFC\uD559\uC801\uC73C\uB85C. \uB124 \uC0DD\uAC01\uC740 \uC5B4\uB54C?",
  "Outdoor_2": "\uB0B4\uAC00 \uADF8\uB807\uAC8C \uD1A1\uD1A1 \uD280\uB294 \uC0AC\uB78C\uC740 \uC544\uB2C8\uC9C0\uB9CC, \uD55C\uD3C9\uC0DD \uB124\uAC8C\uB9CC \uCDA9\uC2E4\uD560 \uAC70\uC57C.$l",
  "Outdoor_3": "@... \uB108... \uB10C \uB0B4\uAC8C \uC788\uC5B4 \uC774 \uC138\uC0C1 \uC804\uBD80\uC57C.$l",
  "Outdoor_4": "\uACFC\uD559\uC790\uB85C\uC11C \uB09C \uACE4\uCDA9\uACFC \uC2DD\uBB3C\uC758 \uC12C\uC138\uD55C \uC0C1\uD638 \uC791\uC6A9\uC774 \uB300\uB2E8\uD788 \uD765\uBBF8\uB85C\uC6B4 \uAC78.",
  "OneKid_0": "\uB108\uC640 %kid1(\uC774)\uB294 \uB0B4 \uC778\uC0DD\uC758 \uAC00\uC7A5 \uC911\uC694\uD55C \uBD80\uBD84\uC774\uC57C.",
  "OneKid_1": "\uC6B0\uB9AC \uC791\uC740 %kid1(\uC774)\uB294 \uC5EC\uAE30\uC11C \uC644\uBCBD\uD55C \uC720\uB144\uAE30\uB97C \uBCF4\uB0BC \uC218 \uC788\uC744 \uAC70\uC57C. \uC774\uB7F0 \uAE30\uD68C\uB97C \uAC00\uC9C8 \uC218 \uC788\uB294 \uC6B0\uB9B0 \uC815\uB9D0 \uBCF5\uBC1B\uC740 \uAC70\uC57C.",
  "OneKid_3": "\uC9C0\uAE08\uAE4C\uC9C0\uB294 \uC801\uC5B4\uB3C4, \uB09C \uC544\uBE60\uC778 \uAC8C \uC815\uB9D0 \uC815\uB9D0 \uC88B\uC544!$h",
  "TwoKids_0": "%kid1(\uC774)\uB791 %kid2(\uC774) \uC774\uBBF8 \uC544\uCE68\uC740 \uB0B4\uAC00 \uCC28\uB824\uC92C\uC5B4. \uAC74\uAC15\uD55C \uC74C\uC2DD\uC744 \uC990\uAE38 \uC218 \uC788\uB3C4\uB85D \uAC00\uB974\uCE58\uB824 \uD558\uACE0 \uC788\uC5B4!",
  "TwoKids_1": "\uB09C \uC544\uC774\uB77C\uBA74 \uB9C8\uC74C\uAECF \uB180\uACE0 \uD0D0\uD5D8\uD560 \uC218 \uC788\uC5B4\uC57C \uD55C\uB2E4 \uBBFF\uC5B4. \uC778\uC0DD\uC5D0\uC11C \uC5B4\uB9B0 \uC2DC\uC808\uC740 \uD55C \uBC88\uBFD0\uC774\uC796\uC544.",
  "TwoKids_2": "%kid2(\uC774)\uAC00 \uC790\uB77C\uC11C \uBE44\uD589\uC0AC\uAC00 \uB420 \uC218 \uC788\uC744\uAE4C?",
  "TwoKids_3": "\uB0B4 \uC778\uC0DD\uC740 \uC5EC\uBCF4\uB791 \uC544\uC774\uB4E4\uC5D0\uAC8C \uD5CC\uC2E0\uD558\uBA74 \uB418\uB294 \uAC70\uB2C8\uAE4C, \uB09C \uD589\uBCF5\uD574. \uD56D\uC0C1 \uBA4B\uC9C4 \uAC00\uC871\uACFC \uD568\uAED8\uD558\uB294 \uAC83\uC774 \uAFC8\uC774\uC5C8\uC5B4.$l#$e#\uD3C9\uC0DD \uD63C\uC790\uC77C\uAE4C \uC545\uBABD\uB3C4 \uAFE8\uACE0.... \uC815\uB9D0\uC774\uC9C0, \uB9CE\uC774 \uC0AC\uB791\uD574.$l",
  "Good_0": "@...\uC6B0\uB9AC\uAC00 \uACB0\uD63C\uD588\uB2E4\uB294 \uC0AC\uC2E4\uC774 \uC544\uC9C1\uB3C4 \uC548 \uBBFF\uACA8...$l",
  "Good_1": "\uB098\uB97C \uC678\uB85C\uC6C0\uC73C\uB85C\uBD80\uD130 \uAD6C\uD574\uC92C\uC5B4, \uB0B4 \uB9C8\uC74C\uC18D\uC758 \uBE48 \uACF5\uAC04\uB3C4 \uCC44\uC6CC\uC92C\uACE0. \uACE0\uB9C8\uC6CC.$l",
  "Good_2": "\uB124\uAC00 \uC5EC\uAE30 \uC774\uC0AC \uC628 \uC21C\uAC04\uBD80\uD130 \uB0B4 \uC778\uC0DD\uC740 \uB108\uC640 \uD568\uAED8\uD560 \uAC70\uB780 \uAC78 \uC54C\uC558\uC5B4...$l",
  "Good_3": "\uC640\uC6B0, \uC624\uB298 \uC815\uB9D0 \uC798\uC0DD\uACBC\uB294\uAC78! \uBA74\uB3C4\uD55C \uAC70\uC57C?$l^\uC624, \uC138\uC0C1\uC5D0... \uC624\uB298 \uC544\uB984\uB2E4\uC6CC \uBCF4\uC5EC.$l",
  "Good_6": "\uAF2D \uC870\uC2EC\uD574! \uB098 \uAC00\uB054 \uB124\uAC00 \uBAB8\uC774 \uCD95 \uCC98\uC9C4 \uCC44\uB85C \uC751\uAE09\uC2E4\uB85C \uC2E4\uB824 \uB4E4\uC5B4\uC624\uB294 \uC545\uBABD\uC744 \uAFD4.$7",
  "funLeave_Harvey": "\uC624\uB298\uC740 \uC0B0\uCC45 \uC880 \uD558\uB824\uACE0. \uAE34\uC7A5 \uC880 \uD480\uC5B4\uC57C\uACA0\uC5B4.",
  "funReturn_Harvey": "\uC624\uB298 \uD558\uB8E8 \uC88B\uC558\uC5B4. \uAC00\uB054 \uD63C\uC790\uB9CC\uC758 \uC2DC\uAC04\uC744 \uBCF4\uB0B4\uB294 \uAC83\uB3C4 \uC0C1\uCF8C\uD558\uC9C0. \uC624\uB298 \uC88B\uC740 \uD558\uB8E8 \uBCF4\uB0C8\uC5B4, \uC5EC\uBCF4?",
  "spring_1": "\uC2DD\uBB3C\uB4E4\uC774 \uC0B4\uC544\uB3CC\uC544\uC624\uB294 \uAC83\uC744 \uBCF4\uB2C8 \uC88B\uB124. \uD751\uBC31\uC758 \uACA8\uC6B8\uC774 \uC9C0\uB098\uACE0 \uB098\uC11C \uB179\uC0C9\uC774 \uBCF4\uC774\uB2C8 \uC2E0\uC120\uD574.",
  "spring_12": "\uC624, \uB0B4\uC77C \uCD95\uC81C\uB0A0\uC774\uC9C0, \uADF8\uCE58? \uC0AC\uB78C\uB3C4 \uB9CE\uACE0, \uD65C\uB3D9\uB3C4 \uB9CE\uACE0... *\uAFC0\uAEBD*$s",
  "spring_23": "\uB0B4...\uB0B4\uC77C \uC800\uC640 \uCDA4\uC744 \uCD94\uC2DC\uACA0\uC5B4\uC694?$7#$e#\uC774\uAC74 \uB9E4\uBC88 \uBD80\uB044\uB7FD\uB124.$7",
  "summer_1": "\uD587\uBCD5\uC5D0 \uD0C0\uC9C0 \uC54A\uB3C4\uB85D \uC870\uC2EC\uD574, \uC5EC\uBCF4! \uD53C\uBD80\uC5D0 \uC544\uC8FC \uC704\uD5D8\uD55C \uC77C\uC774\uC57C.$8#$e#\uB2F9\uC2E0\uC758 \uB0A8\uD3B8\uACFC \uC758\uC0AC\uB85C\uC11C, \uB2F9\uC2E0\uC758 \uAC74\uAC15\uACFC \uC548\uC804\uC740 \uB0B4\uAC8C \uCD5C\uC6B0\uC120\uC774\uB77C\uACE0!",
  "summer_10": "\uB8E8\uC544\uC6B0 \uC2A4\uD504\uC5D0 \uC5B4\uB5A4 \uAC78 \uB123\uC744\uC9C0 \uC0DD\uAC01\uD574\uBD24\uC5B4?#$e#\uD488\uC9C8\uB3C4 \uAC00\uCE58\uB3C4 \uB192\uC740 \uAC78 \uB123\uB294 \uAC8C \uC88B\uC744 \uAC83 \uAC19\uC544. \uB3C4\uC9C0\uC0AC\uB2D8\uAED8 \uC88B\uC740 \uC778\uC0C1 \uB0A8\uACA8\uC57C\uC9C0!",
  "summer_27": "\uC5EC\uB984\uC774 \uB05D\uB098\uACE0 \uB0A0\uC774 \uCD94\uC6CC\uC9C0\uBA74\uC11C \uB0B4 \uD560 \uC77C\uB3C4 \uC810\uC810 \uB298\uACA0\uC9C0. \uB0B4\uAC00 \uAE30\uBD84\uC774 \uC880 \uC548 \uC88B\uC544 \uBCF4\uC778\uB2E4\uBA74 \uBBF8\uC548\uD574...",
  "fall_1": "\uC5EC\uBCF4, \uC774\uBC88 \uAC00\uC744\uC740 \uAF2D \uC791\uBB3C\uC744 \uB2E4\uC591\uD558\uAC8C \uC2EC\uB294 \uAC70 \uC78A\uC9C0 \uB9D0\uACE0.#$e#\uC544\uB2C8\uBA74 \uADF8\uB0E5 \uC628\uD1B5 \uD06C\uB79C\uBCA0\uB9AC\uB97C \uD0A4\uC6B0\uAC70\uB098... \uC0AC\uC2E4 \uC804\uC801\uC73C\uB85C \uC5EC\uBCF4 \uACB0\uC815\uC774\uC9C0. \uB09C \uB18D\uACBD \uC9C0\uC2DD\uC774 \uC5C6\uB294 \uAC78?",
  "fall_15": "\uB0B4\uC77C\uC774 \uCD95\uC81C\uB124. \uC74C\uC2DD\uC774 \uAE30\uB984\uC9C0\uACE0 \uC5FC\uBD84\uC774 \uB9CE\uC9C0\uB9CC, \uAC00\uB054\uC740 \uC2E4\uCEF7 \uBA39\uB294 \uAC83\uB3C4 \uC88B\uC9C0.$h",
  "fall_26": "\uC778\uC815\uD560\uAC8C, \uC601\uB839\uC758 \uC804\uC57C\uC81C \uC0DD\uAC01\uD558\uBA74 \uBC30\uAC00 \uC544\uD30C... \uD558\uC9C0\uB9CC \uCD5C\uC120\uC744 \uB2E4\uD574\uC11C \uC6A9\uAE30 \uB0B4\uBCFC\uAC8C.",
  "winter_1": "\uACA8\uC6B8\uC5D0\uB294 \uACF5\uAE30\uAC00 \uB9CE\uC774 \uAC74\uC870\uD558\uC9C0. \uADF8\uB798\uC11C \uD53C\uBD80\uAC00 \uC57D\uD574\uC9C0\uB294 \uAC70\uACE0.#$e#\uAC71\uC815\uD560 \uD544\uC694 \uC5C6\uC5B4, \uBC24\uB9C8\uB2E4 \uB4F1\uC5D0 \uC1A1\uB85C\uBC84\uC12F \uC624\uC77C \uC870\uAE08 \uBC1C\uB77C\uC904\uAC8C.$l",
  "winter_7": "\uC6B0\uB9AC \uB0B4\uC77C \uC5BC\uC74C \uCD95\uC81C \uC7A0\uAE50 \uAC08\uAE4C? \uC774\uAE00\uB8E8\uAC00 \uC815\uB9D0 \uB9C8\uC74C\uC5D0 \uB4DC\uB294\uB370...",
  "winter_28": "\uC790, \uC6B0\uB9AC \uB0B4\uB144\uB3C4 \uBA4B\uC9C4 \uD55C\uD574 \uBCF4\uB0B4\uC57C\uC9C0. \uB0B4\uB144\uC774 \uD6E8\uC52C \uB354 \uC88B\uC744 \uAC70\uB77C\uACE0 \uB09C \uD655\uACE0\uD558\uAC8C \uBBFF\uC5B4!$h"
}