{
  "Introduction": "\uC548\uB155\uD558\uC2E0\uAC00! \uC80A\uC740 \uC0AC\uB78C\uC774 \uACC4\uACE1\uC5D0 \uC774\uC0AC\uC624\uB294 \uAC78 \uBCF4\uB2C8 \uC88B\uAD6C\uBA3C. \uC694\uC998 \uD754\uD55C \uC77C\uC740 \uC544\uB2C8\uC9C0.",
  "AcceptGift_(O)StardropTea": "\uB0B4 \uD30C\uC774\uD504\uC758 \uB9C9\uB300\uC5EC... \uBCC4\uBC29\uC6B8\uCC28\uB77C\uB2C8! \uC778\uC5B4 \uC804\uC124\uC5D0\uB098 \uB098\uC624\uB294 \uBB3C\uAC74\uC778 \uC904 \uC54C\uC558\uB124. \uACE0\uB9C8\uC6CC.",
  "AcceptGift_(O)Book_Crabbing": "\uADF8\uB824... \uC138\uC6D4\uC774 \uD758\uB7EC\uB3C4 \uC774\uAC74 \uACE0\uC804\uC774\uC9C0. \uC77D\uC744 \uB54C\uB9C8\uB2E4 \uB208\uAC00\uAC00 \uCD09\uCD09\uD574\uC9C0\uB294\uAD6C\uBA3C. \uB09A\uC2DC\uAFBC\uC774\uB77C\uBA74 \uBA87 \uAD8C\uC774\uACE0 \uC788\uC5B4\uC57C \uD560 \uCC45\uC774\uC57C! \uACE0\uB9D9\uB124.$h",
  "AcceptGift_(O)Book_Roe": "\uACE0\uB9D9\uB124! \uACA8\uC6B8\uCCA0\uC5D0 \uC77D\uAE30 \uB531 \uC88B\uC740 \uCC45\uC774\uC9C0. \uC544, \uBC14\uB2E4 \uB0C4\uC0C8\uAE4C\uC9C0 \uB098\uB294\uAD6C\uBA3C...$h",
  "AcceptGift_(O)SkillBook_1": "\uC544, \u0027\uBBF8\uB07C\uC640 \uCC0C\u0027... \uB09A\uC2DC\uAFBC\uC774\uB77C\uBA74 \uAD6C\uB3C5\uD558\uB294 \uAC8C \uB9DE\uC9C0\uB9CC, \uC800\uB834\uD558\uC9C4 \uC54A\uB2E4\uB124. \uC138\uC6D4\uC5D0 \uAC78\uCCD0 \uB0B4\uAC8C \uB9CE\uC740 \uB09A\uC2DC \uD301\uC744 \uAC00\uB974\uCCD0 \uC92C\uC9C0. \uACE0\uB9D9\uB124!$h",
  "AcceptGift_Positive_coffee_item": "\uC544, \uBF1B\uC18D\uAE4C\uC9C0 \uB530\uB048\uD558\uAC8C \uB370\uC6CC\uC8FC\uB124. \uACE0\uB9C8\uC6CC.",
  "GreenRain": "\uADF8\uB824... \uC774\uC0C1\uD55C \uBE44\uAC00 \uC0DD\uC120\uC5D0\uAC8C \uC601\uD5A5\uC744 \uC8FC\uBA74 \uC548 \uB420 \uD150\uB370... \uB0B4 \uC778\uC0DD\uC774 \uAC78\uB9B0 \uC77C\uC774\uC57C!",
  "GreenRainFinished": "\uC74C, \uC0DD\uC120\uB4E4\uC740 \uC5EC\uC804\uD788 \uAC74\uAC15\uD558\uB354\uAD70. \uC624\uD788\uB824 \uC608\uC804\uBCF4\uB2E4 \uB354 \uD798\uCC28\uAC8C \uBB34\uB294 \uB290\uB08C\uC774\uC57C!",
  "GreenRain_2": "\uC0DD\uC120\uB4E4\uC774 \uC774 \uBE44\uB97C \uC88B\uC544\uD55C\uB2E4\uBA74, \uB098\uB3C4 \uC774 \uBE44\uAC00 \uC88B\uB2E4\uB124.",
  "accept_869": "\uC544... \uB0B4\uAC00 \uC7A1\uC73C\uB824\uB358 \uBA54\uAE30\uAC00 \uC788\uB294\uB370, \uADF8 \uBBF8\uB07C\uB77C\uBA74 \uC644\uBCBD\uD558\uACA0\uAD6C\uBA3C!#$b#\uC5EC\uAE30, \uC774\uAC70\uB791 \uAD50\uD658\uD574 \uC904\uAC8C. \uC815\uD655\uD788 \uBB54\uC9C0\uB294 \uC798 \uBAA8\uB974\uACA0\uC9C0\uB9CC, \uC5BC\uB9C8 \uC804\uC5D0 \uD574\uBCC0\uC5D0 \uB5A0\uB0B4\uB824\uC654\uB124.#$b#\uBB54\uAC00 \uC790\uB124\uD55C\uD14C \uC720\uC6A9\uD560 \uAC83 \uAC19\uC544 \uBCF4\uC774\uB124.",
  "AcceptGift_(O)682": "\uC774\uB7F0 \uB054\uCC0D\uD55C! ...\uC774\uAC74 \uBB34\uC2A8 \uAD34\uBB3C\uC774\uB780 \uB9D0\uC778\uAC00?",
  "AcceptGift_(O)336": "*\uC544\uADF8\uC791*... \uADF8\uB824, \uC9C4\uC9DC \uAE08\uC774 \uB9DE\uAD6C\uBA3C. \uD558\uD558! \uBA4B\uC9C4 \uC120\uBB3C\uC774\uC57C!$h",
  "married": "\uB3C5\uC2E0 \uC0DD\uD65C\uC740 \uC774\uC81C \uD3EC\uAE30\uD558\uB294 \uAC74\uAC00?#$b#\uB09A\uC2DC\uD560 \uC2DC\uAC04\uB9CC\uC740 \uD3EC\uAE30\uD558\uC9C0 \uB9D0\uAC8C...",
  "fishCaught_160": "\uC544, \uC544\uADC0\uB97C \uC7A1\uC558\uAD6C\uB9CC, \uADF8\uB798? \uD76C\uADC0\uD55C \uC0DD\uC120\uC758 \uC138\uACC4\uB85C \uAC00\uB294 \uC88B\uC740 \u0027\uCCAB\uAC78\uC74C\u0027\uC774\uC9C0, \uADF8\uAC70.",
  "fishCaught_159": "\uADF8\uB798, \uB4DC\uB514\uC5B4 \uD06C\uB9BC\uC2A8\uD53C\uC26C\uB97C \uC815\uBCF5\uD588\uAD6C\uB9CC! \uB0A0 \uBA87 \uB144 \uB3D9\uC548 \uC870\uB871\uD55C \uC0DD\uC120\uC774\uC9C0. \uB0B4 \uC9D1 \uBC11\uC758 \uB098\uBB34\uB97C \uBB3C\uC5B4\uC11C \uB6AB\uC744 \uBED4\uB3C4 \uD588\uC5B4!",
  "fishCaught_163": "\uB0B4 \uD30C\uC774\uD504\uC758 \uB9C9\uB300\uC5EC... \u0027\uC804\uC124\uC758 \uBB3C\uACE0\uAE30\u0027\uB97C \uC7A1\uB2E4\uB2C8. \uC774\uB7F0\uB0A0\uC774 \uC62C\uAC70\uB77C \uC0DD\uAC01\uB3C4 \uBABB\uD588\uB124...$h#$b#\uADF8\uB798, \uC80A\uC740\uC774, \uC790\uB124\uAC00 \uD574\uB0C8\uB124... \uC624\uB7AB\uB3D9\uC548 \uC790\uB124\uB97C \uB2A5\uAC00\uD560 \uB09A\uC2DC\uAFBC\uC740 \uC774 \uACC4\uACE1\uC5D0 \uC5C6\uC5C8\uC9C0...$h^\uADF8\uB798, \uC544\uAC00\uC528, \uC790\uB124\uAC00 \uD574\uB0C8\uB124... \uC624\uB7AB\uB3D9\uC548 \uC790\uB124\uB97C \uB2A5\uAC00\uD560 \uB09A\uC2DC\uAFBC\uC740 \uC774 \uACC4\uACE1\uC5D0 \uC5C6\uC5C8\uC9C0...$h",
  "fishCaught_775": "\uC544, \uBE59\uD558\uACE0\uAE30\uB97C \uC7A1\uC558\uAD6C\uB9CC... \uB0B4 \uC0B4\uC544\uC0DD\uC804 \uADF8\uB807\uAC8C \uBBF8\uB044\uB7EC\uC6B4 \uC0DD\uC120\uC740 \uBABB \uBD24\uB2E4\uB124!#$e#\uADF8\uB798, \uBA87 \uBC88 \uB9CC\uC5D0 \uC131\uACF5\uD588\uB098?",
  "fishCaught_682": "*\uD081* *\uD081*... \uD558\uC218\uB3C4\uC5D0\uC11C \uB09A\uC2DC\uB97C \uD588\uB098 \uBCF4\uB124, \uC80A\uC740\uC774.^*\uD081* *\uD081*... \uD558\uC218\uB3C4\uC5D0\uC11C \uB09A\uC2DC\uB97C \uD588\uB098 \uBCF4\uB124, \uC544\uAC00\uC528.#$b#\uC0C9\uB2E4\uB978 \uB3C4\uC804\uC774\uAD70, \uADF8\uAC74 \uD655\uC2E4\uD574. \uAC70\uB300\uD55C \uC789\uC5B4\uC758 \uC804\uC124\uC774 \uC788\uB2E4\uB124, \uD558\uC218\uB3C4 \uD3D0\uAE30\uBB3C\uC5D0 \uC758\uD574 \uAD34\uBB3C \uAC19\uC740 \uBAA8\uC2B5\uC774 \uB418\uC5C8\uB2E4\uACE0 \uADF8\uB7EC\uB354\uAD70...",
  "FullCrabPond": "*\uD081*... \uC544... \uC775\uC219\uD55C \uC774 \uB0C4\uC0C8. \uC694\uC998 \uAC8C\uB97C \uD0A4\uC6B0\uAE30 \uC2DC\uC791\uD55C \uAC8C \uBD84\uBA85\uD558\uAD6C\uBA3C!#$b#@, \uC790\uB128 \uB098\uC640 \uAC19\uC740 \uB9C8\uC74C\uC744 \uAC00\uC9C4 ${\uB0A8^\uC5EC}$\uC798\uC138. \uD558!$h#$b#\uC5EC\uAE30, \uC774\uAC70 \uBC1B\uAC8C. \uD574\uBCC0\uC5D0\uC11C \uCC3E\uC558\uC5B4... \uD2B9\uBCC4\uD55C \uC77C\uC744 \uC704\uD574 \uC544\uAEF4\uB450\uACE0 \uC788\uC5C8\uC9C0. \uAC8C\uB97C \uC88B\uC544\uD558\uB294 \uC0AC\uB78C\uC744 \uCC3E\uB294 \uAC8C \uB9E4\uC77C \uC788\uB294 \uC77C\uC774 \uC544\uB2C8\uAC70\uB4E0! [797]",
  "MovieInvitation": "\uC544... \uC601\uD654\uB77C. \uCE5C\uC808\uD55C \uC80A\uC740\uC774\uC57C, \uC5ED\uC2DC.^\uC544... \uC601\uD654\uB77C. \uCE5C\uC808\uD55C \uC544\uAC00\uC528\uC57C, \uC5ED\uC2DC.#$b#\uC9C0\uAE08 \uD53C\uB358 \uD30C\uC774\uD504\uB9CC \uB9C8\uCE58\uACE0 \uAC00\uC11C \uBCF4\uACA0\uB124.",
  "summer_19": "\uB0B4\uC77C\uC740 \uC5F0\uAC04 \uC1A1\uC5B4 \uC2DC\uD569\uC77C\uC138... \uADF8\uB824, \uBBFC\uBB3C\uB09A\uC2DC\uAFBC\uC758 \uAFC8!#$e#\uC6B0\uB9AC \uC544\uB984\uB2E4\uC6B4 \uBB34\uC9C0\uAC1C \uC1A1\uC5B4\uB97C \uC7A1\uC73C\uB7EC \uC804 \uC138\uACC4\uC758 \uB09A\uC2DC\uAFBC\uB4E4\uC774 \uBAA8\uC5EC\uB4E4 \uAC70\uC57C...#$e#\uC790\uB124\uB3C4 \uAF2D \uC624\uAC8C, \uC80A\uC740\uC774!$h^\uC790\uB124\uB3C4 \uAF2D \uC624\uAC8C!$h#$e#\uC55E\uC73C\uB85C \uC774\uD2C0 \uB3D9\uC548 \uB09C \uC544\uCE68 9\uC2DC\uBD80\uD130 \uD55C \uC2DC\uAC04\uB9CC \uAC00\uAC8C\uB97C \uBCF4\uACA0\uB124. \uC815\uB9D0 \uD544\uC694\uD55C \uAC8C \uC788\uB2E4\uBA74 \uADF8\uB54C \uBC29\uBB38\uD574 \uC8FC\uAC8C.",
  "summer_20": "\uC624\uB298\uC774 \uADF8\uB0A0\uC774\uC57C! \uC7A5\uBE44\uB97C \uBAA8\uB450 \uC1A1\uC5B4\uC5D0 \uB9DE\uCDB0 \uC900\uBE44\uD588\uC5B4...#$e#\uD589\uC6B4\uC744 \uBE44\uB124!",
  "summer_21": "\uC2DC\uD569\uC740 \uC5B4\uB5A4\uAC00?#$b#\uB098\uC57C \uD669\uAE08 \uAF2C\uB9AC\uD45C\uB97C \uB9CE\uC774 \uCC3E\uC558\uC9C0... \uD558\uC9C0\uB9CC \uC544\uC9C1 \uB05D\uC774 \uC544\uB2D0\uC138!",
  "winter_11": "\uB0B4\uC77C \uD574\uBCC0\uC5D0 \uC791\uC740 \uBAA8\uC784\uC774 \uC788\uC9C0... \uBC14\uB85C \u0027\uC624\uC9D5\uC5B4 \uCD95\uC81C\u0027.#$e#\uADF8\uB824... \uC5B4\uB824\uC6B4 \uC0C1\uB300\uC57C, \uC624\uC9D5\uC5B4\uB294. \uD558\uC9C0\uB9CC \uC9C0\uAE08\uCBE4\uC774\uBA74 \uC790\uB124\uB3C4 \uB09A\uC2DC\uB97C \uC880 \uD130\uB4DD\uD588\uC744 \uAC70\uB77C \uBBFF\uB124.",
  "winter_12": "\uC544\uC9C1 \uD3EC\uAE30\uD558\uAE34 \uC77C\uB7EC! \uC544\uC9C1 \uBB3C\uC18D\uC5D4 \uC624\uC9D5\uC5B4\uAC00 \uB9CE\uB2E4\uACE0...",
  "winter_13": "\uCD94\uC6B4 \uACA8\uC6B8\uC5D0 \uB9C8\uC74C\uC774 \uB530\uB73B\uD574\uC9C0\uB124, \uB09A\uC2DC\uB97C \uC0AC\uB791\uD558\uB294 \uC0AC\uB78C\uB4E4\uC774 \uC774\uB807\uAC8C \uBAA8\uC5EC\uB4E0 \uAC78 \uBCF4\uAC8C\uB098...$h",
  "Mon": "\uC548\uB155\uD55C\uAC00, \uC80A\uC740\uC774.^\uC548\uB155\uD55C\uAC00, \uC544\uAC00\uC528.#$b#\uB09A\uC2DC\uD558\uAE30 \uC88B\uC740 \uB0A0\uC528 \uAC19\uB124, \uC548 \uADF8\uB7EC\uAC00?",
  "Mon4": "\uC774 \uC8FC\uBCC0\uC5D0\uC11C \uB09A\uC2DC \uC6B4\uC740 \uC880 \uC788\uC5C8\uB098? \uC790\uB124\uAC00 \uB178\uB825\uB9CC \uD55C\uB2E4\uBA74 \uAC15\uD55C \uB09A\uC2DC\uAFBC\uC774 \uB420 \uC790\uC9C8\uC774 \uC788\uC5B4 \uBCF4\uC774\uB124.",
  "Tue": "\uC9C4\uC815\uD55C \uB09A\uC2DC\uAFBC\uC740 \uBB3C\uC744 \uC874\uC911\uD574\uC57C \uD574... \uC78A\uC9C0 \uB9D0\uAC8C\uB098.",
  "Tue6": "\uC544\uBC84\uC9C0\uB3C4 \uB09A\uC2DC\uAFBC\uC774\uC168\uC9C0. \uC544\uBC84\uC9C0 \uB530\uB77C \uD398\uB978 \uC12C\uB3C4 \uC0AC\uC774\uB97C \uC624\uAC00\uACE0 \uD558\uB8E8\uD558\uB8E8 \uB09A\uC2DC\uD574\uBA39\uC73C\uBA74\uC11C \uC790\uB790\uC5B4.#$e#\uB09A\uC2DC\uAFBC\uC758 \uC0B6\uC740 \uAC70\uCE60\uC9C0\uB9CC, \uC5B4\uB5A4 \uC54C \uC218 \uC5C6\uB294, \uACC4\uC18D\uD558\uAC8C \uD558\uB294 \uBB34\uC5B8\uAC00\uAC00 \uC788\uC9C0.",
  "Wed": "\uACC4\uC808\uC774 \uC624\uAC00\uBA74\uC11C \uC0DD\uC120\uB3C4 \uC624\uAC00\uC9C0. \uC5B4\uB5A4 \uAC83\uB4E4\uC740 \uBC24\uC774\uB098 \uBE44 \uC62C \uB54C\uB9CC \uBCF4\uC774\uACE0.",
  "Wed6": "\uD3ED\uD3EC \uC0AC\uC774\uC758 \uBB3C\uC5D0\uC11C \uB09A\uC744 \uC218 \uC788\uB294 \uD2B9\uBCC4\uD55C \uC0DD\uC120\uC5D0 \uB300\uD55C \uC18C\uBB38\uC744 \uB4E4\uC5C8\uB124...#$b#\uB09A\uC2EF\uC904\uC774 \uAC70\uAE30\uAE4C\uC9C0 \uB2FF\uB294\uB2E4\uBA74 \uB9D0\uC774\uC9C0...",
  "Thu": "*\uC911\uC5BC* *\uC911\uC5BC* ...\uC5D0? \uB0B4\uAC00 \uBB34\uC2A8 \uC0DD\uAC01 \uD558\uB294\uC9C0 \uC54C\uB824\uC8FC\uACA0\uC9C0\uB9CC, \uB09A\uC2DC\uAFBC\uC758 \uBE44\uBC00\uC774\uB77C \uB9D0\uC774\uC9C0.",
  "Thu2": "\uC774 \uADFC\uBC29\uC5D0 \uC815\uB9D0 \uADC0\uD55C \uC0DD\uC120\uC774 \uC788\uB2E4\uB294 \uC18C\uBB38\uC774 \uC788\uC5B4... \uD558\uC9C0\uB9CC \uACBD\uD5D8 \uB9CE\uC740 \uB09A\uC2DC\uAFBC\uB9CC \uC81C\uB300\uB85C \uC7A1\uC744 \uC218 \uC788\uC744 \uAC70\uC57C.#$e#\uD76C\uADC0\uD55C \uC0DD\uC120\uC774 \uBB3C\uAE30\uB97C \uBC14\uB780\uB2E4\uBA74 \uCD5C\uACE0\uC758 \uBBF8\uB07C\uB97C \uC368\uC57C \uD560 \uAC78\uC138.",
  "Fri": "\uC0DD\uC120\uC774 \uC880 \uB9CE\uC774 \uBB3C\uAE30\uB97C \uBC14\uB780\uB2E4\uBA74, \uB09A\uC2EF\uBC14\uB298\uC5D0 \uAF2D \uBBF8\uB07C\uB97C \uC4F0\uAC8C\uB098.",
  "Fri4": "\uB098\uC57C \uC0AC\uB78C\uC774 \uB2E8\uC21C\uD574\uC11C... \uD30C\uC774\uD504\uAC00 \uAC00\uB4DD\uD558\uBA74 \uB09C \uD589\uBCF5\uD558\uC9C0. \uD30C\uC774\uD504\uAC00 \uBE44\uC5C8\uC73C\uBA74... \uBB50, \uADF8\uB7EC\uBA74 \uB2E4\uC2DC \uCC44\uC6B0\uC9C0.$u",
  "Sat": "\uC774 \uB3D9\uB124\uC5D0 \uB09A\uC2DC\uD558\uB294 \uC0AC\uB78C\uC774 \uC880 \uB9CE\uC544\uC9C4\uB2E4\uBA74, \uAC00\uAC8C \uBB3C\uD488\uC744 \uC880 \uB298\uB9B4 \uC218\uB3C4 \uC788\uC9C0.",
  "Sat8": "\uADF8\uB798, \uC790\uB124 \uB09A\uC2DC \uC778\uC0DD\uC740 \uC5B4\uB5BB\uAC8C \uC880 \uC798 \uB418\uC5B4\uAC00\uB294\uAC00?#$e#\uB098\uB3C4 \uCD5C\uB300\uD55C \uC790\uC8FC \uB09A\uC2DC\uB97C \uD558\uB824\uACE0 \uD558\uC9C0\uB9CC, \uAC00\uAC8C\uB97C \uC6B4\uC601\uD574\uC57C \uD574\uC11C \uC27D\uC9C0\uB9CC\uC740 \uC54A\uB124.",
  "Sun": "\uC880 \uB354 \uD488\uC9C8\uC774 \uC88B\uC740 \uB09A\uC2EF\uB300\uB97C \uAD6C\uD55C\uB2E4\uBA74, \uBBF8\uB07C\uC640 \uCD94\uAC00 \uC7A5\uBE44\uB97C \uC7A5\uCC29\uD560 \uC218 \uC788\uC744 \uAC78\uC138.#$b#\uBBF8\uB07C\uAC00 \uC788\uC73C\uBA74 \uC0DD\uC120\uC774 \uB354 \uBE68\uB9AC \uBB3C\uC9C0. \uB09A\uC2DC \uB3C4\uAD6C\uB294 \uBB3C\uACE0\uAE30\uB97C \uAC10\uC544 \uB4E4\uC77C \uB54C \uB354 \uC27D\uAC8C \uB9CC\uB4E4\uC5B4 \uC8FC\uC9C0.#$e#\uC7A5\uBE44\uB294 \uBCC4\uC758\uBCC4 \uC885\uB958\uAC00 \uB9CE\uC544, \uD558\uB098\uD558\uB098 \uB2E4 \uD2B9\uC131\uB3C4 \uB2E4\uB974\uC9C0. \uADFC\uB370 \uBCF4\uD1B5 \uC57D\uD55C \uD3B8\uC774\uB77C, \uC870\uAE08 \uC4F0\uB2E4\uAC00 \uB9DD\uAC00\uC838\uB3C4 \uB108\uBB34 \uB180\uB77C\uC9C4 \uB9D0\uAC8C.",
  "Sun10": "\uC774\uC57C, \uC774\uAC70 \uB0B4 \uC120\uC7A5\uB2D8, @(\uC774)\uC796\uC544!$h#$e#\uB0B4\uAC00 \uC5EC\uC720\uB9CC \uB418\uC5C8\uC5B4\uB3C4 \uBBF8\uB07C \uAC00\uACA9 \uC880 \uD560\uC778\uD574\uC8FC\uB294 \uAC74\uB370 \uB9D0\uC774\uC9C0.$s",
  "Fair_Judging": "\uC774\uAE38 \uAC00\uB2A5\uC131\uC740 \uBCC4\uB85C \uC5C6\uB294 \uAE30\uBD84\uC778\uAC78... \uC0DD\uC120\uC774 \uBA4B\uC838 \uBCF4\uC5EC\uB3C4 \uB0C4\uC0C8\uAC00 \uADF8\uB807\uAC8C \uC88B\uC9C4 \uC54A\uB124...$s",
  "Fair_Judged": "\uC640, \uC810\uC218\uAC00 \uCC98\uB7C9\uD558\uB124. \uB8E8\uC774\uC2A4 \uC2DC\uC7A5\uC740 \uC0DD\uC120\uC740 \uBCC4\uB85C \uC548 \uC88B\uC544\uD558\uB098 \uBD10. \uC5B4\uCA54 \uC218 \uC5C6\uC9C0...$s"
}