  "Sun2": "\uC8FC\uB9D0 \uC798 \uBCF4\uB0B4\uACE0 \uC788\uC5B4? ...\uC88B\uB124.",
  "Sun4": "\uBCF4\uD1B5 \uBC16\uC5D0 \uC548 \uB098\uAC00\uB294 \uD3B8\uC778\uB370, \uAC00\uB054 \uD574\uBCC0\uC5D0 \uAC00\uAE34 \uD574.#$b#\uBE44\uAC00 \uC62C \uB54C\uB9CC \uAC00, \uADFC\uB370.#$e#\uC65C \uADF8\uB7F0\uC9C0\uB294 \uBAA8\uB974\uACA0\uB294\uB370, \uD669\uB7C9\uD55C \uC218\uD3C9\uC120\uC744 \uBCF4\uACE0 \uC788\uC73C\uBA74... \uBAA8\uB974\uACA0\uB2E4. \uACC4\uC18D \uB178\uB825\uD560\uB9CC\uD558\uB2E4\uB294 \uB290\uB08C\uC774 \uB4E0\uB2EC\uAE4C.",
  "Fri8": "\uC694\uC998 \uC5B4\uB54C?$h#$e#\uB09C \uC624\uB298 \uBC24\uC5D0\uB3C4 \uC8FC\uC810\uC5D0 \uAC00\uC11C \uD3EC\uCF13\uBCFC\uB85C \uC0D8\uC744 \uD63C\uCB50\uB0B4\uC918\uC57C \uD574.$h",
  "Sun10": "\uC5B4, \uC548 \uADF8\uB798\uB3C4 \uB124 \uC0DD\uAC01 \uD558\uACE0 \uC788\uC5C8\uC5B4...$l",
  "Event_game1": "\uADF8\uB798, \uADF8\uAC83\uB3C4 \uAD1C\uCC2E\uC9C0.",
  "Event_game2": "\uC88B\uC740 \uC120\uD0DD\uC774\uC57C. \uB0B4 \uCE90\uB9AD\uD130\uB791\uB3C4 \uC798 \uB9DE\uB124.",
  "Event_cave1": "\uC7A0\uAE50\uB9CC! \uBB54\uC9C0 \uC54C\uACE0 \uC2F6\uC5B4.",
  "Event_cave2": "\uC815\uB9D0? \uC18C\uB9AC \uC5C4\uCCAD \uB0B4\uACE0 \uC788\uC5C8\uB294\uB370!",
  "Event_cave3": "\uCE7C \uC5C6\uC774 \uAC00\uB294 \uAC74 \uB108\uBB34 \uC704\uD5D8\uD574. \uADFC\uB370 \uADF8 \uBAA8\uD5D8\uC2EC\uC740 \uB9C8\uC74C\uC5D0 \uB4E0\uB2E4.$h",
  "event_garage1": "\uC88B\uC544.$8",
  "event_garage2": "\uADF8\uB798... \uADF8\uB7FC \uB9D0\uACE0.$9",
  "event_garage3": "\uAC71\uC815\uD558\uC9C0 \uB9C8, \uC704\uD5D8\uD55C \uC77C\uC744 \uC2DC\uB3C4\uD558\uAE30 \uC804\uC5D0 \uC77C\uB2E8 \uAE30\uBCF8\uBD80\uD130 \uD655\uC2E4\uD788 \uC54C\uB824\uC904 \uD14C\uB2C8\uAE4C.$8^\uAC71\uC815\uD560 \uD544\uC694 \uC5C6\uC5B4... \uB124\uAC00 \uC548\uC804\uC740 \uB0B4\uAC00 \uC9C0\uD0AC \uAC70\uC57C.$8",
  "event_city1": "\uC74C... \uB0B4\uAC00 \uC4F8 \uD45C\uD604\uC740 \uC544\uB2C8\uC9C0\uB9CC, \uADF8\uB807\uAE34 \uD574.",
  "event_city2": "\uC751... \uB098\uB3C4 \uB531 \uADF8\uB7F0 \uAE30\uBD84\uC774\uC57C.$l",
  "event_city3": "\uC624... \uB110 \uB370\uB9AC\uACE0 \uC62C \uC7A5\uC18C\uAC00 \uC544\uB2C8\uC5C8\uB098 \uBCF4\uB2E4 \uADF8\uB7FC. \uC774 \uACBD\uCE58\uC758 \uC544\uB984\uB2E4\uC6C0\uC744 \uB108\uB3C4 \uAC10\uC0C1\uD560 \uC218 \uC788\uC5C8\uC73C\uBA74 \uC88B\uC558\uC744 \uD150\uB370.$s",
  "event_city4": "\uC73C... \uB0B4 \uC5C4\uB9C8 \uAC19\uC740 \uC18C\uB9AC \uD558\uB124.$a#$b#...*\uD55C\uC228*$s#$b#\uB124 \uB9D0\uC774 \uB9DE\uAE34 \uD574, \uADFC\uB370. \uC774\uAC74 \uC911\uB3C5\uC774\uACE0, \uC88B\uC9C0 \uC54A\uC544.$s",
  "summer_Mon": "\uB2E4\uB4E4 \uD587\uBE5B\uC744 \uBC1B\uC73C\uBA70 \uD589\uBCF5\uD574\uD558\uB124. \uC774\uD574\uAC00 \uC548 \uB3FC.",
  "summer_Mon6": "\uB2E4\uB4E4 \uB0A0\uC774 \uB9D1\uC73C\uBA74 \uC88B\uC544\uD558\uB124...#$e#\uBB50, \uB2E4\uB4E4 \uAC01\uC790 \uC88B\uC544\uD558\uB294 \uAC8C \uB2E4\uB978 \uAC70\uACA0\uC9C0.||\uB2E4\uB4E4 \uB0A0\uC528 \uB9D1\uC740 \uAC78 \uC88B\uC544\uD558\uC9C0?#$b#\uBE44\uD0C0\uBBFC D\uAC00 \uD544\uC694\uD558\uAE34 \uD558\uACA0\uC9C0...",
  "summer_Tue": "\uC0AC\uC2E4 \uC880 \uB354 \uCDA5\uACE0 \uC2B5\uD55C \uACC4\uC808\uC774 \uAE30\uB300\uB3FC. \uC880 \uB354 \uB9C8\uC74C\uC774 \uB193\uC774\uB354\uB77C\uACE0.",
  "summer_Tue4": "\uCDA5\uACE0 \uC2B5\uD55C \uACC4\uC808\uC744 \uAE30\uB300\uD558\uB294 \uC911\uC774\uC57C. \uB0B4 \uB0B4\uBA74\uC758 \uB450\uAEBC\uBE44\uAC00 \uAE30\uB300\uD558\uB294 \uAC78\uC9C0\uB3C4.$h",
  "summer_Wed": "\uBC16\uC5D0 \uBB50 \uD558\uB7EC \uB098\uAC00? \uC774\uBBF8 \uB2E4 \uBCF8 \uC801 \uC788\uB294 \uAC74\uB370.",
  "summer_Wed6": "\uC6B0\uC6B8\uD560 \uB54C\uBA74 \uBAA8\uB4E0 \uAC8C \uBA4D\uCCAD\uD55C \uC77C \uAC19\uC544. \uD558\uC9C0\uB9CC \uAE30\uBD84\uC774 \uAE0D\uC815\uC801\uC774\uBA74 \uD3C9\uBC94\uD55C \uAC83\uB4E4\uB9CC \uBD10\uB3C4 \uD589\uBCF5\uD558\uC9C0.#$e#\uC5B4\uB5BB\uAC8C \uC624\uB7AB\uB3D9\uC548 \uAE0D\uC815\uC801\uC77C \uC218 \uC788\uC744\uAE4C? \uB09C \uC9C4\uC9DC \uBAA8\uB974\uACA0\uC5B4.#$e#...\uC5B8\uC820\uAC00 \uC54C\uAC8C \uB418\uB824\uB098.",
  "summer_Wed10": "\uC65C \uC6C3\uACE0 \uC788\uB0D0\uACE0? \uC694\uC998 \uC774\uC0C1\uD560 \uC815\uB3C4\uB85C \uD589\uBCF5\uD574\uC11C \uADF8\uB798...$l",
  "summer_Thu": "\uB098 \uC808\uB300 \uC218\uC601\uD558\uB7EC \uC548\uAC00, \uBB3C\uC5B4\uBCF4\uAE30 \uC804\uC5D0 \uC598\uAE30\uD574\uB458\uAC8C.$s#$e#\uC5B4, \uADF8\uB0E5 \uC778\uC0AC\uD558\uB7EC \uC628 \uAC70\uB77C\uACE0? \uBBF8\uC548.",
  "summer_Thu10": "\uB124\uAC00 \uC218\uC601 \uAC00\uC790\uACE0 \uD558\uBA74... \uAC00\uAE34 \uAC08 \uAC70 \uAC19\uC544.$l",
  "summer_Mountain_58_35": "#$c .5#\uD574\uAC00 \uC9C0\uACE0 \uB098\uC11C\uC57C \uC880 \uD3B8\uC548\uD55C \uC628\uB3C4\uAC00 \uB418\uB354\uB77C.#$e#\uADF8\uB798\uB3C4 \uD638\uC218 \uCABD\uC774 \uD56D\uC0C1 \uC880 \uB354 \uC2DC\uC6D0\uD55C \uAC83 \uAC19\uC544.",
  "summer_Fri": "\uC5B4, \uC548\uB155. *\uD558\uD488*",
  "summer_Fri6": "\uC5B4, \uC640\uC918\uC11C \uACE0\uB9C8\uC6CC.$h#$e#\uB354\uC6B4\uB370 \uC5B4\uB5BB\uAC8C \uC9C0\uB0B4\uACE0 \uC788\uC5B4?",
  "summer_Sat": "\uC624\uB298 \uC800\uB141\uC774 \uBC84\uC12F \uCE90\uC11C\uB864\uC774 \uC544\uB2C8\uC5C8\uC73C\uBA74 \uC88B\uACA0\uB294\uB370...$s||\uC624 \uC548\uB3FC, \uB3D9\uAD74 \uB2F9\uADFC \uD0C0\uCF54 \uBA39\uB294 \uB0A0\uC774\uB2E4...*\uC73C\uC73C*$s",
  "spring_12": "\uC0AC\uC2E4 \uCD95\uC81C\uB294 \uBCC4\uB85C \uC548 \uC88B\uC544\uD574. \uB108\uBB34 \uC2DC\uB04C\uBC85\uC801\uD558\uACE0, \uC0AC\uB78C\uB3C4 \uB108\uBB34 \uB9CE\uC774 \uB9C8\uC8FC\uCE58\uACE0... \uB0B4 \uC785\uC7A5\uC5D0\uC120 \uC7AC\uBBF8 \uBCF4\uB2E8 \uC2A4\uD2B8\uB808\uC2A4\uAC00 \uB9CE\uC544.",
  "spring_23": "\uC544... \uB0B4\uC77C \uCD95\uC81C\uAC00 \uC9C4\uC9DC \uCD5C\uC545\uC774\uC57C. \uCDA4\uCD9C \uB54C \uB0B4 \uBAA8\uC2B5\uC774 \uC5BC\uB9C8\uB098 \uBC14\uBCF4 \uAC19\uC744\uC9C0 \uAE30\uB300\uD574\uBD10.",
  "fall_20": "\uC601\uB839\uC758 \uC804\uC57C\uC81C \uAE30\uB300\uD558\uACE0 \uC788\uC5B4? \uB0B4\uAC00 \uC81C\uC77C \uC88B\uC544\uD558\uB294 \uCD95\uC81C \uAC19\uC544.$h",
  "fall_26": "\uB0B4\uC77C\uC774 \uC601\uB839\uC758 \uC804\uC57C\uC81C\uC57C. \uC62C\uD574\uB3C4 \uADF8 \uD574\uACE8 \uC7A5\uC2DD \uC788\uC5C8\uC73C\uBA74 \uC88B\uACA0\uB2E4.$h#$e#\uC774\uCBE4 \uB418\uB2C8\uAE4C \uADF8 \uD574\uACE8\uB4E4\uC774 \uAC70\uC758 \uB0B4 \uCE5C\uAD6C\uAC00 \uB41C \uB290\uB08C\uC774\uC57C.",
  "summer_10": "\uD5E4\uD5E4... \uB0B4\uC77C \uD3EC\uD2B8\uB7ED \uB54C \uC5ED\uACA8\uC6B4 \uAC78 \uB123\uB294 \uAC83\uB3C4 \uC7AC\uBC0C\uC744 \uAC83 \uAC19\uC544. \uADF8\uB807\uB2E4\uACE0 \uB204\uAD6C \uB3C5\uC0B4\uD558\uC9C4 \uB9D0\uACE0.#$e#\uC65C \uD3EC\uD2B8\uB7ED\uC744 \uB9DD\uCE58\uB0D0\uACE0? \uD760... \uC0AC\uD68C\uC758 \uBEE3\uBEE3\uD55C \uAD6C\uC870\uAC00 \uC870\uAE08 \uBB34\uB108\uC838\uB0B4\uB824\uC57C \uC228\uD1B5\uC774 \uD2B8\uC774\uB294 \uAE30\uBD84\uC774 \uB4DC\uB294 \uC0AC\uB78C\uC774 \uC788\uB294 \uAC78\uC9C0\uB3C4. \uC544\uB2C8\uBA74 \uADF8\uB0E5 \uB0B4\uAC00 \uC774\uC0C1\uD55C \uAC78\uC9C0\uB3C4.",
  "summer_27": "\uC624\uB298 \uBD80\uB450\uC5D0 \uBAA8\uC5EC\uC11C \uB2EC\uBE5B \uD574\uD30C\uB9AC\uB4E4\uC774 \uC774\uC8FC\uD558\uB294 \uAC78 \uAD6C\uACBD\uD560 \uAC70\uC57C. \uC5F4\uC2DC\uC5D4\uAC00 \uC2DC\uC791\uD558\uB294 \uAC70 \uAC19\uB358\uB370.",
  "winter_24": "\uC624\uB298\uC774 \uACA8\uC6B8 \uBCC4\uC758 \uB9CC\uCC2C \uC804\uC57C\uB124. \uB0B4\uC77C \uB9CE\uC774 \uBA39\uC73C\uB824\uBA74 \uC624\uB298\uBD80\uD130 \uC18D\uC744 \uBE44\uC6CC\uB194\uC57C \uD574.",
  "summer_Sun": "\uB09C \uBCF4\uD1B5 \uC5B4\uB450\uC6CC\uC9C0\uACE0 \uB098\uC11C \uBC16\uC5D0 \uB098\uAC00. \uC880 \uC774\uC0C1\uD55C \uAC83 \uAC19\uC544?",
  "summer_Sun4": "\uC5B4\uC82F\uBC24\uC5D0 \uD638\uC218 \uADFC\uCC98\uC5D0 \uBC15\uC950 \uD55C\uBB34\uB9AC\uAC00 \uB0A0\uC544\uB2E4\uB2C8\uB294 \uAC78 \uBD24\uC5B4.#$e#\uC774\uB9D8\uB54C \uBAA8\uAE30\uB97C \uBA39\uB294 \uAC74\uAC00?",
  "fall_Mon": "\uADF8\uB798... \uCD94\uC218 \uD55C\uBC88 \uD06C\uAC8C \uD560 \uACC4\uC808\uC774\uB124, \uADF8\uCE58?",
  "fall_Mon4": "\uB18D\uC7A5\uC77C \uD574\uC11C \uB3C8 \uB9CE\uC774 \uBC8C\uACE0 \uC788\uACA0\uB2E4, \uADF8\uCE58?#$e#\uB098\uB3C4 \uACE7 \uC77C\uAC70\uB9AC\uB97C \uCC3E\uC544\uC57C \uD560 \uD150\uB370...$s",
  "fall_Tue": "\uC774\uAC83\uB3C4 \uD38C\uD0A8 \uC2A4\uD30C\uC774\uC2A4... \uC800\uAC83\uB3C4 \uD38C\uD0A8 \uC2A4\uD30C\uC774\uC2A4... \uC544, \uACC4\uC808 \uC720\uD589 \uC9C4\uC9DC \uC9C8\uB9B0\uB2E4.",
  "fall_Tue6": "\uB4DC\uBBF8\uD2B8\uB9AC\uC6B0\uC2A4\uB294 \uBB54 \uC0DD\uAC01\uC778 \uAC70\uC9C0, \uB098\uBCF4\uACE0 \uC774\uB798\uB77C\uC800\uB798\uB77C \uD558\uACE0? \uB0B4 \uC9C4\uC9DC \uC544\uBE60\uB3C4 \uC544\uB2C8\uBA74\uC11C.$a",
  "fall_Tue10": "\uD56D\uC0C1 \uB0B4\uAC00 \uBD88\uB9AC\uD55C \uCABD\uC774\uB77C\uB294 \uAE30\uBD84\uC774 \uB4E4\uC5C8\uC5B4. \uD558\uC9C0\uB9CC \uB3C4\uC804\uC744 \uADF9\uBCF5\uD558\uACE0 \uB09C \uB354 \uAC15\uD574\uC9C8 \uAC70\uC57C.",
  "fall_Wed": "*\uD558\uD488*... \uBA87 \uC2DC\uC57C? \uB098 \uC5B4\uC82F\uBC24\uC5D0 \uB108\uBB34 \uB9CE\uC774 \uC7A4\uB098 \uBD10.",
  "fall_Wed8": "\uC624, \uC640\uC918\uC11C \uBC18\uAC11\uB2E4. \uC2EC\uC2EC\uD574\uC9C0\uACE0 \uC788\uC5C8\uB294\uB370.#$e#\uBBFF\uAC70\uB098 \uB9D0\uAC70\uB098, \uC9C0\uAE08 \uAC11\uC790\uAE30 \uAE30\uC6B4\uC774 \uB9C9 \uB098\uACE0 \uC788\uC5B4.",
  "fall_Thu": "\uBC29\uC5D0 \uCC3D\uBB38\uC774\uB77C\uB3C4 \uC788\uC5C8\uB2E4\uBA74 \uC880 \uB35C \uC6B0\uC6B8\uD588\uC744 \uAC83 \uAC19\uC544...$s",
  "fall_Fri": "*\uD558\uD488*... \uC0C8 \uCC45 \uC77D\uB2E4\uAC00 3\uC2DC\uC5D0 \uC7A0\uB4E4\uC5C8\uC5B4...#$q 62/63 fall_Fri_old#@, \uB108\uB3C4 \uCC45 \uC77D\uC5B4?#$r 62 -30 Fri_bad#\uC751. \uACE0\uC804\uB4E4\uB85C.#$r 63 30 Fri_good#\uACF5\uC0C1\uACFC\uD559\uD558\uACE0 \uD310\uD0C0\uC9C0\uB9CC#$r 62 0 Fri_bad#\uB85C\uB9E8\uC2A4 \uC774\uC57C\uAE30 \uC88B\uB354\uB77C#$r 63 -30 Fri_bad#\uC544\uB2C8, \uCC45\uC740 \uC548 \uC77D\uC5B4",
  "fall_Fri_old": "$p 62#\uB10C \uBCC4\uB85C \uC548 \uC88B\uC544\uD558\uACA0\uB2E4.$s|\uB108\uB3C4 \uBD84\uBA85 \uC88B\uC544\uD560 \uAC70\uC57C.",
  "fall_Fri_good": "\uC5B4, \uB098\uB3C4. \uC0C1\uC0C1\uC744 \uC790\uADF9\uD558\uB294\uB370 \uC88B\uC740 \uC18C\uC124\uB9CC \uD55C \uAC8C \uC5C6\uC9C0.$h",
  "fall_Fri_bad": "\uD760. \uBCC4\uB85C \uC7AC\uBBF8\uC5C6\uB294 \uB300\uB2F5\uC774\uB2E4.",
  "fall_Fri6": "\uC694\uC998 \uB18D\uBD80\uC5D0 \uB300\uD55C \uCC45\uC744 \uC77D\uACE0 \uC788\uC5C8\uC5B4. \uC0AC\uC2E4 \uC77D\uC73C\uBA74\uC11C \uB124 \uC0DD\uAC01 \uB9CE\uC774 \uD588\uC5B4.$h#$e#\uC5B4, \uC18C\uB984 \uB07C\uCCE4\uB2E4\uBA74 \uBBF8\uC548\uD574.$h",
  "fall_Sat": "\uB531 *\uC694\uB9CC\uD07C\uB9CC* \uB354 \uAC8C\uC744\uB800\uC5B4\uB3C4 \uD558\uB8E8 \uC885\uC77C \uCE68\uB300\uC5D0 \uC788\uC744 \uBED4\uD588\uB124. \uADF8\uB7F0 \uD3B8\uC774 \uB098\uC558\uACA0\uB2E4, \uADFC\uB370.",
  "fall_Sun": "\uD558\uB8E8 \uC911 \uD574\uAC00 \uB5A0\uC788\uB294 \uC2DC\uAC04\uC774 \uC810\uC810 \uC9E7\uC544\uC9C0\uACE0 \uC788\uC5B4... \uC544\uC8FC \uC88B\uC544.",
  "winter_Mon": "\uB09C \uC694\uC998 \uC774 \uCE68\uC6B8\uD55C \uB0A0\uC528\uB97C \uC990\uAE30\uACE0 \uC788\uC5B4... \uADFC\uB370 \uC194\uC9C1\uD788 \uC880 \uCDA5\uAE34 \uD558\uB2E4.",
  "winter_Mon4": "\uC544\uBB34\uAC83\uB3C4 \uB180\uB77C\uC6B4 \uC77C\uC774 \uC5C6\uC5B4... \uBCC4\uB85C \uC6C3\uC744 \uC77C\uB3C4 \uC5C6\uACE0.#$e#\uC54C\uC544, \uC54C\uC544... \uB0B4\uAC00 \uC880 \uB108\uBB34 \uACFC\uC7A5\uD574\uC11C \uC598\uAE30\uD558\uACE0 \uC788\uAE34 \uD558\uC9C0.",
  "winter_Mon8": "\uAC00\uB054 \uC790\uC2E0\uC758 \uC61B \uBAA8\uC2B5\uC774 \uBD80\uB044\uB7FD\uACE0 \uD55C\uC2EC\uD558\uB2E4 \uC0DD\uAC01\uD55C \uC801 \uC788\uC5B4?#$e#\uC131\uC7A5\uD558\uB294 \uACFC\uC815\uC758 \uC77C\uBD80\uACA0\uC9C0 \uC774\uAC83\uB3C4.",
  "winter_Tue": "\uD760... \uC0AC\uC2E4 \uBB34\uC2A8 \uC598\uAE30\uB97C \uD574\uC57C \uD560\uC9C0 \uC798 \uBAA8\uB974\uACA0\uB2E4. \uC544\uC9C1 \uB110 \uC798 \uC544\uB294 \uD3B8\uC774 \uC544\uB2C8\uB77C\uC11C \uB9D0\uC774\uC9C0.",
  "winter_Tue4": "\uC5B4...#$b#\uAC00\uB054 \uC0C8\uB85C\uC6B4 \uC8FC\uC81C\uB97C \uB5A0\uC62C\uB9AC\uAE30 \uD798\uB4DC\uB124. \uC880 \uC798 \uC54C\uAC8C \uB41C \uC0AC\uB78C\uC774\uB791 \uC598\uAE30\uD558\uB294 \uAC70\uB77C\uB3C4.#$e#...\uBBF8\uC548.",
  "winter_Tue6": "\uB0B4 \uC61B\uB0A0 \uB9CC\uD654\uB4E4 \uBC84\uB838\uB2E4\uACE0 \uC5C4\uB9C8\uD55C\uD14C \uC18C\uB9AC \uC9C0\uB97C \uBED4 \uD588\uB294\uB370... \uC660\uC9C0 \uADF8\uB0E5 \uBA48\uCDC4\uC5B4.#$e#\uD760... \uB098\uC774\uAC00 \uB4E4\uBA74 \uC9C0\uD61C\uB85C\uC6CC\uC9C0\uB294 \uBC95\uC774\uC9C0.",
  "winter_Tue10": "\uB098 \uBCF4\uB7EC \uC5EC\uAE30 \uC628 \uAC70\uC57C?$l#$e#...$h",
  "winter_Wed": "%\uC138\uBC14\uC2A4\uCC2C\uC740 \uC0DD\uAC01\uC5D0 \uC7A0\uACA8\uC788\uC2B5\uB2C8\uB2E4...",
  "winter_Wed4": "\uC57C, \uB098 \uB54C\uBB38\uC5D0 \uD560 \uC77C\uC744 \uBBF8\uB8E8\uC9C4 \uB9D0\uACE0.#$e#\uD2B9\uBCC4\uD788 \uBC14\uC05C \uAC8C \uC544\uB2C8\uC5B4\uC11C \uB180\uB2E4 \uAC00\uBA74 \uB098\uC57C \uC88B\uC9C0\uB9CC.$h",
  "winter_Thu": "\uC624\uB298 \uC800\uB141\uC740 \uBB50 \uBA39\uC73C\uB824\uB098... *\uAD81\uC2DC\uB801*$s",
  "winter_Thu6": "\uC694\uB9AC\uD558\uB294 \uBC95\uC744 \uBC30\uC6CC\uC57C\uACA0\uC5B4. \uBD84\uBA85 \uC720\uC6A9\uD560 \uAC70\uC57C.",
  "winter_Fri": "\uCCA0\uB85C \uC606\uC5D0 \uC0AC\uB294 \uAC74 \uC7AC\uBC0C\uC5B4. \uC800 \uBC16\uC5D0 \uD070 \uC138\uC0C1\uC774 \uC788\uB2E4\uB294 \uAC78 \uD56D\uC0C1 \uC0C1\uAE30\uC2DC\uCF1C\uC8FC\uC9C0.",
  "winter_Fri8": "\uC5B4\uB838\uC744 \uB54C\uB294 \uAE30\uCC28 \uC624\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB9AC\uBA74 \uAF2D \uAD6C\uACBD\uD558\uB7EC \uB6F0\uC5B4\uB098\uAC14\uC5C8\uB294\uB370.#$e#\uADF8 \uC2DC\uC808\uC740 \uC5B4\uB514 \uAC14\uC744\uAE4C...? *\uD55C\uC228*$s",
  "winter_Sat": "\uACA8\uC6B8\uCCA0\uC5D0 \uAC1C\uAD6C\uB9AC\uB4E4\uC740 \uCC38 \uD798\uB4E4 \uAC83 \uAC19\uC544.#$e#\uBD88\uC30D\uD55C \uB140\uC11D\uB4E4.$s||\uAC1C\uAD6C\uB9AC\uB4E4\uC740 \uACA8\uC6B8\uC5D0 \uBB58 \uD560\uAE4C? \uADF8\uB0E5 \uC5BC\uC5C8\uB2E4\uAC00 \uBD04\uC5D0 \uB2E4\uC2DC \uB179\uB098?",
  "winter_Sat6": "\uB09C \uACA8\uC6B8\uC774 \uC88B\uC9C0\uB9CC \uCD94\uC6CC\uD560 \uB3D9\uBB3C\uB4E4 \uC0DD\uAC01\uD558\uBA74 \uB9C8\uC74C\uC774 \uC880 \uC544\uD504\uAE34 \uD574.#$e#\uADFC\uB370, \uB098\uCC98\uB7FC \uC775\uC219\uD574\uC838 \uC788\uACA0\uC9C0...",
  "winter_Sun": "\uB208\uC0AC\uB78C\uC744 \uC9C0\uC5C8\uB294\uB370 \uB4DC\uBBF8\uD2B8\uB9AC\uC6B0\uC2A4\uAC00 \uCE58\uC6B0\uAC8C \uD588\uC5B4.#$e#\uB300\uCCB4 \uC65C \uC800\uB7EC\uB294 \uAC70\uC9C0?$u",
  "winter_Sun6": "\uB208\uC0AC\uB78C\uC744 \uC9C0\uC5C8\uB294\uB370 \uB4DC\uBBF8\uD2B8\uB9AC\uC6B0\uC2A4\uAC00 \uCE58\uC6B0\uAC8C \uD588\uC5B4... \uD558\uC9C0\uB9CC \uB9C8\uB8E8\uAC00 \uC9C0\uC740 \uC791\uACE0 \uADC0\uC5EC\uC6B4 \uB208\uC0AC\uB78C\uC740 \uADF8\uB0E5 \uB450\uACE0!$a#$e#\uC774\uAC74 \uB9D0\uB3C4 \uC548 \uB3FC."
}