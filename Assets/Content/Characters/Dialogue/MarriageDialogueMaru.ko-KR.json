{
  "Rainy_Day_0": "\uD398\uB2C8\uB294 \uC694\uC998 \uC5B4\uB5BB\uAC8C \uC9C0\uB0B4\uB824\uB098? \uB098\uC911\uC5D0 \uC804\uD654\uD574\uBD10\uC57C\uACA0\uB2E4.",
  "Rainy_Day_1": "\uB098 \uC7A0\uAE50 \uB2E4\uB978 \uC0DD\uAC01\uD558\uACE0 \uC788\uC5C8\uC5B4... \uB9C8\uB9B4\uB2E4\uB294 \uC798 \uC9C0\uB0B4\uACE0 \uC788\uC744 \uAC83 \uAC19\uC544? \uC138\uC0C1\uC5D0\uC11C \uADF8\uB140\uB97C \uBC18\uACA8\uC8FC\uB294 \uACF3\uC744 \uCC3E\uC744 \uC218 \uC788\uC73C\uBA74 \uC88B\uC744 \uD150\uB370...",
  "Rainy_Day_2": "\uC548\uB155! \uBC24\uC5D0 \uC7A0\uC774 \uC798 \uC548 \uC640\uC11C \uC791\uC5C5\uC2E4\uC5D0 \uC880 \uC788\uC5C8\uC5B4. \uC5EC\uAE30, \uC774\uAC70 \uB9CC\uB4E4\uC5C8\uC5B4. [688 369 338 325 287]#$e#\uC720\uC6A9\uD558\uAC8C \uC4F8 \uC218 \uC788\uAE38 \uBC14\uB77C.",
  "Rainy_Day_3": "\uBE44\uAC00 \uB9C8\uC74C\uC5D0 \uC548 \uB4DC\uB294 \uC810 \uB531 \uD558\uB098\uAC00 \uBCC4\uC744 \uBABB \uBCF8\uB2E4\uB294 \uAC70\uC57C!",
  "Rainy_Day_4": "\uC9C0\uBD95\uC774 \uC0C8\uB294 \uC18C\uB9AC\uC778\uAC00? \uD55C\uBC88 \uC0B4\uD3B4\uBD10\uC57C\uACA0\uC5B4. \uC5C4\uB9C8\uD55C\uD14C\uC11C \uBAA9\uACF5 \uC77C\uC740 \uD55C\uB450 \uAC00\uC9C0 \uBC30\uC6E0\uAC70\uB4E0.",
  "Rainy_Night_0": "\uB3C4\uAD6C\uB4E4 \uBE44 \uC624\uB294 \uB370 \uBC29\uCE58\uD558\uC9C0 \uB9D0\uACE0! \uADF8\uB7EC\uB2E4 \uB179\uC2AC\uC5B4\uBC84\uB9B4 \uC218\uAC00 \uC788\uC5B4.",
  "patio_Maru": "\uC774\uAC8C \uBB54\uC9C0\uB294 \uC544\uC9C1 \uC798 \uBAA8\uB974\uACA0\uC5B4... \uADF8\uB798\uB3C4 \uAC00\uB054 \uB80C\uCE58\uB97C \uB3CC\uB9AC\uB294 \uAC8C \uC7AC\uBC0C\uC5B4.",
  "Rainy_Night_1": "\uC548\uB155 @. \uC624\uB298 \uD558\uB8E8 \uC5B4\uB560\uC5B4... \uCD95\uCD95\uD588\uC5B4?#$e#\uB0A0\uC528\uAC00 \uC774\uB7EC\uB2C8\uAE4C \uC0C8\uB85C\uC6B4 \uC7A5\uCE58\uC5D0 \uB300\uD55C \uAD6C\uC0C1\uC774 \uB5A0\uC624\uB974\uB124... \uBE57\uBB3C\uC744 \uC774\uC6A9\uD574\uC11C \uBC29\uC557\uAC04\uC744 \uB3CC\uB9B4 \uC218 \uC788\uC73C\uB824\uB098?",
  "Rainy_Night_2": "\uC544\uBE60\uAC00 \uC9C0\uB09C 20\uB144\uAC04 \uB0A0\uC528 \uBCC0\uD654\uB97C \uAE30\uB85D\uD558\uC168\uC5B4.#$e#\uC544\uC9C1 \uD655\uC5B8\uD558\uAE34 \uC774\uB974\uC9C0\uB9CC, \uACB0\uACFC\uC5D0 \uC758\uD558\uBA74 \uBE44\uC815\uC0C1\uC801\uC778 \uCD94\uC138\uAC00 \uC788\uB098 \uBD10.",
  "Rainy_Night_3": "\uC6B0\uB9AC \uC624\uB298 \uCE68\uB300\uC5D0 \uB204\uC6CC\uC11C \uC2A4\uD30C\uAC8C\uD2F0 \uBA39\uC744\uAE4C?",
  "Rainy_Night_4": "\uB098 \uB514\uC800\uD2B8 \uB9CC\uB4E4\uC5C8\uC5B4! \uC7A0\uB4E4\uAE30 \uC804\uC5D0 \uC591\uCE58 \uAF2D \uD558\uACE0 \uADF8\uB798\uB3C4. [232 234 223 220]$h",
  "Rainy_Night_5": "\uC624\uB298 \uBCC4\uB85C \uC2E0\uB098\uB294 \uC77C\uC740 \uC5C6\uC5C8\uC5B4... \uB0A0\uC528 \uB54C\uBB38\uC5D0 \uC885\uC77C \uC9D1\uC548\uC5D0 \uC788\uC5C8\uC5B4.#$e#\uD3B8\uC548\uD558\uAE34 \uD588\uC5B4, \uADF8\uB798\uB3C4. \u0027\uC8FC\uAC04 \uB3C4\uBA74\u0027 \uC7A1\uC9C0 \uBCF4\uBA74\uC11C \uB180\uC558\uC5B4.",
  "Indoor_Day_0": "\uD760? \uBBF8\uC548, \uAC00\uB054 \uC0DD\uAC01\uC5D0 \uB108\uBB34 \uAE4A\uC774 \uBE60\uC838\uC11C \uB0B4\uAC00 \uBB50\uD558\uACE0 \uC788\uB294\uC9C0 \uAE5C\uBE61\uD574.",
  "Indoor_Day_1": "\uB0A8\uC740 \uBD80\uD488 \uC911\uC5D0 \uC774\uAC78 \uCC3E\uC558\uC5B4. \uD639\uC2DC \uC4F8\uBAA8 \uC788\uC744 \uAC83 \uAC19\uC544? [286 287 205 732]",
  "Indoor_Day_2": "\uB4DC\uB514\uC5B4 \uC77C\uC5B4\uB0AC\uAD6C\uB098! \uB108\uBB34 \uBC30\uACE0\uD320\uC5B4... *\uAF2C\uB974\uB975*$h",
  "Indoor_Day_3": "\uB18D\uC7A5\uC5D0\uC11C \uC9C0\uB0B4\uC11C \uC81C\uC77C \uB9C8\uC74C\uC5D0 \uB4DC\uB294 \uAC83 \uC911 \uD558\uB098\uAC00 \uC0C8\uB4E4\uC758 \uB178\uB7AB\uC18C\uB9AC\uB97C \uB4E4\uC73C\uBA74\uC11C \uC77C\uC5B4\uB098\uB294 \uAC70\uC57C.",
  "Indoor_Day_4": "\uB18D\uC7A5 \uC77C\uC744 \uACC4\uC18D\uD558\uB294\uB370 \uC190\uC774 \uC5B4\uB5BB\uAC8C \uADF8\uB807\uAC8C \uBD80\uB4DC\uB7EC\uC6CC?",
  "Indoor_Night_0": "\uC624\uB298 \uBC24\uC5D0 \uB2EC \uBD24\uC5B4? \uC9C0\uD3C9\uC120\uC5D0 \uAC78\uB824\uC788\uB294 \uAC78 \uBCF4\uBA74 \uC5B8\uC81C \uBD10\uB3C4 \uC7A5\uAD00\uC774\uC57C.",
  "Indoor_Night_1": "\uC544\uAE4C \uC720\uC131 \uBD24\uC5B4. \uB9C8\uB9B4\uB2E4\uAC00 \uC6B0\uB9AC \uC798 \uC9C0\uB0B4\uB098 \uBCF4\uB7EC \uC628 \uAC70\uB77C\uACE0 \uC0DD\uAC01\uD558\uACE0 \uC2F6\uC5B4.$h",
  "Indoor_Night_2": "\uC9C0\uAE08 \uB0B4\uAC00 \uCD08\uCF5C\uB9BF\uC774 \uBA39\uACE0 \uC2F6\uC740 \uAC74\uC9C0 \uC798 \uC775\uC740 \uB538\uAE30\uAC00 \uBA39\uACE0 \uC2F6\uC740 \uAC74\uC9C0 \uACB0\uC815\uC744 \uBABB \uD558\uACA0\uC5B4. \uC544\uB2C8\uBA74 \uB458 \uB2E4...?#$e#\uC194\uC9C1\uD788 \uB9D0\uD574\uBD10... \uB098 \uC694\uC998 \uC0B4\uCC0C\uACE0 \uC788\uC5B4?$s",
  "Indoor_Night_3": "\uC624\uB298 \uC5F4\uC2EC\uD788 \uC798\uD588\uC5B4! \uC800\uB141\uC740 \uCDA9\uBD84\uD788 \uD479 \uC26C\uC5B4\uB3C4 \uB420 \uAC70\uC57C.",
  "Indoor_Night_4": "\uB098 \uC774 \uC624\uB798\uB41C \uC9D1\uC774 \uC815\uB9D0 \uC0AC\uB791\uC2A4\uB7EC\uC6CC. \uBC24\uC5D0 \uB108\uBB34 \uC544\uB291\uD574.#$e#\uC5C4\uB9C8\uAC00 \uC5EC\uAE30 \uACF5\uC0AC \uC815\uB9D0 \uC798\uD558\uC168\uC5B4.$h",
  "Outdoor_0": "\uC544... \uB18D\uC7A5 \uB0C4\uC0C8 \uC815\uB9D0 \uC88B\uC544, \uBD80\uBAA8\uB2D8\uB301 \uC606\uC5D0 \uC788\uB294 \uC0B0 \uC0DD\uAC01\uC774 \uB098.",
  "Outdoor_1": "\uC870\uAE08\uB9CC \uACC4\uD68D\uC744 \uC798 \uC138\uC6B0\uBA74, \uB18D\uC7A5\uC77C \uB300\uBD80\uBD84\uC744 \uC790\uB3D9\uD654\uD558\uACE0 \uD3B8\uD558\uAC8C \uC9C0\uB0BC \uC218 \uC788\uC744 \uAC70\uC57C!",
  "Outdoor_2": "\uC624\uB298 \uBC24\uC740 \uB0A0\uC528 \uB9D1\uC73C\uB824\uB098 \uBD10... %noun\uC790\uB9AC\uAC00 \uC624\uB298 \uBCF4\uC774\uB824\uB098?",
  "Outdoor_3": "\uC9D1 \uC548\uC5D0 \uC9C4\uD759 \uC880 \uB4E4\uC5B4\uC640\uB3C4 \uB09C \uAD1C\uCC2E\uC544. \uAC00\uB054 \uC9C0\uC800\uBD84\uD574\uC9C0\uB294 \uAC83\uB3C4 \uC7AC\uBC0C\uC9C0.",
  "Outdoor_4": "\uB18D\uC7A5 \uC6B4\uC601\uD558\uB294\uB370 \uC774\uB807\uAC8C \uB9CE\uC740 \uAD00\uC2EC\uACFC \uACC4\uD68D\uC774 \uD544\uC694\uD55C \uC904 \uBAB0\uB790\uC5B4! \uC2E4\uD5D8\uC2E4\uC5D0\uC11C \uC77C\uD558\uB294 \uAC70\uB791 \uB9CE\uC774 \uBE44\uC2B7\uD558\uB124.",
  "OneKid_0": "\uC624\uB298 %kid1(\uC774)\uB791 \uC2DC\uAC04 \uC880 \uBCF4\uB0C8\uC5B4? \uC5B4\uB838\uC744 \uB54C \uB9CE\uC774 \uB180\uC544\uC57C \uC7A0\uC7AC\uB825\uC744 \uBC1C\uD718\uD560 \uC218 \uC788\uC5B4.",
  "OneKid_1": "\uC5B4\uB5BB\uAC8C \uC0DD\uAC01\uD574... %kid1(\uC774)\uAC00 \uCEE4\uC11C \uB18D\uBD80\uAC00 \uB420\uAE4C? \uC544\uB2C8\uBA74 \uAE30\uC220\uC790\uAC00 \uB420\uAE4C?",
  "OneKid_3": "\uB098 \uC6B0\uB9AC \uC544\uC774\uD55C\uD14C \uAE30\uB300\uAC00 \uCEE4. \uC694\uC998 \uC721\uC544 \uAD00\uB828\uB41C \uC5F0\uAD6C\uB97C \uCC3E\uC544\uBCF4\uACE0 \uC788\uC5B4.",
  "TwoKids_3": "\uB098\uB9CC\uC758 \uC791\uC5C5\uC2E4, \uBA4B\uC9C4 \uC544\uC774 \uB458, \uC544\uB984\uB2E4\uC6B4 \uB18D\uC7A5\uAE4C\uC9C0. \uC778\uC0DD \uCC38 \uC88B\uC544.",
  "Good_1": "\uC6B0\uB9AC \uC774\uC81C \uD568\uAED8 \uC0B4\uB2E4 \uBCF4\uB2C8, \uB2E4\uC2DC \uD63C\uC790 \uC0AC\uB294 \uC0C1\uC0C1\uC740 \uBABB\uD558\uACA0\uC5B4.",
  "Good_2": "\uC26C\uACE0 \uC788\uC5B4? \uC88B\uC740 \uC77C\uC774\uC57C!",
  "Good_3": "\uB18D\uC7A5 \uC6B4\uC601\uD558\uB294 \uB370 \uC804\uB7B5\uC774\uB791 \uACC4\uD68D\uC774 \uB9CE\uC774 \uD544\uC694\uD558\uB124. \uB0B4\uAC00 \uC0DD\uAC01\uD588\uB358 \uAC83\uBCF4\uB2E4 \uC9C0\uC801\uC73C\uB85C \uC790\uADF9\uC774 \uB9CE\uC774 \uB41C\uB2E4!",
  "Good_4": "\uB098 \uC0AC\uC2E4 \uC608\uC804\uC5D0 \uB85C\uBD07 ${\uB0A8\uD3B8\uC744^\uC544\uB0B4\uB97C}$ \uC9C0\uC744\uAE4C \uC0DD\uAC01\uD588\uC5C8\uC5B4. \uADFC\uB370 \uB108\uB791 \uC788\uB294 \uAC8C \uD6E8\uC52C \uC7AC\uBC0C\uC5B4!$h",
  "Good_5": "\uACB0\uD63C \uD39C\uB358\uD2B8 \uAC10\uC0C1\uD558\uACE0 \uC788\uC5C8\uC5B4... \uAECD\uB370\uAE30\uC5D0 \uD2F0\uAC00 \uD558\uB098\uB3C4 \uC5C6\uB124. \uC774\uAC70 \uC815\uB9D0 \uD76C\uADC0\uD55C \uD45C\uBCF8\uC774\uC57C!$l",
  "Good_6": "\uC5B4\uC82F\uBC24\uC5D0, \uAC70\uB300\uD55C \uB9DD\uC6D0\uACBD\uC73C\uB85C \uD558\uB298\uC744 \uBCF4\uB294 \uAFC8\uC744 \uAFE8\uC5B4. %noun \uC131\uC6B4\uC5D0\uC11C \uBB54\uAC00 \uC6C0\uC9C1\uC774\uB294 \uAC83\uC744 \uBD24\uC5B4. \uC57D\uAC04 \uC73C\uC2A4\uC2A4\uD558\uC9C0.",
  "Neutral_0": "\uB0B4\uAC00 \uC0B4\uC774 \uC880 \uB354 \uCA84\uB3C4 \uB098 \uC544\uC9C1 \uC88B\uC544\uD588\uC73C\uBA74 \uC88B\uACA0\uB2E4.",
  "Neutral_8": "\uC624\uB298\uC740 \uB3D9\uAE30\uBD80\uC5EC\uAC00 \uC548\uB41C\uB2E4.$s",
  "funLeave_Maru": "\uC624\uB298\uC740 \uBD80\uBAA8\uB2D8 \uBD48\uB7EC \uAC00\uB824\uACE0. \uBABB \uBCF8 \uC9C0 \uC880 \uC624\uB798\uB418\uC5C8\uC5B4.",
  "funReturn_Maru": "\uC5C4\uB9C8\uB791 \uC544\uBE60\uB791 \uB2E4 \uC798 \uC9C0\uB0B4\uC154. \uB0B4\uAC00 \uC5C6\uC5B4\uB3C4 \uC77C\uC0C1\uC774 \uB611\uAC19\uC73C\uC2DC\uB354\uB77C\uACE0. \uC5EC\uBCF4\uB294 \uC624\uB298 \uC798 \uC9C0\uB0C8\uC5B4?",
  "spring_2": "\uADF8\uB798, \uC62C\uD574 \uB18D\uC7A5\uC744 \uCD5C\uC801\uD654\uD560 \uC804\uB7B5\uC740 \uC5B4\uB5A4 \uAC70\uC57C?",
  "spring_1": "\uBD04\uC5D0 \uB3D9\uBB3C\uB4E4\uC774\uB791 \uC2DD\uBB3C\uB4E4\uC774\uB791 \uB2E4\uC2DC \uC0B4\uC544\uB3CC\uC544\uC624\uB294 \uAC78 \uBCF4\uB2C8 \uB108\uBB34 \uC88B\uB2E4.",
  "spring_22": "\uC624\uBE60\uAC00 \uADF8\uB807\uAC8C \uC740\uB454\uC790\uAC00 \uC544\uB2C8\uC5C8\uB2E4\uBA74 \uC800\uB141 \uBA39\uC73C\uB7EC \uC624\uB77C\uACE0 \uCD08\uB300\uB77C\uB3C4 \uD560 \uD150\uB370.",
  "summer_20": "\uC624\uBE60\uAC00 \uC560\uBE44\uAC8C\uC77C\uD55C\uD14C \uB370\uC774\uD2B8 \uC2E0\uCCAD\uD560 \uB9CC\uD07C \uC6A9\uAE30\uB97C \uB0BC \uB0A0\uC774 \uC624\uB824\uB098?",
  "summer_2": "\uC5EC\uB984\uC5D0 \uBCF8 \uB2E4\uC591\uD55C \uACE4\uCDA9\uB4E4 \uBAA9\uB85D\uC744 \uC791\uC131\uD558\uB824\uACE0.",
  "fall_1": "\uACC4\uC808\uB9C8\uB2E4 \uBC24\uD558\uB298\uC758 \uC0C8\uB85C\uC6B4 \uBD80\uBD84\uC774 \uB450\uB4DC\uB7EC\uC9C0\uB124. \uC9C1\uC811 \uBCF4\uBA74 \uC815\uB9D0 \uD658\uC0C1\uC801\uC774\uC57C.",
  "fall_25": "\uC870\uAE08 \uC788\uC73C\uBA74 \uACA8\uC6B8\uC774\uB124. \uB09C\uBC29 \uC798 \uB3CC\uC544\uAC00\uAC8C \uD544\uC694 \uC5C6\uB294 \uBC38\uBE0C\uB294 \uC7A0\uADF8\uACE0 \uC9D1\uC5D0 \uB2E8\uC5F4\uCC98\uB9AC \uC544\uC9C1 \uC798 \uB418\uC5B4\uC788\uB098 \uD655\uC778\uD574\uC57C\uC9C0.#$e#\uAC71\uC815\uD558\uC9C0 \uB9C8, \uB0B4\uAC00 \uC190\uBCFC\uAC8C.",
  "fall_3": "\uAC00\uC744\uC774\uBA74 \uC5C4\uB9C8\uB791 \uB098\uBB34 \uBCA0\uB7EC \uB2E4\uB2C8\uB358 \uAC8C \uC0DD\uAC01\uB098... \uAC13 \uC790\uB978 \uBAA9\uC7AC\uB791 \uC218\uC561 \uB0C4\uC0C8 \uB54C\uBB38\uC778\uAC00 \uBD10.",
  "winter_15": "\uACA8\uC6B8 \uB0A0\uC528\uAC00 \uC694\uC998 \uBD88\uC548\uD560 \uC815\uB3C4\uB85C \uAC00\uBCBC\uC6B4\uB370.",
  "winter_5": "\uC544\uBE60 \uAD1C\uCC2E\uC73C\uC2DC\uB824\uB098... \uACA8\uC6B8\uC5D0 \uC880 \uC6B0\uC6B8\uD574\uD558\uC2DC\uB354\uB77C\uACE0, \uD604\uC7A5 \uC5F0\uAD6C\uD560 \uAE30\uD68C\uAC00 \uBCC4\uB85C \uC5C6\uC5B4\uC11C.",
  "winter_2": "\uADF8\uB798, \uACA8\uC6B8\uC5D0 \uC218\uC785 \uC720\uC9C0\uD560 \uACC4\uD68D\uC740 \uC5B4\uB5A4 \uAC8C \uC788\uC5B4?#$e#\uB09A\uC2DC\uB098 \uCC44\uC9D1\uD560 \uC218\uB3C4 \uC788\uACA0\uACE0...#$e#\uCC44\uAD11\uD560 \uACC4\uD68D\uC774\uB77C\uBA74, \uAF2D \uC870\uC2EC\uD574.",
  "spring_Maru": "\uB098 \uC77C\uB144 \uB354 \uB18D\uC0AC\uC9C0\uC744 \uC0DD\uAC01\uC5D0 \uC2E0\uB098, @\uC544(\uC57C)!$h",
  "summer_Maru": "\uC694\uC998 \uBC24\uC5D0\uB3C4 \uB530\uB73B\uD574\uC11C, \uC815\uB9D0 \uBCC4 \uBCF4\uAE30 \uC88B\uC740 \uC2DC\uAE30\uC57C. \uC800 \uC704\uC5D0 \uC5B4\uB5A4 \uAC8C \uC788\uC744\uC9C0 \uB204\uAC00 \uC54C\uACA0\uC5B4?",
  "fall_Maru": "\uB18D\uC7A5\uC5D0\uC11C \uC9C0\uB0B4\uB294 \uAC83\uB3C4 \uC88B\uC9C0\uB9CC, \uC544\uC9C1 \uBCD1\uC6D0\uC5D0\uC11C \uC77C\uD558\uACE0 \uC788\uC5B4\uC11C \uC88B\uC544... \uC8FC\uBBFC\uB4E4\uC744 \uC704\uD574 \uC911\uC694\uD55C \uC11C\uBE44\uC2A4\uB97C \uC81C\uACF5\uD574\uC8FC\uB294 \uAE30\uBD84\uC774\uC57C.",
  "winter_Maru": "\uBD04\uC774 \uC624\uBA74 \uB300\uD669 \uD30C\uC774\uAC00 \uC815\uB9D0 \uBA39\uACE0 \uC2F6\uC5B4. \uC624... \uADF8 \uD1A1 \uC3D8\uB294 \uB9DB, \uADF8 \uD48D\uBBF8!",
  "spouseRoom_Maru": "#$c .5#\uB098 \uC870\uAE08 \uC77C\uCC0D \uC77C\uC5B4\uB098\uC11C \uBCC4 \uC880 \uBD24\uC5B4.#$e#\uC5EC\uBCF4, \uB098 \uC624\uB298\uC740 \uBC29\uC5D0\uC11C \uD504\uB85C\uC81D\uD2B8 \uC880 \uC9C4\uD589\uD560\uAC8C."
