{
  "Rainy_Day_0": "\u0418\u043D\u043E\u0433\u0434\u0430 \u0432\u0434\u043E\u0445\u043D\u043E\u0432\u0435\u043D\u0438\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442 \u043C\u043D\u0435 \u0432 \u0441\u0430\u043C\u044B\u0445 \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u044B\u0445 \u043C\u0435\u0441\u0442\u0430\u0445.",
  "Rainy_Day_1": "\u0420\u0430\u043D\u044C\u0448\u0435, \u043A\u043E\u0433\u0434\u0430 \u044F \u0436\u0438\u043B\u0430 \u0432 \u0433\u043E\u0440\u043E\u0434\u0435, \u0434\u043E\u0436\u0434\u044C \u043C\u0435\u043D\u044F \u0443\u0433\u043D\u0435\u0442\u0430\u043B. \u041D\u043E \u0437\u0434\u0435\u0441\u044C, \u0432 \u0434\u043E\u043B\u0438\u043D\u0435 \u0421\u0442\u0430\u0440\u0434\u044C\u044E, \u043E\u043D \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u0435\u043D.",
  "Rainy_Day_2": "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E! \u042F \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0430\u0441\u044C \u043F\u043E\u0440\u0430\u043D\u044C\u0448\u0435 \u0438 \u043D\u0430\u0431\u0440\u0430\u043B\u0430 \u0433\u0440\u0438\u0431\u043E\u0432. \u0412\u043E\u0442, \u0434\u0435\u0440\u0436\u0438.[281 404 420 257]#$e#\u0418\u0441\u043A\u0430\u0442\u044C \u0433\u0440\u0438\u0431\u044B \u2014 \u043A\u0430\u043A \u0438\u0441\u043A\u0430\u0442\u044C \u0441\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u0430. \u042D\u0442\u043E \u043E\u0447\u0435\u043D\u044C \u0432\u0435\u0441\u0435\u043B\u043E.$h",
  "Rainy_Day_3": "\u0412 \u0442\u0430\u043A\u0438\u0435 \u0434\u043D\u0438 \u044F \u043E\u0447\u0435\u043D\u044C \u0440\u0430\u0434\u0430, \u0447\u0442\u043E \u0443 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u0442\u044F\u0436\u0435\u043B\u044B\u0435 \u0441\u0430\u043F\u043E\u0433\u0438.$h",
  "Rainy_Day_4": "\u0414\u0435\u0440\u0435\u0432\u044C\u044F \u0442\u0430\u043A \u043F\u0440\u043E\u0441\u0438\u043B\u0438 \u0434\u043E\u0436\u0434\u044F... \u042F \u0440\u0430\u0434\u0430 \u0437\u0430 \u043D\u0438\u0445.",
  "Rainy_Night_0": "\u0410 \u0442\u0432\u043E\u0439 \u0434\u0435\u043D\u044C \u043A\u0430\u043A \u043F\u0440\u043E\u0448\u0435\u043B? \u0412\u0441\u0442\u0440\u0435\u0447\u0430\u043B\u0438\u0441\u044C \u043A\u0430\u043A\u0438\u0435-\u043D\u0438\u0431\u0443\u0434\u044C \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0435?",
  "patio_Leah": "\u041D\u0435 \u0440\u0430\u0441\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0439, \u044D\u0442\u043E \u043D\u0435\u0437\u0430\u043A\u043E\u043D\u0447\u0435\u043D\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430.",
  "Rainy_Night_1": "\u041E\u0431\u044B\u0447\u043D\u043E \u044F \u0435\u043C \u0441\u0430\u043B\u0430\u0442\u044B... \u041D\u043E \u0432 \u0442\u0430\u043A\u0443\u044E \u0441\u044B\u0440\u0443\u044E \u043D\u043E\u0447\u044C \u043C\u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0433\u043E\u0440\u044F\u0447\u0435\u0433\u043E \u0441\u0443\u043F\u0430.$h",
  "Rainy_Night_2": "\u0412 \u0442\u0430\u043A\u0443\u044E \u043D\u043E\u0447\u044C \u0431\u0443\u0434\u0435\u0442 \u043E\u0447\u0435\u043D\u044C \u043F\u0440\u0438\u044F\u0442\u043D\u043E \u0437\u0430\u0441\u043D\u0443\u0442\u044C...$l",
  "Rainy_Night_3": "\u042F \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0441\u0434\u0435\u043B\u0430\u043B\u0430 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0443\u044E \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u0443\u044E \u0441\u0442\u0430\u0442\u0443\u044D\u0442\u043A\u0443, \u043D\u043E \u043E\u043D\u0430 \u0432\u044B\u0448\u043B\u0430 \u0442\u0430\u043A\u043E\u0439 \u0443\u0436\u0430\u0441\u043D\u043E\u0439, \u0447\u0442\u043E \u044F \u043A\u0438\u043D\u0443\u043B\u0430 \u0435\u0435 \u0432 \u043E\u0433\u043E\u043D\u044C.$u#$e#\u0414\u0443\u043C\u0430\u044E, \u0447\u0442\u043E\u0431\u044B \u0441\u0442\u0430\u0442\u044C \u0432\u0435\u043B\u0438\u043A\u0438\u043C \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u043E\u043C, \u043D\u0443\u0436\u043D\u043E \u0431\u044B\u0442\u044C \u0441\u0430\u043C\u043E\u043A\u0440\u0438\u0442\u0438\u0447\u043D\u044B\u043C.",
  "Rainy_Night_4": "\u0425\u043E\u0440\u043E\u0448\u043E, \u0447\u0442\u043E \u0442\u044B \u0434\u043E\u043C\u0430... \u0412 \u0442\u0430\u043A\u0443\u044E \u043D\u043E\u0447\u044C \u0445\u043E\u0440\u043E\u0448\u043E \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u0433\u0440\u0435\u0442\u044C\u0441\u044F \u043F\u043E\u0434 \u043E\u0434\u0435\u044F\u043B\u043E\u043C.",
  "Rainy_Night_Leah": "\u041A\u0430\u043A \u043F\u0440\u043E\u0448\u0435\u043B \u0434\u0435\u043D\u044C, \u0441\u043E\u043B\u043D\u044B\u0448\u043A\u043E? \u0413\u0440\u044F\u0437\u043D\u043E?",
  "Indoor_Day_0": "\u042D\u0442\u043E\u0442 \u0434\u043E\u043C \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u043B\u0443\u0447\u0448\u0435 \u043C\u043E\u0435\u0439 \u0441\u0442\u0430\u0440\u043E\u0439 \u0445\u0438\u0436\u0438\u043D\u044B! \u042F \u043F\u043E \u043D\u0435\u0439 \u043D\u0435 \u0441\u043A\u0443\u0447\u0430\u044E.",
  "Indoor_Day_1": "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E, @. \u042F \u0438\u0445 \u043F\u043E\u0441\u0430\u0434\u0438\u043B\u0430 \u0432 \u0433\u043E\u0440\u0448\u043E\u0447\u043A\u0435 \u043D\u0430 \u0437\u0430\u0434\u043D\u0435\u043C \u0434\u0432\u043E\u0440\u0435...[16 18 20 22 90 259 396 402]#$e#\u042F \u0432\u044B\u0440\u0430\u0441\u0442\u0438\u043B\u0430 \u044D\u0442\u043E \u0441 \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043B\u044E\u0431\u043E\u0432\u044C\u044E \u0438 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435\u043C. \u041D\u0430\u0441\u043B\u0430\u0436\u0434\u0430\u0439\u0441\u044F.",
  "Indoor_Day_2": "\u041D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0432\u043E\u043A\u0440\u0443\u0433 \u043A\u0430\u043A \u0441\u043B\u0435\u0434\u0443\u0435\u0442! \u0412\u043E\u043A\u0440\u0443\u0433 \u0440\u0430\u0441\u0442\u0435\u0442 \u043F\u043E\u043B\u043D\u043E \u0435\u0434\u044B.",
  "Indoor_Day_3": "\u042F \u0442\u0443\u0442 \u0434\u0443\u043C\u0430\u043B\u0430... \u0416\u0438\u0437\u043D\u044C \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043A\u043E\u0440\u043E\u0442\u043A\u0430, \u0447\u0442\u043E\u0431\u044B \u043F\u043B\u043E\u0445\u043E \u043F\u0438\u0442\u0430\u0442\u044C\u0441\u044F. \u041A \u0441\u0447\u0430\u0441\u0442\u044C\u044E, \u043C\u044B \u0436\u0438\u0432\u0435\u043C \u0432 \u043E\u0434\u043D\u043E\u043C \u0438\u0437 \u043B\u0443\u0447\u0448\u0438\u0445 \u0440\u0435\u0433\u0438\u043E\u043D\u043E\u0432, \u0433\u0434\u0435 \u0435\u0441\u0442\u044C \u043E\u0432\u043E\u0449\u0438 \u0438 \u0434\u0440\u0443\u0433\u0430\u044F \u0437\u0435\u043B\u0435\u043D\u044C!#$e#\u0412\u043E\u0442, \u044F \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u043B\u0430 \u0442\u0435\u0431\u0435 \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0439 \u0441\u0430\u043B\u0430\u0442.[196]#$e#\u0423\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E, \u043A\u0430\u043A \u0442\u0435\u0431\u044F \u0435\u0449\u0435 \u043D\u0435 \u0442\u043E\u0448\u043D\u0438\u0442 \u043E\u0442 \u043C\u043E\u0435\u0433\u043E \u0441\u0430\u043B\u0430\u0442\u0430!",
  "Indoor_Day_4": "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E, @! \u042F \u0441\u0432\u0430\u0440\u0438\u043B\u0430 \u043D\u0430\u043C \u043A\u043E\u0444\u0435.[395]$h#$e#\u041C\u043E\u0435 \u0443\u0442\u0440\u043E \u043D\u0435 \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u043B\u043D\u044B\u043C \u0431\u0435\u0437 \u0433\u043E\u0440\u044F\u0447\u0435\u0439 \u0447\u0430\u0448\u043A\u0438 \u043A\u043E\u0444\u0435.",
  "Indoor_Night_0": "\u041F\u043E\u0447\u0435\u043C\u0443-\u0442\u043E \u0432 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u0432\u0435\u0447\u0435\u0440\u043E\u043C \u043C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u043F\u0438\u0442\u044C.",
  "Indoor_Night_1": "\u0422\u0435\u0447\u0435\u043D\u0438\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0442\u0430\u043A\u043E\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435... \u0414\u0430\u0436\u0435 \u0441\u0430\u043C\u043E\u0435 \u043A\u0440\u043E\u0448\u0435\u0447\u043D\u043E\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u043C\u0435\u043D\u044F\u0435\u0442 \u0431\u0443\u0434\u0443\u0449\u0435\u0435 \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430.",
  "Indoor_Night_2": "\u0417\u0434\u0435\u0441\u044C \u0432\u0435\u0447\u0435\u0440\u043E\u043C \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u043F\u0440\u0438\u044F\u0442\u043D\u0435\u0435, \u0447\u0435\u043C \u0441\u0440\u0435\u0434\u0438 \u0441\u043B\u0435\u043F\u044F\u0449\u0438\u0445 \u043E\u0433\u043D\u0435\u0439 \u0433\u043E\u0440\u043E\u0434\u0430.#$e#\u0414\u043B\u044F \u043C\u0435\u043D\u044F \u0432\u0441\u0435 \u0441\u043B\u043E\u0436\u0438\u043B\u043E\u0441\u044C \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E. \u041C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u043F\u043E\u0432\u0435\u0437\u043B\u043E.",
  "Indoor_Night_3": "\u041D\u0438\u043A\u043E\u0433\u0434\u0430 \u0431\u044B \u043D\u0435 \u043F\u043E\u0434\u0443\u043C\u0430\u043B\u0430, \u0447\u0442\u043E \u043C\u043D\u0435 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0430\u0442 \u041A\u0443\u043B\u043E\u043D \u0420\u0443\u0441\u0430\u043B\u043A\u0438 \u0441\u0440\u0430\u0437\u0443 \u0432\u0441\u043A\u043E\u0440\u0435 \u043F\u043E\u0441\u043B\u0435 \u043F\u0435\u0440\u0435\u0435\u0437\u0434\u0430 \u0441\u044E\u0434\u0430! \u041D\u043E \u044F \u0440\u0430\u0434\u0430.$l",
  "Indoor_Night_4": "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u0432\u0438\u0434\u0435\u043B\u0430 \u0434\u0438\u043A\u043E\u0433\u043E \u043A\u0440\u043E\u043B\u0438\u043A\u0430. \u0425\u043E\u0442\u0435\u043B\u043E\u0441\u044C \u0431\u044B \u043C\u043D\u0435 \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u0442\u0430\u043A\u043E\u0433\u043E \u043F\u043E\u0433\u043B\u0430\u0434\u0438\u0442\u044C. \u041E\u043D\u0438 \u0442\u0430\u043A\u0438\u0435 \u043F\u0443\u0448\u0438\u0441\u0442\u044B\u0435...",
  "Outdoor_0": "\u041F\u0440\u043E\u0445\u043B\u0430\u0434\u043D\u044B\u0439 \u0432\u0435\u0442\u0435\u0440\u043E\u043A \u0442\u0430\u043A\u043E\u0439 \u043F\u0440\u0438\u044F\u0442\u043D\u044B\u0439. \u041E\u043D \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442 \u043C\u043D\u0435 \u043E \u0436\u0438\u0437\u043D\u0438 \u0443 \u0440\u0435\u043A\u0438.",
  "Outdoor_1": "\u0425\u043C-\u043C... \u042F \u0442\u0443\u0442 \u043A\u043E\u0435-\u0447\u0442\u043E \u043F\u043E\u0447\u0438\u043D\u044E \u0432 \u0434\u043E\u043C\u0435. \u041F\u0440\u043E\u0441\u0442\u043E \u0438\u043D\u043E\u0433\u0434\u0430 \u043C\u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u043F\u043E\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u043C\u043E\u043B\u043E\u0442\u043A\u043E\u043C.",
  "Outdoor_2": "\u0414\u0435\u043D\u044C \u0431\u0443\u0434\u0435\u0442 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u044B\u043C, \u044F \u044D\u0442\u043E \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E.",
  "Outdoor_3": "\u0410\u0445... \u042D\u0442\u043E\u0442 \u0437\u0430\u043F\u0430\u0445 \u0441\u0432\u0435\u0436\u0435\u0439 \u0433\u0440\u044F\u0437\u0438. \u041E\u043D \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u044B\u0439.$h#$e#\u0421\u0440\u0430\u0437\u0443 \u0432\u0438\u0434\u043D\u043E, \u0447\u0442\u043E \u0432\u043E\u0437\u0434\u0443\u0445 \u0437\u0434\u0435\u0441\u044C \u0447\u0438\u0441\u0442\u044B\u0439... \u0422\u0430\u043A \u043F\u0440\u0438\u044F\u0442\u043D\u043E \u0435\u0433\u043E \u0432\u0434\u043E\u0445\u043D\u0443\u0442\u044C.",
  "Outdoor_4": "\u041D\u0435 \u043F\u0435\u0440\u0435\u0442\u0440\u0443\u0434\u0438\u0441\u044C, ${\u0434\u043E\u0440\u043E\u0433\u043E\u0439^\u0434\u043E\u0440\u043E\u0433\u0430\u044F}$.#$e#\u041D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439 \u0434\u0435\u043B\u0430\u0442\u044C \u043F\u0435\u0440\u0435\u0440\u044B\u0432\u044B, \u0438 \u043D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439 \u043F\u0435\u0440\u0435\u043A\u0443\u0441\u0438\u0442\u044C.$h",
  "funLeave_Leah": "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0441\u044C \u043F\u043E\u0433\u0443\u043B\u044F\u0442\u044C \u043F\u043E \u043B\u0435\u0441\u0443. \u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0432\u044B\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0438\u0437 \u0434\u043E\u043C\u0443.",
  "funReturn_Leah": "\u042F \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0445\u043E\u0440\u043E\u0448\u043E \u043F\u0440\u043E\u0432\u0435\u043B\u0430 \u0432\u0440\u0435\u043C\u044F \u0438 \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u0438\u043B\u0430\u0441\u044C. \u0410 \u043A\u0430\u043A \u043F\u0440\u043E\u0448\u0435\u043B \u0442\u0432\u043E\u0439 \u0434\u0435\u043D\u044C?",
  "OneKid_3": "\u0412\u0435\u0441\u0435\u043B\u043E \u0431\u044B\u0442\u044C \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0435\u043C. \u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0441 \u043C\u043E\u0438\u043C \u0432\u043E\u0441\u043F\u0438\u0442\u0430\u043D\u0438\u0435\u043C %kid1 \u043D\u0430\u0443\u0447\u0438\u0442\u0441\u044F \u043B\u044E\u0431\u0438\u0442\u044C \u043F\u0440\u0438\u0440\u043E\u0434\u0443.",
  "TwoKids_3": "\u0423 \u043D\u0430\u0441 \u0447\u0443\u0434\u0435\u0441\u043D\u0430\u044F \u0444\u0435\u0440\u043C\u0430 \u0438 \u043F\u043E\u043B\u043D\u0430\u044F \u0441\u0435\u043C\u044C\u044F. \u041D\u0430\u0448\u0430 \u043D\u043E\u0432\u0430\u044F \u0436\u0438\u0437\u043D\u044C \u0438\u0434\u0435\u0442 \u043D\u0435\u043F\u043B\u043E\u0445\u043E, \u043F\u0440\u0430\u0432\u0434\u0430?",
  "Good_0": "\u0417\u0434\u0435\u0441\u044C \u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E, \u0431\u0443\u0434\u0442\u043E \u0436\u0438\u0432\u0443 \u043D\u0430 \u0432\u0435\u0440\u0448\u0438\u043D\u0435 \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0433\u043E\u0440\u044B.",
  "Good_1": "\u042F \u0442\u0435\u0431\u0435 \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430?.. \u0412\u043E \u0432\u0440\u0435\u043C\u044F \u0442\u0432\u043E\u0435\u0433\u043E \u043F\u0435\u0440\u0435\u0435\u0437\u0434\u0430 \u043C\u043D\u0435 \u043F\u0440\u0438\u0441\u043D\u0438\u043B\u0441\u044F \u0441\u043E\u043D, \u0447\u0442\u043E \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u043C\u044B \u0431\u0443\u0434\u0435\u043C \u0432\u043C\u0435\u0441\u0442\u0435.",
  "Good_2": "\u041F\u043E\u0440\u043E\u0439 \u0431\u044B\u0432\u0430\u0435\u0442 \u043D\u0435\u0441\u043B\u043E\u0436\u043D\u043E \u043F\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0432 \u0441\u0443\u0434\u044C\u0431\u0443... \u0422\u043E\u0442 \u0444\u0430\u043A\u0442, \u0447\u0442\u043E \u044F \u0440\u0435\u0448\u0438\u043B\u0430 \u0441\u044E\u0434\u0430 \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u0442\u044C, \u0438 \u0447\u0442\u043E \u043C\u044B \u043D\u0430\u0448\u043B\u0438 \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430.#$b#\u0412\u0441\u0435 \u043C\u043E\u0433\u043B\u043E \u0431\u044B \u043F\u043E\u0439\u0442\u0438 \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E \u043F\u043E-\u0434\u0440\u0443\u0433\u043E\u043C\u0443 \u0432 \u043B\u044E\u0431\u043E\u0439 \u043C\u043E\u043C\u0435\u043D\u0442.",
  "Good_3": "\u041E\u0433\u043E, \u0442\u044B \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0448\u044C \u0442\u0430\u043A\u0438\u043C \u044D\u043D\u0435\u0440\u0433\u0438\u0447\u043D\u044B\u043C!$l^\u0422\u044B \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0442\u0430\u043A\u0430\u044F \u043A\u0440\u0430\u0441\u0438\u0432\u0430\u044F.$l",
  "Good_4": "\u041C-\u043C-\u043C... \u0422\u044B \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043F\u0440\u0438\u044F\u0442\u043D\u043E \u043F\u0430\u0445\u043D\u0435\u0448\u044C.",
  "Good_5": "\u042F \u0442\u0443\u0442 \u043B\u044E\u0431\u0443\u044E\u0441\u044C \u0441\u0432\u0430\u0434\u0435\u0431\u043D\u044B\u043C \u0430\u043C\u0443\u043B\u0435\u0442\u043E\u043C... \u042F \u0431\u0443\u0434\u0443 \u0446\u0435\u043D\u0438\u0442\u044C \u0435\u0433\u043E \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u0441\u0432\u043E\u0435\u0439 \u0436\u0438\u0437\u043D\u0438.$l",
  "Good_6": "\u0411\u0443\u0434\u044C \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u0435\u0439! \u0418\u043D\u043E\u0433\u0434\u0430 \u044F \u0431\u043E\u044E\u0441\u044C, \u0447\u0442\u043E \u0442\u044B \u0443\u043F\u0430\u0434\u0435\u0448\u044C \u0432 \u0441\u0442\u0432\u043E\u043B \u0448\u0430\u0445\u0442\u044B.",
  "Good_7": "@? \u042F \u0442\u043E\u043B\u044C\u043A\u043E \u0445\u043E\u0447\u0443 \u0441\u043A\u0430\u0437\u0430\u0442\u044C, \u0447\u0442\u043E \u0446\u0435\u043D\u044E \u0432\u0435\u0441\u044C \u0442\u043E\u0442 \u0442\u0440\u0443\u0434, \u0447\u0442\u043E \u0442\u044B \u0432\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0448\u044C \u0432 \u043D\u0430\u0448 \u0434\u043E\u043C.$h",
  "Good_8": "\u0417\u0430 \u043C\u0435\u043D\u044F \u043D\u0435 \u0432\u043E\u043B\u043D\u0443\u0439\u0441\u044F... \u042F \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0443 \u0442\u0435\u0431\u044F \u043C\u043D\u043E\u0433\u043E \u043E\u0431\u044F\u0437\u0430\u043D\u043D\u043E\u0441\u0442\u0435\u0439 \u0432\u043D\u0435 \u0434\u043E\u043C\u0430. \u041C\u043D\u0435 \u0438 \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0443 \u043D\u0435\u043F\u043B\u043E\u0445\u043E!$l",
  "Good_9": "\u041E, \u043C\u043D\u0435 \u043D\u0435 \u0441\u043A\u0443\u0447\u043D\u043E... \u042F \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0430\u0441\u043B\u0430\u0436\u0434\u0430\u044E\u0441\u044C \u0442\u0435\u043C, \u0447\u0442\u043E \u0443 \u043D\u0430\u0441 \u0435\u0441\u0442\u044C.#$e#\u0416\u0438\u0437\u043D\u044C \u0443 \u043D\u0430\u0441 \u043F\u0440\u043E\u0441\u0442\u0430\u044F, \u043D\u043E \u043C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F.$h",
  "Neutral_0": "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u044F \u043D\u0435 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043D\u0443 \u0442\u0435\u0431\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F, \u043A\u043E\u0433\u0434\u0430 \u0441\u0442\u0430\u043D\u0443 \u0441\u0442\u0430\u0440\u043E\u0439 \u0438 \u0441\u0435\u0434\u043E\u0439.",
  "Neutral_1": "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043A\u0442\u043E \u0436\u0438\u043B \u0437\u0434\u0435\u0441\u044C \u0434\u043E \u043D\u0430\u0441?",
  "Neutral_2": "\u0420\u0430\u0437\u0432\u0435 \u0442\u0435\u0431\u0435 \u043D\u0435\u0447\u0435\u043C \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0437\u0430\u043D\u044F\u0442\u044C\u0441\u044F?",
  "Neutral_3": "\u0415\u0441\u043B\u0438 \u043F\u043E\u0439\u0434\u0435\u0448\u044C \u0432 \u0433\u043E\u0440\u043E\u0434, \u043D\u0435 \u0437\u0430\u0431\u0443\u0434\u044C \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u0432\u0441\u0435\u043C \u043E\u0442 \u043C\u0435\u043D\u044F \u043F\u0440\u0438\u0432\u0435\u0442.",
  "Neutral_4": "\u042F \u0443\u0441\u0442\u0440\u043E\u044E \u0441\u0442\u0438\u0440\u043A\u0443 \u0437\u0430\u0432\u0442\u0440\u0430 \u0441 \u0443\u0442\u0440\u0430, \u0435\u0449\u0435 \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u0442\u044B \u043F\u0440\u043E\u0441\u043D\u0435\u0448\u044C\u0441\u044F... \u0422\u043E\u0433\u0434\u0430 \u0442\u0435\u0431\u0435 \u043D\u0435 \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F \u0436\u0434\u0430\u0442\u044C.",
  "Neutral_5": "\u0423 \u043D\u0430\u0441 \u0432\u0441\u0435 \u0445\u043E\u0440\u043E\u0448\u043E \u0441 \u0434\u0435\u043D\u044C\u0433\u0430\u043C\u0438, @?",
  "Neutral_6": "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u0447\u0435\u043C \u0432\u0441\u0435 \u0432 \u0433\u043E\u0440\u043E\u0434\u0435 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0437\u0430\u043D\u044F\u0442\u044B?",
  "Neutral_7": "\u0427\u0442\u043E-\u0442\u043E \u043C\u043D\u0435 \u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0438\u0447\u0435\u0433\u043E \u0434\u0435\u043B\u0430\u0442\u044C.",
  "Neutral_8": "\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u043D\u0438 \u0443\u0431\u0438\u0440\u0430\u0439\u0441\u044F, \u0432 \u0434\u043E\u043C\u0435 \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E \u043E\u043F\u044F\u0442\u044C \u0431\u0443\u0434\u0435\u0442 \u0433\u0440\u044F\u0437\u043D\u043E.#$e#\u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u043D\u0430 \u0444\u0435\u0440\u043C\u0435 \u043F\u043E-\u0434\u0440\u0443\u0433\u043E\u043C\u0443 \u043D\u0438\u043A\u0430\u043A.",
  "Neutral_9": "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043F\u0440\u043E\u0436\u0438\u0432\u0435\u043C \u043B\u0438 \u043C\u044B \u0437\u0434\u0435\u0441\u044C \u0432\u0441\u044E \u0436\u0438\u0437\u043D\u044C?",
  "Bad_0": "... \u0422\u044B \u0435\u0449\u0435 \u043B\u044E\u0431\u0438\u0448\u044C \u043C\u0435\u043D\u044F?$s",
  "Bad_1": "\u042D\u0445... \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u043C\u044B \u043F\u043E\u0442\u043E\u0440\u043E\u043F\u0438\u043B\u0438\u0441\u044C \u0441\u043E \u0441\u0432\u0430\u0434\u044C\u0431\u043E\u0439.$s",
  "Bad_2": "\u042F \u0435\u0449\u0435 \u0440\u0430\u0434\u0443\u044E \u0442\u0435\u0431\u044F?$s",
  "Bad_3": "\u042F \u0447\u0442\u043E-\u0442\u043E \u0434\u0435\u043B\u0430\u044E \u043D\u0435 \u0442\u0430\u043A? \u0412 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0432\u0440\u0435\u043C\u044F \u0442\u044B \u0432\u0435\u0434\u0435\u0448\u044C \u0441\u0435\u0431\u044F \u043F\u043E-\u0434\u0440\u0443\u0433\u043E\u043C\u0443.$s",
  "Bad_4": "\u0422\u0435\u0431\u0435 \u043D\u0435 \u0431\u044B\u0432\u0430\u0435\u0442 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u0447\u0442\u043E \u0435\u0449\u0435 \u0435\u0441\u0442\u044C \u0432 \u0436\u0438\u0437\u043D\u0438?$s",
  "Bad_5": "\u0420\u0430\u043D\u044C\u0448\u0435 \u0443 \u043D\u0430\u0441 \u0431\u044B\u043B\u043E \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0440\u043E\u043C\u0430\u043D\u0442\u0438\u043A\u0438... \u0427\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C?$s#$e#\u042F \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u043C\u043E\u043B\u043E\u0434\u043E\u0441\u0442\u044C \u043F\u043E\u0442\u0438\u0445\u043E\u043D\u044C\u043A\u0443 \u043C\u0435\u043D\u044F \u043F\u043E\u043A\u0438\u0434\u0430\u0435\u0442... \u0422\u044B \u0442\u043E\u043B\u044C\u043A\u043E \u0438\u0437-\u0437\u0430 \u044D\u0442\u043E\u0433\u043E \u0441\u043E \u043C\u043D\u043E\u0439?$a",
  "Bad_6": "\u0416\u0438\u0437\u043D\u044C \u043A\u043E\u0440\u043E\u0442\u043A\u0430... \u041D\u0435\u0443\u0436\u0435\u043B\u0438 \u043B\u0443\u0447\u0448\u0435 \u0432\u0441\u0435\u0433\u043E \u0435\u0435 \u043F\u0440\u043E\u0436\u0438\u0442\u044C \u0432\u043E\u0442 \u0442\u0430\u043A?$s",
  "Bad_7": "\u0420\u0430\u043D\u044C\u0448\u0435 \u043C\u044B \u0431\u044B\u043B\u0438 \u043D\u0435 \u0440\u0430\u0437\u043B\u0435\u0439 \u0432\u043E\u0434\u0430... \u0410 \u0442\u0435\u043F\u0435\u0440\u044C \u0442\u044B \u0441\u043E \u043C\u043D\u043E\u0439 \u0440\u0430\u0437\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0448\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u0437\u0430\u0442\u0435\u043C, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C.$s",
  "Bad_8": "\u0412 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0432\u0440\u0435\u043C\u044F \u0442\u044B \u043E\u0442 \u043C\u0435\u043D\u044F \u043E\u0442\u0441\u0442\u0440\u0430\u043D\u044F\u0435\u0448\u044C\u0441\u044F...$s",
  "Bad_9": "\u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u044F \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u044E \u043B\u0443\u0447\u0448\u0435\u0433\u043E?$s",
  "spring_2": "\u041A\u0430\u043A\u0438\u0435 \u0443 \u043D\u0430\u0441 \u043F\u043E\u0441\u0435\u0432\u044B \u0432 \u044D\u0442\u043E\u0442 \u0441\u0435\u0437\u043E\u043D?",
  "spring_1": "\u0414\u0430, \u043D\u043E\u0432\u044B\u0439 \u0433\u043E\u0434 \u043C\u044B \u0432\u0447\u0435\u0440\u0430 \u043E\u0442\u043F\u0440\u0430\u0437\u0434\u043D\u043E\u0432\u0430\u043B\u0438 \u0437\u043D\u0430\u0442\u043D\u043E...$l",
  "spring_15": "\u042D\u0445... \u041F\u043E\u0445\u043E\u0436\u0435, \u043D\u0430\u0441\u0442\u0430\u043B\u0430 \u043F\u043E\u0440\u0430 \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0439 \u0432\u0435\u0441\u0435\u043D\u043D\u0435\u0439 \u0443\u0431\u043E\u0440\u043A\u0438.$s",
  "summer_1": "\u0410\u0445, \u043B\u0435\u0442\u043E... \u042F \u0443\u0436\u0435 \u0447\u0443\u044E \u0437\u0430\u043F\u0430\u0445 \u043E\u0441\u0442\u0440\u044B\u0445 \u044F\u0433\u043E\u0434.$h",
  "summer_9": "\u041F\u0440\u043E\u0441\u0442\u0438, \u0435\u0441\u043B\u0438 \u044F \u043C\u043E\u043A\u0440\u0430\u044F... \u042F \u043D\u043E\u0447\u044C\u044E \u0441\u0438\u043B\u044C\u043D\u043E \u043F\u043E\u0442\u0435\u044E \u043E\u0442 \u0436\u0430\u0440\u044B.",
  "summer_2": "\u0412\u043E\u0442 \u0438 \u043B\u0435\u0442\u043E... \u0422\u0435\u043F\u0435\u0440\u044C \u0432 \u0434\u043E\u043C\u0435 \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u043B\u043D\u043E \u043C\u0443\u0445.#$e#\u041D\u0435 \u0432\u043E\u043B\u043D\u0443\u0439\u0441\u044F, \u044F \u0441 \u043D\u0438\u043C\u0438 \u0440\u0430\u0437\u0431\u0435\u0440\u0443\u0441\u044C.",
  "fall_1": "\u042F \u043B\u044E\u0431\u043B\u044E \u043E\u0441\u0435\u043D\u044C. \u0421\u0442\u043E\u043B\u044C\u043A\u043E \u0433\u0440\u0438\u0431\u043E\u0432 \u043C\u043E\u0436\u043D\u043E \u0441\u043E\u0431\u0440\u0430\u0442\u044C. \u041D\u043E \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u043E\u043D\u0430 \u043E\u0447\u0435\u043D\u044C \u0431\u044B\u0441\u0442\u0440\u043E.",
  "fall_20": "\u0423 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C \u043A\u0430\u043A\u0438\u0435-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u043B\u0430\u043D\u044B \u043D\u0430 \u0437\u0438\u043C\u0443? \u041D\u0435\u043F\u043B\u043E\u0445\u043E \u0431\u044B \u0438\u043C\u0435\u0442\u044C \u0437\u0430\u043F\u0430\u0441 \u0441\u0435\u043D\u0430.",
  "fall_2": "\u042F \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0441\u0435\u0437\u043E\u043D \u0441\u0431\u043E\u0440\u0430 \u0443\u0440\u043E\u0436\u0430\u044F \u0434\u043B\u044F \u0442\u0435\u0431\u044F \u0437\u0430\u043D\u044F\u0442\u043E\u0439. \u042F \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C \u043F\u043E\u043C\u043E\u0447\u044C, \u0447\u0435\u043C \u0441\u043C\u043E\u0433\u0443.",
  "winter_1": "\u041F\u0440\u0438\u0448\u043B\u0430 \u0437\u0438\u043C\u0430, \u0430 \u0437\u043D\u0430\u0447\u0438\u0442, \u0441\u0435\u0439\u0447\u0430\u0441 \u0441\u0435\u0437\u043E\u043D \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445 \u0444\u0440\u0443\u043A\u0442\u043E\u0432. \u0423 \u043D\u0438\u0445 \u0442\u0430\u043A\u043E\u0439 \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0439 \u0432\u043A\u0443\u0441, \u043F\u0440\u0430\u0432\u0434\u0430?",
  "winter_7": "\u042F \u043F\u0440\u0435\u0434\u0432\u043A\u0443\u0448\u0430\u044E, \u043A\u0430\u043A \u0431\u0443\u0434\u0443 \u0437\u0430\u0432\u0442\u0440\u0430 \u0432\u0430\u044F\u0442\u044C \u043B\u0435\u0434\u043E\u0432\u044B\u0435 \u0441\u043A\u0443\u043B\u044C\u043F\u0442\u0443\u0440\u044B. \u041C\u043D\u0435 \u044D\u0442\u043E \u0443\u0434\u0430\u0435\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0437 \u0432 \u0433\u043E\u0434\u0443, \u043D\u043E \u0437\u0430\u0442\u043E \u043A\u0430\u043A \u0432\u0435\u0441\u0435\u043B\u043E!",
  "winter_28": "\u042D\u0439, \u0437\u0430 \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0439 \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u0439 \u0433\u043E\u0434 \u043D\u0430 \u0444\u0435\u0440\u043C\u0435 \u00AB%farm\u00BB! \u041F\u043E\u0432\u0435\u0441\u0435\u043B\u0438\u043C\u0441\u044F \u0436\u0435 \u0441\u0435\u0433\u043E\u0434\u043D\u044F![348]$h#$e#\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0433\u043E\u0434 \u0431\u0443\u0434\u0435\u0442 \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u043C, \u044F \u044D\u0442\u043E \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E."
}