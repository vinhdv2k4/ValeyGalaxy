  "AcceptGift_Positive_category_greens": "\u0425\u043E\u0440\u043E\u0448\u0430\u044F \u043D\u0430\u0445\u043E\u0434\u043A\u0430! \u042F \u0432\u0441\u0435\u0433\u0434\u0430 \u0440\u0430\u0434 \u0434\u0438\u043A\u043E\u0439 \u043F\u0438\u0449\u0435. \u0421\u043F\u0430\u0441\u0438\u0431\u043E.",
  "married": "\u041E\u0434\u043D\u0430\u0436\u0434\u044B \u044F \u0445\u043E\u0442\u0435\u043B \u0441\u0432\u044F\u0437\u0430\u0442\u044C \u0441\u0435\u0431\u044F \u0441 \u043A\u0435\u043C-\u0442\u043E \u0443\u0437\u0430\u043C\u0438 \u0431\u0440\u0430\u043A\u0430. \u0421\u0435\u0439\u0447\u0430\u0441 \u0436\u0435 \u044F \u0432 \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u043E\u043C \u0441\u043E\u044E\u0437\u0435 \u0441 \u0432\u0435\u0442\u0440\u043E\u043C, \u0448\u0443\u0440\u0448\u0430\u0449\u0438\u043C \u0432 \u043B\u0438\u0441\u0442\u044C\u044F\u0445, \u0438 \u043B\u044F\u0433\u0443\u0448\u043A\u0430\u043C\u0438, \u043A\u0432\u0430\u043A\u0430\u044E\u0449\u0438\u043C\u0438 \u043F\u043E\u0434 \u043B\u0443\u043D\u043E\u0439.",
  "GreenRain": "\u0417\u0430\u0432\u0442\u0440\u0430 \u0432\u0441\u0435 \u044D\u0442\u0438 \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0435 \u0434\u0435\u0440\u0435\u0432\u044C\u044F \u0438\u0441\u0447\u0435\u0437\u043D\u0443\u0442... \u042D\u0442\u043E \u043E\u0434\u043D\u0430 \u0438\u0437 \u0437\u0430\u0433\u0430\u0434\u043E\u043A \u043F\u0440\u0438\u0440\u043E\u0434\u044B.",
  "GreenRainFinished": "\u041A\u0430\u043A \u0442\u0430\u043C \u0441\u0431\u043E\u0440 \u043C\u0445\u0430? \u0425\u0435-\u0445\u0435... \u041C\u043E\u044F \u043A\u0440\u043E\u0432\u0430\u0442\u044C \u0442\u0435\u043F\u0435\u0440\u044C \u043D\u0430\u043C\u043D\u043E\u0433\u043E \u043C\u044F\u0433\u0447\u0435.",
  "GreenRain_2": "\u042F \u0443\u0436\u0435 \u0441\u043E\u0431\u0440\u0430\u043B \u043C\u0445\u0430 \u043D\u0430 \u0432\u0435\u0441\u044C \u0433\u043E\u0434. \u0410 \u0442\u044B?",
  "AcceptGift_(O)774": "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C... \u0412\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E. \u0422\u044B \u0445\u043E\u0440\u043E\u0448\u043E \u0443\u0447\u0438\u0448\u044C\u0441\u044F, @.$h",
  "AcceptGift_(O)166": "\u041D\u0435\u0442, \u0441\u043F\u0430\u0441\u0438\u0431\u043E. \u0414\u0435\u043D\u0435\u0433 \u043C\u043D\u0435 \u043D\u0435 \u043D\u0443\u0436\u043D\u043E... \u042F \u0432\u043E\u043E\u0431\u0449\u0435 \u0441\u0447\u0438\u0442\u0430\u044E, \u0447\u0442\u043E \u043E\u043D\u0438 \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u044B. [166]",
  "AcceptGift_Positive_category_fish": "\u0410\u0433\u0430, \u043D\u0430 \u0432\u0438\u0434 \u0441\u0432\u0435\u0436\u0430\u044F. \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0443\u0436\u0438\u043D \u0431\u0443\u0434\u0435\u0442 \u043D\u0430 \u0441\u043B\u0430\u0432\u0443!$h",
  "reject_869": "\u0427\u0442\u043E \u044D\u0442\u043E \u0443 \u0442\u0435\u0431\u044F \u0442\u0430\u043C? \u041F\u043E\u0445\u043E\u0436\u0435, \u0438\u0437 \u044D\u0442\u043E\u0433\u043E \u0432\u044B\u0439\u0434\u0435\u0442 \u0445\u043E\u0440\u043E\u0448\u0430\u044F \u043F\u0440\u0438\u043C\u0430\u043D\u043A\u0430.$h",
  "cc_Boulder": "\u041C\u043E\u0439 \u0441\u0442\u0430\u0440\u044B\u0439 \u0434\u0440\u0443\u0433, \u0441\u0432\u0435\u0440\u043A\u0430\u044E\u0449\u0438\u0439 \u0431\u0443\u043B\u044B\u0436\u043D\u0438\u043A, \u043A\u0443\u0434\u0430-\u0442\u043E \u0434\u0435\u043B\u0441\u044F. \u041A\u043E\u043C\u0443-\u0442\u043E \u044D\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u043D\u0435\u0432\u0430\u0436\u043D\u044B\u043C, \u0430 \u0434\u043B\u044F \u043C\u0435\u043D\u044F \u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u0434\u0435\u043B\u043E.#$b#\u041D\u043E \u044F \u0440\u0430\u0434, \u0447\u0442\u043E \u0441\u0442\u0430\u0440\u044B\u0439 \u043A\u0430\u043C\u0435\u043D\u044E\u043A\u0430 \u0443\u0432\u0438\u0434\u0438\u0442 \u043C\u0438\u0440.$h",
  "mineArea_80": "\u041C\u0430\u043B\u043E \u043A\u0442\u043E \u0437\u0430\u0431\u0438\u0440\u0430\u043B\u0441\u044F \u0442\u0430\u043A \u0436\u0435 \u0433\u043B\u0443\u0431\u043E\u043A\u043E \u0432 \u0448\u0430\u0445\u0442\u044B, \u043A\u0430\u043A \u0442\u044B.",
  "eventSeen_8357109": "\u0412\u043E\u0434\u0430 \u0441\u0442\u0435\u043A\u0430\u0435\u0442 \u0441\u044E\u0434\u0430 \u0441 \u043B\u0435\u0434\u043D\u0438\u043A\u043E\u0432 \u0432\u044B\u0441\u043E\u043A\u043E \u0432 \u0433\u043E\u0440\u0430\u0445.#$e#\u041E\u0434\u043D\u0430\u0436\u0434\u044B \u044F \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F \u043A \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0443, \u043F\u0440\u043E\u0441\u0442\u043E \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u0434\u0430\u0442\u044C \u0434\u0430\u043D\u044C \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F \u0432\u043E\u0434\u0435.",
  "movieTheater": "\u041A\u0438\u043D\u043E\u0442\u0435\u0430\u0442\u0440? \u0425\u043C-\u043C... \u041F\u043E \u043C\u043D\u0435, \u0442\u0430\u043A \u043F\u043B\u0430\u0432\u043D\u044B\u0435 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u044B \u043F\u0440\u0438\u0440\u043E\u0434\u044B \u2014 \u0432\u0441\u044F \u0434\u0440\u0430\u043C\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u0430.",
  "MovieInvitation": "\u041E\u0439... \u044F? \u041E\u0431\u044B\u0447\u043D\u043E \u044F \u043D\u0435... \u043D\u043E \u0442\u0443\u0442 \u043B\u0430\u0434\u043D\u043E. \u0420\u0430\u0434, \u0447\u0442\u043E \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0448\u044C \u043E\u0431\u043E \u043C\u043D\u0435.#$b#\u0421\u043A\u043E\u0440\u043E \u0442\u0443\u0434\u0430 \u0432\u044B\u0434\u0432\u0438\u043D\u0443\u0441\u044C.",
  "DumpsterDiveComment": "\u0415\u0441\u0442\u044C \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0445\u043E\u0440\u043E\u0448\u0435\u0435?$h",
  "Mon": "\u0412\u0441\u0435, \u0447\u0442\u043E \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u2014 \u0441\u0432\u0435\u0436\u0438\u0439 \u0432\u043E\u0437\u0434\u0443\u0445 \u043D\u0430 \u043F\u0440\u0438\u0440\u043E\u0434\u0435.#$e#\u042F \u0436\u0438\u0432\u0443 \u0437\u0434\u0435\u0441\u044C \u043F\u043E \u0441\u0432\u043E\u0435\u0439 \u0432\u043E\u043B\u0435.",
  "Tue": "... \u0411\u0443\u0434\u0435\u0448\u044C \u043D\u0430\u0434\u043E \u043C\u043D\u043E\u0439 \u0438\u0437\u0434\u0435\u0432\u0430\u0442\u044C\u0441\u044F?#$e#\u042F \u043D\u0438\u043A\u043E\u043C\u0443 \u043D\u0435 \u043C\u0435\u0448\u0430\u044E.",
  "Wed": "\u042F \u043D\u0435 \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0437\u043D\u0430\u044E \u0442\u0435\u0431\u044F, \u0447\u0442\u043E\u0431\u044B \u0434\u043E\u0432\u0435\u0440\u044F\u0442\u044C \u0442\u0435\u0431\u0435. \u041F\u0440\u043E\u0441\u0442\u0438.",
  "Thu": "... \u0425\u043C-\u043C? \u0422\u0435\u0431\u0435 \u0447\u0442\u043E-\u0442\u043E \u043E\u0442 \u043C\u0435\u043D\u044F \u043D\u0443\u0436\u043D\u043E?",
  "Fri": "\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043D\u0435 \u043B\u043E\u043C\u0430\u0439 \u043C\u043E\u044E \u043F\u0430\u043B\u0430\u0442\u043A\u0443.#$e#\u0411\u044B\u043B\u0438 \u043F\u0440\u0435\u0446\u0435\u0434\u0435\u043D\u0442\u044B.$s",
  "Sat": "\u042F \u0438 \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0443 \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432.#$e#\u041D\u043E\u0432\u044B\u0435 \u0434\u0440\u0443\u0437\u044C\u044F \u043C\u043D\u0435 \u043D\u0435 \u043D\u0443\u0436\u043D\u044B.",
  "Sun4": "\u0411\u044B\u043B\u043E \u0431\u044B \u0437\u0434\u043E\u0440\u043E\u0432\u043E, \u0435\u0441\u043B\u0438 \u0431\u044B \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u043B\u0438 \u043C\u0435\u043D\u044F \u0442\u0430\u043A\u0438\u043C, \u043A\u0430\u043A\u043E\u0439 \u044F \u0435\u0441\u0442\u044C.$s#$b#\u041C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u0436\u0438\u0442\u044C \u0437\u0434\u0435\u0441\u044C, \u043F\u043E\u0434 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C \u043D\u0435\u0431\u043E\u043C. \u042D\u0442\u043E\u0433\u043E \u043E\u043D\u0438 \u0438 \u043D\u0435 \u043C\u043E\u0433\u0443\u0442 \u043F\u043E\u043D\u044F\u0442\u044C.",
  "Tue4": "\u041D\u0430\u0443\u0447\u0438\u0442\u044C\u0441\u044F \u0432\u044B\u0436\u0438\u0432\u0430\u0442\u044C \u0432 \u0434\u0438\u043A\u043E\u0439 \u043F\u0440\u0438\u0440\u043E\u0434\u0435 \u0432\u043F\u043E\u043B\u043D\u0435 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E. \u042F \u0436\u0435 \u043D\u0430\u0443\u0447\u0438\u043B\u0441\u044F.#$e#\u0414\u0443\u043C\u0430\u044E, \u0432 \u043A\u0430\u0436\u0434\u043E\u043C \u0438\u0437 \u043D\u0430\u0441 \u0435\u0441\u0442\u044C \u0441\u043A\u0440\u044B\u0442\u043E\u0435 \u0441\u0442\u0440\u0435\u043C\u043B\u0435\u043D\u0438\u0435 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u0432 \u0434\u0438\u043A\u0443\u044E \u043F\u0440\u0438\u0440\u043E\u0434\u0443. \u041F\u0440\u043E\u0441\u0442\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u043E \u043F\u043E\u0439\u0442\u0438 \u043D\u0430 \u044D\u0442\u043E\u0442 \u0448\u0430\u0433.",
  "Wed6": "\u042F \u043C\u043D\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043F\u0440\u043E\u0432\u043E\u0436\u0443 \u0432 \u0440\u0430\u0437\u0434\u0443\u043C\u044C\u044F\u0445.#$e#\u0415\u0441\u043B\u0438 \u0441\u043C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u043F\u043E\u0437\u043D\u0430\u0442\u044C \u043C\u043E\u0442\u0438\u0432\u044B \u0441\u0432\u043E\u0438\u0445 \u043C\u044B\u0441\u043B\u0435\u0439, \u0442\u043E \u0432\u044B\u0439\u0434\u0435\u0448\u044C \u043D\u0430 \u043D\u043E\u0432\u044B\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u0431\u044B\u0442\u0438\u044F.",
  "Wed2": "\u042F \u0432\u044B\u043D\u0443\u0436\u0434\u0435\u043D \u043E\u0441\u0442\u0435\u0440\u0435\u0433\u0430\u0442\u044C\u0441\u044F \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u0446\u0435\u0432. \u041D\u0435\u043C\u043D\u043E\u0433\u0438\u043C \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u0022\u0434\u0438\u043A\u0438\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0022.",
  "Thu4": "\u041B\u044E\u0434\u0438 \u0437\u0434\u0435\u0441\u044C \u043D\u0435\u043F\u043B\u043E\u0445\u0438\u0435, \u043D\u043E \u043E\u043D\u0438 \u043C\u0435\u043D\u044F \u0438\u0437\u0431\u0435\u0433\u0430\u044E\u0442.#$e#\u041B\u044E\u0434\u0438 \u0431\u043E\u044F\u0442\u0441\u044F \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E.$u",
  "Fri4": "\u0423 \u0434\u0435\u0440\u0435\u0432\u044C\u0435\u0432 \u043C\u043E\u0436\u043D\u043E \u043C\u043D\u043E\u0433\u043E\u043C\u0443 \u043D\u0430\u0443\u0447\u0438\u0442\u044C\u0441\u044F.#$b#\u0415\u0441\u043B\u0438 \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u0441\u0440\u0435\u0434\u0438 \u043D\u0438\u0445 \u043A\u0430\u043A\u043E\u0435-\u0442\u043E \u0432\u0440\u0435\u043C\u044F, \u043E\u043D\u0438 \u043C\u043E\u0433\u0443\u0442 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C \u0442\u0435\u0431\u0435 \u0441\u0432\u043E\u0438 \u0442\u0430\u0439\u043D\u044B.#$e#\u0418\u0434\u0438 \u0441 \u043C\u0438\u0440\u043E\u043C, \u0434\u0435\u0442\u0435\u043D\u044B\u0448.",
  "Sat4": "\u0423 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u0432\u0441\u0435, \u0447\u0442\u043E \u043D\u0443\u0436\u043D\u043E \u0434\u043B\u044F \u0432\u044B\u0436\u0438\u0432\u0430\u043D\u0438\u044F, \u0438 \u0434\u0430\u0436\u0435 \u0431\u043E\u043B\u044C\u0448\u0435. \u041F\u0440\u0438\u0440\u043E\u0434\u0430 \u043D\u0430\u043F\u0435\u0432\u0430\u0435\u0442 \u0447\u0443\u0434\u0435\u0441\u043D\u0443\u044E \u043C\u0435\u043B\u043E\u0434\u0438\u044E, \u043D\u0443\u0436\u043D\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u0443\u0447\u0438\u0442\u044C\u0441\u044F \u0441\u043B\u0443\u0448\u0430\u0442\u044C.",
  "Sun": "#$1 linusVandal#\u0412\u0447\u0435\u0440\u0430 \u0432\u0435\u0447\u0435\u0440\u043E\u043C \u043A\u0442\u043E-\u0442\u043E \u043A\u0438\u0434\u0430\u043B\u0441\u044F \u043A\u0430\u043C\u043D\u044F\u043C\u0438 \u0432 \u043C\u043E\u044E \u043F\u0430\u043B\u0430\u0442\u043A\u0443... \u041C\u043D\u0435 \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u044D\u0442\u043E \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C.$s$k#$e#\u041D\u0435 \u043B\u044E\u0431\u043B\u044E \u0434\u043E\u043B\u0433\u043E \u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u043E\u0434\u043D\u043E\u043C \u043C\u0435\u0441\u0442\u0435. \u0421\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E \u0432\u0441\u0435\u0433\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E\u0433\u043E \u0432 \u043C\u0438\u0440\u0435.",
  "summer_Mon4": "\u0417\u0430 \u0432\u0441\u0435 \u044D\u0442\u0438 \u0433\u043E\u0434\u044B \u044F \u0443\u0437\u043D\u0430\u043B \u043F\u0430\u0440\u0443 \u0441\u0435\u043A\u0440\u0435\u0442\u043E\u0432 \u0436\u0438\u0437\u043D\u0438.#$e#\u041D\u0435 \u043C\u043E\u0433\u0443 \u0442\u0435\u0431\u0435 \u0441\u043A\u0430\u0437\u0430\u0442\u044C, \u0438\u0445 \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F \u0443\u0437\u043D\u0430\u0432\u0430\u0442\u044C \u0441\u0430\u043C\u043E\u043C\u0443.",
  "summer_Mon": "#$1 LinusHeron#\u0421\u043A\u0432\u043E\u0437\u044C \u0443\u0442\u0440\u0435\u043D\u043D\u044E\u044E \u0434\u044B\u043C\u043A\u0443 \u044F \u0432\u0438\u0434\u0435\u043B, \u043A\u0430\u043A \u0446\u0430\u043F\u043B\u044F \u0433\u0440\u0430\u0446\u0438\u043E\u0437\u043D\u043E \u0432\u044B\u0448\u0430\u0433\u0438\u0432\u0430\u043B\u0430 \u043F\u043E \u0432\u043E\u0434\u0435. \u0422\u0430\u043A\u043E\u0432\u044B \u0441\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u0430 \u0442\u0438\u0445\u043E\u0439 \u0436\u0438\u0437\u043D\u0438.$k#$e#\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u0443\u0436 \u043B\u0435\u0433\u043A\u043E \u0437\u0430\u0442\u0435\u0440\u044F\u0442\u044C\u0441\u044F \u0432 \u0448\u0443\u043C\u0435 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439 \u0436\u0438\u0437\u043D\u0438. \u041B\u0443\u0447\u0448\u0438\u0435 \u0442\u0432\u043E\u0438 \u0433\u043E\u0434\u044B \u043F\u0440\u043E\u0439\u0434\u0443\u0442 \u0431\u0435\u0441\u0444\u043E\u0440\u043C\u0435\u043D\u043D\u044B\u043C \u043F\u044F\u0442\u043D\u043E\u043C. \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0443\u0436\u043D\u043E \u043D\u0430\u0443\u0447\u0438\u0442\u044C\u0441\u044F \u043F\u0440\u0438\u0442\u043E\u0440\u043C\u043E\u0437\u0438\u0442\u044C.",
  "summer_Tue4": "\u041A\u0430\u043A \u0442\u0432\u043E\u0438 \u0434\u0435\u043B\u0430, \u043C\u043E\u0439 \u044E\u043D\u044B\u0439 \u0434\u0440\u0443\u0433?",
  "summer_Wed6": "\u0410\u0445... \u041B\u0435\u0442\u043E. \u0442\u0435\u043F\u043B\u043E\u0435 \u0441\u043E\u043B\u043D\u0446\u0435 \u043D\u0430\u0433\u0440\u0435\u0432\u0430\u0435\u0442 \u043C\u043D\u0435 \u0436\u0435\u0441\u0442\u044F\u043D\u043A\u0438.#$b#\u0422\u043E\u0433\u0434\u0430 \u0432\u0435\u0447\u0435\u0440\u043E\u043C \u0443 \u043C\u0435\u043D\u044F \u0431\u0443\u0434\u0435\u0442 \u0442\u0435\u043F\u043B\u0430\u044F \u043F\u0438\u0449\u0430.",
  "summer_Thu4": "\u0423 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u0441\u0432\u043E\u0438 \u043F\u0440\u0438\u0447\u0438\u043D\u044B \u0436\u0438\u0442\u044C \u0432\u043E\u0442 \u0442\u0430\u043A, \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u0435.#$e#\u041E \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0432\u0435\u0449\u0430\u0445 \u043B\u0443\u0447\u0448\u0435 \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C...#$e#\u041D\u0443\u0436\u043D\u043E \u0437\u0430\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u0435\u0434\u044B.",
  "summer_Fri4": "\u041A\u043E\u0433\u0434\u0430 \u043B\u043E\u0432\u0438\u0448\u044C \u0440\u044B\u0431\u0443, \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0441\u044C \u043D\u0430 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435 \u0438 \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438 \u0440\u044B\u0431\u0443 \u0437\u0430 \u0435\u0435 \u0436\u0435\u0440\u0442\u0432\u0443.#$b#\u0414\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u0442\u044B \u043D\u0435 \u0432\u0435\u0440\u0438\u0448\u044C, \u0447\u0442\u043E \u0443 \u0440\u044B\u0431\u044B \u0435\u0441\u0442\u044C \u0434\u0443\u0448\u0430, \u044D\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u043B\u0435\u0437\u043D\u043E\u0439 \u0434\u0443\u0445\u043E\u0432\u043D\u043E\u0439 \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u043E\u0439. \u041D\u0443\u0436\u043D\u043E \u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C, \u043A\u0430\u043A\u043E\u0435 \u0432\u043B\u0438\u044F\u043D\u0438\u0435 \u043C\u044B \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u043C \u043D\u0430 \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u0439 \u043C\u0438\u0440.",
  "summer_Sat4": "\u0421\u0435\u0439\u0447\u0430\u0441 \u0432 \u0440\u0435\u043A\u0430\u0445 \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0439\u043C\u0430\u0442\u044C \u0440\u0430\u0434\u0443\u0436\u043D\u0443\u044E \u0444\u043E\u0440\u0435\u043B\u044C.",
  "summer_Sun": "\u042D\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u0433\u043E\u0434\u0430 \u0434\u043B\u044F \u043C\u0435\u043D\u044F \u043F\u043E\u043F\u0440\u043E\u0449\u0435. \u041D\u0435 \u043D\u0443\u0436\u043D\u043E \u0434\u0443\u043C\u0430\u0442\u044C, \u043A\u0430\u043A \u043E\u0431\u043E\u0433\u0440\u0435\u0442\u044C \u0441\u0435\u0431\u044F.#$e#\u0414\u0430 \u0438 \u0434\u0438\u043A\u0438\u0435 \u043F\u043B\u043E\u0434\u044B \u0440\u0430\u0441\u0442\u0443\u0442 \u043F\u043E\u0432\u0441\u044E\u0434\u0443.",
  "fall_Mon": "\u042F \u0437\u0430\u0445\u043E\u0434\u0438\u043B \u0433\u043B\u0443\u0431\u043E\u043A\u043E \u0432 \u043F\u0435\u0449\u0435\u0440\u044B.#$e#\u0412 \u043D\u0438\u0445 \u0441\u043E\u043A\u0440\u044B\u0442\u044B \u043E\u0441\u043E\u0431\u044B\u0435 \u0442\u0430\u0439\u043D\u044B.#$e#\u0422\u043E\u043B\u044C\u043A\u043E \u0431\u0443\u0434\u044C \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u0435\u043D, \u0435\u0441\u043B\u0438 \u0441\u043F\u0443\u0441\u0442\u0438\u0448\u044C\u0441\u044F \u0442\u0443\u0434\u0430.",
  "fall_Tue4": "#$1 LinusFall1#\u041A\u0430\u043A\u043E\u0439-\u0442\u043E \u0448\u0443\u0442\u043D\u0438\u043A \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043B \u043C\u043D\u0435 \u043D\u043E\u0447\u044C\u044E \u0432\u0435\u0441\u044C \u0434\u043E\u043C... \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0442\u044C \u0443\u0442\u0440\u043E\u043C \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0447\u0430\u0441\u043E\u0432, \u0447\u0442\u043E\u0431\u044B \u0435\u0433\u043E \u043E\u0442\u043C\u044B\u0442\u044C.$k#$e#\u041D\u0443\u0436\u043D\u043E \u043D\u0430\u0447\u0438\u043D\u0430\u0442\u044C \u0437\u0430\u0433\u043E\u0442\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C \u0434\u0440\u043E\u0432\u0430 \u043D\u0430 \u0437\u0438\u043C\u0443.#$e#\u0423 \u0442\u0435\u0431\u044F \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0434\u0440\u043E\u0432, \u0447\u0442\u043E\u0431\u044B \u0441\u043E\u0433\u0440\u0435\u0442\u044C \u0434\u043E\u043C \u0437\u0438\u043C\u043E\u0439?",
  "fall_Wed4": "\u0414\u0435\u043B \u0443 \u043C\u0435\u043D\u044F \u043D\u0435\u043C\u043D\u043E\u0433\u043E, \u0442\u0430\u043A \u0447\u0442\u043E \u044F \u043C\u043D\u043E\u0433\u043E \u0434\u0443\u043C\u0430\u044E.#$e#\u041D\u0443\u0436\u043D\u043E \u043F\u043E\u043D\u044F\u0442\u044C \u0441\u0432\u043E\u0438 \u043C\u044B\u0441\u043B\u0438, \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0441\u043C\u043E\u0436\u0435\u0448\u044C \u0438\u043C\u0438 \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C.",
  "fall_Sun": "\u041D\u0435 \u043B\u044E\u0431\u043B\u044E \u0434\u043E\u043B\u0433\u043E \u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u043E\u0434\u043D\u043E\u043C \u043C\u0435\u0441\u0442\u0435.",
  "fall_Sun6": "\u0413\u0440\u0438\u0431\u043D\u043E\u0439 \u043F\u0438\u0440 \u043E\u0441\u0435\u043D\u044C\u044E \u2014 \u044D\u0442\u043E \u0447\u0442\u043E-\u0442\u043E \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0435.$h",
  "winter_Mon": "\u041A\u043E\u0433\u0434\u0430 \u0436\u0438\u0432\u0435\u0448\u044C \u0432 \u043F\u0430\u043B\u0430\u0442\u043A\u0435, \u0438\u043D\u043E\u0433\u0434\u0430 \u0431\u044B\u0432\u0430\u0435\u0442 \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u043B\u043E\u0434\u043D\u043E.$s",
  "winter_Mon4": "\u041F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u043E\u0442\u0434\u0430\u043B\u0438\u0448\u044C\u0441\u044F \u043E\u0442 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E \u043E\u0431\u0440\u0430\u0437\u0430 \u0436\u0438\u0437\u043D\u0438, \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0448\u044C \u043F\u043E-\u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C\u0443 \u0446\u0435\u043D\u0438\u0442\u044C \u043F\u0440\u043E\u0441\u0442\u044B\u0435 \u0432\u0435\u0449\u0438... \u0421\u043E\u043B\u043D\u0446\u0435, \u0441\u043F\u0435\u043B\u044B\u0435 \u0444\u0440\u0443\u043A\u0442\u044B, \u043D\u0430\u0439\u0442\u0438 \u043F\u0430\u043B\u043A\u0443 \u0442\u043E\u0439 \u0444\u043E\u0440\u043C\u044B, \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0438\u0441\u043A\u0430\u043B.",
  "winter_Tue4": "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E \u043D\u0435 \u0447\u0443\u0440\u0430\u0435\u0448\u044C\u0441\u044F \u043C\u0435\u043D\u044F, @. \u041D\u0443\u0436\u043D\u043E \u0431\u044B\u0442\u044C \u043E\u0447\u0435\u043D\u044C \u043C\u0443\u0434\u0440\u044B\u043C, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0434\u0430\u0432\u0438\u0442\u044C \u0441\u0432\u043E\u0438 \u0431\u0430\u0437\u043E\u0432\u044B\u0435 \u0438\u043D\u0441\u0442\u0438\u043D\u043A\u0442\u044B.#$e#\u042F \u0432\u0435\u0434\u044C \u0442\u0430\u043A\u043E\u0439 \u0436\u0435 \u0447\u0435\u043B\u043E\u0432\u0435\u043A, \u043A\u0430\u043A \u0438 \u0432\u0441\u0435 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435. \u041F\u0440\u043E\u0441\u0442\u043E \u0443 \u043C\u0435\u043D\u044F \u0434\u0440\u0443\u0433\u043E\u0439 \u043E\u0431\u0440\u0430\u0437 \u0436\u0438\u0437\u043D\u0438.",
  "winter_Wed4": "\u042F \u0443\u0432\u0435\u0440\u0435\u043D, \u0447\u0442\u043E \u0442\u044B \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C, \u043F\u043E\u0447\u0435\u043C\u0443 \u044F \u043E\u043F\u0430\u0441\u0430\u044E\u0441\u044C \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u0446\u0435\u0432.#$e#\u041D\u043E \u0434\u0430\u0432\u0430\u0439 \u0437\u0430\u0431\u0443\u0434\u0435\u043C \u043E\u0431 \u044D\u0442\u043E\u043C, \u0445\u043E\u0440\u043E\u0448\u043E? \u0414\u0443\u043C\u0430\u044E, \u043C\u044B \u0441 \u0442\u043E\u0431\u043E\u0439 \u0442\u0435\u043F\u0435\u0440\u044C \u0434\u0440\u0443\u0437\u044C\u044F.",
  "winter_Thu4": "\u0417\u0438\u043C\u043E\u0439 \u0431\u044B\u0432\u0430\u0435\u0442 \u043D\u0435\u043F\u0440\u043E\u0441\u0442\u043E, \u043D\u043E \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0436\u0438\u0442\u044C \u0440\u044B\u0431\u0430\u043B\u043A\u043E\u0439 \u0438 \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\u043C.#$e#\u0415\u0441\u043B\u0438 \u0442\u044B \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0448\u044C \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445, \u0434\u0435\u0440\u0436\u0438 \u0438\u0445 \u043F\u043E\u0434 \u043A\u0440\u044B\u0448\u0435\u0439.",
  "winter_Fri4": "\u0417\u0438\u043C\u043E\u0439 \u0434\u0435\u0440\u0435\u0432\u044C\u044F \u0437\u0430\u0441\u044B\u043F\u0430\u044E\u0442. \u0411\u0435\u0437 \u043D\u0438\u0445 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043E\u0434\u0438\u043D\u043E\u043A\u043E.#$e#\u041D\u043E \u044F \u043D\u0435 \u043C\u043E\u0433\u0443 \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C \u0438\u043C \u0432 \u0445\u043E\u0440\u043E\u0448\u0435\u043C \u0441\u043D\u0435.$h",
  "winter_Sat4": "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E \u0437\u0430\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0448\u044C. \u041C\u043D\u0435 \u043A\u0430\u043A \u0440\u0430\u0437 \u0431\u044B\u043B\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043E\u0434\u0438\u043D\u043E\u043A\u043E \u044D\u0442\u0438\u043C \u0443\u0442\u0440\u043E\u043C.#$e#\u041D\u0443 \u0447\u0442\u043E, \u043D\u0430\u0448\u043B\u043E\u0441\u044C \u0432 \u0448\u0430\u0445\u0442\u0435 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E\u0433\u043E?",
  "winter_Sun": "\u0421\u043F\u0430\u0442\u044C \u043D\u0430 \u0437\u0435\u043C\u043B\u0435 \u043F\u043E\u043B\u0435\u0437\u043D\u043E \u0434\u043B\u044F \u0441\u043F\u0438\u043D\u044B.#$e#\u041D\u0443\u0436\u043D\u043E \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043D\u0430 \u043C\u0438\u0440 \u0441 \u043E\u043F\u0442\u0438\u043C\u0438\u0437\u043C\u043E\u043C.$h"
}