{
  "Introduction": "\u0425\u043C-\u043C\u0444... \u041A\u0430\u043A \u0436\u0435 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0430\u0435\u0442 \u0437\u0434\u043E\u0440\u043E\u0432\u0430\u0442\u044C\u0441\u044F \u0441\u043E \u0432\u0441\u0435\u043C\u0438 \u044D\u0442\u0438\u043C\u0438 \u043D\u043E\u0432\u0438\u0447\u043A\u0430\u043C\u0438, \u0430?#$b#\u0417\u043E\u0432\u0443\u0442 \u043C\u0435\u043D\u044F \u0414\u0436\u043E\u0440\u0434\u0436, \u043A\u0441\u0442\u0430\u0442\u0438. \u0410 \u0442\u0435\u043F\u0435\u0440\u044C \u043E\u0442\u0432\u044F\u0436\u0438\u0441\u044C... \u0425\u043C-\u043C\u0444.",
  "AcceptGift_(O)StardropTea": "\u0425\u043C-\u043C... *\u0445\u043B\u044E\u043F*... \u0410-\u0430-\u0430\u0445... \u041D\u0430 \u0432\u043A\u0443\u0441 \u043A\u0430\u043A \u043C\u0430\u043C\u0438\u043D\u0430 \u0437\u0430\u043F\u0435\u043A\u0430\u043D\u043A\u0430 \u0438\u0437 \u0442\u0443\u043D\u0446\u0430! \u0412\u043A\u0443\u0441\u043D\u044F\u0442\u0438\u043D\u0430!",
  "accept_867": "\u042D\u0442\u043E \u0447\u0442\u043E \u0442\u0430\u043A\u043E\u0435?#$b#\u0422\u0430\u043A... \u0417\u043D\u0430\u0447\u0438\u0442, \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0443\u0436\u043D\u043E \u043D\u0430\u0436\u0430\u0442\u044C \u043D\u0430 \u044D\u0442\u0443 \u043A\u043D\u043E\u043F\u043A\u0443? \u0410 \u0447\u0442\u043E \u043E\u043D\u0430 \u0434\u0435\u043B\u0430\u0435\u0442? \u0425\u043C... *\u0432\u043E\u0440\u0447\u0438\u0442*#$b#\u0425\u0435-\u0445\u0435! \u0412\u043E\u0442 \u0442\u0430\u043A \u043A\u0430\u043A! \u041D\u043E\u0432\u044B\u0439 \u043A\u0430\u043D\u0430\u043B!$h#$b#\u0412\u043E\u0442, \u0432\u043E\u0437\u044C\u043C\u0438. \u042F \u043D\u0430\u0448\u0435\u043B \u044D\u0442\u043E\u0442 \u043A\u0430\u043C\u0435\u043D\u044C, \u043A\u043E\u0433\u0434\u0430 \u043D\u0430 \u0443\u0433\u043E\u043B\u044C\u043D\u043E\u0439 \u0448\u0430\u0445\u0442\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u043B. \u0417\u0430\u0431\u0430\u0432\u043D\u043E\u0435 \u0434\u0435\u043B\u043E, \u043E\u043D \u0441\u043E\u0440\u043E\u043A \u043B\u0435\u0442 \u0441\u0432\u0435\u0442\u0438\u043B\u0441\u044F \u0433\u043E\u043B\u0443\u0431\u044B\u043C \u0438 \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0441\u044F \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u043C. \u041A\u0430\u043A\u043E\u0435-\u0442\u043E \u043F\u0440\u044F\u043C\u043E \u0432\u043E\u043B\u0448\u0435\u0431\u0441\u0442\u0432\u043E!",
  "GreenRain": "\u041D\u0443-\u043D\u0443, \u043B\u044E\u0431\u043E\u0432\u044C \u043C\u043E\u044F... \u041D\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0439.%noturn#$b#\u0414\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u043E\u043D \u0442\u043E\u043A\u0441\u0438\u0447\u043D\u044B\u0439, \u044F \u0440\u0430\u043D\u044C\u0448\u0435 \u0432 \u0448\u0430\u0445\u0442\u0430\u0445 \u0437\u0430 \u043E\u0434\u043D\u0443 \u043C\u0438\u043D\u0443\u0442\u0443 \u043A\u0443\u0434\u0430 \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0441\u044F\u043A\u043E\u0439 \u0433\u0430\u0434\u043E\u0441\u0442\u0438 \u0432\u0434\u044B\u0445\u0430\u043B... \u0438 \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u0435\u0449\u0435 \u0436\u0438\u0432!",
  "GreenRain_2": "\u041F\u043E\u0445\u043E\u0436\u0435, \u043C\u043E\u043B\u043E\u0434\u0435\u0436\u0438 \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F \u0432\u044B\u0434\u0435\u0440\u0433\u0430\u0442\u044C \u043F\u043E\u0431\u043E\u043B\u044C\u0448\u0435 \u0441\u043E\u0440\u043D\u044F\u043A\u043E\u0432 \u043F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0433\u043E \u0434\u043E\u0436\u0434\u044F... \u0425\u0435-\u0445\u0435-\u0445\u0435...$h",
  "pamHouseUpgrade": "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E ${\u0438\u0437\u0431\u0430\u0432\u0438\u043B^\u0438\u0437\u0431\u0430\u0432\u0438\u043B\u0430}$ \u043D\u0430\u0441 \u043E\u0442 \u044D\u0442\u043E\u0433\u043E \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u043F\u043E\u0442\u0440\u0435\u043F\u0430\u043D\u043D\u043E\u0433\u043E \u0444\u0443\u0440\u0433\u043E\u043D\u0430... \u043D\u043E\u0432\u044B\u0439 \u0434\u043E\u043C \u043D\u0430 \u044D\u0442\u043E\u043C \u043C\u0435\u0441\u0442\u0435 \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0441\u044F \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u043B\u0443\u0447\u0448\u0435!#$e#\u0417\u043D\u0430\u0435\u0448\u044C, \u044F \u0434\u0443\u043C\u0430\u044E \u044D\u0442\u043E \u043F\u043E\u0432\u044B\u0441\u0438\u043B\u043E \u0438 \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u043D\u0430\u0448\u0435\u0433\u043E \u0443\u0447\u0430\u0441\u0442\u043A\u0430!",
  "pamHouseUpgradeAnonymous": "\u0427\u0442\u043E \u0436... \u041D\u043E\u0432\u044B\u0439 \u0434\u043E\u043C \u0441\u043B\u0435\u0433\u043A\u0430 \u0437\u0430\u0433\u043E\u0440\u0430\u0436\u0438\u0432\u0430\u0435\u0442 \u043C\u043D\u0435 \u0432\u0438\u0434 \u043D\u0430 \u0440\u0435\u043A\u0443... \u041D\u043E \u043E\u043D \u0443\u0436 \u0432\u0441\u044F\u043A\u043E \u043F\u043E\u043B\u0443\u0447\u0448\u0435, \u0447\u0435\u043C \u0442\u0430 \u0441\u0442\u0430\u0440\u0430\u044F \u0436\u0435\u0441\u0442\u044F\u043D\u043A\u0430, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0436\u0438\u043B\u0430 \u041F\u044D\u043C.",
  "MovieInvitation": "\u0425\u043E\u0447\u0435\u0448\u044C \u0441 \u0434\u0435\u0434\u043E\u043C \u0432 \u043A\u0438\u043D\u043E \u0441\u0445\u043E\u0434\u0438\u0442\u044C? \u041D\u0443... \u0434\u0430\u0432\u0430\u0439... \u0412\u0441\u0442\u0440\u0435\u0442\u0438\u043C\u0441\u044F \u0443 \u043A\u0438\u043D\u043E\u0442\u0435\u0430\u0442\u0440\u0430.",
  "eventSeen_502969_memory_oneweek": "\u041D\u0435 \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0437\u0430 \u043C\u0430\u0433\u0438\u044F, \u043D\u043E \u0442\u0435\u0445 \u0435\u043D\u043E\u0442\u043E\u0432 \u0443\u0436\u0435 \u043D\u0435\u0434\u0435\u043B\u044E \u043A\u0430\u043A \u043D\u0435 \u0432\u0438\u0434\u0430\u0442\u044C!",
  "eventSeen_18_memory_oneweek": "\u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u044F \u0443\u0436\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u0441\u0432\u044F\u0437\u044C \u0441 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E, \u043D\u043E \u0435\u0441\u043B\u0438 \u043F\u043E\u0436\u0438\u0432\u0435\u0448\u044C \u0441 \u043C\u043E\u0435, \u043F\u043E\u0439\u043C\u0435\u0448\u044C, \u043A\u0430\u043A \u0432 \u0436\u0438\u0437\u043D\u0438 \u0432\u0441\u0435 \u0443\u0441\u0442\u0440\u043E\u0435\u043D\u043E. \u042D\u0442\u043E \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u00AB\u043C\u0443\u0434\u0440\u043E\u0441\u0442\u044C\u00BB.#$b#\u041C\u043E\u043B\u043E\u0434\u0435\u0436\u044C \u043D\u0435 \u0432\u0438\u0434\u0438\u0442 \u0432\u0441\u0435\u0439 \u043F\u043E\u043B\u043D\u043E\u0442\u044B \u043A\u0430\u0440\u0442\u0438\u043D\u044B. \u0414\u0430 \u0438 \u0441\u043C\u043E\u0433\u0443\u0442 \u043B\u0438 \u043E\u043D\u0438?",
  "married_Alex": "...\u0425\u043C-\u043C.^\u0425\u043E\u0442\u0435\u043B\u043E\u0441\u044C \u0431\u044B \u0441\u0442\u0430\u0442\u044C \u043F\u0440\u0430\u0434\u0435\u0434\u0443\u0448\u043A\u043E\u0439, \u043F\u043E\u043A\u0430 \u043D\u0435 \u043E\u0442\u0431\u0440\u043E\u0441\u0438\u043B \u043A\u043E\u043F\u044B\u0442\u0430. \u041F\u043E\u043C\u043E\u0436\u0435\u0448\u044C \u0441 \u044D\u0442\u0438\u043C?",
  "divorced_once": "\u041F\u0444-\u0444... \u041B\u0435\u0433\u043A\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u0440\u0430\u0437\u0432\u043E\u0434\u0438\u0442\u044C\u0441\u044F, \u0434\u0430?#$e#\u041D\u044B\u043D\u0447\u0435 \u0434\u043B\u044F \u043B\u044E\u0434\u0435\u0439 \u0431\u0440\u0430\u043A \u2014 \u043A\u0430\u043A \u0442\u0435\u043B\u0435\u0432\u0438\u0437\u043E\u0440... \u041D\u0430\u0434\u043E\u0435\u043B\u043E \u0447\u0442\u043E-\u0442\u043E \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u2014 \u0441\u043C\u0435\u043D\u0438\u043B \u043A\u0430\u043D\u0430\u043B. \u0412\u043E\u0442 \u0432 \u043C\u043E\u0435 \u0432\u0440\u0435\u043C\u044F... *\u0432\u043E\u0440\u0447\u0438\u0442*",
  "joja_Begin": "\u0417\u043D\u0430\u0447\u0438\u0442... \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u043A\u043B\u0443\u0431\u0430 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435\u0442, \u0432\u0435\u0440\u043D\u043E? \u0427\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C \u0441 \u0434\u0443\u0445\u043E\u043C \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0433\u043E \u0433\u043E\u0440\u043E\u0434\u043A\u0430? \u041F\u0440\u043E\u0441\u0442\u043E \u0443\u0436\u0430\u0441, \u043A\u0430\u043A \u0431\u044B\u0441\u0442\u0440\u043E \u0432\u0441\u0451 \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F...",
  "Mon": "\u042F \u043D\u0435 \u043E\u0441\u043E\u0431\u043E \u043B\u044E\u0431\u043B\u044E \u0440\u0430\u0437\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044C. \u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u0441 \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u0446\u0430\u043C\u0438, \u0443\u0436 \u043F\u0440\u043E\u0441\u0442\u0438\u0442\u0435.",
  "Tue": "\u0425\u043C-\u043C\u0444... \u041F\u043E\u0445\u043E\u0436\u0435, \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0439 \u043C\u0440\u0430\u0447\u043D\u044B\u0439 \u0434\u0435\u043D\u044C.$s",
  "Wed": "\u0410\u043B\u0435\u043A\u0441 \u2014 \u043C\u043E\u0439 \u0432\u043D\u0443\u043A. \u042F \u0442\u0435\u0431\u0435 \u0435\u0449\u0435 \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043B?#$e#\u0410? \u0413\u043E\u0432\u043E\u0440\u0438 \u0433\u0440\u043E\u043C\u0447\u0435.",
  "Wed_inlaw_Alex": "\u041A\u0430\u043A \u043C\u043E\u0433\u0443\u0442 \u0434\u0432\u043E\u0435 \u043C\u0443\u0436\u0447\u0438\u043D \u0441\u043E\u0447\u0435\u0442\u0430\u0442\u044C\u0441\u044F \u0431\u0440\u0430\u043A\u043E\u043C? \u042D\u0442\u043E \u043D\u0435\u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E... \u0425\u043C-\u043C\u0444. \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u044F \u043F\u0440\u043E\u0441\u0442\u043E \u00AB\u0441\u0442\u0430\u0440\u043E\u043C\u043E\u0434\u043D\u044B\u0439\u00BB...^\u0422\u044B \u0442\u0435\u043F\u0435\u0440\u044C \u0447\u0430\u0441\u0442\u044C \u0441\u0435\u043C\u044C\u0438. \u042F \u0440\u0430\u0434, \u0447\u0442\u043E \u043C\u043E\u0439 \u0432\u043D\u0443\u043A \u043D\u0430\u0448\u0435\u043B \u0441\u0435\u0431\u0435 \u0442\u0430\u043A\u0443\u044E \u043A\u0440\u0430\u0441\u0430\u0432\u0438\u0446\u0443-\u0436\u0435\u043D\u0443.",
  "Wed10_inlaw_Alex": "\u041F\u0440\u0438\u0437\u043D\u0430\u044E\u0441\u044C, \u044F \u0434\u0443\u043C\u0430\u043B, \u0447\u0442\u043E \u0434\u0432\u043E\u0435 \u043C\u0443\u0436\u0447\u0438\u043D... \u0432\u043C\u0435\u0441\u0442\u0435... \u044D\u0442\u043E \u0441\u0442\u0440\u0430\u043D\u043D\u043E. \u041D\u043E \u0442\u044B \u0442\u0430\u043A\u043E\u0439 \u0441\u043B\u0430\u0432\u043D\u044B\u0439 \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A, \u0438 \u044F \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0432\u044B \u043B\u044E\u0431\u0438\u0442\u0435 \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430... \u042F \u043F\u0435\u0440\u0435\u0434\u0443\u043C\u0430\u043B.^\u0422\u044B \u0442\u0435\u043F\u0435\u0440\u044C \u0447\u0430\u0441\u0442\u044C \u043D\u0430\u0448\u0435\u0439 \u0441\u0435\u043C\u044C\u0438... \u042F \u0442\u0430\u043A \u0432\u0430\u043C\u0438 \u0433\u043E\u0440\u0436\u0443\u0441\u044C.",
  "Thu": "\u042F \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0435 \u043C\u043E\u0433\u0443 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C, \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A.^\u042F \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0435 \u043C\u043E\u0433\u0443 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C, \u043C\u0438\u0441\u0441.#$e#\u0418\u0434\u0435\u0442 \u043C\u043E\u044F \u043B\u044E\u0431\u0438\u043C\u0430\u044F \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0430.",
  "Fri": "\u0422\u0430\u043A \u0442\u044B, \u0437\u043D\u0430\u0447\u0438\u0442, \u0444\u0435\u0440\u043C\u0435\u0440? \u041D\u0443, \u044D\u0442\u043E \u0445\u043E\u0442\u044F \u0431\u044B \u0447\u0435\u0441\u0442\u043D\u044B\u0439 \u0442\u0440\u0443\u0434.",
  "Sat": "\u0414\u043B\u044F \u043C\u0435\u043D\u044F \u0432\u044B\u0445\u043E\u0434\u043D\u044B\u0435 \u043D\u0438\u0447\u0435\u043C \u043D\u0435 \u043E\u0442\u043B\u0438\u0447\u0430\u044E\u0442\u0441\u044F \u043E\u0442 \u0431\u0443\u0434\u043D\u0435\u0439.#$e#\u0422\u0430\u043A\u0430\u044F \u0432\u043E\u0442 \u0436\u0438\u0437\u043D\u044C \u043D\u0430 \u043F\u0435\u043D\u0441\u0438\u0438.",
  "Sun": "\u0422\u0435\u0431\u0435 \u043D\u0435 \u0445\u043E\u043B\u043E\u0434\u043D\u043E? \u0422\u0430\u043A\u0438\u0445 \u0441\u0432\u0438\u0442\u0435\u0440\u043E\u0432, \u043A\u0430\u043A \u0440\u0430\u043D\u044C\u0448\u0435, \u0442\u0435\u043F\u0435\u0440\u044C \u043D\u0435 \u0434\u0435\u043B\u0430\u044E\u0442.#$e#\u042D\u0445...",
  "Mon6": "\u0423\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E, \u0447\u0442\u043E \u0442\u044B \u0445\u043E\u0447\u0435\u0448\u044C \u0434\u0440\u0443\u0436\u0438\u0442\u044C \u0441 \u0442\u0430\u043A\u0438\u043C \u0441\u0442\u0430\u0440\u0438\u043A\u043E\u043C, \u043A\u0430\u043A \u044F.",
  "Thu6": "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439, @. \u0425\u043E\u0447\u0435\u0448\u044C \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0441\u043E \u043C\u043D\u043E\u0439 \u0442\u0435\u043B\u0438\u043A?",
  "Fri4": "\u0414\u0435\u0434\u0430 \u043C\u043E\u0439 \u0431\u044B\u043B \u0444\u0435\u0440\u043C\u0435\u0440\u043E\u043C. \u042D\u0442\u043E \u0443\u0432\u0430\u0436\u0430\u0435\u043C\u0430\u044F \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u044F.#$e#\u041D\u0435 \u0431\u0443\u0434\u044C \u044F \u0442\u0430\u043A \u0447\u0435\u0440\u0442\u043E\u0432\u0441\u043A\u0438 \u0441\u0442\u0430\u0440, \u044F \u0431\u044B \u043F\u0440\u0438\u0448\u0435\u043B \u043A \u0442\u0435\u0431\u0435 \u043D\u0430 \u0444\u0435\u0440\u043C\u0443 \u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043B \u0431\u044B, \u043A\u0430\u043A \u043D\u0430\u0434\u043E...",
  "Wed8": "\u0425\u043E\u0442\u0435\u043B \u0431\u044B \u044F, \u0447\u0442\u043E\u0431\u044B \u043D\u043E\u0433\u0438 \u0443 \u043C\u0435\u043D\u044F \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438, \u0438 \u0447\u0442\u043E\u0431\u044B \u044F \u0441\u043C\u043E\u0433 \u043F\u043E\u043A\u0438\u0434\u0430\u0442\u044C \u043C\u044F\u0447 \u0441 \u0410\u043B\u0435\u043A\u0441\u043E\u043C.$s#$e#\u042D\u0442\u043E\u0433\u043E \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0441\u043B\u0443\u0447\u0438\u0442\u0441\u044F.$s",
  "Fri8": "\u042F \u0442\u0443\u0442 \u043F\u043E\u0440\u0430\u0437\u043C\u044B\u0441\u043B\u0438\u043B... \u041C\u043E\u0436\u0435\u0442, \u044F \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u0435\u0440\u0435\u0433\u043D\u0443\u043B \u0441\u043E \u0441\u0432\u043E\u0438\u043C \u0432\u043E\u0440\u0447\u0430\u043D\u0438\u0435\u043C.$s#$e#\u042F \u0440\u0430\u043D\u044C\u0448\u0435 \u0434\u0443\u043C\u0430\u043B, \u0447\u0442\u043E \u043D\u0438\u043A\u043E\u043C\u0443 \u0434\u043E \u043D\u0430\u0441, \u0441\u0442\u0430\u0440\u0438\u043A\u043E\u0432, \u0438 \u0434\u0435\u043B\u0430 \u043D\u0435\u0442\u0443.",
  "Fri10": "\u0417\u043D\u0430\u0435\u0448\u044C, \u044F \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0431\u044B\u043B \u0434\u043B\u044F \u0432\u0441\u0435\u0445 \u0432\u043E\u0440\u0447\u043B\u0438\u0432\u044B\u043C \u0441\u0442\u0430\u0440\u0438\u043A\u043E\u043C. \u041D\u043E \u0441\u0435\u0439\u0447\u0430\u0441 \u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E, \u0447\u0442\u043E \u0441\u0442\u0430\u043B \u043C\u044F\u0433\u0447\u0435, \u043A\u0430\u043A \u043F\u0435\u0440\u0435\u0437\u0440\u0435\u043B\u044B\u0439 \u043F\u043B\u043E\u0434. \u0425\u0435-\u0445\u0435!$h#$e#\u041F\u043E\u043A\u0430, \u0441\u044B\u043D\u043E\u043A.^\u041F\u043E\u043A\u0430, \u0434\u043E\u0440\u043E\u0433\u0443\u0448\u0430.",
  "Wed10": "@! \u0421\u0435\u0439\u0447\u0430\u0441 \u044F \u0432\u044B\u043A\u043B\u044E\u0447\u0443 \u044D\u0442\u043E\u0442 \u0447\u0435\u0440\u0442\u043E\u0432 \u044F\u0449\u0438\u043A, \u0438 \u043C\u044B \u0441 \u0442\u043E\u0431\u043E\u0439 \u043F\u043E\u0431\u043E\u043B\u0442\u0430\u0435\u043C.$h#$e#\u041D\u0443, \u0447\u0442\u043E \u0442\u0430\u043C \u043D\u044B\u043D\u0447\u0435 \u043C\u043E\u043B\u043E\u0434\u0435\u0436\u044C?",
  "Tue10": "\u0417\u043D\u0430\u0435\u0448\u044C, \u043D\u0435 \u0441\u0442\u043E\u0438\u0442 \u043C\u043D\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0440\u0430\u0441\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0442\u044C\u0441\u044F \u0438\u0437-\u0437\u0430 \u043D\u043E\u0433.#$e#\u041D\u0443\u0436\u043D\u043E \u0440\u0430\u0434\u043E\u0432\u0430\u0442\u044C\u0441\u044F \u0442\u043E\u043C\u0443, \u0447\u0442\u043E \u044F \u0435\u0449\u0435 \u0436\u0438\u0432.$h",
  "Thu10": "\u041A\u043E\u0433\u0434\u0430 \u0434\u043E\u0436\u0438\u0432\u0430\u0435\u0448\u044C \u0434\u043E \u043C\u043E\u0435\u0433\u043E \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0430, \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0441\u043B\u043E\u0436\u043D\u0435\u0435 \u043F\u0440\u0438\u0441\u043F\u043E\u0441\u043E\u0431\u0438\u0442\u044C\u0441\u044F \u043A \u043D\u043E\u0432\u043E\u043C\u0443.#$e#\u041E\u0434\u043D\u0430\u0436\u0434\u044B \u0442\u044B \u043F\u043E\u0439\u043C\u0435\u0448\u044C \u043C\u0435\u043D\u044F.#$e#\u0418\u0434\u0438 \u0438 \u0440\u0430\u0437\u0432\u043B\u0435\u043A\u0430\u0439\u0441\u044F, \u043F\u043E\u043A\u0430 \u0435\u0441\u0442\u044C \u043C\u043E\u043B\u043E\u0434\u043E\u0441\u0442\u044C.",
  "winter_1": "\u041E\u0445-\u0445... \u041A\u0430\u043A \u0436\u0435 \u0445\u043E\u043B\u043E\u0434\u043D\u043E.#$e#\u041A\u043E\u0433\u0434\u0430 \u0442\u044B \u043C\u043E\u043B\u043E\u0434, \u043C\u043E\u0440\u043E\u0437 \u043D\u0435 \u0442\u0430\u043A\u043E\u0439 \u043A\u0443\u0441\u0430\u0447\u0438\u0439.",
  "WinterStar_GiveGift_After": "\u041D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F, \u0430? \u0425\u0430! \u041C\u043E\u043B\u043E\u0434\u0435\u0436\u044C... \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u044B\u043D\u0447\u0435 \u043D\u0435 \u0446\u0435\u043D\u044F\u0442. \u041E\u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0430\u044F, \u0430 \u0443 \u043C\u0435\u043D\u044F \u0434\u0435\u043D\u0435\u0436\u043D\u044B\u0445 \u0437\u0430\u043F\u0430\u0441\u043E\u0432 \u043D\u0435\u0442, \u0437\u043D\u0430\u0435\u0448\u044C \u043B\u0438!"
}