  "spring_1": "@, \uC62C\uD574\uB294 \uC5B4\uB5A4 \uACC4\uD68D\uC774 \uC788\uC5B4?",
  "spring_23": "\uB0B4\uC77C \uBD04\uAF43 \uBB34\uB3C4\uD68C \uB2E4\uB140\uC640! \uB09C \uAC71\uC815\uD558\uC9C0 \uB9C8.",
  "summer_1": "\uB09C \uD587\uBE5B \uBC1B\uC73C\uBA74 \uC798 \uD0C0\uC11C, \uC774 \uACC4\uC808\uC740 \uC870\uC2EC\uD574\uC57C \uD574.",
  "summer_8": "\uC74C... \uC5B4\uB514\uC11C \uC88B\uC740 \uD5A5\uAE30\uAC00 \uB098\uB294\uB370? \uBC24\uC0C8 \uB540 \uD758\uB838\uAD6C\uB098...$h",
  "summer_15": "\uC5EC\uB984\uC774\uB2E4... \uC9D1\uC548\uC5D0 \uD30C\uB9AC\uAC00 \uB9CE\uC774 \uBCF4\uC774\uACA0\uC9C0.#$e#\uAD1C\uCC2E\uC544, \uB0B4\uAC00 \uCC98\uB9AC\uD560\uAC8C. \uB2E8\uBC31\uC9C8\uC774 \uD48D\uBD80\uD55C \uAC04\uC2DD\uC774\uC57C!$h",
  "fall_8": "\uC624\uB298\uC740 \uC544\uBB34\uAC83\uB3C4 \uD558\uAE30 \uC2EB\uB2E4.",
  "fall_15": "\uB18D\uAC00 \uC804\uC2DC\uC5D0 \uC5B4\uB5A4 \uAC78 \uC120\uBCF4\uC77C\uC9C0 \uACB0\uC815\uD588\uC5B4?",
  "fall_24": "\uC601\uB839\uC758 \uC804\uC57C\uC81C \uCD95\uC81C\uC5D0 \uB0B4\uAC00 \uAC00\uBA74 \uBD84\uBA85 \uC5B4\uB514 \uAC00\uB46C\uB193\uACA0\uC9C0...$s",
  "winter_28": "\uC5EC\uAE30\uC11C \uC9C0\uB0BC \uC218 \uC788\uAC8C \uD574\uC918\uC11C \uACE0\uB9C8\uC6CC, @. \uB0B4\uB144\uB3C4 \uBA4B\uC9C4 \uD574\uAC00 \uB420 \uAC70\uB77C \uAE30\uB300\uD558\uACE0 \uC788\uC5B4!$h",
  "spouseRoom_Krobus": "#$c .5#\uC6B0\uB9AC \uC2E0\uCCB4\uC801\uC73C\uB85C \uB108\uBB34 \uB2EC\uB77C\uC11C \uD568\uAED8 \uC0AC\uB294 \uAC8C \uC5B4\uB824\uC6B8 \uB54C\uAC00 \uC788\uC5B4, \uADF8\uB807\uC9C0?#$e#\uC5EC\uAE30 \uC2B5\uB3C4\uAC00 \uB124\uAC8C \uB108\uBB34 \uC131\uAC00\uC2DC\uC9C0 \uC54A\uAE38 \uBC14\uB77C. \uC6B0\uB9AC \uB458 \uB2E4 \uD0C0\uD611\uD574\uC57C \uD568\uAED8 \uC9C0\uB0BC \uC218 \uC788\uACA0\uC9C0!",
  "spring_Krobus": "\uC774\uC81C \u0027\uBD04\u0027\uC774\uB780 \uAC70\uC9C0, \uB9DE\uC9C0? \uC57C\uC0DD \uACE0\uCD94\uB0C9\uC774\uC758 \uB9E4\uCF64\uD55C \uD5A5\uC73C\uB85C \uC54C \uC218 \uC788\uC5B4.",
  "summer_Krobus": "\uB10C \uC774\uB9D8\uB54C\uB97C \u0027\uC5EC\uB984\u0027\uC774\uB77C \uBD80\uB974\uC9C0? \uB530\uB73B\uD558\uACE0 \uC2B5\uD55C \uAC74 \uC88B\uC9C0\uB9CC, \uD587\uBE5B\uC774 \uB108\uBB34 \uAC15\uD558\uB124.",
  "fall_Krobus": "\uC694\uC998 \uC880 \uB354 \uC120\uC120\uD574\uC9C0\uACE0 \uD034\uD034\uD55C \uB0C4\uC0C8\uAC00 \uB098. \uC774\uC81C \u0027\uAC00\uC744\u0027\uC774\uB77C\uB294 \uC2DC\uAE30\uC778 \uAC70 \uB9DE\uC9C0?",
  "winter_Krobus": "\uC77C \uB144 \uC911 \uC774\uB9D8\uB54C\uB294 \uC5B4\uB450\uC6CC\uC11C \uC88B\uC544. \uB354 \uB530\uB73B\uD588\uC73C\uBA74 \uC88B\uC744 \uD150\uB370!"
}