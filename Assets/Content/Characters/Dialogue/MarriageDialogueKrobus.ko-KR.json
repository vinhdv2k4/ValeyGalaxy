{
  "Rainy_Day_0": "@, \uB108\uB3C4 \uB098\uB9CC\uD07C \uBE44 \uC624\uB294 \uB0A0\uC744 \uC88B\uC544\uD574?",
  "Rainy_Day_1": "\uC6B0\uB9B0 \uC11C\uB85C \uB2E4\uB978 \uC810\uC774 \uC815\uB9D0 \uB9CE\uC544... \uD558\uC9C0\uB9CC \uAD1C\uCC2E\uC544.",
  "Rainy_Day_2": "\uC88B\uC740 \uC544\uCE68\uC774\uC57C, @. \uC544\uCE68 \uC77C\uCC0D \uB098\uAC14\uB2E4\uAC00 \uB110 \uC8FC\uB824\uACE0 \uC774\uAC78 \uCC3E\uC558\uC5B4. [305 308 203 795 397]#$e#\uB108\uBB34 \uC774\uC0C1\uD55C \uBB3C\uAC74\uC740 \uC544\uB2C8\uC5C8\uC73C\uBA74 \uD574.",
  "Rainy_Day_3": "\uB9C8\uBC95\uC0AC\uAC00 \uC774 \uC0C1\uD669...\uC5D0 \uB300\uD574\uC11C \uC54C\uACE0 \uC788\uC744\uAE4C? \uBE44\uBC00\uC744 \uC9C0\uCF1C\uC92C\uC73C\uBA74 \uC88B\uACA0\uB2E4.$s",
  "Rainy_Day_4": "\uC544\uBB34\uB9AC \uACE0\uC0C1\uD55C \uCC99\uC744 \uD558\uB824\uACE0 \uD574\uB3C4, \uAC00\uB054 \uB9D0\uC37D\uC744 \uBD80\uB9AC\uACE0 \uC2F6\uC740 \uCDA9\uB3D9\uC744 \uB290\uAEF4...$6#$e#\uB0B4 \uC885\uC871 \uD2B9\uC720\uC758 \uC0C1\uD0DC\uB77C\uACE0 \uD558\uB354\uB77C\uACE0.",
  "Rainy_Day_Krobus": "\uC544, \uBE44\uAC00 \uC640\uC11C \uC2B5\uD558\uB2E4... \uB9C8\uC74C\uC774 \uD3B8\uD574\uC9C0\uB124.",
  "Rainy_Night_0": "\uC774\uB7F0 \uBC24, \uC778\uAC04\uB4E4\uC740 \uCC3D\uBC16\uC73C\uB85C \uADF8\uB9BC\uC790\uC5D0 \uB4DC\uB9AC\uC6B4 \uD615\uCCB4\uB4E4\uC744 \uBCF4\uACE4 \uD558\uC9C0. \uADF8\uAC8C \uB098\uC600\uC744 \uC218\uB3C4 \uC788\uB2E4 \uC0DD\uAC01\uD558\uB2C8\uAE4C... \uC2E0\uAE30\uD558\uB124.$7",
  "Rainy_Night_1": "\uADF8\uB9BC\uC790 \uC0AC\uB78C\uB4E4\uC774 \uC6B0\uB9AC \uC0C1\uD669\uC5D0 \uB300\uD574 \uC54C\uAC8C \uB41C\uB2E4\uBA74, \uB098\uB97C... \u0027\uCC98\uBC8C\u0027\uD560 \uAC70\uC57C.$s#$e#\uB300\uBD80\uBD84\uC774 \uC778\uAC04\uC744 \uACBD\uBA78\uD574, \uC54C\uB2E4\uC2DC\uD53C.",
  "Rainy_Night_2": "\uB108 \uC644\uC804 \uCD95\uCD95\uD558\uACE0 \uCC28\uAC00\uC6CC! \uB108\uD76C \uC885\uC871\uD55C\uD14C\uB294 \uC704\uD5D8\uD55C \uAC70 \uC544\uB0D0?$s",
  "Rainy_Night_3": "\uB098 \uC774\uBBF8 \uC800\uB141 \uBA39\uC5C8\uC5B4, \uADFC\uB370 \uB124\uAC00 \uBA39\uC744 \uC218 \uC788\uB294 \uADF8\uB7F0 \uAC74 \uC544\uB2C8\uC5C8\uC5B4... \uBBF8\uC548\uD574.",
  "Rainy_Night_4": "\uB0B4 \uC885\uC871\uC744 \uB5A0\uB09C \uB4A4, \uB09C \uC904\uACE7 \uB098\uB9CC\uC758 \uC9D1\uC744 \uCC3E\uC544\uD5E4\uB9F8\uB294\uB370... \uC774\uC81C \uB098\uB3C4 \uC5B4\uB518\uAC00 \uC18D\uD574\uC788\uC5B4. \uB098\uD55C\uD14C \uADF8\uAC83\uBCF4\uB2E4 \uC911\uC694\uD55C \uAC74 \uC5C6\uC5B4.",
  "Rainy_Night_5": "\uB0B4 \uC885\uC871\uC740 \uC624\uB798\uC804\uC5D0 \uC774\uACF3\uC73C\uB85C \uC654\uB2E4\uB354\uB77C\uACE0, \uD070 \uC7AC\uC559\uC774 \uC788\uC5C8\uB294\uB370 \uADF8\uB54C \uACF5\uD5C8 \uC18D\uC5D0 \uC788\uB358 \uC815\uB839\uB4E4\uC774 \uC774 \uC138\uACC4\uB85C \uAC74\uB108\uC62C \uC218 \uC788\uC5C8\uB300.",
  "Rainy_Night_Krobus": "\uBE57\uC18C\uB9AC\uB97C \uB4E4\uC73C\uBA74 \uD558\uC218\uB3C4 \uC0DD\uAC01\uC774 \uB098... \uD3B8\uC548\uD55C \uAE30\uBD84\uC774\uC57C.#$e#\uD558\uC218\uB3C4\uB294 \uB0B4 \uD53C\uC2E0\uCC98\uC600\uAC70\uB4E0... \uC548\uC804\uD55C \uB290\uB08C\uC774 \uB4DC\uB294 \uC7A5\uC18C. \uAC71\uC815\uD558\uC9C4 \uB9C8... \uB0B4 \uC0C8\uB85C\uC6B4 \uC9D1\uC5D0 \uB300\uD574\uC11C\uB3C4 \uAC19\uC740 \uAE30\uBD84\uC774\uC57C.",
  "Indoor_Day_0": "\uD568\uAED8 \uAC08 \uC218 \uC788\uC5C8\uB2E4\uBA74 \uAC19\uC774 \uAC08 \uD150\uB370... \uC9D1\uC548 \uC815\uB9AC\uC5D0 \uCD5C\uC120\uC744 \uB2E4\uD560\uAC8C.",
  "Indoor_Day_1": "\uC778\uAC04 \uC74C\uC2DD\uC744 \uB9CC\uB4E4\uC5B4\uBD24\uC5B4... [203 204 651 225]#$e#\uB098\uC911\uC5D0 \uBA39\uC5B4\uB3C4 \uB3FC, \uBD80\uB2F4 \uAC16\uC9C4 \uB9C8...",
  "Indoor_Day_2": "\uC9D1\uC5D0\uC11C \uD558\uB8E8 \uC885\uC77C \uC788\uC5B4\uB3C4 \uD589\uBCF5\uD574. \uD3B8\uD55C \uC704\uCE58\uB97C \uCC3E\uC558\uC5B4... \uB09C \uC778\uAC04\uB4E4\uCC98\uB7FC \uBC16\uC744 \uAF2D \uB098\uAC00\uC57C \uD558\uB294 \uAC74 \uC544\uB0D0.#$e#\uD558\uC9C0\uB9CC \uB124\uAC00 \uB098\uAC00\uC57C \uD55C\uB2E4\uB294 \uC0AC\uC2E4\uC740 \uC774\uD574\uD574! \uB098\uB791 \uC5EC\uAE30 \uC788\uC5B4\uC57C \uD55C\uB2E4\uACE0 \uC0DD\uAC01\uD558\uC9C4 \uB9D0\uC544\uC918.$3",
  "Indoor_Day_3": "\uACF5\uCC98\uB7FC \uC6C5\uD06C\uB9B0 \uCC44\uB85C \uAD6C\uC11D\uC5D0 \uC788\uC744\uAE4C \uC0DD\uAC01 \uC911\uC774\uC57C...#$e#\uC751? \uB10C \uC548 \uADF8\uB7F0\uB2E4\uACE0?$3",
  "Indoor_Day_4": "\uAE08\uC694\uC77C\uC740 \uC694\uBC14\uB97C \uACBD\uC758\uD558\uB294 \uB9C8\uC74C\uC73C\uB85C \uC870\uC6A9\uD788 \uC9C0\uB0B4\uB824\uACE0 \uD574. \uB108\uBB34 \uC2E0\uACBD \uC4F0\uC9C4 \uB9D0\uC544\uC918.",
  "Indoor_Day_Krobus": "\uB18D\uC7A5 \uC77C\uC744 \uB3C4\uC640\uC8FC\uACE0 \uC2F6\uC740\uB370, \uB09C \uD587\uBE5B\uC744 \uBCF4\uBA74 \uC548 \uB3FC...",
  "Indoor_Night_0": "\uC624\uB298 \uC9D1\uC5D0 \uC788\uB294 \uBC8C\uB808\uB4E4 \uB2E4 \uC7A1\uC558\uC5B4... \uBBF8\uC548, \uB124 \uAC74 \uBABB \uB0A8\uACBC\uC5B4! *\uCA5D\uCA5D*$7",
  "Indoor_Night_1": "\uB10C \uCC38 \uB2E8\uB2E8\uD55C \uAC8C \uC2E0\uAE30\uD574... \uAC00\uB054\uC740 \uB098\uB3C4 \uBF08\uAC00 \uC788\uC5C8\uC73C\uBA74 \uC88B\uACA0\uC5B4...$s",
  "Indoor_Night_2": "\uAC00\uB054 \uC778\uAC04\uACFC \uADF8\uB9BC\uC790 \uC0AC\uB78C\uB4E4\uC774 \uC815\uB9D0\uB85C \uACF5\uC874\uD560 \uC218 \uC788\uC744\uAE4C \uAD81\uAE08\uD574... \uB9E4\uB825\uC801\uC778 \uC0DD\uAC01\uC774\uC9C0\uB9CC, \uD604\uC2E4\uC801\uC77C\uAE4C?$s#$e#\uADF8\uB7AC\uC73C\uBA74 \uC88B\uACA0\uB2E4...",
  "Indoor_Night_3": "\uAC00\uB054 \uB124 \uB355\uC5D0 \uC778\uAC04\uC5D0 \uB300\uD574\uC11C \uBC30\uC6B4 \uBAA8\uB4E0 \uAC83\uC5D0 \uB300\uD574 \uAC00\uB9CC\uD788 \uC0DD\uAC01\uD574\uBCF4\uACE4 \uD574...#$b#\uB2E4\uB978 \uADF8\uB9BC\uC790 \uC0AC\uB78C\uB4E4\uB3C4 \uC774 \uAE30\uBD84\uC744 \uC54C\uC558\uC73C\uBA74 \uC88B\uC744 \uD150\uB370.",
  "Indoor_Night_4": "\uB110 \uC704\uD574 \uC88B\uC740 \uD558\uC6B0\uC2A4\uBA54\uC774\uD2B8\uAC00 \uB418\uACE0 \uC2F6\uC740\uB370, \uB0B4\uAC00 \uC798 \uD558\uACE0 \uC788\uB294\uC9C0 \uC54C \uC218\uAC00 \uC5C6\uC5B4... *\uB059* $s#$e#\uC778\uAC04\uC758 \uD45C\uD604\uC744 \uC774\uD574\uD558\uAE30 \uD798\uB4E4\uC5B4. \uD558... \uD558\uC9C0\uB9CC... \uB098\uB791 \uC9C0\uB0B4\uB294 \uAC8C \uC88B\uB2E4\uACE0?#$e#\uC88B\uC544!$7",
  "Indoor_Night_Krobus": "\uC548\uB155, @. \uB3CC\uC544\uC654\uAD6C\uB098. \uC624\uB298 \uC5F4\uC2EC\uD788 \uC77C\uD588\uB098 \uBCF4\uB124!$h",
  "Outdoor_0": "\uC7A0\uAE50 \uC5EC\uAE30 \uB098\uC640\uC788\uC744\uAC8C, \uD558\uC9C0\uB9CC \uC6B0\uB9AC \uC870\uC2EC\uD574\uC57C \uD574... \uB204\uAC00 \uC624\uB294 \uAC8C \uBCF4\uC774\uBA74 \uB09C \uC228\uC5B4\uC57C \uD574!",
  "Outdoor_1": "\uB0B4\uAC00 \uBC16\uC5D0 \uB098\uC62C \uC218 \uC788\uB294 \uD754\uCE58\uC54A\uC740 \uAE30\uD68C\uC57C!",
  "Outdoor_2": "\uC544\uB984\uB2E4\uC6B4 \uB0A0\uC774\uB124!$h",
  "Outdoor_3": "\uC774\uB807\uAC8C \uD0C1 \uD2B8\uC778 \uACF5\uAC04\uC740 \uAE34\uC7A5\uB418\uB354\uB77C...$s",
  "Outdoor_4": "\uB09C \uC2E0\uACBD \uC4F0\uC9C0 \uB9D0\uACE0 \uD574\uC57C \uD560 \uAC70 \uD574, \uC5EC\uAE30\uC11C \uC9D1 \uC9C0\uD0A4\uACE0 \uC788\uC744\uAC8C.",
  "Outdoor_Krobus": "\uD639\uC2DC \uBC8C\uB808\uAC00 \uC774\uCABD\uC73C\uB85C \uC624\uB098 \uC870\uAE08 \uAE30\uB2E4\uB824\uBCFC\uAC8C.#$e#\uC544\uC9C1 \uC544\uCE68\uC744 \uBABB \uBA39\uC5C8\uAC70\uB4E0!",
  "OneKid_3": "\uC5B4\uB5BB\uAC8C \uB41C \uAC74\uC9C0\uB294 \uBAA8\uB974\uACA0\uC9C0\uB9CC, \uC694\uBC14\uAED8\uC11C \uC6B0\uB9AC\uC5D0\uAC8C \u0027\uC544\uC774\u0027\uC758 \uCD95\uBCF5\uC744 \uB0B4\uB824\uC8FC\uC168\uC5B4...",
  "TwoKids_0": "\uAC71\uC815\uD558\uC9C0 \uB9C8... %kid1(\uC774)\uB791 %kid2\uC774(\uAC00) \uBA39\uAC8C \uACF5\uD5C8 \uB2EC\uAC40 \uC624\uBBC8\uB81B\uC744 \uD574\uC92C\uC5B4.",
  "TwoKids_2": "\uC544\uC774\uB4E4\uC758 \uBBF8\uB798\uAC00 \uAC71\uC815\uB418\uAE34 \uD558\uC9C0\uB9CC... \uC694\uBC14\uAED8\uC11C \uACC4\uD68D\uC774 \uC788\uC73C\uC2DC\uB77C \uBBFF\uC5B4.",
  "TwoKids_3": "\uC774\uC81C \uC694\uBC14\uAED8\uC11C \uC774 \uC9D1\uC5D0 \uC544\uC774\uB97C \uB458\uC774\uB098 \uCD95\uBCF5\uD574\uC8FC\uC168\uC5B4... \uC6B0\uB9AC\uC758 \uC0C1\uD669\uC744 \uC694\uBC14\uAED8\uC11C \uBC1B\uC544\uB4E4\uC774\uC2E0\uB2E4\uB294 \uB73B\uC77C\uAE4C?",
  "Good_1": "\uC774\uC0C1\uD55C \uAE30\uBD84\uC774 \uB4E4\uC5B4... \uC774\uAC8C \uBC14\uB85C \uADF8... \u0027\uC815\uC2E0\uC801\uC778 \uC0AC\uB791\u0027\uC778\uAC00?$l#$b#... \uC544, \uC7A0\uAE50... \uADF8\uB0E5 \uD5C8\uBB3C\uC774 \uBC97\uACA8\uC9C0\uB294 \uAC70\uC600\uAD6C\uB098.$s",
  "Good_2": "\uB0B4\uAC00 \uC778\uAC04\uC5D0 \uB300\uD574 \uAC00\uC9C0\uACE0 \uC788\uB358 \uD3B8\uACAC\uC740 \uADF9\uBCF5\uD588\uC5B4... \uD558\uC9C0\uB9CC \uB4DC\uC6CC\uD504\uB294 \uC544\uC9C1\uB3C4 \uC5ED\uACA8\uC6CC.$a",
  "Good_3": "\uBC24\uC0AC\uC774 \uC7A0\uB4E0 \uCC44\uB85C \uB0A0 \uC0B4\uC0B4 \uAE68\uBB3C\uB354\uB2C8 \u0027\uAC80\uC740 \uAC00 \uC74C \uCD08\u0027 \uC598\uAE30\uB97C \uD588\uB294\uB370... \uBB34\uC2A8 \uC758\uBBF8\uC57C?$3",
  "Good_0": "\uC6B0\uB9AC \uC798 \uC9C0\uB0B4\uACE0 \uC788\uC5B4, \uD76C\uB9DD\uCC2C \uAE30\uBD84\uC774 \uB4E4\uC5B4.$h",
  "Good_5": "\uC774 \uC0AC\uB791\uC2A4\uB7EC\uC6B4 \uC9D1\uC744 \uBCF4\uACE0 \uAC10\uD0C4\uD558\uACE0 \uC788\uC5C8\uC5B4... \uC544\uC8FC \uBA4B\uC9C4 \uACF3\uC774\uC57C.$l",
  "Neutral_0": "\uB09C \uB299\uC9C0 \uC54A\uC744 \uAC70\uC9C0\uB9CC, \uB10C \uADF8\uB7EC\uACA0\uC9C0. \uAC00\uB054 \uADF8\uB7F0 \uC0AC\uC2E4\uC774 \uC2AC\uD504\uAE34 \uD55C\uB370... \uC5B4\uCA54 \uC218 \uC5C6\uC9C0.$s",
  "Neutral_1": "\uB0A8\uAE30\uACE0 \uAC04 \uC9D1\uC5D0 \uBAAC\uC2A4\uD130\uAC00 \uC0B0\uB2E4\uB294 \uC0AC\uC2E4\uC744 \uB108\uD76C \uD560\uC544\uBC84\uC9C0\uAED8\uC11C \uAD1C\uCC2E\uB2E4\uACE0 \uC0DD\uAC01\uD558\uC2E4\uAE4C?",
  "Neutral_2": "\uC6B0\uB9AC \uD568\uAED8 \uC0B4\uC544\uC11C \uACE4\uB780\uD560 \uC77C\uC774 \uC0DD\uAE38\uAE4C?$s",
  "Neutral_3": "\uC5EC\uAE30 \uB108\uBB34 \uBC1D\uC544... \uBA87 \uC2DC\uAC04\uB9CC \uB208 \uC880 \uBD99\uC774\uACE0 \uC788\uC5B4\uC57C\uACA0\uC5B4.$s",
  "Neutral_4": "\uB09C \uBC16\uC5D0 \uB098\uAC08 \uC218\uB3C4 \uC5C6\uACE0, \uBA39\uC744 \uC218 \uC788\uB294 \uAC8C \uC815\uD574\uC838\uC788\uACE0, \uC628\uB3C4\uB3C4 \uB531 \uB9DE\uC544\uC57C \uD558\uACE0... \uB098\uB791 \uC0AC\uB294 \uAC8C \uB108\uBB34 \uBD88\uD3B8\uD558\uC9C0 \uC54A\uC558\uC73C\uBA74 \uD574, @.$s",
  "Neutral_5": "\uC6F0\uC705 \uB9D0\uC5D0 \uC758\uD558\uBA74 \uB09C \uC624\uB298 \uC800\uC8FC\uBC1B\uC558\uB300.$s",
  "Neutral_6": "\uBE44\uBC00 \uD558\uB098 \uC54C\uB824\uC904\uAC8C... \uB098 \uC0AC\uC2E4 \uC7A0\uC740 \uC548 \uC790, \uADF8\uB0E5 \uB208 \uAC10\uACE0 \uB204\uC6CC\uC788\uB294 \uAC70\uC57C...",
  "Neutral_7": "\uB108\uB3C4 \uC815\uB9D0 \uD2B9\uC774\uD574, \uB098 \uAC19\uC740 \uC0DD\uBB3C\uD558\uACE0 \uC0B4\uACE0 \uC2F6\uB2E4\uB2C8.",
  "Neutral_8": "\uC624\uB298\uC740 \uD558\uB8E8 \uC885\uC77C \uC9D1\uC548\uC744 \uCCAD\uC18C\uD560 \uAC70\uC57C! \uC7AC\uBC0C\uB2E4.$7",
  "Neutral_9": "\uC6B0\uB9B0 \uD3C9\uC0DD \uC5EC\uAE30\uC11C \uC9C0\uB0B4\uAC8C \uB418\uB294 \uAC78\uAE4C? \uC774\uC0AC\uD558\uB294 \uAC74 \uB098\uD55C\uD14C\uB294 \uB108\uBB34 \uC704\uD5D8\uD55C \uC77C\uC774\uC57C.",
  "Bad_1": "*\uD55C\uC228*... \uADF8\uB0E5 \uB0B4 \uC885\uC871\uD558\uACE0 \uC788\uC744 \uAC78 \uADF8\uB7AC\uB2E4.$s",
  "Bad_0": "...\uC544\uC9C1 \uB098 \uC88B\uC544\uD574?$s",
  "Bad_2": "\uB098\uB791 \uC9C0\uB0B4\uB294 \uAC70 \uC544\uC9C1\uB3C4 \uD589\uBCF5\uD574?$s",
  "Bad_4": "\uB2E4\uB978 \uC0AC\uB78C\uC774\uB791 \uC9C0\uB0B4\uB294 \uD3B8\uC774 \uB124\uAC00 \uB354 \uD589\uBCF5\uD560 \uAC83 \uAC19\uC544...$s",
  "Bad_5": "\uB124 \uD589\uB3D9\uC5D0\uC11C \uBB54\uAC00 \uB2EC\uB77C\uC84C\uB2E4\uB294 \uAC78 \uAC10\uC9C0\uD588\uC5B4... \uBB34\uC2A8 \uC758\uBBF8\uC57C? *\uB059*$s",
  "Bad_6": "\uB124 \uD558\uB098\uBFD0\uC778 \uC778\uC0DD\uC744 \uC9E7\uC740\uB370... \uB098\uAC19\uC774 \uD749\uCE21\uD55C \uC0DD\uBB3C\uCCB4\uB791 \uBCF4\uB0B4\uACE0 \uC2F6\uB2E4\uB294 \uAC8C \uD655\uC2E4\uD574?$s",
  "Bad_7": "\uC774\uB7F0 \uAD00\uACC4\uB294 \uC2E4\uD328\uD560 \uC6B4\uBA85\uC77C\uC9C0\uB3C4...$s",
  "Bad_8": "\uB108 \uC694\uC998 \uBD88\uD589\uD574 \uBCF4\uC5EC...$s",
  "Bad_9": "\uD558\uC218\uB3C4\uAC00 \uADF8\uB9AC\uC6CC.$s",
