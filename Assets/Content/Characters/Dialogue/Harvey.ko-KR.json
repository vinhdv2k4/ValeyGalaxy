  "eventSeen_58_memory_oneweek": "\uB0B4 \uBE44\uBC00\uC744 \uC774\uBBF8 \uC54C\uACE0 \uC788\uC73C\uB2C8\uAE4C \uC790\uB791\uD574\uB3C4 \uB418\uACA0\uC9C0... \uC774\uBC88 \uC8FC \uC5D0\uC5B4\uB85C\uBE45 \uC218\uC5C5 \uC911\uC5D0\uB294 \uD6E8\uC52C \uC228\uC774 \uB35C \uCC28\uB354\uAD70!",
  "eventSeen_58_memory_twoweeks": "\uC624\uB298 \uC5D0\uC5B4\uB85C\uBE45 \uC218\uC5C5 \uB54C \uC6B4\uB3D9\uC744 \uC815\uB9D0 \uB9CE\uC774 \uD574\uC11C \uC800\uB141\uC5D0 \uD30C\uC2A4\uD0C0 \uD504\uB9AC\uB9C8\uBCA0\uB77C\uB85C \uCD95\uD558\uD574\uB3C4 \uB418\uACA0\uC9C0 \uC2F6\uC5B4...$h",
  "eventSeen_58_memory_fourweeks": "\uB0B4\uAC00 \uC65C \uC5D0\uC5B4\uB85C\uBE45 \uC218\uC5C5\uC744 \uBD80\uB044\uB7EC\uC6CC\uD588\uB294\uC9C0 \uBAA8\uB974\uACA0\uC5B4. \uB2E4\uB9AC\uAC00 \uC815\uB9D0 \uD2BC\uD2BC\uD574\uC84C\uACE0, \uC0AC\uC790 \uAC19\uC740 \uC790\uC2E0\uAC10\uB3C4 \uC0DD\uACBC\uB294\uAC78!",
