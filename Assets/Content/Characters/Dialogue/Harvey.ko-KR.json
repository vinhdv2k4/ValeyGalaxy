{
  "Introduction": "\uB9CC\uB098\uC11C \uBC18\uAC00\uC6CC\uC694. \uB3D9\uB124 \uC758\uC0AC\uC778 \uD558\uBE44\uB77C\uACE0 \uD574\uC694.#$e#\uD3A0\uB9AC\uCEE8 \uB9C8\uC744 \uC8FC\uBBFC\uC758 \uAC74\uAC15 \uAC80\uC9C4\uACFC \uCE58\uB8CC\uB97C \uD558\uACE0 \uC788\uC8E0. \uCC38 \uBFCC\uB4EF\uD55C \uC77C\uC774\uC5D0\uC694.#$e#\uBCF8\uC778\uC774 \uD558\uB294 \uC77C\uC5D0\uC11C\uB3C4 \uADF8\uB7F0 \uB9CC\uC871\uAC10\uC744 \uB290\uB07C\uAE38 \uBC14\uB77C\uC694.$h",
  "AcceptBirthdayGift_Positive": "\uC624! \uC815\uB9D0 \uACE0\uB9C8\uC6CC! \uC0AC\uC2E4 \uC624\uB298\uC774 \uB0B4 \uC0DD\uC77C\uC778 \uAC78 \uC544\uB294 \uC0AC\uB78C\uC774 \uC5C6\uC744 \uAC70\uB77C \uC0DD\uAC01\uD588\uC5B4.$h",
  "AcceptBirthdayGift_Negative": "\uC624! \uC774\uAC74 \uC5B4... \uADF8\uB798, \uBB3C\uAC74\uC774\uB124. \uC624\uB298\uC774 \uB0B4 \uC0DD\uC77C\uC778 \uAC78 \uC544\uB294 \uC0AC\uB78C\uC774 \uC5C6\uC744 \uAC70\uB77C \uC0DD\uAC01\uD588\uB294\uB370.",
  "AcceptGift_(O)StardropTea": "\uC774\uAC78 \uB098\uD55C\uD14C \uC120\uBB3C\uD558\uACA0\uB2E4\uACE0? \uC601\uAD11\uC774\uC57C. \uACE0\uB9C8\uC6CC!",
  "FlowerDance_Accept": "\uC624! \uB124\uAC00... \uB098\uB791 \uCDA4\uCD94\uACE0 \uC2F6\uB2E4\uACE0?$4#$b#...\uC88B\uC544. \uC544\uC8FC \uC88B\uC544!$h",
  "GreenRain": "\uC758\uC57D\uD488\uC744 \uC880 \uCC59\uACA8\uC654\uC5B4\uC694, \uD639\uC2DC \uBAB0\uB77C\uC11C. \uC624\uB298 \uC870\uC2EC\uD558\uC138\uC694!",
  "GreenRain_2": "\uCC98\uC74C \uC774\uB7F0 \uC77C\uC774 \uC788\uC744 \uB54C\uB294 \uB2E4\uB4E4 \uBE44\uAC00 \uC704\uD5D8\uD560 \uC218 \uC788\uC5B4\uC11C \uAC71\uC815\uD588\uB294\uB370.#$b#\uD558\uC9C0\uB9CC \uC0AC\uC2E4\uC740 \uAC74\uAC15\uC5D0 \uC774\uB85C\uC6B8\uC9C0\uB3C4? \uB204\uAC00 \uC54C\uACA0\uC5B4... \uC801\uC5B4\uB3C4 \uC2DD\uBB3C\uB4E4\uC740 \uC88B\uC544\uD558\uB294 \uAC83 \uAC19\uB124.",
  "AcceptGift_(O)432": "\uB098\uD55C\uD14C \uC8FC\uB294 \uC120\uBB3C\uC774\uC57C? \uACE0\uB9C8\uC6CC! \uD30C\uC2A4\uD0C0\uC5D0 \uBFCC\uB824 \uBA39\uC73C\uBA74 \uD658\uC0C1\uC801\uC774\uACA0\uB2E4.$h",
  "AcceptGift_(O)348": "\uB0A0 \uC704\uD574\uC11C? \uBA4B\uC9C4 \uC120\uBB3C\uC774\uB124! \uD658\uC0C1\uC801\uC774\uB2E4!$h#$b#\uC0AC\uC2E4, \uC0DD\uB9AC\uD559\uC801\uC73C\uB85C\uB294 \uC54C\uCF54\uC62C \uC12D\uCDE8\uB97C \uAD8C\uC7A5\uD558\uC9C4 \uBABB\uD558\uACA0\uC9C0\uB9CC...#$b#\uB290\uAE0B\uD558\uAC8C \uC990\uAE30\uB294 \uC2A4\uD0C0\uB4C0 \uBC38\uB9AC\uC758 \uACE0\uAE09 \uC640\uC778 \uD55C \uC794\uC758 \uC7A5\uC810\uC744 \uBD80\uC815\uD560 \uC21C \uC5C6\uC9C0!$h",
  "eventSeen_56_memory_fourweeks": "\uBA87 \uB144\uC9F8 \u0027\uB3D9\uBB3C \uCCB4\uD06C\uB9AC\uC2A4\uD2B8\u0027\uB97C \uCC44\uC6CC\uB098\uAC00\uB294 \uC911\uC774\uC57C. \uBC38\uB9AC\uC5D0 \uC11C\uC2DD\uD558\uB294 \uBAA8\uB4E0 \uC885\uC744 \uAD00\uCC30\uD558\uACE0 \uC2F6\uC5B4!",
  "eventSeen_56_memory_twoweeks": "\uB0B4\uAC00 \uC9C1\uC811 \uD53C\uD074\uC744 \uB9CC\uB4E4\uC5B4\uBCF4\uB824\uACE0 \uD55C \uC801\uC774 \uC788\uB294\uB370...$s#$e#\uC74C, \uC774\uB807\uAC8C\uB9CC \uB9D0\uD560\uAC8C... \uACE0\uB4F1\uD559\uAD50 \uB54C \uD574\uBD80\uD55C \uAC1C\uAD6C\uB9AC \uC815\uB3C4\uBA74 \uC7A5\uBBF8\uD5A5\uC774\uB77C\uACE0 \uC0DD\uAC01\uD558\uAC8C \uB410\uC5B4...",
