  "Wed4": "\uB108\uC640 \uC880 \uB354 \uC798 \uC54C\uACE0 \uC9C0\uB0B4\uACE0 \uC2F6\uC5B4, @. \uC6B0\uB9AC \uB108\uBB34 \uC758\uC0AC-\uD658\uC790\uAD00\uACC4\uB85C\uB9CC \uC9C0\uB0B4\uC9C4 \uB9D0\uC790.",
  "Wed6": "\uB3D9\uB124\uC5D0 \uCE5C\uAD6C\uAC00 \uC788\uC5B4\uC11C \uC990\uAC81\uB124.$h",
  "Wed8": "\uC548\uC0C9\uC774 \uC815\uB9D0 \uAC74\uAC15\uD558\uB124. \uC88B\uC740 \uC77C\uC774\uC57C.$h",
  "Wed": "\uC7AC\uCC44\uAE30\uB97C \uD560 \uB550 \uAF2D \uC785\uC744 \uAC00\uB9AC\uC138\uC694.#$e#\uADF8\uB7EC\uACE0 \uB098\uC11C \uC190\uC744 \uC53B\uB294 \uAC83\uB3C4 \uC78A\uC9C0 \uB9D0\uC544\uC694.",
  "Thu8": "$query PLAYER_NPC_RELATIONSHIP current any married roommate#\uC758\uC0AC\uB2E4 \uBCF4\uB2C8 \uC9D1\uC5D0\uC11C \uC9C1\uC811 \uC694\uB9AC\uD55C \uC74C\uC2DD\uC774 \uAC74\uAC15\uC5D0 \uC5BC\uB9C8\uB098 \uC88B\uC740\uC9C0 \uC798 \uC54C\uC9C0. \uD558\uC9C0\uB9CC \uBC14\uBE60\uC11C \uC9C1\uC811 \uC694\uB9AC\uD560 \uAE30\uD68C\uAC00 \uB9CE\uC9C4 \uC54A\uB124.$s|\uC758\uC0AC\uB77C\uB294 \uC9C1\uC5C5\uC740 \uC77C\uC774 \uCC38 \uB9CE\uC544. \uCDA9\uBD84\uD788 \uC798 \uCC59\uACA8 \uBA39\uC9C0 \uBABB\uD558\uB294 \uACBD\uC6B0\uB3C4 \uB9CE\uACE0.$s#$e#\uD63C\uC790 \uC0B4\uC9C0 \uC54A\uC558\uB354\uB77C\uBA74 \uC880 \uB354 \uC218\uC6D4\uD588\uC744 \uD150\uB370.$l",
  "Thu": "\uC62C\uBC14\uB978 \uC601\uC591\uBD84 \uC12D\uCDE8\uB294 \uC544\uC8FC \uC911\uC694\uD574\uC694, \uAF2D \uC798 \uCC59\uACA8 \uB4DC\uC138\uC694. \uC57C\uCC44\uB3C4 \uB9CE\uC774 \uB4DC\uC2DC\uACE0\uC694!#$e#\uC9D1\uC5D0\uC11C \uB9CC\uB4E4\uC5B4 \uBA39\uB294 \uC2DD\uC0AC\uAC00 \uC81C\uC77C \uC88B\uC8E0. \uC694\uB9AC\uD558\uC2DC\uB098\uC694?",
  "Fri": "\uCC38 \uC544\uB984\uB2E4\uC6B4 \uB0A0\uC774\uC8E0, \uADF8\uB807\uC8E0?#$e#\uD560 \uC77C\uC774 \uC774\uB807\uAC8C \uB9CE\uC9C0 \uC54A\uC558\uC73C\uBA74 \uC88B\uACA0\uB124\uC694.$s",
  "Fri4": "\uC9D1\uC5D0 \uB180\uB7EC \uC624\uACE0 \uC2F6\uB2E4\uBA74, \uC5B8\uC81C\uB4E0\uC9C0 \uBC29\uBB38\uD574\uB3C4 \uC88B\uC544. \uB09C \uBCD1\uC6D0 \uC704\uCE35\uC5D0\uC11C \uC9C0\uB0B4.",
  "Fri10": "\uD639\uC2DC \uBE44\uBC00\uB9AC\uC5D0 \uAC80\uC9C4\uBC1B\uACE0 \uC2F6\uC740 \uAC8C \uC788\uB2E4\uBA74 \uC9D1\uC73C\uB85C \uBC29\uBB38\uD574\uB3C4 \uC88B\uC544.$l",
