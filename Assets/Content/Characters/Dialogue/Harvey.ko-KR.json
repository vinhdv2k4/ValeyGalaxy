  "Mon6": "\uC2A4\uD0C0\uB4C0 \uBC38\uB9AC\uC5D0 \uC624\uB798 \uBA38\uBB34\uB974\uACE0 \uC2F6\uC5B4. \uC815\uB9D0 \uACF5\uB3D9\uCCB4\uC758 \uC77C\uC6D0\uC774 \uB41C \uAE30\uBD84\uC774 \uB4E4\uAE30 \uC2DC\uC791\uD588\uC5B4.#$e#\uB0A8\uC5D0\uAC8C \uB3C4\uC6C0\uC744 \uB41C\uB2E4\uB294 \uAC78 \uC544\uB294 \uAC74 \uCC38 \uAE30\uBD84 \uC88B\uC740 \uC77C\uC774\uC9C0.",
  "Mon10": "\uC624! \uC548\uB155, @.$l#$e#\uBB54\uAC00... \uC758\uD559\uC801\uC778 \uC9C8\uBB38\uC774 \uC788\uB294 \uAC70\uC57C?$l",
  "Tue": "\uD639\uC2DC \uBAB8\uC774 \uC544\uD508 \uAC83 \uAC19\uC73C\uBA74 \uC5B8\uC81C\uB77C\uB3C4 \uBC29\uBB38\uD574\uC8FC\uC138\uC694.#$e#\uD558\uC9C0\uB9CC \uC544\uC9C1 \uC80A\uC73C\uC154\uC11C \uD070 \uB178\uB825 \uC5C6\uC774\uB3C4 \uAC74\uAC15\uC744 \uC27D\uAC8C \uC720\uC9C0\uB420 \uAC70\uC608\uC694.$h",
