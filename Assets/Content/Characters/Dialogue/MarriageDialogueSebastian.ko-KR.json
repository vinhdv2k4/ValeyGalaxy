{
  "Rainy_Day_0": "\uB4DC\uB514\uC5B4... \uBE44\uAC00 \uC880 \uB9CE\uC774 \uC640\uC8FC\uB124. \uD654\uCC3D\uD55C \uB0A0\uC740 \uAE08\uBC29 \uC9C8\uB824.",
  "Rainy_Day_1": "\uC544. \uB0B4 \uBC29\uC73C\uB85C \uC4F0\uB358 \uC9C0\uD558\uC2E4 \uC0DD\uAC01\uD558\uACE0 \uC788\uC5C8\uC5B4. \uD3B8\uD558\uAE34 \uD588\uC9C0\uB9CC, \uC5EC\uAE30\uAC00 \uD6E8\uC52C \uD765\uBBF8\uB85C\uC6CC. \uAC8C\uB2E4\uAC00 \uB0C4\uC0C8\uB3C4 \uBCC4\uB85C\uC600\uC9C0...#$e#\uC0AC\uC2E4 \uC5C4\uB9C8\uB124 \uC9D1\uC5D0\uC11C \uADF8\uB807\uAC8C \uC624\uB798 \uC9C0\uB0B8 \uAC8C \uBD80\uB044\uB7FD\uAE30\uB3C4 \uD574.",
  "Rainy_Day_2": "\uC57C. \uC5B4\uC82F\uBC24\uC5D0 \uC7A0\uC774 \uC548 \uC640\uC11C \uB3D9\uAD74 \uCABD\uC73C\uB85C \uC0B0\uCC45 \uAC14\uC5B4. \uC774\uAC70 \uCC3E\uC558\uB294\uB370... \uC904\uAE4C?[575 769 767 84 66 78]#$e#\uADF8\uB0E5 \uAC00\uB054 \uC7A0\uC744 \uBABB \uC790\uB294 \uAC83\uBFD0\uC774\uC57C, \uB124\uAC00 \uADF8\uB7AC\uB2E4\uB294 \uAC74 \uC544\uB2C8\uACE0. \uC0AC\uB791\uD574.$7",
  "Rainy_Day_3": "\uADF8\uB0E5 \uB204\uC6CC\uC788\uAE30 \uC88B\uC740 \uB0A0 \uAC19\uB2E4, \uCC45\uC774\uB77C\uB3C4 \uC77D\uAC70\uB098... \uB124 \uC0DD\uAC01\uC740 \uC5B4\uB54C?",
  "Rainy_Day_4": "\uC57C, \uB610 \uBE44 \uC628\uB2E4... \uC644\uBCBD\uD574.#$e#\uB108 \uCD94\uC6CC \uBCF4\uC5EC... \uC5EC\uAE30, \uC880 \uB354 \uAC00\uAE4C\uC774 \uC640.$l",
  "Rainy_Night_0": "\uC6B0\uB9AC \uACB0\uD63C\uD588\uC73C\uB2C8 \uB2F4\uBC30 \uB04A\uB294\uB370 \uCD5C\uC120\uC744 \uB2E4\uD574\uC57C\uC9C0... \uB110 \uB450\uACE0 \uC8FD\uC744 \uC21C \uC5C6\uC5B4. \uB098\uC05C \uBC84\uB987\uC774\uAE30\uB3C4 \uD558\uACE0.#$e#\uD568\uAED8\uD560 \uBBF8\uB798\uB97C \uB204\uB9AC\uACE0 \uC788\uB294 \uAC78.$l",
  "patio_Sebastian": "\uD544\uC694\uD55C \uAC70 \uC788\uC5B4? \uB098 \uC5EC\uAE30\uC11C \uBC14\uC774\uD06C \uC880 \uC190\uBCF4\uACE0 \uC788\uC744\uAC8C.",
  "Rainy_Night_1": "\uC624\uB298 \uB178\uD2B8\uBD81\uC73C\uB85C \uC77C \uC880 \uD588\uC5B4. \uC0AC\uC2E4 \uB0B4\uAC00 \uB9CC\uB4E4\uACE0 \uC2F6\uC740 \uAC8C\uC784 \uC544\uC774\uB514\uC5B4 \uC880 \uC815\uB9AC\uD574\uBCF4\uACE0 \uC788\uC5C8\uC5B4.#$e#\uB18D\uC7A5 \uC218\uC785 \uB355\uBD84\uC5D0, \uC815\uB9D0 \uD558\uACE0 \uC2F6\uC740 \uC77C\uC744 \uD560 \uC218 \uC788\uC5B4. \uD658\uC0C1\uC801\uC774\uC57C. \uC815\uB9D0 \uACE0\uB9C8\uC6CC.$h",
  "Rainy_Night_2": "\uBBF8\uC548, \uC800\uB141 \uCC28\uB9AC\uB294 \uAC70 \uAE5C\uBE61\uD588\uC5B4. \uB0C9\uC7A5\uACE0\uC5D0 \uB0C9\uB3D9\uD53C\uC790\uB77C\uB3C4 \uC788\uC744 \uAC70\uC57C.#$e#\uBAA8\uB974\uACA0\uC5B4, \uB2E4\uB978 \uC0DD\uAC01\uD558\uACE0 \uC788\uC5C8\uB098. \uC9D1\uC548\uC77C \uAE30\uC5B5\uD558\uB294 \uAC8C \uC5B4\uB824\uC6CC...",
  "Rainy_Night_3": "\uC624\uB298 \uD558\uB8E8 \uC5B4\uB560\uC5B4? \uBAAC\uC2A4\uD130 \uC880 \uC7A1\uC558\uC5B4?$h#$e#\uAC00\uB054 \uADF8\uB7F0 \uACA9\uD55C \uD65C\uB3D9\uB3C4 \uC88B\uC9C0, \uC548 \uADF8\uB798?",
  "Rainy_Night_4": "\uC624\uB298 \uBC24 \uB9C8\uB140\uAC00 \uBC29\uBB38\uD558\uB824\uB098? \uD558.. \uC778\uC0DD\uC774 \uADF8\uB807\uAC8C \uD765\uBBF8\uB85C\uC6E0\uC73C\uBA74...",
  "Indoor_Day_0": "\uB098\uC774\uAC00 \uB4E4\uC218\uB85D, \uB3C4\uC2DC\uC758 \uB9E4\uB825\uC774 \uC904\uC5B4\uB4DC\uB294 \uAC83 \uAC19\uC544. \uD55C\uB54C\uB294 \uC2E0\uBE44\uB85C\uC6B4 \uB290\uB08C\uC774 \uB4E4\uC5C8\uC9C0. \uADFC\uB370 \uADF8\uB0E5 \uB85C\uB9E8\uD2F1\uD55C \uD658\uC0C1\uC774\uB354\uB77C\uACE0.#$e#\uB3C4\uC2DC\uB294 \uC815\uB9D0 \uBC14\uC058\uACE0 \uC0AC\uB78C\uB4E4\uB85C \uAC00\uB4DD\uD574... \uB0B4\uAC00 \uC788\uC744 \uACF3\uC774 \uC544\uB2C8\uC57C. \uB09C \uD63C\uC790\uAC00 \uC88B\uC740 \uAC78.",
  "Indoor_Day_1": "\uC57C... \uCEE4\uD53C \uB9C8\uC2E4\uB798?[395]$7#$e#\uB09C \uC880 \uD544\uC694\uD588\uC5B4... \uC545\uBABD \uB54C\uBB38\uC5D0 \uC77C\uCC0D \uAE68\uC11C \uC7A0\uC774 \uC624\uC9C8 \uC54A\uB354\uB77C\uACE0.",
  "Indoor_Day_2": "\uBC24\uC5D0 \uC7A0\uC774 \uC548 \uC640\uC11C \uC624\uD1A0\uBC14\uC774 \uD0C0\uB7EC \uC7A0\uAE50 \uB098\uAC14\uC5B4.#$e#\uB09C \uB098\uB9CC\uC758 \uC2DC\uAC04\uC774 \uD544\uC694\uD574, \uC6B0\uB9AC\uAC00 \uACB0\uD63C\uD558\uAE34 \uD588\uC9C0\uB9CC. \uADF8\uB0E5 \uB0B4\uAC00 \uC774\uB7F0 \uAC78. \uADF8\uB798\uB3C4 \uB0B4\uAC00 \uB110 \uC0AC\uB791\uD55C\uB2E4\uB294 \uAC74 \uBCC0\uD568\uC5C6\uC5B4.$7",
  "Indoor_Day_3": "\uC5B4\uC82F\uBC24\uC5D0 \uC798 \uC7A4\uC5B4? \uB124\uAC00 \uC911\uC5BC\uAC70\uB9AC\uB294 \uAC78 \uB4E4\uC5C8\uC5B4.#$e#\uAC81\uBA39\uC740 \uAC83 \uAC19\uC558\uB294\uB370, \uC194\uC9C1\uD788... \uC880 \uADC0\uC5EC\uC6E0\uC5B4.$l",
  "Indoor_Day_4": "\uB108\uB791 \uC5EC\uAE30\uC11C \uC9C0\uB0B4\uB2E4 \uBCF4\uB2C8\uAE4C \uB0B4\uBA74\uC73C\uB85C \uC790\uAFB8 \uC228\uB294 \uBC84\uB987\uC774 \uC810\uC810 \uC5C6\uC5B4\uC9C0\uACE0 \uC788\uC5B4. \uB098\uD55C\uD14C \uC88B\uC740 \uC77C \uAC19\uC544.$7",
  "Indoor_Night_0": "\uC548\uB155. \uC624\uB298\uC740 \uADF8\uB0E5 \uC9D1\uC5D0\uC11C \uBCF4\uB0C8\uC5B4. \uD2B9\uBCC4\uD55C \uAC74 \uC5C6\uC5C8\uC5B4...#$e#...#$e#\uC6B0\uB9AC \uC9D1\uC5D0\uC11C \uBCF4\uC774\uB294 \uD48D\uACBD\uC774 \uC644\uBCBD\uD574. \uC55E\uB9C8\uB2F9\uC5D0\uC11C \uD3A0\uB9AC\uCEE8 \uB9C8\uC744\uC5D0 \uD574\uAC00 \uC9C0\uB294 \uAC8C \uBCF4\uC5EC.",
  "Indoor_Night_1": "\uCEE4\uD53C\uB97C \uB108\uBB34 \uB9CE\uC774 \uB9C8\uC168\uB098... \uD53C\uACE4\uD55C \uAE30\uBD84\uC774 \uC548 \uB4E4\uC5B4.#$e#\uC544\uC9C1 \uB18D\uC7A5 \uC0DD\uD65C\uC5D0 \uC801\uC751 \uC911\uC774\uC57C. \uC608\uC804\uC5D0\uB294 \uC0C8\uBCBD 5\uC2DC\uC5D0 \uC7A0\uB4E4\uACE0 \uC624\uD6C4 2\uC2DC\uAE4C\uC9C0 \uC794 \uACBD\uC6B0\uB3C4 \uC788\uB294\uAC78.$h",
  "Indoor_Night_2": "\uC6B0\uB9AC\uB9CC\uC758 \uC7A5\uC18C\uAC00 \uC788\uC5B4\uC11C \uC88B\uB2E4. \uC0AC\uB78C\uB4E4 \uC794\uC18C\uB9AC \uC5C6\uC774 \uB0B4\uAC00 \uD558\uACE0 \uC2F6\uC740 \uB300\uB85C \uD560 \uC218 \uC788\uC5B4.#$e#\uB0B4\uAC00 \uB5A0\uB098\uC11C \uB9C8\uB8E8\uB3C4 \uBD84\uBA85 \uAE30\uC060 \uAC70\uC57C.",
  "Indoor_Night_3": "\uC544\uAE4C \uCC3D\uBC16\uC73C\uB85C \uBC15\uC950\uB97C \uBD24\uC5B4. \uBCF4\uAE30 \uC5B4\uB835\uAE34 \uD558\uC9C0\uB9CC, \uC9D1\uC911\uD558\uBA74 \uB0A0\uC544\uB2E4\uB2C8\uB294 \uAC8C \uBCF4\uC5EC. \uC800 \uBC16\uC5D0 \uC5B4\uB518\uAC00 \uC788\uC5B4.",
  "Indoor_Night_4": "\uC9D1\uC5D0\uC11C \uC9C0\uB0BC \uB54C\uB294 \uC778\uC815\uBC1B\uC9C0 \uBABB\uD558\uB294 \uAE30\uBD84\uC774 \uC790\uC8FC \uB4E4\uC5C8\uB294\uB370... \uC5EC\uAE30\uB294 \uB0B4\uAC00 \uC788\uC744 \uC790\uB9AC\uB77C\uB294 \uAE30\uBD84\uC774 \uD655\uC2E4\uD788 \uB4E4\uC5B4. \uD658\uC601\uBC1B\uB294 \uAE30\uBD84\uC744 \uB290\uB07C\uAC8C \uD574\uC918\uC11C \uACE0\uB9C8\uC6CC, @.$l",
  "Outdoor_0": "\uC624\uB298 \uBB54\uAC00 \uD558\uACE0 \uC2F6\uC740\uB370... \uBB58 \uD558\uACE0 \uC2F6\uC740\uC9C0 \uBAA8\uB974\uACA0\uC5B4. \uC774\uB7F0 \uAE30\uBD84 \uB4E4 \uB54C \uC788\uC5B4, @?",
  "Outdoor_1": "\uD760... \uAC00\uB054 \uAC74\uAC15\uC744 \uC704\uD574\uC11C \uBC16\uC73C\uB85C \uC77C\uBD80\uB7EC \uB098\uC640.#$e#\uC65C \uADF8\uB7F0\uC9C0 \uBAA8\uB974\uACA0\uB294\uB370, \uB09C \uC2E4\uB0B4\uC5D0 \uC788\uB294 \uAC8C \uC88B\uB354\uB77C\uACE0. \uC5B4\uB450\uC6B4 \uC9C0\uD558\uC2E4\uC5D0 \uB108\uBB34 \uC775\uC219\uD574\uC9C4 \uAC78\uAE4C.",
  "Outdoor_2": "\uB09C \uADF8\uB0E5 \uC5EC\uAE30\uC11C \uB108 \uAD6C\uACBD\uD558\uACE0 \uC788\uC744\uAC8C.$h#$e#\uB09C \uB108 \uBCF4\uACE0 \uC788\uB294 \uAC8C \uC88B\uB354\uB77C.",
  "Outdoor_3": "\uACB0\uD63C\uD588\uB2E4\uACE0 \uB0B4\uAC00 \uB108\uBB34 \uC5EC\uB9B0 \uC0AC\uB78C\uC774 \uB418\uBA74 \uC548 \uB418\uB294\uB370. \uB9E4\uC6B4 \uACE0\uCD94\uB97C \uBA39\uACE0 \uC6B4\uB3D9\uC744 \uD574\uC57C \uD558\uB098?#$e#\uADF8\uB0E5 \uC0DD\uAC01\uD574\uBCF8 \uAC70\uC57C...$h",
  "Outdoor_4": "\uC6B0\uB9AC \uC2AC\uB77C\uC784 \uC880 \uB354 \uB9CE\uC774 \uD0A4\uC6B0\uC790... \uC591\uC774 \uB9CE\uC73C\uBA74 \uAF64 \uC218\uC775\uC131\uB3C4 \uAD1C\uCC2E\uC744 \uAC70\uC57C. \uD0A4\uC6B0\uAE30\uB3C4 \uC27D\uACE0.#$e#\uAC8C\uB2E4\uAC00, \uC0C9\uAE54\uBCC4\uB85C \uB2E4\uB978 \uBB3C\uD488\uC744 \uC0DD\uC0B0\uD558\uAC70\uB4E0. \uADF8\uB9AC\uACE0, \uBAA8\uB974\uACA0\uB2E4, \uAF64 \uC7AC\uBC0C\uB294 \uCDE8\uBBF8\uC77C \uC218\uB3C4 \uC788\uC744 \uAC83 \uAC19\uC544.",
  "OneKid_0": "\uC544\uC9C1 \uC544\uBE60\uB77C\uB294 \uC0AC\uC2E4\uC5D0 \uC775\uC219\uD574\uC9C0\uACE0 \uC788\uC5B4. \uAC71\uC815\uD558\uC9C4 \uB9C8, %kid1(\uC774)\uB294 \uC798 \uB3CC\uBCF4\uACE0 \uC788\uC5B4! \uADF8\uB0E5... \uB9CE\uC774 \uC0C8\uB85C\uC6CC.",
  "OneKid_1": "%kid1(\uC774)\uAC00 \uB098\uC774\uAC00 \uC880 \uB354 \uB4E4\uBA74, \uBC14\uC774\uD06C\uC5D0 \uC5F0\uACB0\uD560 \uC0AC\uC774\uB4DC\uCE74 \uAD6C\uD574\uC11C \uAC19\uC774 \uD0C0\uB7EC \uAC08 \uC218 \uC788\uACA0\uB2E4.$h",
  "OneKid_3": "%kid1(\uC774) \uB0C4\uC0C8 \uB9E1\uC544\uBD24\uC5B4? \uBAA9\uC695\uC2DC\uCF1C\uC57C\uACA0\uB294\uAC78...",
  "TwoKids_0": "\uC560\uB4E4 \uBC25\uC740 \uC774\uBBF8 \uCC59\uACA8\uC92C\uC5B4, \uAC71\uC815 \uC548 \uD574\uB3C4 \uAD1C\uCC2E\uC544... %kid2(\uC774)\uAC00 \uB610 \uB0B4 \uC637\uC5D0 \uCD08\uCF5C\uB9BF \uC6B0\uC720\uB97C \uC628\uD1B5 \uD758\uB838\uC5B4.",
  "TwoKids_1": "%kid1(\uC774)\uB791 %kid2(\uC774)\uAC00 \uC11C\uB85C \uCE5C\uD588\uC73C\uBA74 \uC88B\uACA0\uB2E4. \uB9C8\uB8E8\uB791 \uB098\uB791 \uC5B4\uB838\uC744 \uB54C \uC790\uC8FC \uC2F8\uC6E0\uAC70\uB4E0.#$e#\uB2E4\uC2DC \uC0DD\uAC01\uD574\uBCF4\uB2C8\uAE4C, \uB300\uBD80\uBD84 \uB0B4 \uD0D3\uC774\uC5C8\uB124...",
  "TwoKids_2": "\uC694\uC998 %kid2(\uC774)\uAC00 \uADF8\uB9BC\uC790 \uC8FC\uC220\uC0AC \uBCF5\uC7A5\uC744 \uD558\uACE0 \uBE5B\uB098\uB294 \uD638\uBC15\uC5D0 \uC549\uC544\uC788\uB294 \uAFC8\uC744 \uC790\uAFB8 \uAFD4. \uC774\uC0C1\uD558\uC9C0, \uADF8\uCE58?",
  "TwoKids_3": "\uC6B0\uB9AC \uC815\uB9D0 \uC774\uB8EC \uAC8C \uB9CE\uC544, @. \uC6B0\uB9AC \uAC00\uC871\uC744 \uBD10. \uC194\uC9C1\uD788, \uB0B4\uAC8C \uC774\uB7F0 \uC0C1\uD669\uC774 \uC62C \uC904\uC740 \uC0DD\uAC01\uD574\uBCF8 \uC801\uC774 \uC5C6\uC5B4.#$e#\uADFC\uB370 \uB9C9\uC0C1 \uC774\uB7EC\uB2C8\uAE4C, \uC815\uB9D0 \uB9C8\uC74C\uC5D0 \uB4E4\uC5B4...$l",
  "Good_0": "\uC774\uBD10. \uB098 \uBD10\uBD10. \uB0B4\uAC00 \uB110 \uC0AC\uB791\uD55C\uB2E4\uB294 \uC0AC\uC2E4\uC744 \uC78A\uC9C0 \uB9C8... \uB10C \uB0B4 \uC804\uBD80\uC57C.$l#$b#\uC790, \uC774\uC81C \uAC00\uC11C \uB3C8 \uBC8C\uC5B4.$h",
  "Good_1": "\uC57C... \uC77C\uB85C \uC640\uBD10. \uC624\uB298 \uC88B\uC544 \uBCF4\uC5EC.$l",
  "Good_2": "\uC790\uAE34 \uD56D\uC0C1 \uBA4B\uC838 \uBCF4\uC5EC, \uD558\uB8E8 \uC885\uC77C \uBC2D\uC77C\uC744 \uD588\uB294\uB370\uB3C4 \uB9D0\uC774\uC57C.$l",
  "Good_3": "\uB0B4\uAC00 \uC790\uC8FC \uB0B4\uC0C9\uD558\uC9C4 \uC54A\uC9C0\uB9CC, \uB0B4\uAC00 \uB124 \uB0A8\uD3B8\uC774\uB77C\uC11C \uC815\uB9D0 \uD589\uBCF5\uD574. \uB108\uC640 \uACB0\uD63C\uD558\uB294 \uAC74 \uB0B4\uAC00 \uB0B4\uB9B0 \uCD5C\uACE0\uC758 \uACB0\uC815\uC774\uC57C.$l",
  "Good_4": "\uB0B4 \uAC71\uC815 \uD560 \uD544\uC694\uB294 \uC5C6\uC5B4. \uB098 \uD63C\uC790\uC11C \uC2DC\uAC04 \uC798 \uBCF4\uB0B4\uC796\uC544.",
  "Good_5": "\uAC00\uB054 \uC815\uB9D0 \uD654\uAC00 \uB098\uB294\uB370... \uB124\uAC00 \uC624\uBA74 \uD56D\uC0C1 \uAE30\uBD84\uC774 \uD480\uB824.$7#$e#\uB098\uC774\uAC00 \uB4E4\uBA74 \uC880 \uB354 \uCC28\uBD84\uD574\uC9C0\uB824\uB098.",
  "Good_6": "\uB124\uAC00 \uAC15\uD558\uB2E4\uB294 \uAC74 \uC54C\uC9C0\uB9CC, \uADF8\uB798\uB3C4 \uAC00\uB054 \uB124 \uAC71\uC815\uC774 \uB418\uB294\uAC78. \uC0DD\uBA85\uC758 \uC601\uC57D\uC774\uB791 \uD2BC\uD2BC\uD55C \uC7A5\uD654 \uC5C6\uC774\uB294 \uC808\uB300\uB85C \uBAAC\uC2A4\uD130 \uC0AC\uB0E5\uD558\uB7EC \uAC00\uC9C0 \uB9C8, \uC54C\uC558\uC9C0?",
  "Good_8": "\uC624\uB298 \uC815\uB9D0\uC774\uC9C0 \uC77C\uD558\uACE0 \uC2F6\uC740 \uAE30\uBD84\uC740 \uC544\uB2C8\uB2E4. \uD2F0\uBE44\uC5D0\uC11C \uBB50\uD558\uB098 \uBCFC\uAE4C.",
  "Good_9": "\uB098 \uCE5C\uAD6C\uB294 \uBCC4\uB85C \uD544\uC694 \uC5C6\uC5B4. \uB0B4 \uC778\uC0DD\uC5D0\uC11C \uD544\uC694\uD55C \uC0AC\uB78C\uC740 \uB108\uBFD0\uC778\uAC78. \uC774\uC0C1\uD55C \uAC74\uAC00?#$e#\uB0B4\uAC00 \uB300\uBD80\uBD84 \uC0AC\uB78C\uB4E4\uD558\uACE0 \uB2E4\uB974\uAE34 \uD558\uC9C0.",
  "Neutral_0": "\uB098 \uC0B0\uCC45\uD560 \uB54C\uBA74 \uB418\uB3C4\uB85D \uB2E4\uB978 \uC0AC\uB78C\uB4E4\uC740 \uD53C\uD574. \uC7A1\uB2F4\uD574\uC57C \uD558\uB294 \uC0C1\uD669\uC774 \uB108\uBB34 \uC2EB\uC5B4.",
  "Neutral_2": "\uC624\uB298 \uD558\uB8E8 \uC5B4\uB560\uB294\uC9C0\uB294 \uC790\uAE30 \uC804\uC5D0 \uC598\uAE30\uD558\uBA74 \uC548 \uB420\uAE4C? \uB098 \uC9C0\uAE08\uC740 \uC880 \uBC14\uBE60\uC11C...",
  "Neutral_3": "\uC624\uB298 \uB9C8\uC744 \uAC00\uB824\uACE0? \uC65C, \uBB50\uD558\uB824\uACE0?",
  "Neutral_4": "\uC624\uB298 \uBE68\uB798\uB294 \uB0B4\uAC00 \uD574\uC57C\uACA0\uB124... \uB18D\uC7A5 \uC77C\uB85C\uB3C4 \uB10C \uCDA9\uBD84\uD788 \uBC14\uC058\uACA0\uC9C0.",
  "Neutral_5": "\uC6B0\uB9AC \uB3C8\uC740 \uAD1C\uCC2E\uC740 \uAC70\uC9C0? \uB178\uD2B8\uBD81\uC744 \uD314\uACE0 \uC2F6\uC9C4 \uC54A\uC544...",
  "Neutral_6": "\uB9C8\uC744\uC5D0\uC11C \uCE5C\uAD6C\uB4E4 \uBCF4\uB7EC \uAC00\uC57C \uD558\uBA74 \uC5B8\uC81C\uB4E0 \uB2E4\uB140\uC640. \uB09C \uC5B4\uCC28\uD53C \uD63C\uC790\uC778 \uAC8C \uC88B\uC73C\uB2C8\uAE4C.",
  "Neutral_8": "\uCCAD\uC18C\uD558\uB294 \uAC8C \uC7AC\uBC0C\uC9C4 \uC54A\uC9C0\uB9CC, \uC74C\uC545 \uB4E4\uC73C\uBA74\uC11C \uD558\uBA74 \uAE08\uBC29 \uB05D\uB098\uB354\uB77C.",
  "Bad_5": "\uC788\uC9C0, \uB098 \uC9C0\uAE08\uC740 \uADF8\uB0E5 \uD63C\uC790 \uC788\uACE0 \uC2F6\uC5B4. \uD55C\uB3D9\uC548 \uB098\uAC00\uC11C \uB124\uAC00 \uD574\uC57C \uD560 \uC77C \uD558\uB294 \uAC74 \uC5B4\uB54C?",
  "Bad_6": "\uBB58 \uC6D0\uD574? \uAF2D \uD558\uB294 \uC18C\uB9AC\uAC00 \uB0B4 \uC0C8\uC544\uBE60 \uAC19\uB124. \uC800\uB9AC \uAC00.$a",
  "Bad_7": "\uC5EC\uAE30 \uC880 \uBB34\uB364 \uAC19\uB2E4.$s",
  "Bad_8": "\uB098 \uB2F4\uBC30 \uB2E4\uC2DC \uD53C\uAE30 \uC2DC\uC791\uD588\uC5B4... \uADF8\uB0E5 \uC694\uC998 \uC2A4\uD2B8\uB808\uC2A4\uAC00 \uB108\uBB34 \uB9CE\uC544\uC11C.$s",
  "funLeave_Sebastian": "\uB098 \uC624\uB298\uC740 \uC0B0\uCC45\uD558\uACE0 \uC624\uB824\uACE0. \uD63C\uC790 \uC788\uC744 \uC2DC\uAC04\uC774 \uD544\uC694\uD574. \uC800\uB141\uC5D0 \uBCFC\uAC8C.",
  "funReturn_Sebastian": "\uC624\uB298 \uD558\uB8E8 \uAD1C\uCC2E\uC558\uC5B4, \uD2B9\uBCC4\uD788 \uB4E4\uB824\uC904 \uC598\uAE30\uB294 \uC5C6\uC9C0\uB9CC. \uB124 \uD558\uB8E8\uB294 \uC5B4\uB560\uC5B4?",
  "spring_1": "\uC544\uC774\uACE0... \uBA38\uB9AC\uC57C. \uC0C8\uD574 \uBCF5 \uB9CE\uC774 \uBC1B\uC544...$h",
  "spring_12": "\uB0B4\uC77C \uCD95\uC81C \uAE30\uB300\uD558\uACE0 \uC788\uC5B4? \uC0D8\uB3C4 \uB2E4\uC2DC \uBCFC \uC218 \uC788\uACA0\uB124.",
  "spring_23": "\uC624... \uB0B4\uC77C \uBD04\uAF43 \uBB34\uB3C4\uD68C\uAD6C\uB098, \uADF8\uCE58? \uC6B0\uB9AC \uAF2D \uAC00\uC57C \uD574?#$e#\uADF8 \uC6C3\uAE30\uB294 \uC810\uD504 \uC288\uD2B8 \uC815\uB9D0 \uC785\uAE30 \uC2EB\uC5B4. \uB8E8\uC774\uC2A4\uB294 \uC65C \uC6B0\uB9AC\uD55C\uD14C \uC774\uB7F0 \uAC78 \uD558\uAC8C \uB9CC\uB4DC\uB294 \uAC70\uC9C0?$s",
  "summer_1": "\uC5EC\uB984\uC774\uB124... \uB0B4 \uCC3D\uBC31\uD55C \uD53C\uBD80\uB97C \uC720\uC9C0\uD558\uB824\uBA74 \uC120\uD06C\uB9BC \uAF64 \uB450\uD141\uAC8C \uBC14\uB974\uAE30 \uC2DC\uC791\uD574\uC57C\uACA0\uC5B4...",
  "summer_10": "\uB8E8\uC544\uC6B0 \uC2A4\uD504\uC5D0 \uBB58 \uB123\uC744\uC9C0 \uC0DD\uAC01\uD574\uBD24\uC5B4?#$e#\uB09C \uBB50\uAC00 \uC88B\uC744\uC9C0 \uC804\uD600 \uBAA8\uB974\uACA0\uC5B4... \uB124\uAC00 \uC170\uD504\uC778\uAC78!$7",
  "summer_27": "\uB0A0\uC774 \uC120\uC120\uD574\uC9C0\uACE0 \uC788\uB124. \uC815\uB9D0 \uC88B\uB2E4.#$e#\uC6B0\uB9AC \uB0B4\uC77C \uBC24\uC5D0 \uCD95\uC81C \uAC08\uAE4C? \uC0AC\uC2E4 \uB0B4\uAC00 \uC880 \uC990\uAE30\uB294 \uC804\uD1B5 \uCD95\uC81C\uC57C.$7",
  "fall_1": "\uC628 \uACC4\uACE1\uC774 \uBC24\uC0AC\uC774 \uC804\uBD80 \uBC14\uB010 \uAC83 \uAC19\uC544... \uB4DC\uB514\uC5B4 \uAC00\uC744\uC774 \uC654\uB098 \uBCF4\uB124.",
  "fall_15": "\uC2A4\uD0C0\uB4C0 \uBC38\uB9AC \uD488\uD3C9\uD68C\uB294 \uC0AC\uB78C\uC774 \uB108\uBB34 \uBD90\uBCBC... \uADF8\uB798\uB3C4 \uC0D8 \uBCF4\uB7EC \uAC00\uC57C\uC9C0. \uC624\uB79C\uB9CC\uC5D0 \uBCF4\uBA74 \uC88B\uC744 \uAC70\uC57C.#$e#\uB10C \uADF8\uB798\uB3C4 \uCD95\uC81C \uC990\uAE30\uACE0! \uB0B4 \uAC71\uC815\uC740 \uC548\uD574\uB3C4 \uB3FC.$7",
  "fall_26": "\uB098 \uB0B4\uC77C \uC601\uB839\uC758 \uC804\uC57C\uC81C \uAE30\uB300\uD558\uACE0 \uC788\uC5B4. \uC5B4\uB5A4 \uACF5\uD3EC\uAC00 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC744\uC9C0 \uAD81\uAE08\uD558\uB124.$h",
  "winter_1": "\uC62C\uACA8\uC6B8 \uC5B4\uB5BB\uAC8C \uBCF4\uB0BC \uACC4\uD68D\uC774\uC57C? \uB18D\uC7A5\uC5D0\uC11C \uD574\uC57C \uD560 \uC77C\uC774 \uC880 \uB354 \uC801\uC740 \uACC4\uC808\uC774\uB780 \uAC74 \uC54C\uC544.",
  "winter_7": "\uB0B4\uC77C \uB09A\uC2DC \uB300\uD68C \uCC38\uAC00\uD560 \uAC70\uC57C?",
  "winter_28": "\uC815\uB9D0 \uC88B\uC740 \uD55C \uD574\uC600\uC5B4, @. \uC6B0\uB9AC \uCD95\uD558\uB3C4 \uC880 \uD558\uC790. [346]$h#$e#\uB0B4\uB144\uC740 \uBD84\uBA85 \uB354 \uC88B\uC744 \uAC70\uC57C.$7"
}