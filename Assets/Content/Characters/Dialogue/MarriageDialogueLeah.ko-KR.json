  "Bad_7": "\uB0B4\uAC00 \uC608\uC804\uC5D4 \uB2F9\uC2E0\uC758 \uC560\uC778\uC774\uC600\uB294\uB370... \uC774\uC820 \uB0B4\uAC00 \uC800\uB141 \uC694\uB9AC\uD560 \uB54C\uB9CC \uCC38\uACE0 \uACAC\uB514\uB294 \uAC83 \uAC19\uC544.$s",
  "Bad_8": "\uC694\uC998 \uB098\uD55C\uD14C \uB108\uBB34 \uCC28\uAC00\uC6CC...$s",
  "Bad_9": "\uB098\uD55C\uD14C \uB354 \uB098\uC740 \uC0B6\uC774 \uC788\uC5C8\uC744 \uC218\uB3C4 \uC788\uB294\uB370.$s",
  "spring_2": "\uADF8\uB798, \uC6B0\uB9AC \uC62C\uBD04\uC740 \uC5B4\uB5A4 \uAC70 \uC2EC\uC744\uAE4C?",
  "spring_1": "\uC815\uB9D0 \uBA4B\uC9C0\uAC8C \uC0C8\uD574\uB97C \uB9DE\uC774\uD588\uC9C0 \uC6B0\uB9AC...$l",
  "spring_15": "*\uD55C\uC228*... \u0027\uBD04\uB9DE\uC774 \uB300\uCCAD\uC18C\u0027 \uB610 \uD574\uC57C\uACA0\uB124.$s",
  "summer_1": "\uC544, \uC5EC\uB984\uC774\uB124... \uBC8C\uC368 \uBC31\uB7C9\uAE08 \uD5A5\uC774 \uB098\uB124.$h",
  "summer_9": "\uB098 \uC9C0\uAE08 \uC880 \uCD95\uCD95\uD574, \uBBF8\uC548... \uB354\uC6CC\uC11C \uC5B4\uC81C \uBC24\uC0C8 \uB540\uB0AC\uC5B4.",
  "summer_2": "\uC5EC\uB984\uC774\uB124... \uC9D1\uC548\uC5D0 \uD30C\uB9AC\uAC00 \uB108\uBB34 \uB9CE\uC544.#$e#\uAC71\uC815\uD558\uC9C0 \uB9C8, \uB0B4\uAC00 \uCC98\uB9AC\uD560\uAC8C.",
  "fall_1": "\uAC00\uC744\uC5D0 \uBC84\uC12F \uCC44\uC9D1\uD560 \uAE30\uD68C\uAC00 \uB9CE\uC544\uC11C \uC88B\uC544. \uAE08\uBC29 \uC654\uB2E4 \uAE08\uBC29 \uAC00\uB294 \uAE30\uD68C\uAE34 \uD558\uC9C0\uB9CC.",
  "fall_20": "\uACA8\uC6B8 \uCC44\uBE44\uB294 \uD588\uC5B4? \uAC74\uCD08\uB97C \uB9CE\uC774 \uBE44\uCD95\uD558\uBA74 \uC88B\uC9C0.",
  "fall_2": "\uC218\uD655\uCCA0\uC774\uB77C \uBC14\uC05C \uAC70 \uC54C\uC544. \uB098\uB3C4 \uCD5C\uB300\uD55C \uB9CE\uC774 \uB3C4\uC640\uC904 \uC218 \uC788\uB3C4\uB85D \uD560\uAC8C.",
  "winter_1": "\uACA8\uC6B8\uC774\uB124. \uC218\uC815 \uACFC\uC77C \uCCA0\uC774\uAD6C\uB098 \uC774\uC81C. \uB9DB\uC774 \uC815\uB9D0 \uB3C5\uD2B9\uD558\uC9C0, \uADF8\uCE58?",
  "winter_7": "\uB0B4\uC77C \uC5BC\uC74C\uC870\uAC01\uC0C1 \uB9CC\uB4E4 \uC77C\uC744 \uAE30\uB300\uD558\uACE0 \uC788\uC5B4. \uC77C \uB144\uC5D0 \uD55C \uBC88\uBC16\uC5D0 \uBABB\uD558\uC9C0\uB9CC, \uC815\uB9D0 \uC7AC\uBC0C\uC5B4!",
  "winter_28": "\uC790, %farm \uB18D\uC7A5\uC5D0\uC11C \uB610 \uBA4B\uC9C4 \uD55C \uD574\uB97C \uC704\uD558\uC5EC! \uC624\uB298 \uBC24\uC740 \uC7AC\uBC0C\uAC8C \uBCF4\uB0B4\uC790\uACE0! [348]$h#$e#\uB0B4\uB144\uB3C4 \uB300\uB2E8\uD560 \uAC70\uC57C, \uB290\uAEF4\uC838."
}