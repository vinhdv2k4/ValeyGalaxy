  "Resort_Shore": "\u0422\u0443\u0442 \u0442\u0430\u043A\u0430\u044F \u0442\u0435\u043F\u043B\u0430\u044F \u0432\u043E\u0434\u0430, \u043D\u0435 \u0442\u043E, \u0447\u0442\u043E \u0443 \u043D\u0430\u0441 \u0432 \u0414\u043E\u043B\u0438\u043D\u0435. \u042D\u0442\u043E \u0442\u0430\u043A \u043F\u0440\u0438\u044F\u0442\u043D\u043E!",
