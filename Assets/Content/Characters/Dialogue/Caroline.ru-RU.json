{
  "Introduction": "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435! \u0412\u044B, \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C, @, \u043D\u043E\u0432\u044B\u0439 \u0444\u0435\u0440\u043C\u0435\u0440. \u042F \u2014 \u041A\u044D\u0440\u043E\u043B\u0430\u0439\u043D.#$e#\u041C\u043E\u0439 \u043C\u0443\u0436 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442 \u043C\u0435\u0441\u0442\u043D\u044B\u0439 \u043C\u0430\u0433\u0430\u0437\u0438\u043D. \u0412\u044B \u0435\u0449\u0435 \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438 \u0441 \u043C\u043E\u0435\u0439 \u0434\u043E\u0447\u0435\u0440\u044C\u044E, \u0410\u0431\u0438\u0433\u0435\u0439\u043B? \u041E\u043D\u0430 \u0442\u0430\u043A\u0430\u044F \u0431\u043B\u0435\u0434\u043D\u0435\u043D\u044C\u043A\u0430\u044F, \u0441 \u0444\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u044B\u043C\u0438 \u0432\u043E\u043B\u043E\u0441\u0430\u043C\u0438.",
  "AcceptBirthdayGift_Positive": "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0434\u043E\u0440\u043E\u0433\u0443\u0448\u0430. \u041A\u0430\u043A \u043F\u0440\u0438\u044F\u0442\u043D\u043E, \u0447\u0442\u043E \u0442\u044B \u043F\u043E\u043C\u043D\u0438\u0448\u044C \u043F\u0440\u043E \u043C\u043E\u0439 \u0434\u0435\u043D\u044C \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F.$h",
  "AcceptBirthdayGift_Negative": "\u041E\u0439... \u042D\u0442\u043E \u0447\u0442\u043E... \u043F\u043E\u0434\u0430\u0440\u043E\u043A \u043D\u0430 \u0434\u0435\u043D\u044C \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F? \u042F\u0441\u043D\u043E... \u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0437\u0430 \u0432\u0438\u0437\u0438\u0442.$a",
  "AcceptGift_(O)StardropTea": "\u041E-\u043E-\u043E, \u044D\u0442\u043E \u0442\u0430\u043A \u043C\u0438\u043B\u043E. \u041F\u0440\u0438\u0431\u0435\u0440\u0435\u0433\u0443 \u0434\u043B\u044F \u0442\u0438\u0445\u043E\u0433\u043E \u0434\u043D\u044F \u043D\u0430 \u0442\u0435\u0440\u0440\u0430\u0441\u0435.",
  "AcceptGift_(O)16": "\u041E, \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\u043C \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0448\u044C\u0441\u044F! \u0421\u043F\u0430\u0441\u0438\u0431\u043E!#$b#\u0414\u043E\u0431\u0430\u0432\u043B\u044E \u0432 \u043E\u0441\u0442\u0440\u044B\u0439 \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044C\u043D\u044B\u0439 \u0441\u043E\u0443\u0441. \u0423 \u041F\u044C\u0435\u0440\u0430 \u043E\u0442 \u044D\u0442\u043E\u0433\u043E \u043F\u0440\u043E\u0431\u044C\u0435\u0442\u0441\u044F \u043F\u0430\u0440\u0443 \u0432\u043E\u043B\u043E\u0441\u043A\u043E\u0432 \u043D\u0430 \u0433\u0440\u0443\u0434\u0438.$h",
  "cropMatured_815": "\u0417\u0430\u043C\u0435\u0442\u0438\u043B\u0430, \u0442\u044B \u0447\u0430\u0439 \u0443 \u0441\u0435\u0431\u044F \u043D\u0430 \u0444\u0435\u0440\u043C\u0435 \u0432\u044B\u0440\u0430\u0449\u0438\u0432\u0430\u0435\u0448\u044C. \u041D\u0435 \u0437\u0430\u0431\u0443\u0434\u044C, \u043F\u0440\u0438\u043D\u0435\u0441\u0438 \u043C\u043D\u0435 \u043D\u0430 \u0447\u0430\u0448\u0435\u0447\u043A\u0443!$h",
  "dating_Abigail_memory_oneday": "\u042D\u0431\u0431\u0438 \u0441\u043A\u0430\u0437\u0430\u043B\u0430 \u043C\u043D\u0435, \u0447\u0442\u043E \u0432\u044B \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442\u0435\u0441\u044C. \u041A\u0430\u043A \u0441\u043B\u0430\u0432\u043D\u043E!",
  "GreenRain": "\u0412 \u0436\u0438\u0437\u043D\u0438 \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0430 \u0437\u0435\u043B\u0435\u043D\u044B\u0439 \u0434\u043E\u0436\u0434\u044C... \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u043E\u043D \u043D\u0435 \u0442\u0430\u043A\u043E\u0439 \u0443\u0436 \u0438 \u043E\u043F\u0430\u0441\u043D\u044B\u0439, \u0440\u0430\u0437 \u0442\u044B \u0437\u0434\u0435\u0441\u044C!",
  "GreenRain_2": "\u0410, \u043E\u0441\u043E\u0431\u044B\u0439 \u0434\u043E\u0436\u0434\u044C \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F, \u0432 \u044D\u0442\u043E\u043C \u0433\u043E\u0434\u0443 \u044F \u043D\u0430\u0441\u043B\u0430\u0436\u0443\u0441\u044C \u0438\u043C \u043F\u043E \u043F\u043E\u043B\u043D\u043E\u0439!#$e#\u0412\u0440\u0435\u043C\u044F \u0437\u0430\u0432\u0430\u0440\u0438\u0442\u044C \u0447\u0430\u0448\u0435\u0447\u043A\u0443 \u0437\u0435\u043B\u0435\u043D\u043E\u0433\u043E \u0447\u0430\u044F!$h",
  "movieTheater_memory_oneweek": "\u0425\u043E\u0440\u043E\u0448\u043E, \u0447\u0442\u043E \u0443 \u043D\u0430\u0441 \u0442\u0435\u043F\u0435\u0440\u044C \u0435\u0441\u0442\u044C \u043A\u0438\u043D\u043E\u0442\u0435\u0430\u0442\u0440. \u0425\u043E\u0447\u0443 \u0441\u0445\u043E\u0434\u0438\u0442\u044C \u043D\u0430 \u0432\u0435\u0441\u0442\u0435\u0440\u043D!",
  "married_Abigail": "\u042F \u0442\u0430\u043A \u0440\u0430\u0434\u0430 \u0437\u0430 \u0432\u0430\u0441 \u043E\u0431\u043E\u0438\u0445. \u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C \u0432 \u0441\u0435\u043C\u044C\u044E!$h",
  "wonGrange": "\u041F\u044C\u0435\u0440, \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u0432\u0438\u0434\u0443 \u043D\u0435 \u043F\u043E\u0434\u0430\u0435\u0442, \u043D\u043E \u043E\u043D \u043A\u0440\u0430\u0439\u043D\u0435 \u0440\u0430\u0437\u0434\u043E\u0441\u0430\u0434\u043E\u0432\u0430\u043D, \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0433\u0440\u0430\u043B \u0442\u0435\u0431\u0435 \u043D\u0430 \u042F\u0440\u043C\u0430\u0440\u043A\u0435 \u0414\u043E\u043B\u0438\u043D\u044B \u0421\u0442\u0430\u0440\u0434\u044C\u044E.",
  "married_memory_oneweek": "\u0410, \u043C\u043E\u043B\u043E\u0434\u043E\u0436\u0435\u043D\u044B. \u041D\u0443 \u0438 \u043A\u0430\u043A \u043F\u0440\u043E\u0448\u0435\u043B \u043C\u0435\u0434\u043E\u0432\u044B\u0439 \u043C\u0435\u0441\u044F\u0446?#$e#\u042F\u0441\u043D\u043E. \u0421\u0434\u0430\u0435\u0442\u0441\u044F \u043C\u043D\u0435, \u0447\u0442\u043E \u043D\u0430 \u0444\u0435\u0440\u043C\u0435 \u0432\u0441\u0435 \u0437\u0430\u0432\u044F\u043B\u043E, \u0440\u0430\u0437 \u0432\u0430\u0441 \u0442\u0430\u043C \u043D\u0435 \u0431\u044B\u043B\u043E...",
  "eventSeen_719926": "\u041D\u0443 \u043A\u0430\u043A, \u043F\u0440\u0430\u0432\u0434\u0430 \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u043B\u044F\u0435\u0442? \u0415\u0449\u0435 \u0431\u044B...",
  "houseUpgrade_1": "$y \u0027\u0421\u043B\u044B\u0448\u0430\u043B\u0430, \u0443 \u0442\u0435\u0431\u044F \u043D\u043E\u0432\u0430\u044F \u043A\u0443\u0445\u043D\u044F! \u0414\u0443\u043C\u0430\u0435\u0448\u044C, \u0442\u0435\u043F\u0435\u0440\u044C \u0431\u0443\u0434\u0435\u0448\u044C \u043C\u043D\u043E\u0433\u043E \u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C?_\u041F\u043B\u0430\u043D\u0438\u0440\u0443\u044E!_\u042D\u0442\u043E \u043A\u0440\u0430\u0439\u043D\u0435 \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0439 \u043D\u0430\u0432\u044B\u043A. \u0423 \u0442\u0435\u0431\u044F \u043D\u0430 \u0444\u0435\u0440\u043C\u0435 \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0432\u0441\u0435\u0433\u043E \u0441\u0432\u0435\u0436\u0435\u0433\u043E \u0440\u0430\u0441\u0442\u0435\u0442 \u2014 \u0431\u043B\u044E\u0434\u0430 \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u0441\u044F \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0435!_\u041D\u0435, \u044D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0434\u043B\u044F \u043A\u0440\u0430\u0441\u043E\u0442\u044B._\u042F\u0441\u043D\u043E. \u0427\u0442\u043E \u0436, \u043D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439 \u0445\u043E\u0442\u044F \u0431\u044B \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u043F\u0438\u0442\u0430\u0442\u044C\u0441\u044F... \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u0443 \u043D\u0443\u0436\u043D\u0430 \u043F\u043E\u043B\u0435\u0437\u043D\u0430\u044F \u043F\u0438\u0449\u0430.\u0027",
  "achievement_15": "\u0412\u0435\u0442\u0435\u0440 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442 \u0441 \u0444\u0435\u0440\u043C\u044B \u0442\u0430\u043A\u0438\u0435 \u043F\u0440\u0438\u044F\u0442\u043D\u044B\u0435 \u0430\u0440\u043E\u043C\u0430\u0442\u044B, \u0441\u0434\u0430\u0435\u0442\u0441\u044F \u043C\u043D\u0435, \u0442\u044B \u0433\u043E\u0442\u043E\u0432\u0438\u0448\u044C \u0447\u0442\u043E-\u0442\u043E \u043E\u0447\u0435\u043D\u044C \u0432\u043A\u0443\u0441\u043D\u043E\u0435!$h",
  "Resort_Entering": "\u0412\u0438\u043B\u043B\u0438 \u0440\u0430\u0437\u0434\u0430\u043B \u043D\u0430\u043C \u0432\u0441\u0435\u043C \u043F\u043E \u043A\u0443\u0441\u043E\u0447\u043A\u0443 \u0435\u0433\u043E \u0432\u044F\u043B\u0435\u043D\u043E\u0439 \u0440\u044B\u0431\u044B. \u042F \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u0435\u0433\u043E \u0436\u0443\u044E.",
