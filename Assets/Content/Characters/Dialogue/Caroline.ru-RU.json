  "Resort": "\u041F\u0440\u0438\u0432\u0435\u0442, @. \u0422\u044B \u0442\u0443\u0442 \u043D\u0430 \u043E\u0442\u0434\u044B\u0445\u0435 \u0438\u043B\u0438 \u043F\u043E \u0440\u0430\u0431\u043E\u0442\u0435?",
  "Mon": "\u0412\u043E\u0442 \u0431\u044B \u042D\u0431\u0431\u0438 \u043D\u0435 \u0441\u0438\u0434\u0435\u043B\u0430 \u0442\u0430\u043A \u043C\u043D\u043E\u0433\u043E \u0443 \u0441\u0435\u0431\u044F \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435.",
  "Mon_inlaw_Abigail": "\u041F\u0440\u0438\u0432\u0435\u0442, @. \u041D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u0442\u0435\u0431\u0435 \u0436\u0438\u0437\u043D\u044C \u0432 \u0431\u0440\u0430\u043A\u0435? \u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0447\u0442\u043E \u0434\u0430!",
  "Mon8": "#$1 Caroline23#\u041A\u043E\u0433\u0434\u0430 \u043C\u044B \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u043B\u0438 \u0432 \u0433\u043E\u0440\u043E\u0434 \u041F\u0435\u043B\u0438\u043A\u0430\u043D, \u044F \u0442\u0430\u0439\u043A\u043E\u043C \u0445\u043E\u0434\u0438\u043B\u0430 \u0432 \u0431\u0430\u0448\u043D\u044E \u043A \u0432\u043E\u043B\u0448\u0435\u0431\u043D\u0438\u043A\u0443. \u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438 \u041F\u044C\u0435\u0440\u0443, \u0443 \u043D\u0435\u0433\u043E \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B \u0441 \u0440\u0435\u0432\u043D\u043E\u0441\u0442\u044C\u044E.#$e#\u0410\u0431\u0438\u0433\u0435\u0439\u043B \u0440\u043E\u0434\u0438\u043B\u0430\u0441\u044C \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E \u0447\u0435\u0440\u0435\u0437 \u0433\u043E\u0434 \u043F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u043C\u044B \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u043B\u0438 \u0432 \u044D\u0442\u043E\u0442 \u0433\u043E\u0440\u043E\u0434. \u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u0431\u0443\u0434\u0435\u0442 \u043B\u0438 \u043E\u043D\u0430 \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u0436\u0438\u0442\u044C \u0433\u0434\u0435-\u043D\u0438\u0431\u0443\u0434\u044C \u0432\u043D\u0435 \u0434\u043E\u043B\u0438\u043D\u044B?",
  "Tue": "\u042F \u0432\u0438\u0434\u0435\u043B\u0430 \u0432 \u043B\u0435\u0441\u0443 \u0434\u0438\u043A\u0438\u0439 \u0445\u0440\u0435\u043D.#$e#\u0421\u043E\u0431\u0438\u0440\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E \u2014 \u044D\u0442\u043E \u0443\u0432\u043B\u0435\u043A\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0441\u043F\u043E\u0441\u043E\u0431 \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C. \u0410 \u0435\u0449\u0435 \u0442\u043E, \u0447\u0442\u043E \u0442\u044B \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0448\u044C, \u043C\u043E\u0436\u043D\u043E \u0434\u0430\u0440\u0438\u0442\u044C \u0438\u043B\u0438 \u0435\u0441\u0442\u044C.",
  "Wed": "\u041F\u0440\u0438\u0432\u0435\u0442. \u0423 \u0442\u0435\u0431\u044F \u0432\u0441\u0435 \u043D\u0443\u0436\u043D\u043E\u0435 \u0435\u0441\u0442\u044C \u043D\u0430 \u0444\u0435\u0440\u043C\u0435?#$e#\u0415\u0441\u043B\u0438 \u043D\u0435\u0442, \u0442\u043E \u043C\u044B \u043C\u043E\u0436\u0435\u043C \u043F\u043E\u043C\u043E\u0447\u044C.#$e#\u041C\u044B \u043F\u0440\u043E\u0434\u0430\u0435\u043C \u0440\u0430\u0437\u043D\u044B\u0435 \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0435 \u0432\u0435\u0449\u0438.",
  "Thu": "#$1 Caroline1#\u0425\u043C-\u043C-\u043C... \u041C\u043E\u0436\u0435\u0442, \u0443\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u041F\u044C\u0435\u0440\u0430 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0443\u0436\u0438\u043D.#$e#\u0425\u043C-\u043C-\u043C... \u0427\u0442\u043E \u0431\u044B \u0442\u0430\u043A\u043E\u0433\u043E \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0430 \u0443\u0436\u0438\u043D?#$e#\u041C\u043E\u0436\u0435\u0442, \u043F\u0440\u043E\u0441\u0442\u043E \u0432\u043E\u0437\u044C\u043C\u0443 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043D\u0430 \u0432\u044B\u043D\u043E\u0441 \u0432 \u0441\u0430\u043B\u0443\u043D\u0435.",
  "Fri": "\u0425\u043E\u0440\u043E\u0448\u0438\u0439 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0434\u0435\u043D\u0435\u043A.#$e#\u0412 \u0442\u0430\u043A\u0438\u0435 \u0434\u043D\u0438 \u044F \u043B\u044E\u0431\u043B\u044E \u043F\u043E\u043C\u043E\u0433\u0430\u0442\u044C \u042D\u0432\u0435\u043B\u0438\u043D \u0432 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u043C \u0441\u0430\u0434\u0443.#$e#\u041E\u043D\u0430 \u043A\u0440\u0435\u043F\u043A\u0430\u044F \u0434\u043B\u044F \u0441\u0432\u043E\u0435\u0433\u043E \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0430, \u043D\u043E \u043C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0447\u0442\u043E \u043E\u043D\u0430 \u0446\u0435\u043D\u0438\u0442 \u043B\u044E\u0431\u0443\u044E \u043F\u043E\u043C\u043E\u0449\u044C.",
  "Sat": "\u041C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0438\u043B\u0438 \u0443 \u0410\u0431\u0438\u0433\u0435\u0439\u043B \u043A\u0430\u043A\u0430\u044F-\u0442\u043E \u043D\u0435\u0437\u0434\u043E\u0440\u043E\u0432\u0430\u044F \u0442\u044F\u0433\u0430 \u043A\u043E \u0432\u0441\u0435\u043C\u0443 \u043C\u0440\u0430\u0447\u043D\u043E\u043C\u0443 \u0438 \u0431\u0435\u0437\u044B\u0441\u0445\u043E\u0434\u043D\u043E\u043C\u0443?#$e#\u041C\u043E\u0436\u0435\u0442, \u044F \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0441\u0442\u0430\u0440\u0430, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043D\u044F\u0442\u044C \u0442\u0430\u043A\u043E\u0435.",
  "Sat_inlaw_Abigail": "\u0421 \u0442\u0435\u0445 \u043F\u043E\u0440, \u043A\u0430\u043A \u0410\u0431\u0438\u0433\u0435\u0439\u043B \u0441\u044A\u0435\u0445\u0430\u043B\u0430 \u043E\u0442 \u043D\u0430\u0441, \u0443\u0436\u0438\u043D \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u0442\u0438\u0448\u0435.#$e#\u041D\u0435\u0442, \u0432\u043E\u0432\u0441\u0435 \u043D\u0435 \u043F\u043E\u0442\u043E\u043C\u0443, \u0447\u0442\u043E \u043E\u043D\u0430 \u0436\u0435\u0432\u0430\u043B\u0430 \u0441 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C \u0440\u0442\u043E\u043C!$h",
  "Sat2": "\u0423 \u042D\u0431\u0431\u0438 \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044B\u043B \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0439 \u0438\u043D\u0442\u0435\u0440\u0435\u0441 \u043A\u043E \u0432\u0441\u0435\u043C\u0443 \u043E\u043A\u043A\u0443\u043B\u044C\u0442\u043D\u043E\u043C\u0443. \u041D\u0435 \u0437\u043D\u0430\u044E, \u043E\u0442 \u043A\u043E\u0433\u043E \u044D\u0442\u043E \u0443 \u043D\u0435\u0435...",
  "Sat4": "\u0423 \u042D\u0431\u0431\u0438 \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044B\u043B \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0439 \u0438\u043D\u0442\u0435\u0440\u0435\u0441 \u043A\u043E \u0432\u0441\u0435\u043C\u0443 \u043E\u043A\u043A\u0443\u043B\u044C\u0442\u043D\u043E\u043C\u0443. \u0423\u0432\u0435\u0440\u0435\u043D\u0430, \u044D\u0442\u043E \u0443 \u043D\u0435\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0435\u0440\u0438\u043E\u0434 \u0442\u0430\u043A\u043E\u0439...",
  "Sat6": "#$1 Caroline12#\u041A\u043E\u0433\u0434\u0430 \u043C\u044B \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u044E\u0434\u0430 \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u043B\u0438, \u044F \u0434\u043E\u043B\u0433\u043E \u043E\u0441\u0432\u0430\u0438\u0432\u0430\u043B\u0430\u0441\u044C... \u042F \u043D\u0435 \u0431\u044B\u043B\u0430 \u0433\u043E\u0442\u043E\u0432\u0430 \u043A \u0434\u043E\u043C\u0430\u0448\u043D\u0435\u0439 \u0436\u0438\u0437\u043D\u0438.#$e#\u041F\u044C\u0435\u0440 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043A\u043E\u043D\u0441\u0435\u0440\u0432\u0430\u0442\u0438\u0432\u0435\u043D \u0432 \u0441\u0432\u043E\u0438\u0445 \u0432\u0437\u0433\u043B\u044F\u0434\u0430\u0445... \u041D\u043E \u043E\u043D \u0445\u043E\u0440\u043E\u0448\u0438\u0439. \u0423 \u043D\u0435\u0433\u043E \u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u0430\u043C\u0431\u0438\u0446\u0438\u0438, \u043D\u043E \u0441\u0435\u043C\u044C\u044F \u0434\u043B\u044F \u043D\u0435\u0433\u043E \u043F\u0440\u0435\u0432\u044B\u0448\u0435 \u0432\u0441\u0435\u0433\u043E",
  "Sun": "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u0431\u0443\u0434\u0443 \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u043B\u044F\u0442\u044C\u0441\u044F \u0438 \u043C\u044B\u0441\u043B\u0438\u0442\u044C \u043F\u043E\u0437\u0438\u0442\u0438\u0432\u043D\u043E.#$e#\u0422\u044B \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0448\u044C \u0441\u0435\u0431\u0435 \u0432\u044B\u0445\u043E\u0434\u043D\u044B\u0435?",
  "Wed6": "\u0414\u043E\u043B\u0438\u043D\u0430 \u0421\u0442\u0430\u0440\u0434\u044C\u044E \u2014 \u0441\u043B\u0430\u0432\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E, \u043D\u043E \u044F \u0445\u043E\u0442\u0435\u043B\u0430 \u0431\u044B \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u044C\u0441\u044F \u0441 \u043D\u043E\u0432\u044B\u043C\u0438 \u043B\u044E\u0434\u044C\u043C\u0438.#$e#\u042F \u0440\u0430\u0434\u0430, \u0447\u0442\u043E \u043C\u044B \u043F\u043E\u0434\u0440\u0443\u0436\u0438\u043B\u0438\u0441\u044C.",
  "summer_Mon": "\u041F\u043E \u0441\u0440\u0435\u0434\u0430\u043C \u043D\u0430\u0448 \u043C\u0430\u0433\u0430\u0437\u0438\u043D \u0437\u0430\u043A\u0440\u044B\u0442.#$e#\u0418\u043C\u0435\u0439 \u044D\u0442\u043E \u0432 \u0432\u0438\u0434\u0443, \u0435\u0441\u043B\u0438 \u0442\u0435\u0431\u0435 \u0447\u0442\u043E-\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \u043D\u0443\u0436\u043D\u043E.",
  "summer_Tue": "\u0412 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0432\u0440\u0435\u043C\u044F \u044F \u0432\u0438\u0436\u0443 \u0432 \u043B\u0435\u0441\u0443 \u043C\u043D\u043E\u0433\u043E \u0434\u0438\u043A\u0438\u0445 \u043F\u043B\u043E\u0434\u043E\u0432.#$e#\u0421\u043E\u0431\u0438\u0440\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E \u2014 \u044D\u0442\u043E \u0443\u0432\u043B\u0435\u043A\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0441\u043F\u043E\u0441\u043E\u0431 \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C. \u0410 \u0435\u0449\u0435 \u0442\u043E, \u0447\u0442\u043E \u0442\u044B \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0448\u044C, \u043C\u043E\u0436\u043D\u043E \u0434\u0430\u0440\u0438\u0442\u044C \u0438\u043B\u0438 \u0435\u0441\u0442\u044C.",
  "summer_Wed": "\u041F\u0440\u0438\u0432\u0435\u0442. \u0423 \u0442\u0435\u0431\u044F \u0432\u0441\u0435 \u043D\u0443\u0436\u043D\u043E\u0435 \u0435\u0441\u0442\u044C \u043D\u0430 \u0444\u0435\u0440\u043C\u0435?#$e#\u0415\u0441\u043B\u0438 \u043D\u0435\u0442, \u0442\u043E \u043C\u044B \u043C\u043E\u0436\u0435\u043C \u043F\u043E\u043C\u043E\u0447\u044C.#$e#\u041C\u044B \u043F\u0440\u043E\u0434\u0430\u0435\u043C \u0440\u0430\u0437\u043D\u044B\u0435 \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0435 \u0432\u0435\u0449\u0438.",
  "summer_Sat": "\u041C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0438\u043B\u0438 \u0410\u0431\u0438\u0433\u0435\u0439\u043B \u0431\u043B\u0435\u0434\u043D\u043E\u0432\u0430\u0442\u0430?#$e#\u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u044F \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E \u0437\u0430 \u043D\u0435\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u044E.",
  "summer_Sat_inlaw_Abigail": "\u041A\u0430\u043A \u0442\u0430\u043C \u0443 \u0410\u0431\u0438\u0433\u0435\u0439\u043B \u0441\u043E \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435\u043C? \u041E\u043D\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044B\u043B\u0430 \u0431\u043B\u0435\u0434\u043D\u043E\u0439 \u0434\u0435\u0432\u043E\u0447\u043A\u043E\u0439. \u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u043E\u043D\u0430 \u0441\u0442\u0430\u043D\u0435\u0442 \u0445\u043E\u0442\u044C \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0440\u0443\u043C\u044F\u043D\u0435\u0435 \u043E\u0442 \u0436\u0438\u0437\u043D\u0438 \u043D\u0430 \u0444\u0435\u0440\u043C\u0435.",
  "summer_Sun": "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u0431\u0443\u0434\u0443 \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u043B\u044F\u0442\u044C\u0441\u044F \u0438 \u0434\u0443\u043C\u0430\u0442\u044C \u043F\u043E\u0437\u0438\u0442\u0438\u0432\u043D\u043E.#$e#\u0422\u044B \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0448\u044C \u0441\u0435\u0431\u0435 \u0432\u044B\u0445\u043E\u0434\u043D\u044B\u0435?",
  "summer_Wed6": "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u0447\u0442\u043E \u0447\u0435\u043C \u0442\u044B \u0441\u0442\u0430\u0440\u0448\u0435, \u0442\u0435\u043C \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u043B\u0435\u0442\u0438\u0442 \u0432\u0440\u0435\u043C\u044F...$s",
  "fall_Mon": "\u041E\u0441\u0435\u043D\u044C \u2014 \u043B\u044E\u0431\u0438\u043C\u043E\u0435 \u0432\u0440\u0435\u043C\u044F \u0433\u043E\u0434\u0430 \u042D\u0431\u0431\u0438, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u044F \u043D\u0430\u0434\u0435\u044E\u0441\u044C, \u0447\u0442\u043E \u043E\u043D\u0430 \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u0447\u0430\u0449\u0435 \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u044C \u0438\u0437 \u043A\u043E\u043C\u043D\u0430\u0442\u044B.",
  "fall_Mon_inlaw_Abigail": "\u042D\u0431\u0431\u0438 \u0442\u0443\u0442 \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0430\u0441\u044C \u043E\u043D\u043B\u0430\u0439\u043D-\u043A\u0443\u0440\u0441\u0430\u043C\u0438, \u043D\u043E \u044F \u043D\u0435 \u0434\u0443\u043C\u0430\u044E, \u0447\u0442\u043E \u043E\u043D\u0430 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u044D\u0442\u043E\u0433\u043E \u0445\u043E\u0442\u0435\u043B\u0430...#$e#\u041E\u043D\u0430 \u2014 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0430\u044F \u0434\u0443\u0448\u0430, \u043F\u0440\u044F\u043C\u043E \u043A\u0430\u043A \u044F \u0434\u043E \u0432\u0441\u0442\u0440\u0435\u0447\u0438 \u0441 \u041F\u044C\u0435\u0440\u043E\u043C. \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u0435\u0439 \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0430 \u0442\u0432\u043E\u0435\u0439 \u0444\u0435\u0440\u043C\u0435 \u0436\u0438\u0432\u0435\u0442\u0441\u044F \u043B\u0443\u0447\u0448\u0435 \u0432\u0441\u0435\u0433\u043E.",
  "fall_Tue": "\u042F \u0432\u0438\u0434\u0435\u043B\u0430 \u0432 \u043B\u0435\u0441\u0443 \u0441\u044A\u0435\u0434\u043E\u0431\u043D\u044B\u0435 \u0433\u0440\u0438\u0431\u044B.#$e#\u0421\u043E\u0431\u0438\u0440\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E \u2014 \u044D\u0442\u043E \u0443\u0432\u043B\u0435\u043A\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0441\u043F\u043E\u0441\u043E\u0431 \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C. \u0410 \u0435\u0449\u0435 \u0442\u043E, \u0447\u0442\u043E \u0442\u044B \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0448\u044C, \u043C\u043E\u0436\u043D\u043E \u0434\u0430\u0440\u0438\u0442\u044C \u0438\u043B\u0438 \u0435\u0441\u0442\u044C.",
  "fall_Sat": "\u041C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0438\u043B\u0438 \u0410\u0431\u0438\u0433\u0435\u0439\u043B \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E \u0438\u0433\u0440\u0430\u0435\u0442 \u0432 \u0432\u0438\u0434\u0435\u043E\u0438\u0433\u0440\u044B?#$e#\u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u044F \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0441\u0442\u0430\u0440\u043E\u043C\u043E\u0434\u043D\u0430.",
  "fall_Wed6": "\u0417\u043D\u0430\u0435\u0448\u044C, \u044F \u043A\u043E\u0433\u0434\u0430-\u0442\u043E \u0441\u0430\u043C\u0430 \u0445\u043E\u0442\u0435\u043B\u0430 \u0441\u0442\u0430\u0442\u044C \u0444\u0435\u0440\u043C\u0435\u0440\u043E\u043C. \u0422\u043E\u0447\u043D\u0435\u0435, \u0445\u043E\u0437\u044F\u0439\u043A\u043E\u0439 \u0440\u0430\u043D\u0447\u043E.#$e#\u042F \u0432\u0441\u0435\u0433\u0434\u0430 \u043B\u044E\u0431\u0438\u043B\u0430 \u0432\u0435\u0441\u0442\u0435\u0440\u043D\u044B, \u043A\u043E\u0433\u0434\u0430 \u0431\u044B\u043B\u0430 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0439.",
  "winter_Tue": "\u0417\u0438\u043C\u043E\u0439 \u0431\u044B\u0432\u0430\u0435\u0442 \u043D\u0435\u043B\u0435\u0433\u043A\u043E, \u043D\u043E \u0435\u0441\u043B\u0438 \u0442\u0435\u0431\u0435 \u043F\u043E\u0432\u0435\u0437\u0435\u0442, \u043C\u043E\u0436\u0435\u0448\u044C \u043D\u0430\u043A\u043E\u043F\u0430\u0442\u044C \u043A\u043E\u0440\u0435\u043D\u044C\u0435\u0432.#$e#\u0421\u043E\u0431\u0438\u0440\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E \u2014 \u044D\u0442\u043E \u0443\u0432\u043B\u0435\u043A\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0441\u043F\u043E\u0441\u043E\u0431 \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C. \u0410 \u0435\u0449\u0435 \u0442\u043E, \u0447\u0442\u043E \u0442\u044B \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0448\u044C, \u043C\u043E\u0436\u043D\u043E \u0434\u0430\u0440\u0438\u0442\u044C \u0438\u043B\u0438 \u0435\u0441\u0442\u044C.",
  "winter_Fri": "\u041F\u0443\u0441\u043A\u0430\u0439 \u0441\u0435\u0439\u0447\u0430\u0441 \u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u043E, \u044F \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E \u0438\u043D\u043E\u0433\u0434\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044E \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u0435 \u043A\u043B\u0443\u043C\u0431\u044B.#$e#\u041F\u0440\u043E\u0441\u0442\u043E \u0445\u043E\u0447\u0443 \u0443\u0431\u0435\u0434\u0438\u0442\u044C\u0441\u044F, \u0447\u0442\u043E \u043E\u043D\u0438 \u043D\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u044B \u043F\u0435\u0440\u0435\u0434 \u0432\u0435\u0441\u043D\u043E\u0439.",
  "winter_Sat": "\u0422\u0435\u0431\u0435 \u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0447\u0442\u043E \u042D\u0431\u0431\u0438 \u0431\u043E\u043B\u044C\u0448\u0435 \u0438\u0434\u0435\u0442 \u0435\u0435 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439 \u0446\u0432\u0435\u0442 \u0432\u043E\u043B\u043E\u0441?#$e#\u0420\u0430\u043D\u044C\u0448\u0435 \u0443 \u043D\u0435\u0435 \u0431\u044B\u043B\u0438 \u0441\u0432\u0435\u0442\u043B\u043E-\u043A\u0430\u0448\u0442\u0430\u043D\u043E\u0432\u044B\u0435 \u0432\u043E\u043B\u043E\u0441\u044B.",
  "winter_Wed6": "\u0422\u044B \u0440\u0430\u0434\u0443\u0435\u0448\u044C\u0441\u044F \u043D\u0430\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u044E \u043D\u043E\u0432\u043E\u0433\u043E \u0433\u043E\u0434\u0430?#$e#\u041F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u044E \u0442\u0435\u0431\u0435 \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0439 \u0443\u0441\u043F\u0435\u0445 \u043D\u0430 \u0444\u0435\u0440\u043C\u0435.$h"
}