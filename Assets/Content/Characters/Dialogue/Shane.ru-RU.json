  "Mon2": "\u042F \u0442\u0435\u0431\u044F \u043F\u043E\u0447\u0442\u0438 \u043D\u0435 \u0437\u043D\u0430\u044E. \u0417\u0430\u0447\u0435\u043C \u0442\u044B \u043A\u043E \u043C\u043D\u0435 \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0448\u044C\u0441\u044F?||\u0417\u0430\u0447\u0435\u043C \u0432\u043E\u043E\u0431\u0449\u0435 \u0441\u043E \u043C\u043D\u043E\u0439 \u0440\u0430\u0437\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044C? \u041C\u043D\u0435 \u0434\u0440\u0443\u0437\u044C\u044F \u043D\u0435 \u043D\u0443\u0436\u043D\u044B.",
  "Mon4": "\u041F\u0440\u0438\u0432\u0435\u0442. \u041F\u0440\u043E\u0441\u0442\u0438, \u0435\u0441\u043B\u0438 \u0432 \u043D\u0430\u0448\u0443 \u043F\u0435\u0440\u0432\u0443\u044E \u0432\u0441\u0442\u0440\u0435\u0447\u0443 \u044F \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u0433\u0440\u0443\u0431\u044B\u043C.#$e#\u042F \u0434\u043E\u043B\u0433\u043E \u043F\u0440\u0438\u0432\u044B\u043A\u0430\u044E \u043A \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u0446\u0430\u043C.||\u041C\u043D\u0435 \u0441\u043B\u043E\u0436\u043D\u043E \u043D\u0430\u0447\u0438\u043D\u0430\u0442\u044C \u0441 \u043A\u0435\u043C-\u0442\u043E \u0434\u0440\u0443\u0436\u0438\u0442\u044C. \u041B\u0435\u0433\u0447\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F \u043E\u0434\u043D\u043E\u043C\u0443.",
  "Mon6": "\u0421\u043A\u0430\u0436\u0443 \u0447\u0435\u0441\u0442\u043D\u043E, \u044F \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u0442\u0430\u043A \u0438 \u043D\u0435 \u043F\u043E\u043D\u044F\u043B, \u043F\u043E\u0447\u0435\u043C\u0443 \u0442\u044B \u0445\u043E\u0447\u0435\u0448\u044C \u0441\u043E \u043C\u043D\u043E\u0439 \u0434\u0440\u0443\u0436\u0438\u0442\u044C.||\u0416\u0438\u0437\u043D\u044C \u2014 \u0448\u0442\u0443\u043A\u0430 \u043D\u0435\u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u0430\u044F, \u0430 \u044F \u0442\u043E\u043B\u044C\u043A\u043E \u0438 \u043C\u043E\u0433\u0443, \u0447\u0442\u043E \u043E\u0431 \u044D\u0442\u043E\u043C \u044F\u0437\u0432\u0438\u0442\u044C.",
  "Mon10": "\u0422\u044B \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044C, \u0431\u0443\u0434\u0442\u043E \u0432\u0435\u0441\u044C \u043C\u0438\u0440 \u0442\u0435\u0431\u044F \u043F\u0440\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u043E \u0438\u0437\u0443\u0447\u0430\u0435\u0442, \u0431\u0443\u0434\u0442\u043E \u043C\u0435\u0440\u0437\u043A\u043E\u0435 \u043D\u0430\u0441\u0435\u043A\u043E\u043C\u043E\u0435?",
  "Tue": "\u0427\u0442\u043E? \u0427\u0435\u0433\u043E \u0442\u0435\u0431\u0435? \u0423\u0439\u0434\u0438.",
  "Tue2": "\u0427\u0435\u0433\u043E \u0442\u0435\u0431\u0435 \u043E\u0442 \u043C\u0435\u043D\u044F \u043D\u0430\u0434\u043E? \u0414\u0435\u043D\u0435\u0433? \u042F \u0442\u0435\u0431\u0435 \u0446\u0435\u043B\u044B\u0439 \u0433\u043E\u0440\u0448\u043E\u043A \u0437\u043E\u043B\u043E\u0442\u0430 \u043E\u0442\u0434\u0430\u043C, \u0435\u0441\u043B\u0438 \u0442\u044B \u043E\u0442 \u043C\u0435\u043D\u044F \u043E\u0442\u0441\u0442\u0430\u043D\u0435\u0448\u044C!",
  "Tue4": "\u041A\u0430\u0436\u0434\u044B\u0439 \u0440\u0430\u0437, \u043A\u0430\u043A \u044F \u043F\u044B\u0442\u0430\u044E\u0441\u044C \u0437\u0430\u043D\u044F\u0442\u044C\u0441\u044F \u0447\u0435\u043C-\u0442\u043E \u043D\u043E\u0432\u044B\u043C, \u0432\u0441\u0435 \u0438\u0434\u0435\u0442 \u043D\u0430\u043F\u0435\u0440\u0435\u043A\u043E\u0441\u044F\u043A. \u0412 \u0438\u0442\u043E\u0433\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C, \u0447\u0442\u043E \u043B\u0443\u0447\u0448\u0435 \u043D\u0435 \u0432\u044B\u043B\u0430\u0437\u0438\u0442\u044C \u0438\u0437 \u0441\u0432\u043E\u0435\u0439 \u0441\u043A\u043E\u0440\u043B\u0443\u043F\u044B.",
  "Tue6": "\u0416\u0438\u0437\u043D\u044C \u043D\u0435 \u0442\u0430\u043A \u0443\u0436 \u0438 \u043F\u043B\u043E\u0445\u0430... \u041F\u043E \u043A\u0440\u0430\u0439\u043D\u0435\u0439 \u043C\u0435\u0440\u0435, \u0443 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u044F\u0439\u0446\u0430 \u0438 \u0437\u0430\u043C\u043E\u0440\u043E\u0436\u0435\u043D\u043D\u0430\u044F \u043F\u0438\u0446\u0446\u0430.$u",
  "Tue8": "\u041D\u0430\u043C \u043D\u0443\u0436\u043D\u043E \u0432\u043C\u0435\u0441\u0442\u0435 \u043D\u0430 \u043C\u0430\u0442\u0447 \u00AB\u0422\u0443\u043D\u0435\u043B\u043B\u0435\u0440\u043E\u0432\u00BB \u0441\u0445\u043E\u0434\u0438\u0442\u044C. \u041A\u043E\u0433\u0434\u0430 \u044F \u0445\u043E\u0436\u0443 \u043E\u0434\u0438\u043D, \u0442\u043E \u043F\u044C\u044E \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E \u043F\u0438\u0432\u0430.",
  "Tue10": "\u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0441\u0435\u0431\u044F \u0432 \u0440\u0443\u043A\u0430\u0445 \u0440\u0430\u0434\u0438 \u0414\u0436\u0430\u0441. \u042F \u043D\u0435 \u0445\u043E\u0447\u0443 \u0431\u044B\u0442\u044C \u0434\u043B\u044F \u043D\u0435\u0435 \u043F\u043B\u043E\u0445\u0438\u043C \u043F\u0440\u0438\u043C\u0435\u0440\u043E\u043C.||\u042F \u0434\u043B\u044F \u0414\u0436\u0430\u0441 \u0447\u0442\u043E-\u0442\u043E \u0442\u0438\u043F\u0430 \u043E\u0442\u0446\u0430. \u041F\u0440\u043E\u0441\u0442\u043E \u043D\u0430\u0434\u0435\u044E\u0441\u044C, \u0447\u0442\u043E \u044F \u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u0435\u0435 \u043F\u043E\u0434\u0432\u0435\u043B.$s",
  "Wed": "\u041D\u0435\u0442, \u0443 \u043C\u0435\u043D\u044F \u043D\u0435\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0441 \u0442\u043E\u0431\u043E\u0439 \u043F\u043E\u0431\u043E\u043B\u0442\u0430\u0442\u044C.",
  "Wed8": "\u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u044F \u0443\u0436\u0435 \u043F\u0440\u0438\u0432\u044F\u0437\u0430\u043B\u0441\u044F \u043A \u041C\u0430\u0440\u043D\u0438 \u0438 \u0414\u0436\u0430\u0441. \u041C\u044B \u0442\u0430\u043A\u0438\u0435 \u0440\u0430\u0437\u043D\u044B\u0435, \u043D\u043E \u0432 \u0442\u043E \u0436\u0435 \u0432\u0440\u0435\u043C\u044F \u043C\u044B \u0431\u0443\u0434\u0442\u043E \u0441\u0442\u0440\u0430\u043D\u043D\u0430\u044F \u0442\u0430\u043A\u0430\u044F \u0441\u0435\u043C\u044C\u044F.#$e#\u0412 \u0434\u0435\u0442\u0441\u0442\u0432\u0435 \u0443 \u043C\u0435\u043D\u044F \u043E\u0441\u043E\u0431\u043E \u0438 \u043D\u0435 \u0431\u044B\u043B\u043E \u0441\u0435\u043C\u044C\u0438.$s",
  "Wed4": "$d Joja#\u042D\u0445... \u041A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C \u043E\u0434\u043D\u043E \u0438 \u0442\u043E \u0436\u0435. \u0417\u0430\u043F\u043E\u043B\u043D\u044F\u0435\u0448\u044C \u044D\u0442\u0438 \u0443\u0436\u0430\u0441\u043D\u044B\u0435 \u043F\u043E\u043B\u043A\u0438, \u0438\u0434\u0435\u0448\u044C \u0432 \u0441\u0430\u043B\u0443\u043D, \u0432\u0441\u044E \u043D\u043E\u0447\u044C \u0432\u043E\u0440\u043E\u0447\u0430\u0435\u0448\u044C\u0441\u044F.$s|\u042F \u043D\u0435\u043D\u0430\u0432\u0438\u0434\u0435\u043B \u0441\u0432\u043E\u044E \u0440\u0430\u0431\u043E\u0442\u0443 \u0432 \u0414\u0436\u043E\u0434\u0436\u0430\u041C\u0430\u0440\u0442\u0435, \u043D\u043E \u0431\u0435\u0437 \u0440\u0430\u0431\u043E\u0442\u044B \u043C\u043D\u0435 \u0435\u0449\u0435 \u0445\u0443\u0436\u0435.$s",
  "Thu": "\u0427\u0435\u0433\u043E \u0442\u0435\u0431\u0435? \u041E\u0441\u0442\u0430\u0432\u044C \u043C\u0435\u043D\u044F \u0432 \u043F\u043E\u043A\u043E\u0435.",
  "Thu4": "\u0410 \u0442\u044B \u043D\u0435 \u0441\u0434\u0430\u0435\u0448\u044C\u0441\u044F. \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u044F \u043F\u0440\u043E\u0441\u0442\u043E \u0443\u0434\u0438\u0432\u043B\u0435\u043D, \u0447\u0442\u043E \u0441\u043E \u043C\u043D\u043E\u0439 \u043A\u043E\u043C\u0443-\u0442\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C.",
  "Thu6": "\u0423-\u0443... \u0413\u0434\u0435 \u0414\u0436\u043E\u0434\u0436\u0430-\u043A\u043E\u043B\u0430?||\u0417\u0430\u0447\u0435\u043C \u0441\u0442\u0430\u0440\u0430\u0442\u044C\u0441\u044F? \u0416\u0438\u0437\u043D\u044C \u2014 \u043A\u0430\u043A \u0431\u0440\u043E\u0441\u043E\u043A \u0438\u0433\u0440\u0430\u043B\u044C\u043D\u043E\u0439 \u043A\u043E\u0441\u0442\u0438.#$e#\u041A\u043E\u0433\u0434\u0430 \u043A\u0438\u0434\u0430\u043B\u0438 \u043C\u043E\u044E \u2014 \u043E\u043D\u0430 \u0432\u044B\u043B\u0435\u0442\u0435\u043B\u0430 \u0437\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u044B \u0441\u0442\u043E\u043B\u0430.",
  "Thu8": "\u0422\u0435\u0431\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u0441\u043E \u043C\u043D\u043E\u0439 \u0440\u0430\u0437\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044C? \u041F\u043E\u0436\u0430\u043B\u0443\u0439, \u044F \u0442\u0435\u0431\u0435 \u0434\u0430\u0436\u0435 \u043F\u043E\u0432\u0435\u0440\u044E... \u041C\u043E\u0436\u0435\u0442, \u0442\u044B ${\u0442\u0430\u043A\u043E\u0439 \u0436\u0435 \u0447\u0443\u0434\u0430\u043A^\u0442\u0430\u043A\u0430\u044F \u0436\u0435 \u0447\u0443\u0434\u0430\u0447\u043A\u0430}$, \u043A\u0430\u043A \u0438 \u044F.$h",
  "Fri": "\u0420\u0430\u0437\u0432\u0435 \u0442\u0435\u0431\u0435 \u043D\u0435\u0447\u0435\u043C \u0437\u0430\u043D\u044F\u0442\u044C\u0441\u044F?",
  "JojaMart": "%\u0428\u0435\u0439\u043D \u0441\u0435\u0439\u0447\u0430\u0441 \u0437\u0430 \u0440\u0430\u0431\u043E\u0442\u043E\u0439. \u041D\u0435 \u043F\u043E\u0445\u043E\u0436\u0435, \u0447\u0442\u043E \u043E\u043D \u0445\u043E\u0447\u0435\u0442 \u043F\u043E\u0431\u043E\u043B\u0442\u0430\u0442\u044C.",
  "Fri4": "$d Joja#\u041A\u0430\u043A\u043E\u0439 \u0432 \u0436\u0438\u0437\u043D\u0438 \u0441\u043C\u044B\u0441\u043B, \u0435\u0441\u043B\u0438 \u0442\u043E\u043B\u044C\u043A\u043E \u0438 \u0434\u0435\u043B\u0430\u0435\u0448\u044C, \u0447\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0448\u044C?|\u0423 \u043C\u0435\u043D\u044F \u043D\u0435\u0442 \u0434\u0435\u043D\u0435\u0433 \u043D\u0430 \u043E\u043F\u043B\u0430\u0442\u0443 \u0430\u0440\u0435\u043D\u0434\u044B, \u043D\u043E \u041C\u0430\u0440\u043D\u0438 \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E \u043C\u0435\u043D\u044F \u043D\u0435 \u043F\u0440\u043E\u0433\u043E\u043D\u044F\u0435\u0442. \u041C\u043D\u0435 \u043F\u043E\u0432\u0435\u0437\u043B\u043E.",
  "Fri6": "\u0412\u0435\u0447\u0435\u0440\u043E\u043C \u044F \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u043F\u043E\u0439\u0434\u0443 \u0432 \u0441\u0430\u043B\u0443\u043D. \u0410 \u0447\u0435\u0433\u043E \u0435\u0449\u0435 \u0434\u0435\u043B\u0430\u0442\u044C?",
  "Fri8": "\u0423\u0444... \u041F\u0440\u0438\u043A\u0438\u043D\u044C, \u043A\u0430\u043A \u0443\u0436\u0430\u0441\u043D\u043E, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043C\u043E\u044F \u043F\u0435\u0447\u0435\u043D\u044C?$s#$e#\u042F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E \u0441\u0435\u0431\u044F \u043D\u0430 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043B\u0435\u0442 \u0441\u0442\u0430\u0440\u0448\u0435, \u0447\u0435\u043C \u0441\u043B\u0435\u0434\u0443\u0435\u0442...$s",
  "Fri10": "\u041C\u043E\u0435 \u0442\u0435\u043B\u043E \u043D\u043E\u0435\u0442 \u043D\u0430\u043C\u043D\u043E\u0433\u043E \u043C\u0435\u043D\u044C\u0448\u0435 \u0441 \u0442\u0435\u0445 \u043F\u043E\u0440, \u043A\u0430\u043A \u044F \u0441\u0442\u0430\u043B \u043C\u0435\u043D\u044C\u0448\u0435 \u043F\u0438\u0442\u044C.#$e#\u041D\u043E \u043C\u043D\u0435 \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0447\u0442\u043E \u044F \u0445\u043E\u0436\u0443 \u043F\u043E \u043A\u0440\u0430\u044E...$s",
  "Sat": "\u0427\u0435\u0433\u043E \u0442\u044B \u043A\u043E \u043C\u043D\u0435 \u043F\u0440\u0438\u0441\u0442\u0430\u0435\u0448\u044C? \u042F \u0445\u043E\u0447\u0443 \u043F\u043E\u0431\u044B\u0442\u044C \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u0435.",
  "Sat2": "#$1 ShaneJOSH#\u042F \u0443\u0434\u0438\u0432\u043B\u0435\u043D, \u0447\u0442\u043E \u0442\u044B \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u043F\u044B\u0442\u0430\u0435\u0448\u044C\u0441\u044F \u0441\u043E \u043C\u043D\u043E\u0439 \u043F\u043E\u0434\u0440\u0443\u0436\u0438\u0442\u044C\u0441\u044F. \u042F \u0447\u0442\u043E, \u043C\u0430\u043B\u043E \u0442\u0435\u0431\u0435 \u0433\u0440\u0443\u0431\u0438\u043B?#$e#\u042D\u0445...$s",
  "Sat4": "$d Joja#\u042F \u0441\u043D\u0438\u043C\u0430\u044E \u043A\u043E\u043C\u043D\u0430\u0442\u0443 \u0443 \u041C\u0430\u0440\u043D\u0438 \u043F\u043E \u043E\u0442\u043B\u0438\u0447\u043D\u043E\u0439 \u0446\u0435\u043D\u0435. \u041A\u043E\u043C\u043D\u0430\u0442\u0430 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F, \u043D\u043E \u044F \u043D\u0435 \u0436\u0430\u043B\u0443\u044E\u0441\u044C.|\u0415\u0441\u043B\u0438 \u0431\u044B \u044F \u043C\u043E\u0433 \u043D\u0430\u0447\u0430\u0442\u044C \u0436\u0438\u0437\u043D\u044C \u0441\u043D\u0430\u0447\u0430\u043B\u0430, \u044F \u0431\u044B \u0437\u0430\u0432\u0435\u043B \u043F\u0442\u0438\u0447\u043D\u0438\u043A. \u041A\u043E\u043D\u0435\u0447\u043D\u043E, \u044F\u0439\u0446\u0430 \u0431\u044B\u043B\u0438 \u0431\u044B \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0442 \u043A\u0443\u0440 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0433\u043E \u0432\u044B\u0433\u0443\u043B\u0430.",
  "Sat8": "\u042F \u0441\u0438\u043B\u044C\u043D\u043E \u043F\u0440\u0438\u0432\u044F\u0437\u0430\u043B\u0441\u044F \u043A \u043A\u0443\u0440\u0430\u043C \u041C\u0430\u0440\u043D\u0438.$h||\u041A\u0443\u0440\u043E\u0447\u043A\u0430 \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u0442\u0435\u0431\u044F \u043D\u0435 \u043F\u043E\u0434\u0432\u0435\u0434\u0435\u0442. \u0410 \u0432\u043E\u0442 \u043B\u044E\u0434\u0438...",
  "Sat10": "\u041F\u043E\u0445\u043E\u0436\u0435, \u0442\u0432\u043E\u044F \u0444\u0435\u0440\u043C\u0430 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0434\u043B\u044F \u0440\u0430\u0437\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043A\u0443\u0440\u0438\u0446.$h",
  "Sun": "\u042F \u0437\u0430\u043D\u044F\u0442, \u0440\u0430\u0437\u0432\u0435 \u043D\u0435 \u0432\u0438\u0434\u043D\u043E?||...\u041D\u0435 \u0445\u043E\u0447\u0443 \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0438 \u0441 \u043A\u0435\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C.",
  "Sun2": "\u0421\u043D\u043E\u0432\u0430 \u0442\u044B? \u0421\u043A\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0437 \u043C\u043D\u0435 \u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0442\u0435\u0431\u044F \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043C\u0435\u043D\u044F \u0432 \u043F\u043E\u043A\u043E\u0435?$s",
  "Sun4": "\u0425\u043C-\u043C... \u0423\u0436\u0435 %time. \u0423\u0436\u0435 \u043C\u043E\u0436\u043D\u043E \u043A\u0438\u043D\u0443\u0442\u044C \u043F\u0438\u0446\u0446\u0443 \u0432 \u043C\u0438\u043A\u0440\u043E\u0432\u043E\u043B\u043D\u043E\u0432\u043A\u0443 \u0438\u043B\u0438 \u0435\u0449\u0435 \u043F\u043E\u0434\u043E\u0436\u0434\u0430\u0442\u044C?$u||\u0415\u0441\u043B\u0438 \u00AB\u0422\u0443\u043D\u0435\u043B\u043B\u0435\u0440\u044B\u00BB \u043F\u043E\u0431\u0435\u0434\u044F\u0442, \u043E\u0442\u043F\u0440\u0430\u0437\u0434\u043D\u0443\u044E \u043F\u0435\u043D\u043D\u044B\u043C.#$e#\u0410 \u0435\u0441\u043B\u0438 \u043F\u0440\u043E\u0438\u0433\u0440\u0430\u044E\u0442? \u0423\u0442\u043E\u043F\u043B\u044E \u0432 \u043D\u0435\u043C \u043F\u0435\u0447\u0430\u043B\u044C.",
  "Sun6": "... \u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u044F \u043D\u0430\u0431\u0438\u0440\u0430\u044E \u0432\u0435\u0441.$s",
  "Sun8": "\u0415\u0441\u043B\u0438 \u044F \u0431\u0443\u0434\u0443 \u043F\u043E\u0431\u043E\u043B\u044C\u0448\u0435 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0442\u0435\u043B\u0435\u0432\u0438\u0437\u043E\u0440, \u043C\u043E\u0436\u0435\u0442, \u044F \u0438 \u0437\u0430\u0431\u0443\u0434\u0443 \u043E \u0441\u0432\u043E\u0438\u0445 \u0437\u0430\u0431\u043E\u0442\u0430\u0445. \u0411\u044B\u043B\u043E \u0431\u044B \u0437\u0434\u043E\u0440\u043E\u0432\u043E.$u",
  "Sun10": "\u041F\u0440\u0438\u0432\u0435\u0442, @. \u041D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435, \u0434\u0435\u043D\u044C \u0443 \u043C\u0435\u043D\u044F \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u043D\u0435\u043F\u043B\u043E\u0445\u043E.$h",
  "event_room1": "\u041B\u0430\u0434\u043D\u043E... \u041F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u0439. \u041C\u043E\u0436\u0435\u0442, \u0441\u043F\u0440\u043E\u0448\u0443 \u0441\u043E\u0432\u0435\u0442\u0430 \u0443 \u042D\u043B\u043B\u0438\u043E\u0442\u0430, \u043A\u043E\u0433\u0434\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0443 \u0435\u0433\u043E \u0432 \u0441\u0430\u043B\u0443\u043D\u0435.$s",
  "event_room2": "\u0417\u0432\u0443\u0447\u0438\u0442 \u0437\u0434\u043E\u0440\u043E\u0432\u043E. \u041D\u0443\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442 \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043F\u043E\u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0430\u0442\u0443\u0440\u0430\u043B\u044C\u043D\u044B\u0445 \u0441\u043F\u0435\u0446\u044D\u0444\u0444\u0435\u043A\u0442\u043E\u0432, \u0447\u0442\u043E\u0431\u044B \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u043E\u0441\u044C \u043A\u0440\u0443\u0442\u043E.",
  "event_noLoan1": "\u042F \u0438 \u043D\u0435 \u0437\u043D\u0430\u043B, \u0447\u0442\u043E \u0442\u044B \u0441\u043A\u0440\u044F\u0433\u0430...$s",
  "event_noLoan2": "\u041B\u0430\u0434\u043D\u043E, \u043F\u0430\u043F...$s^\u041B\u0430\u0434\u043D\u043E, \u043C\u0430\u043C...$s",
  "event_noLoan3": "\u041E\u0433\u043E...$s",
  "event_apologize1": "...\u042D\u0442\u043E \u0442\u043E\u0447\u043D\u043E.",
  "event_apologize2": "\u0417\u043D\u0430\u0435\u0448\u044C... \u042F \u0437\u0430 \u044D\u0442\u0438\u043C \u0438 \u0437\u0430\u0448\u0435\u043B, \u0447\u0442\u043E\u0431\u044B \u0442\u0435\u0431\u0435 \u043E\u0431 \u044D\u0442\u043E\u043C \u0441\u043A\u0430\u0437\u0430\u0442\u044C.",
  "event_apologize3": "\u041E\u0433\u043E, \u0432\u0441\u0435 \u0431\u044B\u043B\u043E \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0435\u0440\u044C\u0435\u0437\u043D\u043E? \u042F \u043D\u0438\u0447\u0435\u0433\u043E \u0438 \u043D\u0435 \u043F\u043E\u043C\u043D\u044E...",
  "event_stadium1": "\u0414\u0430? \u041D\u0443 \u043B\u0430\u0434\u043D\u043E...$6#$b#\u042F? \u041C\u043D\u0435 \u0438\u043D\u043E\u0433\u0434\u0430 \u0431\u044B\u0432\u0430\u0435\u0442 \u0441\u043A\u0443\u0447\u043D\u043E \u0432 \u041F\u0435\u043B\u0438\u043A\u0430\u043D\u0435.#$b#\u041D\u043E... \u041C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F, \u0447\u0442\u043E \u043C\u044B \u0440\u0430\u0437\u043D\u044B\u0435. \u0422\u0430\u043A \u043C\u0435\u0436\u0434\u0443 \u043D\u0430\u043C\u0438 \u0435\u0441\u0442\u044C \u0440\u0430\u0432\u043D\u043E\u0432\u0435\u0441\u0438\u0435.$l",
  "event_stadium2": "\u041F\u0440\u0430\u0432\u0434\u0430? \u0423\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E... \u0420\u0430\u0437\u0432\u0435 \u0442\u044B \u0432 \u0434\u043E\u043B\u0438\u043D\u0435 \u0421\u0442\u0430\u0440\u0434\u044C\u044E \u043D\u0435 \u0434\u043B\u044F \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B \u0441\u0431\u0435\u0436\u0430\u0442\u044C \u043E\u0442 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0433\u043E \u0448\u0443\u043C\u0430?$6#$b#\u041D\u0443, \u0442\u043E \u0435\u0441\u0442\u044C \u044F... \u041D\u0435 \u043F\u043E\u0439\u043C\u0438 \u043C\u0435\u043D\u044F \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u043D\u043E, \u044F \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0442\u0435\u0431\u044F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E. \u041C\u043D\u0435, \u0437\u043D\u0430\u0435\u0448\u044C, \u0441\u0430\u043C\u043E\u043C\u0443 \u043D\u0435 \u043E\u0447\u0435\u043D\u044C-\u0442\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E \u0436\u0438\u0432\u0435\u0442\u0441\u044F \u0432 \u041F\u0435\u043B\u0438\u043A\u0430\u043D\u0435."
}