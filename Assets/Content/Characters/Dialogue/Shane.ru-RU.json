  "Resort_Leaving": "\u041D\u0443-\u0441... \u041D\u0430 \u0433\u043E\u0434 \u0432\u0438\u0442\u0430\u043C\u0438\u043D\u0430 D \u044F \u0442\u043E\u0447\u043D\u043E \u043D\u0430\u0433\u0443\u043B\u044F\u043B. \u0422\u0435\u043F\u0435\u0440\u044C \u043C\u043E\u0436\u043D\u043E \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0439\u0441\u044F \u0433\u043E\u0434 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u0433\u0430\u043C\u0430\u0442\u044C \u0441 \u0437\u0430\u043D\u0430\u0432\u0435\u0448\u0435\u043D\u043D\u044B\u043C\u0438 \u043E\u043A\u043D\u0430\u043C\u0438.",
  "Resort_Shore": "\u0412\u043E\u0442 \u0442\u0430\u043A... \u042F \u0431\u0435\u0437 \u0431\u043E\u0442\u0438\u043D\u043E\u043A \u0438 \u0434\u0430\u0436\u0435 \u0431\u0435\u0437 \u043D\u043E\u0441\u043A\u043E\u0432.#$b#\u041A\u0442\u043E-\u0442\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u0447\u0442\u043E \u044F \u0442\u0430\u043A \u0430\u043D\u0442\u0438\u0441\u0430\u043D\u0438\u0442\u0430\u0440\u0438\u044E \u0440\u0430\u0437\u0432\u043E\u0436\u0443.#$b#\u0410 \u043A\u0440\u0430\u0431\u0430\u043C \u0432\u043E\u0442 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F.$h",
