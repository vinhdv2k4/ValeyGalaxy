  "divorced": "...$a#$e#...\u041E\u0442\u0441\u0442\u0430\u043D\u044C \u043E\u0442 \u043C\u0435\u043D\u044F.$a",
  "breakUp": "*\u0441\u0433\u043B\u0430\u0442\u044B\u0432\u0430\u0435\u0442* \u041E\u0445... \u0414\u0430, \u043A\u043E\u043D\u0435\u0447\u043D\u043E... \u041C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u044D\u0442\u043E\u0433\u043E \u0438 \u0441\u0442\u043E\u0438\u043B\u043E \u043E\u0436\u0438\u0434\u0430\u0442\u044C.$s#$b#\u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435... \u044D\u043C... \u0422\u043E\u0433\u0434\u0430 \u0443\u0432\u0438\u0434\u0438\u043C\u0441\u044F \u0432 \u0441\u0430\u043B\u0443\u043D\u0435.",
  "dumped_Guys": "%\u0423 \u0428\u0435\u0439\u043D\u0430 \u043E\u0441\u0442\u0435\u043A\u043B\u0435\u043D\u0435\u0432\u0448\u0438\u0439 \u0432\u0437\u0433\u043B\u044F\u0434. \u041E\u043D \u0441 \u0432\u0430\u043C\u0438 \u043D\u0435 \u0440\u0430\u0437\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0442.",
