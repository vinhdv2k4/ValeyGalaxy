{
  "Rainy_Day_0": "\u042F \u0441\u0438\u043B\u044C\u043D\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u0430\u0441\u044C \u0437\u0430 \u0432\u0441\u0435 \u044D\u0442\u0438 \u0433\u043E\u0434\u044B, \u043D\u043E \u0432\u0441\u0435 \u0435\u0449\u0435 \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0438\u0442\u0430\u044E \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u0443\u044E \u043F\u043E\u0433\u043E\u0434\u0443.",
  "Rainy_Day_1": "\u0418\u043D\u043E\u0433\u0434\u0430 \u044F \u043C\u0435\u0447\u0442\u0430\u044E \u043E \u0442\u043E\u043C, \u043A\u0430\u043A \u043C\u044B \u0443\u0439\u0434\u0435\u043C \u043D\u0430 \u043F\u0435\u043D\u0441\u0438\u044E... \u043D\u0430\u0441\u043B\u0430\u0436\u0434\u0430\u044F\u0441\u044C \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u044B\u043C\u0438 \u043F\u043B\u044F\u0436\u0430\u043C\u0438 \u041F\u0430\u043F\u043E\u0440\u043E\u0442\u043D\u0438\u043A\u043E\u0432\u044B\u0445 \u043E\u0441\u0442\u0440\u043E\u0432\u043E\u0432!#$e#\u0410 \u0442\u044B \u0447\u0430\u0441\u0442\u043E \u0434\u0443\u043C\u0430\u0435\u0448\u044C \u043E \u0431\u0443\u0434\u0443\u0449\u0435\u043C, @?",
  "Rainy_Day_2": "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E! \u042F \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0430\u0441\u044C \u043F\u043E\u0440\u0430\u043D\u044C\u0448\u0435 \u0438 \u0438\u0441\u043F\u0435\u043A\u043B\u0430 \u0442\u0435\u0431\u0435 \u043A\u043E\u0435-\u0447\u0442\u043E \u0441\u043B\u0430\u0434\u0435\u043D\u044C\u043A\u043E\u0435![223 234 211 651 731]#$e#\u042F \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0442\u0435\u0431\u0435 \u0432\u0441\u0435 \u043F\u043E \u043F\u043B\u0435\u0447\u0443, \u043D\u043E \u0442\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E \u0445\u043E\u0440\u043E\u0448\u043E \u043F\u0438\u0442\u0430\u0442\u044C\u0441\u044F, \u0447\u0442\u043E\u0431\u044B \u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0435!$h",
  "Rainy_Day_3": "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u043D\u0435 \u043C\u043E\u0433\u0443 \u0432\u044B\u0439\u0442\u0438 \u043D\u0430 \u0443\u043B\u0438\u0446\u0443... \u0412\u043E\u043B\u043E\u0441\u044B \u043E\u0441\u043B\u0430\u0431\u0435\u044E\u0442. \u041F\u0440\u043E\u0441\u0442\u0438, \u0441\u043E\u043B\u043D\u0446\u0435.$s#$e#\u042F \u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u0442\u044C \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E \u043B\u0443\u0447\u0448\u0435 \u0434\u043B\u044F \u0442\u0435\u0431\u044F.",
  "Rainy_Day_4": "\u0422\u044B \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0448\u044C\u0441\u044F \u043D\u0430 \u0443\u043B\u0438\u0446\u0443 \u0432 \u0442\u0430\u043A\u0443\u044E \u043F\u043E\u0433\u043E\u0434\u0443? \u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u0437\u0430\u0431\u0443\u0434\u044C \u0432\u044B\u0442\u0435\u0440\u0435\u0442\u044C \u043D\u043E\u0433\u0438, \u043A\u043E\u0433\u0434\u0430 \u0432\u0435\u0440\u043D\u0435\u0448\u044C\u0441\u044F, ${\u0434\u043E\u0440\u043E\u0433\u043E\u0439^\u0434\u043E\u0440\u043E\u0433\u0430\u044F}$.#$e#\u042F \u043E\u0441\u0442\u0430\u043D\u0443\u0441\u044C \u0442\u0443\u0442, \u043F\u0435\u0440\u0435\u0434\u0435\u043B\u0430\u044E \u0434\u0435\u043B\u0430 \u043F\u043E \u0434\u043E\u043C\u0443.",
  "patio_Haley": "\u0421\u043A\u0430\u0436\u0438 \u00AB\u043A\u043E\u0437\u0438\u0439 \u0441\u044B\u0440\u00BB!",
  "Rainy_Day_Haley": "\u041E \u043D\u0435\u0442! \u0415\u0441\u043B\u0438 \u043F\u043E\u0433\u043E\u0434\u0430 \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F \u0442\u0430\u043A\u043E\u0439 \u0436\u0435, \u044F \u0441\u043E\u0432\u0441\u0435\u043C \u043F\u043E\u0431\u043B\u0435\u0434\u043D\u0435\u044E!$s",
  "Rainy_Night_0": "\u041E, \u044F \u0440\u0430\u0434\u0430, \u0447\u0442\u043E \u0442\u044B \u0441\u043D\u043E\u0432\u0430 \u0437\u0434\u0435\u0441\u044C. \u041E\u0434\u043D\u043E\u0439 \u0437\u0434\u0435\u0441\u044C \u0442\u0430\u043A \u0445\u043E\u043B\u043E\u0434\u043D\u043E... \u041D\u0443 \u0447\u0442\u043E, \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u043C \u0441\u0432\u0435\u0442?",
  "Rainy_Night_1": "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0437\u0430\u0432\u0442\u0440\u0430 \u0441 \u0443\u0442\u0440\u0430 \u0431\u0443\u0434\u0435\u0442 \u0445\u043E\u0440\u043E\u0448\u043E \u0438 \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u043E. \u041A\u043E\u0433\u0434\u0430 \u0437\u0430\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0434\u043E\u0436\u0434\u044C, \u043C\u043D\u0435 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0442\u043E\u0441\u043A\u043B\u0438\u0432\u043E.$s",
  "Rainy_Night_2": "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u042D\u043C\u0438\u043B\u0438 \u043D\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043E\u0434\u0438\u043D\u043E\u043A\u043E. \u041D\u0443\u0436\u043D\u043E \u0435\u0435 \u043F\u043E\u0441\u043A\u043E\u0440\u0435\u0435 \u043D\u0430\u0432\u0435\u0441\u0442\u0438\u0442\u044C.$7",
  "Rainy_Night_3": "\u0414\u043B\u044F \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0430 \u0434\u043E\u0436\u0434\u044C \u2014 \u044D\u0442\u043E \u0443\u0436\u0430\u0441\u043D\u043E. \u041E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0435 \u043F\u043B\u043E\u0445\u043E\u0435, \u0438 \u043D\u0430 \u0443\u043B\u0438\u0446\u0443 \u043D\u0435 \u0432\u044B\u0439\u0442\u0438, \u043D\u0435 \u0438\u0441\u043F\u043E\u0440\u0442\u0438\u0432 \u0430\u043F\u043F\u0430\u0440\u0430\u0442!$s",
  "Rainy_Night_4": "\u042F \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u043B\u0430 \u0442\u0435\u0431\u0435 \u0433\u043E\u0440\u044F\u0447\u0435\u0433\u043E \u043F\u043E\u0435\u0441\u0442\u044C, \u0441\u043E\u043B\u043D\u0446\u0435. \u041F\u043E\u0431\u043E\u043B\u044C\u0448\u0435 \u0441\u043F\u0435\u0446\u0438\u0439, \u043A\u0430\u043A \u0442\u044B \u043B\u044E\u0431\u0438\u0448\u044C. \u041D\u0430\u0441\u043B\u0430\u0436\u0434\u0430\u0439\u0441\u044F! [727 231 207 199]$h",
  "Rainy_Night_5": "\u041D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0434\u0443\u043C\u0430\u043B\u0430, \u0447\u0442\u043E \u0441\u043A\u0430\u0436\u0443 \u0442\u0430\u043A\u043E\u0435, \u043D\u043E \u0436\u0438\u0437\u043D\u044C \u0437\u0430 \u0433\u043E\u0440\u043E\u0434\u043E\u043C \u043C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442.$h",
  "Rainy_Night_Haley": "\u041F\u0440\u0438\u0432\u0435\u0442, \u0441\u043E\u043B\u043D\u0446\u0435. \u042F \u0442\u0430\u043A \u0440\u0430\u0434\u0430, \u0447\u0442\u043E \u0442\u044B \u0434\u043E\u043C\u0430. \u041C\u043D\u0435 \u0431\u044B\u043B\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043E\u0434\u0438\u043D\u043E\u043A\u043E.$l",
  "Indoor_Day_0": "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E! \u041A\u0430\u043A \u0442\u0435\u0431\u0435 \u0441\u043F\u0430\u043B\u043E\u0441\u044C?$h#$e#\u0414\u0443\u043C\u0430\u044E \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0440\u0430\u0441\u0447\u0435\u0445\u043B\u0438\u0442\u044C \u0441\u0432\u043E\u044E \u0441\u0442\u0430\u0440\u0443\u044E \u043A\u0430\u043C\u0435\u0440\u0443... \u041E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0435 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E\u0435.",
  "Indoor_Day_1": "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E, ${\u0434\u043E\u0440\u043E\u0433\u043E\u0439^\u0434\u043E\u0440\u043E\u0433\u0430\u044F}$! \u0417\u0434\u043E\u0440\u043E\u0432\u043E \u043F\u0430\u0445\u043D\u0435\u0442, \u043F\u0440\u0430\u0432\u0434\u0430? \u042D\u0442\u043E \u0442\u0435\u0431\u044F \u0434\u043E\u0436\u0438\u0434\u0430\u0435\u0442\u0441\u044F \u0437\u0430\u0432\u0442\u0440\u0430\u043A![194 195 210 211 216]#$e#\u042F \u0437\u043D\u0430\u044E, \u0442\u0435\u0431\u0435 \u0442\u044F\u0436\u0435\u043B\u043E \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0435. \u042F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0443 \u0442\u0435\u0431\u044F \u043A\u0430\u043A \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043C\u043E\u0433\u0443!",
  "Indoor_Day_2": "\u041A\u0430\u043A \u0442\u0435\u0431\u0435 \u0441\u043F\u0430\u043B\u043E\u0441\u044C? \u0422\u044B \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0445\u0440\u0430\u043F\u0438\u0448\u044C.$h#$e#\u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043A\u043E\u0435-\u043A\u0430\u043A\u0438\u0435 \u0434\u0435\u043B\u0430 \u043F\u043E \u0434\u043E\u043C\u0443. \u0425\u043E\u0440\u043E\u0448\u0435\u0433\u043E \u0442\u0435\u0431\u0435 \u0434\u043D\u044F.",
  "Indoor_Day_3": "\u042F \u0440\u0430\u0434\u0430, \u0447\u0442\u043E \u043D\u0430\u0443\u0447\u0438\u043B\u0430\u0441\u044C \u043B\u044E\u0431\u0438\u0442\u044C \u0443\u0431\u043E\u0440\u043A\u0443! \u0412 \u044D\u0442\u043E\u043C \u0434\u043E\u043C\u0435 \u0442\u0430\u043A \u0431\u044B\u0441\u0442\u0440\u043E \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0433\u0440\u044F\u0437\u043D\u043E.$10#$e#\u041F\u0440\u0438\u044F\u0442\u043D\u043E, \u043A\u043E\u0433\u0434\u0430 \u0432\u0441\u0435 \u0431\u043B\u0435\u0441\u0442\u0438\u0442 \u043E\u0442 \u0447\u0438\u0441\u0442\u043E\u0442\u044B.#$e#\u0410 \u043F\u043E\u0446\u0435\u043B\u0443\u0435\u0448\u044C \u043C\u0435\u043D\u044F \u043F\u0435\u0440\u0435\u0434 \u0443\u0445\u043E\u0434\u043E\u043C?$11",
  "Indoor_Day_4": "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E, ${\u0434\u043E\u0440\u043E\u0433\u043E\u0439^\u0434\u043E\u0440\u043E\u0433\u0430\u044F}$. \u0415\u0449\u0435 \u043E\u0434\u0438\u043D \u0434\u0435\u043D\u044C \u0444\u0435\u0440\u043C\u0435\u0440\u0441\u043A\u0438\u0445 \u0437\u0430\u0431\u043E\u0442?#$e#\u042F \u0431\u0443\u0434\u0443 \u0434\u0443\u043C\u0430\u0442\u044C \u043E \u0442\u0435\u0431\u0435. \u003C$h",
  "Indoor_Day_Haley": "\u0423 \u043C\u0435\u043D\u044F \u0431\u0443\u0434\u0442\u043E \u043D\u0435 \u0431\u044B\u043B\u043E \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u0430 \u0432 \u0436\u0438\u0437\u043D\u0438, \u043F\u043E\u043A\u0430 \u044F \u043D\u0435 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0430 \u0442\u0435\u0431\u044F. \u0410 \u0442\u0435\u043F\u0435\u0440\u044C \u0443 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u043A\u0430\u043A \u0440\u0430\u0437 \u0442\u043E, \u0447\u0442\u043E \u043C\u043D\u0435 \u0438 \u043D\u0443\u0436\u043D\u043E.$l",
  "Indoor_Night_Haley": "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0431\u044B\u043B\u043E \u043C\u043D\u043E\u0433\u043E \u0440\u0430\u0431\u043E\u0442\u044B, \u0441\u043E\u043B\u043D\u044B\u0448\u043A\u043E. \u0414\u0430\u0432\u0430\u0439 \u044F \u043F\u043E\u043C\u043E\u0433\u0443 \u0442\u0435\u0431\u0435 \u0441\u043D\u044F\u0442\u044C \u0441\u0442\u0440\u0435\u0441\u0441.$l",
  "Outdoor_0": "\u041C\u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u043B\u0443\u0447\u0448\u0435 \u0432\u0441\u0435\u0433\u043E \u0441\u043D\u0430\u0440\u0443\u0436\u0438, \u043D\u0430 \u0441\u0432\u0435\u0436\u0435\u043C \u0432\u043E\u0437\u0434\u0443\u0445\u0435.#$b#\u041D\u0435 \u043F\u043E\u0439\u043C\u0438 \u043C\u0435\u043D\u044F \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E, \u0434\u043E\u043C\u0438\u043A \u0442\u0432\u043E\u0435\u0433\u043E \u0434\u0435\u0434\u0443\u0448\u043A\u0438 \u0442\u043E\u0436\u0435 \u043E\u0447\u0435\u043D\u044C \u043C\u0438\u043B\u044B\u0439! \u041D\u043E \u0441 \u044D\u0442\u0438\u043C \u043B\u0430\u043D\u0434\u0448\u0430\u0444\u0442\u043E\u043C \u043D\u0438\u0447\u0442\u043E \u043D\u0435 \u0441\u0440\u0430\u0432\u043D\u0438\u0442\u0441\u044F.",
  "Outdoor_1": "\u041D\u0443\u0436\u043D\u043E \u043F\u043E\u0437\u0430\u0431\u043E\u0442\u0438\u0442\u044C\u0441\u044F \u043E \u0442\u043E\u043C, \u0447\u0442\u043E\u0431\u044B \u0444\u0435\u0440\u043C\u0430 \u0431\u044B\u043B\u0430 \u043C\u0438\u043B\u0435\u043D\u044C\u043A\u043E\u0439! \u042D\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u043E\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u0432\u0430\u0436\u043D\u043E... \u041F\u0440\u0430\u0432\u0434\u0430, \u0441\u043E\u043B\u043D\u0446\u0435?",
  "Outdoor_2": "\u041F\u0440\u0438\u0432\u0435\u0442, \u0441\u043E\u043B\u043D\u044B\u0448\u043A\u043E! \u042F \u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u043C\u043D\u043E\u0433\u043E \u0437\u043D\u0430\u044E \u043E \u0440\u0430\u0431\u043E\u0442\u0435 \u043D\u0430 \u0444\u0435\u0440\u043C\u0435, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u0438 \u043F\u043E\u043C\u043E\u0433\u0430\u044E. \u041F\u0440\u043E\u0441\u0442\u0438!#$e#\u042F \u0431\u0443\u0434\u0443 \u0434\u0443\u043C\u0430\u0442\u044C \u043E \u0442\u0435\u0431\u0435.$h",
  "Outdoor_3": "\u042F \u0432\u044B\u0442\u0440\u0443 \u0442\u0443\u0442 \u043F\u044B\u043B\u044C. \u042D\u0442\u043E \u0432\u0435\u0434\u044C \u0442\u0435\u0431\u0435 \u043F\u043E\u043C\u043E\u0436\u0435\u0442, \u0434\u0430?#$e#\u0423\u0444... \u041D\u0443 \u0438 \u0436\u0430\u0440\u0430 \u0442\u0443\u0442.",
  "Outdoor_4": "\u041D\u0435 \u043F\u0435\u0440\u0435\u0442\u0440\u0443\u0434\u0438\u0441\u044C, ${\u0434\u043E\u0440\u043E\u0433\u043E\u0439^\u0434\u043E\u0440\u043E\u0433\u0430\u044F}$.#$e#\u041D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439 \u0434\u0435\u043B\u0430\u0442\u044C \u043F\u0435\u0440\u0435\u0440\u044B\u0432\u044B, \u0438 \u043D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439 \u043F\u0435\u0440\u0435\u043A\u0443\u0441\u0438\u0442\u044C.$h",
  "Outdoor_Haley": "\u041F\u043E\u0445\u043E\u0436\u0435, \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0434\u0435\u043D\u044C, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0437\u0430\u0433\u043E\u0440\u0430\u0442\u044C. \u0422\u044B \u0442\u0430\u043A \u043D\u0435 \u0434\u0443\u043C\u0430\u0435\u0448\u044C, \u0441\u043E\u043B\u043D\u044B\u0448\u043A\u043E?",
  "funLeave_Haley": "\u042F \u043F\u043E\u0439\u0434\u0443 \u0432 \u0433\u043E\u0440\u043E\u0434, \u043F\u043E\u0431\u043E\u043B\u0442\u0430\u044E \u0441\u043E \u0432\u0441\u0435\u043C\u0438 \u043D\u0435\u043C\u043D\u043E\u0433\u043E.",
  "funReturn_Haley": "\u0411\u044B\u043B\u043E \u043F\u0440\u0438\u044F\u0442\u043D\u043E \u043F\u043E\u0432\u0438\u0434\u0430\u0442\u044C\u0441\u044F \u0441\u043E \u0432\u0441\u0435\u043C\u0438 \u0432 \u0433\u043E\u0440\u043E\u0434\u0435. \u0423 \u0442\u0435\u0431\u044F \u0431\u044B\u043B \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0434\u0435\u043D\u044C, ${\u0434\u043E\u0440\u043E\u0433\u043E\u0439^\u0434\u043E\u0440\u043E\u0433\u0430\u044F}$?",
  "OneKid_3": "\u041A\u0430\u043A \u0441\u0442\u0440\u0430\u043D\u043D\u043E, \u0430? \u041D\u0435 \u043F\u0440\u0438\u0432\u044B\u043A\u043B\u0430 \u044F \u0431\u044B\u0442\u044C \u043C\u0430\u0442\u0435\u0440\u044C\u044E.",
  "TwoKids_2": "%kid2 \u2014 \u0442\u0430\u043A\u043E\u0439 \u043C\u0438\u043B\u044B\u0439 \u0440\u0435\u0431\u0435\u043D\u043E\u0447\u0435\u043A, \u043F\u0440\u0430\u0432\u0434\u0430?",
  "TwoKids_3": "\u0411\u043E\u043B\u044C\u0448\u043E\u0439 \u0434\u043E\u043C, \u0434\u0432\u043E\u0435 \u0434\u0435\u0442\u0435\u0439, \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u0443\u0447\u0430\u0441\u0442\u043E\u043A. \u041D\u0435 \u0443\u0432\u0435\u0440\u0435\u043D\u0430, \u0447\u0442\u043E \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0441\u0438\u0442\u044C \u043E \u0431\u043E\u043B\u044C\u0448\u0435\u043C.",
  "spring_2": "\u041A\u0430\u043A\u0438\u0435 \u0443 \u043D\u0430\u0441 \u043F\u043E\u0441\u0435\u0432\u044B \u0432 \u044D\u0442\u043E\u043C \u0441\u0435\u0437\u043E\u043D\u0435?",
  "spring_1": "\u0417\u0438\u043C\u0430 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0430\u0441\u044C, \u0432\u043F\u0435\u0440\u0435\u0434\u0438 \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u044B\u0435 \u0434\u0435\u043D\u044C\u043A\u0438. \u042F \u0442\u0430\u043A \u0440\u0430\u0434\u0430.",
  "summer_3": "\u041F\u0440\u043E\u0441\u0442\u0438, \u0435\u0441\u043B\u0438 \u0432\u044B\u0433\u043B\u044F\u0436\u0443 \u043D\u0435\u0432\u0430\u0436\u043D\u043E... \u041F\u0440\u043E\u0441\u0442\u043E \u0432\u043E\u0437\u0434\u0443\u0445 \u0442\u0430\u043A\u043E\u0439 \u0432\u043B\u0430\u0436\u043D\u044B\u0439, \u0447\u0442\u043E \u0432\u043E\u043B\u043E\u0441\u044B \u043D\u0435 \u0443\u043B\u043E\u0436\u0438\u0442\u044C.",
  "summer_15": "\u041B\u0435\u0442\u043E... \u0417\u043D\u0430\u0447\u0438\u0442, \u0434\u043E\u043C\u0430 \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u043B\u043D\u043E \u043C\u0443\u0445 \u0438 \u043C\u0443\u0440\u0430\u0432\u044C\u0435\u0432... \u0424\u0443.$s",
  "fall_2": "\u042F \u0443\u0436\u0435 \u0441\u043A\u0443\u0447\u0430\u044E \u043F\u043E \u043B\u0435\u0442\u0443...",
  "fall_1": "\u041E\u0441\u0435\u043D\u044C \u0434\u043B\u044F \u043C\u0435\u043D\u044F \u2014 \u043F\u0435\u0447\u0430\u043B\u044C\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F... \u0412\u0441\u0435 \u0443\u043C\u0438\u0440\u0430\u0435\u0442.$5",
  "winter_14": "\u0423 \u043C\u0435\u043D\u044F \u0441\u043E\u0445\u043D\u0435\u0442 \u043A\u043E\u0436\u0430 \u0432 \u0442\u0430\u043A\u0443\u044E \u043F\u043E\u0433\u043E\u0434\u0443.",
  "winter_2": "\u041F\u043E\u0447\u0435\u043C\u0443-\u0442\u043E \u0432 \u0442\u0430\u043A\u043E\u0439 \u0441\u043D\u0435\u0433 \u043C\u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0440\u043E\u0437\u043E\u0432\u043E\u0433\u043E \u0442\u043E\u0440\u0442\u0430...",
  "spring_Haley": "\u0420\u0430\u0437\u0432\u0435 \u0442\u044B \u043D\u0435 ${\u0440\u0430\u0434^\u0440\u0430\u0434\u0430}$, \u0447\u0442\u043E \u0437\u0438\u043C\u0430 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0430\u0441\u044C, ${\u0434\u043E\u0440\u043E\u0433\u043E\u0439^\u0434\u043E\u0440\u043E\u0433\u0430\u044F}$? \u0421\u0440\u0430\u0437\u0443 \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u043D\u043E\u0432\u044B\u0445 \u043D\u0430\u0434\u0435\u0436\u0434.",
  "summer_Haley": "\u042F \u043B\u044E\u0431\u043B\u044E \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u044C \u0437\u0430 \u0441\u0432\u0435\u0442\u043B\u044F\u0447\u043A\u0430\u043C\u0438 \u0436\u0430\u0440\u043A\u043E\u0439 \u043B\u0435\u0442\u043D\u0435\u0439 \u043D\u043E\u0447\u044C\u044E. \u0422\u0430\u043A \u044F \u0431\u043B\u0438\u0436\u0435 \u0432\u0441\u0435\u0433\u043E \u043A \u0437\u0432\u0435\u0437\u0434\u0430\u043C.",
  "fall_Haley": "\u042F \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0438\u0442\u0430\u044E \u043B\u0435\u0442\u043E, \u043D\u043E \u043E\u0441\u0435\u043D\u044C\u044E, \u043F\u043E\u0436\u0430\u043B\u0443\u0439, \u043B\u0443\u0447\u0448\u0435 \u0432\u0441\u0435\u0433\u043E \u0441\u043D\u0438\u043C\u0430\u0442\u044C \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438. \u042D\u0442\u0438 \u0434\u043B\u0438\u043D\u043D\u044B\u0435, \u043D\u0438\u0437\u043A\u0438\u0435 \u0442\u0435\u043D\u0438...",
  "winter_Haley": "\u042F \u0442\u0443\u0442 \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u043B\u0430, \u043A\u0430\u043A \u0442\u044B \u0442\u043E\u0433\u0434\u0430 ${\u043F\u043E\u043C\u043E\u0433^\u043F\u043E\u043C\u043E\u0433\u043B\u0430}$ \u043C\u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0431\u0430\u043D\u043A\u0443 \u0441 \u043E\u0433\u0443\u0440\u0446\u0430\u043C\u0438. \u041F\u043E\u043C\u043D\u0438\u0448\u044C?$h#$e#\u0414\u0430, \u043C\u043D\u043E\u0433\u043E \u0432\u043E\u0434\u044B \u0441 \u0442\u0435\u0445 \u043F\u043E\u0440 \u0443\u0442\u0435\u043A\u043B\u043E.$l"
}