  "Good_0": "\uC6B0\uB9AC\uAC00 \uB4DC\uB514\uC5B4 \uACB0\uD63C\uD588\uB2E4\uB294 \uAC8C \uBBFF\uAE30\uC9C0 \uC54A\uC544...$l",
  "Good_1": "\uC788\uC9C0, \uC5B8\uC820\uAC04 \uC6B0\uB9AC\uAC00 \uC774\uB807\uAC8C \uD568\uAED8\uD560 \uAC70\uB780 \uB290\uB08C\uC774 \uC608\uC804\uBD80\uD130 \uC788\uC5C8\uC5B4.$l",
