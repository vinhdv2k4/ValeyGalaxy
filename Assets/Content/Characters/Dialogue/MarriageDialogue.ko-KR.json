  "jobReturn_Penny": "#$c .5#\uC88B\uC740 \uC800\uB141\uC774\uC5D0\uC694. \uB09C \uC624\uB298 \uD558\uB8E8 \uAD1C\uCC2E\uC558\uC5B4\uC694! \uC5EC\uBCF4\uB294 \uC5B4\uB560\uB098\uC694?$h#$e#\uC7AC\uC2A4\uB791 \uBE48\uC13C\uD2B8\uAC00 \uC624\uB298 \uC880 \uB9D0\uC37D\uC774\uC5C8\uC5B4\uC694. \uB098 \uC544\uC9C1 \uAE30\uBD84\uC774 \uC548 \uD480\uB838\uB098 \uBD10\uC694...",
  "jobReturn_Maru": "#$c .5#\uBB50, \uC624\uB298\uB3C4 \uBCD1\uC6D0 \uC77C\uC740 \uC9C0\uB8E8\uD588\uC5B4.#$e#\uC624\uB298 \uB098\uBCF4\uB2E4 \uC7AC\uBC0C\uB294 \uD558\uB8E8 \uBCF4\uB0C8\uC5B4? \uADF8\uB807\uAE38 \uBC14\uB77C.#$e#$c .5#\uBB50, \uC774\uC820 \uC880 \uC274 \uC2DC\uAC04\uC774\uB124. \uC800\uB141 \uD639\uC2DC \uC880 \uB0A8\uC558\uC5B4?#$e#\uADF8\uB0E5 \uC5BC\uB978 \uC790\uACE0 \uC2F6\uB2E4.$h",
  "OneKid_0": "\uC624\uB298 %kid1(\uC774)\uB791\uC740 \uC2DC\uAC04 \uC880 \uBCF4\uB0C8\uC5B4?",
  "OneKid_1": "%kid1(\uC774)\uB3C4 \uC790\uB77C\uC11C \uB2F9\uC2E0\uCC98\uB7FC \uB18D\uBD80\uAC00 \uB418\uB824\uB098?",
  "OneKid_2": "%kid1(\uC774) \uBC25\uC740 \uC624\uB298 \uB0B4\uAC00 \uCC59\uAE38\uAC8C, \uAC71\uC815 \uC548 \uD574\uB3C4 \uB420 \uAC70\uC57C. \uB18D\uC7A5 \uC6B4\uC601\uC5D0 \uC9D1\uC911\uD574\uC694 \uC5EC\uBCF4.",
