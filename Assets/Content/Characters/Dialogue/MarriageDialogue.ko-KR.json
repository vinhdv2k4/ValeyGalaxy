  "Outdoor_Elliott": "\uC624\uB298\uC740 \uC0C8 \uC18C\uC124\uC744 \uACC4\uC18D \uC4F8 \uAC70\uC57C. \uC6B0\uB9AC \uBA4B\uC9C4 \uB18D\uC7A5\uB9CC\uD07C \uC791\uC5C5\uD558\uAE30 \uC88B\uC740 \uACF3\uB3C4 \uC5C6\uC9C0.$h#$e#\uC644\uBCBD\uD574.$l",
  "Outdoor_Alex": "\uC624\uB298\uC740 \uC6B4\uB3D9 \uC794\uB729 \uD560 \uAC70\uC57C! \uD558\uD558! \uB18D\uC7A5\uC5D0 \uC0AC\uB294 \uAC70 \uC9C4\uC9DC \uC88B\uB124.$h",
  "Outdoor_Sam": "\uC5B4, \uC5EC\uBCF4, \uD558\uB298\uC5D0 \uC800 \uBB49\uAC8C\uBB49\uAC8C \uB5A0\uC788\uB294 \uAD6C\uB984 \uBD10\uBD10!$h#$e#\uC7A0\uAE50 \uC800 \uAD6C\uB984 \uC880 \uBCF4\uACE0 \uC788\uC744\uAC8C.",
  "Outdoor_Shane": "\uD3D0\uAC00 \uC774 \uC0C1\uCF8C\uD568\uC744 \uAC10\uB2F9\uD560 \uC218 \uC788\uC73C\uB824\uB098. \uC544\uC9C1 \uC870\uC790 \uACF5\uAE30\uAC00 \uC775\uC219\uD574\uC11C.",
  "Outdoor_Emily": "\uC798\uD558\uACE0 \uC788\uC5B4, @. \uC5F4\uC2EC\uD788 \uD558\uC790.",
