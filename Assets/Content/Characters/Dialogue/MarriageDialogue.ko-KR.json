  "Outdoor_Leah": "\uC640, \uC774\uAC70 \uC815\uB9D0 \uC88B\uC740 \uAC78! @\uC544(\uC57C), \uB098 \uC694\uC998 \uB18D\uC7A5 \uC0DD\uD65C\uC774 \uC815\uB9D0 \uC990\uAC70\uC6CC\uC9C0\uACE0 \uC788\uB294 \uAC83 \uAC19\uC544.$h#$e#\uB0B4\uAC00 \uD56D\uC0C1 \uAFC8\uAFD4\uC624\uB358 \uC7A5\uC18C\uC57C.$l",
  "Outdoor_Penny": "@, \uC6B0\uB9AC \uC791\uC740 \uB18D\uC7A5\uC5D0\uC11C \uC9C0\uB0B4\uC11C \uB108\uBB34 \uD589\uBCF5\uD574\uC694.$h",
  "Outdoor_Sebastian": "\uB0B4 \uC608\uC804 \uC0B6\uC774\uB791 \uB108\uBB34 \uB2E4\uB974\uAE34 \uD55C\uB370, \uC810\uC810 \uB9C8\uC74C\uC5D0 \uB4DC\uB294 \uAC83 \uAC19\uC544.$h#$e#\uB0B4\uAC00 \uC788\uC5B4\uC57C \uD560 \uACF3\uC774 \uB531 \uC5EC\uAE30\uB77C\uB294 \uAE30\uBD84\uC774 \uB4E4\uC5B4.$l",
