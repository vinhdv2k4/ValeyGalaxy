  "summer_Harvey": "\uD587\uBCD5\uC5D0 \uD0C0\uC9C0 \uC54A\uAC8C \uC870\uC2EC\uD574, \uC5EC\uBCF4... \uD53C\uBD80\uC5D0 \uC815\uB9D0 \uC548 \uC88B\uC544.",
  "summer_Elliott": "\uBC14\uB2E4\uAC00 \uADF8\uB9AC\uC6B4 \uAC70 \uD558\uB098\uB294 \uC2E0\uC120\uD55C \uC0DD\uC120\uC774\uC57C.",
  "summer_Alex": "\uB09C \uD56D\uC0C1 \uC5EC\uB984\uC5D0 \uC81C\uC77C \uD798\uC774 \uB098\uB354\uB77C\uACE0.",
  "summer_Sam": "\uC5EC\uB984\uC774 \uB418\uBA74 \uAF2D \uBC14\uBCA0\uD050\uAC00 \uADF8\uB807\uAC8C \uBA39\uACE0 \uC2F6\uB354\uB77C.",
  "summer_Emily": "\uD734! \uC5EC\uB984\uC774 \uC815\uB9D0 \uB365\uC9C0\uB9CC \uAE30\uBD84 \uC88B\uAE34 \uD574, \uADF8\uCE58?#$e#\uC624\uB298 \uC57C\uC0DD \uC575\uBB34\uC0C8\uB97C \uBCFC \uC218 \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uB2E4.",
  "summer_Shane": "\uC624\uB298 \uD558\uB824\uB358 \uC77C\uC774 \uBB50\uB354\uB77C... \uD750\uC74C... #$e#\uBCF4\uC544\uD558\uB2C8 \uB9E4\uCF64\uD55C \uD504\uB808\uCCBC \uACFC\uC790\uB791 \uCC28\uAC00\uC6B4 \uAC70 \uBA87 \uC794\uC774 \uACC4\uD68D\uB418\uC5B4\uC788\uAD6C\uBA3C.",
  "fall_Maru": "\uC544\uC9C1 \uBCD1\uC6D0\uC5D0\uC11C \uC77C\uD558\uACE0 \uC788\uC5B4\uC11C \uAE30\uBED0... \uC8FC\uBBFC\uB4E4\uC744 \uC704\uD574 \uC911\uC694\uD55C \uC11C\uBE44\uC2A4\uB97C \uC81C\uACF5\uD574\uC8FC\uB294 \uAE30\uBD84\uC774\uC57C.",
  "fall_Abigail": "\uC62C\uD574 \uC6B0\uB9AC \uD638\uBC15 \uD0A4\uC6B8 \uAC70\uC9C0?$h",
  "fall_Haley": "\uCF00\uC774\uD06C \uB108\uBB34 \uBA39\uACE0 \uC2F6\uC5B4.#$e#\uADFC\uB370 \uC544\uBB34 \uCF00\uC774\uD06C\uB098 \uBA39\uACE0 \uC2F6\uC740 \uAC8C \uC544\uB0D0... \uAF2D \uD551\uD06C\uC0C9\uC774\uC5B4\uC57C \uD574.",
  "fall_Leah": "\uC228 \uAE4A\uC774 \uB4E4\uC774\uB9C8\uC154\uBD10... \uB290\uAEF4\uC838? \uBC84\uC12F\uC758 \uACC4\uC808\uC774\uB77C \uB098\uB294 \uD5A5\uC774\uC57C.",
  "fall_Penny": "\uC5EC\uAE30 \uB18D\uC7A5\uC5D0 \uC788\uC73C\uB2C8 \uCC38 \uD3C9\uD654\uB86D\uB124\uC694. \uB9C8\uC744\uC5D0 \uC0B4\uC558\uC744 \uB54C\uB294 \uC790\uC5F0\uC744 \uCDA9\uBD84\uD788 \uAC10\uC0C1\uD558\uC9C0 \uBABB\uD588\uC5B4\uC694.",
  "fall_Sebastian": "\uC5B4\uBA38\uB2C8\uAED8\uC120 \uAC00\uC744\uC774\uBA74 \uD56D\uC0C1 \uC815\uB9D0 \uB9DB\uC788\uB294 \uD638\uBC15\uC8FD\uC744 \uB9CC\uB4DC\uC168\uC5B4.",
  "fall_Harvey": "\uC640\uC778 \uB9C8\uC2DC\uAE30 \uC88B\uC740 \uB0A0\uC528\uC778\uAC78.",
  "fall_Elliott": "\uC544... \uAC00\uC744. \uB530\uB73B\uD55C \uD0DC\uC591\uC774 \uD558\uB298\uC5D0 \uB0AE\uAC8C \uAC78\uB824 \uD758\uB7EC\uAC00\uBA70, \uC190 \uD754\uB4DC\uB294 \uD669\uAE08\uBE5B \uBC2D\uC5D0 \uAE34 \uADF8\uB9BC\uC790\uB97C \uB4DC\uB9AC\uC6B0\uC9C0.#$e#\uCC38 \uC544\uB984\uB2E4\uC6B4 \uACC4\uC808\uC774\uC57C, \uC548 \uADF8\uB798?",
  "fall_Alex": "\uD798\uC774 \uC5C6\uC5B4... \uB2E8\uBC31\uC9C8\uC774 \uD544\uC694\uD574.$s",
  "fall_Sam": "\uC138\uC0C1 \uB2E4\uB978 \uACF3\uC5D4 \uC5B4\uB5A4 \uC77C\uC774 \uBC8C\uC5B4\uC9C0\uACE0 \uC788\uC744\uAE4C? \uC5EC\uAE30\uC11C \uC6B0\uB9B0 \uC880 \uACE0\uB9BD\uB418\uC5B4\uC788\uB124.",
  "fall_Emily": "\uC624\uB298 \uC544\uCE68\uC5D0 \uC288\uD37C\uD478\uB4DC \uC2A4\uBB34\uB514 \uB9C8\uC168\uB354\uB2C8 \uAE30\uBD84\uC774 \uB108\uC5B4\uC5B4\uC5B4\uC5B4\uBB34 \uC88B\uC544!$h",
  "fall_Shane": "\uB0B4 \uBBF8\uB2C8 \uB0C9\uC7A5\uACE0 \uB4A4\uC5D0 \uC0C8\uB85C\uC6B4 \uC885\uC758 \uADE0\uCCB4\uAC00 \uC790\uB77C\uACE0 \uC788\uB294 \uAC83 \uAC19\uC544.#$e#\uC544 \uBB50, \uC2DC\uAE30\uC801\uC808\uD558\uC9C0, \uC548 \uADF8\uB798?",
  "winter_Maru": "\uACE7 \uC788\uC73C\uBA74 \uBD04\uC774\uB124. \uB098 \uB300\uD669 \uD30C\uC774 \uAE30\uB300\uD558\uACE0 \uC788\uC5B4.",
  "winter_Abigail": "\uB0B4 \uBC29\uC5D0\uC11C \u0027\uB300\uCD08\uC6D0\uC758 \uC655\u0027 \uD558\uB358 \uB54C \uAE30\uC5B5\uB098? \uADF8 \uC2DC\uC808 \uC815\uB9D0 \uC7AC\uBC0C\uC5C8\uC5B4.$h",
  "winter_Haley": "\uC608\uC804\uC5D0 \uC790\uAE30\uAC00 \uD53C\uD074 \uBCD1 \uC5F4\uC5B4\uC900 \uAC70 \uC0DD\uAC01\uD558\uACE0 \uC788\uC5C8\uC5B4.$h#$e#\uCC38 \uC624\uB798 \uC54C\uACE0 \uC9C0\uB0C8\uB124 \uC6B0\uB9AC.$l",
  "winter_Leah": "\uACA8\uC6B8\uC5D0 \uAF2D \uC0D0\uB7EC\uB4DC\uAC00 \uBA39\uACE0 \uC2F6\uB354\uB77C\uACE0... \uACE4\uB780\uD574, \uB9DE\uC544.",
  "winter_Penny": "\uC62C\uACA8\uC6B8\uC740 \uCC45 \uB9CE\uC774 \uC77D\uC744 \uACC4\uD68D\uC774\uC5D0\uC694.",
  "winter_Sebastian": "\uC0D8\uC740 \uC694\uC998 \uBB50 \uD558\uB824\uB098? \uC6B0\uB9AC \uCC38 \uCE5C\uD588\uB294\uB370.",
  "winter_Harvey": "\uACA8\uC6B8\uC740 \uB3C5\uAC10 \uCCA0\uC774\uB77C, \uBCD1\uC6D0 \uC77C\uC774 \uC880 \uB354 \uD798\uB4E4 \uC218 \uC788\uACA0\uB2E4. \uB0B4\uAC00 \uD639\uC2DC \uD3C9\uC18C\uBCF4\uB2E4 \uD22C\uB35C\uAC70\uB9AC\uAC8C \uB418\uBA74 \uBBF8\uB9AC \uBBF8\uC548\uD574.",
  "winter_Elliott": "\uACA8\uC6B8\uC5D0\uB294 \uAE00 \uC368\uC57C\uC9C0. \uC0AC\uC2E4, \uBCC4\uB85C \uB2EC\uB9AC\uD560 \uC77C\uC774 \uB9CE\uC9C0\uB3C4 \uC54A\uC544.",
  "winter_Alex": "\uD560\uC544\uBC84\uC9C0 \uD560\uBA38\uB2C8 \uC798 \uACC4\uC2DC\uB824\uB098. \uAC19\uC774 \uC9C0\uB0BC \uB54C \uB0B4\uAC00 \uB9CE\uC774 \uB3C4\uC640\uB4DC\uB838\uB294\uB370. \uC54C\uC796\uC544, \uBB50 \uBB34\uAC70\uC6B4 \uAC70 \uB4E4\uC5B4 \uC62C\uB9AC\uAC70\uB098 \uADF8\uB7F0 \uAC70.",
  "winter_Sam": "\uC74C\uC545\uAC00\uAC00 \uB418\uB294 \uAC74 \uC774\uC81C \uD3EC\uAE30\uD588\uC5B4. \uB09C \uC774\uC81C \uAC00\uC815\uC744 \uC9C0\uD0A4\uB294 \uB0A8\uC790\uB77C\uACE0!",
  "winter_Emily": "\uC6C1\uC2A4, \uBA38\uB9AC\uAC00 \uC5BC\uC5B4\uC11C \uB2E8\uB2E8\uD574\uC84C\uB124.$s",
  "winter_Shane": "\uC138\uC0C1\uC740 \uB113\uACE0 \uB9CE\uC740 \uAC83\uC774 \uC788\uC9C0... \uD558\uC9C0\uB9CC \uB09C \uADF8\uB0E5 \uB0B4 \uBC29\uC5D0 \uC788\uACA0\uC5B4.",
  "spouseRoom_Maru": "#$c .5#\uC870\uAE08 \uB354 \uC77C\uCC0D \uC77C\uC5B4\uB098\uC11C \uBCC4 \uC880 \uBD24\uC5B4.#$e#\uC5EC\uBCF4, \uB098 \uC624\uB298\uC740 \uB530\uB85C \uB0B4 \uD504\uB85C\uC81D\uD2B8 \uC880 \uC9C4\uD589\uD560\uAC8C.",
  "spouseRoom_Abigail": "#$c .5#\uC870\uAE08 \uC77C\uCC0D \uC77C\uC5B4\uB098\uC11C \uB370\uC774\uBE44\uB4DC \uC8FC\uB2C8\uC5B4\uD55C\uD14C \uBC25 \uC92C\uC5B4. \uC624\uB298 \uC544\uCE68 \uB9CE\uC774 \uD65C\uBC1C\uD558\uB124.#$e#\uAE30\uB2C8\uD53C\uADF8 \uB0C4\uC0C8 \uB108\uBB34 \uC2E0\uACBD \uC4F0\uC9C0 \uB9D0\uACE0.",
  "spouseRoom_Haley": "#$c .5#\uBA3C\uC800 \uC77C\uACFC \uC2DC\uC791\uD574, \uC5EC\uBCF4. \uB098 \uD654\uC7A5 \uC880 \uD558\uACE0.#$e#\uC624\uB298 \uD2B9\uBCC4\uD55C \uACC4\uD68D \uC788\uC5B4?",
  "spouseRoom_Leah": "#$c .5#\uD558\uB8E8 \uC815\uD574\uC11C \uB124 \uCD08\uC0C1\uD654 \uADF8\uB824\uC57C\uACA0\uB2E4.#$e#\uC774 \uCC3D\uBB38 \uBC16\uC73C\uB85C \uBCF4\uC774\uB294 \uD48D\uACBD\uC774 \uCC38 \uC601\uAC10\uC744 \uC8FC\uC9C0 \uC54A\uC544?",
  "spouseRoom_Penny": "#$c .5#\uD56D\uC0C1 \uB098\uB9CC\uC758 \uB3C4\uC11C\uAD00\uC744 \uAC16\uACE0 \uC2F6\uC5C8\uB294\uB370. \uC774\uAC70 \uB108\uBB34 \uB9E4\uB825\uC801\uC774\uB124\uC694.$h#$e#\uC544\uCE68\uC5D0 \uC77C\uC5B4\uB098\uBA74 \uCC45\uBD80\uD130 \uC880 \uC77D\uB294 \uAC78 \uC88B\uC544\uD574\uC694. \uB1CC\uB97C \uAE68\uC6CC\uC8FC\uB294 \uB290\uB08C\uC774\uC5D0\uC694.",
  "spouseRoom_Sebastian": "#$c .5#\uC624\uB298 \uC77C\uD560\uC9C0 \uD558\uB8E8 \uC885\uC77C \uB9CC\uD654\uB97C \uC77D\uC744\uC9C0 \uACE0\uBBFC \uC911\uC774\uC57C.#$e#\uC544, \uC6B0\uB9AC \uB0C9\uB3D9 \uD53C\uC790 \uC880 \uC788\uC5B4? \uB098 \uBC30\uACE0\uD30C.",
  "spouseRoom_Harvey": "#$c .5#\uC624\uB298 \uC8FC\uBCC0\uC5D0 \uBE44\uD589\uAE30\uB294 \uC5C6\uB124. \uADF8\uB798\uB3C4 \uAC00\uB054 \uC7A5\uBE44\uB97C \uAEBC\uB0B4\uB294 \uAC74 \uC7AC\uBC0C\uC5B4.#$e#\uC0C8\uB85C\uC6B4 \uBE44\uD589\uAE30 \uBAA8\uD615\uC744 \uB9CC\uB4DC\uB294 \uC911\uC774\uC57C. \uC804\uC5D0 \uC0B4\uB358 \uC9D1\uBCF4\uB2E4 \uC5EC\uAE30\uC11C \uD6E8\uC52C \uD3B8\uC548\uD558\uAC8C \uC791\uC5C5\uD560 \uC218 \uC788\uC5B4.",
  "spouseRoom_Elliott": "#$c .5#\uC624\uB298\uC740 \uAE00 \uC4F0\uB294\uB370 \uC9D1\uC911\uD558\uB824\uACE0.#$e#\uB0B4 \uB3C4\uC6C0 \uC5C6\uC774 \uAD1C\uCC2E\uC9C0?",
  "spouseRoom_Alex": "#$c .5#\uB0B4\uAC00 \uAC8C\uC73C\uB974\uAC8C \uC788\uB294 \uAC78 \uAC00\uB9CC\uB450\uC9C0 \uB9C8. \uB110 \uC704\uD574\uC11C \uD56D\uC0C1 \uCD5C\uC120\uC758 \uCEE8\uB514\uC158\uC744 \uC720\uC9C0\uD558\uACE0 \uC2F6\uC5B4!#$e#\uC5EC\uAE34 \uC6B4\uB3D9\uD560 \uACF5\uAC04\uC774 \uB9CE\uC544. \uADF8 \uC5B4\uB290 \uB54C\uBCF4\uB2E4 \uBE60\uB978 \uC9C4\uCC99\uC744 \uBCF4\uC774\uACE0 \uC788\uC5B4!",
  "spouseRoom_Sam": "#$c .5#\uC800 \uC624\uB798\uB41C \uAE30\uD0C0... \uC608\uC804\uAC19\uC774 \uC5F0\uC8FC\uD560 \uC5F4\uC815\uC774 \uC548 \uB098. \uD558\uC9C0\uB9CC \uAD1C\uCC2E\uC544.#$e#\uC624\uB298 \uD560 \uC77C\uC774 \uBB50\uAC00 \uC788\uC9C0?",
  "spouseRoom_Emily": "\uC624\uB298\uC740 \uC575\uBB34\uC0C8\uB791 \uC2DC\uAC04 \uC880 \uBCF4\uB0B4\uB824\uACE0. \uB2E4\uC2DC\uB294 \uB0A0 \uC218 \uC5C6\uB2E4\uB294 \uC0DD\uAC01\uC5D0 \uB9C8\uC74C\uC774 \uB108\uBB34 \uC544\uD30C.$u",
  "spouseRoom_Shane": "#$c .5#\uB9E5\uC8FC \uC544\uB2C8\uBA74 \uC0AC\uC774\uB2E4? \uC778\uC0DD\uC5D0\uC11C \uD798\uB4E0 \uACB0\uC815\uC744 \uD574\uC57C \uD560 \uB54C\uAC00 \uB9CE\uC9C0.#$e#\uC548\uB155, @. \uB09C \uC624\uB298 \uADF8\uB0E5 \uC5EC\uAE30 \uC788\uC73C\uB824\uACE0. \uC5B4... \uBC14\uB2E5\uB3C4 \uC880 \uC4F8\uAC70\uB098 \uADF8\uB7F4 \uACC4\uD68D\uC774\uC57C.",
  "Rainy_Day_Krobus": "\uC544, \uBE44\uAC00 \uC640\uC11C \uC624\uB298\uC740 \uC2B5\uD558\uB124... \uB9C8\uC74C\uC774 \uD3B8\uC548\uD574\uC838.",
  "Rainy_Night_Krobus": "\uBE57\uC18C\uB9AC\uB97C \uB4E4\uC73C\uBA74 \uD558\uC218\uB3C4 \uC0DD\uAC01\uC774 \uB098... \uD3B8\uC548\uD55C \uAE30\uBD84\uC774\uC57C.#$e#\uD558\uC218\uB3C4\uB294 \uB0B4 \uD53C\uC2E0\uCC98\uC600\uAC70\uB4E0... \uC548\uC804\uD55C \uB290\uB08C\uC774 \uB4DC\uB294 \uC7A5\uC18C. \uAC71\uC815\uD558\uC9C4 \uB9C8... \uB0B4 \uC0C8\uB85C\uC6B4 \uC9D1\uC5D0 \uB300\uD574\uC11C\uB3C4 \uAC19\uC740 \uAE30\uBD84\uC774\uC57C.",
  "Indoor_Day_Krobus": "\uB18D\uC7A5 \uC77C\uC744 \uB3D5\uACE0 \uC2F6\uC740\uB370, \uB09C \uD574\uB97C \uBCF4\uBA74 \uC548 \uB3FC\uC11C...",
  "Indoor_Night_Krobus": "\uC548\uB155, @. \uB3CC\uC544\uC628 \uAC78 \uD658\uC601\uD574. \uC5F4\uC2EC\uD788 \uC77C\uD558\uB2E4 \uC654\uAD6C\uB098!$h",
  "Outdoor_Krobus": "\uC774\uB7F0 \uB0A0\uC740 \uAC19\uC774 \uBC16\uC5D0 \uC788\uC744 \uC218 \uC788\uC5B4. \uC815\uB9D0 \uC88B\uC544!$h#$b#\uADF8\uB7F0\uB370 \uD639\uC2DC \uB204\uAC00 \uC624\uB294 \uAC8C \uBCF4\uC774\uBA74 \uC54C\uB824\uC918, \uC5BC\uB978 \uC228\uC744 \uC218 \uC788\uAC8C.$u",
  "NoBed_0": "\uB09C \uC774\uC81C \uC5B4\uB514\uC11C \uC790\uC57C \uD558\uC9C0...?$s",
  "NoBed_1": "\uC9C0\uB09C\uBC24 \uD479 \uC798 \uC218\uAC00 \uC5C6\uC5C8\uC5B4...$s",
  "NoBed_2": "\uBC14\uB2E5\uC5D0\uC11C \uC790\uC57C \uD558\uB294 \uC2E0\uC138\uB77C\uB2C8...$s",
  "NoBed_3": "\uC6B0\uB9AC \uCE68\uB300\uB294...?$s"
}