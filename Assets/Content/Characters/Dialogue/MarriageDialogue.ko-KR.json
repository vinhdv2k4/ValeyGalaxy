{
  "Rainy_Day_0": "\uBC16\uC5D0 \uBE44 \uC624\uB124. \uAC10\uAE30 \uAC78\uB9AC\uC9C0 \uC54A\uAC8C \uC870\uC2EC\uD574, \uC5EC\uBCF4.#$e#\uCD5C\uB300\uD55C \uC2E4\uB0B4\uC5D0 \uC788\uACE0.$h#$e#\uAC00\uB054 \uB2F9\uC2E0 \uAC71\uC815\uB41C\uB2E4\uB2C8\uAE4C!",
  "Rainy_Day_1": "\uBE44\uAC00 \uC624\uB124! \uC624\uB298 \uC791\uBB3C\uC5D0 \uBB3C\uC740 \uC548 \uC918\uB3C4 \uB418\uACA0\uB2E4.$h#$e#\uB300\uC790\uC5F0\uC774 \uAC00\uB054 \uD070 \uB3C4\uC6C0\uC774 \uB418\uB124.#$e#\uC5EC\uBCF4, \uB3D9\uBB3C\uB4E4 \uC0AC\uB8CC\uB294 \uC92C\uC5B4?",
  "Rainy_Day_2": "\uC88B\uC740 \uC544\uCE68! \uBE57\uC18C\uB9AC\uC5D0 \uC77C\uCC0D \uAE68\uC11C \uC544\uCE68 \uC880 \uB9CC\uB4E4\uC5C8\uC5B4. [194 195 210 211 216]  #$e#\uB530\uB73B\uD558\uAC8C \uC788\uACE0 \uB108\uBB34 \uBB34\uB9AC\uD558\uC9C0 \uB9C8. \uB2F9\uC2E0\uC774 \uAC74\uAC15\uD588\uC73C\uBA74 \uC88B\uACA0\uC5B4.",
  "Rainy_Day_3": "\uC624\uB298 \uD560 \uC77C\uC740 \uBB54\uAC00\uC694, \uC5EC\uBCF4?#$e#\uC774\uB7F0 \uB0A0\uC528\uC5D0 \uBC16\uC5D0 \uB098\uAC00\uAE34 \uC2EB\uB2E4... \uC9D1\uC548\uC77C\uC5D0 \uC9D1\uC911\uD574\uC57C\uC9C0.#$e#\uC800\uB141\uC2DD\uC0AC\uB294 \uB530\uB73B\uD55C \uAC78\uB85C \uC900\uBE44\uD574\uC57C\uACA0\uB2E4.",
  "Rainy_Day_4": "\uC624\uB298 \uC800\uB141\uC5D0 \uD2B9\uBCC4\uD788 \uBA39\uACE0 \uC2F6\uC740 \uAC70 \uC788\uC5B4?",
  "Rainy_Day_Maru": "\uAE30\uC220\uC774 \uC544\uBB34\uB9AC \uBC1C\uB2EC\uD588\uB2E4\uC9C0\uB9CC, \uBE44\uB9CC\uD07C \uC791\uBB3C\uC5D0 \uBB3C\uC744 \uC798 \uC8FC\uB294 \uAC8C \uC5C6\uC5B4.",
  "Rainy_Day_Abigail": "\uC2DC\uACE8 \uD48D\uACBD\uC774 \uC774\uB7F0 \uB0A0\uC528\uC5D0 \uB354 \uD765\uBBF8\uB85C\uC6CC \uBCF4\uC5EC, \uC548 \uADF8\uB798?",
  "Rainy_Day_Penny": "\uC624\uB298\uC740 \uBE75 \uC880 \uAD6C\uC6B8\uAE4C \uD574\uC694.$h",
  "Rainy_Day_Leah": "\uC624\uB298\uC740 \uB09A\uC2DC\uB098 \uAD11\uC0B0 \uAC00\uC57C\uACA0\uB124, \uADF8\uCE58?",
  "Rainy_Day_Haley": "\uD750\uC74C. \uB0A0\uC528\uAC00 \uACC4\uC18D \uC774\uB7EC\uBA74 \uB098 \uB108\uBB34 \uCC3D\uBC31\uD574\uC9C8 \uD150\uB370.$s",
  "Rainy_Day_Harvey": "\uC624\uB298 \uAF2D \uBE44 \uB9CE\uC774 \uC548 \uB9DE\uB3C4\uB85D \uC870\uC2EC\uD574, \uC5EC\uBCF4. \uCCB4\uC628 \uB5A8\uC5B4\uC9C0\uBA74 \uC548 \uB3FC.",
  "Rainy_Day_Sebastian": "\uC0C8\uBCBD\uC5D0 \uD574 \uB728\uAE30 \uC804\uC5D0 \uC77C\uC5B4\uB098\uC11C \uB18D\uC7A5 \uC8FC\uBCC0 \uC7A0\uAE50 \uC0B0\uCC45\uD588\uC5B4. \uADF8 \uC2DC\uAC04\uC5D4 \uC815\uB9D0 \uD3C9\uD654\uB85C\uC6CC.",
  "Rainy_Day_Alex": "\uD760... \uC624\uB298\uC740 \uC2E4\uB0B4\uC5D0\uC11C \uD314\uAD7D\uD600\uD3B4\uAE30\uB791 \uC717\uBAB8\uC77C\uC73C\uD0A4\uAE30 \uD574\uC57C\uACA0\uB124.",
  "Rainy_Day_Elliott": "\uBE44\uAC00 \uC624\uB2C8 \uD574\uBCC0\uC5D0\uC11C \uC0B4\uB358 \uC0B6\uC774 \uC0DD\uAC01\uB098\uB124.#$e#\uBCC0\uD654\uB294 \uC0B6\uC758 \uC77C\uBD80\uC9C0. \uC88B\uC740 \uC77C\uC774\uC57C.",
  "Rainy_Day_Sam": "\uC624\uB298\uC740 \uC9C0\uBD95\uC774\uB098 \uCC3D\uBB38 \uC0C8\uB294 \uACF3 \uC788\uB098 \uCC3E\uC544\uBCF4\uACE0 \uACE0\uCCD0\uC57C\uACA0\uB2E4.",
  "Rainy_Day_Emily": "\uC77C\uC5D0 \uC790\uBD80\uC2EC\uC744 \uB290\uB07C\uB294 \uAC74 \uC54C\uC9C0\uB9CC, \uC624\uB298\uC740 \uB108\uBB34 \uBB34\uB9AC\uD558\uC9C0 \uB9C8. \uC54C\uC558\uC9C0, \uC5EC\uBCF4?$u",
  "Rainy_Day_Shane": "\uC9C0\uBD95\uC774 \uC0CC\uB2E4\uACE0? \uC544 \uBB50... \uACF0\uD321\uC774 \uC870\uAE08 \uD53C\uC5B4\uB3C4 \uC548 \uC8FD\uC5B4.",
  "Rainy_Night_0": "\uBE44\uAC00 \uC624\uB2C8\uAE4C \uC138\uC0C1\uC5D0 \uC6B0\uB9AC \uB458\uBFD0\uC778 \uAC83 \uAC19\uC544.$l#$e#\uCD94\uC6CC... \uC790\uB7EC \uAC08\uAE4C?$l",
  "Rainy_Night_1": "\uAF2D \uB530\uB73B\uD55C \uC637\uC73C\uB85C \uAC08\uC544\uC785\uC5B4. \uC544\uD504\uBA74 \uC548 \uB3FC.#$e#@\uC544(\uC57C), \uC9C0\uBD95\uC5D0 \uB5A8\uC5B4\uC9C0\uB294 \uBE57\uC18C\uB9AC \uB4E4\uB824?",
  "Rainy_Night_2": "\uC544...\uBE44 \uB5A8\uC5B4\uC9C0\uB294 \uC794\uC794\uD55C \uC18C\uB9AC... \uC624\uB298 \uBC24\uC740 \uD479 \uC790\uACA0\uB2E4.$h",
  "Rainy_Night_3": "\uBE44 \uC624\uBA74 \uC9D1\uC774 \uB108\uBB34 \uC544\uB291\uD574 \uBCF4\uC5EC.$h^\uC774\uB7F0 \uBC24\uC774\uBA74 \uC6B0\uB9AC \uC9C0\uBD95\uC774 \uD2BC\uD2BC\uD55C \uAC8C \uB108\uBB34 \uB4E0\uB4E0\uD574.",
  "Rainy_Night_4": "\uC800\uB141\uC73C\uB85C \uC2A4\uD504 \uC880 \uB9CC\uB4E4\uC5C8\uC5B4. [199 218 219 727 730]$h#$e#\uC774\uB7F0 \uB0A0\uC740 \uB530\uB73B\uD558\uAC8C \uBA39\uC5B4\uC57C\uC9C0!$h",
  "Rainy_Night_5": "\uC790\uAE30\uAC00 \uC5EC\uAE30 \uC788\uC5B4\uC11C \uB108\uBB34 \uC88B\uB2E4... \uC9D1\uC5D0 \uC788\uAE30 \uC88B\uC740 \uBC24\uC774\uC57C.",
  "Rainy_Night_Maru": "\uC624\uB298 \uD558\uB824\uB358 \uC77C\uC740 \uB9CE\uC774 \uC774\uB918\uC5B4, \uC790\uAE30\uC57C?#$e#\uB09C \uC9D1 \uC8FC\uBCC0 \uC774\uAC83\uC800\uAC83 \uACE0\uCE58\uB824\uACE0 \uD574\uBD24\uC5B4... \uC54C\uC796\uC544, \uC791\uC740 \uAC70 \uC774\uAC83\uC800\uAC83.",
  "Rainy_Night_Abigail": "\uB108 \uC798 \uC900\uBE44\uB410\uC73C\uBA74 \uB098\uB3C4 \uC900\uBE44\uB418\uC5C8\uC5B4. \uBE57\uC18C\uB9AC \uB54C\uBB38\uC5D0 \uBC14\uB85C \uC7A0\uB4E4\uACA0\uB2E4.",
  "Rainy_Night_Penny": "\uC544... \uB0C4\uC0C8\uC694? \uBE75\uC744 \uC880 \uAD6C\uC6B0\uB824\uACE0 \uD588\uB294\uB370... \uC798 \uC548\uB410\uC5B4\uC694.$s",
  "Rainy_Night_Leah": "\uC624\uB298 \uD558\uB8E8\uB294 \uC5B4\uB560\uC5B4, \uC5EC\uBCF4? \uC9C4\uD759\uD22C\uC131\uC774\uC600\uC5B4?",
  "Rainy_Night_Haley": "\uC548\uB155, \uC790\uAE30\uC57C. \uC9D1\uC5D0 \uB3CC\uC544\uC640\uC11C \uB108\uBB34 \uC88B\uB2E4. \uB098 \uC880 \uC678\uB85C\uC6CC\uC9C0\uACE0 \uC788\uC5C8\uC5B4.$l",
  "Rainy_Night_Harvey": "\uC548\uB155. \uC624\uB298 \uD558\uB8E8 \uAD1C\uCC2E\uC558\uC5B4?$h#$e#\uC624\uB298\uC740 \uC758\uD559\uD559\uC220\uC9C0 \uBCF4\uBA74\uC11C \uBCF4\uB0C8\uC5B4.",
  "Rainy_Night_Sebastian": "\uBE44\uB294 \uBD10\uB3C4 \uBD10\uB3C4 \uC9C8\uB9AC\uC9C0 \uC54A\uC544... \uD2B9\uD788 \uC774\uB807\uAC8C \uC2DC\uACE8\uC5D0\uC120.",
  "Rainy_Night_Alex": "\uD560\uBA38\uB2C8\uAED8\uC11C \uC774\uB7F0 \uBC24\uC5D0\uB294 \uD56D\uC0C1 \uC2A4\uD29C\uB97C \uB9CC\uB4E4\uACE4 \uD558\uC168\uC9C0.$h",
  "Rainy_Night_Elliott": "\uC549\uC544, \uC26C\uC5B4! \uC885\uC77C \uC9C4\uD759\uD0D5\uC5D0\uC11C \uD798\uC4F0\uB290\uB77C \uC9C0\uCCE4\uACA0\uC5B4.",
  "Rainy_Night_Sam": "\uBE48\uC13C\uD2B8\uD55C\uD14C \uC804\uD654 \uC654\uC5B4. \uB098 \uBCF4\uACE0 \uC2F6\uB2E4\uACE0 \uD588\uACE0 \uB108\uD55C\uD14C \uC548\uBD80 \uC804\uD574\uB2EC\uB798.$h",
  "Rainy_Night_Shane": "\uC7AC\uC2A4\uB791 \uB9C8\uB2C8\uB791 \uBC29\uAE08 \uD1B5\uD654\uD588\uB294\uB370. \uB098 \uC5C6\uC774\uB3C4 \uC798 \uC9C0\uB0B4\uACE0 \uC788\uB294 \uAC83 \uAC19\uB124.",
  "Rainy_Night_Emily": "\uBA87\uBA87 \uC815\uB839\uC740 \uBE44\uAC00 \uC62C \uB54C\uB9CC \uB098\uD0C0\uB09C\uB300. \uADF8\uB4E4\uC758 \uC18C\uB9AC\uB97C \uB4E4\uC5B4\uBCF8 \uC801 \uC788\uC5B4?",
  "Indoor_Day_0": "\uC88B\uC740 \uC544\uCE68 ~\u003C$h#$e#\uC624\uB298 \uC5F4\uC2EC\uD788 \uC77C\uD560 \uC900\uBE44\uB418\uC5C8\uC5B4? \uB09C \uB418\uC5C8\uC9C0.$h",
  "Indoor_Day_1": "\uC548\uB155, \uC5EC\uBCF4! \uB0C4\uC0C8 \uC88B\uC9C0, \uADF8\uCE58? \uC544\uCE68 \uCC28\uB838\uC5B4! [194 195 210 211 216]#$e#\uC885\uC77C \uD798\uC4F0\uB824\uBA74 \uC544\uCE68\uBD80\uD130 \uB4E0\uB4E0\uD558\uAC8C \uBA39\uC5B4\uC57C\uC9C0.",
  "Indoor_Day_2": "\uC7A0\uC740 \uC798 \uC7A4\uC5B4?#$e#\uD574\uC57C \uD558\uB294 \uC9D1\uC548\uC77C\uC774 \uC880 \uC788\uC5B4.",
  "Indoor_Day_3": "\uC5B4\uC82F\uBC24\uC5D0 \uC774\uC0C1\uD55C \uAFC8\uAFE8\uC5B4?#$e#\uB09C \uD558\uB098 \uAFE8\uB294\uB370, \uAE30\uC5B5\uB098\uB294 \uAC8C %adj %noun\uC5D0 \uAD00\uB828\uB41C \uAFC8\uC774\uC5C8\uB2E4\uB294 \uAC83 \uBC16\uC5D0 \uC5C6\uC5B4. \uC774\uC0C1\uD558\uC9C0.$s#$e#\uD5E4\uD5E4. \uAFC8\uC740 \uBCC4 \uC758\uBBF8\uAC00 \uC5C6\uC73C\uB2C8\uAE4C... \uC544\uB2CC\uAC00?$l#$e#\uBB50, \uD558\uB8E8 \uC885\uC77C \uC218\uB2E4\uB9CC \uB5A8 \uC218\uB294 \uC5C6\uC9C0. \uC77C\uD558\uB7EC \uAC00\uC57C\uC9C0!",
  "Indoor_Day_4": "\uC88B\uC740 \uC544\uCE68\uC774\uC57C, \uC5EC\uBCF4. \uB18D\uC7A5 \uC77C\uB85C \uAC00\uB4DD\uD55C \uD558\uB8E8\uAC00 \uB418\uACA0\uB124, \uADF8\uCE58?#$e#\uC751\uC6D0\uD560\uAC8C. \u003C$h",
  "Indoor_Day_Maru": "\uC791\uBB3C \uC0DD\uC0B0\uC744 \uCD5C\uC801\uD654 \uC2DC\uD0A4\uB294 \uC77C\uC774\uB77C\uB358\uAC00 \uADF8\uB7F0 \uC598\uAE30\uB97C \uD558\uACE0 \uC2F6\uB2E4\uBA74... \uC5B8\uC81C\uB77C\uB3C4 \uD658\uC601\uC774\uC57C!",
  "Indoor_Day_Abigail": "\uD56D\uC0C1 \uB18D\uC7A5\uC5D0\uC11C \uBB34\uC5B8\uAC00 \uC0C8\uB85C\uC6B4 \uC77C\uC774 \uC77C\uC5B4\uB098\uACE0 \uC788\uC5B4... \uB108\uBB34 \uC88B\uC544.",
  "Indoor_Day_Penny": "\uD2B8\uB808\uC77C\uB7EC\uC5D0 \uBE44\uD558\uBA74 \uC774\uACF3\uC740 \uC815\uB9D0 \uCEE4\uC694, \uC880 \uC555\uB3C4\uC801\uC774\uB124\uC694... \uC88B\uC740 \uC758\uBBF8\uB85C\uC694!",
  "Indoor_Day_Leah": "\uAC74\uCD95\uBB3C\uC5D0 \uBAA9\uACF5 \uC791\uC5C5\uC744 \uC880 \uC9C4\uD589\uD574\uB3C4 \uAD1C\uCC2E\uC744\uAE4C? \uB04C\uC9C8\uD558\uACE0 \uC2F6\uC5B4\uC11C \uC190\uC774 \uADFC\uC9C8\uADFC\uC9C8\uD574!",
  "Indoor_Day_Haley": "\uD654\uCC3D\uD55C \uB0A0\uC5D0\uB294 \uD56D\uC0C1 \uD589\uBCF5\uD574.$h",
  "Indoor_Day_Harvey": "\uD558\uB298 \uC624\uB298 \uC5C4\uCCAD\uB09C\uAC78... \uC544\uC8FC \uB9D1\uC544!#$e#\uC774\uC81C\uBD80\uD130\uB294 \uC608\uC57D\uC9C4\uB8CC\uAC00 \uC788\uC744 \uB54C\uB9CC \uBCD1\uC6D0\uC744 \uAC00\uC57C\uACA0\uC5B4. \uB098\uBA38\uC9C0 \uC77C\uC740 \uC9D1\uC5D0\uC11C \uD558\uBA74 \uB418\uB2C8\uAE4C!",
  "Indoor_Day_Sebastian": "\uBB50, \uC804\uC5D0 \uC0B4\uB358 \uC9C0\uD558\uC2E4\uC5D0 \uBE44\uD558\uBA74 \uC5EC\uAE30\uAC00 \uD6E8\uC52C \uC88B\uC740 \uAC78, \uC548 \uADF8\uB798?$h",
  "Indoor_Day_Alex": "\uD574\uAC00 \uBE5B\uB098\uACE0 \uC788\uACE0 \uB09C \uD65C\uB825\uC774 \uB118\uCE58\uACE0 \uC788\uC5B4! \uC870\uC2EC\uD558\uB77C\uACE0! \uD5E4 \uD5E4.$h",
  "Indoor_Day_Elliott": "\uC6B0\uB9AC \uAC19\uC774 \uC0B4\uAE30 \uC2DC\uC791\uD558\uACE0\uBD80\uD130 \uACC4\uC18D \uC77C\uAE30\uB97C \uC4F0\uACE0 \uC788\uC5B4. \uC2E4\uC81C\uB85C \uC77C\uC0C1\uC774\uB780 \uAC8C \uC0DD\uAE30\uB2E4 \uBCF4\uB2C8\uAE4C, \uC815\uB9D0 \uC4F8 \uAE00\uC774 \uB9CE\uC544\uC84C\uC5B4.$h#$e#\uC774 \uC2DC\uAC04\uC740 \uC5B8\uC81C\uAE4C\uC9C0\uB77C\uB3C4 \uAF2D \uAE30\uC5B5\uD558\uACE0 \uC2F6\uC5B4.",
  "Indoor_Day_Sam": "\uC624\uB298 \uB05D\uB0B4\uACE0 \uC2F6\uC740 \uC77C\uC774 \uB108\uBB34 \uB9CE\uC544... \uADF8\uB0E5 \uD2F0\uBE44\uB098 \uBCFC\uAE4C.",
  "Indoor_Day_Emily": "\uC2E0\uC120\uD558\uACE0 \uAC74\uAC15\uD55C \uC791\uBB3C\uC744 \uC8FC\uBBFC\uB4E4\uC5D0\uAC8C \uC81C\uACF5\uD574\uC8FC\uB2C8\uAE4C \uC6B0\uB9B0 \uD070 \uB3C4\uC6C0\uC744 \uC8FC\uACE0 \uC788\uB294 \uAC70\uC57C!",
  "Indoor_Day_Shane": "\uBB54\uAC00 \uD2B9\uBCC4\uD55C \uB0C4\uC0C8\uAC00 \uB098\uB294\uB370... *\uD081*... \uBB58\uAE4C? \uC624...#$b#\uC544, \uB0B4\uAC00 \uBA87 \uC8FC \uC804\uC5D0 \uB123\uC5B4\uB454 \uCF58\uCE69\uC774\uAD6C\uB098. *\uC624\uB3C4\uB3C5*",
  "Indoor_Night_0": "\uC624\uB298 \uD558\uB824\uB358 \uAC74 \uB2E4 \uD588\uC5B4, @\uC544(\uC57C)?#$e#\uB09C \uC9D1\uC548\uC77C \uC880 \uD588\uC5B4... \uADF8\uB7F0\uB370 \uC774\uC820 \uB108\uBB34 \uD798\uB4DC\uB124.#$e#\uC798 \uC900\uBE44\uD558\uACE0 \uBC14\uB85C \uC790\uC790.$h",
  "Indoor_Night_1": "\uC640, \uC624\uB298 \uC77C \uC815\uB9D0 \uB9CE\uC774 \uD588\uB124.#$e#\uC624\uB298 \uBC24\uC740 \uB290\uAE0B\uD558\uAC8C \uC26C\uC790.$h",
  "Indoor_Night_2": "\uC9D1\uC5D0 \uC640\uC11C \uB2E4\uD589\uC774\uC57C.#$e#\uC0AC\uC2E4 \uBC24\uC5D0 \uD63C\uC790 \uC788\uC73C\uBA74 \uC880 \uBB34\uC11C\uC6CC.$s^\uBC24\uC5D0 \uD63C\uC790 \uC788\uC73C\uBA74 \uC678\uB85C\uC6CC...$s#$e#...$h",
  "Indoor_Night_3": "\uC624\uB298 \uC77C\uC740 \uB2E4 \uB9C8\uCE5C \uAC70\uC57C? \uB098\uB791 \uB180\uC790 \uC774\uC81C.$h#$e#\uADFC\uB370 \uC9C0\uCCE4\uB2E4\uBA74 \uC774\uD574\uD574.",
  "Indoor_Night_4": "*\uD734*! \uC9D1\uC548\uC77C \uB2E4 \uB9C8\uCCE4\uB2E4. \uC774\uC81C \uC6B0\uB9AC \uC2DC\uAC04 \uC880 \uBCF4\uB0BC\uAE4C?$h#$e#\uC624\uB298 \uD558\uB8E8\uB294 \uC5B4\uB560\uC5B4? \uC598\uAE30 \uB4E3\uACE0 \uC2F6\uC5B4.$l#$e#...$h",
  "Indoor_Night_Maru": "@, \uB2F9\uC7A5\uC774\uB77C\uB3C4 \uC798 \uAC83 \uAC19\uC740 \uC5BC\uAD74\uC774\uB124. \uB0B4 \uCD5C\uADFC \uD504\uB85C\uC81D\uD2B8\uC758 \uAE30\uC220\uC801\uC778 \uC138\uBD80\uC0AC\uD56D\uC744 \uB4E4\uB824\uC918\uC11C \uC7A0\uC7AC\uC6CC\uC904\uAE4C?$h#$e#*\uD558\uD488*... \uC194\uC9C1\uD788, \uB098\uB3C4 \uC880 \uC878\uB824.",
  "Indoor_Night_Abigail": "\uACE7 \uC7A0\uB4E4 \uC900\uBE44\uB418\uC5C8\uC5B4? \uC804\uAE30\uC7A5\uD310 \uCF1C\uB1A8\uC5B4...$l",
  "Indoor_Night_Penny": "\uC5EC\uBCF4, \uC548\uB155. \uC9D1\uC5D0\uC11C \uC870\uC6A9\uD55C \uC800\uB141\uC744 \uBCF4\uB0BC\uAE4C\uC694?",
  "Indoor_Night_Leah": "\uBC24\uC5D0 \uCC38 \uC870\uC6A9\uD558\uACE0 \uD3C9\uD654\uB85C\uC6CC. \uC0B6\uC758 \uD55C\uC21C\uAC04 \uD55C\uC21C\uAC04\uC5D0 \uC9D1\uC911\uD560 \uC218 \uC788\uB294 \uB290\uB08C\uC774\uB784\uAE4C.",
  "Indoor_Night_Haley": "\uC790\uAE30, \uC5F4\uC2EC\uD788 \uC77C\uD558\uACE0 \uC654\uAD6C\uB098. \uC2A4\uD2B8\uB808\uC2A4 \uD478\uB294 \uAC70 \uB3C4\uC640\uC904\uAC8C.$l",
  "Indoor_Night_Harvey": "\uC624\uB298 \uBC24\uC740 \uB9C8\uC0AC\uC9C0 \uC81C\uB300\uB85C \uBC1B\uC544\uC57C\uACA0\uB294\uAC78.$l#$e#\uC758\uC0AC\uC758 \uAD8C\uACE0\uC57C \uC774\uAC74... \uD608\uC561\uC21C\uD658\uC5D0 \uB3C4\uC6C0\uC774 \uB41C\uB2E4\uACE0!",
  "Indoor_Night_Sebastian": "#$c .5#\uB0B4\uAC00 \uC880 \uC740\uB454\uC790\uC774\uAE34 \uD558\uC9C0\uB9CC, \uB124\uAC00 \uC788\uC744 \uB54C\uB294 \uC5B8\uC81C\uB77C\uB3C4 \uC88B\uC544.$h#$e#\uC548\uB155, @. \uC5B8\uC81C \uBD10\uB3C4 \uC88B\uB124. \uB124 \uACC1\uC5D0 \uC788\uC73C\uBA74 \uD3B8\uC548\uD574.$h",
  "Indoor_Night_Alex": "\uD314\uC774 \uAC00\uB9CC\uC788\uC9C8 \uBABB\uD558\uACA0\uB124... \uB9C8\uC0AC\uC9C0 \uAE38\uACE0 \uC9C4\uD558\uAC8C \uD574\uC904\uAE4C?$l^\uAE30\uC9C4\uB9E5\uC9C4\uC774\uC57C... \uC88B\uC740 \uC77C\uC774\uC9C0! \uC624\uB298 \uC5F4\uC2EC\uD788 \uC77C\uD588\uB2E4\uB294 \uB73B\uC774\uB2C8\uAE4C.$h",
  "Indoor_Night_Elliott": "#$c .5#\uC5F4\uC2EC\uD788 \uC77C\uD558\uACE0 \uC628 \uB0A0 \uB0C4\uC0C8\uAC00 \uB108\uBB34 \uC88B\uB354\uB77C. \uB124 \uC790\uC5F0 \uD5A5\uC774\uC57C!^\uC5EC\uBCF4, \uB2EC\uCF64\uD55C \uB0C4\uC0C8\uB09C\uB2E4. \uD5A5 \uC9C4\uD55C \uCC28 \uC704\uC5D0 \uB5A0\uC788\uB294 \uBC8C\uC9D1 \uD55C \uC870\uAC01 \uAC19\uC544.#$e#\uC774\uB9AC \uC640, \uB4F1 \uB9C8\uC0AC\uC9C0\uD574\uC904\uAC8C. \uBB49\uCE58\uACA0\uB2E4.$l^\uC5EC\uBCF4, \uB2EC\uCF64\uD55C \uB0C4\uC0C8\uB09C\uB2E4. \uC5EC\uB984\uCCA0 \uC0B0\uB4E4\uBC14\uB78C\uC5D0 \uB5A0\uAC00\uB294 \uACC4\uD53C \uD55C \uC78E\uC0AC\uADC0 \uAC19\uC544.",
  "Indoor_Night_Sam": "#$c .5#\uC624\uB298 \uBC24 \uB2EC\uC774 \uBCF4\uC774\uB824\uB098?#$e#\uB18D\uC7A5\uC5D0\uC11C \uD558\uB824\uB358 \uC77C\uC740 \uB2E4 \uB9C8\uCCE4\uC5B4? \uBABB\uD588\uB2E4\uACE0 \uB0B4\uAC00 \uD654\uB0B8\uB2E4\uAC70\uB098 \uADF8\uB7F0 \uAC74 \uC544\uB2C8\uACE0!",
  "Indoor_Night_Emily": "\uC9D1 \uC815\uB9D0 \uC544\uB291\uD574... \uB9C8\uC74C\uC5D0 \uB4E4\uC5B4.",
  "Indoor_Night_Shane": "\uC624\uB298 \uD558\uB8E8 \uC5B4\uB560\uC5B4? \uB09C \uAF64 \uAD1C\uCC2E\uC558\uC5B4.",
  "Outdoor_0": "\uC624\uB298 \uB0A0\uC774 \uC815\uB9D0 \uC544\uB984\uB2F5\uB124.$h#$e#\uC774\uB7F0 \uB0A0\uC740 \uC77C\uD560 \uB54C\uB3C4 \uAE30\uBD84\uC774 \uB354 \uCF8C\uC801\uD558\uC9C0.",
  "Outdoor_1": "\uB098 \uC624\uB298\uC740 \uC880 \uC26C\uBA74\uC11C \uB18D\uC7A5 \uB458\uB7EC\uBCF4\uB824\uACE0.#$e#\uC5EC\uAE30 \uC8FC\uBCC0\uC774 \uB108\uBB34 \uBCF4\uAE30 \uC88B\uC740 \uAC83 \uAC19\uC544.$h",
  "Outdoor_2": "\uC5EC\uBCF4 \uC548\uB155! \uB18D\uC7A5 \uC77C\uC5D0 \uB300\uD574 \uB354 \uC54C\uC558\uC73C\uBA74 \uB354 \uB3C4\uC640\uC904 \uC218 \uC788\uC744 \uD150\uB370. \uBBF8\uC548!#$e#\uC790\uAE30 \uC0DD\uAC01\uD558\uACE0 \uC788\uC744\uAC8C.$h",
  "Outdoor_3": "\uC774\uCABD\uC5D0\uC11C \uBA3C\uC9C0 \uC880 \uCE58\uC6B0\uACE0 \uC788\uC744\uAC8C. \uB3C4\uC6C0\uC774 \uC880 \uB418\uACA0\uC9C0, \uADF8\uCE58?#$e#*\uD734*... \uBC16\uC5D0 \uB365\uB2E4.",
