  "spring_Leah": "\uBC16\uC5D0 \uB2E4\uB2C8\uB294 \uB3D9\uC548 \uC57C\uC0DD \uACE0\uCD94\uB0C9\uC774\uB791 \uB9AC\uD06C\uB791 \uBBFC\uB4E4\uB808 \uC788\uB098 \uAF2D \uBCF4\uACE0!",
  "spring_Penny": "\uC628\uD1B5 \uD770\uC0C9\uBFD0\uC778 \uAE34 \uACA8\uC6B8\uC774 \uC9C0\uB098\uACE0 \uB179\uC0C9\uC774 \uC880 \uBCF4\uC774\uB2C8 \uAE30\uC058\uB124\uC694.",
  "spring_Sebastian": "\uC640, \uB098 \uCC3D\uBC31\uD574\uC84C\uB124... \uC774\uBC88 \uACC4\uC808\uC740 \uB18D\uC7A5 \uC77C \uAF2D \uB3C4\uC640\uC918\uC57C\uACA0\uC5B4.",
  "spring_Harvey": "\uC62C\uBD04\uC740 \uAC74\uAC15\uD55C \uCC44\uC18C \uB9CE\uC774 \uAE30\uB974\uC790\uACE0.$h",
  "spring_Elliott": "%farm \uB18D\uC7A5\uC5D0\uC11C \uB610 \uD558\uB098\uC758 \uC544\uB984\uB2E4\uC6B4 \uD55C \uD574\uB97C \uAE30\uB300\uD558\uACE0 \uC788\uC5B4.$h",
  "spring_Alex": "\uC57C @. \uC624\uB298\uB3C4 \uC5F4\uC2EC\uD788 \uD558\uC790\uACE0!",
  "spring_Sam": "*\uD081* ... \uB098 \uCF54 \uB9C9\uD600... \uC54C\uB7EC\uC9C0.",
  "spring_Shane": "\uC62C\uD574\uB294 \uC0C8\uB85C\uC6B4 \uAC78 \uBC30\uC6CC\uBCFC\uAE4C...",
  "summer_Maru": "\uBCC4 \uBCF4\uAE30\uC5D0 \uC88B\uC740 \uACC4\uC808\uC774\uB124.",
  "summer_Abigail": "\uC624... \uCD08\uCF5C\uB9BF \uCF00\uC774\uD06C \uBA39\uACE0\uC2F6\uB2E4.",
  "summer_Haley": "\uC9C0\uAE08\uCBE4\uC774\uBA74 \uB0B4\uAC00 \uC5EC\uB984\uC744 \uC81C\uC77C \uC88B\uC544\uD55C\uB2E4\uB294 \uAC83\uC744 \uC54C\uACA0\uC9C0.$h",
  "summer_Leah": "\uC5EC\uB984\uC774\uB791 \uB531 \uC5B4\uC6B8\uB9AC\uB294 \uAC74 \uB2EC\uCF64\uD55C \uC640\uC778\uC774\uC9C0. \uC548 \uADF8\uB798 \uC5EC\uBCF4?",
  "summer_Penny": "\uC62C\uC5EC\uB984\uC5D0 \uBA5C\uB860 \uD0A4\uC6B0\uB098\uC694?",
