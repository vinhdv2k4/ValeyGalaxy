  "Good_3": "\uC624\uB298 \uC65C \uC774\uB807\uAC8C \uC798\uC0DD\uACBC\uC5B4!$l^\uC624\uB298 \uC65C \uC774\uB807\uAC8C \uC544\uB984\uB2E4\uC6CC.$l",
  "Good_4": "\uC5EC\uAE30\uAC00 \uC774\uC81C \uB0B4 \uC9D1\uC774\uC57C... \uC5EC\uAE30\uC11C \uB09C \uD589\uBCF5\uD574.$l",
  "Good_5": "\uACB0\uD63C \uD39C\uB358\uD2B8 \uAC10\uC0C1\uD558\uACE0 \uC788\uC5C8\uC5B4... \uAECD\uB370\uAE30\uAC00 \uD2F0 \uD558\uB098 \uC5C6\uB124. \uC774\uAC70 \uC544\uC8FC \uBE44\uC30C\uACA0\uB294\uB370!$l",
  "Good_6": "\uD56D\uC0C1 \uC870\uC2EC\uD558\uACE0! \uAC00\uB054 \uAC31\uB3C4\uC5D0 \uB5A8\uC5B4\uC9C8\uAE4C \uBD10 \uAC71\uC815\uB3FC.",
  "Good_7": "@? \uC6B0\uB9AC \uC9D1\uC548\uC744 \uC704\uD574\uC11C \uB124\uAC00 \uD558\uB294 \uBAA8\uB4E0 \uC77C\uC5D0 \uD56D\uC0C1 \uACE0\uB9D9\uB2E4\uACE0 \uC598\uAE30\uD558\uACE0 \uC2F6\uC5C8\uC5B4.$h",
  "Good_8": "\uB09C \uB108\uBB34 \uAC71\uC815\uD558\uC9C0 \uB9D0\uACE0... \uB124\uAC00 \uCC45\uC784\uC9C0\uACE0\uD574\uC57C \uD560 \uC77C\uC774 \uB9CE\uB2E4\uB294 \uAC78 \uC54C\uC544. \uB098 \uD63C\uC790\uC11C\uB3C4 \uAD1C\uCC2E\uC544!$l",
  "Good_9": "\uC624, \uB09C \uC2EC\uC2EC\uD558\uC9C0 \uC54A\uC544... \uC6B0\uB9AC\uD55C\uD14C \uC5EC\uAE30 \uC788\uB294 \uAC83\uB4E4\uC744 \uC990\uAE30\uACE0 \uC788\uC5B4.#$e#\uAC04\uB2E8\uD55C \uC0B6\uC774\uC9C0\uB9CC, \uB9C8\uC74C\uC5D0 \uB4E4\uC5B4.$h",
  "Neutral_0": "\uB0B4\uAC00 \uB299\uACE0 \uBA38\uB9AC\uAC00 \uD558\uC597\uAC8C \uB418\uC5B4\uB3C4 \uC544\uC9C1 \uB0A0 \uC88B\uC544\uD588\uC73C\uBA74 \uC88B\uACA0\uB124.$s",
  "Neutral_1": "\uC6B0\uB9AC\uAC00 \uD574\uB0B8 \uC77C\uC744 \uB2F9\uC2E0 \uD560\uC544\uBC84\uC9C0\uAED8\uC11C\uB3C4 \uC790\uB791\uC2A4\uB7EC\uC6CC\uD558\uC2E4\uAE4C?",
  "Neutral_2": "\uC26C\uB294 \uC911\uC774\uC57C? \uB0B4\uAC00 \uC0DD\uAC01\uD588\uB358 \uAC83\uBCF4\uB2E4 \uB18D\uBD80 \uC77C\uC774 \uC26C\uC6B4\uAC00 \uBCF4\uB124...",
  "Neutral_3": "\uC624\uB298 \uB9C8\uC744 \uAC00\uAC8C \uB418\uBA74, \uC0AC\uB78C\uB4E4\uD55C\uD14C \uB0B4 \uC548\uBD80\uB3C4 \uC804\uD574\uC918.",
  "Neutral_4": "\uB0B4\uC77C \uC544\uCE68\uC5D0 \uB2F9\uC2E0\uC774 \uAE68\uAE30 \uC804\uC5D0 \uBE68\uB798 \uD574\uB193\uC744\uAC8C... \uADF8\uB7FC \uB9C8\uB0E5 \uAE30\uB2E4\uB9AC\uB294 \uC2DC\uAC04\uC740 \uC5C6\uACA0\uC9C0.",
  "Neutral_5": "@, \uC6B0\uB9AC \uC7AC\uC815\uC0C1\uD669\uC740 \uAD1C\uCC2E\uC9C0?",
  "Neutral_6": "\uC624\uB298 \uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC740 \uBB50\uD558\uACE0 \uC788\uC73C\uB824\uB098?",
  "Neutral_7": "\uC624\uB298\uC740 \uC660\uC9C0 \uC544\uBB34\uAC83\uB3C4 \uD558\uAE30 \uC2EB\uB2E4.",
  "Neutral_8": "\uC544\uBB34\uB9AC \uCCAD\uC18C\uB97C \uD574\uB3C4, \uC9D1\uC548\uC774 \uB2E4\uC2DC \uC9C0\uC800\uBD84\uD574\uC838.#$e#\uB18D\uC7A5\uC5D0\uC11C \uC9C0\uB0B4\uB2E4 \uBCF4\uBA74 \uADF8\uB7F4 \uC218 \uC788\uB294 \uAC70\uACA0\uC9C0.",
  "Neutral_9": "\uC6B0\uB9AC \uD3C9\uC0DD \uC5EC\uAE30\uC11C \uC9C0\uB0B4\uB824\uB098?",
  "Bad_0": "...\uB098 \uC544\uC9C1 \uC0AC\uB791\uD574?$s",
  "Bad_1": "*\uD55C\uC228*... \uC6B0\uB9AC \uB108\uBB34 \uC80A\uC744 \uB54C \uACB0\uD63C\uD588\uB098 \uBD10.$s",
  "Bad_2": "\uC544\uC9C1 \uB098\uB791 \uD589\uBCF5\uD55C \uAC70 \uB9DE\uC9C0?$s",
  "Bad_3": "\uB0B4\uAC00 \uBB54\uAC00 \uC798\uBABB\uD55C \uAC70 \uC788\uC5B4? \uC694\uC998 \uB2F9\uC2E0 \uB2EC\uB77C\uC84C\uC5B4.$s",
  "Bad_4": "\uC138\uC0C1\uC5D0 \uBB54\uAC00 \uB2E4\uB978 \uAC83\uC774 \uC788\uC744\uAE4C \uC0DD\uAC01\uD574\uBCF8 \uC801 \uC788\uC5B4?$s",
  "Bad_5": "\uC790\uAE30 \uB85C\uB9E8\uD2F1\uD588\uB294\uB370... \uC5B4\uB5BB\uAC8C \uB41C \uAC70\uC57C?$s#$e#\uB0B4\uAC00 \uC608\uC804\uCC98\uB7FC \uC80A\uC9C0 \uC54A\uC740 \uAC70 \uC54C\uC544... \uADF8\uB0E5 \uADF8\uAC83 \uB54C\uBB38\uC5D0 \uB098\uB791 \uACB0\uD63C\uD55C \uAC70\uC57C?$a",
  "Bad_6": "\uC6B0\uB9AC \uC0B6\uC740 \uC774 \uC9E7\uC740 \uC2DC\uAC04 \uD558\uB098\uBFD0\uC778\uB370... \uC774\uAC8C \uC815\uB9D0 \uCD5C\uC120\uC77C\uAE4C?$s",
  "Bad_7": "\uB0B4\uAC00 \uC608\uC804\uC5D4 \uB2F9\uC2E0\uC758 \uC560\uC778\uC774\uC5C8\uB294\uB370... \uC774\uC820 \uB0B4\uAC00 \uC800\uB141 \uC694\uB9AC\uD560 \uB54C\uB9CC \uCC38\uACE0 \uACAC\uB514\uB294 \uAC83 \uAC19\uC544.$s",
  "Bad_8": "\uC694\uC998 \uB098\uD55C\uD14C \uB108\uBB34 \uCC28\uAC00\uC6CC...$s",
  "Bad_9": "\uB098\uD55C\uD14C \uB354 \uB098\uC740 \uC0B6\uC774 \uC788\uC5C8\uC744 \uC218\uB3C4 \uC788\uB294\uB370.$s",
  "spring_1": "\uC544, \uC0C8\uD574\uC758 \uC2DC\uC791\uC774\uB124. \uC62C\uD574 \uC774\uB8E8\uACE0 \uC2F6\uC740 \uACC4\uD68D\uC740 \uC788\uC5B4?#$e#\uB098 \uD76C\uB9DD\uCC2C \uAE30\uBD84\uC774 \uB4E4\uC5B4.",
  "spring_8": "\uACA8\uC6B8\uC774 \uB05D\uB0AC\uC73C\uB2C8, \uC0DD\uC0B0\uC801\uC77C \uC218 \uC788\uB294 \uB0A0\uC774 \uB9CE\uC544\uC9C0\uACA0\uC9C0.",
  "spring_23": "\uCDA4 \uC5F0\uC2B5\uC740 \uC880 \uD574\uB480\uAE38 \uBC14\uB77C... \uB0B4\uC77C \uBD04\uAF43 \uBB34\uB3C4\uD68C \uAC70\uB4E0!",
  "summer_1": "\uC5F4\uC0AC\uBCD1 \uC870\uC2EC\uD574, \uC5EC\uBCF4.#$e#\uBB3C \uB9CE\uC774 \uB9C8\uC2DC\uACE0 \uBB34\uB9AC\uD558\uC9C0 \uB9D0\uACE0.",
  "summer_8": "\uB098 \uD639\uC2DC \uB0C4\uC0C8\uB098\uBA74 \uBBF8\uC548\uD574... \uBC24\uC0C8 \uB354\uC6CC\uC11C \uACC4\uC18D \uB540\uB0AC\uC5B4.",
  "summer_15": "\uC5EC\uB984\uC774\uB124... \uC9D1\uC548\uC5D0 \uD30C\uB9AC\uAC00 \uB108\uBB34 \uB9CE\uC544.#$e#\uAC71\uC815\uD558\uC9C0 \uB9C8, \uB0B4\uAC00 \uCC98\uB9AC\uD560\uAC8C.",
  "fall_1": "\uC5EC\uB984 \uB354\uC704\uAC00 \uC880 \uAC00\uC2DC\uACE0 \uB098\uB2C8\uAE4C \uB0A0\uC528 \uB9CE\uC774 \uC88B\uC544\uC84C\uB2E4.",
  "fall_8": "\uC870\uAE08 \uC788\uC73C\uBA74 \uACA8\uC6B8\uC774\uB124. \uB09C\uBC29 \uC798 \uB3CC\uC544\uAC00\uAC8C \uD544\uC694 \uC5C6\uB294 \uBC38\uBE0C\uB294 \uC7A0\uADF8\uACE0 \uC9D1\uC5D0 \uB2E8\uC5F4\uCC98\uB9AC \uC544\uC9C1 \uC798 \uB418\uC5B4\uC788\uB098 \uD655\uC778\uD574\uC57C\uC9C0.#$e#\uAC71\uC815\uD558\uC9C0 \uB9C8, \uB0B4\uAC00 \uC190\uBCFC\uAC8C.",
  "fall_15": "\uC6B0\uB9AC \uB0B4\uC77C \uB18D\uAC00 \uC804\uC2DC \uB54C \uBCF4\uC5EC\uC904 \uBB3C\uD488\uB4E4 \uC815\uD588\uC5B4?",
  "fall_26": "\uC6B0\uB9AC \uB0B4\uC77C \uBC24\uC5D0 \uC601\uB839\uC758 \uC804\uC57C\uC81C \uCD95\uC81C \uAC08\uAE4C?",
  "winter_1": "\uC73C\uC73C.... \uCDA5\uB124. \uACA8\uC6B8\uC778\uAC00 \uBD10.",
  "winter_7": "\uB0B4\uC77C \uB09A\uC2DC\uB300\uD68C \uCC38\uAC00\uD560 \uAC70\uC57C?",
  "winter_28": "\uC62C\uD574\uB3C4 \uACE0\uB9C8\uC6CC, @. \uC6B0\uB9AC \uD568\uAED8 \uB0B4\uB144\uB3C4 \uD798\uB0B4\uC790\uACE0.$l",
  "spring_Maru": "@, \uD55C\uD574 \uB354 \uB18D\uC0AC\uC9C0\uC744 \uC0DD\uAC01\uD558\uB2C8 \uC2E0\uB098!$h",
  "spring_Abigail": "\uB0B4\uAC00 \uCD94\uC6B4 \uACC4\uC808\uC744 \uB354 \uC88B\uC544\uD558\uAE34 \uD558\uC9C0\uB9CC, \uB2E4 \uC9C0\uB098\uACE0 \uB098\uBA74 \uBD04\uC774 \uC624\uB294 \uAC83\uB3C4 \uD56D\uC0C1 \uBC18\uAC00\uC6CC.",
