{
  "Rainy_Day_0": "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0443 \u0414\u0436\u0430\u0441 \u0438 \u041C\u0430\u0440\u043D\u0438 \u0431\u0435\u0437 \u043C\u0435\u043D\u044F \u0432\u0441\u0435 \u0445\u043E\u0440\u043E\u0448\u043E.#$e#\u042F \u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u0437\u0430 \u043D\u0438\u0445 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u044E... \u0414\u0436\u0430\u0441 \u0443\u0436\u0435 \u0431\u043E\u043B\u044C\u0448\u0430\u044F, \u043C\u043E\u0436\u0435\u0442 \u0441\u0430\u043C\u0430 \u0443\u0445\u0430\u0436\u0438\u0432\u0430\u0442\u044C \u0437\u0430 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u043C\u0438.",
  "Rainy_Day_1": "\u0417\u043D\u0430\u0435\u0448\u044C, \u044F \u0434\u0443\u043C\u0430\u044E, \u0447\u0442\u043E \u0441 \u0442\u0435\u0445 \u043F\u043E\u0440, \u043A\u0430\u043A \u044F \u043A \u0442\u0435\u0431\u0435 \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u043B, \u044F \u0434\u0430\u0436\u0435 \u043F\u043E\u0445\u0443\u0434\u0435\u043B.$6",
  "Rainy_Day_2": "\u0412\u043E\u0442... \u0414\u0435\u0440\u0436\u0438.[346 174 303 305 215]#$e#\u042F \u044D\u0442\u043E \u0434\u0430\u0432\u043D\u043E \u043F\u043E\u043A\u0443\u043F\u0430\u043B, \u0441\u0440\u043E\u043A \u0433\u043E\u0434\u043D\u043E\u0441\u0442\u0438 \u043F\u043E\u0447\u0442\u0438 \u0438\u0441\u0442\u0435\u043A...",
  "Rainy_Day_3": "\u0423-\u0443... \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043C\u043D\u0435 \u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0437\u0430\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F \u043D\u0438\u0447\u0435\u043C \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u043C.",
  "Rainy_Day_4": "@, \u043A\u0430\u043A \u0434\u0443\u043C\u0430\u0435\u0448\u044C, \u0437\u0430\u043D\u044F\u0442\u044C\u0441\u044F \u043C\u043D\u0435 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0447\u0435\u043C-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u043C?.. \u0418\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u0434\u0440\u044B\u0445\u043D\u0443\u0442\u044C \u0432\u0441\u044E \u043E\u0441\u0442\u0430\u0432\u0448\u0443\u044E\u0441\u044F \u0432\u0435\u0447\u043D\u043E\u0441\u0442\u044C?",
  "Rainy_Night_0": "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u0435\u0447\u0435\u0440\u043E\u043C \u0441\u0430\u043C\u043E\u0435 \u0432\u0440\u0435\u043C\u044F, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u043A\u0438\u043D\u0443\u0442\u044C \u0432 \u043C\u0438\u043A\u0440\u043E\u0432\u043E\u043B\u043D\u043E\u0432\u043A\u0443 \u043F\u0430\u0440\u0443 \u043F\u0438\u0446\u0446\u0430-\u0440\u043E\u043B\u043B\u043E\u0432.#$e#\u041A\u043E\u0435-\u043A\u0442\u043E \u0440\u0430\u0437\u043E\u0433\u0440\u0435\u0432\u0430\u0435\u0442 \u0438\u0445 \u0432 \u0434\u0443\u0445\u043E\u0432\u043A\u0435, \u043D\u043E \u044F \u043D\u0435 \u043C\u043E\u0433\u0443 \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0436\u0434\u0430\u0442\u044C. \u0414\u0430 \u0438 \u043C\u044F\u0433\u043A\u0430\u044F \u0442\u0435\u043A\u0441\u0442\u0443\u0440\u0430 \u043C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F.$h",
  "patio_Shane": "\u0423 \u0427\u0430\u0440\u043B\u0438 \u0432\u0441\u0435 \u0445\u043E\u0440\u043E\u0448\u043E.$8",
  "Rainy_Night_1": "\u041A\u0430\u043F-\u043A\u0430\u043F... \u0428\u0443\u043C \u0434\u043E\u0436\u0434\u044F \u0431\u0443\u0434\u0442\u043E \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442 \u043C\u0435\u043D\u044F \u0432 \u0434\u0440\u0443\u0433\u043E\u0435 \u0432\u0440\u0435\u043C\u044F... \u0412 \u0434\u0440\u0443\u0433\u043E\u0435 \u043C\u0435\u0441\u0442\u043E.",
  "Rainy_Night_2": "\u0411\u044B\u043B\u0438 \u0431\u044B \u0443 \u043C\u0435\u043D\u044F \u0447\u0438\u0441\u0442\u044B\u0435 \u0448\u0442\u0430\u043D\u044B, \u044F \u0431\u044B \u0432\u044B\u0448\u0435\u043B \u043F\u043E\u0433\u0443\u043B\u044F\u0442\u044C... \u0414\u0430 \u043D\u0443.",
  "Rainy_Night_3": "\u042F \u043B\u044E\u0431\u043B\u044E \u043F\u0430\u0441\u043C\u0443\u0440\u043D\u0443\u044E \u043F\u043E\u0433\u043E\u0434\u0443, \u043D\u043E \u0432 \u0442\u0430\u043A\u0443\u044E \u043F\u043E\u0433\u043E\u0434\u0443 \u043C\u043D\u0435 \u0436\u0430\u043B\u043A\u043E \u043A\u0443\u0440.",
  "Rainy_Night_4": "\u041A\u0430\u043F-\u043A\u0430\u043F-\u043A\u0430\u043F... \u0427\u0442\u043E-\u0442\u043E \u043F\u0438\u0442\u044C \u0437\u0430\u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C.$6",
  "Indoor_Day_0": "\u0423-\u0443... \u0418\u043D\u043E\u0433\u0434\u0430 \u0436\u0438\u0437\u043D\u044C \u0441\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0432 \u043E\u0434\u043D\u043E \u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u0441\u0435\u0440\u043E\u0435 \u043F\u044F\u0442\u043D\u043E... \u041F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C, \u043E \u0447\u0435\u043C \u044F?",
  "Indoor_Day_1": "\u0425\u0435\u0439, \u0432\u043E\u0442, \u0434\u0435\u0440\u0436\u0438... \u042F \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E \u0437\u0430\u043A\u0438\u043D\u0443\u043B \u0432 \u043C\u0438\u043A\u0440\u043E\u0432\u043E\u043B\u043D\u043E\u0432\u043A\u0443. [195 215 206]#$e#\u041F\u0440\u043E\u0441\u0442\u0438, \u0435\u0441\u043B\u0438 \u043E\u043D\u043E \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u044F\u0433\u043A\u043E\u0435.",
  "Indoor_Day_2": "\u041F\u043E\u043E\u0431\u0435\u0449\u0430\u0439 \u043C\u043D\u0435 \u043A\u043E\u0435-\u0447\u0442\u043E... \u041A\u043E\u0433\u0434\u0430 \u044F \u0443\u0439\u0434\u0443 \u0438\u0437 \u044D\u0442\u043E\u0433\u043E \u043C\u0438\u0440\u0430, \u0443\u0434\u043E\u0431\u0440\u0438 \u043C\u043E\u0438\u043C \u043F\u0440\u0430\u0445\u043E\u043C \u043A\u0443\u043A\u0443\u0440\u0443\u0437\u0443 \u0434\u043B\u044F \u043A\u0443\u0440.",
  "Indoor_Day_3": "*\u0427\u043C\u043E\u043A*... \u041C-\u043C, \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u043A\u0442\u043E-\u0442\u043E \u043F\u043E\u0436\u0435\u0432\u0430\u043B \u043F\u0438\u0446\u0446\u0430-\u0440\u043E\u043B\u043B\u043E\u0432.$6",
  "Indoor_Day_4": "\u042F \u0447\u0430\u0441\u0442\u043E \u043E\u0442\u043C\u0430\u043B\u0447\u0438\u0432\u0430\u044E\u0441\u044C \u0438 \u043C\u043E\u0433\u0443 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u043D\u0435\u0441\u0447\u0430\u0441\u0442\u043D\u044B\u043C... \u043D\u043E \u044F \u0446\u0435\u043D\u044E \u0432\u0435\u0441\u044C \u0442\u0432\u043E\u0439 \u0442\u0440\u0443\u0434. \u041C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u043F\u043E\u0432\u0435\u0437\u043B\u043E.$6",
  "Indoor_Night_0": "\u042F \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u044B\u043F\u044C\u044E \u0435\u0449\u0435 \u043F\u0438\u0432\u043A\u0430 \u043F\u0435\u0440\u0435\u0434 \u0441\u043D\u043E\u043C.",
  "Indoor_Night_1": "\u0412\u043E\u0442 \u0431\u044B... \u0415\u0441\u043B\u0438 \u0431\u044B... \u0410, \u044F \u0442\u0443\u0442 \u043F\u0440\u043E\u0441\u0442\u043E \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u044E \u0441\u0432\u043E\u0438 \u0441\u043B\u0430\u0432\u043D\u044B\u0435 \u0434\u043D\u0438 \u0432 \u0433\u0440\u0438\u0434\u0431\u043E\u043B\u044C\u043D\u043E\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u0435.$6#$b#\u0410 \u0442\u0435\u043F\u0435\u0440\u044C \u044F \u0441\u0442\u0430\u043B \u0441\u0442\u0430\u0440 \u0438 \u0441\u043B\u0430\u0431...",
  "Indoor_Night_2": "\u0423\u0444-\u0444... *\u0431\u0443\u0440\u0447\u0430\u043D\u0438\u0435* \u0423\u0444... \u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u044F \u043F\u0435\u0440\u0435\u0435\u043B \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0441\u043E\u0443\u0441\u0430 \u0414\u0436\u043E\u0434\u0436\u0430...",
  "Indoor_Night_3": "\u0423-\u0443... \u0411\u044B\u043B \u0431\u044B \u044F \u0441\u0430\u043D\u0442\u0438\u043C\u0435\u0442\u0440\u043E\u0432 \u043D\u0430 \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0432\u044B\u0448\u0435 \u0438 \u043D\u0430 \u043F\u0430\u0440\u0443 \u043C\u043E\u0437\u0433\u043E\u0432 \u0443\u043C\u043D\u0435\u0435...#$e#\u0422\u044B \u043B\u044E\u0431\u0438\u0448\u044C \u043C\u0435\u043D\u044F \u0442\u0430\u043A\u0438\u043C, \u043A\u0430\u043A\u043E\u0439 \u044F \u0435\u0441\u0442\u044C? \u042F \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u043D\u0435 \u043C\u043E\u0433\u0443 \u0442\u0435\u0431\u044F \u0432 \u044D\u0442\u043E\u043C \u043F\u043E\u043D\u044F\u0442\u044C...",
  "Indoor_Night_4": "\u042F \u0432\u0435\u0441\u044C \u0434\u0435\u043D\u044C \u0441\u043C\u043E\u0442\u0440\u0435\u043B \u0442\u0435\u043B\u0438\u043A, \u0438 \u0442\u0435\u043F\u0435\u0440\u044C \u0443 \u043C\u0435\u043D\u044F \u043D\u043E\u0433\u0438 \u0431\u0443\u0434\u0442\u043E \u0432\u0430\u0442\u043D\u044B\u0435. \u041F\u0440\u0438\u0434\u0435\u0442\u0441\u044F \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C \u0434\u043E \u0437\u0430\u0432\u0442\u0440\u0430.",
  "Outdoor_0": "\u042F \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0435 \u0432\u044B\u0441\u043F\u0430\u043B\u0441\u044F. \u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0441\u0432\u0435\u0436\u0438\u0439 \u0432\u043E\u0437\u0434\u0443\u0445 \u043F\u0440\u0438\u0432\u0435\u0434\u0435\u0442 \u043C\u0435\u043D\u044F \u0432 \u0447\u0443\u0432\u0441\u0442\u0432\u043E.#$e#\u0412 \u043A\u0430\u043A\u043E\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u043E? \u0425\u0435... \u041D\u0443 \u0438 \u0432\u043E\u043F\u0440\u043E\u0441\u044B \u0443 \u0442\u0435\u0431\u044F.$h",
  "Outdoor_1": "\u0418\u043D\u043E\u0433\u0434\u0430 \u044F \u043F\u0440\u043E\u0441\u0442\u043E \u043E\u0441\u043E\u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u044F \u2014 \u043B\u0438\u0448\u044C \u043C\u0435\u0448\u043E\u043A \u0441\u043E\u0447\u043D\u043E\u0439 \u0438 \u043C\u044F\u0433\u043A\u043E\u0439 \u043F\u043B\u043E\u0442\u0438.#$e#\u041D\u043E \u044D\u0442\u043E \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E... \u0427\u0442\u043E \u0432\u043E\u043E\u0431\u0449\u0435 \u0442\u0430\u043A\u043E\u0435 \u0436\u0438\u0437\u043D\u044C?$h",
  "Outdoor_2": "\u0415\u0441\u043B\u0438 \u0437\u0430\u0434\u0443\u043C\u0430\u0442\u044C\u0441\u044F... \u042F \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u0432 \u043E\u0442\u043B\u0438\u0447\u043D\u043E\u043C \u043C\u0435\u0441\u0442\u0435. \u0418 \u0436\u0438\u0437\u043D\u044C \u0443 \u043C\u0435\u043D\u044F \u0445\u043E\u0440\u043E\u0448\u0430\u044F.$6",
  "Outdoor_3": "\u041E\u0445-\u0445... \u0423 \u043C\u0435\u043D\u044F \u044F\u0437\u044B\u043A \u0440\u0430\u0441\u043F\u0443\u0445 \u043E\u0442 \u043F\u0435\u0440\u0435\u0447\u043D\u044B\u0445 \u0431\u043E\u043C\u0431\u043E\u0447\u0435\u043A.$s",
  "Outdoor_4": "\u041F\u0440\u0438\u0432\u0435\u0442, @. \u0422\u044B \u0442\u0430\u043A \u043C\u0438\u043B\u043E \u0441\u043F\u0438\u0448\u044C, \u043A\u0430\u043A ${\u0440\u0435\u0431\u0435\u043D\u043E\u043A^\u0434\u0438\u0442\u044F}$... \u042F \u0440\u0435\u0448\u0438\u043B \u0442\u0435\u0431\u044F \u043D\u0435 \u0431\u0443\u0434\u0438\u0442\u044C, \u043F\u043E\u0448\u0435\u043B \u043F\u0440\u043E\u0433\u0443\u043B\u044F\u0442\u044C\u0441\u044F \u043F\u043E \u0444\u0435\u0440\u043C\u0435 \u0441 \u0443\u0442\u0440\u0430. \u0412\u0441\u0435 \u0431\u0443\u0434\u0442\u043E \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435.",
  "OneKid_0": "\u042D\u0442\u043E \u0442\u0430\u043A \u0441\u0442\u0440\u0430\u043D\u043D\u043E. \u041A\u043E\u0433\u0434\u0430 \u044F \u0431\u044B\u043B \u043C\u043E\u043B\u043E\u0436\u0435, \u0442\u043E \u043F\u043E\u043A\u043B\u044F\u043B\u0441\u044F, \u0447\u0442\u043E \u0434\u0435\u0442\u0435\u0439 \u0443 \u043C\u0435\u043D\u044F \u043D\u0435 \u0431\u0443\u0434\u0435\u0442. \u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u0447\u0442\u043E \u0441\u043E \u043C\u043D\u043E\u0439 \u0442\u0430\u043A\u043E\u0435 \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E?$6",
  "OneKid_1": "%kid1 \u0431\u0443\u0434\u0435\u0442 \u0435\u0441\u0442\u044C \u043F\u043E\u0431\u043E\u043B\u044C\u0448\u0435 \u044F\u0438\u0446, \u043D\u0430\u0434\u043E \u043E\u0431 \u044D\u0442\u043E\u043C \u043F\u043E\u0437\u0430\u0431\u043E\u0442\u0438\u0442\u044C\u0441\u044F... \u0420\u0435\u0431\u0435\u043D\u043A\u0443 \u043D\u0443\u0436\u043D\u044B \u043A\u0440\u0435\u043F\u043A\u0438\u0435 \u043D\u043E\u0433\u0438!",
  "OneKid_3": "\u041F\u0430\u043F\u0430 \u0428\u0435\u0439\u043D \u043F\u0440\u0438\u0431\u044B\u043B \u043D\u0430 \u0434\u0435\u0436\u0443\u0440\u0441\u0442\u0432\u043E...$6#$e#\u0423-\u0443... \u042F \u0442\u0430\u043A\u043E\u0439 \u043D\u0435\u043B\u0435\u043F\u044B\u0439 \u0441\u0442\u0430\u0440\u0438\u043A.",
  "TwoKids_0": "\u042F \u0443\u0436\u0435 \u043D\u0430\u0441\u044B\u043F\u0430\u043B \u0434\u0435\u0442\u044F\u043C \u043F\u043E \u0434\u0432\u0435 \u043C\u0438\u0441\u043A\u0438 \u043F\u0438\u0446\u0446\u0430-\u0445\u043B\u043E\u043F\u044C\u0435\u0432. \u041E\u043D\u0438 \u0435\u0449\u0435 \u0434\u043E\u043B\u0433\u043E \u0431\u0443\u0434\u0443\u0442 \u0441\u044B\u0442\u044B\u043C\u0438.",
  "TwoKids_1": "\u0421\u043A\u0430\u0436\u0443 \u0447\u0435\u0441\u0442\u043D\u043E... \u0414\u0432\u0443\u0445 \u0434\u0435\u0442\u0435\u0439 \u043C\u043D\u0435 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E.",
  "TwoKids_2": "\u0423\u0444... %kid2 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043C\u043D\u043E\u0433\u043E \u043A\u0430\u043F\u0440\u0438\u0437\u043D\u0438\u0447\u0430\u0435\u0442. \u042D\u0442\u043E, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u043E\u0442 \u043C\u0435\u043D\u044F...",
  "TwoKids_3": "\u042D\u0445... \u041F\u043E\u0441\u043B\u0430\u0442\u044C \u0431\u044B \u0434\u0435\u0442\u0435\u0439 \u043D\u0430 \u043C\u0435\u0441\u044F\u0446 \u0432 \u043B\u0430\u0433\u0435\u0440\u044C \u0414\u0436\u043E\u0434\u0436\u0430...#$e#\u0428\u0443\u0447\u0443.$h",
  "Good_0": "*\u041F\u0440\u0438\u043D\u044E\u0445\u0438\u0432\u0430\u0435\u0442\u0441\u044F*... \u041C-\u043C... \u0427\u0442\u043E \u0437\u0430 \u0447\u0443\u0434\u0435\u0441\u043D\u044B\u0435 \u0434\u0443\u0445\u0438? \u041E\u0434\u0435\u043F\u0435\u043F\u043F\u0435\u0440\u043E\u043D\u0438?$6",
  "Good_1": "\u0422\u044B \u0432\u0435\u0434\u044C \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u043A\u0440\u0430\u0441\u0438\u0432\u0435\u0435 \u043C\u0435\u043D\u044F, \u0437\u043D\u0430\u0435\u0448\u044C \u043E\u0431 \u044D\u0442\u043E\u043C?$h",
  "Good_2": "\u0418\u043C\u044F \u00AB\u0428\u0435\u0439\u043D\u00BB \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u00AB\u0434\u0430\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0418\u043E\u0431\u043E\u0439\u00BB... \u041A\u0430\u043A\u0430\u044F \u0438\u0440\u043E\u043D\u0438\u044F.",
  "Good_3": "\u042F \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0432 \u043E\u0442\u043B\u0438\u0447\u043D\u043E\u043C \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0438... \u00AB\u0422\u0443\u043D\u043D\u0435\u043B\u0435\u0440\u044B\u00BB \u0432\u044B\u0438\u0433\u0440\u0430\u043B\u0438 \u043C\u0430\u0442\u0447 \u0432\u0447\u0435\u0440\u0430 \u0432\u0435\u0447\u0435\u0440\u043E\u043C.$h",
  "Good_4": "\u0421\u043B\u0443\u0448\u0430\u0439, \u0435\u0441\u043B\u0438 \u044F \u0432\u0434\u0440\u0443\u0433 \u043A\u0430\u043F\u0440\u0438\u0437\u043D\u0438\u0447\u0430\u044E, \u0442\u044B \u043D\u0435 \u043E\u0431\u0440\u0430\u0449\u0430\u0439 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F. \u0423 \u043C\u0435\u043D\u044F \u0438\u043D\u043E\u0433\u0434\u0430 \u0431\u044B\u0432\u0430\u044E\u0442 \u0441\u043A\u0430\u0447\u043A\u0438 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F, \u043D\u043E \u044D\u0442\u043E \u043D\u0435 \u0438\u0437-\u0437\u0430 \u0442\u0435\u0431\u044F... \u041B\u0430\u0434\u043D\u043E?",
  "Good_5": "\u0410\u0445... \u0416\u0438\u0437\u043D\u044C \u043D\u0430 \u0444\u0435\u0440\u043C\u0435 \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u043B\u0443\u0447\u0448\u0435 \u0440\u0430\u0431\u043E\u0442\u044B \u0432 \u0414\u0436\u043E\u0434\u0436\u0430. \u042D\u0442\u043E \u0431\u044B\u043B\u043E \u043E\u0442\u0432\u0440\u0430\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E.$h#$e#\u0427\u0442\u043E, \u0434\u0443\u043C\u0430\u0435\u0448\u044C, \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439 \u0437\u0430\u043B \u043D\u0430\u0433\u043E\u043D\u044F\u043B \u0442\u043E\u0441\u043A\u0438? \u042D\u0442\u043E \u0442\u044B \u0435\u0449\u0435 \u043F\u043E\u0434\u0441\u043E\u0431\u043A\u0443 \u043D\u0435 ${\u0432\u0438\u0434\u0435\u043B^\u0432\u0438\u0434\u0435\u043B\u0430}$...",
  "Good_6": "\u0410\u0445... \u0412\u043E\u0442 \u044D\u0442\u043E \u0436\u0438\u0437\u043D\u044C. \u041D\u0438\u043A\u0430\u043A\u0438\u0445 \u043E\u0431\u044F\u0437\u0430\u043D\u043D\u043E\u0441\u0442\u0435\u0439, \u0432\u0435\u0447\u0435\u0440\u043E\u043C \u0438\u0433\u0440\u0430\u044E\u0442 \u00AB\u0422\u0443\u043D\u043D\u0435\u043B\u0435\u0440\u044B\u00BB, \u0430 \u0432 \u0445\u043E\u043B\u043E\u0434\u0438\u043B\u044C\u043D\u0438\u043A\u0435 \u0432\u0441\u0435, \u0447\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F \u043C\u0443\u0436\u0447\u0438\u043D\u0435.$h",
  "Good_8": "\u0427\u0442\u043E-\u0442\u043E \u043C\u043D\u0435 \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0441\u0435\u0433\u043E\u0434\u043D\u044F. \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u044E, \u0447\u0442\u043E \u0442\u0430\u043C \u043F\u043E \u0442\u0435\u043B\u0438\u043A\u0443.",
  "Good_9": "\u0425\u043C... \u0421\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0448\u044C, \u043F\u043E\u0447\u0435\u043C\u0443 \u044F \u0442\u0430\u043A \u0433\u043B\u0443\u043F\u043E \u0443\u043B\u044B\u0431\u0430\u044E\u0441\u044C? \u041A\u043E\u0440\u043E\u0442\u043A\u0430\u044F \u0436\u0435 \u0443 \u0442\u0435\u0431\u044F \u043F\u0430\u043C\u044F\u0442\u044C. *\u043A\u0440\u0430\u0441\u043D\u0435\u0435\u0442*$h",
  "Neutral_0": "\u0422\u0435\u0431\u0435 \u0447\u0442\u043E-\u0442\u043E \u043D\u0443\u0436\u043D\u043E? \u041F\u0440\u043E\u0441\u0442\u0438, \u044F \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0437\u0430\u043D\u044F\u0442.",
  "Neutral_2": "\u041C\u043E\u0436\u0435\u0442, \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0435\u0448\u044C, \u043A\u0430\u043A \u043F\u0440\u043E\u0448\u0435\u043B \u0434\u0435\u043D\u044C, \u043A\u043E\u0433\u0434\u0430 \u043C\u044B \u0431\u0443\u0434\u0435\u043C \u0432 \u043F\u043E\u0441\u0442\u0435\u043B\u0438? \u042F \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0437\u0430\u043D\u044F\u0442...",
  "Neutral_3": "\u0420\u0430\u0431\u043E\u0442\u0430 \u0432 \u0414\u0436\u043E\u0434\u0436\u0430 \u0431\u044B\u043B\u0430 \u0442\u044F\u0433\u043E\u043C\u043E\u0442\u043D\u0430\u044F, \u043D\u043E \u0442\u0430\u043C \u044F \u0445\u043E\u0442\u044F \u0431\u044B \u0432\u0438\u0434\u0435\u043B \u0434\u0440\u0443\u0433\u0438\u0445 \u043B\u044E\u0434\u0435\u0439.",
  "Neutral_4": "\u0427\u0442\u043E, \u0445\u043E\u0447\u0435\u0448\u044C, \u0447\u0442\u043E\u0431\u044B \u044F \u043F\u043E\u043C\u044B\u043B \u043F\u043E\u0441\u0443\u0434\u0443? \u042F \u043F\u043E\u043C\u043E\u044E... \u041F\u043E\u0442\u043E\u043C...",
  "Neutral_5": "\u041A\u0430\u043A \u0443 \u043D\u0430\u0441 \u0441 \u0434\u0435\u043D\u044C\u0433\u0430\u043C\u0438? \u042F \u043D\u0435 \u0445\u043E\u0447\u0443 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0443 \u0432 \u0414\u0436\u043E\u0434\u0436\u0430.",
  "Neutral_6": "\u0415\u0441\u043B\u0438 \u0445\u043E\u0447\u0435\u0448\u044C \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C\u0441\u044F \u0441 \u043A\u0435\u043C-\u043D\u0438\u0431\u0443\u0434\u044C \u0438\u0437 \u0434\u0440\u0443\u0437\u0435\u0439 \u0432 \u0433\u043E\u0440\u043E\u0434\u0435, \u043C\u043E\u0436\u0435\u0448\u044C \u0438\u0434\u0442\u0438. \u041C\u043D\u0435 \u0438 \u0432 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 \u0442\u0435\u043B\u0438\u043A\u0430 \u0438 \u043F\u0430\u0440\u044B \u0431\u0443\u0442\u044B\u043B\u043E\u043A \u043D\u0438\u0447\u0435\u0433\u043E.",
  "Neutral_8": "\u0423\u0444... \u0427\u0438\u0441\u0442\u0438-\u0447\u0438\u0441\u0442\u0438-\u0447\u0438\u0441\u0442\u0438. \u041C\u0435\u0442\u0438-\u043C\u0435\u0442\u0438-\u043C\u0435\u0442\u0438. \u041A\u0443\u043F\u0430\u0439. \u0413\u043E\u0442\u043E\u0432\u044C. \u0417\u0430\u043F\u0440\u0430\u0432\u044C \u043A\u0440\u043E\u0432\u0430\u0442\u044C... \u041D\u0443, \u043D\u0438\u0447\u0435\u0433\u043E. \u0416\u0438\u0437\u043D\u044C \u0443 \u043C\u0435\u043D\u044F \u043D\u0435\u043F\u043B\u043E\u0445\u0430\u044F.",
  "Bad_5": "\u0421\u043B\u0443\u0448\u0430\u0439, \u044F \u043F\u0440\u043E\u0441\u0442\u043E \u0445\u043E\u0447\u0443 \u043F\u043E\u0431\u044B\u0442\u044C \u043E\u0434\u0438\u043D. \u041C\u043E\u0436\u0435\u0442, \u0432\u044B\u0439\u0434\u0435\u0448\u044C, \u0437\u0430\u0439\u043C\u0435\u0448\u044C\u0441\u044F \u043F\u043E\u043A\u0430 \u0441\u0432\u043E\u0438\u043C\u0438 \u0434\u0435\u043B\u0430\u043C\u0438?",
  "Bad_6": "\u0427\u0435\u0433\u043E \u0442\u0435\u0431\u0435? \u0422\u044B \u043F\u0440\u044F\u043C\u043E \u043A\u0430\u043A \u041C\u0430\u0440\u043D\u0438, \u043A\u043E\u0433\u0434\u0430 \u043E\u043D\u0430 \u043D\u0435 \u0432 \u0434\u0443\u0445\u0435. \u0423\u0445\u043E\u0434\u0438.$a",
  "Bad_7": "\u0416\u0438\u0437\u043D\u044C \u043D\u0430 \u0444\u0435\u0440\u043C\u0435 \u0442\u0430\u043A\u0430\u044F \u0441\u043A\u0443\u0447\u043D\u0430\u044F, \u043D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435. \u0427\u0442\u043E \u044F \u0432\u043E\u043E\u0431\u0449\u0435 \u0437\u0434\u0435\u0441\u044C \u0434\u0435\u043B\u0430\u044E?$s",
  "Bad_8": "\u0410\u0433\u0430... *\u0418\u043A* ...\u0414\u0430-\u0434\u0430, \u043C\u043E\u044F \u0440\u0430\u0434\u043E\u0441\u0442\u044C. \u041A\u0430\u043A \u0441\u043A\u0430\u0436\u0435\u0448\u044C... *\u0418\u043A*",
  "funLeave_Shane": "\u042F \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043F\u043E\u0439\u0434\u0443 \u0432 \u0433\u043E\u0440\u043E\u0434, \u043B\u0430\u0434\u043D\u043E?",
  "funReturn_Shane": "\u041F\u0440\u043E\u0441\u0442\u0438, \u0435\u0441\u043B\u0438 \u044F \u0432\u0441\u043F\u043E\u0442\u0435\u043B... \u041F\u043E\u0445\u043E\u0434 \u0431\u044B\u043B \u0434\u043E\u043B\u0433\u0438\u0439... \u0423-\u0443, \u044F \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435 \u0432 \u0444\u043E\u0440\u043C\u0435.$6",
  "spring_1": "\u0423-\u0443-\u0443... \u041A\u0430\u043A \u0436\u0435 \u0431\u043E\u043B\u0438\u0442 \u0433\u043E\u043B\u043E\u0432\u0430. \u0421\u043A\u043E\u043B\u044C\u043A\u043E \u044F \u0432\u0447\u0435\u0440\u0430 \u0432\u044B\u043F\u0438\u043B?",
  "spring_12": "\u041F\u043E\u0436\u0430\u043B\u0443\u0439, \u044F\u0438\u0447\u043D\u044B\u0439 \u0444\u0435\u0441\u0442\u0438\u0432\u0430\u043B\u044C \u2014 \u043C\u043E\u0439 \u043B\u044E\u0431\u0438\u043C\u044B\u0439 \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A... \u041D\u0443, \u0442\u044B \u043C\u0435\u043D\u044F \u0437\u043D\u0430\u0435\u0448\u044C, \u044F \u0432\u0441\u0435 \u043B\u044E\u0431\u043B\u044E, \u0447\u0442\u043E \u0441\u0432\u044F\u0437\u0430\u043D\u043E \u0441 \u043A\u0443\u0440\u0430\u043C\u0438.$h",
  "spring_23": "\u0410, \u0442\u043E\u0447\u043D\u043E. \u0417\u0430\u0432\u0442\u0440\u0430 \u0446\u0432\u0435\u0442\u043E\u0447\u043D\u044B\u0435 \u0442\u0430\u043D\u0446\u044B. \u041D\u0443, \u0435\u0441\u043B\u0438 \u0442\u044B \u044D\u0442\u043E\u043C\u0443 \u0440\u0430\u0434\u0443\u0435\u0448\u044C\u0441\u044F, \u0442\u043E \u0438 \u044F \u0440\u0430\u0434.",
  "summer_1": "\u041C\u043D\u0435 \u043D\u0440\u0430\u0432\u044F\u0442\u0441\u044F \u0442\u0440\u043E\u043F\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F \u0432 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u0433\u043E\u0434\u0430. \u0414\u043E\u043B\u0438\u043D\u0430 \u0442\u0430\u043A \u043F\u044B\u0448\u043D\u043E \u0440\u0430\u0441\u0446\u0432\u0435\u0442\u0430\u0435\u0442.",
  "summer_10": "\u041F\u043E\u0436\u0430\u043B\u0443\u0439, \u043F\u043E\u0433\u043E\u043B\u043E\u0434\u0430\u044E \u0434\u043E \u0437\u0430\u0432\u0442\u0440\u0430\u0448\u043D\u0435\u0433\u043E \u043B\u0443\u0430\u0443. \u041D\u0443\u0436\u043D\u043E, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0434 \u0433\u043E\u0440\u044F\u0447\u0438\u0439 \u0441\u0443\u043F \u0431\u044B\u043B\u043E \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E \u0431\u043E\u043B\u044C\u0448\u0435 \u043C\u0435\u0441\u0442\u0430.$h",
  "summer_27": "\u041A\u0430\u043A\u0438\u0435 \u0443 \u0442\u0435\u0431\u044F \u043F\u043B\u0430\u043D\u044B \u043D\u0430 \u043E\u0441\u0435\u043D\u044C? \u042F \u0434\u0443\u043C\u0430\u044E \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0438\u043D\u0430 \u0432 \u0441\u0432\u043E\u0439 \u0440\u0430\u0446\u0438\u043E\u043D.",
  "fall_1": "\u0425\u043C-\u043C... \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F \u043A\u0443\u043F\u0438\u0442\u044C \u0442\u044B\u043A\u0432\u0435\u043D\u043D\u043E\u0433\u043E \u044D\u043B\u044F, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043F\u0440\u0430\u0437\u0434\u043D\u043E\u0432\u0430\u0442\u044C \u043E\u0441\u0435\u043D\u044C...$6",
  "fall_15": "\u0417\u0430\u0432\u0442\u0440\u0430 \u044F \u0431\u0443\u0434\u0443 \u043F\u043E\u043C\u043E\u0433\u0430\u0442\u044C \u041C\u0430\u0440\u043D\u0438 \u0441 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u043C\u0438 \u043D\u0430 \u044F\u0440\u043C\u0430\u0440\u043A\u0435, \u043A\u0430\u043A \u0438 \u0432\u0441\u0435\u0433\u0434\u0430. \u0410 \u0442\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u044C\u0441\u044F \u0438 \u0440\u0430\u0434\u0443\u0439\u0441\u044F \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A\u0443.$6",
  "fall_17": "\u042F \u043D\u0430\u0447\u0438\u043D\u0430\u044E \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C \u0441\u0435\u0431\u044F \u043D\u0430 \u0441\u0432\u043E\u0438 \u0433\u043E\u0434\u044B... \u0438 \u043C\u043D\u0435 \u044D\u0442\u043E \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F.",
  "winter_1": "\u0423 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C \u043A\u0430\u043A\u0438\u0435-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u043B\u0430\u043D\u044B \u043D\u0430 \u0437\u0438\u043C\u0443? \u042F, \u0441\u043A\u043E\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043E, \u043F\u0440\u043E\u0441\u0442\u043E \u0431\u0443\u0434\u0443 \u0442\u043E\u0440\u0447\u0430\u0442\u044C \u0434\u043E\u043C\u0430 \u0438 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0442\u0435\u043B\u0435\u0432\u0438\u0437\u043E\u0440.",
  "winter_28": "\u0412\u043E\u0442 \u0438 \u0435\u0449\u0435 \u043E\u0434\u0438\u043D \u0433\u043E\u0434 \u043F\u0440\u043E\u0448\u0435\u043B... \u042F \u0432\u044B\u0433\u043B\u044F\u0436\u0443 \u0447\u0443\u0442\u044C \u043F\u043E\u0441\u0442\u0430\u0440\u0448\u0435, \u043D\u043E \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u043E\u0441\u044C.$6"
}