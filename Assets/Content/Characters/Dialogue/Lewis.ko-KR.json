{
  "Introduction": "\uADF8\uB798, \uB0A1\uC740 \uC624\uB450\uB9C9\uC5D0\uC11C \uBCF4\uB0B8 \uCCAB \uBC24\uC740 \uC880 \uC5B4\uB560\uB098?#$e#\uD560\uC544\uBC84\uC9C0\uAED8\uC11C \uCE68\uB300\uAC00 \uC624\uB798\uB418\uACE0 \uC090\uAC71\uAC70\uB9B0\uB2E4\uACE0 \uBD88\uD3C9\uD558\uACE4 \uD558\uC168\uC9C0. \uADFC\uB370 \uB0B4 \uC0DD\uAC01\uC5D4, \uBD84\uBA85 \uB9C8\uC74C\uC18D \uAE4A\uC774\uC5D0\uB294 \uADF8 \uC9D1\uC744 \uC0AC\uB791\uD558\uC168\uC744 \uAC70\uC57C.",
  "AcceptGift_(O)StardropTea": "\uC0B4\uBA74\uC11C \uB9CE\uC740 \uCC28\uB97C \uB9C8\uC154\uBD24\uC9C0\uB9CC, \uC774\uAC83\uB9CC\uD07C \uD76C\uADC0\uD558\uACE0 \uD2B9\uBCC4\uD55C \uAC74 \uB610 \uC5C6\uAD6C\uBA3C. \uACE0\uB9D9\uB124!",
  "AcceptBirthdayGift_Positive": "\uC544, \uC774 \uB299\uC740 \uC2DC\uC7A5\uC758 \uC0DD\uC77C\uC744 \uAE30\uC5B5\uD574 \uC8FC\uB2E4\uB2C8. \uB9C8\uC74C\uC528\uAC00 \uC815\uB9D0 \uACF1\uAD6C\uBA3C! \uC120\uBB3C\uB3C4 \uBA4B\uC9C0\uACE0!$h",
  "GreenRain": "\uBC29\uAE08 \uB3C4\uC9C0\uC0AC\uB2D8\uACFC \uD1B5\uD654\uB97C \uB9C8\uCCE4\uB124... \uB4E3\uC790 \uD558\uB2C8 \uC774 \uBE44\uB294 \uC778\uCCB4\uC5D0 \uBB34\uD574\uD558\uB2E4\uACE0 \uD558\uB354\uAD70. \uADF8\uB0E5 \uC790\uC5F0\uC758 \uD2B9\uC774\uD55C \uD604\uC0C1 \uC911 \uD558\uB098\uC9C0.#$b#\uADF8\uB798\uB3C4 \uC8FC\uBBFC \uC911\uC5D0 \uAC81\uC5D0 \uC9C8\uB9B0 \uC0AC\uB78C\uB4E4\uC774 \uC788\uC5B4\uC11C, \uC548 \uC88B\uC740 \uC77C\uC774\uAE34 \uD574...",
  "GreenRainFinished": "\uADF8\uB798, \uC6B0\uB9AC \uC791\uC740 \uB9C8\uC744\uC5D0 \uAF64\uB098 \uD765\uBBF8\uB85C\uC6B4 \uC0AC\uAC74\uC774\uC5C8\uC9C0! \uB2E4\uB4E4 \uAD1C\uCC2E\uC544\uC11C \uB2E4\uD589\uC774\uB124.$h#$e#\uB2E4\uC2DC \uC774\uB7F0 \uC77C\uC774 \uC0DD\uAE34\uB2E4\uBA74, \uB2E4\uB4E4 \uC880 \uB354 \uCC28\uBD84\uD558\uAC8C \uB300\uC751\uD560\uAC78\uC138. \uC138\uC0C1\uC758 \uC885\uB9D0\uB3C4 \uC544\uB2C8\uB2C8\uAE4C \uB9D0\uC774\uC9C0!",
  "GreenRain_2": "\uB9E4\uB144 \uC774 \uC774\uC0C1\uD55C \uBE44\uAC00 \uC624\uB824\uB098\uBCF4\uB124. \uC790\uC5F0\uC758 \uC77C\uBD80\uB77C\uB294 \uAC78 \uC54C\uAC8C \uB41C \uB4A4\uB85C \uB2E4\uB4E4 \uC880 \uB354 \uC9C4\uC815\uD55C \uAC83 \uAC19\uAD6C\uBA3C.",
  "AcceptBirthdayGift_Negative": "\uC544, \uC774 \uB299\uC740 \uC2DC\uC7A5\uC758 \uC0DD\uC77C\uC744 \uAE30\uC5B5\uD574 \uC8FC\uB2E4\uB2C8... \uADFC\uB370 \uC774\uAC74 \uBB50\uC9C0?$h#$b#\uC74C... \uADF8\uB798, \uC0DD\uAC01\uD574 \uC900 \uAC8C \uC5B4\uB518\uAC00.",
  "cropMatured_24": "\uC544, \uC9C0\uB09C\uBC24 \uC6B4\uC1A1\uD568\uC744 \uD655\uC778\uD558\uB7EC \uBC29\uBB38\uD588\uB2E4\uAC00 \uCCAB \uD30C\uC2A4\uB2D9\uC774 \uC218\uD655\uD560 \uC900\uBE44\uAC00 \uB418\uC5C8\uB2E4\uB294 \uAC78 \uBD24\uB2E4\uB124. \uCD95\uD558\uD558\uB124, \uCD95\uD558\uD574!",
  "cropMatured_254": "%farm \uB18D\uC7A5\uC758 \uBA5C\uB860\uC774 \uC815\uB9D0 \uC798 \uC775\uC5B4\uAC00\uB294 \uAC78 \uBD24\uC5B4!$h#$b#\uADF8\uAC70 \uC544\uB098, \uC790\uB124 \uD560\uC544\uBC84\uC9C0\uAED8\uC11C \uBA5C\uB860\uC744 \uC81C\uC77C \uC88B\uC544\uD588\uC9C0.",
  "cropMatured_276": "\u0027\uAC00\uC744\u0027 \uD558\uBA74 \uBC14\uB85C \uD638\uBC15 \uC544\uB2CC\uAC00! \uC548 \uADF8\uB7F0\uAC00?",
  "Resort": "\uBA4B\uC9C0\uAD6C\uBA3C, @. \uC815\uC131 \uB4E4\uC5EC \uC218\uB9AC\uB97C \uD588\uAD70!$h",
  "married": "\uCD95\uD558\uD558\uB124, @. \uC774\uAC74 \uC790\uB124\uC640 %spouse \uBAA8\uB450\uC5D0\uAC8C \uD070 \uACBD\uC0AC\uC57C. \uC815\uB9D0 \uC81C\uB300\uB85C \uC774 \uB9C8\uC744\uC5D0 \uBFCC\uB9AC\uB97C \uB0B4\uB838\uB2E4\uB294 \uAC8C \uBCF4\uC774\uB124!",
  "married_twice": "\uB2E4\uC2DC \uD55C\uBC88 \uCD95\uD558\uD558\uB124, @.",
  "divorced_once": "\uC774\uD63C \uC11C\uB958 \uC791\uC5C5\uC740 \uC798 \uB9C8\uBB34\uB9AC\uB418\uC5C8\uB124. \uC77C\uC774 \uC774\uB807\uAC8C \uB418\uB2E4\uB2C8 \uC720\uAC10\uC774\uAD6C\uBA3C...",
  "divorced_twice": "\uB610 \uC774\uD63C\uC774\uB77C\uACE0? \uC774\uBCF4\uAC8C, @... \uC55E\uC73C\uB85C \uB610 \uACB0\uD63C\uD558\uAC8C \uB41C\uB2E4\uBA74 \uC870\uAE08 \uB354 \uC2E0\uC911\uD788 \uC0DD\uAC01\uD574 \uC8FC\uAC8C...$u",
  "movieTheater": "\uC80A\uC740 \uCE5C\uAD6C\uB4E4\uC774 \uB2E4\uB4E4 \uC0C8 \uC601\uD654\uAD00\uC744 \uC815\uB9D0 \uB9C8\uC74C\uC5D0 \uB4E4\uC5B4 \uD558\uB294 \uAC83 \uAC19\uAD6C\uBA3C.#$e#\uC601\uD654\uAD00\uC774 \uBC88\uCC3D\uD558\uBA74 \uC8FC\uBCC0 \uACBD\uC81C\uC5D0\uB3C4 \uAE0D\uC815\uC801\uC778 \uC601\uD5A5\uC744 \uC8FC\uACA0\uC9C0. \uC601\uD654 \uB0B4\uC6A9\uC5D0 \uBD88\uCF8C\uD55C \uB0B4\uC6A9\uB9CC \uC5C6\uC5C8\uC73C\uBA74 \uC88B\uACA0\uB124!",
  "Resort_Leaving": "\uBAA8\uB450 \uD0D1\uC2B9\uD574 \uC8FC\uC138\uC694! \uB9C8\uC744\uB85C \uB3CC\uC544\uAC11\uB2C8\uB2E4!",
  "Resort_Shore": "\uC774\uB7F0 \uD734\uC591\uC9C0 \uC0AC\uC5C5\uC774 \uC9C0\uC5ED \uACBD\uC81C \uD65C\uC131\uC5D0 \uC815\uB9D0 \uD070 \uAE30\uD68C\uC9C0!#$e#\uD587\uBCD5\uC5D0 \uB108\uBB34 \uC624\uB798 \uC788\uC73C\uBA74 \uC548 \uB418\uACA0\uB124, \uC790\uCE6B\uD558\uBA74 \uC218\uC5FC\uC774 \uB9D0\uB77C\uBC84\uB9AC\uACA0\uC5B4.",
  "Resort_Chair": "\uD5E4\uD5E4... \uC815\uB9D0 \uBA4B\uC9C4 \uACF3\uC774\uC57C! \uC790\uB124\uAC00 \uC5B4\uB5BB\uAC8C \uD574\uB0C8\uB294\uC9C0\uB294 \uBAA8\uB974\uACA0\uC9C0\uB9CC, \uC694\uC998 \uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC774 \uC628\uD1B5 \uC774 \uC12C \uC598\uAE30\uB77C\uB124.$h",
  "Resort_Bar": "\uD5E4\uD5E4... \uAC70\uC2A4 \uBB3C \uB9CC\uB0AC\uB124.",
  "pamHouseUpgrade": "@, \uD338\uACFC \uD398\uB2C8\uB97C \uC704\uD574 \uC5B4\uB5A4 \uC77C\uC744 \uD588\uB294\uC9C0 \uB4E4\uC5C8\uB124... \uC774\uC81C *\uADF8\uAC70\uC57C\uB9D0\uB85C* \uB0B4\uAC00 \uD3A0\uB9AC\uCEE8 \uB9C8\uC744\uC5D0\uC11C \uBCF4\uACE0 \uC2F6\uC5B4 \uD558\uB294 \uACF5\uB3D9\uCCB4\uC758\uC2DD\uC774\uC9C0!$h",
  "pamHouseUpgradeAnonymous": "@, \uB4E4\uC5C8\uB098? \uB204\uAD70\uAC00 \uD338\uACFC \uD398\uB2C8\uB97C \uC704\uD55C \uC9D1\uC744 \uC9C0\uC5B4\uB2EC\uB77C\uACE0 \uB85C\uBE48\uC744 \uACE0\uC6A9\uD588\uB2E4\uB124! \uD558\uC9C0\uB9CC \uB85C\uBE48\uC740 \uADF8\uAC8C \uB204\uAD70\uC9C0 \uB098\uD55C\uD14C \uC548 \uC54C\uB824\uC92C\uC5B4.#$e#\uB204\uAC00 \uC9C0\uBD88\uC744 \uD588\uAC74 \uAC04\uC5D0, \uD3A0\uB9AC\uCEE8 \uB9C8\uC744\uC5D0\uC11C \uC774\uB7F0 \uACF5\uB3D9\uCCB4\uC758\uC2DD\uC744 \uBCF4\uB2C8 \uB108\uBB34 \uC0AC\uB791\uC2A4\uB7FD\uAD6C\uBA3C!$h",
  "willyCrabs": "*\uD081*... *\uD081*... \uB0C4\uC0C8\uB098\uB098? \uC2E0\uC120\uD55C \uAC8C \uB0C4\uC0C8\uAC00 \uD558\uB8E8 \uC885\uC77C \uC5B4\uB514\uC120\uAC00 \uB098\uACE0 \uC788\uC5B4...$u",
  "cc_Begin": "*\uD081*... *\uD081*... \uC544, \uC61B \uB9C8\uC744\uD68C\uAD00\uC5D0\uC11C \uC2DC\uAC04\uC744 \uC880 \uBCF4\uB0B4\uAE30 \uC2DC\uC791\uD588\uAD6C\uBA3C. \uB204\uAD70\uAC00 \uADF8\uACF3\uC744 \uB3CC\uBCF4\uACE0 \uC788\uB2E4\uB294 \uC0AC\uC2E4\uC744 \uC544\uB2C8 \uAE30\uBD84\uC774 \uC88B\uB124.",
  "cc_Complete": "\uC6B0\uB9AC \uB9C8\uC744\uC5D0 \uB300\uD574 \uC774\uB807\uAC8C\uB098 \uC790\uB791\uC2A4\uB7EC\uC6E0\uB358 \uC801\uC774 \uC5C6\uB124. \uD3A0\uB9AC\uCEE8 \uB9C8\uC744\uC744 \uC704\uD574 \uB300\uB2E8\uD55C \uBD09\uC0AC\uB97C \uD574\uC8FC\uC5C8\uB124, @.$h",
  "cc_Bridge": "\uC5B4\uCC0C \uB41C \uC77C\uC778\uC9C0, \uCC44\uC11D\uC7A5\uC73C\uB85C \uAC00\uB294 \uB0A1\uC740 \uB2E4\uB9AC\uAC00 \uC218\uB9AC\uB418\uC5C8\uB124.#$b#\uC880 \uB180\uB790\uC5B4... \uADF8\uAC78 \uACE0\uCE58\uB824\uBA74 \uC778\uBD80\uAC00 \uB9CE\uC774 \uD544\uC694\uD588\uC744 \uD150\uB370!#$b#\uB300\uCCB4 \uB204\uAC00 \uC774\uAC78 \uD574\uB0B8 \uAC78\uAE4C?",
  "cc_Bus": "@, \uB4E4\uC5C8\uB098? \uBC24\uC0AC\uC774 \uB9C8\uC744\uBC84\uC2A4\uAC00 \uB2E4\uC2DC \uC791\uB3D9\uD558\uAE30 \uC2DC\uC791\uD588\uB098 \uBD10!$h#$b#\uC218\uC2ED \uB144\uAC04 \uD65C\uB3D9\uC774 \uC5C6\uC5C8\uB294\uB370... \uC815\uB9D0 \uBBF8\uC2A4\uD130\uB9AC\uD55C \uC77C\uC77C\uC138.",
  "joja_Begin": "\uADF8\uB798, \uC61B \uB9C8\uC744\uD68C\uAD00\uC774 \uC5C6\uC5B4\uC84C\uAD6C\uBA3C... \uC2DC\uB300\uAC00 \uBCC0\uD558\uBA74\uC11C \uC88B\uC558\uB358 \uAC83\uB4E4\uB3C4 \uC0AC\uB77C\uC9C0\uB294 \uAC70\uACA0\uC9C0... \uD558\uC9C0\uB9CC \uBB54\uAC00 \uC0C1\uC2E4\uAC10\uC774 \uD06C\uB124.$s#$e#\uC2DC\uC7A5\uC73C\uB85C\uC11C\uC758 \uACBD\uB825\uC774 \uC774\uAC78\uB85C \uC190\uC0C1\uB418\uB294 \uAC70 \uC544\uB2CC\uAC00 \uBAA8\uB974\uACA0\uB124.$s",
  "wonGrange": "\uB18D\uAC00 \uC804\uC2DC \uC6B0\uC2B9 \uCD95\uD558\uD558\uB124.#$e#\uD5E4\uD5E4... \uC6B0\uB9AC\uB07C\uB9AC \uC598\uAE30\uC9C0\uB9CC, \uD53C\uC5D0\uB974\uB294 \uCF67\uB300\uB97C \uC880 \uAEBE\uC5B4 \uC904 \uD544\uC694\uAC00 \uC788\uC5C8\uC5B4!$h",
  "Mon": "\uB18D\uBD80\uAC00 \uC544\uB2CC \uC774\uB4E4\uC5D0\uAC8C\uB3C4 \uC815\uC6D0\uC744 \uAC00\uAFB8\uB294 \uC77C\uC5D0 \uB300\uD574 \uC0DD\uAC01\uD558\uAE30 \uC88B\uC740 \uACC4\uC808\uC77C\uC138.#$e# \uC774 \uACC4\uACE1\uC740 \uC815\uB9D0 \uD6CC\uB96D\uD55C \uBD04\uCCA0 \uAF43\uC774 \uD53C\uAE30\uB85C \uC720\uBA85\uD558\uC9C0!$h",
  "Tue": "\uD314\uACE0 \uC2F6\uC740 \uAC8C \uC788\uB2E4\uBA74 \uC9D1 \uC606\uC5D0 \uC788\uB294 \uC6B4\uC1A1\uD568\uC5D0 \uB123\uC5B4\uB450\uAC8C\uB098.#$e#\uAC70\uAE30\uC5D0 \uC790\uB124\uAC00 \uC5B4\uB5A4 \uAC83\uC744 \uB123\uC5B4\uB458\uC9C0 \uB098\uB3C4 \uAD81\uAE08\uD558\uB124.",
  "Saloon_Entry": "\uC548\uB155, \uAC70\uC2A4!",
  "Tue2": "\uC0C8\uB85C\uC6B4 \uACC4\uC808\uC744 \uB9DE\uC774\uD560 \uB54C\uBA74 \uC9C0\uB09C \uACC4\uC808\uC758 \uC8FD\uC740 \uC791\uBB3C\uB4E4\uBD80\uD130 \uC81C\uAC70\uD574\uC57C \uD560 \uAC78\uC138. \uB0AB\uC73C\uB85C \uC791\uC5C5\uD558\uB294 \uAC8C \uC81C\uC77C \uC218\uC6D4\uD560 \uAC70\uC57C.",
  "spring_3": "\uBD04 \uC791\uBB3C\uC740 \uC880 \uC2EC\uC5C8\uB098? \uC54C\uB2E4\uC2DC\uD53C \uD55C \uACC4\uC808\uC774 \uC601\uC6D0\uD558\uC9C4 \uC54A\uB124.",
  "Town_57_40": "#$c .3#\uB9C8\uC744\uC5D0 \uC77C\uCC0D \uC654\uAD6C\uBA3C, \uADF8\uB798? \uB18D\uC7A5 \uC77C\uC740 \uBC8C\uC368 \uB9C8\uCE5C \uAC74\uAC00?#$e#\uC88B\uC740 \uC544\uCE68! \uD56D\uC0C1 \uADF8\uB807\uB4EF \uC815\uC6D0\uC744 \uC0B4\uD3B4\uBCF4\uB294 \uC911\uC77C\uC138.$h#$c .5#\uD760... \uC774\uAC74 \uC9C4\uB527\uBB3C\uC778\uAC00?$s#$e#\uD760... \uC800\uAC8C \uAC1C\uAC01\uCDA9\uC774 \uC544\uB2C8\uC5C8\uC73C\uBA74 \uC88B\uACA0\uB294\uB370...$s",
  "Wed": "\uD760... \uC138\uAE08 \uC9D5\uC218... *\uC911\uC5BC* ...\uBD04 \uCD95\uC81C \uC9C0\uCD9C... *\uC911\uC5BC*...$u#$e#\uC751?",
  "spring_10": "\uC544... \uC544\uCE68\uC5D0 \uC9C4\uD55C \uCC28 \uD55C \uC794 \uB9CC\uD55C \uAC8C \uC5C6\uC9C0.",
  "Thu": "\uC8FC\uC810\uC740 \uBC24\uC5D0 \uC880 \uD65C\uBC1C\uD574\uC9C0\uB124. \uAC00\uB054 \uC8FC\uD06C\uBC15\uC2A4\uC5D0 \uB3C8\uB3C4 \uB123\uC9C0 *\uD5C8\uD5C8*$h#$e#\uC5EC\uD558\uD2BC, \uB09C \uC77C\uC8FC\uC77C\uC5D0 \uD55C \uBC88\uCBE4 \uAC00\uC11C \uC774\uB7F0\uC800\uB7F0 \uC18C\uC2DD\uC744 \uB4E3\uB294 \uAC78 \uC88B\uC544\uD55C\uB2E4\uB124.",
  "Saloon": "\uC88B\uC740 \uC800\uB141\uC77C\uC138! \uB9C8\uC744 \uC8FC\uBBFC\uB4E4\uACFC \uC5B4\uC6B8\uB9AC\uB294 \uAC83\uC744 \uBCF4\uB2C8 \uC88B\uAD6C\uBA3C.#$b#\uAC00\uB054 \uB4E4\uB7EC\uC11C \uC774\uB7F0\uC800\uB7F0 \uC598\uAE30\uB97C \uB4E3\uB294 \uAC83\uB3C4 \uC88B\uC9C0.$h",
  "Saloon4": "\uC88B\uC740 \uC800\uB141\uC77C\uC138, @! \uC8FC\uC810\uC5D0\uC11C \uBCF4\uB2C8 \uBC18\uAC11\uAD6C\uBA3C. \uC544\uBB34\uB798\uB3C4 \uAC00\uB054 \uC26C\uC5B4\uC8FC\uB294 \uAC8C \uC88B\uC9C0.$h#$b#\uC790\uB124 \uD560\uC544\uBC84\uC9C0\uAED8\uC120 \uB108\uBB34 \uC5F4\uC2EC\uD788 \uC77C\uD558\uC168\uC9C0... \uCD94\uC5B5\uC744 \uB5A0\uC62C\uB9AC\uBA70 \uB9E5\uC8FC \uD55C\uC794 \uB354\uD574\uC57C\uACA0\uC5B4.",
  "Fri": "%farm \uB18D\uC7A5\uC5D0\uC11C \uBAA8\uB4E0 \uC77C\uC774 \uC798 \uD480\uB9AC\uACE0 \uC788\uAE38 \uBC14\uB77C\uB124. \uBC14\uC9DD \uB9D0\uB77C\uBC84\uB9B0 \uBAA8\uC2B5\uC744 \uBCF4\uACE0 \uC2F6\uC9C4 \uC54A\uC73C\uB2C8.",
  "Sat": "\uB2E4\uB4E4 \uC8FC\uB9D0\uC5D4 \uC880 \uB354 \uD589\uBCF5\uD574 \uBCF4\uC774\uC9C0, \uC548 \uADF8\uB7F0\uAC00?#$e#\uB098\uC57C \uC77C\uC774 \uC8FC 7\uC77C \uB0B4\uB0B4 \uC774\uC5B4\uC9C0\uC9C0\uB9CC \uB9D0\uC77C\uC138.",
  "Sun": "\uB09C \uD3A0\uB9AC\uCEE8 \uB9C8\uC744\uC758 \uC2DC\uC7A5\uC744 20\uB144 \uB3D9\uC548 \uD574\uC654\uB124!#$e#\uC120\uAC70\uCCA0\uC774 \uB418\uBA74 \uC544\uBB34\uB3C4 \uC9C0\uC6D0\uC744 \uC548 \uD574. \uB0B4\uAC00 \uC77C\uC744 \uC798 \uD558\uACE0 \uC788\uB2E4\uB294 \uB73B\uC73C\uB85C \uC0DD\uAC01\uD558\uACE0 \uC2F6\uB124.#$e#\uB09C \uC2DC\uC7A5\uC778 \uAC8C \uC369 \uB9C8\uC74C\uC5D0 \uB4E4\uAC70\uB4E0.",
  "event_secret1": "\uACE0\uB9D9\uB124, @. \uC774 \uC740\uD61C \uC78A\uC9C0 \uC54A\uC744 \uAC78\uC138.",
  "event_secret2": "*\uD751\uD751* ... \uADF8\uB7F0 \uC77C\uC744 \uD558\uB2E4\uB2C8, \uBBFF\uC744 \uC218 \uC5C6\uB124...$s#$b#\uC790\uB124 \uB054\uCC0D\uD55C \uC0AC\uB78C\uC774\uAD6C\uBA3C.$s",
  "summer_Mon": "\uC815\uC6D0\uC744 \uAC00\uAFB8\uB294 \uC77C\uC774 \uCDE8\uBBF8\uB77C, \uB530\uB73B\uD55C \uB0A0\uC528\uAC00 \uC62C \uC0DD\uAC01\uC5D0 \uB09C \uB9CE\uC774 \uB4E4\uB5B4\uB124.",
  "summer_Town_57_40": "#$c .3#\uC544, \uAF43\uC774 \uBA4B\uC9C0\uAC8C \uC790\uB77C\uACE0 \uC788\uAD6C\uBA3C!$h#$c .3#\uC88B\uC740 \uC544\uCE68\uC77C\uC138! \uC774 \uC774\uC2AC\uBC31\uD569\uB4E4\uC758 \uB2EC\uCF64\uD55C \uD5A5\uC774 \uB290\uAEF4\uC9C0\uB294\uAC00?#$e#\uC774\uB978 \uC2DC\uAC04\uC774\uC9C0\uB9CC \uBC8C\uC368 \uAF64 \uB530\uB73B\uD558\uB124. \uC5EC\uB984\uC740 \uB098 \uAC19\uC740 \uB299\uC740\uC774\uB4E4\uC5D0\uAC90 \uC815\uB9D0 \uC88B\uC544, \uD5C8\uD5C8.",
  "summer_Tue": "\uB0B4\uAC00 \uC5B4\uB5BB\uAC8C \uC2DC\uC7A5\uC774 \uB418\uC5C8\uB0D0\uACE0? \uC598\uAE30\uAC00 \uC880 \uAE30\uB124.#$e#\uC6B0\uB9AC \uB458 \uB2E4 \uC9C0\uAE08\uC740 \uC598\uAE30\uD558\uAE30\uC5D4 \uC880 \uB108\uBB34 \uBC14\uC058\uACE0 \uB9D0\uC774\uC9C0.",
  "summer_Wed": "\uB2EC\uBE5B \uD574\uD30C\uB9AC\uB4E4\uC774 \uACE7 \uC5EC\uAE30 \uC62C\uAC78\uC138. \uC774 \uACC4\uACE1\uC5D0\uC11C \uB0B4\uAC00 \uC81C\uC77C \uC88B\uC544\uD558\uB294 \uAC83\uB4E4 \uC911 \uD558\uB098\uC57C.",
  "summer_Thu": "\uC8FC\uC810\uC740 \uBC24\uC5D0 \uC880 \uD65C\uBC1C\uD574\uC9C0\uB124.#$e#\uB09C \uC77C\uC8FC\uC77C\uC5D0 \uD55C \uBC88\uCBE4 \uAC00\uC11C \uC774\uB7F0\uC800\uB7F0 \uC18C\uC2DD\uC744 \uB4E3\uB294 \uAC78 \uC88B\uC544\uD55C\uB2E4\uB124. \uADF8\uB9AC\uACE0 \uAC70\uC2A4\uAC00 \uB9CC\uB4E0 \uC2A4\uD30C\uAC8C\uD2F0\uB3C4 \uBA39\uACE0 \uB9D0\uC774\uC9C0.",
  "summer_Fri": "\uD760... \uC624\uB298 \uB204\uAD6C \uC0DD\uC77C\uC778\uAC00 \uBAA8\uB974\uACA0\uB124? \uD53C\uC5D0\uB974 \uAC00\uAC8C \uC55E\uC5D0 \uC788\uB294 \uB2EC\uB825 \uD655\uC778\uD574\uBD10\uC57C\uACA0\uAD6C\uBA3C.",
  "summer_Sat": "\uB2E4\uB4E4 \uC8FC\uB9D0\uC5D4 \uC880 \uB354 \uD589\uBCF5\uD574 \uBCF4\uC774\uC9C0, \uC548 \uADF8\uB7F0\uAC00?#$e#\uB098\uC57C \uC77C\uC774 \uC8FC 7\uC77C \uB0B4\uB0B4 \uC774\uC5B4\uC9C0\uC9C0\uB9CC \uB9D0\uC77C\uC138.",
  "summer_Sun": "\uC790\uB124 \uD639\uC2DC, \uB18D\uC7A5\uC5D0\uC11C \uBE14\uB8E8\uBCA0\uB9AC \uD0A4\uC6B0\uB098??#$e#\uB0B4\uAC00 \uC2E0\uC120\uD55C \uBE14\uB8E8\uBCA0\uB9AC\uB97C \uCC38 \uC88B\uC544\uD574\uC11C \uB9D0\uC77C\uC138.%revealtaste:Lewis:258",
  "fall_Mon": "\uBA87\uBA87 \uC8FC\uBBFC\uB4E4\uC740 \uB0AF\uC120 \uC0AC\uB78C\uC744 \uC880 \uACBD\uACC4\uD55C\uB2E4\uB124. \uC2E0\uB8B0\uB97C \uC5BB\uC5B4\uC57C \uADF8\uB4E4\uC774 \uB9C8\uC74C\uC744 \uC5F4 \uAC78\uC138.#$e#\uAFB8\uC900\uD55C \uD0DC\uB3C4\uB97C \uBCF4\uC774\uBA74 \uADF8\uB4E4\uB3C4 \uB9C8\uC74C\uC5D0 \uB4E4\uC5B4 \uD560 \uAC70\uC57C.$h",
  "fall_Tue": "\uB0B4\uAC00 \uCC98\uC74C \uC2DC\uC7A5\uC774 \uB41C \uAC83\uB3C4 \uC774 \uC2DC\uAE30 \uC988\uC74C\uC774\uC5C8\uC9C0, \uADF8\uAC83\uB3C4 20\uB144\uB3C4 \uC804\uC5D0.#$e#\uC815\uB9D0 \uB098\uC774\uAC00 \uB4E0 \uAE30\uBD84\uC774\uB124.$s",
  "fall_Wed": "\uB9C8\uC744\uC5D0 \uAD00\uD574 \uC81C\uC548\uD560 \uC0AC\uD56D\uC774 \uC788\uB2E4\uBA74, \uCABD\uC9C0\uC5D0 \uC801\uC5B4\uC11C \uB0B4 \uC81C\uC548 \uC0C1\uC790\uC5D0 \uB123\uC5B4\uC8FC\uAC8C\uB098.#$e#\uC544, \uB9DE\uB2E4... \uB098 \uC81C\uC548 \uC0C1\uC790\uAC00 \uC5C6\uB124\uB9CC.",
  "fall_Wed2": "\uB9E4\uC8FC \uC218\uC694\uC77C \uB09C \uC544\uCE68\uC2DD\uC0AC\uB85C \uBA54\uBC00 \uC640\uD50C\uACFC \uCEE4\uD53C\uB97C \uBA39\uB294\uB2E4\uB124. \uB3C5\uC2E0\uC73C\uB85C \uC9C0\uB0B4\uB294\uB370 \uC0B6\uC744 \uADF8\uB098\uB9C8 \uD765\uBBF8\uB86D\uAC8C \uD574\uC8FC\uB294 \uC791\uC740 \uC804\uD1B5 \uC911 \uD558\uB098\uC9C0.$h",
  "fall_Town_57_40": "#$c .3#\uD750\uC74C... \uC694\uC998 \uB098\uBB47\uC870\uAC01\uC5D0\uC11C \uC774\uC0C1\uD55C \uC791\uC740 \uBC84\uC12F\uB4E4\uC774 \uC790\uAFB8 \uB098\uACE0 \uC788\uB124. \uC5B4\uB5A4 \uC885\uB958\uC758 \uBC84\uC12F\uC774\uC9C0?#$c .3#\uC88B\uC740 \uC544\uCE68! \uC11C\uC11C\uD788 \uB0A0\uC774 \uCD94\uC6CC\uC9C0\uACE0 \uC788\uB124, \uADF8\uB798\uC11C \uC815\uC6D0\uB3C4 \uC644\uB9CC\uD558\uAC8C \uB9C8\uBB34\uB9AC\uB97C \uC9D3\uACE0 \uC788\uC9C0.#$e#dk, \uB9C8\uC744\uC5D0 \uC77C\uCC0D \uC654\uAD6C\uBA3C, \uADF8\uB798? \uB18D\uC7A5 \uC77C\uC740 \uBC8C\uC368 \uB9C8\uCE5C \uAC74\uAC00?",
  "fall_Thu": "\uC8FC\uC810\uC740 \uBC24\uC5D0 \uC880 \uD65C\uBC1C\uD574\uC9C0\uB124.#$e#\uB09C \uC77C\uC8FC\uC77C\uC5D0 \uD55C \uBC88\uCBE4 \uAC00\uC11C \uC774\uB7F0\uC800\uB7F0 \uC18C\uC2DD\uC744 \uB4E3\uB294 \uAC78 \uC88B\uC544\uD55C\uB2E4\uB124.",
  "fall_Fri": "\uC790\uB124 \uB18D\uC7A5\uC5D0\uC11C \uBAA8\uB4E0 \uC77C\uC774 \uC798 \uD480\uB9AC\uACE0 \uC788\uAE38 \uBC14\uB77C\uB124.",
  "fall_12": "\uB18D\uC7A5\uC5D0 \uC591\uBD09\uC7A5\uC740 \uC788\uB098?#$e#\uAF43 \uADFC\uCC98\uC5D0 \uC124\uCE58\uD55C\uB2E4\uBA74 \uB2E4\uC591\uD55C \uC885\uB958\uC758 \uAFC0\uC744 \uC5BB\uC744 \uC218 \uC788\uB2E4\uB124.",
  "fall_19": "\uAC00\uB054\uC740 \uB545\uC5D0 \uBB34\uC5B8\uAC00 \uBB3B\uD600\uC788\uB2E4\uB294 \uAC83\uC744 \uC54C\uC544\uCC28\uB9B4 \uC218 \uC788\uC9C0. \uB208 \uD06C\uAC8C \uB728\uACE0 \uB2E4\uB2C8\uAC8C\uB098.",
  "fall_Fri4": "\uAC70\uC2A4\uC758 \u0027\uBE44\uBC00\u0027 \uC2A4\uD30C\uAC8C\uD2F0 \uC18C\uC2A4\uB97C \uBA39\uC5B4\uBCF8 \uC801 \uC788\uB098?$s#$b#...\uC7AC\uB8CC\uB294 \uBE44\uBC00\uC77C\uC9C0\uB77C\uB3C4, \uB0C4\uC0C8\uB294 \uADF8\uB807\uAC8C \uBE44\uBC00\uC2A4\uB7FD\uC9C4 \uC54A\uB2E4\uB124.#$b#\uADF8\uB7FC \uB098\uC911\uC5D0 \uB610 \uBCF4\uAC8C.",
  "fall_Sun": "\uB18D\uC7A5\uC5D0\uC11C \uCD5C\uC120\uC744 \uB2E4\uD558\uACE0 \uC788\uB098, @? \uB2E4\uC7AC\uB2E4\uB2A5\uD55C \uC8FC\uBBFC\uC774 \uB418\uB824\uBA74 \uB2E4\uC591\uD55C \uBD84\uC57C\uC5D0\uC11C \uB9CE\uC740 \uAC83\uC744 \uC774\uB904\uB0B4\uC57C \uD560 \uAC70\uC57C.",
  "winter_1": "\uADF8\uB798, \uACA8\uC6B8\uC774 \uC654\uB124! \uB9C8\uC744 \uC8FC\uBBFC\uB4E4\uC774 \uC774\uC81C \uB300\uBD80\uBD84 \uC2E4\uB0B4\uC5D0\uC11C \uC0DD\uD65C\uD558\uACA0\uC9C0.#$e#\uBB50, \uC801\uC5B4\uB3C4 \uC5B4\uB514\uC11C \uCC3E\uC544\uC57C \uD560\uC9C0\uB294 \uC54C\uAE30 \uC26C\uC6B8\uAC78\uC138!$h",
  "winter_Mon": "\uC77C \uB144\uC774 \uAC70\uC758 \uB05D\uB098\uAC00\uB124!#$e#\uC62C\uD574 \uC0DD\uC0B0\uC801\uC778 \uD55C \uD574\uB97C \uBCF4\uB0C8\uAE30\uB97C \uBC14\uB77C\uB124!",
  "winter_Tue": "\uB0B4\uB144 \uB9C8\uC744\uC744 \uD5A5\uC0C1\uC2DC\uD0AC \uACC4\uD68D\uC744 \uC0DD\uAC01\uD558\uAE30 \uC2DC\uC791\uD574\uC57C \uD560 \uD150\uB370!",
  "winter_Wed": "\uB9E4\uC77C \uBC24 \uC0DD\uC0B0\uD488\uC744 \uC6B4\uC1A1\uD558\uB7EC \uCC3E\uC544\uC624\uACA0\uB124, \uB208\uC774 \uC624\uB354\uB77C\uB3C4 \uB9D0\uC774\uC9C0.#$e#\uACA8\uC6B8\uC774\uB77C\uB3C4 \uB3C8\uC744 \uBC8C\uC5B4\uC57C \uD560 \uD14C\uB2C8!",
  "winter_Fri": "\uC790\uB124 \uB18D\uC7A5\uC5D0\uC11C \uBAA8\uB4E0 \uC77C\uC774 \uC798 \uD480\uB9AC\uACE0 \uC788\uAE38 \uBC14\uB77C\uB124.",
  "winter_Fri6": "\uB09C \uACB0\uD63C\uD55C \uC801\uC774 \uC5C6\uB124. \uAC00\uC871\uB3C4 \uC5C6\uACE0. \uB0B4 \uC0B6\uC758 \uC758\uBBF8\uB294 \uADF8\uC800 \uC2DC\uC7A5\uC774\uB77C\uB294 \uC0AC\uC2E4\uC774\uC9C0.$s#$e#\uC774\uAC8C \uAC00\uCE58\uAC00 \uC788\uB294 \uC77C\uC77C\uAE4C?$s#$e#...*\uD55C\uC228*...$s",
  "winter_Sun": "\uC548\uB155, @! \uC624\uB298\uC740 \uC880 \uC5B4\uB5A4\uAC00?$h#$e#\uD639\uC2DC \uB9C8\uB2C8\uB97C \uBCF4\uAC8C \uB41C\uB2E4\uBA74 \uC548\uBD80 \uC880 \uC804\uD574\uC8FC\uAC8C\uB098."
