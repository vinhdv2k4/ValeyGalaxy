{
  "Introduction": "\u042D\u0439, \u0430 \u0434\u043B\u044F \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0442\u044B \u043D\u0435\u043F\u043B\u043E\u0445\u043E\u0439 \u0448\u0430\u0445\u0442\u0435\u0440.",
  "AcceptBirthdayGift_Positive": "\u041E! \u042F \u0447\u0438\u0442\u0430\u043B \u043E \u0442\u0430\u043A\u043E\u0439 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0438... \u042D\u0442\u043E \u00AB\u043F\u043E\u0434\u0430\u0440\u043E\u043A \u043D\u0430 \u0434\u0435\u043D\u044C \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F\u00BB, \u0434\u0430? \u0425\u043C-\u043C, \u043E\u0447\u0435\u043D\u044C \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E...",
  "AcceptBirthdayGift_Negative": "\u041E! \u042F \u0447\u0438\u0442\u0430\u043B \u043E \u0442\u0430\u043A\u043E\u0439 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0438... \u042D\u0442\u043E \u00AB\u043F\u043E\u0434\u0430\u0440\u043E\u043A \u043D\u0430 \u0434\u0435\u043D\u044C \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F\u00BB, \u0434\u0430?#$b#\u0410 \u043C\u0443\u0441\u043E\u0440 \u0434\u0430\u0440\u0438\u0442\u044C \u2014 \u0442\u043E\u0436\u0435 \u0447\u0430\u0441\u0442\u044C \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0438?",
  "GreenRain": "\u042F \u0437\u0435\u043B\u0435\u043D\u044B\u0439 \u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u0440\u0430\u0437\u043B\u0438\u0447\u0430\u044E.#$b#\u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u044D\u0442\u043E \u0438\u0437-\u0437\u0430 \u043C\u043E\u0435\u0433\u043E \u043F\u043E\u0434\u0437\u0435\u043C\u043D\u043E\u0433\u043E \u043E\u0431\u0440\u0430\u0437\u0430 \u0436\u0438\u0437\u043D\u0438.",
  "AcceptGift_(O)StardropTea": "*\u043D\u044E\u0445*... \u042D\u0442\u043E \u043C\u043E\u043B\u043E\u043A\u043E? *\u0445\u043B\u044E\u043F*... \u0425\u043C-\u043C... \u0412\u043A\u0443\u0441\u043D\u043E.",
  "Mon": "\u0412\u0441\u0435 \u044D\u0442\u0438 \u0432\u0435\u0449\u0438 \u044F \u0434\u043E\u0431\u044B\u043B \u0441 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438. \u042F \u043F\u0440\u043E\u0441\u0442\u043E \u0431\u0435\u0440\u0443 \u0438\u0445 \u043F\u043E \u043D\u043E\u0447\u0430\u043C \u0443 \u0432\u0430\u0448\u0435\u0433\u043E \u043D\u0430\u0440\u043E\u0434\u0430.#$e#\u0425\u043C-\u043C? \u0427\u0442\u043E \u0437\u0430 \u043F\u043E\u043D\u044F\u0442\u0438\u0435 \u0442\u0430\u043A\u043E\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0432\u044B \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0435 \u0022\u0447\u0430\u0441\u0442\u043D\u043E\u0439 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C\u044E\u0022?",
  "AcceptGift_Neutral_milk_item": "\u0410, \u00AB\u043C\u043E\u043B\u043E\u043A\u043E\u00BB... *\u0445\u043B\u044E\u043F*... \u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E. \u041D\u0430\u043F\u043E\u043C\u043D\u0438... \u041E\u0442\u043A\u0443\u0434\u0430 \u0438\u043C\u0435\u043D\u043D\u043E \u0431\u0435\u0440\u0435\u0442\u0441\u044F \u044D\u0442\u043E\u0442 \u0441\u043E\u043A?#$b#...!!! *\u0442\u044C\u0444\u0443*",
  "Tue": "\u0410\u0445... \u041F\u043E\u0445\u043B\u0435\u0431\u043A\u0430 \u0438\u0437 \u043F\u0435\u0449\u0435\u0440\u043D\u043E\u0439 \u043C\u043E\u0440\u043A\u043E\u0432\u043A\u0438, \u0436\u0430\u0440\u0435\u043D\u0430\u044F \u043F\u0435\u0449\u0435\u0440\u043D\u0430\u044F \u043C\u043E\u0440\u043A\u043E\u0432\u043A\u0430, \u0441\u0443\u043F \u0438\u0437 \u043F\u0435\u0449\u0435\u0440\u043D\u043E\u0439 \u043C\u043E\u0440\u043A\u043E\u0432\u043A\u0438 \u0438 \u043F\u0435\u0449\u0435\u0440\u043D\u0430\u044F \u043C\u043E\u0440\u043A\u043E\u0432\u043A\u0430 \u0432 \u0441\u0443\u0445\u0430\u0440\u044F\u0445.#$e#... \u0418 \u0440\u0430\u043C\u0435\u043A\u0438\u043D \u0441 \u0431\u0440\u044E\u043B\u0435 \u0438\u0437 \u043F\u0435\u0449\u0435\u0440\u043D\u043E\u0439 \u043C\u043E\u0440\u043A\u043E\u0432\u043A\u0438, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0434\u0441\u043B\u0430\u0441\u0442\u0438\u0442\u044C \u043D\u043E\u0447\u044C.#$e#\u0427\u0442\u043E?",
  "firstVisit_IslandNorth": "\u0415\u0441\u043B\u0438 \u0437\u0430\u0439\u0434\u0435\u0448\u044C \u0432 \u0432\u0443\u043B\u043A\u0430\u043D \u043D\u0430 \u0418\u043C\u0431\u0438\u0440\u043D\u043E\u043C \u043E\u0441\u0442\u0440\u043E\u0432\u0435, \u043C\u043E\u0436\u0435\u0448\u044C \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C \u043C\u043E\u0439 \u043D\u0430\u0440\u043E\u0434. \u041D\u0435 \u0431\u043E\u0439\u0441\u044F. \u041C\u044B \u043B\u044E\u0434\u0435\u0439 \u043D\u0435 \u0442\u0440\u043E\u0433\u0430\u0435\u043C.",
  "mineArea_121": "\u0410 \u0437\u043D\u0430\u0435\u0448\u044C, \u0432 \u0433\u043E\u0440\u043D\u043E\u043C \u0434\u0435\u043B\u0435 \u0442\u044B \u043D\u0438\u0447\u0435\u0433\u043E \u0442\u0430\u043A. \u0414\u043B\u044F \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430.",
  "fishCaught_158": "\u041E, \u044D\u0442\u043E \u0447\u0442\u043E, \u041A\u0430\u043C\u0435\u043D\u044C-\u0440\u044B\u0431\u0430? \u0417\u043D\u0430\u044E \u0442\u0430\u043A\u0438\u0445. \u041C\u044B \u0438\u0445 \u0438\u043D\u043E\u0433\u0434\u0430 \u0434\u043E\u043C\u0430 \u0434\u0435\u0440\u0436\u0438\u043C.",
  "fishCaught_161": "\u041E, \u0443 \u0442\u0435\u0431\u044F \u0442\u0430\u043C \u041B\u0435\u0434\u043E\u043F\u0438\u043F? \u041E\u043D\u0438 \u043C\u0435\u043B\u043A\u0438\u0435 \u0438 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u0440\u0435\u0437\u0432\u044B\u0435, \u0434\u0430\u0436\u0435 \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0442\u044F\u0436\u043A\u0438\u0435 \u0443\u0441\u043B\u043E\u0432\u0438\u044F, \u0432 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043E\u043D\u0438 \u0436\u0438\u0432\u0443\u0442. \u041E\u0434\u043D\u0430\u043A\u043E \u043C\u043E\u0439 \u043D\u0430\u0440\u043E\u0434 \u0438\u0437\u0431\u0435\u0433\u0430\u0435\u0442 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0445 \u0437\u043E\u043D... \u041E\u0447\u0435\u043D\u044C \u0445\u043E\u043B\u043E\u0434\u043D\u043E!",
  "fishCaught_162": "\u041E, \u044D\u0442\u043E \u0443 \u0442\u0435\u0431\u044F \u041B\u0430\u0432\u043E\u0432\u044B\u0439 \u0443\u0433\u043E\u0440\u044C? \u041E\u0447\u0435\u043D\u044C \u0445\u043E\u0440\u043E\u0448\u043E! \u041B\u043E\u0432\u043B\u044F \u041B\u0430\u0432\u043E\u0432\u043E\u0433\u043E \u0443\u0433\u0440\u044F \u2014 \u0432\u0430\u0436\u043D\u0430\u044F \u0447\u0430\u0441\u0442\u044C \u043D\u0430\u0448\u0435\u0439 \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u044B. \u041E\u043D\u0438 \u0441\u0447\u0438\u0442\u0430\u044E\u0442\u0441\u044F \u0434\u0435\u043B\u0438\u043A\u0430\u0442\u0435\u0441\u043E\u043C!",
  "firstVisit_Caldera": "\u0422\u044B \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B \u043B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u0443\u044E \u0414\u0432\u0430\u0440\u0444\u0438\u0439\u0441\u043A\u0443\u044E \u043A\u0443\u0437\u043D\u0438\u0446\u0443? \u041D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E... \u0421\u0430\u043C \u044F \u0435\u0435 \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0432\u0438\u0434\u0435\u043B.#$e#\u042D\u0442\u043E \u043E\u0447\u0435\u043D\u044C \u0441\u0442\u0430\u0440\u044B\u0439 \u0430\u043F\u043F\u0430\u0440\u0430\u0442, \u043D\u0438\u043A\u0442\u043E \u0438\u0437 \u043C\u043E\u0435\u0433\u043E \u043D\u0430\u0440\u043E\u0434\u0430 \u043D\u0435 \u0437\u043D\u0430\u0435\u0442, \u043A\u0430\u043A \u043E\u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442. \u041D\u043E \u044D\u0442\u043E \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u043E \u0434\u0432\u0430\u0440\u0444\u0438\u0439\u0441\u043A\u0430\u044F \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u044F.",
  "Wed": "\u042D\u0439, \u0445\u043E\u0447\u0435\u0448\u044C \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043A\u0443\u043F\u0438\u0442\u044C?",
  "Wed_6": "\u0414\u0430\u0432\u043D\u044B\u043C-\u0434\u0430\u0432\u043D\u043E \u043C\u043E\u0439 \u043D\u0430\u0440\u043E\u0434 \u0437\u043D\u0430\u043B \u0442\u0430\u0439\u043D\u044B \u043F\u0440\u043E\u0434\u0432\u0438\u043D\u0443\u0442\u043E\u0439 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0438. \u0422\u043E\u043C\u0443 \u0435\u0441\u0442\u044C \u0430\u0440\u0445\u0435\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430.#$e#\u041D\u043E \u043C\u043D\u0435 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043E\u0442\u043A\u0443\u0434\u0430 \u0432\u0441\u0435 \u044D\u0442\u043E \u043F\u043E\u044F\u0432\u0438\u043B\u043E\u0441\u044C? \u0418 \u043A\u0443\u0434\u0430 \u0432\u0441\u0435 \u044D\u0442\u043E \u0438\u0441\u0447\u0435\u0437\u043B\u043E? \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u043D\u0430 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0432\u043E\u043F\u0440\u043E\u0441\u044B \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0431\u0443\u0434\u0435\u0442 \u043E\u0442\u0432\u0435\u0442\u043E\u0432...",
  "Thu_4": "\u0423\u044E\u0442\u043D\u0435\u0435 \u0432\u0441\u0435\u0433\u043E \u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E \u0441\u0435\u0431\u044F \u043F\u043E\u0434 \u0437\u0435\u043C\u043B\u0435\u0439.#$e#\u0427\u0435\u043C \u0433\u043B\u0443\u0431\u0436\u0435 \u043F\u043E\u0434 \u0437\u0435\u043C\u043B\u0435\u0439, \u0442\u0435\u043C \u043B\u0443\u0447\u0448\u0435.",
  "Fri": "\u0422\u0435\u0431\u0435 \u0432\u0435\u0434\u044C \u0440\u0430\u043D\u044C\u0448\u0435 \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0434\u043E\u0432\u043E\u0434\u0438\u043B\u043E\u0441\u044C \u0432\u0438\u0434\u0435\u0442\u044C \u0434\u0432\u0430\u0440\u0444\u0430, \u043F\u0440\u0430\u0432\u0434\u0430?",
  "Sat_8": "\u0428\u0430\u0445\u0442\u044B \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C \u043F\u0440\u0435\u0434\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438 \u043E\u043F\u0430\u0441\u043D\u044B\u043C\u0438. \u0411\u0443\u0434\u044C \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u0435\u043D, \u0434\u0440\u0443\u0433.",
  "Sat": "\u0412 \u0448\u0430\u0445\u0442\u0435 \u043E\u043F\u0430\u0441\u043D\u043E. \u041C\u043E\u0436\u0435\u0442, \u043A\u0443\u043F\u0438\u0448\u044C \u0443 \u043C\u0435\u043D\u044F \u043F\u0430\u0440\u0443 \u0432\u0435\u0449\u0435\u0439, \u0447\u0442\u043E\u0431\u044B \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0442\u044C \u0441\u0435\u0431\u0435 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C?",
  "Sun": "\u041A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u0442\u044B \u043C\u043D\u0435 \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0435\u0448\u044C \u043E \u043D\u0430\u043F\u0438\u0442\u043A\u0435, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432\u044B \u0437\u043E\u0432\u0435\u0442\u0435 \u00AB\u043C\u043E\u043B\u043E\u043A\u043E\u00BB.",
  "Thu": "\u0422\u044B \u0432\u0435\u0434\u044C \u043D\u0435 \u0448\u043F\u0438\u043E\u043D \u041D\u0430\u0440\u043E\u0434\u0430 \u0422\u0435\u043D\u0435\u0439, \u043F\u0440\u0430\u0432\u0434\u0430?#$e#\u042F \u0437\u0430 \u0442\u043E\u0431\u043E\u0439 \u0441\u043B\u0435\u0436\u0443.",
  "Fri_2": "\u0411\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E \u043B\u044E\u0434\u0435\u0439 \u0431\u043E\u044F\u0442\u0441\u044F \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E... \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u044F \u0441\u043F\u0440\u044F\u0442\u0430\u043B \u0441\u0432\u043E\u044E \u043B\u0430\u0432\u043A\u0443 \u0437\u0434\u0435\u0441\u044C.#$e#\u0422\u0435\u0431\u0435 \u044F \u043C\u043E\u0433\u0443 \u0432\u0435\u0440\u0438\u0442\u044C, \u0442\u0432\u043E\u0438 \u0448\u0430\u0445\u0442\u0435\u0440\u0441\u043A\u0438\u0435 \u043D\u0430\u0432\u044B\u043A\u0438 \u0445\u043E\u0440\u043E\u0448\u0438."
