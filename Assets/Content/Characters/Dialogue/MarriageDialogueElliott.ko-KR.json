{
  "Rainy_Day_0": "\uC624\uB298\uC740 \uC601\uAC10\uC774 \uC798 \uB5A0\uC624\uB974\uB124... \uAE00 \uC880 \uC4F8\uAE4C \uC2F6\uC5B4.",
  "Rainy_Day_1": "\uBE57\uC18C\uB9AC\uAC00, \uC544\uC8FC \uC791\uC740 \uBC29\uBA74\uC73C\uB85C\uB294, \uD574\uBCC0\uC758 \uB0B4 \uC624\uB450\uB9C9\uC744 \uB5A0\uC62C\uB9AC\uAC8C \uD574.#$e#\uB18D\uC7A5\uB3C4 \uC544\uC8FC \uBA4B\uC9C0\uC9C0\uB9CC, \uBC14\uB2F7\uC18C\uB9AC\uAC00 \uADF8\uB9AC\uC6B8 \uB54C\uB3C4 \uC788\uC5B4.",
  "Rainy_Day_2": "\uC77C\uCC0D \uC77C\uC5B4\uB098\uC11C \uCEE4\uD53C \uC880 \uB0B4\uB838\uC5B4.[395]#$e#\uC774 \uC815\uAD50\uD55C \uC74C\uB8CC \uD55C \uC794\uC774\uBA74 \uC774\uB978 \uC544\uCE68\uC774 \uD6E8\uC52C \uC990\uAC70\uC6CC\uC9C0\uB354\uB77C\uACE0.",
  "Rainy_Day_3": "\uC5EC\uBCF4, \uB098 \uC624\uB298\uC740 \uC2E4\uB0B4\uC5D0 \uC788\uC73C\uB824\uACE0. \uBE44\uAC00 \uC624\uBA74 \uBA38\uB9AC\uAC00 \uCD95 \uB298\uC5B4\uC9C0\uB354\uB77C\uACE0.",
  "Rainy_Day_4": "\uAE00 \uC4F8 \uC601\uAC10\uC740 \uB0A0\uC528 \uAC19\uC544... \uC608\uACE0 \uC5C6\uC774 \uC624\uACE0 \uAC00\uC9C0. \uC624\uB298\uC740 \uC644\uC804\uD788 \uCE59\uCE59\uD558\uB124.$s#$e#\uCC3D\uC758\uB825 \uC880 \uD65C\uC131\uD654\uC2DC\uD0AC \uC218 \uC788\uAC8C \uACE0\uC804 \uD558\uB098 \uC77D\uC744\uAE4C.",
  "patio_Elliott": "\uC544, \uCC45 \uC77D\uAE30 \uC815\uB9D0 \uC88B\uC740 \uB0A0\uC774\uC57C... \uC548 \uADF8\uB798, \uC5EC\uBCF4?",
  "Rainy_Night_0": "\uC88B\uC740 \uC800\uB141. \uC624\uB298 \uC0DD\uC0B0\uC801\uC778 \uD558\uB8E8 \uBCF4\uB0C8\uC5B4, @?^\uC88B\uC740 \uC800\uB141. \uC624\uB298 \uC0DD\uC0B0\uC801\uC778 \uD558\uB8E8 \uBCF4\uB0C8\uC5B4, \uC5EC\uBCF4?",
  "Rainy_Night_1": "\uB108 \uC65C \uC774\uB807\uAC8C \uCC28\uAC00\uC6CC! \uB0B4\uAC00 \uB370\uC6CC\uC904\uAC8C.$l",
  "Rainy_Night_2": "\uB0B4\uAC00 \uD45C\uD604\uB825\uC774 \uB0A8\uBD80\uB7FD\uC9C0 \uC54A\uC740\uB370, \uC544\uC9C1\uB3C4 \uB124 \uB9E4\uB825\uC744 \uC81C\uB300\uB85C \uBB18\uC0AC\uD560 \uBC29\uBC95\uC744 \uBAA8\uB974\uACA0\uC5B4.$l^\uB0B4\uAC00 \uD45C\uD604\uB825\uC774 \uB0A8\uBD80\uB7FD\uC9C0 \uC54A\uC740\uB370, \uC544\uC9C1\uB3C4 \uB124 \uC544\uB984\uB2E4\uC6C0\uC744 \uC81C\uB300\uB85C \uBB18\uC0AC\uD560 \uBC29\uBC95\uC744 \uBAA8\uB974\uACA0\uC5B4.$l",
  "Rainy_Night_3": "\uC624\uB298 \uBB50 \uD588\uB0D0\uACE0? \uC774\uAC83\uB9CC \uB9D0\uD574\uB458\uAC8C... \uC774 \uAC15\uC778\uD55C \uC778\uC0C1\uC744 \uC720\uC9C0\uD558\uB824\uBA74 \uD560 \uC77C\uC774 \uB9CE\uC544!",
  "Rainy_Night_4": "\uC624\uD6C4 \uB0B4\uB0B4 \uBC14\uB2E4\uC5D0 \uB300\uD574 \uBC31\uC77C\uBABD\uC744 \uAFE8\uC5B4. \uADF8\uB798\uC11C \uD574\uC0B0\uBB3C \uC694\uB9AC\uB97C \uD558\uAE30\uB85C \uACB0\uC815\uD588\uC9C0. [198 202 727 728]$h",
  "Indoor_Day_0": "\uC6B0\uB9AC\uAC00 \uD568\uAED8 \uC9C0\uB0B4\uAE30 \uC2DC\uC791\uD55C \uB4A4\uB85C \uC790\uAE30\uAD00\uB9AC\uB3C4 \uD6E8\uC52C \uC88B\uC544\uC84C\uC5B4. \uBBF8\uD63C\uB0A8\uC73C\uB85C \uC9C0\uB0B8 \uB0B4 \uC0B6\uC740 \uADF8\uB807\uAC8C \uAC74\uAC15\uD558\uC9C4 \uC54A\uC558\uAC70\uB4E0.",
  "Indoor_Day_1": "\uC88B\uC740 \uC544\uCE68\uC774\uC57C, @! \uCEE4\uD53C \uC880 \uB0B4\uB838\uC5B4.[395]#$e#\uC774 \uC6D0\uAE30\uC655\uC131\uD55C \uB9DB\uC744 \uC544\uCE68\uB9C8\uB2E4 \uAC08\uB9DD\uD558\uAC8C \uB418\uB124.",
  "Indoor_Day_2": "\uD639\uC2DC \uC9D1\uC548\uC5D0 \uAC70\uBBF8\uAC00 \uBCF4\uC774\uBA74, \uC8FD\uC774\uC9C0 \uB9C8! \uB098\uD55C\uD14C \uC54C\uB824\uC8FC\uBA74 \uB0B4\uAC00 \uBD88\uC30D\uD55C \uAC70\uBBF8\uB97C \uBC16\uC73C\uB85C \uBCF4\uB0BC\uAC8C.",
  "Indoor_Day_3": "\uC624\uB298 \uD658\uC0C1\uC801\uC778 \uB0A0\uC774 \uB420 \uAC70\uC57C... \uB290\uAEF4\uC838!$h#$e#\uCF54 \uC548\uC5D0 \uD2B9\uBCC4\uD55C \uB290\uB08C\uC744 \uBC1B\uACE0 \uC788\uC5B4...",
  "Indoor_Day_4": "\uB124\uAC00 \uB0B4 \uBA38\uB9AC\uB97C \uC544\uC8FC \uC9E7\uAC8C \uAE4E\uB294 \uC545\uBABD\uC744 \uC694\uC998 \uBC18\uBCF5\uD574\uC11C \uAFD4... \uB098\uD55C\uD14C \uADF8\uB7F0 \uC9D3\uC740 \uC548 \uD560 \uAC70\uC9C0, \uADF8\uCE58?$s#$e#\uB09C \uB110 \uBBFF\uC5B4.",
  "Indoor_Night_0": "\uAC00\uC7A5 \uBC1D\uC740 \uACA8\uC6B8\uC758 \uBCC4\uB3C4, \uC774\uB9AC\uB4D0 \uAD11\uB9E5\uC758 \uC77C\uB801\uC774\uB294 \uBE5B\uB3C4... \uADF8 \uBB34\uC5C7\uB3C4 \uB0B4 \uBA4B\uC9C4 \uB0A8\uC790\uC5D0 \uBE44\uD560 \uAC83\uC774 \uBABB\uB418\uC9C0.$l^\uAC00\uC7A5 \uBC1D\uC740 \uACA8\uC6B8\uC758 \uBCC4\uB3C4, \uC694\uC815 \uC7A5\uBBF8\uC758 \uD5A5\uB3C4... \uADF8 \uBB34\uC5C7\uB3C4 \uB124 \uB9E4\uD639\uC801\uC778 \uC544\uB984\uB2E4\uC6C0\uC5D0 \uBE44\uD560 \uAC83\uC774 \uBABB\uB418\uC9C0.$l",
  "Indoor_Night_1": "\uBD88\uC774 \uD0C1\uD0C1\uD558\uACE0 \uD0C0\uB294 \uC18C\uB9AC\uB294 \uC9D1\uC548\uC5D0 \uBA4B\uC9C4 \uBD84\uC704\uAE30\uB97C \uB354\uD574\uC8FC\uC9C0... \uB098\uBB34 \uD55C \uC870\uAC01 \uD55C \uC870\uAC01\uC774 \uB2E4\uB974\uAC8C \uD0C0\uAC70\uB4E0.",
  "Indoor_Night_2": "\uB0B4\uAC00 \uD574\uBCC0\uC5D0 \uC0B4 \uB54C\uB294 \uC2DD\uBB3C\uC744 \uD0A4\uC6B0\uB294 \uAC8C \uC131\uACF5\uC801\uC778 \uACBD\uC6B0\uAC00 \uC5C6\uC5C8\uC5B4. \uB110 \uBCF4\uBA74\uC11C \uD55C\uB450 \uAC00\uC9C0 \uBC30\uC6B8 \uC218 \uC788\uC73C\uBA74 \uC88B\uC744 \uAC83 \uAC19\uC544.#$e#\uC774\uB807\uAC8C \uBCF4\uBA74, \uB124\uAC00 \uB2EC\uC778\uC774\uACE0 \uB09C \uBCC0\uBCC0\uCE58 \uC54A\uC740 \uACAC\uC2B5\uC0DD\uC778 \uAC70\uC9C0.",
  "Indoor_Night_3": "\uB2F9\uC2E0\uC758 \uAC10\uD0C4\uC2A4\uB7F0 \uC5BC\uAD74\uC744 \uBCF4\uB178\uB77C\uBA74, \uD615\uD0DC\uC640 \uC6B0\uC544\uD568\uC774 \uC9C4\uADC0\uD55C \uBCF4\uC11D \uAC19\uC544, \uC2EC\uC7A5\uC774... \uD55C\uBC24\uC758 \uB450\uB824\uC6C0\uC5D0 \uCC22\uACA8\uC788\uB358 \uC2EC\uC7A5\uC774, \uD669\uAE08\uBE5B \uAD11\uD718\uB85C \uC815\uD654\uB418\uB124.#$e#\uB108\uB97C \uD5A5\uD55C \uB0B4 \uAE30\uBD84\uC740 \uC2DC\uB97C \uD1B5\uD574\uC11C\uB9CC \uD45C\uD604\uD560 \uC218 \uC788\uACA0\uB2E4.$l",
  "Indoor_Night_4": "\uB0B4 \uC0AC\uB791... \uC774\uB9AC\uB4D0 \uC8FC\uAD34 100\uAC1C\uB97C \uC900\uB2E4 \uD574\uB3C4 \uB2F9\uC2E0\uC744 \uBC84\uB9AC\uC9C0 \uC54A\uC744 \uAC70\uC608\uC694.#$e#1000\uAC1C\uB77C\uB3C4...#$e#\uC544\uB2C8, 10,000\uAC1C\uB77C\uB3C4, \uADF8\uB7EC\uC9C0 \uC54A\uC744 \uAC70\uC694.$7#$e#...$7#$e#\uC544\uB2C8, 100,000\uAC1C\uB77C\uB3C4!$a#$e#...$s#$e#\uC5B4... \uC21C \uC774\uB9AC\uB4D0 \uC8FC\uAD34 \uBC31\uB9CC \uAC1C...? \uC5EC\uAE30\uAE4C\uC9C0 \uD558\uC790...$8",
  "Outdoor_0": "\uAFC8\uB9CC \uAC19\uC740 \uC77C\uC774 \uD604\uC2E4\uC774 \uB418\uC5C8\uC5B4... \uC774 \uBBFF\uAE30\uC9C0 \uC54A\uB294 \uD48D\uACBD\uC744 \uBD10!",
  "Outdoor_1": "\uBC1C\uBC11\uC5D0\uB294 \uBE44\uC625\uD55C \uB545, \uD3D0\uC5D0\uB294 \uC2E0\uC120\uD55C \uBC14\uB78C, \uD53C\uBD80\uC5D0\uB294 \uD0DC\uC591\uC758 \uB530\uC2A4\uD568... \uC778\uC0DD\uC740 \uCC38 \uD589\uBCF5\uD574.",
  "Outdoor_2": "\uC5EC\uAE30\uC11C \uC2DC \uC880 \uC4F8\uAE4C \uBD10. \uAC11\uC790\uAE30 \uCC3D\uC758\uB825\uC774 \uC19F\uAD6C\uCE58\uB294\uAC78! \uC790\uAE30\uB294 \uD574\uC57C \uD560 \uC77C \uBA3C\uC800 \uD574.",
  "Outdoor_3": "\uC815\uB9D0 \uAC00\uB9CC\uD788 \uC788\uB294\uB2E4\uBA74, \uB208\uBD80\uC2DC\uAC8C \uBA4B\uC9C4 \uB098\uBE44\uAC00 \uB0B4 \uCF54\uC5D0 \uC549\uB294 \uCD95\uBCF5\uC744 \uBCA0\uD480\uC9C0\uB3C4 \uBAB0\uB77C.",
  "Outdoor_4": "\uCEE4\uD53C \uB108\uBB34 \uB9CE\uC774 \uB9C8\uC168\uC5B4... \uC785\uC548\uC5D0 \uCE7C\uB9AC\uCF54 \uC0AC\uB9C9\uC774 \uC0DD\uACBC\uB294\uAC78.$s#$e#\uC624... \uCEE4\uD53C \uB54C\uBB38\uC5D0 \uC785 \uB0C4\uC0C8\uB098\uC9C0? \uBBF8\uC548\uD574.$7",
  "OneKid_0": "\uC624\uB298 %kid1(\uC774)\uB791\uC740 \uB180\uC558\uC5B4? \uC544\uC774\uB97C \uD558\uB098 \uB354 \uAC00\uC9C0\uBA74 \uC77C\uC774 \uB354 \uC26C\uC6CC\uC9C8 \uC218\uB3C4 \uC788\uC5B4.",
  "OneKid_1": "\uC6B0\uB9AC \uC791\uC740 %kid1(\uC774)\uB294 \uC5EC\uAE30\uC11C \uCD5C\uACE0\uC758 \uC5B4\uB9B0 \uC2DC\uC808\uC744 \uBCF4\uB0BC \uAC70\uC57C. \uD0D0\uD5D8\uD560 \uAC83\uC774 \uB108\uBB34 \uB9CE\uC544.",
  "OneKid_3": "\uC544\uC774\uB97C \uB3CC\uBCF4\uB294 \uAC74 \uB0B4 \uC7A5\uC810\uC740 \uC544\uB2C8\uC9C0\uB9CC... \uC88B\uC740 \uC544\uBC84\uC9C0\uAC00 \uB418\uAE30 \uC704\uD574\uC11C \uCD5C\uC120\uC744 \uB2E4\uD558\uACA0\uC5B4.",
  "TwoKids_0": "%kid1(\uC774)\uB791 %kid2(\uC774) \uBC25\uC740 \uC774\uBBF8 \uCC59\uACA8\uC92C\uC5B4. \uB108\uBB34 \uC791\uC740 \uC0DD\uBA85\uCCB4\uC778\uB370 \uC815\uB9D0 \uB9CE\uC774 \uBA39\uB124!",
  "TwoKids_1": "%kid1(\uC774)\uB97C \uC544\uAE4C \uC548\uACE0 \uC788\uC5C8\uB294\uB370, \u0022\uBE60...\uBE60\u0022\uB77C\uACE0 \uD558\uB294 \uAC78 \uBD84\uBA85 \uB4E4\uC740 \uAC83 \uAC19\uC544.$h",
  "TwoKids_2": "%kid1(\uC774)\uD55C\uD14C \uCD5C\uB300\uD55C \uC77C\uCC0D \uAE00 \uC77D\uB294 \uBC95\uC744 \uAC00\uB974\uCCD0\uC904 \uAC70\uC57C! \uC544\uC774\uB4E4\uC774 \uC138\uC0C1\uC5D0 \uB300\uD574 \uBC30\uC6B0\uAE30 \uC544\uC8FC \uC88B\uC740 \uBC29\uBC95\uC774\uC9C0.",
  "TwoKids_3": "\uC6B0\uB9AC \uC798 \uD574\uB0C8\uC9C0, @\uC544(\uC57C). \uB18D\uC7A5\uC774 \uC798 \uB418\uC5B4\uAC00\uACE0 \uC788\uACE0, \uC6B0\uB9AC \uAC74\uAC15\uD55C \uC544\uC774\uB4E4\uC740 \uC6B0\uB9AC \uC0B6\uC758 \uD589\uBCF5\uC774\uACE0. \uC774\uBCF4\uB2E4 \uD589\uBCF5\uD560 \uC218 \uC5C6\uC744 \uAC83 \uAC19\uC544.",
  "Good_0": "@... \uB124\uAC00 \uC5F4\uC2EC\uD788 \uC77C\uD55C \uAC8C \uB108\uBB34 \uC790\uB791\uC2A4\uB7EC\uC6CC. \uB124\uAC00 \uC788\uC5B4\uC11C \uB09C \uCC38 \uD589\uC6B4\uC774\uC57C.$l",
  "Good_1": "\uB110 \uD5A5\uD55C \uB0B4 \uC0AC\uB791\uC744 \uB2F4\uC740 \uC2DC\uB97C \uBAA8\uC740 \uBE44\uBC00 \uCC45\uC744 \uD558\uB098 \uAC04\uC9C1\uD558\uACE0 \uC788\uC5B4.$l",
  "Good_2": "\uB09C \uB0B4 \uC7AC\uB2A5\uC774 \uB300\uAD8C\uC744 \uC7A5\uC545\uD560 \uC218 \uC788\uB294 \uC0C1\uC544\uD0D1\uC744 \uCC3E\uC73C\uB7EC \uACC4\uACE1\uC73C\uB85C \uC654\uC5B4. \uD558\uC9C0\uB9CC \uB0B4\uAC00 \uCC3E\uC740 \uAC83\uC740 \uC678\uB85C\uC6C0\uC758 \uAC10\uC625\uC774\uC5C8\uC9C0. \uB124\uAC00 \uB0A0 \uAD6C\uD574\uC92C\uC5B4.$l",
  "Good_3": "\uC640\uC6B0, \uC624\uB298 \uC815\uB9D0 \uC798\uC0DD\uACBC\uB294\uAC78! \uBA74\uB3C4\uD588\uC5B4? \uD131 \uC120\uC774 \uC644\uBCBD\uD574.$l^\uB124 \uC5EC\uC131\uC2A4\uB7EC\uC6B4 \uB9E4\uB825\uC774 \uC624\uB298 \uAC70\uBD80\uD560 \uC218 \uC5C6\uB294 \uC218\uC900\uC778\uAC78. \uB208\uC744 \uB5BC\uC9C8 \uBABB\uD558\uACA0\uC5B4.$l",
  "Good_4": "\uB124\uAC00 \uC5C6\uC73C\uBA74 \uB2E4 \uD0C0\uBC84\uB9B0 \uB290\uB08C\uC774\uC57C. \uADF8\uB7EC\uB2E4 \uB098\uBB34\uB97C \uCE58\uB294 \uC9C4\uD759 \uBB3B\uC740 \uC7A5\uD654 \uC18C\uB9AC\uB97C \uB4E4\uC73C\uBA74, \uC7BF\uB354\uBBF8\uC5D0\uC11C \uB0B4 \uC2EC\uC7A5\uC774 \uC19F\uC544\uC62C\uB77C.",
  "Good_5": "\uC624\uB298 \uAC78\uC73C\uBA70 \uBA85\uC0C1\uD558\uB824\uACE0. \uCC3D\uC758\uB825\uC5D0 \uC88B\uC740 \uAC70\uC57C.",
  "Good_6": "\uBC16\uC5D0\uC11C \uC870\uC2EC\uD558\uACE0! \uAC00\uB054 \uB124 \uAC71\uC815\uC744 \uB9CE\uC774 \uD574. \uC138\uC0C1\uC5D0\uB294 \uB108\uB97C \uC774\uC6A9\uD574\uBA39\uC73C\uB824 \uD560 \uC0AC\uB78C\uB4E4\uC774 \uC788\uC5B4.",
  "funLeave_Elliott": "\uC624\uB298 \uB2E4\uC2DC \uD574\uBCC0\uC5D0 \uAC00\uBCFC\uAE4C \uD574. \uBC14\uB2E4\uB97C \uB2E4\uC2DC \uBCF4\uB294 \uAC74 \uC5B8\uC81C\uB4E0 \uD658\uC601\uC774\uC57C.",
  "funReturn_Elliott": "\uD574\uBCC0\uC5D0\uC11C \uC624\uB79C\uB9CC\uC5D0 \uD63C\uC790\uB9CC\uC758 \uC2DC\uAC04\uC744 \uBCF4\uB0C8\uC5B4. \uC608\uC804\uCC98\uB7FC \uD30C\uB3C4\uAC00 \uC624\uAC00\uB294 \uAC83\uC744 \uAD6C\uACBD\uD588\uC9C0.",
  "spring_1": "\uC62C\uD574 \uBAA9\uD45C\uB294 \uAE00 \uC4F0\uACE0, \uAE00 \uC4F0\uACE0, \uAE00 \uC4F0\uB294 \uAC70\uC57C! \uAE30\uC220\uC744 \uAC1C\uC120\uD558\uB294 \uAC78 \uBA48\uCD94\uBA74 \uC548 \uB3FC.",
  "spring_12": "\uC774\uC0C1\uD558\uC9C0\uB9CC, \uBD04\uCCA0\uC5D0 \uC11D\uB958\uAC00 \uC790\uC8FC \uBA39\uACE0 \uC2F6\uC5B4\uC838.",
  "spring_23": "\uC5EC\uBCF4, \uB0B4\uC77C \uD568\uAED8 \uCDA4\uCD9C \uAC78 \uAE30\uB300\uD558\uACE0 \uC788\uC5B4\uC694.",
  "summer_1": "\uD0DC\uC591\uC774 \uBBF8\uC18C \uC9D3\uACE0 \uB098\uBE44\uAC00 \uD5A5\uAE30 \uAC00\uB4DD\uD55C \uC0B0\uB4E4\uBC14\uB78C\uC744 \uD0C0\uACE0 \uCDA4\uCD9C \uB54C \uAE30\uBD84\uC774 \uB098\uC058\uAE30\uB3C4 \uC5B4\uB835\uC9C0.$h",
  "summer_10": "\uC624\uB298 \uC624\uB450\uB9C9\uC5D0 \uB4E4\uB7EC\uC11C \uC789\uD06C \uD55C \uBCD1 \uB354 \uAC00\uC838\uC62C\uAE4C \uD588\uB294\uB370, \uB0B4\uC77C\uC774 \uB8E8\uC544\uC6B0\uB780 \uAC78 \uAE30\uC5B5\uD588\uC5B4. \uADF8\uB0E5 \uADF8\uB54C \uAC00\uC838\uC640\uC57C\uC9C0.",
  "summer_27": "\uC88B\uC740 \uAC83\uB4E4\uB3C4 \uB05D\uC774 \uC788\uB294 \uAC70\uC9C0, \uC5EC\uB984\uC758 \uAE30\uC05C \uB0A0\uB3C4. \uD589\uBCF5\uC758 \uC5F4\uC1E0\uB294 \uBE44\uD310 \uC5C6\uC774 \uBCC0\uD654\uB97C \uBC1B\uC544\uB4E4\uC774\uB294 \uAC70\uC9C0.",
  "fall_1": "\uAC00\uC744\uC758 \uC7A5\uB824\uD568... \uBAA8\uB4E0 \uAC10\uAC01\uC73C\uB85C \uC990\uAE38 \uC218 \uC788\uB294 \uC2E0\uB85D\uC758 \uC131\uCC2C... \uC774 \uACC4\uC808\uC774 \uC5ED\uB300\uC801\uC73C\uB85C \uC704\uB300\uD55C \uC2DC\uC758 \uC601\uAC10\uC774 \uB418\uC5C8\uC9C0.",
  "fall_15": "\uB0B4\uC77C \uC790\uC874\uC2EC\uC740 \uBC84\uB9AC\uACE0 \uB0B4\uC77C \uC9C8\uD380\uD558\uACE0 \uC18C\uC2A4 \uAC00\uB4DD\uD55C \uBC14\uBCA0\uD050 \uC0CC\uB4DC\uC704\uCE58\uB85C \uBC30\uB97C \uCC44\uC6B8\uAE4C \uC2F6\uC5B4.",
  "fall_26": "\uC601\uB839\uC758 \uC804\uC57C\uC81C \uB54C \uB0B4\uAC00 \uD638\uBC15 \uC5D0\uC77C \uB450 \uAC24\uB7F0\uC744 \uBC8C\uCEE5\uBC8C\uCEE5 \uB9C8\uC154\uB3C4 \uB0A0 \uC0AC\uB791\uD574\uC904 \uAC70\uC57C? \uAC00\uB054 \uC6D0\uC2DC\uC801\uC778 \uCDA9\uB3D9\uC774 \uB4E4 \uB54C\uAC00 \uC788\uC5B4\uC11C...",
  "winter_1": "\uACA8\uC6B8\uC740 \uCC45 \uC77D\uACE0 \uD53C\uC544\uB178\uB97C \uCE58\uAE30 \uC88B\uC740 \uACC4\uC808\uC774\uC9C0. \uAC00\uB054 \uC26C\uACE0 \uC870\uC6A9\uD55C \uC21C\uAC04\uC744 \uC990\uAE30\uB294 \uAC78 \uAE30\uC5B5\uD574\uC57C \uD574.",
  "winter_7": "\uC5F0\uC2B5\uD55C\uC9C0 \uC880 \uB418\uC5C8\uC9C0\uB9CC, \uB0B4\uC77C \uB09A\uC2DC\uB300\uD68C\uC5D0 \uCC38\uAC00\uD574\uBCF4\uB824\uACE0! \uC5EC\uBCF4 \uACBD\uC7C1\uC0C1\uB300\uAC00 \uB9CC\uB9CC\uCE58 \uC54A\uC740\uAC78?",
  "winter_28": "\uC62C\uD574\uB3C4 \uBA4B\uC9C4 \uD55C \uD574\uC600\uC5B4, \uC5EC\uBCF4. \uCD95\uD558\uD560 \uACB8 \uC774\uAC78 \uC904\uAC8C. [348]"
}