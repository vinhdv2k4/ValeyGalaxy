  "FullCrabPond": "*\u043D\u044E\u0445*... \u0410\u0445... \u0421\u0442\u0430\u0440\u044B\u0439 \u0434\u043E\u0431\u0440\u044B\u0439 \u0437\u0430\u043F\u0430\u0445. \u0422\u044B \u043A\u0440\u0430\u0431\u043E\u0432 \u0447\u0442\u043E \u043B\u044C \u0440\u0430\u0441\u0442\u0438\u0448\u044C, \u0430?#$b#\u041E\u0442 \u0442\u044B \u043C\u043D\u044F \u0432 \u0441\u0430\u043C\u043E\u0435 \u0441\u0435\u0440\u0434\u0446\u0435 ${\u043F\u043E\u0440\u0430\u0437\u0438\u043B^\u043F\u043E\u0440\u0430\u0437\u0438\u043B\u0430}$, @. \u0425\u0430!$h#$b#\u041D\u0430, \u0432\u043E\u0437\u044C\u043C\u0438. \u041D\u0430 \u043F\u043B\u044F\u0436\u0443 \u043D\u0430\u0448\u0435\u043B... \u0425\u0440\u0430\u043D\u0438\u043B \u0434\u043E \u043E\u0441\u043E\u0431\u043E\u0433\u043E \u0441\u043B\u0443\u0447\u0430\u044F, \u0442\u0430\u043A \u0441\u043A\u0430\u0437\u0430\u0442\u044C. \u041D\u0435 \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0448\u044C \u0442\u0430\u043A\u043E\u0433\u043E \u0436\u0435 \u043B\u044E\u0431\u0438\u0442\u0435\u043B\u044F \u043A\u0440\u0430\u0431\u043E\u0432, \u043A\u0430\u043A \u044F! [797]",
  "MovieInvitation": "\u041E... \u041A\u0438\u043D\u043E. \u041A\u0430\u043A \u043C\u0438\u043B\u043E \u0441 \u0442\u0432\u043E\u0435\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B, \u043F\u0430\u0446\u0430\u043D.^\u041E... \u041A\u0438\u043D\u043E. \u041A\u0430\u043A \u043C\u0438\u043B\u043E \u0441 \u0442\u0432\u043E\u0435\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B, \u0434\u0435\u0432\u0447\u0443\u043B\u044C.#$b#\u0422\u043E\u0433\u0434\u0430 \u0434\u043E\u043A\u0443\u0440\u044E \u0438 \u043F\u043E\u0439\u0434\u0443.",
  "summer_19": "\u0417\u0430\u0432\u0442\u0440\u0430 \u0435\u0436\u0435\u0433\u043E\u0434\u043D\u044B\u0439 \u0424\u043E\u0440\u0435\u043B\u0435\u0432\u044B\u0439 \u0442\u0443\u0440\u043D\u0438\u0440... \u041E \u0434\u0430, \u043C\u0435\u0447\u0442\u0430 \u043B\u044E\u0431\u0438\u0442\u0435\u043B\u044F \u0440\u0435\u0447\u043D\u043E\u0439 \u0440\u044B\u0431\u0430\u043B\u043A\u0438!#$e#\u0420\u044B\u0431\u0430\u043A\u0438 \u0441\u043E \u0432\u0441\u0435\u0433\u043E \u0441\u0432\u0435\u0442\u0430 \u043F\u0440\u0438\u0435\u0434\u0443\u0442, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u043E\u0432\u0438\u0442\u044C \u043D\u0430\u0448\u0443 \u0420\u0430\u0434\u0443\u0436\u043D\u0443\u044E \u0444\u043E\u0440\u0435\u043B\u044C...#$e#\u0422\u044B \u0434\u0430\u0432\u0430\u0439 \u0442\u043E\u0436\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u0438!$h^\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0443\u0432\u0438\u0434\u0438\u043C\u0441\u044F \u0442\u0430\u043C!$h#$e#\u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435 \u0434\u0432\u0430 \u0434\u043D\u044F \u044F \u0431\u0443\u0434\u0443 \u0437\u0430\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0442\u044C \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D \u043B\u0438\u0448\u044C \u043D\u0430 \u0447\u0430\u0441\u043E\u043A, \u0432 9 \u0443\u0442\u0440\u0430. \u0422\u0430\u043A \u0447\u0442\u043E \u043B\u043E\u0432\u0438 \u043C\u0435\u043D\u044F \u0432 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F, \u0435\u0441\u043B\u0438 \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u043B\u044E\u0441\u044C.",
  "summer_20": "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0434\u0435\u043D\u044C! \u0423 \u043C\u0435\u043D\u044F \u0432\u0441\u0435 \u0441\u043D\u0430\u0441\u0442\u0438 \u043F\u043E\u0434 \u0444\u043E\u0440\u0435\u043B\u044C \u0437\u0430\u0442\u043E\u0447\u0435\u043D\u044B...#$e#\u0423\u0434\u0430\u0447\u0438 \u0442\u0435\u0431\u0435!",
  "summer_21": "\u041D\u0443 \u043A\u0430\u043A \u0442\u0435\u0431\u0435 \u0422\u0443\u0440\u043D\u0438\u0440?#$b#\u0423 \u043C\u0435\u043D\u044F \u0443\u0436\u0435 \u043A\u0443\u0447\u0430 \u0417\u043E\u043B\u043E\u0442\u044B\u0445 \u044F\u0440\u043B\u044B\u043A\u043E\u0432... \u043D\u043E \u0435\u0449\u0435 \u043D\u0435 \u0432\u0435\u0447\u0435\u0440!",
  "winter_11": "\u0417\u0430\u0432\u0442\u0440\u0430 \u043D\u0430 \u043F\u043B\u044F\u0436\u0435 \u0441\u0442\u0430\u0440\u0442\u0443\u0435\u0442 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0441\u0445\u043E\u0434... \u00AB\u041A\u0430\u043B\u044C\u043C\u0430\u0440\u043E\u0444\u0435\u0441\u0442\u00BB \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F.#$e#\u0414\u0430... \u043A\u0430\u043B\u044C\u043C\u0430\u0440\u0430-\u0442\u043E \u0441\u043B\u043E\u0436\u043D\u043E \u043F\u043E\u0439\u043C\u0430\u0442\u044C. \u041D\u043E, \u0441\u0434\u0430\u0435\u0442\u0441\u044F \u043C\u043D\u0435, \u0442\u0435\u0431\u044F \u0443\u0436\u0435 \u0445\u043E\u0440\u043E\u0448\u0435\u043D\u044C\u043A\u043E \u0437\u0430\u0432\u043B\u0435\u043A \u044D\u0442\u043E\u0442 \u0441\u043F\u043E\u0440\u0442.",
  "winter_12": "\u041D\u0435 \u0432\u0435\u0448\u0430\u0439 \u043D\u043E\u0441! \u0412 \u0432\u043E\u0434\u0435 \u0435\u0449\u0435 \u043A\u0443\u0447\u0430 \u043A\u0430\u043B\u044C\u043C\u0430\u0440\u043E\u0432...",
  "winter_13": "\u041C\u043E\u0435\u043C\u0443 \u0440\u044B\u0431\u0430\u0446\u043A\u043E\u043C\u0443 \u0441\u0435\u0440\u0434\u0446\u0443 \u0442\u0435\u043F\u043B\u043E \u0432 \u044D\u0442\u0443 \u043C\u043E\u0440\u043E\u0437\u043D\u0443\u044E \u043F\u043E\u0433\u043E\u0434\u0443, \u043A\u043E\u0433\u0434\u0430 \u044F \u0432\u0438\u0436\u0443, \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043B\u044E\u0431\u0438\u0442\u0435\u043B\u0435\u0439 \u0440\u044B\u0431\u0430\u043B\u043A\u0438 \u0441\u043E\u0431\u0440\u0430\u043B\u043E\u0441\u044C \u043D\u0430 \u0444\u0435\u0441\u0442\u0438\u0432\u0430\u043B\u044C...$h",
  "Mon": "\u0417\u0434\u043E\u0440\u043E\u0432\u043E, \u0441\u044B\u043D\u043E\u043A.^\u0417\u0434\u043E\u0440\u043E\u0432\u043E, \u0434\u043E\u0447\u0430.#$b#\u041D\u0435\u043F\u043B\u043E\u0445\u0430\u044F \u0442\u0430\u043A\u0430\u044F \u043F\u043E\u0433\u043E\u0434\u043A\u0430 \u0434\u043B\u044F \u0440\u044B\u0431\u0430\u043B\u043A\u0438, \u0434\u0430?",
  "Mon4": "\u041D\u0443 \u043A\u0430\u043A \u0442\u0435\u0431\u0435 \u0440\u044B\u0431\u0430\u043B\u043A\u0430 \u0432 \u043D\u0430\u0448\u0438\u0445 \u0432\u043E\u0434\u0430\u0445? \u0414\u0443\u043C\u0430\u044E, \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u0434\u043D\u0430\u0442\u043E\u0440\u0435\u0442\u044C \u0435\u0449\u0435 \u0431\u043E\u043B\u044C\u0448\u0435, \u0435\u0441\u043B\u0438 \u0437\u0430\u0445\u043E\u0447\u0435\u0448\u044C.",
  "Tue": "\u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u0440\u044B\u0431\u0430\u043A \u0432\u043E\u0434\u0443 \u0443\u0432\u0430\u0436\u0430\u0435\u0442... \u0422\u044B \u044D\u0442\u043E\u0433\u043E \u043D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439.",
  "Tue6": "\u0421\u0442\u0430\u0440\u0438\u043A-\u0442\u043E \u043C\u043E\u0439 \u0440\u044B\u0431\u0430\u043A\u043E\u043C \u0431\u044B\u043B, \u0437\u043D\u0430\u0435\u0448\u044C. \u042F \u0432\u044B\u0440\u043E\u0441, \u043F\u043B\u0430\u0432\u0430\u044F \u043C\u0435\u0436\u0434\u0443 \u041F\u0430\u043F\u043E\u0440\u043E\u0442\u043D\u0438\u043A\u043E\u0432\u044B\u043C\u0438 \u043E\u0441\u0442\u0440\u043E\u0432\u0430\u043C\u0438 \u2014 \u0436\u0438\u043B\u0438 \u043E\u0442 \u0443\u043B\u043E\u0432\u0430 \u0434\u043E \u0443\u043B\u043E\u0432\u0430.#$e#\u0420\u044B\u0431\u0430\u0446\u043A\u0430\u044F \u0436\u0438\u0437\u043D\u044C \u2014 \u043D\u0435 \u0441\u0430\u0445\u0430\u0440, \u043D\u043E \u0447\u0442\u043E-\u0442\u043E \u0432 \u043D\u0435\u0439 \u0435\u0441\u0442\u044C \u0442\u0430\u043A\u043E\u0435, \u043E\u0442\u0447\u0435\u0433\u043E \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0436\u0438\u0442\u044C \u0435\u044E \u0434\u0430\u043B\u044C\u0448\u0435.",
  "Wed": "\u0418\u043D\u0430\u044F \u0440\u044B\u0431\u043A\u0430 \u0441 \u0432\u0440\u0435\u043C\u0435\u043D\u0430\u043C\u0438 \u0433\u043E\u0434\u0430 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442 \u0438 \u0443\u0445\u043E\u0434\u0438\u0442. \u0410 \u0434\u0440\u0443\u0433\u0430\u044F \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u043E\u0447\u044C\u044E \u0432\u044B\u0445\u043E\u0434\u0438\u0442, \u0438\u043B\u0438 \u0432 \u0434\u043E\u0436\u0434\u044C.",
  "Wed6": "\u0421\u043B\u044B\u0448\u0430\u043B, \u0447\u0442\u043E \u0432 \u043F\u0440\u0443\u0434\u0430\u0445 \u043C\u0435\u0436\u0434\u0443 \u0432\u043E\u0434\u043E\u043F\u0430\u0434\u0430\u043C\u0438 \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0439\u043C\u0430\u0442\u044C \u043E\u0441\u043E\u0431\u0443\u044E \u0440\u044B\u0431\u0443...#$b#\u0415\u0441\u043B\u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F \u0442\u0443\u0434\u0430 \u0443\u0434\u043E\u0447\u043A\u0443 \u0437\u0430\u0431\u0440\u043E\u0441\u0438\u0442\u044C, \u043A\u043E\u043D\u0435\u0447\u043D\u043E...",
  "Thu": "*\u0411\u043E\u0440\u043C\u043E\u0447\u0435\u0442* ... \u0410\u0441\u044C? \u042F \u0431 \u0442\u0435\u0431\u0435 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B, \u043E \u0447\u0435\u043C \u0434\u0443\u043C\u0430\u044E, \u0434\u0430 \u0442\u043E\u043B\u044C\u043A\u043E \u044D\u0442\u043E \u0440\u044B\u0431\u0430\u0446\u043A\u0438\u0439 \u0441\u0435\u043A\u0440\u0435\u0442.",
  "Thu2": "\u0425\u043E\u0434\u044F\u0442 \u0441\u043B\u0443\u0445\u0438, \u0431\u0443\u0434\u0442\u043E \u0432\u043E\u0434\u0438\u0442\u0441\u044F \u0443 \u043D\u0430\u0441 \u0440\u044B\u0431\u0430 \u043E\u0447\u0435\u043D\u044C \u0440\u0435\u0434\u043A\u0430\u044F... \u0414\u0430 \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0430\u043C\u043E\u043C\u0443 \u043E\u043F\u044B\u0442\u043D\u043E\u043C\u0443 \u0440\u044B\u0431\u043E\u043B\u043E\u0432\u0443 \u043E\u043D\u0430 \u043F\u043E\u0434 \u0441\u0438\u043B\u0443.#$e#\u0418 \u043D\u0430\u0436\u0438\u0432\u043A\u0430 \u043D\u0443\u0436\u043D\u0430 \u0441\u0430\u043C\u0430\u044F \u043B\u0443\u0447\u0448\u0430\u044F, \u0447\u0442\u043E\u0431\u044B \u0440\u0435\u0434\u043A\u0430\u044F \u0440\u044B\u0431\u043A\u0430 \u043A\u043B\u044E\u043D\u0443\u043B\u0430.",
  "Fri": "\u0415\u0441\u043B\u0438 \u0445\u043E\u0447\u0435\u0448\u044C, \u0447\u0442\u043E\u0431\u044B \u043A\u043B\u0435\u0432 \u043F\u043E\u0448\u0435\u043B, \u043D\u0443\u0436\u043D\u0430 \u043D\u0430 \u043A\u0440\u044E\u0447\u043A\u0435 \u043D\u0430\u0436\u0438\u0432\u043A\u0430.",
  "Fri4": "\u042F \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043F\u0440\u043E\u0441\u0442\u043E\u0439... \u044F \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432, \u043A\u043E\u0433\u0434\u0430 \u043C\u043E\u044F \u0442\u0440\u0443\u0431\u043A\u0430 \u043F\u043E\u043B\u043D\u0430. \u041A\u043E\u0433\u0434\u0430 \u043C\u043E\u044F \u0442\u0440\u0443\u0431\u043A\u0430 \u043F\u0443\u0441\u0442\u0430... \u042F \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u0431\u0438\u0432\u0430\u044E \u0435\u0435 \u0435\u0449\u0435 \u0440\u0430\u0437.$u",
  "Sat": "\u0415\u0441\u043B\u0438 \u0432 \u0433\u043E\u0440\u043E\u0434\u0435 \u0441\u0442\u0430\u043D\u0443\u0442 \u0431\u043E\u043B\u044C\u0448\u0435 \u0440\u044B\u0431\u0430\u0447\u0438\u0442\u044C, \u0442\u043E \u044F, \u0433\u043B\u044F\u0434\u0438\u0448\u044C, \u0438 \u043D\u043E\u0432\u044B\u0435 \u0442\u043E\u0432\u0430\u0440\u044B \u0437\u0430\u0432\u0435\u0437\u0443.",
  "Sat8": "\u041A\u0430\u043A \u0442\u0430\u043C \u0436\u0438\u0437\u043D\u044C \u0442\u0432\u043E\u044F \u0440\u044B\u0431\u0430\u0446\u043A\u0430\u044F?#$e#\u042F \u0432\u043E\u0442 \u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C \u043F\u043E\u0447\u0430\u0449\u0435 \u0440\u044B\u0431\u0430\u0447\u0438\u0442\u044C, \u043D\u043E \u043D\u0435\u043F\u0440\u043E\u0441\u0442\u043E \u044D\u0442\u043E, \u043A\u043E\u0433\u0434\u0430 \u0443 \u0442\u0435\u0431\u044F \u0435\u0449\u0435 \u0438 \u043C\u0430\u0433\u0430\u0437\u0438\u043D \u043D\u0430 \u043F\u043B\u0435\u0447\u0430\u0445.",
  "Sun": "\u0415\u0441\u043B\u0438 \u043A\u0443\u043F\u0438\u0448\u044C \u0443\u0434\u043E\u0447\u043A\u0443 \u043F\u043E\u043B\u0443\u0447\u0448\u0435, \u043C\u043E\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0441 \u043D\u0435\u0439 \u043D\u0430\u0436\u0438\u0432\u043A\u0443 \u0434\u0430 \u0441\u043D\u0430\u0441\u0442\u0438.#$b#\u0421 \u043D\u0430\u0436\u0438\u0432\u043A\u043E\u0439 \u043A\u043B\u0435\u0432 \u0431\u0443\u0434\u0435\u0442 \u0431\u043E\u0439\u0447\u0435. \u0410 \u0441\u043E \u0441\u043D\u0430\u0441\u0442\u044F\u043C\u0438 \u0440\u044B\u0431\u043A\u0443 \u043F\u0440\u043E\u0449\u0435 \u0438\u0437 \u0432\u043E\u0434\u044B \u0432\u044B\u0442\u0430\u0449\u0438\u0442\u044C.#$e#\u0421\u043D\u0430\u0441\u0442\u0438 \u0440\u0430\u0437\u043D\u044B\u0435 \u0431\u044B\u0432\u0430\u044E\u0442, \u0434\u043B\u044F \u0440\u0430\u0437\u043D\u044B\u0445 \u0446\u0435\u043B\u0435\u0439. \u041E\u043D\u0438 \u043E\u0431\u044B\u0447\u043D\u043E \u0445\u043B\u0438\u043F\u043A\u0438\u0435, \u0442\u0430\u043A \u0447\u0442\u043E \u043D\u0435 \u0443\u0434\u0438\u0432\u043B\u044F\u0439\u0441\u044F, \u0435\u0441\u043B\u0438 \u0432\u0434\u0440\u0443\u0433 \u0440\u0430\u0437\u0432\u0430\u043B\u044F\u0442\u0441\u044F.",
  "Sun10": "\u0411\u0430, \u0430 \u0432\u043E\u0442 \u0438 \u043C\u043E\u0439 \u0448\u043A\u0438\u043F\u0435\u0440, @!$h#$e#\u042F \u0431 \u0434\u0430\u043B \u0442\u0435\u0431\u0435 \u0441\u043A\u0438\u0434\u043A\u0443 \u043D\u0430 \u043D\u0430\u0436\u0438\u0432\u043A\u0443, \u0435\u0441\u043B\u0438 \u0431\u044B \u043C\u043E\u0433 \u0441\u0435\u0431\u0435 \u0442\u0430\u043A\u043E\u0435 \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u044C.$s",
  "Fair_Judging": "\u042F \u043D\u0435 \u043E\u0441\u043E\u0431\u043E-\u0442\u043E \u0438 \u043D\u0430\u0434\u0435\u044E\u0441\u044C \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u044C... \u0420\u044B\u0431\u0430 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u0437\u0434\u043E\u0440\u043E\u0432\u043E, \u0434\u0430 \u043F\u0430\u0445\u043D\u0435\u0442 \u043D\u0435 \u043E\u0447\u0435\u043D\u044C...$s",
  "Fair_Judged": "\u041E\u0433\u043E, \u043A\u0430\u043A \u043C\u043D\u0435 \u043C\u0430\u043B\u043E \u043E\u0447\u043A\u043E\u0432-\u0442\u043E \u0434\u0430\u043B\u0438. \u0412\u0438\u0434\u0430\u0442\u044C, \u043D\u0435 \u0443\u0432\u0430\u0436\u0430\u0435\u0442 \u043C\u044D\u0440 \u043D\u0430\u0448 \u041B\u044C\u044E\u0438\u0441 \u0440\u044B\u0431\u0430\u043B\u043A\u0443-\u0442\u043E. \u041D\u0443 \u043B\u0430\u0434\u043D\u043E, \u0447\u0435\u0433\u043E \u0443\u0436...$s"
}