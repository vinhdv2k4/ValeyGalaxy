  "Sat_8": "\uAD11\uC0B0\uC740 \uC704\uD5D8\uD55C \uACF3\uC77C \uC218 \uC788\uC9C0. \uC870\uC2EC\uD574, \uCE5C\uAD6C.",
  "Sat": "\uAD11\uC0B0 \uC548\uC740 \uC704\uD5D8\uD574. \uC548\uC804\uC744 \uBCF4\uC7A5\uD558\uAE30 \uC704\uD574 \uB0B4 \uAC00\uAC8C\uC5D0\uC11C \uBA87 \uAC00\uC9C0 \uC0AC \uAC00\uB294 \uAC74 \uC5B4\uB54C?",
  "Sun": "\uC57C, \uD558\uB8E8 \uB0A0 \uC7A1\uACE0 \uB098\uD55C\uD14C \uADF8 \u0022\uC6B0\uC720\u0022\uB780 \uAC83\uC5D0 \uB300\uD574 \uC124\uBA85\uD574\uC918.",
