  "fishCaught_162": "\uC624, \uC6A9\uC554 \uC7A5\uC5B4\uB97C \uC7A1\uC558\uB2E4\uACE0? \uC798\uD588\uC5B4! \uC6A9\uC554 \uC7A5\uC5B4 \uB09A\uC2DC\uB294 \uC6B0\uB9AC \uBB38\uD654\uC758 \uC911\uC694\uD55C \uBD80\uBD84\uC774\uC9C0. \uC9C4\uBBF8\uB85C \uB300\uC6B0\uBC1B\uC544!",
  "firstVisit_Caldera": "\uC804\uC124\uC758 \uB4DC\uC6CC\uD504 \uB300\uC7A5\uAC04\uC744 \uCC3E\uC558\uB2E4\uACE0? \uBBFF\uAE30\uC9C0 \uC54A\uC544... \uB09C \uC9C1\uC811 \uBCF8 \uC801\uC740 \uC5C6\uC5B4.#$e#\uB108\uBB34\uB098 \uACE0\uB300\uC758 \uC7A5\uCE58\uB77C\uC11C \uC6B0\uB9AC \uC911\uC5D0 \uADF8 \uAE30\uACC4\uC758 \uC791\uB3D9\uBC95\uC744 \uC774\uD574\uD558\uB294 \uB4DC\uC6CC\uD504\uB294 \uC5C6\uC5B4. \uD558\uC9C0\uB9CC \uBD84\uBA85 \uB4DC\uC6CC\uD504 \uAE30\uC220\uB825\uC774\uAE34 \uD574.",
  "Wed": "\uC57C, \uBB50 \uC0B4\uB798?",
  "Wed_6": "\uC608\uC804\uC5D0\uB294, \uB0B4 \uC885\uC871\uC740 \uB6F0\uC5B4\uB09C \uAE30\uC220\uB825\uC758 \uBE44\uBC00\uC744 \uC54C\uACE0 \uC788\uC5C8\uC9C0. \uACE0\uACE0\uD559\uC801\uC778 \uC99D\uAC70\uB85C \uC99D\uBA85\uD560 \uC218 \uC788\uC5B4.#$e#\uD558\uC9C0\uB9CC \uADF8\uB7F0 \uC9C0\uC2DD\uC774 \uC5B4\uB514\uC11C \uB0AC\uC744\uAE4C? \uADF8\uB9AC\uACE0 \uC5B4\uB514\uB85C \uAC14\uC744\uAE4C? \uBA87\uBA87 \uC9C8\uBB38\uC740 \uB2F5\uC744 \uBABB \uCC3E\uB294 \uAC70\uACA0\uC9C0...",
  "Thu_4": "\uB09C \uC9C0\uD558\uC5D0 \uC788\uC744 \uB54C\uAC00 \uC81C\uC77C \uD3B8\uD574.#$e#\uC9C0\uD558 \uB354 \uC2F6\uC740 \uACF3\uC77C\uC218\uB85D \uB354 \uC88B\uC544.",
