  "GreenRain": "\uB09C \uC0AC\uC2E4 \uB179\uC0C9\uC774 \uC798 \uC548 \uBCF4\uC5EC.#$b#\uC9C0\uD558\uC5D0\uC11C \uB108\uBB34 \uC624\uB798 \uC0B4\uC544\uC11C \uADF8\uB7F0\uAC00\uBD10.",
