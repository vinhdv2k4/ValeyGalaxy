  "firstVisit_IslandNorth": "\uC9C4\uC800 \uC12C\uC758 \uD654\uC0B0\uC5D0 \uB4E4\uC5B4\uAC00 \uBCF4\uBA74 \uB0B4 \uC885\uC871\uC744 \uB9CC\uB0A0 \uC218\uB3C4 \uC788\uC5B4. \uB180\uB77C\uC9C4 \uB9C8! \uC6B0\uB9B0 \uC778\uAC04\uACFC \uD3C9\uD654\uB86D\uAC8C \uC9C0\uB0B4\uAC70\uB4E0.",
  "mineArea_121": "\uC774\uBD10, \uB10C \uC778\uAC04\uCE58\uACE4 \uCC44\uAD11 \uC19C\uC528\uAC00 \uB6F0\uC5B4\uB098.",
  "fishCaught_158": "\uC624, \uC465\uCE58\uB97C \uC7A1\uC558\uB2E4\uACE0? \uB0B4\uAC00 \uC798 \uC54C\uC9C0. \uC6B0\uB9B0 \uAC00\uB054 \uC465\uCE58\uB97C \uD0A4\uC6B0\uAE30\uB3C4 \uD574.",
