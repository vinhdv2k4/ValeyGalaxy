{
  "Introduction": "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435, \u0440\u0430\u0434\u0430 \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u044C\u0441\u044F.$h#$e#\u0412\u044B \u0432\u044B\u0431\u0440\u0430\u043B\u0438 \u0445\u043E\u0440\u043E\u0448\u0435\u0435 \u043C\u0435\u0441\u0442\u043E \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u0435\u0437\u0434\u0430... \u0412\u0435\u0441\u043D\u0430 \u0437\u0434\u0435\u0441\u044C \u0437\u0430\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F.",
  "AcceptGift_(O)StardropTea": "\u0423\u0445 \u0442\u044B, \u044F \u0442\u0430\u043A\u043E\u0435 \u0432 \u0434\u0435\u0442\u0441\u0442\u0432\u0435 \u043F\u0440\u043E\u0431\u043E\u0432\u0430\u043B\u0430... \u0438 \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u0432\u043A\u0443\u0441 \u043F\u043E\u043C\u043D\u044E.",
  "AcceptBirthdayGift_Positive": "\u042D\u0439, \u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u0441\u043F\u0430\u0441\u0438\u0431\u043E, @! \u0422\u0435\u043F\u0435\u0440\u044C \u043C\u043E\u0439 \u0434\u0435\u043D\u044C \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F \u0441\u0442\u0430\u043B \u0447\u0443\u0442\u043E\u0447\u043A\u0443 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u0435\u0435.$h",
  "FlowerDance_Accept": "\u0425\u043E\u0447\u0435\u0448\u044C \u043F\u043E\u0442\u0430\u043D\u0446\u0435\u0432\u0430\u0442\u044C \u0441\u043E \u043C\u043D\u043E\u0439? \u0414\u0430!$h#$e#\u042F \u0432\u0441\u0435 \u0434\u0443\u043C\u0430\u043B\u0430, \u043F\u0440\u0438\u0433\u043B\u0430\u0441\u0438\u0448\u044C \u043B\u0438 \u0442\u044B \u043C\u0435\u043D\u044F...$h",
  "dating_Leah": "\u0423 \u043C\u0435\u043D\u044F \u0431\u044B\u043B\u043E \u043F\u0440\u0435\u0434\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0435, \u0447\u0442\u043E \u0442\u044B \u044D\u0442\u043E \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0448\u044C...$l",
  "married_Elliott": "\u042D\u043B\u043B\u0438\u043E\u0442 \u0442\u0430\u043A\u043E\u0439 \u0440\u043E\u043C\u0430\u043D\u0442\u0438\u0447\u043D\u044B\u0439... \u0423\u0432\u0435\u0440\u0435\u043D\u0430, \u0442\u0435\u043F\u0435\u0440\u044C \u0432 \u0442\u0432\u043E\u0435\u0439 \u0436\u0438\u0437\u043D\u0438 \u0431\u0443\u0434\u0435\u0442 \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u044D\u0437\u0438\u0438!$h",
  "married_Shane": "\u0420\u0430\u0434\u0430, \u0447\u0442\u043E \u0428\u0435\u0439\u043D \u0432 \u0442\u0430\u043A\u043E\u043C \u0445\u043E\u0440\u043E\u0448\u0435\u043C \u043C\u0435\u0441\u0442\u0435. \u041D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0430, \u0447\u0442\u043E\u0431\u044B \u043E\u043D \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0443\u043B\u044B\u0431\u0430\u043B\u0441\u044F!#$e#\u041E\u043D \u0442\u0430\u043A \u043B\u044E\u0431\u0438\u0442 \u043A\u0443\u0440\u043E\u0447\u0435\u043A, \u043D\u0430 \u0444\u0435\u0440\u043C\u0435 \u00AB%farm\u00BB \u0435\u043C\u0443 \u0441\u0430\u043C\u043E\u0435 \u043C\u0435\u0441\u0442\u043E!$h",
  "AcceptGift_(O)169": "\u041E! \u0421\u043F\u0430\u0441\u0438\u0431\u043E! \u0422\u0430\u043A\u0430\u044F \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u0430\u044F \u0444\u043E\u0440\u043C\u0430...$h",
  "AcceptGift_(O)430": "\u041E\u0439, \u043E\u0442\u043A\u0443\u0434\u0430 \u044D\u0442\u043E \u0443 \u0442\u0435\u0431\u044F? *\u043D\u044E\u0445\u0430\u0435\u0442*... \u041C-\u043C-\u043C... \u0411\u0443\u0434\u0435\u0442 \u043E\u0431\u044A\u0435\u0434\u0435\u043D\u044C\u0435, \u0435\u0441\u043B\u0438 \u043D\u0430 \u043F\u0430\u0441\u0442\u0443 \u043F\u043E\u0442\u0435\u0440\u0435\u0442\u044C. \u0421\u043F\u0430\u0441\u0438\u0431\u043E!$h",
  "AcceptGift_(O)200": "\u041C-\u043C-\u043C... \u0412 \u0433\u043E\u0440\u043E\u0434\u0435 \u043E\u0432\u043E\u0449\u0438 \u043D\u0435 \u0431\u044B\u043B\u0438 \u0442\u0430\u043A\u0438\u043C\u0438 \u0441\u0432\u0435\u0436\u0438\u043C\u0438. \u041E\u0431\u043E\u0436\u0430\u044E!$h",
  "AcceptGift_(O)196": "$c 0.8#\u0412\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043E\u0447\u0435\u043D\u044C \u0432\u043A\u0443\u0441\u043D\u043E... \u0421\u043F\u0430\u0441\u0438\u0431\u043E! \u041D\u0435\u0442 \u043D\u0438\u0447\u0435\u0433\u043E \u043B\u0443\u0447\u0448\u0435 \u0441\u0432\u0435\u0436\u0435\u0433\u043E \u043E\u0433\u043E\u0440\u043E\u0434\u043D\u043E\u0433\u043E \u0441\u0430\u043B\u0430\u0442\u0430.$h#\u0423\u0445 \u0442\u044B, @! \u042D\u0442\u043E\u0433\u043E-\u0442\u043E \u043C\u043D\u0435 \u0438 \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C. \u041A\u0442\u043E \u0442\u0435\u0431\u0435 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B?$h",
  "dating_Leah_memory_oneday": "\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043D\u0435 \u0434\u0443\u043C\u0430\u0439, \u0447\u0442\u043E \u0440\u0430\u0437 \u043C\u044B \u0442\u0435\u043F\u0435\u0440\u044C \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u043C\u0441\u044F, \u0442\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C \u0432\u0441\u0435 \u0432\u0440\u0435\u043C\u044F \u0441\u043E \u043C\u043D\u043E\u0439... \u042F \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0443 \u0442\u0435\u0431\u044F \u043C\u043D\u043E\u0433\u043E \u0434\u0435\u043B!",
  "eventSeen_53_memory_oneday": "\u042F \u043F\u0440\u043E\u0434\u0430\u043B\u0430 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u043A\u0430\u0440\u0442\u0438\u043D \u043D\u0430 \u0442\u043E\u043C \u043F\u043E\u043A\u0430\u0437\u0435, \u0447\u0442\u043E\u0431\u044B \u0445\u0432\u0430\u0442\u0438\u043B\u043E \u0435\u0449\u0435 \u043D\u0430 \u0433\u043E\u0434. \u0410 \u0431\u043E\u043B\u044C\u0448\u0435\u0433\u043E \u043C\u043D\u0435 \u0438 \u043D\u0435 \u043D\u0430\u0434\u043E!",
  "eventSeen_54_memory_oneday": "\u042F \u0432\u0441\u0435 \u0435\u0449\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0435\u043D\u0430 \u0438\u0437-\u0437\u0430 \u043F\u0438\u043A\u043D\u0438\u043A\u0430... \u041A\u0430\u043A\u043E\u0439 \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0439!$a#$b#\u0414\u0430\u0432\u0430\u0439 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0431\u0443\u0434\u0435\u043C... \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C... \u043E\u0431 \u044D\u0442\u043E\u043C \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0435.$s",
  "eventSeen_584059_memory_oneday": "\u0415\u0441\u043B\u0438 \u0441\u043F\u0440\u043E\u0441 \u043D\u0430 \u043C\u043E\u0438 \u043A\u0430\u0440\u0442\u0438\u043D\u044B \u043E\u043D\u043B\u0430\u0439\u043D \u043D\u0435 \u0443\u043F\u0430\u0434\u0435\u0442, \u044F \u0441\u043C\u043E\u0433\u0443 \u0440\u0438\u0441\u043E\u0432\u0430\u0442\u044C \u0438\u0445 \u0432\u0435\u0447\u043D\u043E. \u0423 \u043C\u0435\u043D\u044F \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044B\u043B\u0430 \u0442\u0430\u043A\u0430\u044F \u043C\u0435\u0447\u0442\u0430.",
  "Resort_Entering": "\u041D\u0438\u043A\u043E\u043C\u0443 \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438, \u043D\u043E \u0412\u0438\u043B\u043B\u0438 \u0434\u0430\u043B \u043C\u043D\u0435 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u043E\u0440\u0443\u043B\u0438\u0442\u044C.$h",
  "Resort_Leaving": "\u041E\u0445, \u044D\u0442\u043E \u0431\u044B\u043B\u043E \u043E\u0447\u0435\u043D\u044C \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u043B\u044F\u044E\u0449\u0435.",
  "Resort": "\u041C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u043F\u043E\u0433\u043E\u0434\u0430 \u0432 \u0414\u043E\u043B\u0438\u043D\u0435 \u0421\u0442\u0430\u0440\u0434\u044C\u044E, \u043D\u043E, \u043A\u0430\u043A \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0441\u044F, \u0432\u0441\u0435 \u043F\u043E\u0437\u043D\u0430\u0435\u0442\u0441\u044F \u0432 \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u0438, \u0442\u0430\u043A \u0447\u0442\u043E \u043F\u0440\u0438\u044F\u0442\u043D\u043E \u0438\u043D\u043E\u0439 \u0440\u0430\u0437 \u0438\u0437 \u0434\u043E\u043C\u0430 \u0432\u044B\u0431\u0440\u0430\u0442\u044C\u0441\u044F.",
  "Resort_Shore": "\u0424\u043E\u0440\u043C\u044B \u044D\u0442\u0438\u0445 \u0432\u043E\u043B\u043D \u0432\u043D\u0443\u0448\u0430\u044E\u0442 \u0431\u043B\u0430\u0433\u043E\u0433\u043E\u0432\u0435\u043D\u0438\u0435 \u0438 \u0442\u0440\u0435\u043F\u0435\u0442.#$e#\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u0441\u043C\u043E\u0433\u0443 \u043B\u0438 \u044F \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u0442\u044C \u043F\u043E\u0434\u043E\u0431\u043D\u0443\u044E \u0431\u0435\u0441\u0444\u043E\u0440\u043C\u0435\u043D\u043D\u043E\u0441\u0442\u044C \u0432 \u0441\u0432\u043E\u0438\u0445 \u0441\u043A\u0443\u043B\u044C\u043F\u0442\u0443\u0440\u0430\u0445.",
  "Resort_Chair": "\u0415\u0441\u043B\u0438 \u043E\u0441\u043E\u0431\u043E \u043D\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F, \u0442\u043E \u043C\u043D\u0435 \u044D\u0442\u0430 \u0436\u0430\u0440\u0430 \u0434\u0430\u0436\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F.$h",
  "Resort_Wander": "\u0425\u043C, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u0441 \u044D\u0442\u0438\u043C\u0438 \u0434\u0435\u0440\u0435\u0432\u044C\u044F\u043C\u0438 \u0431\u044B\u043B\u043E \u0431\u044B \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E \u043F\u043E\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0432 \u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u043C \u043F\u043B\u0430\u043D\u0435.#$e#\u041D\u043E, \u043C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0412\u0438\u043B\u043B\u0438 \u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u043E\u0431\u0440\u0430\u0434\u0443\u0435\u0442\u0441\u044F, \u0435\u0441\u043B\u0438 \u044F \u0432 \u0435\u0433\u043E \u043B\u043E\u0434\u043A\u0443 \u0431\u0440\u0435\u0432\u0435\u043D \u043D\u0430\u043A\u0438\u0434\u0430\u044E!$h",
  "Resort_Wander_2": "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u0447\u0442\u043E \u0435\u0449\u0435 \u0442\u0430\u043A\u043E\u0433\u043E \u0442\u0443\u0442 \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C.#$e#\u041C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u044F \u0432\u0438\u0434\u0435\u043B\u0430 \u0440\u043E\u0441\u0441\u044B\u043F\u044C \u0432\u043A\u0443\u0441\u043D\u043E \u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0449\u0438\u0445 \u0433\u0440\u0435\u0446\u043A\u0438\u0445 \u043E\u0440\u0435\u0445\u043E\u0432 \u043D\u0430 \u043A\u0443\u0441\u0442\u0435 \u043D\u0435\u043F\u043E\u0434\u0430\u043B\u0435\u043A\u0443.",
  "Resort_Bar": "\u041A\u0430\u043A \u0442\u0435\u0431\u0435 \u043C\u0435\u0441\u0442\u043D\u0430\u044F \u041F\u0438\u043D\u0430 \u043A\u043E\u043B\u0430\u0434\u0430? \u042F \u0443\u0436\u0435 \u0432\u0442\u043E\u0440\u0443\u044E \u0441\u0435\u0431\u0435 \u0437\u0430\u043A\u0430\u0437\u0430\u043B\u0430... \u0445\u0435-\u0445\u0435.",
  "FlowerDance_Accept_Spouse": "\u041D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E! \u042F \u0443\u0436\u0435 \u043D\u0430\u0447\u0430\u043B\u0430 \u0431\u043E\u044F\u0442\u044C\u0441\u044F, \u0447\u0442\u043E \u0442\u044B \u0431\u0443\u0434\u0435\u0448\u044C \u0442\u0430\u043D\u0446\u0435\u0432\u0430\u0442\u044C \u0441 \u043A\u0435\u043C-\u0442\u043E \u0434\u0440\u0443\u0433\u0438\u043C!$h",
  "FlowerDance_Decline": "\u0421\u043A\u0430\u0436\u0443 \u0442\u0435\u0431\u0435 \u0447\u0435\u0441\u0442\u043D\u043E. \u042F \u043D\u0435 \u0445\u043E\u0447\u0443 \u0441 \u0442\u043E\u0431\u043E\u0439 \u0442\u0430\u043D\u0446\u0435\u0432\u0430\u0442\u044C.$u",
