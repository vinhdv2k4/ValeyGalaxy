  "breakUp": "\u041E\u0439-\u043E\u0439... \u042F\u0441\u043D\u043E. \u0425\u0430... \u0412\u0435\u0447\u043D\u043E \u043C\u043D\u0435 \u0432 \u044D\u0442\u0438\u0445 \u0434\u0435\u043B\u0430\u0445 \u043D\u0435 \u0432\u0435\u0437\u0435\u0442...$s",
  "dumped_Girls": "\u041D\u0435 \u0445\u043E\u0447\u0443 \u043F\u043E\u043A\u0430 \u0442\u0435\u0431\u044F \u0432\u0438\u0434\u0435\u0442\u044C...$s",
  "secondChance_Girls": "\u0422\u044B ${\u043F\u0440\u0438\u0447\u0438\u043D\u0438\u043B^\u043F\u0440\u0438\u0447\u0438\u043D\u0438\u043B\u0430}$ \u043C\u043D\u0435 \u043D\u0435\u043C\u0430\u043B\u043E \u0433\u043E\u0440\u044F... \u041D\u043E \u044F \u0433\u043E\u0442\u043E\u0432\u0430 \u0437\u0430\u0431\u044B\u0442\u044C \u043F\u0440\u043E\u0448\u043B\u043E\u0435.$s",
  "Beach": "\u042F \u043F\u0440\u0438\u0448\u043B\u0430 \u043F\u043E\u0441\u043B\u0443\u0448\u0430\u0442\u044C \u043E\u043A\u0435\u0430\u043D. \u041A\u0440\u0430\u0441\u0438\u0432\u043E, \u043D\u0435 \u043F\u0440\u0430\u0432\u0434\u0430 \u043B\u0438?",
  "Mon": "\u0414\u0435\u0440\u0435\u0432\u044C\u044F \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0442\u0430\u043A\u0438\u0435 \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0435, \u043D\u0435 \u043F\u0440\u0430\u0432\u0434\u0430 \u043B\u0438?#$q 21/22/211132 Mon_old#\u0422\u0430\u043A \u043F\u043E\u0447\u0435\u043C\u0443 \u0442\u0435\u0431\u0435 \u0437\u0430\u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C \u0441\u0442\u0430\u0442\u044C \u0444\u0435\u0440\u043C\u0435\u0440\u043E\u043C?#$r 21 -5 Mon_21#\u042F \u0445\u043E\u0447\u0443 \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u043A\u0443\u0447\u0443 \u0434\u0435\u043D\u0435\u0433.#$r 22 5 Mon_22#\u0416\u0438\u0437\u043D\u044C \u0437\u0434\u0435\u0441\u044C \u0431\u043E\u043B\u0435\u0435 \u00AB\u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0430\u044F\u00BB, \u0447\u0435\u043C \u0432 \u0433\u043E\u0440\u043E\u0434\u0435.#$r 211132 5 Mon_211132#\u0427\u0442\u043E\u0431\u044B \u043F\u043E\u0439\u0442\u0438 \u043F\u043E \u0441\u0442\u043E\u043F\u0430\u043C \u0434\u0435\u0434\u0443\u0448\u043A\u0438.#$r 22 5 Mon_22#\u042F ${\u0445\u043E\u0442\u0435\u043B^\u0445\u043E\u0442\u0435\u043B\u0430}$ \u0441\u0431\u0435\u0436\u0430\u0442\u044C \u043E\u0442 \u0441\u0442\u0430\u0440\u043E\u0439 \u0436\u0438\u0437\u043D\u0438.",
  "Mon_old": "$p 21#\u041D\u0443 \u0438 \u043A\u0430\u043A, \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0448\u044C \u0441\u0442\u043E\u043B\u044C\u043A\u043E, \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C?|\u0412\u0440\u0435\u043C\u044F, \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u043D\u043E\u0435 \u043D\u0430 \u043F\u0440\u0438\u0440\u043E\u0434\u0435, \u0442\u043E\u0433\u043E \u0441\u0442\u043E\u0438\u0442.",
  "Mon_21": "\u0425\u043C-\u043C. \u041A\u0430\u043A-\u0442\u043E \u044D\u0442\u043E \u043C\u0435\u043B\u043E\u0447\u043D\u043E, \u043D\u0435 \u0434\u0443\u043C\u0430\u0435\u0448\u044C?$s",
  "Mon_22": "\u0412\u043E\u0442 \u043E\u043D\u043E \u043A\u0430\u043A... \u042F \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u043B\u0430 \u0441\u044E\u0434\u0430 \u043F\u043E\u0447\u0442\u0438 \u043F\u043E \u0442\u043E\u0439 \u0436\u0435 \u043F\u0440\u0438\u0447\u0438\u043D\u0435!$h#$b#\u041C\u043D\u0435 \u0437\u0430\u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C \u0431\u044B\u0442\u044C \u043F\u043E\u0431\u043B\u0438\u0436\u0435 \u043A \u043F\u0440\u0438\u0440\u043E\u0434\u0435...",
  "Mon_211132": "\u042D\u0442\u043E \u043C\u0438\u043B\u043E, \u0447\u0442\u043E \u0442\u044B \u0442\u0430\u043A \u0447\u0442\u0438\u0448\u044C \u0441\u0432\u043E\u0435\u0433\u043E \u0434\u0435\u0434\u0443\u0448\u043A\u0443.",
  "GreenRain": "\u041E\u0442\u043A\u0443\u0434\u0430 \u0432\u043E\u043E\u0431\u0449\u0435 \u0432\u044B\u043B\u0435\u0437\u043B\u0438 \u0432\u0441\u0435 \u044D\u0442\u0438 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F? \u041D\u0438\u0447\u0435\u0433\u043E \u0441\u0435\u0431\u0435 \u0441\u044E\u0440\u043F\u0440\u0438\u0437, \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u043D\u043E \u044F \u043D\u0435 \u0436\u0430\u043B\u0443\u044E\u0441\u044C...",
  "GreenRainFinished": "\u0412\u0441\u0435 \u0432 \u0433\u043E\u0440\u043E\u0434\u0435 \u0447\u0442\u043E, \u0438\u0441\u043F\u0443\u0433\u0430\u043B\u0438\u0441\u044C \u044D\u0442\u043E\u0433\u043E \u0434\u043E\u0436\u0434\u044F? \u0410 \u044F \u0438 \u043D\u0435 \u0437\u043D\u0430\u043B\u0430... \u041C\u043D\u0435 \u043E\u043D \u043E\u0447\u0435\u043D\u044C \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u0441\u044F!$h",
  "GreenRain_2": "\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044C, \u0435\u0441\u043B\u0438 \u0431\u044B \u044D\u0442\u043E\u0442 \u0434\u043E\u0436\u0434\u044C \u0448\u0435\u043B \u0432\u0441\u0435 \u043B\u0435\u0442\u043E... \u0420\u0430\u0441\u0442\u0435\u043D\u0438\u044F \u0442\u043E\u0433\u0434\u0430 \u0437\u0430\u043F\u043E\u043B\u043E\u043D\u0438\u043B\u0438 \u0431\u044B \u0432\u0441\u044E \u0414\u043E\u043B\u0438\u043D\u0443!",
  "Tue4": "\u041F\u0440\u0438\u0432\u0435\u0442. \u0410, \u0442\u044B \u0445\u043E\u0447\u0435\u0448\u044C \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C?#$e#\u041C\u0435\u0441\u0442\u043D\u044B\u0439 \u043B\u0430\u043D\u0434\u0448\u0430\u0444\u0442 \u0434\u0430\u0435\u0442 \u043C\u043D\u0435 \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E \u0438\u0434\u0435\u0439. \u042D\u0442\u043E\u0442 \u043B\u0430\u043D\u0434\u0448\u0430\u0444\u0442 \u0438 \u0441\u0430\u043C \u043F\u043E\u0447\u0442\u0438 \u043A\u0430\u043A \u0441\u043A\u0443\u043B\u044C\u043F\u0442\u0443\u0440\u0430.#$e#\u042F \u043D\u0435 \u0437\u0430\u043D\u0438\u043C\u0430\u044E\u0441\u044C \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E\u043C \u0440\u0430\u0434\u0438 \u0434\u0435\u043D\u0435\u0433. \u042D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u043C\u043E\u0435 \u043F\u0440\u0438\u0437\u0432\u0430\u043D\u0438\u0435.#$e#\u041F\u043E\u0445\u043E\u0436\u0435, \u0444\u0435\u0440\u043C\u0435\u0440\u0441\u0442\u0432\u043E \u2014 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u0430\u044F \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u044F. \u041C\u043E\u0436\u043D\u043E \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C \u0432\u043A\u0443\u0441\u043D\u0443\u044E \u0435\u0434\u0443 \u0434\u043B\u044F \u0432\u0441\u0435\u0445!$h#$e#\u0423 \u0442\u0435\u0431\u044F, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u0434\u0435\u043B\u0430. \u041F\u0440\u043E\u0441\u0442\u0438.",
  "Tue": "\u041F\u0440\u0438\u0432\u0435\u0442, \u0441\u043E\u0441\u0435\u0434.#$e#\u041C\u044B \u043E\u0431\u0430 \u0436\u0438\u0432\u0435\u043C \u0437\u0430 \u0433\u043E\u0440\u043E\u0434\u043E\u043C. \u042D\u0442\u043E \u0447\u0442\u043E-\u0442\u043E \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442?",
  "Wed": "#$1 LeahBug#\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0443\u0442\u0440\u043E\u043C \u044F \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u043B\u0430 \u043D\u0430 \u0436\u0443\u0447\u043A\u0430.$s#$e#\u0418\u043D\u043E\u0433\u0434\u0430 \u044F \u0434\u0443\u043C\u0430\u044E, \u0447\u0442\u043E \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u0436\u0438\u0442\u044C, \u043D\u0435 \u0440\u0430\u0437\u0440\u0443\u0448\u0430\u044F \u043F\u0440\u0438\u0440\u043E\u0434\u0443 \u0442\u0430\u043A \u0438\u043B\u0438 \u0438\u043D\u0430\u0447\u0435.",
  "Wed6": "\u042F \u043B\u044E\u0431\u043B\u044E \u0431\u044B\u0442\u044C \u0440\u044F\u0434\u043E\u043C \u0441 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u043C\u0438. \u041E\u043D\u0438 \u0442\u0430\u043A\u0438\u0435 \u043D\u0435\u0432\u0438\u043D\u043D\u044B\u0435.#$e#\u0416\u0438\u0432\u043E\u0442\u043D\u044B\u0435 \u043D\u0430 \u0444\u0435\u0440\u043C\u0435 \u0442\u043E\u0436\u0435 \u0447\u0443\u0434\u0435\u0441\u043D\u044B\u0435.$h",
  "Wed8": "$query PLAYER_NPC_RELATIONSHIP current any married roommate#\u0414\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C, \u0442\u0430\u043A \u043F\u0440\u0438\u044F\u0442\u043D\u043E \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C \u0446\u0435\u043B\u043E\u0435 \u043F\u043E\u043B\u0435 \u0443\u0440\u043E\u0436\u0430\u044F, \u0434\u0430? \u0422\u044B \u043F\u0440\u044F\u043C\u043E \u0441\u043E\u0437\u0434\u0430\u0435\u0448\u044C \u0435\u0434\u0443 \u0438\u0437 \u043D\u0438\u0447\u0435\u0433\u043E!$h|\u041F\u0440\u0438\u0432\u0435\u0442, @! \u042F \u043A\u0430\u043A \u0440\u0430\u0437 \u0434\u0443\u043C\u0430\u043B\u0430 \u043E \u0442\u0435\u0431\u0435 \u0438 \u0442\u0432\u043E\u0435\u0439 \u0444\u0435\u0440\u043C\u0435.#$e#\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u043B\u0430, \u043A\u0430\u043A \u0437\u0434\u043E\u0440\u043E\u0432\u043E \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u0441\u0440\u0430\u0437\u0443 \u0446\u0435\u043B\u0443\u044E \u043A\u0443\u0447\u0443 \u0443\u0440\u043E\u0436\u0430\u044F.$h#$e#\u041D\u043E \u043F\u043E\u043C\u043E\u0449\u044C \u0432\u0435\u0434\u044C \u0442\u0435\u0431\u0435 \u0431\u044B \u043D\u0435 \u043F\u043E\u043C\u0435\u0448\u0430\u043B\u0430, \u0434\u0430?$l",
  "Thu": "\u041D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435, \u0437\u0434\u0435\u0441\u044C \u043F\u043E\u043B\u043D\u043E \u0434\u0438\u043A\u043E\u0439 \u0435\u0434\u044B, \u0435\u0441\u043B\u0438 \u0437\u043D\u0430\u0442\u044C, \u0433\u0434\u0435 \u0438\u0441\u043A\u0430\u0442\u044C.#$e#\u042F \u043F\u043E\u0447\u0442\u0438 \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C \u0435\u043C \u0441\u0432\u0435\u0436\u0438\u0435 \u0441\u0430\u043B\u0430\u0442\u044B.$h",
  "Thu6": "\u0421\u043E\u0431\u0438\u0440\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E \u2014 \u044D\u0442\u043E \u043F\u043E \u043C\u043E\u0435\u0439 \u0447\u0430\u0441\u0442\u0438. \u041A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u044F \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u044E \u0442\u0435\u0431\u0435 \u0441\u0432\u0435\u0436\u0438\u0439 \u0441\u0430\u043B\u0430\u0442.$h",
  "Fri": "\u0421 \u0434\u0435\u0440\u0435\u0432\u044C\u044F\u043C\u0438 \u0434\u0440\u0443\u0436\u0438\u0442\u044C \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u043F\u0440\u043E\u0449\u0435. \u0418\u043C \u043D\u0435 \u043E \u0447\u0435\u043C \u043E\u0441\u043E\u0431\u043E \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C.$h",
  "Fri2": "\u0411\u0435\u0437 \u043F\u0440\u0438\u0440\u043E\u0434\u044B \u043C\u044B \u0431\u044B \u043D\u0435 \u0432\u044B\u0436\u0438\u043B\u0438. \u041F\u043E\u043B\u0435\u0437\u043D\u043E \u043F\u043E\u043C\u043D\u0438\u0442\u044C \u043E\u0431 \u044D\u0442\u043E\u043C.",
  "Fri4": "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439, @. \u0425\u043E\u0440\u043E\u0448\u0438\u0439 \u0434\u0435\u043D\u0435\u043A, \u043F\u0440\u0430\u0432\u0434\u0430?#$e#\u0417\u0430\u0445\u043E\u0434\u0438 \u043A\u043E \u043C\u043D\u0435 \u0432 \u0434\u043E\u043C\u0438\u043A, \u0435\u0441\u043B\u0438 \u0437\u0430\u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0441 \u043A\u0435\u043C-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C.$h",
  "Fri6": "\u0418\u043D\u043E\u0433\u0434\u0430 \u043D\u0430 \u043C\u0435\u043D\u044F \u043D\u0430\u0445\u043E\u0434\u0438\u0442 \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u043E. \u0412 \u0433\u043E\u043B\u043E\u0432\u0435 \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442\u0441\u044F \u043F\u043E\u043B\u043D\u0430\u044F \u043F\u0443\u0441\u0442\u043E\u0442\u0430... \u0438 \u043C\u043D\u0435 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043A\u0430\u043A-\u0442\u043E \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E, \u0434\u0430\u0436\u0435 \u0431\u043B\u0430\u0436\u0435\u043D\u043D\u043E.#$e#\u042D\u0439! \u041A \u0432\u0438\u043D\u0443 \u044D\u0442\u043E \u0432\u043E\u043E\u0431\u0449\u0435 \u043D\u0435 \u0438\u043C\u0435\u0435\u0442 \u043D\u0438\u043A\u0430\u043A\u043E\u0433\u043E \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F!$h",
  "Fri8": "\u0422\u0435\u0431\u0435 \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C \u0437\u043D\u0430\u0442\u044C, \u043A\u0430\u043A\u043E\u0432\u043E \u0431\u044B\u0442\u044C \u0434\u0440\u0443\u0433\u0438\u043C \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C?#$e#\u041C\u044B\u0441\u043B\u0438\u043C \u043B\u0438 \u043C\u044B \u043F\u043E\u0445\u043E\u0436\u0438\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u043C \u2014 \u0438\u043B\u0438 \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E \u043F\u043E-\u0440\u0430\u0437\u043D\u043E\u043C\u0443?#$e#\u041D\u0435 \u043E\u0431\u0440\u0430\u0449\u0430\u0439 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F, \u0438\u043D\u043E\u0433\u0434\u0430 \u044F \u0434\u0443\u043C\u0430\u044E \u043E \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u043C...$h",
  "Sat": "\u042F \u043B\u044E\u0431\u043B\u044E \u0443\u043A\u0440\u0430\u0448\u0430\u0442\u044C \u0434\u043E\u043C \u043F\u043E\u0434 \u043A\u0430\u0436\u0434\u043E\u0435 \u0432\u0440\u0435\u043C\u044F \u0433\u043E\u0434\u0430.",
  "Sat8": "$query PLAYER_NPC_RELATIONSHIP current any married roommate#\u042F \u0431\u044B \u0445\u043E\u0442\u0435\u043B\u0430 \u0441\u0430\u043C\u0430 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u043E\u0432\u044B\u0440\u0430\u0449\u0438\u0432\u0430\u0442\u044C, \u043D\u043E \u043C\u043D\u0435 \u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u0442\u044C \u0434\u043B\u044F \u044D\u0442\u043E\u0433\u043E \u0434\u0438\u043A\u0438\u0435 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F.|\u0424\u0435\u0440\u043C\u0435\u0440\u0441\u0442\u0432\u043E \u2014 \u044D\u0442\u043E \u0437\u0432\u0443\u0447\u0438\u0442 \u0442\u0430\u043A \u0437\u0434\u043E\u0440\u043E\u0432\u043E. \u042F \u0438 \u0441\u0430\u043C\u0430 \u043A\u0430\u043A-\u043D\u0438\u0431\u0443\u0434\u044C \u0445\u043E\u0447\u0443 \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C.$l",
  "Sun": "\u0415\u0441\u043B\u0438 \u0432\u0434\u0440\u0443\u0433 \u0443\u0441\u043B\u044B\u0448\u0438\u0448\u044C \u0433\u0440\u043E\u043C\u043A\u0438\u0439 \u0441\u0442\u0443\u043A \u0438\u0437 \u043C\u043E\u0435\u0433\u043E \u0434\u043E\u043C\u0430, \u0442\u043E, \u0441\u043A\u043E\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043E, \u044D\u0442\u043E \u044F \u043F\u0440\u043E\u0441\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u044E \u043D\u0430\u0434 \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0439 \u0441\u043A\u0443\u043B\u044C\u043F\u0442\u0443\u0440\u043E\u0439.",
  "Sun8": "\u0415\u0441\u043B\u0438 \u0442\u0435\u0431\u0435 \u0432\u0434\u0440\u0443\u0433 \u043F\u043E\u043F\u0430\u0434\u0435\u0442\u0441\u044F \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u0430\u044F \u043A\u043E\u0440\u044F\u0433\u0430 \u2014 \u043D\u0435\u0441\u0438 \u0435\u0435 \u043A\u043E \u043C\u043D\u0435.#$e#\u042F \u0431\u0443\u0434\u0443 \u043E\u0447\u0435\u043D\u044C \u043F\u0440\u0438\u0437\u043D\u0430\u0442\u0435\u043B\u044C\u043D\u0430.",
  "event_sculpt1": "... \u0427\u0442\u043E?$7#$b#\u041E! \u0414\u0430, \u044D\u0442\u043E \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u0430\u044F \u043F\u0440\u0430\u0432\u0434\u0430!$h",
  "event_sculpt2": "\u0412 \u044D\u0442\u043E\u043C \u043D\u0435\u0442 \u043D\u0438\u0447\u0435\u0433\u043E \u043F\u043B\u043E\u0445\u043E\u0433\u043E... \u042F \u0434\u0443\u043C\u0430\u044E, \u0432 \u0447\u0438\u0441\u0442\u043E\u0439, \u043D\u0435\u0442\u0440\u043E\u043D\u0443\u0442\u043E\u0439 \u043F\u0440\u0438\u0440\u043E\u0434\u0435 \u0442\u043E\u0436\u0435 \u0435\u0441\u0442\u044C \u0441\u0432\u043E\u044F \u043A\u0440\u0430\u0441\u043E\u0442\u0430!#$b#\u041D\u043E \u043C\u043D\u0435, \u043A\u0430\u043A \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0443, \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043A\u0430\u043A \u043C\u044B \u0444\u043E\u0440\u043C\u0438\u0440\u0443\u0435\u043C \u0438 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u043C \u043C\u0438\u0440 \u0432\u043E\u043A\u0440\u0443\u0433 \u043D\u0430\u0441. \u0414\u0443\u043C\u0430\u044E, \u044F \u0445\u043E\u0447\u0443 \u0441\u043A\u0430\u0437\u0430\u0442\u044C, \u0447\u0442\u043E \u043C\u043D\u0435 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E \u00AB\u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E\u00BB.",
  "event_sculpt3": "\u0421\u0432\u0438\u043D\u044C\u044F!%fork$a^\u041E\u0439! \u0422\u044B?.. \u042F \u0442\u043E\u0436\u0435.$6#$b#\u0423\u0431\u0438\u0440\u0430\u0439\u0441\u044F!$a^\u0411\u0443\u0434\u0443 \u0437\u043D\u0430\u0442\u044C.$l",
  "event_parents1": "\u0422\u0432\u043E\u044F \u043F\u0440\u0430\u0432\u0434\u0430... \u042F \u0431\u044B \u043D\u0435 \u0441\u043C\u043E\u0433\u043B\u0430 \u0431\u044B\u0442\u044C \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u043E\u0439 \u0442\u0430\u043C.$u#$b#\u0422\u0430\u043A \u0431\u044B\u043B\u043E \u043B\u0443\u0447\u0448\u0435 \u0434\u043B\u044F \u043D\u0430\u0441 \u043E\u0431\u043E\u0438\u0445... \u0420\u0430\u0437\u043E\u0440\u0432\u0430\u0442\u044C \u043D\u0435\u0441\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F, \u043F\u043E\u043A\u0430 \u043C\u044B \u0435\u0449\u0435 \u043C\u043E\u043B\u043E\u0434\u044B \u0438 \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u043D\u044B.$u",
  "event_parents2": "\u042D\u0442\u043E \u0431\u044B\u043B\u043E \u0440\u0435\u0437\u043A\u043E\u0432\u0430\u0442\u043E, \u043D\u043E... \u0412 \u043E\u0431\u0449\u0435\u043C, \u0434\u0430. \u041F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442\u044B \u0443 \u043D\u0430\u0441 \u0431\u044B\u043B\u0438 \u0440\u0430\u0437\u043D\u044B\u0435.$u",
  "event_parents3": "\u0414\u0430? \u041D\u0443, \u0442\u043E\u0433\u0434\u0430 \u044F, \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u0438 \u0443\u0435\u0434\u0443!%fork$a",
  "event_parents4": "\u042D\u0445...$s#$b#\u041F\u043E\u0436\u0430\u043B\u0443\u0439, \u044D\u0442\u043E \u0442\u0430\u043A... \u042F \u0431\u044B\u043B\u0430 \u044D\u0433\u043E\u0438\u0441\u0442\u0438\u0447\u043D\u043E\u0439. \u041D\u043E \u0440\u0430\u0437\u0432\u0435 \u043C\u043E\u0436\u043D\u043E \u043C\u0435\u043D\u044F \u0432\u0438\u043D\u0438\u0442\u044C \u0437\u0430 \u0442\u043E, \u0447\u0442\u043E \u044F \u0445\u043E\u0442\u0435\u043B\u0430 \u0431\u044B\u0442\u044C \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u043E\u0439? \u0423\u0444... \u042F \u043D\u0435 \u0437\u043D\u0430\u044E...$s",
  "event_parents5": "\u041E\u0445...$s#$b#\u041C\u043E\u0436\u0435\u0442, \u0442\u0430\u043A \u0438 \u0435\u0441\u0442\u044C... \u041B\u044E\u0434\u0438 \u2014 \u044D\u0433\u043E\u0438\u0441\u0442\u0438\u0447\u043D\u044B\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430. \u042F \u043D\u0435 \u0437\u043D\u0430\u044E.$s#$b#\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043D\u0435 \u0441\u0442\u043E\u0438\u0442 \u043D\u0430 \u044D\u0442\u043E\u043C \u0437\u0430\u0446\u0438\u043A\u043B\u0438\u0432\u0430\u0442\u044C\u0441\u044F. \u0418\u043D\u043E\u0433\u0434\u0430 \u0432\u0441\u0435\u043C \u043D\u0430\u043C \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0441\u043B\u043E\u0436\u043D\u044B\u0439 \u0432\u044B\u0431\u043E\u0440.$s",
  "summer_1": "\u0421\u0440\u0430\u0437\u0443 \u044F\u0441\u043D\u043E, \u0447\u0442\u043E \u0441\u0435\u0439\u0447\u0430\u0441 \u043B\u0435\u0442\u043E, \u0435\u0441\u043B\u0438 \u0432 \u0432\u043E\u0437\u0434\u0443\u0445\u0435 \u0441\u0442\u043E\u0438\u0442 \u0441\u043B\u0430\u0434\u043A\u0438\u0439 \u0430\u0440\u043E\u043C\u0430\u0442 \u043D\u0435\u043A\u0442\u0430\u0440\u0430!$h",
  "summer_Mon": "\u042F \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0430\u0448\u043B\u0430 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0434\u0438\u043A\u0438\u0445 \u0444\u0440\u0443\u043A\u0442\u043E\u0432!#$e#\u041F\u0440\u043E\u0441\u0442\u0438, \u0443 \u043C\u0435\u043D\u044F \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C.$s#$e#\u041D\u043E \u0442\u044B \u043F\u043E\u0438\u0449\u0438, \u044F \u0443\u0432\u0435\u0440\u0435\u043D\u0430, \u0442\u044B \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043D\u0430\u0439\u0434\u0435\u0448\u044C.",
  "summer_Tue": "\u0413\u043E\u043B\u043E\u0441\u0430 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445 \u0441 \u0444\u0435\u0440\u043C\u044B \u2014 \u043F\u0440\u043E\u0441\u0442\u043E \u0447\u0443\u0434\u043E, \u043F\u0440\u0430\u0432\u0434\u0430?",
  "summer_Tue4": "\u041F\u0440\u043E\u0441\u0442\u044B\u0435 \u0432\u0435\u0449\u0438 \u043B\u0443\u0447\u0448\u0435 \u0432\u0441\u0435\u0433\u043E \u0432 \u0436\u0438\u0437\u043D\u0438: \u043D\u0435\u0436\u043D\u044B\u0439 \u043B\u0435\u0442\u043D\u0438\u0439 \u0432\u0435\u0442\u0435\u0440\u043E\u043A, \u0432\u0435\u043B\u0438\u0447\u0430\u0432\u044B\u0435 \u043E\u0431\u043B\u0430\u043A\u0430 \u0438 \u043A\u0443\u0431\u043E\u043A, \u043F\u043E\u043B\u043D\u044B\u0439 \u043A\u0440\u0430\u0441\u043D\u0435\u043D\u044C\u043A\u043E\u0433\u043E \u0438\u0437 \u0434\u043E\u043B\u0438\u043D\u044B \u0421\u0442\u0430\u0440\u0434\u044C\u044E.",
  "summer_Thu6": "\u0423 \u043C\u0435\u043D\u044F \u043D\u0430\u043C\u0435\u0442\u0430\u043D \u0433\u043B\u0430\u0437 \u043D\u0430 \u0434\u0438\u043A\u0438\u0435 \u043F\u043B\u043E\u0434\u044B. \u041A\u0430\u043A-\u043D\u0438\u0431\u0443\u0434\u044C \u044F \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u044E \u0442\u0435\u0431\u0435 \u0444\u0440\u0443\u043A\u0442\u043E\u0432\u044B\u0439 \u0441\u0430\u043B\u0430\u0442.$h",
  "summer_Fri": "\u0421 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043F\u043E\u0434\u0441\u043E\u0447\u043D\u0438\u043A\u0430 \u043C\u043E\u0436\u043D\u043E \u0434\u043E\u0431\u044B\u0432\u0430\u0442\u044C \u0441\u0438\u0440\u043E\u043F\u044B \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0435 \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u0438 \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E \u0438\u0437 \u0434\u0435\u0440\u0435\u0432\u0430.#$e#\u041F\u0440\u043E\u0446\u0435\u0441\u0441 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u0439, \u0437\u0430\u0442\u043E \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u0446\u0435\u043D\u043D\u044B\u0439 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442.",
  "summer_Fri2": "\u041D\u0435 \u0445\u043E\u0447\u0443 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u0433\u0440\u0443\u0431\u043E\u0439, \u043D\u043E \u0435\u0441\u043B\u0438 \u043C\u044B \u043D\u0435 \u043D\u0430\u0447\u043D\u0435\u043C \u0443\u0432\u0430\u0436\u0430\u0442\u044C \u043F\u0440\u0438\u0440\u043E\u0434\u0443, \u043D\u0430\u0448\u0438\u043C \u0432\u043D\u0443\u043A\u0430\u043C \u043A\u0440\u044B\u0448\u043A\u0430.#$e#\u0422\u044B \u0442\u0430\u043A \u043D\u0435 \u0434\u0443\u043C\u0430\u0435\u0448\u044C?",
  "summer_Fri4": "\u0422\u0435\u0431\u0435 \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u0441\u043B\u0443\u0447\u0430\u043B\u043E\u0441\u044C \u0437\u0430\u0439\u0442\u0438 \u0432 \u043B\u0435\u0441... \u0418 \u043F\u0440\u043E\u0441\u0442\u043E... \u041D\u0430\u0441\u043B\u0430\u0434\u0438\u0442\u044C\u0441\u044F \u043A\u0440\u0430\u0441\u043E\u0442\u043E\u0439 \u043F\u0440\u0438\u0440\u043E\u0434\u044B?#$e#\u0422\u0430\u043A \u043B\u0435\u0433\u043A\u043E \u0437\u0430\u0431\u044B\u0442\u044C, \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u0435\u043D \u043D\u0430\u0448 \u043C\u0438\u0440...",
  "summer_Fri6": "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439, @. \u0422\u0435\u0431\u0435 \u043D\u0435 \u0431\u044B\u0432\u0430\u0435\u0442 \u043E\u0434\u0438\u043D\u043E\u043A\u043E \u043D\u0430 \u0442\u0432\u043E\u0435\u0439 \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0444\u0435\u0440\u043C\u0435?#$e#\u0417\u0430\u0445\u043E\u0434\u0438 \u043A\u043E \u043C\u043D\u0435 \u0432 \u0434\u043E\u043C\u0438\u043A, \u0435\u0441\u043B\u0438 \u0437\u0430\u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0441 \u043A\u0435\u043C-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C.$h",
  "summer_Sat": "\u0411\u0435\u0433\u0443\u0449\u0430\u044F \u0432\u043E\u0434\u0430 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043E\u0445\u043B\u0430\u0436\u0434\u0430\u0435\u0442 \u043C\u043E\u0439 \u0434\u043E\u043C \u043B\u0435\u0442\u043E\u043C.#$e#\u042F \u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0440\u043E\u0448\u043E \u043F\u0435\u0440\u0435\u043D\u043E\u0448\u0443 \u0436\u0430\u0440\u0443.",
  "summer_Sat4": "\u041E\u0434\u043D\u0430\u0436\u0434\u044B \u043B\u0435\u0442\u043E\u043C \u0431\u044B\u043B\u043E \u0442\u0430\u043A \u0436\u0430\u0440\u043A\u043E, \u0447\u0442\u043E \u044F \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0430\u0441\u044C \u043F\u043E\u0441\u0440\u0435\u0434\u0438 \u043D\u043E\u0447\u0438, \u0432\u044B\u0448\u043B\u0430 \u0438\u0437 \u0434\u043E\u043C\u0430 \u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0440\u044B\u0433\u043D\u0443\u043B\u0430 \u0432 \u0440\u0435\u043A\u0443!#$e#\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u043C\u0435\u043D\u044F \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0432\u0438\u0434\u0435\u043B!$h",
  "summer_Sun": "\u0427\u0435\u043C \u0431\u044B \u0437\u0430\u043D\u044F\u0442\u044C\u0441\u044F \u0432 \u044D\u0442\u043E\u0442 \u043B\u0435\u043D\u0438\u0432\u044B\u0439 \u0442\u0435\u043F\u043B\u044B\u0439 \u0434\u0435\u043D\u0435\u043A? \u042D\u0445...#$e#\u0415\u0441\u0442\u044C \u0438\u0434\u0435\u0438?",
  "fall_1": "\u0412\u0440\u0435\u043C\u0435\u043D\u0430 \u0433\u043E\u0434\u0430 \u0442\u0430\u043A \u0431\u044B\u0441\u0442\u0440\u043E \u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F!#$e#\u041F\u043E\u0440\u0430\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E.",
  "fall_Mon": "#$c .5#\u0417\u0430 \u0432\u044B\u0445\u043E\u0434\u043D\u044B\u0435 \u044F \u043D\u0430\u0431\u0440\u0430\u043B\u0430 \u0433\u0440\u0438\u0431\u043E\u0432!#$e#\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0430 \u0437\u0430\u0432\u0442\u0440\u0430\u043A \u0443 \u043C\u0435\u043D\u044F \u0431\u044B\u043B\u0430 \u043E\u0433\u0440\u043E\u043C\u043D\u0430\u044F \u0442\u0430\u0440\u0435\u043B\u043A\u0430 \u044F\u0438\u0447\u043D\u0438\u0446\u044B \u0441 \u0433\u0440\u0438\u0431\u0430\u043C\u0438... \u042F \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u0441\u044B\u0442\u0430\u044F.#$e#\u0413\u043B\u044F\u0434\u0438 \u0432 \u043E\u0431\u0430, \u043C\u043E\u0436\u0435\u0442, \u0442\u043E\u0436\u0435 \u043D\u0430\u0439\u0434\u0435\u0448\u044C \u0433\u0440\u0438\u0431\u043E\u0447\u043A\u0438... \u042F \u0443\u0432\u0435\u0440\u0435\u043D\u0430, \u0442\u044B \u0441\u043C\u043E\u0436\u0435\u0448\u044C.",
  "fall_Tue": "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043C\u043E\u0436\u043D\u043E \u043B\u0438 \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0438\u0437 \u0432\u044B\u0441\u0443\u0448\u0435\u043D\u043D\u044B\u0445 \u043B\u0438\u0441\u0442\u044C\u0435\u0432 \u043A\u043E\u043B\u043B\u0430\u0436?#$e#\u041E\u043D\u0438 \u0442\u0430\u043A\u0438\u0435 \u044F\u0440\u043A\u0438\u0435... \u042F \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435 \u043C\u043E\u0433\u0443 \u043D\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0438\u0445 \u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439 \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B.$h",
  "fall_Tue4": "\u0423 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0435\u0441\u0442\u044C \u0441\u0432\u043E\u0439 \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0439 \u0438 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0439 \u0432\u0437\u0433\u043B\u044F\u0434 \u043D\u0430 \u0436\u0438\u0437\u043D\u044C, \u0432\u0435\u0440\u0438\u0442 \u043E\u043D \u0432 \u044D\u0442\u043E \u0438\u043B\u0438 \u043D\u0435\u0442. \u0422\u044B \u0442\u0430\u043A \u043D\u0435 \u0434\u0443\u043C\u0430\u0435\u0448\u044C?#$e#\u041F\u0440\u0430\u0432\u0434\u0430, \u043C\u043D\u0435\u043D\u0438\u044F \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043B\u044E\u0434\u0435\u0439 \u044F \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435 \u043C\u043E\u0433\u0443 \u0443\u0432\u0430\u0436\u0430\u0442\u044C.",
  "fall_Wed": "\u0416\u0438\u0442\u044C \u0443 \u0440\u0435\u043A\u0438 \u0442\u0430\u043A \u0437\u0434\u043E\u0440\u043E\u0432\u043E.#$e#\u041A\u0430\u0436\u0434\u0443\u044E \u043D\u043E\u0447\u044C \u044F \u0437\u0430\u0441\u044B\u043F\u0430\u044E \u043F\u043E\u0434 \u0436\u0443\u0440\u0447\u0430\u043D\u0438\u0435 \u0432\u043E\u0434\u044B.",
  "fall_Thu6": "\u041D\u0430\u0434\u043E \u0431\u0443\u0434\u0435\u0442 \u043A\u0430\u043A-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u0442\u0435\u0431\u0435 \u0433\u0440\u0438\u0431\u043D\u043E\u0439 \u0441\u0442\u0438\u0440-\u0444\u0440\u0430\u0439.$h",
  "fall_Fri": "\u0423 \u0442\u0435\u0431\u044F \u0432 \u0434\u043E\u043C\u0435 \u0435\u0441\u0442\u044C \u043A\u0443\u0445\u043D\u044F?#$e#\u041D\u0430 \u043A\u0443\u0445\u043D\u0435 \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u043C\u043D\u043E\u0433\u043E \u0440\u0430\u0437\u043D\u044B\u0445 \u0432\u043A\u0443\u0441\u043D\u044B\u0445 \u0431\u043B\u044E\u0434.$h",
  "fall_Fri6": "\u041F\u0440\u0438\u0445\u043E\u0434\u0438 \u043A\u043E \u043C\u043D\u0435 \u0432 \u0434\u043E\u043C\u0438\u043A, \u0435\u0441\u043B\u0438 \u0437\u0430\u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0441 \u043A\u0435\u043C-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C.$h",
  "fall_Sat": "\u0423\u043A\u0440\u0430\u0448\u0430\u044F \u0441\u0432\u043E\u0439 \u0434\u043E\u043C \u043F\u043E\u0434 \u0432\u0440\u0435\u043C\u0435\u043D\u0430 \u0433\u043E\u0434\u0430, \u043C\u044B \u043F\u043E\u0434\u0447\u0435\u0440\u043A\u0438\u0432\u0430\u0435\u043C \u0438\u0445 \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0443. \u042F \u0441\u0447\u0438\u0442\u0430\u044E, \u044D\u0442\u043E \u0441\u0442\u043E\u044F\u0449\u0430\u044F \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u044F.",
  "fall_Sun": "\u0417\u0434\u0435\u0441\u044C \u0435\u0441\u0442\u044C \u043C\u043D\u043E\u0433\u043E \u043C\u0435\u0441\u0442, \u0433\u0434\u0435 \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0433\u0443\u043B\u044F\u0442\u044C\u0441\u044F.#$e#\u041F\u0440\u0438\u044F\u0442\u043D\u043E \u0431\u044B\u0432\u0430\u0435\u0442 \u0440\u0430\u0437\u043C\u044F\u0442\u044C \u043D\u043E\u0433\u0438.",
  "fall_Sun4": "\u041C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u043D\u0440\u0430\u0432\u044F\u0442\u0441\u044F \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0435 \u0432\u043E\u0434\u043E\u043F\u0430\u0434\u044B \u0414\u043E\u043B\u0438\u043D\u044B.#$e#\u0422\u0435\u0431\u0435 \u0434\u043E\u0432\u043E\u0434\u0438\u043B\u043E\u0441\u044C \u043F\u043E\u0434\u043E\u043B\u0433\u0443 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043D\u0430 \u043D\u0438\u0445? \u0422\u0430\u043A \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u043B\u044F\u0435\u0442...",
  "winter_Mon": "\u041C\u043D\u0435 \u0442\u0430\u043A \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F, \u043A\u0430\u043A \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u0432\u0441\u0435 \u0432\u043E\u043A\u0440\u0443\u0433, \u043F\u043E\u043A\u0440\u044B\u0442\u043E\u0435 \u0441\u0432\u0435\u0436\u0438\u043C \u0441\u043D\u0435\u0436\u043A\u043E\u043C.",
  "winter_Tue": "\u0412 \u043C\u043E\u0435\u043C \u0434\u043E\u043C\u0438\u043A\u0435 \u0431\u044B\u0432\u0430\u0435\u0442 \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u043B\u043E\u0434\u043D\u043E.$s#$e#\u042F \u043F\u0440\u043E\u0441\u0442\u043E \u0443\u043A\u0443\u0442\u044B\u0432\u0430\u044E\u0441\u044C \u0432 \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0435 \u043E\u0434\u0435\u044F\u043B\u043E, \u0438 \u043C\u043D\u0435 \u0445\u043E\u0440\u043E\u0448\u043E.$h",
  "winter_Wed": "\u0423\u0442\u0440\u043E\u043C \u044F \u0432\u0438\u0434\u0435\u043B\u0430 \u0441\u043D\u0435\u0436\u043D\u043E\u0433\u043E \u043A\u0440\u043E\u043B\u0438\u043A\u0430! \u041E\u043D\u0438 \u0432\u0435\u0434\u044C \u0440\u0435\u0434\u043A\u0438\u0435, \u0434\u0430?",
  "winter_Thu": "\u041C\u043D\u0435 \u0441\u0442\u0430\u043B\u043E \u0441\u043B\u043E\u0436\u043D\u043E \u0438\u0441\u043A\u0430\u0442\u044C \u0441\u0435\u0431\u0435 \u0440\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E \u043F\u0438\u0449\u0443.#$e#\u041F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0435\u0441\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435 \u0445\u043B\u0435\u0431\u0430.$s",
  "winter_Thu6": "\u042D\u0445... \u0417\u0438\u043C\u043E\u0439 \u0441\u043B\u043E\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438 \u0441\u0435\u0431\u0435 \u0440\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E \u043F\u0438\u0449\u0443.#$e#\u0410 \u0443 \u0442\u0435\u0431\u044F \u043D\u0430 \u0444\u0435\u0440\u043C\u0435 \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430 \u0441\u0435\u0439\u0447\u0430\u0441 \u043F\u0440\u0438\u043F\u0430\u0441\u0435\u043D\u0430 \u043A\u0443\u0447\u0430 \u0435\u0434\u044B, \u0434\u0430?",
  "winter_Fri": "\u0412\u0440\u0435\u043C\u044F \u0437\u0434\u0435\u0441\u044C \u0431\u0443\u0434\u0442\u043E \u0438\u0434\u0435\u0442 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435.#$e#\u041A\u043E\u0433\u0434\u0430 \u044F \u0436\u0438\u043B\u0430 \u0432 \u0433\u043E\u0440\u043E\u0434\u0435, \u0432\u0440\u0435\u043C\u044F \u043B\u0435\u0442\u0435\u043B\u043E \u0442\u0430\u043A \u0431\u044B\u0441\u0442\u0440\u043E.",
  "winter_Fri6": "\u0422\u0435\u0431\u0435 \u043D\u0435 \u0431\u044B\u0432\u0430\u0435\u0442 \u0445\u043E\u043B\u043E\u0434\u043D\u043E \u0434\u043E\u043C\u0430?#$e#\u0417\u0430\u0445\u043E\u0434\u0438 \u043A\u043E \u043C\u043D\u0435, \u0435\u0441\u043B\u0438 \u0437\u0430\u0445\u043E\u0447\u0435\u0448\u044C \u043F\u043E\u0441\u0438\u0434\u0435\u0442\u044C \u0441\u043E \u043C\u043D\u043E\u0439 \u043F\u043E\u0434 \u043F\u043B\u0435\u0434\u043E\u043C \u0438 \u0432\u044B\u043F\u0438\u0442\u044C \u0441\u0438\u0434\u0440\u0443.$h",
  "winter_Sat": "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439. \u0422\u0435\u0431\u0435 \u0447\u0442\u043E-\u0442\u043E \u043D\u0443\u0436\u043D\u043E?",
  "winter_Sat2": "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439, @. \u0422\u044B \u0445\u043E\u0447\u0435\u0448\u044C \u0447\u0442\u043E-\u0442\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u044C?",
  "winter_Sun": "\u0423 \u0442\u0435\u0431\u044F \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u0432\u044B\u0434\u0430\u0432\u0430\u043B\u0441\u044F \u0446\u0435\u043B\u044B\u0439 \u0432\u044B\u0445\u043E\u0434\u043D\u043E\u0439 \u0434\u0435\u043D\u044C?#$e#\u0422\u0430\u043A\u0430\u044F \u043F\u0435\u0440\u0435\u0434\u044B\u0448\u043A\u0430 \u0445\u043E\u0440\u043E\u0448\u043E \u043E\u0441\u0432\u0435\u0436\u0430\u0435\u0442.",
  "winter_Sun4": "\u0418\u043D\u043E\u0433\u0434\u0430 \u043D\u0443\u0436\u043D\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0431\u0440\u0430\u0442\u044C \u0432\u044B\u0445\u043E\u0434\u043D\u043E\u0439 \u043D\u0430 \u0446\u0435\u043B\u044B\u0439 \u0434\u0435\u043D\u044C.#$b#\u042D\u0442\u043E \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0445\u043E\u0440\u043E\u0448\u043E \u0434\u043B\u044F \u0434\u0443\u0448\u0438, \u043D\u043E \u0438 \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442 \u0442\u0432\u043E\u044E \u0440\u0430\u0431\u043E\u0442\u043E\u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C!"
}