{
  "Rainy_Day_0": "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043A\u0430\u043A \u0434\u0435\u043B\u0430 \u0443 \u041F\u0435\u043D\u043D\u0438? \u041C\u043E\u0436\u0435\u0442, \u043F\u043E\u0437\u0432\u043E\u043D\u044E \u0435\u0439 \u0441\u0435\u0433\u043E\u0434\u043D\u044F.",
  "Rainy_Day_1": "\u042F \u0442\u0443\u0442 \u0440\u0430\u0437\u043C\u0435\u0447\u0442\u0430\u043B\u0430\u0441\u044C... \u041A\u0430\u043A \u0434\u0443\u043C\u0430\u0435\u0448\u044C, \u0441 \u041C\u0430\u0440\u0418\u041B\u042C\u0414\u043E\u0439 \u0432\u0441\u0435 \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435? \u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u043E\u043D\u0430 \u043D\u0430\u0439\u0434\u0435\u0442 \u0441\u0435\u0431\u0435 \u043C\u0435\u0441\u0442\u043E...",
  "Rainy_Day_2": "\u041F\u0440\u0438\u0432\u0435\u0442! \u041C\u043D\u0435 \u0432\u0447\u0435\u0440\u0430 \u043F\u043B\u043E\u0445\u043E \u0441\u043F\u0430\u043B\u043E\u0441\u044C, \u0442\u0430\u043A \u0447\u0442\u043E \u044F \u043F\u043E\u0432\u043E\u0437\u0438\u043B\u0430\u0441\u044C \u0443 \u0441\u0435\u0431\u044F \u0432 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u043E\u0439. \u0414\u0435\u0440\u0436\u0438, \u044F \u0441\u0434\u0435\u043B\u0430\u043B\u0430 \u044D\u0442\u043E \u0434\u043B\u044F \u0442\u0435\u0431\u044F.[688 369 338 325 287]#$e#\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0442\u0435\u0431\u0435 \u044D\u0442\u043E \u0433\u0434\u0435-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F.",
  "Rainy_Day_3": "\u0412 \u0434\u043E\u0436\u0434\u0435 \u043C\u043D\u0435 \u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u043D\u043E \u2014 \u043D\u0435\u043B\u044C\u0437\u044F \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043D\u0430 \u0437\u0432\u0435\u0437\u0434\u044B!",
  "Rainy_Day_4": "\u041C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0438\u043B\u0438 \u044F \u0441\u043B\u044B\u0448\u0430\u043B\u0430, \u0447\u0442\u043E \u0443 \u043D\u0430\u0441 \u043A\u0440\u044B\u0448\u0430 \u0442\u0435\u0447\u0435\u0442? \u041D\u0443\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C. \u042F \u043A\u043E\u0435-\u0447\u0435\u043C\u0443 \u043D\u0430\u0443\u0447\u0438\u043B\u0430\u0441\u044C, \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u044F \u0437\u0430 \u043C\u0430\u0442\u0435\u0440\u044C\u044E.",
  "Rainy_Night_0": "\u0421\u043C\u043E\u0442\u0440\u0438 \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u044C \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B \u043F\u043E\u0434 \u0434\u043E\u0436\u0434\u0435\u043C! \u041E\u043D\u0438 \u043C\u043E\u0433\u0443\u0442 \u0441\u043E\u0432\u0441\u0435\u043C \u0437\u0430\u0440\u0436\u0430\u0432\u0435\u0442\u044C.",
  "patio_Maru": "\u042F \u0435\u0449\u0435 \u043D\u0435 \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u044D\u0442\u043E \u0431\u0443\u0434\u0435\u0442... \u041F\u0440\u043E\u0441\u0442\u043E \u0438\u043D\u043E\u0433\u0434\u0430 \u0432\u0435\u0441\u0435\u043B\u043E \u043F\u043E\u0432\u043E\u0437\u0438\u0442\u044C\u0441\u044F \u0441\u043E \u0441\u0442\u0430\u0440\u044B\u043C \u043A\u043B\u044E\u0447\u043E\u043C.",
  "Rainy_Night_1": "\u041F\u0440\u0438\u0432\u0435\u0442, @. \u041A\u0430\u043A \u043F\u0440\u043E\u0448\u0435\u043B \u0434\u0435\u043D\u044C... \u041C\u043E\u043A\u0440\u043E?#$e#\u042D\u0442\u0430 \u043F\u043E\u0433\u043E\u0434\u0430 \u0434\u0430\u0435\u0442 \u043C\u043D\u0435 \u0438\u0434\u0435\u0438 \u0434\u043B\u044F \u0438\u0437\u043E\u0431\u0440\u0435\u0442\u0435\u043D\u0438\u0439... \u041C\u043E\u0436\u0435\u0442, \u0435\u0441\u043B\u0438 \u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0434\u043E\u0436\u0434\u0435\u0432\u0443\u044E \u0432\u043E\u0434\u0443 \u0447\u0435\u0440\u0435\u0437 \u0432\u043E\u0440\u043E\u043D\u043A\u0443, \u043E\u043D\u0430 \u0431\u0443\u0434\u0435\u0442 \u043A\u0440\u0443\u0442\u0438\u0442\u044C \u043C\u0435\u043B\u044C\u043D\u0438\u0446\u0443?",
  "Rainy_Night_2": "\u041E\u0442\u0435\u0446 \u043E\u0442\u0441\u043B\u0435\u0436\u0438\u0432\u0430\u0435\u0442 \u043F\u043E\u0433\u043E\u0434\u043D\u044B\u0435 \u0437\u0430\u043A\u043E\u043D\u043E\u043C\u0435\u0440\u043D\u043E\u0441\u0442\u0438 \u0432\u043E\u0442 \u0443\u0436\u0435 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043B\u0435\u0442.#$e#\u0421\u0435\u0439\u0447\u0430\u0441 \u0435\u0449\u0435 \u0440\u0430\u043D\u043E \u043E \u0447\u0435\u043C-\u0442\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0442\u043E\u0447\u043D\u043E, \u043D\u043E \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u043D\u0430 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0430\u043D\u043E\u043C\u0430\u043B\u044C\u043D\u044B\u0435 \u0442\u0435\u043D\u0434\u0435\u043D\u0446\u0438\u0438.",
  "Rainy_Night_3": "\u041C\u043E\u0436\u043D\u043E, \u043C\u044B \u0431\u0443\u0434\u0435\u043C \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0435\u0441\u0442\u044C \u0441\u043F\u0430\u0433\u0435\u0442\u0442\u0438 \u0432 \u043F\u043E\u0441\u0442\u0435\u043B\u0438?",
  "Rainy_Night_4": "\u042F \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u043B\u0430 \u0434\u0435\u0441\u0435\u0440\u0442! \u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u0437\u0430\u0431\u0443\u0434\u044C \u043F\u043E\u0447\u0438\u0441\u0442\u0438\u0442\u044C \u0437\u0443\u0431\u044B \u043F\u0435\u0440\u0435\u0434 \u0441\u043D\u043E\u043C. [232 234 223 220]$h",
  "Rainy_Night_5": "\u0414\u0435\u043D\u044C \u0443 \u043C\u0435\u043D\u044F \u0431\u044B\u043B \u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0439... \u042F \u0441\u0438\u0434\u0435\u043B\u0430 \u0434\u043E\u043C\u0430 \u0438\u0437-\u0437\u0430 \u043F\u043E\u0433\u043E\u0434\u044B.#$e#\u0417\u0430\u0442\u043E \u0431\u044B\u043B\u043E \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E. \u042F \u0440\u0435\u0448\u0438\u043B\u0430 \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u0438\u0442\u044C\u0441\u044F, \u043F\u043E\u0447\u0438\u0442\u044B\u0432\u0430\u044F \u00AB\u0421\u0445\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0435\u0436\u0435\u043D\u0435\u0434\u0435\u043B\u044C\u043D\u0438\u043A\u00BB.",
  "Indoor_Day_0": "\u0425\u043C\u043C? \u041F\u0440\u043E\u0441\u0442\u0438, \u044F \u0438\u043D\u043E\u0433\u0434\u0430 \u0442\u0430\u043A \u0433\u043B\u0443\u0431\u043E\u043A\u043E \u0437\u0430\u0434\u0443\u043C\u044B\u0432\u0430\u044E\u0441\u044C \u043E \u0441\u0432\u043E\u0435\u043C, \u0447\u0442\u043E \u043D\u0435 \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u043F\u043E\u043D\u0438\u043C\u0430\u044E, \u0447\u0442\u043E \u044F \u0432\u043E\u043E\u0431\u0449\u0435 \u0434\u0435\u043B\u0430\u044E.",
  "Indoor_Day_1": "\u042F \u043D\u0430\u0448\u043B\u0430 \u044D\u0442\u043E \u0443 \u0441\u0435\u0431\u044F \u0432 \u043A\u0443\u0447\u0435 \u043C\u0435\u0442\u0430\u043B\u043B\u043E\u043B\u043E\u043C\u0430. \u041C\u043E\u0436\u0435\u0442, \u0442\u0435\u0431\u0435 \u0433\u0434\u0435-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F? [286 287 205 732]",
  "Indoor_Day_2": "\u041D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E, \u043C\u044B \u043E\u0431\u0430 \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0438\u0441\u044C! \u042F \u0442\u0430\u043A \u043F\u0440\u043E\u0433\u043E\u043B\u043E\u0434\u0430\u043B\u0430\u0441\u044C... *\u0411\u0443\u0440\u0447\u0430\u043D\u0438\u0435*$h",
  "Indoor_Day_3": "\u041E\u0434\u043D\u043E \u0438\u0437 \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432 \u0436\u0438\u0437\u043D\u0438 \u043D\u0430 \u0444\u0435\u0440\u043C\u0435 \u2014 \u043F\u0440\u043E\u0441\u044B\u043F\u0430\u0442\u044C\u0441\u044F \u043F\u043E\u0434 \u0445\u043E\u0440 \u043F\u0435\u0432\u0447\u0438\u0445 \u043F\u0442\u0438\u0447\u0435\u043A.",
  "Indoor_Day_4": "\u041A\u0430\u043A \u0442\u044B \u0434\u0435\u0440\u0436\u0438\u0448\u044C \u0440\u0443\u043A\u0438 \u0442\u0430\u043A\u0438\u043C\u0438 \u043C\u044F\u0433\u043A\u0438\u043C\u0438 \u043F\u043E\u0441\u043B\u0435 \u0432\u0441\u0435\u0439 \u044D\u0442\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B \u043D\u0430 \u0444\u0435\u0440\u043C\u0435?",
  "Indoor_Night_0": "\u0422\u0435\u0431\u0435 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0431\u044B\u043B\u043E \u0432\u0438\u0434\u043D\u043E \u043B\u0443\u043D\u0443? \u041E\u043D\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u0442\u0430\u043A \u044D\u0444\u0444\u0435\u043A\u0442\u043D\u043E \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043D\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435.",
  "Indoor_Night_1": "\u042F \u0442\u0443\u0442 \u0432\u0438\u0434\u0435\u043B\u0430 \u043F\u0430\u0434\u0430\u044E\u0449\u0443\u044E \u0437\u0432\u0435\u0437\u0434\u0443. \u041C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u0434\u0443\u043C\u0430\u0442\u044C, \u0431\u0443\u0434\u0442\u043E \u044D\u0442\u043E \u041C\u0430\u0440\u0418\u041B\u042C\u0414\u0410 \u0440\u0435\u0448\u0438\u043B\u0430 \u0437\u0430\u0433\u043B\u044F\u043D\u0443\u0442\u044C \u043A \u043D\u0430\u043C.$h",
  "Indoor_Night_2": "\u041D\u0435 \u043C\u043E\u0433\u0443 \u0440\u0435\u0448\u0438\u0442\u044C, \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u043C\u043D\u0435 \u0448\u043E\u043A\u043E\u043B\u0430\u0434\u043D\u043E\u0433\u043E \u0442\u043E\u0440\u0442\u0430 \u0438\u043B\u0438 \u0441\u043F\u0435\u043B\u043E\u0439 \u043A\u043B\u0443\u0431\u043D\u0438\u043A\u0438. \u041C\u043E\u0436\u0435\u0442, \u0438 \u0442\u043E\u0433\u043E, \u0438 \u0434\u0440\u0443\u0433\u043E\u0433\u043E?..#$e#\u0421\u043A\u0430\u0436\u0438 \u0447\u0435\u0441\u0442\u043D\u043E... \u042F \u043D\u0430\u0431\u0438\u0440\u0430\u044E \u0432\u0435\u0441?$s",
  "Indoor_Night_3": "\u0422\u044B \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0442\u0440\u0443\u0434\u0438\u0448\u044C\u0441\u044F \u043D\u0435 \u043F\u043E\u043A\u043B\u0430\u0434\u0430\u044F \u0440\u0443\u043A! \u041E\u0441\u0442\u0430\u0432\u0448\u0438\u0439\u0441\u044F \u0432\u0435\u0447\u0435\u0440 \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u0437\u0430\u0441\u043B\u0443\u0436\u0435\u043D\u043D\u043E \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C.",
  "Indoor_Night_4": "\u041C\u043D\u0435 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u043D\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F \u044D\u0442\u043E\u0442 \u0441\u0442\u0430\u0440\u044B\u0439 \u0434\u043E\u043C\u0438\u043A. \u041D\u043E\u0447\u0430\u043C\u0438 \u0442\u0443\u0442 \u0442\u0430\u043A \u0443\u044E\u0442\u043D\u043E.#$e#\u041C\u0430\u043C\u0430 \u0445\u043E\u0440\u043E\u0448\u043E \u043D\u0430\u0434 \u043D\u0438\u043C \u043F\u043E\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430.$h",
  "Outdoor_0": "\u0410\u0445... \u041D\u0430 \u0444\u0435\u0440\u043C\u0435 \u0442\u0430\u043A \u0437\u0434\u043E\u0440\u043E\u0432\u043E \u043F\u0430\u0445\u043D\u0435\u0442, \u043F\u0440\u044F\u043C\u043E \u043A\u0430\u043A \u0432 \u0433\u043E\u0440\u0430\u0445 \u0443 \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0433\u043E \u0434\u043E\u043C\u0430.",
  "Outdoor_1": "\u0415\u0441\u043B\u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u0432\u0441\u0435 \u0440\u0430\u0441\u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C, \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E \u0440\u0430\u0431\u043E\u0442\u044B \u043D\u0430 \u0444\u0435\u0440\u043C\u0435 \u043C\u043E\u0436\u043D\u043E \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C, \u0430 \u043F\u043E\u0442\u043E\u043C \u043F\u0440\u043E\u0441\u0442\u043E \u043E\u0442\u0434\u044B\u0445\u0430\u0442\u044C!",
  "Outdoor_2": "\u041D\u0435\u0431\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0431\u0443\u0434\u0435\u0442 \u0447\u0438\u0441\u0442\u044B\u043C... \u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u0431\u0443\u0434\u0435\u0442 \u043B\u0438 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u0438\u0434\u043D\u043E \u0441\u043E\u0437\u0432\u0435\u0437\u0434\u0438\u0435 %noun?",
  "Outdoor_3": "\u041D\u0435 \u0432\u043E\u043B\u043D\u0443\u0439\u0441\u044F, \u0435\u0441\u043B\u0438 \u0437\u0430\u0442\u0430\u0449\u0438\u0448\u044C \u0433\u0440\u044F\u0437\u044C \u0432 \u0434\u043E\u043C, \u044F \u043D\u0435 \u0431\u0443\u0434\u0443 \u0437\u043B\u0438\u0442\u044C\u0441\u044F. \u0418\u043D\u043E\u0433\u0434\u0430 \u043C\u043E\u0436\u043D\u043E \u0438 \u0437\u0430\u043F\u0430\u0447\u043A\u0430\u0442\u044C\u0441\u044F \u043D\u0435\u043C\u043D\u043E\u0433\u043E.",
  "Outdoor_4": "\u042F \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u0438 \u043D\u0435 \u0434\u0443\u043C\u0430\u043B\u0430 \u043E \u0442\u043E\u043C, \u043A\u0430\u043A \u043C\u043D\u043E\u0433\u043E \u043D\u0443\u0436\u043D\u043E \u0437\u0430\u0431\u043E\u0442\u044B \u0438 \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F, \u0447\u0442\u043E\u0431\u044B \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C\u0441\u044F \u0441 \u0444\u0435\u0440\u043C\u043E\u0439! \u042D\u0442\u043E \u043E\u0447\u0435\u043D\u044C \u043F\u043E\u0445\u043E\u0436\u0435 \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0443 \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438.",
  "OneKid_0": "\u041A\u0430\u043A \u0442\u0430\u043C %kid1, \u0432\u044B \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043F\u043E\u0438\u0433\u0440\u0430\u043B\u0438? \u0414\u0435\u0442\u044F\u043C \u043D\u0443\u0436\u043D\u043E \u0443\u0434\u0435\u043B\u044F\u0442\u044C \u0432\u0440\u0435\u043C\u044F \u043D\u0430 \u0438\u0433\u0440\u044B, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u044C \u0438\u0445 \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B.",
  "OneKid_1": "\u041A\u0430\u043A \u0434\u0443\u043C\u0430\u0435\u0448\u044C... %kid1 \u0432\u044B\u0440\u0430\u0441\u0442\u0435\u0442 \u0444\u0435\u0440\u043C\u0435\u0440\u043E\u043C? \u0418\u043B\u0438 \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u043E\u043C?",
  "OneKid_3": "\u0423 \u043C\u0435\u043D\u044F \u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u043D\u0430\u0434\u0435\u0436\u0434\u044B \u043D\u0430 \u0431\u0443\u0434\u0443\u0449\u0435\u0435 \u043D\u0430\u0448\u0435\u0433\u043E \u0440\u0435\u0431\u0435\u043D\u043A\u0430. \u042F \u0432\u0441\u0435 \u0447\u0438\u0442\u0430\u044E \u0432\u0441\u0435 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0435 \u043D\u0430\u0443\u0447\u043D\u044B\u0435 \u0434\u0430\u043D\u043D\u044B\u0435 \u043E \u0442\u043E\u043C, \u043A\u0430\u043A \u043B\u0443\u0447\u0448\u0435 \u0432\u043E\u0441\u043F\u0438\u0442\u044B\u0432\u0430\u0442\u044C \u0434\u0435\u0442\u0435\u0439.",
  "TwoKids_3": "\u041B\u0438\u0447\u043D\u0430\u044F \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F, \u0434\u0432\u043E\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u0434\u0435\u0442\u0435\u0439 \u0438 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u0443\u0447\u0430\u0441\u0442\u043E\u043A. \u0416\u0438\u0437\u043D\u044C \u0445\u043E\u0440\u043E\u0448\u0430.",
  "Good_1": "\u0422\u0435\u043F\u0435\u0440\u044C, \u043A\u043E\u0433\u0434\u0430 \u043C\u044B \u0436\u0438\u0432\u0435\u043C \u0432\u043C\u0435\u0441\u0442\u0435, \u0441\u043B\u043E\u0436\u043D\u043E \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0436\u0438\u0437\u043D\u044C \u0441\u043D\u043E\u0432\u0430 \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u0435.",
  "Good_2": "\u041E\u0442\u0434\u044B\u0445\u0430\u0435\u0448\u044C? \u042D\u0442\u043E \u0445\u043E\u0440\u043E\u0448\u043E!",
  "Good_3": "\u0412 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438 \u0444\u0435\u0440\u043C\u043E\u0439 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u043C\u043D\u043E\u0433\u043E \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0438 \u0438 \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F. \u042D\u0442\u043E \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u0431\u043E\u043B\u0435\u0435 \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u044B\u0439 \u0443\u043C\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439 \u0442\u0440\u0443\u0434, \u0447\u0435\u043C \u044F \u0434\u0443\u043C\u0430\u043B\u0430!",
  "Good_4": "\u041A\u043E\u0433\u0434\u0430-\u0442\u043E \u044F \u043F\u043E\u0434\u0443\u043C\u044B\u0432\u0430\u043B\u0430 \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u0441\u0435\u0431\u0435 \u0440\u043E\u0431\u043E\u0442\u0430-${\u043C\u0443\u0436\u0430^\u0436\u0435\u043D\u0443}$. \u041D\u043E \u0442\u044B \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u043B\u0443\u0447\u0448\u0435!$h",
  "Good_5": "\u042F \u0442\u0443\u0442 \u043B\u044E\u0431\u0443\u044E\u0441\u044C \u0441\u0432\u0430\u0434\u0435\u0431\u043D\u044B\u043C \u0430\u043C\u0443\u043B\u0435\u0442\u043E\u043C... \u0420\u0430\u043A\u0443\u0448\u043A\u0430 \u0431\u0435\u0437\u0443\u043F\u0440\u0435\u0447\u043D\u0430\u044F. \u041E\u0447\u0435\u043D\u044C \u0440\u0435\u0434\u043A\u0438\u0439 \u044D\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440!$l",
  "Good_6": "\u0412\u0447\u0435\u0440\u0430 \u043C\u043D\u0435 \u043F\u0440\u0438\u0441\u043D\u0438\u043B\u043E\u0441\u044C, \u0431\u0443\u0434\u0442\u043E \u044F \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0430 \u0432 \u0433\u0438\u0433\u0430\u043D\u0442\u0441\u043A\u0438\u0439 \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F. \u042F \u0432\u0438\u0434\u0435\u043B\u0430, \u043A\u0430\u043A \u0432 \u0442\u0443\u043C\u0430\u043D\u043D\u043E\u0441\u0442\u0438 %noun \u0447\u0442\u043E-\u0442\u043E \u0434\u0432\u0438\u0433\u0430\u043B\u043E\u0441\u044C. \u0416\u0443\u0442\u043A\u043E\u0432\u0430\u0442\u043E.",
  "Neutral_0": "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u044F \u0431\u0443\u0434\u0443 \u0442\u0435\u0431\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F, \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u044F \u043D\u0430\u0431\u0435\u0440\u0443 \u0432\u0435\u0441.",
  "Neutral_8": "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0443 \u043C\u0435\u043D\u044F \u043D\u0435\u0442 \u0432\u0434\u043E\u0445\u043D\u043E\u0432\u0435\u043D\u0438\u044F.$s",
  "funLeave_Maru": "\u041F\u043E\u0436\u0430\u043B\u0443\u0439, \u043D\u0430\u0432\u0435\u0449\u0443 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0435\u0439. \u0414\u0430\u0432\u043D\u0435\u043D\u044C\u043A\u043E \u0438\u0445 \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0430.",
  "funReturn_Maru": "\u0423 \u043C\u0430\u043C\u044B \u0441 \u043F\u0430\u043F\u043E\u0439 \u0432\u0441\u0435 \u0445\u043E\u0440\u043E\u0448\u043E. \u0420\u0430\u0441\u043F\u043E\u0440\u044F\u0434\u043E\u043A \u0434\u043D\u044F \u0432\u0441\u0435 \u0442\u043E\u0442 \u0436\u0435, \u0445\u043E\u0442\u044F \u043C\u0435\u043D\u044F \u0438 \u043D\u0435\u0442 \u0440\u044F\u0434\u043E\u043C. \u0410 \u0442\u0432\u043E\u0439 \u0434\u0435\u043D\u044C \u043A\u0430\u043A \u043F\u0440\u043E\u0448\u0435\u043B?",
  "spring_2": "\u041A\u0430\u043A\u0430\u044F \u0443 \u043D\u0430\u0441 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044F \u043F\u043E \u043E\u043F\u0442\u0438\u043C\u0438\u0437\u0430\u0446\u0438\u0438 \u0440\u0430\u0431\u043E\u0442\u044B \u0444\u0435\u0440\u043C\u044B \u0432 \u044D\u0442\u043E\u043C \u0433\u043E\u0434\u0443?",
  "spring_1": "\u0427\u0443\u0434\u0435\u0441\u043D\u043E \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u044C \u0437\u0430 \u0442\u0435\u043C, \u043A\u0430\u043A \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F \u0438 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0442\u0441\u044F \u043A \u0436\u0438\u0437\u043D\u0438 \u0432\u0435\u0441\u043D\u043E\u0439.",
  "spring_22": "\u0415\u0441\u043B\u0438 \u0431\u044B \u043C\u043E\u0439 \u0431\u0440\u0430\u0442 \u043D\u0435 \u0431\u044B\u043B \u0442\u0430\u043A\u0438\u043C \u043E\u0442\u0448\u0435\u043B\u044C\u043D\u0438\u043A\u043E\u043C, \u044F \u0431\u044B \u043F\u0440\u0438\u0433\u043B\u0430\u0441\u0438\u043B\u0430 \u0435\u0433\u043E \u043A \u043D\u0430\u043C \u043D\u0430 \u0443\u0436\u0438\u043D.",
  "summer_20": "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043C\u043E\u0439 \u0431\u0440\u0430\u0442 \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u043D\u0430\u0431\u0435\u0440\u0435\u0442\u0441\u044F \u0441\u043C\u0435\u043B\u043E\u0441\u0442\u0438 \u043F\u043E\u0437\u0432\u0430\u0442\u044C \u0410\u0431\u0438\u0433\u0435\u0439\u043B \u043D\u0430 \u0441\u0432\u0438\u0434\u0430\u043D\u0438\u0435?",
  "summer_2": "\u042F \u043B\u044E\u0431\u043B\u044E \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C \u043A\u0430\u0442\u0430\u043B\u043E\u0433 \u0432\u0441\u0435\u0445 \u043D\u0430\u0441\u0435\u043A\u043E\u043C\u044B\u0445, \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u044F \u0432\u0438\u0434\u0435\u043B\u0430 \u0437\u0430 \u043B\u0435\u0442\u043E.",
  "fall_1": "\u0421 \u043A\u0430\u0436\u0434\u044B\u043C \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C \u0433\u043E\u0434\u0430 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u0430\u044F \u043E\u0431\u043B\u0430\u0441\u0442\u044C \u043D\u043E\u0447\u043D\u043E\u0433\u043E \u043D\u0435\u0431\u0430 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u044F\u0440\u0447\u0435. \u041F\u043E\u0442\u0440\u044F\u0441\u0430\u044E\u0449\u0438\u0439 \u043F\u0440\u043E\u0446\u0435\u0441\u0441.",
  "fall_25": "\u0417\u0438\u043C\u0430 \u0441\u043E\u0432\u0441\u0435\u043C \u0441\u043A\u043E\u0440\u043E. \u041D\u0443\u0436\u043D\u043E \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043E\u0442\u043E\u043F\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E \u0441\u0438\u0441\u0442\u0435\u043C\u0443, \u0437\u0430\u043A\u0440\u044B\u0442\u044C \u0432\u0435\u043D\u0442\u0438\u043B\u0438 \u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0442\u0435\u043F\u043B\u043E\u0438\u0437\u043E\u043B\u044F\u0446\u0438\u044E \u0432 \u0434\u043E\u043C\u0435.#$e#\u041D\u0435 \u0432\u043E\u043B\u043D\u0443\u0439\u0441\u044F, \u043B\u044E\u0431\u043E\u0432\u044C \u043C\u043E\u044F. \u042F \u0441\u0430\u043C\u0430 \u0441\u043E \u0432\u0441\u0435\u043C \u044D\u0442\u0438\u043C \u0440\u0430\u0437\u0431\u0435\u0440\u0443\u0441\u044C.",
  "fall_3": "\u041E\u0441\u0435\u043D\u044C \u0432\u0441\u0435\u0433\u0434\u0430 \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442 \u043C\u043D\u0435 \u043E \u0442\u043E\u043C, \u043A\u0430\u043A \u043C\u044B \u0441 \u043C\u0430\u043C\u043E\u0439 \u0445\u043E\u0434\u0438\u043B\u0438 \u0437\u0430 \u0434\u0435\u0440\u0435\u0432\u043E\u043C... \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u044D\u0442\u043E \u0432\u0441\u0435 \u0437\u0430\u043F\u0430\u0445 \u0441\u0432\u0435\u0436\u0435\u0441\u0440\u0443\u0431\u043B\u0435\u043D\u043D\u043E\u0433\u043E \u0434\u0435\u0440\u0435\u0432\u0430 \u0438 \u0434\u0440\u0435\u0432\u0435\u0441\u043D\u043E\u0433\u043E \u0441\u043E\u043A\u0430.",
  "winter_15": "\u0417\u0438\u043C\u044B \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0432\u0440\u0435\u043C\u044F \u043F\u0443\u0433\u0430\u044E\u0449\u0435 \u043C\u044F\u0433\u043A\u0438\u0435.",
  "winter_5": "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0443 \u043F\u0430\u043F\u044B \u0432\u0441\u0435 \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435... \u0417\u0438\u043C\u043E\u0439 \u0435\u043C\u0443 \u0438\u043D\u043E\u0433\u0434\u0430 \u0431\u044B\u0432\u0430\u0435\u0442 \u0433\u0440\u0443\u0441\u0442\u043D\u043E, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0437\u0438\u043C\u043E\u0439 \u043C\u0435\u043D\u044C\u0448\u0435 \u043F\u043E\u0432\u043E\u0434\u043E\u0432 \u0434\u043B\u044F \u043F\u043E\u043B\u0435\u0432\u044B\u0445 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439.",
  "winter_2": "\u041A\u0430\u043A\u0438\u0435 \u0443 \u0442\u0435\u0431\u044F \u043F\u043B\u0430\u043D\u044B \u043F\u043E \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u044E \u043D\u0430\u0448\u0435\u0433\u043E \u0431\u044E\u0434\u0436\u0435\u0442\u0430 \u044D\u0442\u043E\u0439 \u0437\u0438\u043C\u043E\u0439?#$e#\u041C\u043E\u0436\u043D\u043E \u0437\u0430\u043D\u044F\u0442\u044C\u0441\u044F \u0440\u044B\u0431\u0430\u043B\u043A\u043E\u0439 \u0438\u043B\u0438 \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\u043C...#$e#\u0415\u0441\u043B\u0438 \u0441\u043E\u0431\u0435\u0440\u0435\u0448\u044C\u0441\u044F \u0432 \u0448\u0430\u0445\u0442\u0443, \u0431\u0443\u0434\u044C \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u0435\u0435.",
  "spring_Maru": "\u042F \u0441 \u043D\u0435\u0442\u0435\u0440\u043F\u0435\u043D\u0438\u0435\u043C \u0436\u0434\u0443 \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0433\u043E \u0433\u043E\u0434\u0430 \u043D\u0430 \u0444\u0435\u0440\u043C\u0435, @!$h",
  "summer_Maru": "\u0412\u0435\u0447\u0435\u0440\u0430 \u0442\u0430\u043A\u0438\u0435 \u0442\u0435\u043F\u043B\u044B\u0435. \u0421\u0435\u0439\u0447\u0430\u0441 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043B\u0443\u0447\u0448\u0435\u0435 \u0432\u0440\u0435\u043C\u044F, \u0447\u0442\u043E\u0431\u044B \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043D\u0430 \u0437\u0432\u0435\u0437\u0434\u044B. \u041A\u0430\u043A \u0437\u043D\u0430\u0442\u044C, \u0447\u0442\u043E \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438 \u0442\u0430\u043C, \u043D\u0430\u0432\u0435\u0440\u0445\u0443?",
  "fall_Maru": "\u0416\u0438\u0437\u043D\u044C \u043D\u0430 \u0444\u0435\u0440\u043C\u0435 \u043E\u0442\u043B\u0438\u0447\u043D\u0430\u044F, \u043D\u043E \u044F \u0440\u0430\u0434\u0430, \u0447\u0442\u043E \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u0440\u0430\u0431\u043E\u0442\u0430\u044E \u0432 \u043A\u043B\u0438\u043D\u0438\u043A\u0435. \u042D\u0442\u043E \u0432\u0430\u0436\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430 \u043D\u0430 \u0431\u043B\u0430\u0433\u043E \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430.",
  "winter_Maru": "\u042F \u043F\u0440\u0435\u0434\u0432\u043A\u0443\u0448\u0430\u044E \u043F\u0438\u0440\u043E\u0433 \u0441 \u0440\u0435\u0432\u0435\u043D\u0435\u043C \u044D\u0442\u043E\u0439 \u0432\u0435\u0441\u043D\u043E\u0439. \u0410\u0445, \u043A\u0430\u043A\u0430\u044F \u043A\u0438\u0441\u043B\u0438\u043D\u043A\u0430, \u043A\u0430\u043A\u043E\u0439 \u0432\u043A\u0443\u0441!",
  "spouseRoom_Maru": "#$c .5#\u042F \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u0441\u0442\u0430\u043B\u0430 \u043F\u043E\u0440\u0430\u043D\u044C\u0448\u0435, \u0447\u0442\u043E\u0431\u044B \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043D\u0430 \u0437\u0432\u0435\u0437\u0434\u044B.#$e#\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0442\u044B \u043D\u0435 \u0432\u043E\u0437\u0440\u0430\u0436\u0430\u0435\u0448\u044C, \u0435\u0441\u043B\u0438 \u044F \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0443\u0434\u0435\u043B\u044E \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0441\u0432\u043E\u0438\u043C \u043F\u0440\u043E\u0435\u043A\u0442\u0430\u043C, \u043C\u043E\u044F \u0440\u0430\u0434\u043E\u0441\u0442\u044C."
}