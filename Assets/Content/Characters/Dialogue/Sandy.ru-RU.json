{
  "accept_866": "\u0420\u043E\u0437\u0430 \u0414\u043E\u043B\u0438\u043D\u044B \u0421\u0442\u0430\u0440\u0434\u044C\u044E? \u042D\u0442\u043E \u0442\u0430\u043A \u043C\u0438\u043B\u043E! \u0421\u043F\u0430\u0441\u0438\u0431\u043E!$h#$b#\u041A\u0430\u043A \u0442\u043E\u043B\u044C\u043A\u043E \u044F \u0437\u0430\u0441\u043A\u0443\u0447\u0430\u044E \u043F\u043E \u0414\u043E\u043B\u0438\u043D\u0435, \u0442\u043E \u0441\u0440\u0430\u0437\u0443 \u043F\u043E\u043D\u044E\u0445\u0430\u044E \u0435\u0435. \u0425\u0435-\u0445\u0435.$h#$b#\u0412\u043E\u0442, \u0432\u043E\u0437\u044C\u043C\u0438. \u042D\u0442\u0430 \u0432\u0435\u0449\u044C \u0441\u0442\u043E\u0438\u0442 \u043D\u0430 \u0432\u0438\u0442\u0440\u0438\u043D\u0435 \u0443\u0436\u0435 \u043B\u0435\u0442 \u0434\u0435\u0441\u044F\u0442\u044C, \u0438 \u043D\u0438\u043A\u0442\u043E \u0435\u0435 \u0442\u0430\u043A \u0438 \u043D\u0435 \u043A\u0443\u043F\u0438\u043B. \u041C\u043E\u0436\u0435\u0448\u044C \u0437\u0430\u0431\u0440\u0430\u0442\u044C \u0441\u0435\u0431\u0435!",
  "AcceptGift_(O)18": "\u0423\u0445 \u0442\u044B! \u041D\u0430\u0440\u0446\u0438\u0441\u0441 \u0414\u043E\u043B\u0438\u043D\u044B \u0421\u0442\u0430\u0440\u0434\u044C\u044E \u2014 \u044F\u0432\u043D\u044B\u0439 \u043F\u0440\u0438\u0437\u043D\u0430\u043A \u0432\u0435\u0441\u043D\u044B!$h",
  "AcceptGift_(O)StardropTea": "\u0423\u0445 \u0442\u044B, \u0432\u043E\u0442 \u044D\u0442\u043E \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u044C... \u041F\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043D\u0435 \u043C\u043E\u0433\u0443, \u0447\u0442\u043E \u0442\u044B \u0434\u0430\u0440\u0438\u0448\u044C \u044D\u0442\u043E \u043C\u043D\u0435. \u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u043B\u044E\u0431\u043E\u0432\u044C \u043C\u043E\u044F!",
  "AcceptGift_(O)418": "\u0410\u0445... \u0412 \u0414\u043E\u043B\u0438\u043D\u0435 \u0421\u0442\u0430\u0440\u0434\u044C\u044E \u0434\u0430\u0436\u0435 \u0437\u0438\u043C\u043E\u0439 \u0435\u0441\u0442\u044C \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0435 \u0446\u0432\u0435\u0442\u044B.",
  "GreenRain": "\u0421\u043B\u044B\u0448\u0430\u043B\u0430, \u0432 \u0414\u043E\u043B\u0438\u043D\u0435 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442 \u043A\u0430\u043A\u043E\u0435-\u0442\u043E \u0440\u0435\u0434\u043A\u043E\u0435 \u043F\u043E\u0433\u043E\u0434\u043D\u043E\u0435 \u044F\u0432\u043B\u0435\u043D\u0438\u0435.#$e#\u0412\u043E\u0442 \u0431\u044B \u0442\u0443\u0442 \u0442\u043E\u0436\u0435 \u0438\u043D\u043E\u0433\u0434\u0430 \u0448\u0435\u043B \u0434\u043E\u0436\u0434\u044C...$s",
  "married_Emily": "\u041A\u0430\u043A \u043F\u0440\u043E\u0448\u043B\u043E \u0442\u043E\u0440\u0436\u0435\u0441\u0442\u0432\u043E? \u042D\u043C\u0438\u043B\u0438 \u043D\u0435 \u0442\u0430\u043A \u0434\u0430\u0432\u043D\u043E \u0437\u0430\u0445\u043E\u0434\u0438\u043B\u0430 \u0438 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B\u0430 \u043E \u0442\u0432\u043E\u0438\u0445 \u043F\u043B\u0430\u043D\u0430\u0445.#$b#\u041A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u0432\u0441\u0435 \u0436\u0435 \u0437\u0430\u0433\u043B\u044F\u043D\u0443 \u043A \u0432\u0430\u043C \u043D\u0430 \u0444\u0435\u0440\u043C\u0443!",
  "AcceptGift_(O)402": "*\u043D\u044E\u0445*... \u041C-\u043C-\u043C... \u0414\u0443\u0448\u0438\u0441\u0442\u044B\u0439 \u0433\u043E\u0440\u043E\u0448\u0435\u043A \u0442\u0430\u043A \u0432\u043A\u0443\u0441\u043D\u043E \u043F\u0430\u0445\u043D\u0435\u0442.",
  "Mon": "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439-\u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439, \u0434\u0443\u0448\u0435\u0447\u043A\u0430!#$b#\u042F \u0442\u0430\u043A \u0440\u0430\u0434\u0430, \u0447\u0442\u043E \u0430\u0432\u0442\u043E\u0431\u0443\u0441 \u0441\u043D\u043E\u0432\u0430 \u0445\u043E\u0434\u0438\u0442. \u041C\u043D\u0435 \u0437\u0434\u0435\u0441\u044C \u0441\u0442\u0430\u043B\u043E \u0442\u0430\u043A \u043E\u0434\u0438\u043D\u043E\u043A\u043E.#$e#... \u042F \u0447\u0443\u0442\u044C \u043D\u0435 \u0440\u0430\u0437\u043E\u0440\u0438\u043B\u0430\u0441\u044C.$s#$e#\u042D\u0439, \u043D\u043E \u0442\u0435\u043F\u0435\u0440\u044C-\u0442\u043E \u0442\u044B \u0437\u0434\u0435\u0441\u044C, \u043A\u0443\u043F\u0438\u0448\u044C \u0446\u0435\u043B\u0443\u044E \u043A\u0443\u0447\u0443 \u0441\u0435\u043C\u044F\u043D... \u041F\u0440\u0430\u0432\u0434\u0430, \u0434\u0443\u0448\u0435\u0447\u043A\u0430?$h",
  "Tue": "\u0421\u043D\u0430\u0440\u0443\u0436\u0438 \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438 \u043A\u043E\u043A\u043E\u0441\u044B \u0438 \u043F\u043B\u043E\u0434\u044B \u043A\u0430\u043A\u0442\u0443\u0441\u043E\u0432. \u0411\u0435\u0440\u0438 \u0441\u0442\u043E\u043B\u044C\u043A\u043E, \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u043C\u043E\u0436\u0435\u0448\u044C \u0443\u043D\u0435\u0441\u0442\u0438.#$e#\u041E\u043D\u0438 \u0435\u0449\u0435 \u0438 \u043E\u0439 \u043A\u0430\u043A\u0438\u0435 \u0432\u043A\u0443\u0441\u043D\u044B\u0435. \u0425\u0438-\u0438-\u0438!~$h",
  "Wed": "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439! \u0415\u0441\u043B\u0438 \u0432\u0434\u0440\u0443\u0433 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0448\u044C \u0432 \u0433\u043E\u0440\u043E\u0434\u0435 \u043C\u043E\u044E \u043F\u043E\u0434\u0440\u0443\u0436\u043A\u0443 \u042D\u043C\u0438\u043B\u0438, \u043F\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0439 \u0435\u0439 \u043F\u0440\u0438\u0432\u0435\u0442, \u043B\u0430\u0434\u043D\u043E?#$e#\u0421\u043F\u0430\u0441\u0438\u0431\u043E!$h",
  "Thu": "\u0422\u043E\u0442 \u043F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0442\u0438\u043F? \u041C\u043D\u0435 \u043D\u0435 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043E \u043E\u0431 \u044D\u0442\u043E\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C.#$e#\u041D\u0443 \u043B\u0430\u0434\u043D\u043E... \u041A\u0430\u043A \u043F\u043E\u0433\u043E\u0434\u043A\u0430-\u0442\u043E \u0432 \u0434\u043E\u043B\u0438\u043D\u0435?",
  "Fri": "\u0417\u0434\u0435\u0441\u044C \u0431\u044B \u0443 \u0442\u0435\u0431\u044F \u0441 \u0444\u0435\u0440\u043C\u043E\u0439 \u043D\u0435 \u0437\u0430\u043B\u0430\u0434\u0438\u043B\u043E\u0441\u044C, \u0434\u0443\u0448\u0435\u0447\u043A\u0430.#$e#\u0420\u0430\u0437\u0432\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u0430\u043A\u0442\u0443\u0441\u044B \u0440\u0430\u0437\u0432\u043E\u0434\u0438\u0442\u044C.$h",
  "Sat": "\u041F\u0440\u0438\u0432\u0435\u0442! \u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C \u0432 \u00AB\u041E\u0430\u0437\u0438\u0441 \u0421\u044D\u043D\u0434\u0438\u00BB, \u043C\u0430\u0433\u0430\u0437\u0438\u043D \u043D\u043E\u043C\u0435\u0440 \u043E\u0434\u0438\u043D \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u0435 \u041A\u0430\u043B\u0438\u043A\u043E!#$e#*\u0428\u0435\u043F\u043E\u0442\u043E\u043C* \u041D\u0443 \u043A\u0430\u043A, \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E \u043F\u0440\u043E\u0437\u0432\u0443\u0447\u0430\u043B\u043E?$h#$e#\u041D\u0435 \u0437\u0430\u0431\u0443\u0434\u044C \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043D\u0430\u0448 \u0441\u0435\u0437\u043E\u043D\u043D\u044B\u0439 \u0430\u0441\u0441\u043E\u0440\u0442\u0438\u043C\u0435\u043D\u0442 \u0441\u0435\u043C\u044F\u043D.#$e#\u0422\u044B, \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0447\u0435\u0448\u044C \u043F\u0438\u0442\u044C. \u0412\u043E\u0442, \u0434\u0435\u0440\u0436\u0438 \u043B\u0435\u0434\u044F\u043D\u043E\u0433\u043E \u043C\u043E\u043B\u043E\u043A\u0430. [184]#$e#\u0412\u043A\u0443\u0441\u043D\u043E, \u0434\u0430?$h",
  "Sun": "\u0417\u0434\u0435\u0441\u044C \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u043E, \u0434\u0430\u0436\u0435 \u0437\u0438\u043C\u043E\u0439!#$e#\u041D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435, \u0442\u0443\u0442 \u0434\u0430\u0436\u0435 \u0434\u043B\u044F \u043C\u0435\u043D\u044F \u0436\u0430\u0440\u043A\u043E\u0432\u0430\u0442\u043E... \u041C\u043E\u044F \u043D\u0435\u0436\u043D\u0430\u044F \u043A\u043E\u0436\u0430 \u043B\u0435\u0433\u043A\u043E \u043E\u0431\u0433\u043E\u0440\u0430\u0435\u0442 \u043D\u0430 \u0441\u043E\u043B\u043D\u0446\u0435.$s",
  "Thu2": "\u0422\u043E\u0442 \u043F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0442\u0438\u043F? \u041C\u043D\u0435 \u043D\u0435 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043E \u043E\u0431 \u044D\u0442\u043E\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C.#$e#\u041D\u0443 \u043B\u0430\u0434\u043D\u043E... \u041A\u0430\u043A \u043F\u043E\u0433\u043E\u0434\u043A\u0430-\u0442\u043E \u0432 \u0434\u043E\u043B\u0438\u043D\u0435?",
  "Thu4": "\u0425\u0435\u0439. \u0414\u0443\u043C\u0430\u044E, \u044F \u043C\u043E\u0433\u0443 \u0442\u0435\u0431\u0435 \u0434\u043E\u0432\u0435\u0440\u044F\u0442\u044C. \u0422\u044B \u0432\u0435\u0434\u044C \u0443\u043C\u0435\u0435\u0448\u044C \u0445\u0440\u0430\u043D\u0438\u0442\u044C \u0441\u0435\u043A\u0440\u0435\u0442\u044B, \u0434\u0430?#$b#*\u0428\u0435\u043F\u043E\u0442\u043E\u043C* \u0422\u043E\u0442 \u0442\u0438\u043F... \u041E\u043D \u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442 \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u044D\u043A\u0441\u043A\u043B\u044E\u0437\u0438\u0432\u043D\u044B\u0439 \u043A\u043B\u0443\u0431. \u0421\u0430\u043C\u0430 \u044F \u0432\u043D\u0443\u0442\u0440\u0438 \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0431\u044B\u043B\u0430, \u043D\u043E \u043C\u043D\u0435 \u043F\u043B\u0430\u0442\u044F\u0442 \u0449\u0435\u0434\u0440\u0443\u044E \u0430\u0440\u0435\u043D\u0434\u0443 \u043A\u0430\u0436\u0434\u044B\u0439 \u043C\u0435\u0441\u044F\u0446, \u0442\u0430\u043A \u0447\u0442\u043E \u044F \u043D\u0435 \u0437\u0430\u0434\u0430\u044E \u043B\u0438\u0448\u043D\u0438\u0445 \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432.#$e#\u041D\u0443 \u0442\u0430\u043A \u0432\u043E-\u043E-\u043E-\u043E-\u043E\u0442! \u041A\u0430\u043A \u0442\u0430\u043C \u043F\u043E\u0433\u043E\u0434\u043A\u0430-\u0442\u043E \u0432 \u0434\u043E\u043B\u0438\u043D\u0435 \u0421\u0442\u0430\u0440\u0434\u044C\u044E?",
  "Fri4": "\u041D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435, \u043C\u0435\u043D\u044F \u0437\u043E\u0432\u0443\u0442 \u043D\u0435 \u0421\u044D\u043D\u0434\u0438, \u0437\u043D\u0430\u0435\u0448\u044C \u043B\u0438. \u042D\u0442\u043E \u0438\u043C\u044F \u043B\u0443\u0447\u0448\u0435 \u0437\u0432\u0443\u0447\u0438\u0442 \u0434\u043B\u044F \u0431\u0438\u0437\u043D\u0435\u0441\u0430.#$e#\u041D\u043E \u043C\u0435\u043D\u044F \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E \u0432\u0441\u0435 \u0437\u043E\u0432\u0443\u0442 \u0421\u044D\u043D\u0434\u0438, \u0442\u0430\u043A \u0447\u0442\u043E \u044F \u043F\u0440\u0438\u0432\u044B\u043A\u043B\u0430.",
  "Wed8": "\u0420\u0430\u0437\u0432\u0435 \u043D\u0435 \u0434\u043E\u0440\u043E\u0433\u043E \u0442\u0430\u043A \u0447\u0430\u0441\u0442\u043E \u0435\u0437\u0434\u0438\u0442\u044C \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u044E?#$e#\u0422\u044B, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0447\u0435\u0448\u044C \u043C\u0435\u043D\u044F \u0443\u0432\u0438\u0434\u0435\u0442\u044C, \u0434\u0430? \u0425\u043C-\u043C... $h||*\u0432\u0437\u0434\u044B\u0445\u0430\u0435\u0442*... \u042F \u0438 \u043F\u0440\u0430\u0432\u0434\u0430 \u0441\u043A\u0443\u0447\u0430\u044E \u043F\u043E \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u043C \u0446\u0432\u0435\u0442\u0430\u043C \u0414\u043E\u043B\u0438\u043D\u044B \u0421\u0442\u0430\u0440\u0434\u044C\u044E...$s",
  "Sun8": "\u041F\u0440\u0438\u0432\u0435\u0442, \u0441\u043E\u043B\u043D\u0446\u0435. \u0414\u0430, \u044D\u0442\u043E \u0441\u043D\u043E\u0432\u0430 \u044F, \u043E\u0434\u043D\u0430 \u0432 \u044D\u0442\u043E\u043C \u0431\u043E\u043B\u044C\u0448\u043E\u043C \u0438 \u0441\u0442\u0430\u0440\u043E\u043C \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435. \u0425\u043C-\u043C-\u043C...#$e#\u041D\u0443, \u043A\u0440\u043E\u043C\u0435 \u0442\u043E\u0433\u043E \u0436\u0443\u0442\u043A\u043E\u0433\u043E \u0442\u0438\u043F\u0430. \u041D\u043E \u043E\u043D \u0434\u0430\u0436\u0435 \u043D\u0435 \u0448\u0435\u0432\u0435\u043B\u0438\u0442\u0441\u044F, \u0442\u0430\u043A \u0447\u0442\u043E \u044F \u0447\u0430\u0441\u0442\u043E \u0437\u0430\u0431\u044B\u0432\u0430\u044E, \u0447\u0442\u043E \u043E\u043D \u0432\u043E\u043E\u0431\u0449\u0435 \u0442\u0443\u0442 \u0435\u0441\u0442\u044C.",
  "Wed10": "\u042D\u0439, \u0434\u0430 \u044D\u0442\u043E \u0436\u0435 @! \u042F \u0442\u0430\u043A \u0440\u0430\u0434\u0430 \u0442\u0435\u0431\u044F \u0432\u0438\u0434\u0435\u0442\u044C. \u042F \u0443\u0436\u0435 \u0431\u044B\u043B\u043E \u043F\u043E\u0434\u0443\u043C\u0430\u043B\u0430, \u0447\u0442\u043E \u0442\u044B \u043D\u0435 \u0432\u0435\u0440\u043D\u0435\u0448\u044C\u0441\u044F!#$e#\u0415\u0441\u043B\u0438 \u0431\u044B \u0442\u043E\u043B\u044C\u043A\u043E \u043C\u043D\u0435 \u043D\u0435 \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435, \u044F \u0431\u044B \u0441\u044A\u0435\u0437\u0434\u0438\u043B\u0430 \u0441 \u0442\u043E\u0431\u043E\u0439 \u0432 \u0434\u043E\u043B\u0438\u043D\u0443 \u043D\u0430 \u0434\u0435\u043D\u0435\u043A-\u0434\u0440\u0443\u0433\u043E\u0439... \u0422\u043E\u043B\u044C\u043A\u043E \u0442\u044B \u0438 \u044F \u043D\u0430 \u0441\u0442\u0430\u0440\u043E\u0439 \u0444\u0435\u0440\u043C\u0435.$s#$e#\u0422\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E \u043D\u0430\u0432\u0435\u0449\u0430\u0442\u044C \u043C\u0435\u043D\u044F \u043F\u043E\u0447\u0430\u0449\u0435, \u0447\u0442\u043E\u0431\u044B \u044F \u043D\u0435 \u0433\u0440\u0443\u0441\u0442\u0438\u043B\u0430.$h",
  "Tue10": "\u041F\u0440\u0438\u0432\u0435\u0442!~ \u041E\u0441\u0442\u0430\u0432\u0430\u0439\u0441\u044F \u0437\u0434\u0435\u0441\u044C \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0437\u0430\u0445\u043E\u0447\u0435\u0448\u044C.#$e#\u041A\u043E\u043D\u0434\u0438\u0446\u0438\u043E\u043D\u0435\u0440 \u2014 \u044D\u0442\u043E \u0442\u0430\u043A \u0437\u0434\u043E\u0440\u043E\u0432\u043E, \u043F\u0440\u0430\u0432\u0434\u0430?"
}