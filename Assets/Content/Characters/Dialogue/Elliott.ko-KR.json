  "Sun6": "\uC624, @! \uB124\uAC00 \uB4F1\uC7A5\uD558\uAE38 \uBC14\uB77C\uACE0 \uC788\uC5C8\uC5B4.#$e#\uB108\uB97C \uBCF4\uB294 \uAC74 \uC5B8\uC81C\uB77C\uB3C4 \uAE30\uC05C \uC77C\uC774\uC57C.$h",
  "event_idea1": "\uBBF8\uC2A4\uD130\uB9AC\uBB3C? \uD655\uC2E4\uD788 \uD765\uBBF8\uC9C4\uC9C4\uD55C \uC7A5\uB974\uC9C0. \uAE30\uC5B5\uD574\uB458\uAC8C.",
  "event_idea2": "\uC544, \uADF8 \uC7A5\uB974\uB294 \uACE0\uC804\uC774\uC9C0. \uAE30\uC5B5\uD574\uB458\uAC8C.",
  "event_idea3": "\uC0C1\uC0C1\uB3C4 \uBABB\uD588\uC5B4! \uC81C\uC77C \u0022\uC9C0\uAD6C\u0022\uC5D0 \uAC00\uAE4C\uC6B4 \uC9C1\uC5C5\uB3C4 \uC2DC\uC120\uC774 \uBCC4\uC744 \uD5A5\uD560 \uB54C\uAC00 \uC788\uB098 \uBCF4\uB124.$h#$b#\uAE30\uC5B5\uD574\uB458\uAC8C.",
  "event_boat1": "... \uB124\uAC00 \uB2E4\uB978 \uB0A8\uC790\uC5D0 \uB300\uD574 \uC774\uB7F0 \uAC10\uC815\uC774 \uC5C6\uC744\uAE4C \uBD10 \uAC71\uC815\uD588\uC5C8\uC5B4.$l^\uB098\uB3C4 \uADF8\uB798.$l",
  "event_boat2": "\uC624! \uB108\uBB34 \uBBF8\uC548\uD574.$8%fork",
  "event_toast1": "\uC74C...\uADF8\uB798.#$b#@\uC744(\uB97C) \uC704\uD558\uC5EC!",
  "event_toast2": "\uC815\uB9D0 \uAD1C\uCC2E\uC740 \uC0DD\uAC01\uC774\uB2E4!$h#$b#\uC6B0\uB9AC\uB97C \uC704\uD558\uC5EC!",
  "event_toast3": "\uD750\uC74C...\uC544\uB0D0, \uB410\uC5B4.$a",
  "event_toast4": "\uC544, \uACF5\uB3D9\uCCB4\uC758 \uC870\uD654\uB85C\uC6B4 \uBBF8\uB798\uB97C \uC704\uD558\uC5EC... \uACE0\uACB0\uD55C \uC0DD\uAC01\uC774\uC57C.#$b#\uD3A0\uB9AC\uCEE8 \uB9C8\uC744\uC744 \uC704\uD558\uC5EC!",
  "summer_Mon": "\uC624\uB298 \uC544\uCE68\uC5D0 \uC791\uACE0 \uC628\uD654\uD55C \uD587\uBE5B \uD55C \uAC00\uB2E5\uC774 \uB098\uB97C \uAE68\uC6E0\uC5B4. \uC774\uD1A0\uB85D \uC0C1\uCF8C\uD55C \uAE30\uBD84\uC774 \uB4E0 \uC801\uC774 \uC5C6\uC5B4.$u#$e#\uADF8\uB2E4\uC9C0 \uC7AC\uBC0C\uB294 \uC598\uAE30\uB294 \uC544\uB2C8\uB77C \uBBF8\uC548\uD574.",
  "summer_Mon4": "\uB098\uB3C4 \uB0B4\uAC00 \uC880 \u0027\uAD34\uC9DC\u0027\uB77C\uB294 \uAC74 \uC54C\uC544.#$e#\uB108\uB294 \uADF8\uB807\uAC8C \uAC1C\uC758\uCE58 \uC54A\uC558\uC73C\uBA74 \uC88B\uACA0\uC5B4.$h",
  "summer_Mon6": "@, \uB124\uAC00 \uB0B4 \uC791\uAC00\uB85C\uC11C\uC758 \uB2A5\uB825\uC744 \uBBFF\uACE0 \uC788\uB2E4\uB294 \uAC78 \uC54C\uC544. \uB098\uD55C\uD14C\uB294 \uADF8\uAC8C \uC815\uB9D0 \uC758\uBBF8\uAC00 \uCEE4.$h",
  "summer_Tue": "\uC9D1 \uC55E\uC5D0\uC11C \uC544\uB984\uB2E4\uC6B4 \uAECD\uB370\uAE30\uB97C \uAC00\uB054 \uBD24\uC5B4.#$e#\uBA87\uBA87 \uD76C\uADC0\uD55C \uC885\uB958\uB294 \uAF64 \uAC00\uCE58\uAC00 \uC788\uC744 \uAC83\uC774\uB77C \uC0DD\uAC01\uD574.",
  "summer_Tue6": "\uB09C \uC2DC\uAC04\uACFC \uACF5\uAC04\uC744 \uCD08\uC6D4\uD574\uC11C \uC0AC\uB78C\uB4E4\uACFC \uD1B5\uD558\uACE0 \uC2F6\uC740 \uD76C\uB9DD\uC5D0 \uAE00\uC744 \uC368.$u#$e#*\uD55C\uC228*...\uC2DC\uB300\uAC00 \uBCC0\uD558\uACE0 \uC788\uC5B4, \uADFC\uB370. \uC0AC\uB78C\uB4E4\uC774 \uC608\uC804\uB9CC\uD07C \uCC45\uC744 \uC77D\uC9C0 \uC54A\uC544.$s",
  "summer_Wed": "\uC528\uC557\uBD80\uD130 \uCD94\uC218\uD560 \uB54C\uAE4C\uC9C0 \uC791\uBB3C\uC744 \uBCF4\uB294 \uAC74 \uCC38 \uB9CC\uC871\uC2A4\uB7EC\uC6B4 \uC77C\uC778 \uAC83 \uAC19\uC544.#$e#\uB9C8\uCE58 \uB124 \uC815\uAE30\uAC00 \uADF8 \uACFC\uC77C\uC5D0 \uC2A4\uBA70\uB4DC\uB294 \uAC83\uCC98\uB7FC.$u",
  "summer_Thu": "\uC624 \uC774\uB7F0! \uC2E0\uBC1C\uC5D0 \uBAA8\uB798\uAC00 \uAC00\uB4DD\uD558\uC796\uC544.$s#$e#\uD574\uBCC0\uC5D0 \uC0B4\uBA74 \uC774\uB7F0 \uBB38\uC81C\uAC00 \uC788\uC9C0.",
  "summer_Fri": "@? \uBCF5\uC7A1\uD574 \uBCF4\uC5EC.#$b#\uC5EC\uB984 \uACF5\uAE30\uAC00 \uB354\uC6CC\uC11C \uC880 \uC5B4\uC9C0\uB7EC\uC6B8 \uC218\uB3C4 \uC788\uACA0\uB2E4.",
  "summer_Sat": "\uC624\uB298\uC740 \uD574\uAC00 \uD654\uB0AC\uB124... \uC720\uAC10\uC2A4\uB7FD\uAC8C\uB3C4, \uB0B4 \uD53C\uBD80\uAC00 \uC880 \uB9CE\uC774 \uBBFC\uAC10\uD55C \uD3B8\uC774\uC57C.",
  "summer_Sun": "\uB098\uB791 \uC598\uAE30\uD558\uB7EC \uC5EC\uAE30\uAE4C\uC9C0 \uC654\uC5B4? \uCE5C\uC808\uD55C\uAC78.$h",
  "summer_Sun4": "\uC6D0\uD558\uBA74 \uC5B8\uC81C\uB4E0\uC9C0 \uB0B4 \uC624\uB450\uB9C9\uC5D0 \uB180\uB7EC \uC640. \uC190\uB2D8\uC774 \uC624\uBA74 \uB098\uB3C4 \uC88B\uC544.$h",
  "fall_Mon": "\uC548\uB155 @.#$e#\uC77C\uB3C4 \uB54C\uB54C\uB85C \uC26C\uBA74\uC11C \uD574\uC57C \uD574.",
  "fall_Mon4": "\uC77C\uC744 \uC7A0\uC2DC \uC26C\uC5B4\uC57C\uACA0\uB2E4\uB294 \uAE30\uBD84\uC774 \uB4E4\uBA74 \uB0A0 \uBCF4\uB7EC \uC640.$h#$e#\uB09C \uC8FC\uB85C \uB0B4 \uC9D1\uC5D0 \uC788\uC5B4.",
  "fall_Tue": "\uC18C\uBB38\uC5D0 \uC758\uD558\uBA74 \uC57D\uD0C8\uD55C \uAE08\uC73C\uB85C \uAC00\uB4DD\uD55C \uD574\uC801\uC120\uC774 \uC624\uB798\uC804\uC5D0 \uC5EC\uAE30\uC5D0 \uB09C\uD30C\uB418\uC5C8\uB2E4\uACE0 \uD574.",
  "GreenRain": "\uB2E4\uB4E4 \uCD08\uC870\uD574\uD558\uC9C0 \uB9D9\uC2DC\uB2E4... \uAC70\uC2A4! \uBAA8\uB450 \uC9C4\uC815\uD558\uC790\uB294 \uC758\uBBF8\uB85C \uD55C \uC794\uC529 \uD569\uC2DC\uB2E4!%noturn",
  "GreenRain_2": "\uC544, \uACC4\uACE1\uC5D0\uC11C \uD3BC\uCCD0\uC9C0\uB294 \uB610 \uD558\uB098\uC758 \uD2B9\uBCC4\uD55C \uD558\uB8E8\uB124. \uC790\uADF9\uC801\uC774\uC57C!",
  "fall_Tue8": "@, \uC548 \uADF8\uB798\uB3C4 \uB124 \uC0DD\uAC01 \uD558\uACE0 \uC788\uC5C8\uC5B4.$l#$e#\uB124\uAC00 \uADF8\uAC78 \uAC10\uC9C0\uD55C \uAC78\uC9C0\uB3C4.$h#$e#\uC790! \uC624\uB298 \uD558\uB8E8 \uC5B4\uB560\uC5B4?",
  "fall_Wed8": "\uB18D\uC7A5 \uC77C\uC744 \uD574\uBCF4\uB294 \uAC83\uB3C4 \uAD1C\uCC2E\uC744 \uAC83 \uAC19\uC544.#$e#\uB18D\uC7A5\uC758 \uC870\uC6A9\uD55C \uBD84\uC704\uAE30\uAC00 \uBB38\uD559\uC801\uC778 \uC601\uAC10\uC758 \uC88B\uC740 \uADFC\uC6D0\uC774 \uB420 \uC218 \uC788\uC744 \uC218\uB3C4 \uC788\uC9C0, \uC548 \uADF8\uB798?$h",
  "fall_Thu": "\uC624 \uC774\uB7F0! \uC791\uC740 \uAC8C\uAC00 \uB0B4 \uC154\uCE20 \uC8FC\uBA38\uB2C8\uB97C \uC0C8\uB85C\uC6B4 \uC9D1\uC73C\uB85C \uC0BC\uC558\uB098 \uBCF4\uB124.$l#$e#\uD574\uBCC0\uC5D0 \uC0B4\uBA74 \uC774\uB7F0 \uBB38\uC81C\uAC00 \uC788\uC9C0.",
  "fall_Fri4": "\uBC24\uC0C8 \uCC45\uC0C1\uC5D0 \uC549\uC544\uC11C \uAE00\uC744 \uC37C\uB354\uB2C8 \uB2E4\uB9AC\uAC00 \uBEE3\uBEE3\uD574.$s#$e#\uAC00\uB054\uC740 \uB124\uAC00 \uBD80\uB7FD\uB2E4, @.",
  "fall_Fri": "\uC544\uCE68 \uB0B4\uB0B4 \uCC45\uC0C1\uC5D0 \uC549\uC544\uC788\uC5C8\uB354\uB2C8 \uB2E4\uB9AC\uAC00 \uBEE3\uBEE3\uD574.$s",
  "fall_Fri10": "@, \uB124\uAC00 \uADFC\uCC98\uC5D0 \uC788\uC73C\uBA74... \uD3C9\uC18C\uBCF4\uB2E4 \uB354 \uCC3D\uC758\uB825\uC774 \uBC1C\uC0B0\uB418\uB294\uB4EF\uD55C \uAE30\uBD84\uC774 \uB4E4\uC5B4.$l#$e#\uC54C\uC544... \uC774\uC0C1\uD558\uC9C0\uB9CC, \uC0AC\uC2E4\uC778\uAC78.",
  "fall_Sat": "\uC77C \uB144 \uC911 \uC774\uB9D8\uB54C\uBA74 \uBC14\uB78C\uC774 \uB9CE\uC774 \uBD88\uC9C0. \uD6CC\uB96D\uD574!$h",
  "fall_Sun": "\uC624\uB298 \uD654\uBD84\uC5D0 \uAF2D \uBB3C\uC744 \uC8FC\uB294 \uAC78 \uAE30\uC5B5\uD574\uC57C\uC9C0. \uC774\uBC88\uC5D4 \uBC14\uB2F7\uBB3C\uC744 \uC4F0\uC9C0 \uC54A\uC744 \uAC70\uC57C!",
  "winter_Mon": "\uC774 \uCD94\uC6B4 \uB0A0\uC528\uC5D0 \uB098\uB97C \uBCF4\uB7EC \uC640\uC900 \uAC70\uC57C?#$e#\uB098\uB3C4 \uB0B4 \uC678\uB85C\uC6B4 \uC77C\uB85C\uBD80\uD130 \uD55C\uC228 \uB3CC\uB824\uC57C\uC9C0.",
  "winter_Mon4": "@, \uB0A0 \uBC29\uBB38\uD574\uC8FC\uB7EC \uB208\uC744 \uB6AB\uACE0 \uD130\uB35C\uD130\uB35C \uAC78\uC5B4\uC628 \uAC70\uC57C?#$e#\uC601\uAD11\uC778\uAC78!$h",
  "winter_Tue": "\uC778\uB958\uB294 \uBC14\uB2E4\uC5D0\uC11C \uC5BB\uC740 \uAC83\uB4E4\uB85C \uC218\uCC9C \uB144 \uB3D9\uC548 \uC0B6\uC744 \uC774\uB904 \uC654\uC9C0.#$e#\uB09C \uADF8\uB0E5 \uC2DD\uB8CC\uD488\uC810\uC5D0\uC11C \uC0AC \uBA39\uC5B4.$s",
  "winter_Tue10": "@, \uC624\uB298 \uB108\uB97C \uBCFC \uAC70\uB77C\uB294 \uAE30\uBD84\uC774 \uB4E4\uC5C8\uC5B4.#$e#\uC5B4\uCA4C\uBA74 \uC6B0\uB9B0 \uCD08\uC790\uC5F0\uC801\uC778 \uC2E4\uB85C \uC774\uC5B4\uC838\uC788\uB294 \uAC78\uC9C0\uB3C4.$l",
  "-winter_Wed": "\uC0C1\uC0C1\uC758 \uB098\uB798\uB97C \uD3BC\uCE58\uB2E4 \uBCF4\uBA74 \uD558\uB8E8\uAC00 \uC9C0\uB8E8\uD560 \uD2C8\uC774 \uC5C6\uC9C0.$u#$e#\uBBF8\uC548, \uB0B4\uAC00 \uD130\uBB34\uB2C8\uC5C6\uB294 \uB9D0\uB85C \uD6A1\uC124\uC218\uC124\uD558\uB294 \uAC74\uAC00?",
  "winter_Thu": "\uC228\uC744 \uAE4A\uC774 \uB4E4\uC774\uB9C8\uC154\uBD10. \uB290\uAEF4\uC838? \uBC14\uB2E4\uC758 \uB0C4\uC0C8\uC57C.#$e#\uC5B4\uB5A4 \uAE30\uBD84\uC774 \uB4E4\uC5B4?",
  "winter_Thu6": "\uC228\uC744 \uAE4A\uC774 \uB4E4\uC774\uB9C8\uC154\uBD10. \uB290\uAEF4\uC838? \uBC14\uB2E4\uC758 \uB0C4\uC0C8\uC57C.#$e#\uB09C \uBC14\uB2E4 \uB0C4\uC0C8\uB97C \uB9E1\uC744 \uB54C\uB9C8\uB2E4, \uC5B4\uB9B4 \uB54C\uAC00 \uC0DD\uAC01\uB098. \uC5B4\uB838\uC744 \uB54C \uBC14\uB2E4\uB294 \uB0B4\uAC8C \uC815\uB9D0 \uC778\uC0C1 \uAE4A\uC5C8\uAC70\uB4E0.",
  "winter_Fri": "\uBA38\uB9AC\uB97C \uB9E4\uC77C \uBE57\uC9C0 \uC54A\uC73C\uBA74, \uC9C0\uC800\uBD84\uD558\uAC8C \uBB49\uCCD0.#$e#\uC77C\uC774 \uB9CE\uC9C0.#$e#\uB0B4\uAC00 \uC21C\uAC04\uC801\uC778 \uAC10\uC815\uC5D0 \uC0AC\uB85C\uC7A1\uD600 \uB2E4 \uBC00\uC5B4\uBC84\uB9AC\uC9C0 \uC54A\uC740 \uAC8C \uB180\uB77C\uC6CC.$h#$e#\uB0B4\uAC00 \uB108\uBB34 \uD5C8\uC601\uC2EC\uC774 \uB9CE\uC740\uAC00 \uBD10.",
  "winter_Sat": "\uC694\uC998 \uBC16\uC5D0 \uB098\uAC00\uAE34 \uB108\uBB34 \uCD94\uC6CC\uC11C, \uC2E4\uB0B4\uC5D0\uC11C \uC870\uAE08\uC529 \uC6B4\uB3D9\uD558\uACE0 \uC788\uC5B4.#$e#\uC624\uB450\uB9C9 \uC548\uC774 \uB108\uBB34 \uC2B5\uD558\uB2E4\uBA74 \uBBF8\uC548\uD574.$s",
  "winter_Sun": "\uC624\uB298\uC740 \uC815\uB9D0 \uB9C8\uB8FB\uBC14\uB2E5\uC744 \uBC85\uBC85 \uBB38\uC9C8\uB7EC\uC11C \uCCAD\uC18C\uD574\uC57C\uACA0\uC5B4. \uC870\uB958\uAC00 \uC790\uB77C\uAE30 \uC2DC\uC791\uD558\uB294 \uAC83 \uAC19\uC544.$s#$e#\uB108\uB294 \uCCAD\uC18C\uD560 \uC2DC\uAC04\uC744 \uB530\uB85C \uB0B4\uB294 \uD3B8\uC774\uC57C?"
