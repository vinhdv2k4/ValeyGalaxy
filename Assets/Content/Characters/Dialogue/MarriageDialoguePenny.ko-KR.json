{
  "Rainy_Day_0": "\uBE44\uAC00 \uC624\uB294 \uB0A0\uC774\uBA74 \uC2DC\uB098\uBAAC\uD558\uACE0 \uCFE0\uD0A4 \uC0DD\uAC01\uC774 \uB098\uC694.",
  "Rainy_Day_1": "\uB9C8\uB8E8\uB791 \uD558\uBE44 \uC120\uC0DD\uB2D8\uC774\uB791 \uC0AC\uADC0\uAC8C \uB418\uB824\uB098? \uD558\uBE44\uAC00 \uB9C8\uB8E8\uB97C \uC88B\uC544\uD558\uACE0 \uC788\uB2E4\uACE0 \uD655\uC2E0\uD574\uC694...#$e#\uD558\uC9C0\uB9CC \uC544\uB9C8 \uB9C8\uB8E8\uAC00 \uBA3C\uC800 \uB9D0\uC744 \uAEBC\uB0B4\uC57C\uACA0\uC8E0.$h",
  "Rainy_Day_2": "\uC5EC\uBCF4 \uC548\uB155! \uC544\uCE68\uC5D0 \uC7A5 \uBCF4\uB2E4\uAC00 \uC774\uAC70 \uC0AC \uC654\uC5B4\uC694.[186 180 770 535]#$e#\uC774\uAC8C \uC815\uB9D0 \uD558\uB098 \uD544\uC694\uD560 \uAC70\uB77C \uC0DD\uAC01\uD588\uC5B4\uC694.$11",
  "Rainy_Day_3": "\uD760... \uC0C8 \uB808\uC2DC\uD53C\uB97C \uC2DC\uB3C4\uD574\uBCFC\uAE4C. \uB0B4\uAC00 \uC800\uBC88\uC5D0 \uB9CC\uB4E0 \uB808\uC2DC\uD53C \uB9C8\uC74C\uC5D0 \uB4E4\uC5C8\uC8E0, \uC5EC\uBCF4?#$e#\uB0B4\uAC00 \uBB50\uB77C\uACE0 \uBD88\uB800\uB354\uB77C... \u0027\uCE60\uB9AC \uB4DC @\u0027?",
  "Rainy_Day_4": "\uC774\uB7F0 \uB0A0\uC740 \uB9C8\uC74C\uC5D0 \uB4DC\uB294 \uCC45 \uD558\uB098 \uC7A1\uACE0 \uC544\uB291\uD558\uAC8C \uC788\uACE0 \uC2F6\uC5B4\uC694.",
  "Rainy_Night_0": "\uC624\uB298 \uD558\uB8E8 \uC5B4\uB560\uB098\uC694, \uC5EC\uBCF4? \uB09C \uC624\uD6C4\uC5D0 \uC18C\uC124 \uC77D\uC5C8\uC5B4\uC694.",
  "patio_Penny": "\uC608\uC804\uC5D0 \uC9C0\uB0B4\uB358 \uACF3\uBCF4\uB2E4 \uC5EC\uAE30\uAC00 \uD6E8\uC52C \uD3C9\uD654\uB85C\uC6CC\uC694. \uB355\uBD84\uC5D0 \uC544\uC8FC \uD589\uBCF5\uD574\uC694.",
  "Rainy_Night_1": "\uBD84\uBA85 \uC5B4\uBA38\uB2C8\uB294 \uC8FC\uC810\uC5D0 \uC788\uACA0\uC8E0... \uD558\uC9C0\uB9CC \uADF8\uB807\uAC8C \uB9C8\uC74C\uC774 \uD798\uB4E4\uC9C4 \uC54A\uB124\uC694. \uB0B4\uAC00 \uD560 \uC218 \uC788\uB294 \uC77C\uC740 \uB2E4 \uD588\uC5B4\uC694.",
  "Rainy_Night_2": "\uC6B0\uB9AC \uBAA9\uC695\uD0D5\uC5D0\uC11C \uB9CC\uB09C \uADF8 \uBC24\uC5D0 \uB300\uD574 \uC0DD\uAC01\uD558\uACE0 \uC788\uC5C8\uC5B4\uC694.$l#$e#\uADF8\uB0A0 \uBC24\uC740 \uD3C9\uC0DD \uC78A\uC9C0 \uC54A\uC744 \uAC70\uC608\uC694...$l",
  "Rainy_Night_3": "\uC0AC\uC2E4 \uCCA0\uC81C \uD2B8\uB808\uC77C\uB7EC\uC5D0\uC11C \uC9C0\uB0BC \uB54C\uB294 \uBE57\uC18C\uB9AC\uAC00 \uC131\uAC00\uC168\uB294\uB370, \uC5EC\uAE30\uC11C\uB294 \uB9C8\uC74C\uC744 \uB2EC\uB798\uC8FC\uB294 \uC18C\uB9AC \uAC19\uB124\uC694.",
  "Rainy_Night_4": "\uC800\uB141 \uC694\uB9AC\uAC00 \uD558\uACE0 \uC2F6\uC5C8\uC5B4\uC694. \uB9D8\uC5D0 \uB4E4\uAE38 \uBC14\uB77C\uC694. [212 214 225 209 200]$h",
  "Indoor_Day_0": "\uC5EC\uAE34 \uC815\uB9D0 \uD3C9\uD654\uB85C\uC6CC\uC694. \uC608\uC804\uC5D0\uB294 \uC815\uB9D0 \uB054\uCC0D\uD55C \uC545\uBABD\uC744 \uB9CE\uC774 \uAFE8\uB294\uB370, \uC774\uC820 \uC5B4\uB9B0\uC544\uC774\uCC98\uB7FC \uD479 \uC798 \uC218 \uC788\uC5B4\uC694.",
  "Indoor_Day_1": "\uC88B\uC740 \uC544\uCE68\uC774\uC5D0\uC694, @\uC528! \uC9C0\uAE08 \uB9C9 \uC544\uCE68\uC2DD\uC0AC\uB97C \uCC28\uB838\uC5B4\uC694.[195 210 211]#$e#\uB2F9\uC2E0\uC774 \uBC30\uBD80\uB978 \uCC44\uB85C \uC9D1\uC744 \uB098\uC11C\uB294 \uAC8C \uB0B4\uAC90 \uC911\uC694\uD574\uC694.$h",
  "Indoor_Day_2": "\uC788\uC8E0, \uB098 \uC624\uB298\uC740 \uCC45\uC744 \uC77D\uC744\uAE4C \uC2F6\uC5B4\uC694. \uC800\uBC88\uC5D0 \uB3C4\uC11C\uAD00\uC5D0 \uB4E4\uB800\uC744 \uB54C \uBE4C\uB824\uC628 \uCC45\uC774 \uC788\uC5B4\uC694.#$e#\uAC74\uD130\uAC00 \uC548\uBD80 \uC804\uD588\uC5B4\uC694, \uCC38.",
  "Indoor_Day_3": "\uB2F9\uC2E0\uC774 \uBC1C\uACAC\uD55C \uC720\uBB3C\uC5D0 \uB300\uD574 \uC774\uC57C\uAE30\uB97C \uB4E3\uB294 \uAC8C \uB108\uBB34 \uC88B\uC544\uC694. \uACE0\uACE0\uD559\uC740 \uC815\uB9D0 \uD765\uBBF8\uB85C\uC6CC\uC694!#$e#\uC0DD\uAC01\uD574\uBD10\uC694... 10,000\uB144 \uC804\uC5D0 \uBC14\uB85C \uC774 \uC7A5\uC18C\uC5D0 \uB18D\uBD80\uB4E4\uC774 \uC788\uC5C8\uB2E4\uB2C8.",
  "Indoor_Day_4": "\uC6B0\uB9AC \uCC98\uC74C \uB9CC\uB0AC\uC744 \uB54C \uB0B4\uAC00 \uC218\uC90D\uC5B4\uD588\uB098\uC694? \uC7AC\uBC0C\uB124\uC694, \uC774\uB807\uAC8C \uB3CC\uC774\uCF1C \uC0DD\uAC01\uD574\uBCF4\uB2C8.$h",
  "Indoor_Night_0": "\uC88B\uC740 \uC800\uB141\uC774\uC5D0\uC694, \uC5EC\uBCF4. \uC624\uB298 \uD558\uB824\uB358 \uC77C\uC740 \uB2E4 \uB9C8\uCCE4\uB098\uC694?#$e#\uBABB\uD588\uB354\uB77C\uB3C4 \uC5B4\uB54C\uC694. \uC6B0\uB9AC \uC2DC\uAC04 \uB9CE\uC796\uC544\uC694!",
  "Indoor_Night_1": "\uD760... \uB0B4\uC77C \uCE58\uB9C8? \uBC14\uC9C0? \uC624, \uC65C \uACE0\uBBFC\uD558\uACE0 \uC788\uC9C0... \uD56D\uC0C1 \uCE58\uB9C8\uC778\uAC78.",
  "Indoor_Night_2": "\uC5EC\uAE30\uC11C \uC6B0\uB9B0 \uC815\uB9D0 \uB9CE\uC740 \uAC83\uC744 \uB204\uB9AC\uACE0 \uC788\uB124\uC694. \uD56D\uC0C1 \uC6B0\uB9AC\uBCF4\uB2E4 \uB531\uD55C \uD658\uACBD\uC778 \uC0AC\uB78C\uB4E4\uC744 \uC0DD\uAC01\uD574\uC57C \uD574\uC694.#$e#\uC6B0\uB9AC\uAC00 \uAC00\uC9C4 \uBAA8\uB4E0 \uAC83\uC5D0 \uB09C \uD56D\uC0C1 \uAC10\uC0AC\uD574\uC694.",
  "Indoor_Night_3": "\uB0B4\uAC00 \uB5A0\uB098\uC11C \uC5B4\uBA38\uB2C8\uAC00 \uC678\uB85C\uC6CC\uD560 \uAC70\uC608\uC694. \uADF8\uB807\uB2E4\uACE0 \uC8FC\uC810\uC5D0 \uB354 \uC790\uC8FC \uAC00\uC2DC\uBA74 \uC548 \uB420 \uD150\uB370\uC694.#$e#\uC544, \uBBF8\uC548\uD574\uD560 \uD544\uC694\uB294 \uC5C6\uC5B4\uC694! \uC5B4\uBA38\uB2C8\uB3C4 \uC2A4\uC2A4\uB85C \uBB38\uC81C\uB97C \uD574\uACB0\uD558\uC154\uC57C\uC8E0. ",
  "Indoor_Night_4": "\uC798 \uC900\uBE44\uB418\uC5C8\uB098\uC694? \uBC14\uB85C \uC798 \uC218 \uC788\uAC8C \uCE68\uB300 \uC815\uB3C8\uD588\uC5B4\uC694...$11",
  "Outdoor_0": "\uC774\uB807\uAC8C \uC544\uB984\uB2E4\uC6B4 \uACF3\uC5D0 \uC0AC\uB294 \uAC74 \uAFC8\uB9CC \uAFE8\uC5C8\uB294\uB370, \uD604\uC2E4\uC774 \uB418\uC5C8\uB124\uC694.#$e#\uC0AC\uC2E4 \uC9D1\uC5D0 \uC0B4 \uB54C \uC880 \uBE44\uCC38\uD588\uC5B4\uC694.$s",
  "Outdoor_1": "\uC5EC\uAE30 \uC544\uC774\uB97C \uD0A4\uC6B0\uAE30\uC5D0 \uC815\uB9D0 \uC644\uBCBD\uD55C \uC7A5\uC18C \uC544\uB2CC\uAC00\uC694?#$e#\uB098\uB3C4 \uB18D\uC7A5\uC5D0\uC11C \uC790\uB790\uB2E4\uBA74 \uBB34\uCC99 \uD589\uBCF5\uD588\uC744 \uAC70\uC608\uC694.",
  "Outdoor_2": "\uC5EC\uBCF4 \uC548\uB155! \uB18D\uC7A5 \uC77C\uC5D0 \uB300\uD574 \uB354 \uC54C\uC558\uC73C\uBA74 \uB354 \uB3C4\uC640\uC904 \uC218 \uC788\uC744 \uD150\uB370. \uBBF8\uC548\uD574\uC694!#$e#\uB2F9\uC2E0 \uC0DD\uAC01\uD558\uACE0 \uC788\uC744\uAC8C\uC694.$h",
  "Outdoor_3": "\uBC29\uAE08 \uBA85\uAE08\uC774 \uC11C\uCABD\uC73C\uB85C \uB0A0\uC544\uAC00\uB294 \uAC78 \uBC29\uAE08 \uBD24\uC5B4\uC694. \uC774 \uC9C0\uC5ED\uC5D0\uC11C\uB294 \uC544\uC8FC \uC88B\uC740 \uC9D5\uC870\uC5D0\uC694.$h",
  "Outdoor_4": "\uC544... \uBC16\uC5D0 \uB098\uC624\uB2C8 \uC815\uB9D0 \uC88B\uB124\uC694. \uB531 \uC5EC\uAE30\uC11C \uD558\uB8E8 \uC885\uC77C \uC788\uC744 \uC218\uB3C4 \uC788\uC744 \uAC70 \uAC19\uC544\uC694, \uC791\uC740 \uAC83 \uD558\uB098\uD558\uB098 \uAD00\uCC30\uD558\uBA74\uC11C.",
  "OneKid_0": "\uC624\uB298 %kid1(\uC774)\uB791 \uC2DC\uAC04 \uC880 \uBCF4\uB0C8\uC5B4\uC694? \uC544\uC774\uAC00 \uD558\uB098 \uB354 \uC788\uC73C\uBA74 \uC88B\uC73C\uB824\uB098.",
  "OneKid_1": "\uC6B0\uB9AC \uC791\uC740 %kid1(\uC774)\uB294 \uC5EC\uAE30\uC11C \uC815\uB9D0 \uC88B\uC740 \uC5B4\uB9B0 \uC2DC\uC808\uC744 \uBCF4\uB0BC \uAC70\uC608\uC694.",
  "OneKid_3": "\uC544\uC774\uAC00 \uC0DD\uAE30\uACE0 \uB098\uB2C8\uAE4C \uB0B4\uAC00 \uB098\uC774\uAC00 \uB9CE\uC774 \uB4E0 \uAC83 \uAC19\uC544\uC694. \uC0C8\uB85C\uC6B4 \uCC45\uC784\uAC10\uC774 \uBB34\uAC70\uC6CC\uC11C \uADF8\uB7F0 \uAC78\uAE4C\uC694.#$e#\uB098\uC05C \uC77C\uC740 \uC544\uB2C8\uC5D0\uC694! \uC624\uB7AB\uB3D9\uC548 \uC6D0\uD574\uC654\uB358 \uAC70\uC608\uC694.$11",
  "TwoKids_0": "\uB0B4\uAC00 \uBC8C\uC368 %kid1(\uC774)\uB791 %kid2(\uC774) \uBC25\uC740 \uCC59\uACA8\uC92C\uC5B4\uC694. \uB9CE\uC774 \uC798 \uBA39\uB294 \uC544\uC774\uB4E4\uC774\uB124\uC694!",
  "TwoKids_1": "\uC6B0\uB9AC \uC774\uC81C %kid2(\uC774)\uAC00 \uC788\uC73C\uB2C8 %kid1(\uC774)\uD55C\uD14C\uB3C4 \uAD00\uC2EC \uB9CE\uC774 \uC918\uC57C \uD574\uC694. \uC11C\uB85C \uC9C8\uD22C\uAC00 \uC0DD\uAE30\uBA74 \uC548 \uB3FC\uC694.",
  "TwoKids_2": "%kid2(\uC774)\uAC00 \uAC11\uC790\uAE30 \uB0A0\uAC1C\uAC00 \uC0DD\uAE30\uB354\uB2C8 \uBC24\uD558\uB298\uB85C \uB0A0\uC544\uAC00\uB294 \uAFC8\uC744 \uAFE8\uC5B4\uC694. \uBB34\uC2A8 \uB73B\uC77C\uAE4C\uC694?",
  "TwoKids_3": "\uC88B\uC740 \uC9D1, \uBA4B\uC9C4 \uC544\uC774 \uB458, \uADF8\uB9AC\uACE0 \uC544\uB984\uB2E4\uC6B4 \uB18D\uC9C0. \uC6B0\uB9AC \uC815\uB9D0 \uBCF5\uBC1B\uC740 \uAC70\uC608\uC694.",
  "Good_0": "@...\uC544\uC9C1 \uC6B0\uB9AC \uACB0\uD63C\uD588\uB2E4\uB294 \uAC8C \uC548 \uBBFF\uACA8\uC694...$l",
  "Good_1": "\uB2F9\uC2E0\uACFC \uACB0\uD63C\uD558\uB294 \uAFC8\uC744 \uB108\uBB34\uB098 \uC624\uB7AB\uB3D9\uC548 \uAC04\uC9C1\uD588\uC5B4\uC694.$l",
  "Good_2": "\uB2F9\uC2E0\uC774 \uC5EC\uAE30 \uC774\uC0AC \uC628 \uC21C\uAC04\uBD80\uD130 \uB2F9\uC2E0\uC774 \uB0B4 \uC6B4\uBA85\uC778 \uAC78 \uC54C\uC558\uC5B4\uC694...$l",
  "Good_3": "\uC640\uC6B0, \uC624\uB298 \uD2B9\uD788 \uC798\uC0DD\uACBC\uB124\uC694! \uBA74\uB3C4\uD588\uB098\uC694?$l^\uC640\uC6B0, \uC624\uB298 \uC815\uB9D0 \uC544\uB984\uB2E4\uC6CC\uC694. \uBA38\uB9AC\uB97C \uB2E4\uB974\uAC8C \uD55C \uAC74\uAC00\uC694?$l",
  "Good_4": "\uC5EC\uAE30\uAC00 \uC9C4\uC9DC \uB0B4 \uC9D1\uC774\uB77C\uB294 \uAE30\uBD84\uC774 \uC810\uC810 \uB4E4\uC5B4\uC694.$l",
  "Good_6": "\uC870\uC2EC\uD574\uC694! \uAC00\uB054 \uB2F9\uC2E0\uC774 \uAC74\uAC15\uD55C \uC74C\uC2DD\uC744 \uCDA9\uBD84\uD788 \uBA39\uC9C0 \uC54A\uB294 \uAC83 \uAC19\uC544 \uAC71\uC815\uB3FC\uC694.",
  "funLeave_Penny": "\uC624\uB298\uC740 \uB9C8\uC744\uC5D0 \uAC00\uBCF4\uB824\uACE0\uC694, \uB180\uB2E4 \uC62C\uAC8C\uC694. \uB098\uC911\uC5D0 \uB3CC\uC544\uC62C\uAC8C\uC694!",
  "funReturn_Penny": "\uC7AC\uBC0C\uC5C8\uC5B4\uC694... \uC0AC\uB78C\uB4E4\uC774\uB791 \uC5F0\uB77D\uD558\uACE0 \uC9C0\uB0B4\uB294 \uAC74 \uC88B\uC740 \uC77C\uC778 \uAC83 \uAC19\uC544\uC694. \uC5EC\uBCF4 \uD558\uB8E8\uB294 \uC5B4\uB560\uB098\uC694.",
  "spring_8": "\uB0B4\uAC00 \uC81C\uC77C \uC88B\uC544\uD558\uB294 \uACC4\uC808\uC740 \uBD04\uC778\uAC00 \uBD10\uC694. \uACF5\uAE30 \uC911\uC5D0 \uD2B9\uC720\uC758 \uC0C1\uCF8C\uD568\uC774 \uB0A0 \uD76C\uB9DD\uC73C\uB85C \uCC44\uC6B0\uB124\uC694.",
  "spring_1": "\uC6B0\uB9AC \uC55E\uC73C\uB85C \uAE30\uB300\uD560 \uC77C \uB144\uC774 \uB610 \uC654\uB124\uC694. \uC0DD\uC0B0\uC801\uC778 \uD55C\uD574 \uBCF4\uB0B4\uC694, \uC6B0\uB9AC.",
  "spring_15": "\uC544, \u0027\uBD04\uB9DE\uC774 \uB300\uCCAD\uC18C\u0027... \uC0AC\uC2E4 \uC990\uAC70\uC6B8 \uAC83 \uAC19\uC544\uC694.",
  "summer_16": "*\uD734*... \uC774 \uB354\uC704\uB97C \uADF9\uBCF5\uD558\uB824\uBA74 \uBA5C\uB860\uC744 \uB354 \uBA39\uC5B4\uC57C\uACA0\uC5B4\uC694!",
  "summer_1": "\uC5EC\uB984\uC774 \uC815\uB9D0 \uB365\uAE34 \uD558\uC9C0\uB9CC, \uC2B5\uD55C \uB290\uB08C\uC774 \uD53C\uBD80\uC5D0 \uB2FF\uB294 \uAC8C \uC88B\uB124\uC694.",
  "summer_2": "\uC5EC\uB984\uC5D0\uB294 \uAC1C\uBBF8\uB4E4\uC774 \uCC38 \uD65C\uBC1C\uD574\uC838\uC694. \uBA87 \uC2DC\uAC04\uC774\uACE0 \uBCFC \uC218 \uC788\uC744 \uAC83 \uAC19\uC544\uC694... \uAC1C\uBBF8\uB4E4\uB3C4 \uC0C1\uB2F9\uD788 \uBCF5\uC7A1\uD55C \uBB38\uBA85\uC744 \uC774\uB8E8\uACE0 \uC788\uB294 \uAC83 \uAC19\uC544\uC694!",
  "fall_5": "\uAC00\uC744 \uB0C4\uC0C8\uB97C \uB9E1\uC73C\uBA74 \uCC45 \uB0C4\uC0C8\uAC00 \uC0DD\uAC01\uB098\uC694... \uC774\uC0C1\uD558\uC9C0 \uC54A\uB098\uC694?",
  "fall_1": "\uAC00\uC744... \uC0C9\uC885\uC774\uB791 \uD480 \uC0DD\uAC01\uC744 \uD558\uAC8C \uD558\uB124\uC694. \uC544\uC774\uB4E4\uD558\uACE0 \uB108\uBB34 \uB9CE\uC740 \uC2DC\uAC04\uC744 \uBCF4\uB0B4\uACE0 \uC788\uB294 \uAC78\uAE4C\uC694.$h",
  "fall_2": "\uC624\uB298 \uAC70\uB300\uD55C \uD638\uBC15\uC744 \uD0A4\uC6B8 \uC608\uC815\uC778\uAC00\uC694?$11",
  "winter_1": "\uACA8\uC6B8\uC740 \uAE34\uC7A5\uC744 \uD480\uAE30 \uC88B\uC740 \uC2DC\uAC04\uC778 \uAC83 \uAC19\uC544\uC694. \uD55C\uD574 \uC5F4\uC2EC\uD788 \uC77C\uD588\uC73C\uB2C8 \uD479 \uC274 \uC790\uACA9\uC774 \uC788\uC5B4\uC694!",
  "winter_6": "\uB208\uC774 \uC624\uB294 \uAC83\uC744 \uBCF4\uB2C8 \uBCBD\uB09C\uB85C \uC55E\uC5D0 \uD754\uB4E4\uC758\uC790\uC5D0 \uC549\uC544\uACC4\uC2DC\uB358 \uD560\uBA38\uB2C8 \uC0DD\uAC01\uC774 \uB098\uB124\uC694. \uC0AC\uC2E4 \uAE30\uC5B5\uC774 \uC81C\uC77C \uB098\uB294 \uAC74 \uC8FC\uD669\uC0C9 \uB098\uBB34\uC5D0 \uD754\uB4E4\uB9AC\uB358 \uD560\uBA38\uB2C8 \uADF8\uB9BC\uC790\uC608\uC694. \uC544\uC8FC \uC624\uB798 \uC804\uC774\uC8E0.",
  "winter_3": "\uC62C\uACA8\uC6B8\uC740 \uC6B0\uB9AC \uC798 \uC9C0\uB0BC \uC218 \uC788\uACA0\uC8E0? \uC624, \uC0AC\uC2E4 \uC598\uAE30\uD574\uC8FC\uC9C0 \uC54A\uC544\uB3C4 \uAD1C\uCC2E\uC544\uC694... \uB2F9\uC2E0\uC774 \uC633\uC740 \uACB0\uC815\uC744 \uB0B4\uB9B4 \uAC70\uB77C\uACE0 \uBBFF\uC5B4\uC694."
}