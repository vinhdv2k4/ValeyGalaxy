{
  "Rainy_Day_0": "\u0422\u043E, \u0447\u0442\u043E \u0434\u043E\u0436\u0434\u044C \u0432\u044B\u0437\u044B\u0432\u0430\u0435\u0442 \u0433\u0440\u0438\u043F\u043F \u2014 \u044D\u0442\u043E \u043C\u0438\u0444. \u041D\u043E \u0441\u043C\u043E\u0442\u0440\u0438 \u043D\u0435 \u043F\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0438\u0441\u044C \u0432 \u0433\u0440\u044F\u0437\u0438!#$e#\u042F \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E \u0437\u0430 \u0442\u0435\u0431\u044F \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u044E.",
  "Rainy_Day_1": "\u0416\u0438\u0442\u044C \u0432 \u043A\u043B\u0438\u043D\u0438\u043A\u0435 \u0431\u044B\u043B\u043E \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E \u043E\u0434\u0438\u043D\u043E\u043A\u043E... \u0422\u0435\u043F\u0435\u0440\u044C \u044F \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u0435\u0435.$h",
  "Rainy_Day_2": "\u042F \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0441\u044F \u0440\u0430\u043D\u043E, \u043D\u043E \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u043B\u0441\u044F \u043D\u0435 \u0431\u0443\u0434\u0438\u0442\u044C \u0442\u0435\u0431\u044F. \u0422\u044B \u0442\u0430\u043A \u043C\u0438\u0440\u043D\u043E \u0441\u043F\u0438\u0448\u044C.",
  "Rainy_Day_3": "\u041C\u043D\u0435 \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E \u043D\u0430 \u0434\u043E\u0436\u0434\u044C. \u041D\u0443 \u0434\u0430, \u043D\u0430 \u0441\u0430\u043C\u043E\u043B\u0435\u0442\u044B \u043D\u0435 \u043F\u043E\u043B\u044E\u0431\u043E\u0432\u0430\u0442\u044C\u0441\u044F, \u0430 \u0432\u043E\u0442 \u043F\u043E\u0441\u043B\u0443\u0448\u0430\u0442\u044C \u0440\u0430\u0434\u0438\u043E \u044D\u0442\u043E \u043D\u0435 \u043F\u043E\u043C\u0435\u0448\u0430\u0435\u0442.#$e#\u042D\u0442\u043E \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0442\u0430\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438.",
  "Rainy_Day_4": "\u0423 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u0441\u043F\u0438\u0441\u043E\u043A \u0434\u043E\u043C\u0430\u0448\u043D\u0438\u0445 \u0434\u0435\u043B \u043D\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F. \u0414\u0435\u043D\u044C \u0431\u0443\u0434\u0435\u0442 \u0437\u0430\u043D\u044F\u0442\u043E\u0439!",
  "Rainy_Night_0": "\u041A\u0430\u043A \u0442\u0432\u043E\u0439 \u0434\u0435\u043D\u044C, ${\u0434\u043E\u0440\u043E\u0433\u043E\u0439^\u0434\u043E\u0440\u043E\u0433\u0430\u044F}$? \u042F \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0441\u044F \u043F\u043E\u043C\u044B\u0442\u044C \u043F\u043E\u0441\u0443\u0434\u0443, \u043D\u043E \u0443\u0432\u043B\u0435\u043A\u0441\u044F \u0432\u044B\u043F\u0443\u0441\u043A\u043E\u043C \u00AB\u0425\u0438\u0440\u0443\u0440\u0433\u0438\u0438 \u043A\u043E\u043B\u0435\u043D\u0430\u00BB.",
  "patio_Harvey": "\u0417\u043D\u0430\u0435\u0448\u044C, \u043A\u043E\u0433\u0434\u0430 \u044F \u0437\u0434\u0435\u0441\u044C, \u0434\u0430\u0436\u0435 \u00AB\u0416\u0443\u0440\u043D\u0430\u043B \u043E \u0434\u0438\u043D\u0430\u043C\u0438\u043A\u0435 \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u0438\u0439\u00BB \u043D\u0435\u043F\u043B\u043E\u0445\u043E \u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F.",
  "Rainy_Night_1": "\u0415\u0441\u043B\u0438 \u0442\u0435\u0431\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u0442\u0432\u043E\u044F \u0436\u0438\u0437\u043D\u044C, \u0442\u043E \u043A\u043E\u043C\u0443 \u043A\u0430\u043A\u043E\u0435 \u0434\u0435\u043B\u043E, \u0435\u0441\u043B\u0438 \u043E\u043D\u0430 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043E\u0434\u043D\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u0430? \u042F \u0442\u0430\u043A \u0441\u043A\u0430\u0436\u0443.",
  "Rainy_Night_2": "\u0422\u044B \u043F\u0440\u043E\u043C\u043E\u043A, \u043C\u0438\u043B\u044B\u0439. \u041C\u043E\u0436\u0435\u0442, \u043F\u043E\u0433\u0440\u0435\u0435\u0448\u044C\u0441\u044F \u0443 \u043A\u0430\u043C\u0438\u043D\u0430?^\u0422\u044B \u043F\u0440\u043E\u043C\u043E\u043A\u043B\u0430, \u0434\u043E\u0440\u043E\u0433\u0430\u044F. \u041C\u043E\u0436\u0435\u0442, \u043F\u043E\u0433\u0440\u0435\u0435\u0448\u044C\u0441\u044F \u0443 \u043A\u0430\u043C\u0438\u043D\u0430?",
  "Rainy_Night_3": "\u041D\u0430\u0448 \u0440\u0430\u0437\u0443\u043C \u0441\u043E\u0441\u0440\u0435\u0434\u043E\u0442\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u043D\u0430 \u0437\u0432\u0443\u043A\u0435 \u0434\u043E\u0436\u0434\u044F, \u0447\u0442\u043E\u0431\u044B \u043C\u044B \u043D\u0435 \u043E\u0442\u0432\u043B\u0435\u043A\u0430\u043B\u0438\u0441\u044C \u043D\u0430 \u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0435 \u043C\u044B\u0441\u043B\u0438.#$e#\u042D\u0442\u043E \u043C\u043E\u044F \u0442\u0435\u043E\u0440\u0438\u044F \u043E \u0442\u043E\u043C, \u043F\u043E\u0447\u0435\u043C\u0443 \u043E\u043D \u0442\u0430\u043A \u0443\u0441\u043F\u043E\u043A\u0430\u0438\u0432\u0430\u0435\u0442...",
  "Rainy_Night_4": "\u042F \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u043B \u043D\u0430\u043C \u0437\u0434\u043E\u0440\u043E\u0432\u044B\u0439 \u0443\u0436\u0438\u043D. \u0422\u043E\u043B\u044C\u043A\u043E \u0441\u0432\u0435\u0436\u0438\u0435 \u0438 \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0435 \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u044B \u0438\u0437 \u0434\u043E\u043B\u0438\u043D\u044B![212 214 225 209 200]$h#$e#\u0422\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u0439\u0441\u044F \u0435\u0441\u0442\u044C \u0432 \u043C\u0435\u0440\u0443, ${\u0434\u043E\u0440\u043E\u0433\u043E\u0439^\u0434\u043E\u0440\u043E\u0433\u0430\u044F}$.",
  "Indoor_Day_0": "\u0414\u0443\u043C\u0430\u044E, \u0432\u0441\u0435 \u043C\u044B \u0441\u0442\u0440\u0435\u043C\u0438\u043C\u0441\u044F \u0434\u043E\u0441\u0442\u0438\u0447\u044C \u0432 \u0436\u0438\u0437\u043D\u0438 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u043E\u0433\u043E \u0431\u0430\u043B\u0430\u043D\u0441\u0430. \u0420\u0430\u0432\u043D\u043E\u0432\u0435\u0441\u0438\u0435 \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u0435\u0439.#$e#\u0414\u043B\u044F \u043C\u043E\u0435\u0433\u043E \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u0430 \u043F\u0435\u0440\u0435\u0435\u0437\u0434 \u0441\u044E\u0434\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u0442\u0435\u043C, \u0447\u0442\u043E \u043D\u0443\u0436\u043D\u043E \u0434\u043B\u044F \u044D\u0442\u043E\u0433\u043E \u0431\u0430\u043B\u0430\u043D\u0441\u0430.$l",
  "Indoor_Day_1": "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E, @! \u042F \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u043B \u0442\u0435\u0431\u0435 \u043F\u0438\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0437\u0430\u0432\u0442\u0440\u0430\u043A.[201]#$e#\u042F\u0439\u0446\u0430 \u2014 \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B\u0445 \u043F\u0438\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u0432\u0435\u0449\u0435\u0441\u0442\u0432, \u0442\u0430\u043A \u0447\u0442\u043E \u043D\u0430\u043B\u0435\u0442\u0430\u0439.",
  "Indoor_Day_2": "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0441\u044C \u0438\u0437\u0443\u0447\u0430\u0442\u044C \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u0443\u044E \u043B\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u0443. \u0414\u043B\u044F \u043C\u0435\u043D\u044F \u0432\u0430\u0436\u043D\u043E \u0431\u044B\u0442\u044C \u0432 \u043A\u0443\u0440\u0441\u0435 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0445 \u0432\u0435\u044F\u043D\u0438\u0439, \u0447\u0442\u043E\u0431\u044B \u044F \u043C\u043E\u0433 \u043F\u043E\u043C\u043E\u0433\u0430\u0442\u044C \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u0430\u043C \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E \u043B\u0443\u0447\u0448\u0435!",
  "Indoor_Day_3": "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u0431\u0443\u0434\u0443 \u0441\u043B\u0443\u0448\u0430\u0442\u044C \u0434\u0436\u0430\u0437 \u0438 \u0434\u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0442\u044C \u0441\u0432\u043E\u0438 \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u0438\u0435 \u043E\u0442\u0447\u0435\u0442\u044B. \u0410 \u0443 \u0442\u0435\u0431\u044F \u043A\u0430\u043A\u0438\u0435 \u043F\u043B\u0430\u043D\u044B?",
  "Indoor_Day_4": "\u041A\u043E\u0433\u0434\u0430 \u043C\u044B \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0438\u0441\u044C, \u044F \u0442\u0435\u0431\u044F \u043F\u043E\u0431\u0430\u0438\u0432\u0430\u043B\u0441\u044F. \u0422\u0435\u043F\u0435\u0440\u044C, \u043A\u043E\u0433\u0434\u0430 \u043C\u044B \u043F\u0440\u043E\u0448\u043B\u0438 \u044D\u0442\u043E\u0442 \u0434\u043E\u043B\u0433\u0438\u0439 \u043F\u0443\u0442\u044C, \u0441\u043C\u0435\u0448\u043D\u043E \u043E\u0431 \u044D\u0442\u043E\u043C \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u0442\u044C.$h",
  "Indoor_Night_0": "\u0412\u044B\u0433\u043B\u044F\u0434\u0438\u0448\u044C \u0443\u0441\u0442\u0430\u043B\u043E, \u043B\u044E\u0431\u043E\u0432\u044C \u043C\u043E\u044F. \u0414\u0430\u0432\u0430\u0439 \u044F \u0441\u0434\u0435\u043B\u0430\u044E \u0442\u0435\u0431\u0435 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043C\u0430\u0441\u0441\u0430\u0436. \u041E\u0431\u0435\u0449\u0430\u044E, \u043E\u043D \u0443\u043C\u0435\u043D\u044C\u0448\u0438\u0442 \u0432\u043E\u0441\u043F\u0430\u043B\u0435\u043D\u0438\u0435 \u0432 \u0442\u0432\u043E\u0435\u0439 \u043C\u044B\u0448\u0435\u0447\u043D\u043E\u0439 \u0442\u043A\u0430\u043D\u0438!$l",
  "Indoor_Night_1": "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u043E\u0442\u0434\u044B\u0445\u0430\u043B... \u041F\u043E\u0447\u0438\u0442\u0430\u043B \u043D\u0435\u043C\u043D\u043E\u0433\u043E, \u043F\u043E\u0432\u043E\u0437\u0438\u043B\u0441\u044F \u0441 \u0440\u0430\u0434\u0438\u043E, \u043F\u043E\u0440\u0430\u0431\u043E\u0442\u0430\u043B \u043D\u0430\u0434 \u043C\u043E\u0434\u0435\u043B\u044C\u044E \u0441\u0430\u043C\u043E\u043B\u0435\u0442\u0430.#$e#\u0412\u0430\u0436\u043D\u043E \u0438\u043D\u043E\u0433\u0434\u0430 \u0432\u0437\u044F\u0442\u044C \u0432\u044B\u0445\u043E\u0434\u043D\u043E\u0439 \u0438 \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u0438\u0442\u044C\u0441\u044F... \u0421\u0442\u0440\u0435\u0441\u0441 \u0432\u0440\u0435\u0434\u0435\u043D \u0434\u043B\u044F \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F.",
  "Indoor_Night_2": "\u0414\u043E\u0431\u0440\u044B\u0439 \u0432\u0435\u0447\u0435\u0440... \u0412\u0441\u0435 \u043B\u0438 \u0434\u0435\u043B\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C?#$e#\u041E\u0431\u043E \u043C\u043D\u0435 \u043D\u0435 \u0432\u043E\u043B\u043D\u0443\u0439\u0441\u044F. \u042F \u0441\u0430\u043C\u043E\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u0435\u043D. \u0415\u0441\u043B\u0438 \u0443 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C \u0435\u0449\u0435 \u0440\u0430\u0431\u043E\u0442\u0430, \u0442\u043E \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439.",
  "Indoor_Night_3": "\u0420\u0430\u0431\u043E\u0442\u0430 \u0432\u0440\u0430\u0447\u0430 \u043E\u0447\u0435\u043D\u044C \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u043D\u0430\u044F, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043E\u0447\u0435\u043D\u044C \u0437\u0434\u043E\u0440\u043E\u0432\u043E \u0436\u0438\u0442\u044C \u0432 \u0442\u0430\u043A\u043E\u043C \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u043B\u044F\u044E\u0449\u0435\u043C \u043C\u0435\u0441\u0442\u0435, \u043A\u0430\u043A \u0444\u0435\u0440\u043C\u0430 \u00AB%farm\u00BB.",
  "Indoor_Night_4": "\u0410! \u042F \u0437\u0430\u0434\u0443\u043C\u0430\u043B\u0441\u044F \u043E \u0441\u0438\u0441\u0442\u0435\u043C\u0435 \u043A\u0440\u043E\u0432\u043E\u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u044F \u0438 \u0437\u0430\u0431\u044B\u043B, \u0447\u0442\u043E \u0445\u043E\u0442\u0435\u043B \u0441\u0434\u0435\u043B\u0430\u0442\u044C. \u0422\u0438\u043F\u0438\u0447\u043D\u044B\u0435 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B \u0432\u0440\u0430\u0447\u0435\u0439.",
  "Outdoor_0": "\u0417\u0434\u0435\u0441\u044C \u043E\u0447\u0435\u043D\u044C \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E. \u0422\u044B \u0437\u0430\u043D\u0438\u043C\u0430\u0439\u0441\u044F \u0434\u0435\u043B\u0430\u043C\u0438, \u0430 \u043E\u0431\u043E \u043C\u043D\u0435 \u043D\u0435 \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0439\u0441\u044F.",
  "Outdoor_1": "\u041F\u043E\u043B\u0430\u0433\u0430\u044E, \u0437\u0434\u0435\u0441\u044C \u2014 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E, \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0441\u0442\u0438\u0442\u044C \u0434\u0435\u0442\u0435\u0439. \u0421 \u043D\u0430\u0443\u0447\u043D\u043E\u0439 \u0442\u043E\u0447\u043A\u0438 \u0437\u0440\u0435\u043D\u0438\u044F. \u0410 \u0442\u044B \u043A\u0430\u043A \u0434\u0443\u043C\u0430\u0435\u0448\u044C?",
  "Outdoor_2": "\u041C\u043E\u0436\u0435\u0442, \u044F \u0438 \u043D\u0435 \u0441\u0430\u043C\u044B\u0439 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0439 \u043F\u0430\u0440\u0435\u043D\u044C, \u043D\u043E \u044F \u0431\u0443\u0434\u0443 \u0432\u0435\u0440\u0435\u043D \u0442\u0435\u0431\u0435 \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u0436\u0438\u0437\u043D\u0438.$l",
  "Outdoor_3": "@... \u0422\u044B... \u0422\u044B \u2014 \u0441\u043C\u044B\u0441\u043B \u043C\u043E\u0435\u0439 \u0436\u0438\u0437\u043D\u0438.$l",
  "Outdoor_4": "\u041A\u0430\u043A \u0443\u0447\u0435\u043D\u044B\u0439, \u044F \u0432\u043E\u0441\u0445\u0438\u0449\u0435\u043D \u0442\u043E\u043D\u043A\u0438\u043C \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C \u043D\u0430\u0441\u0435\u043A\u043E\u043C\u044B\u0445 \u0438 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439.",
  "OneKid_0": "%kid1 \u0438 \u0442\u044B \u2014 \u0441\u0430\u043C\u043E\u0435 \u0432\u0430\u0436\u043D\u043E\u0435 \u0432 \u043C\u043E\u0435\u0439 \u0436\u0438\u0437\u043D\u0438.",
  "OneKid_1": "\u041C\u0430\u043B\u044E\u0442\u043A\u0430 %kid1 \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u0442 \u0437\u0434\u0435\u0441\u044C \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E\u0435 \u0434\u0435\u0442\u0441\u0442\u0432\u043E. \u041D\u0430\u043C \u043E\u0447\u0435\u043D\u044C \u043F\u043E\u0432\u0435\u0437\u043B\u043E \u0441 \u0442\u0430\u043A\u043E\u0439 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C\u044E.",
  "OneKid_3": "\u0414\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u043C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u0431\u044B\u0442\u044C \u043E\u0442\u0446\u043E\u043C!$h",
  "TwoKids_0": "%kid1 \u0438 %kid2 \u0443\u0436\u0435 \u043F\u043E\u0437\u0430\u0432\u0442\u0440\u0430\u043A\u0430\u043B\u0438. \u042F \u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C \u043F\u0440\u0438\u0443\u0447\u0438\u0442\u044C \u0438\u0445 \u043A \u043F\u043E\u043B\u0435\u0437\u043D\u043E\u0439 \u0435\u0434\u0435!",
  "TwoKids_1": "\u042F \u0441\u0447\u0438\u0442\u0430\u044E, \u0447\u0442\u043E \u0440\u0435\u0431\u0435\u043D\u043A\u0443 \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0442\u044C \u0438\u0433\u0440\u0430\u0442\u044C \u0438 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C \u0441\u0442\u043E\u043B\u044C\u043A\u043E, \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043E\u043D \u0445\u043E\u0447\u0435\u0442. \u0420\u0435\u0431\u0435\u043D\u043A\u043E\u043C \u0431\u044B\u0432\u0430\u0435\u0448\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u043D\u0430\u0436\u0434\u044B.",
  "TwoKids_2": "\u0410 \u0447\u0442\u043E, \u0435\u0441\u043B\u0438 %kid2 \u0432\u044B\u0440\u0430\u0441\u0442\u0435\u0442 \u043F\u0438\u043B\u043E\u0442\u043E\u043C, \u0432\u043C\u0435\u0441\u0442\u043E \u043C\u0435\u043D\u044F?",
  "TwoKids_3": "\u0422\u0435\u043F\u0435\u0440\u044C \u043C\u043E\u044F \u0436\u0438\u0437\u043D\u044C \u043F\u043E\u0441\u0432\u044F\u0449\u0435\u043D\u0430 \u0442\u0435\u0431\u0435 \u0438 \u0434\u0435\u0442\u044F\u043C, \u0438 \u044F \u043E\u0447\u0435\u043D\u044C \u044D\u0442\u043E\u043C\u0443 \u0440\u0430\u0434. \u042F \u0432\u0441\u0435\u0433\u0434\u0430 \u043C\u0435\u0447\u0442\u0430\u043B \u043E \u0447\u0443\u0434\u0435\u0441\u043D\u043E\u0439 \u0441\u0435\u043C\u044C\u0435.$l#$e#\u041C\u043D\u0435 \u0441\u043D\u0438\u043B\u0438\u0441\u044C \u043A\u043E\u0448\u043C\u0430\u0440\u044B \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u044F \u043D\u0430\u0432\u0435\u0447\u043D\u043E \u043E\u0441\u0442\u0430\u043D\u0443\u0441\u044C \u0445\u043E\u043B\u043E\u0441\u0442\u044F\u043A\u043E\u043C... \u042F \u0442\u0430\u043A \u0441\u0438\u043B\u044C\u043D\u043E \u0442\u0435\u0431\u044F \u043B\u044E\u0431\u043B\u044E.$l",
  "Good_0": "@... \u0414\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u043D\u0435 \u0432\u0435\u0440\u0438\u0442\u0441\u044F, \u0447\u0442\u043E \u043C\u044B \u043F\u043E\u0436\u0435\u043D\u0438\u043B\u0438\u0441\u044C...$l",
  "Good_1": "\u0422\u044B ${\u0441\u043F\u0430\u0441^\u0441\u043F\u0430\u0441\u043B\u0430}$ \u043C\u0435\u043D\u044F \u043E\u0442 \u0436\u0438\u0437\u043D\u0438 \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u0435 \u0438 ${\u0437\u0430\u043F\u043E\u043B\u043D\u0438\u043B^\u0437\u0430\u043F\u043E\u043B\u043D\u0438\u043B\u0430}$ \u043F\u0443\u0441\u0442\u043E\u0442\u0443 \u0432 \u043C\u043E\u0435\u043C \u0441\u0435\u0440\u0434\u0446\u0435. \u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0442\u0435\u0431\u0435.$l",
  "Good_2": "\u042F \u043F\u043E\u043D\u044F\u043B, \u0447\u0442\u043E \u0442\u044B \u2014 ${\u0442\u043E\u0442, \u043A\u0442\u043E \u043C\u043D\u0435 \u043D\u0443\u0436\u0435\u043D^\u0442\u0430, \u043A\u0442\u043E \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u0430}$, \u0435\u0449\u0435 \u0441 \u0441\u0430\u043C\u043E\u0433\u043E \u0442\u0432\u043E\u0435\u0433\u043E \u043F\u0435\u0440\u0435\u0435\u0437\u0434\u0430...$l",
  "Good_3": "\u041E\u0433\u043E, \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0442\u044B \u043D\u0435\u043E\u0442\u0440\u0430\u0437\u0438\u043C! \u0422\u044B \u043F\u043E\u0431\u0440\u0438\u043B\u0441\u044F?$l^\u0411\u043E\u0436\u0435... \u0422\u044B \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0442\u0430\u043A \u043A\u0440\u0430\u0441\u0438\u0432\u0430.$l",
  "Good_6": "\u0411\u0443\u0434\u044C \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u0435\u0439! \u041C\u043D\u0435 \u0441\u043D\u044F\u0442\u0441\u044F \u043A\u043E\u0448\u043C\u0430\u0440\u044B \u043E \u0442\u043E\u043C, \u043A\u0430\u043A \u0442\u0432\u043E\u0435 \u043D\u0435\u0434\u0432\u0438\u0436\u043D\u043E\u0435 \u0442\u0435\u043B\u043E \u043D\u0430 \u043A\u0430\u0442\u0430\u043B\u043A\u0435 \u0432\u0432\u043E\u0437\u044F\u0442 \u0432 \u043D\u0435\u043E\u0442\u043B\u043E\u0436\u043A\u0443.$7",
  "funLeave_Harvey": "\u0414\u0443\u043C\u0430\u044E, \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0433\u0443\u043B\u044F\u044E\u0441\u044C. \u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0440\u0430\u0437\u0432\u0435\u044F\u0442\u044C\u0441\u044F.",
  "funReturn_Harvey": "\u042F \u043D\u0435\u043F\u043B\u043E\u0445\u043E \u043F\u0440\u043E\u0432\u0435\u043B \u0434\u0435\u043D\u044C. \u0412\u0440\u0435\u043C\u044F \u043E\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043F\u043E\u0431\u044B\u0442\u044C \u043E\u0434\u043D\u043E\u043C\u0443 \u043E\u0441\u0432\u0435\u0436\u0430\u0435\u0442. \u0410 \u0443 \u0442\u0435\u0431\u044F \u0431\u044B\u043B \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0434\u0435\u043D\u044C, \u043B\u044E\u0431\u043E\u0432\u044C \u043C\u043E\u044F?",
  "spring_1": "\u042D\u0442\u043E \u0447\u0443\u0434\u0435\u0441\u043D\u043E \u2014 \u0432\u0438\u0434\u0435\u0442\u044C, \u043A\u0430\u043A \u0432\u0441\u0435 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0442\u0441\u044F \u043A \u0436\u0438\u0437\u043D\u0438. \u0417\u0435\u043B\u0435\u043D\u044C \u0442\u0430\u043A \u043E\u0441\u0432\u0435\u0436\u0430\u0435\u0442 \u043F\u043E\u0441\u043B\u0435 \u0447\u0435\u0440\u043D\u043E-\u0431\u0435\u043B\u043E\u0439 \u0437\u0438\u043C\u044B.",
  "spring_12": "\u041E\u0439, \u0437\u0430\u0432\u0442\u0440\u0430 \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A, \u0434\u0430? \u0422\u043E\u043B\u043F\u0430, \u0432\u0441\u044F\u043A\u0438\u0435 \u043C\u0435\u0440\u043E\u043F\u0440\u0438\u044F\u0442\u0438\u044F... *\u0421\u0433\u043B\u0430\u0442\u044B\u0432\u0430\u0435\u0442*$s",
  "spring_23": "\u0422-\u0442\u044B \u043F\u043E\u0442\u0430\u043D\u0446\u0443\u0435\u0448\u044C \u0441\u043E \u043C\u043D\u043E\u0439 \u0437\u0430\u0432\u0442\u0440\u0430?$7#$e#\u041C\u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043D\u0435\u043B\u043E\u0432\u043A\u043E.$7",
  "summer_1": "\u041F\u043E\u0441\u0442\u0430\u0440\u0430\u0439\u0441\u044F \u043D\u0435 \u043E\u0431\u0433\u043E\u0440\u0435\u0442\u044C, \u043B\u044E\u0431\u043E\u0432\u044C \u043C\u043E\u044F! \u042D\u0442\u043E \u043E\u0447\u0435\u043D\u044C \u043E\u043F\u0430\u0441\u043D\u043E \u0434\u043B\u044F \u0442\u0432\u043E\u0435\u0439 \u043A\u043E\u0436\u0438.$8#$e#\u041A\u0430\u043A \u0442\u0432\u043E\u0439 \u043C\u0443\u0436 \u0438 \u0432\u0440\u0430\u0447, \u044F \u0441\u0447\u0438\u0442\u0430\u044E \u0442\u0432\u043E\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u043C\u043E\u0438\u043C \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u043C \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442\u043E\u043C!",
  "summer_10": "\u0422\u044B \u0443\u0436\u0435 \u0434\u0443\u043C\u0430\u0435\u0448\u044C, \u0447\u0442\u043E \u043C\u044B \u043F\u043E\u043B\u043E\u0436\u0438\u043C \u0432 \u043E\u0431\u0449\u0438\u0439 \u043A\u043E\u0442\u0435\u043B \u043D\u0430 \u043B\u0443\u0430\u0443?#$e#\u042F \u0431\u044B \u043F\u043E\u043B\u043E\u0436\u0438\u043B \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435 \u0438 \u0446\u0435\u043D\u043D\u043E\u0435. \u041C\u044B \u0432\u0441\u0435 \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0442\u0438\u043C \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0438\u0442\u044C \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430!",
  "summer_27": "\u041B\u0435\u0442\u043E \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F, \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442\u0441\u044F \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0430, \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043C\u043E\u0435\u0439 \u0440\u0430\u0431\u043E\u0442\u044B. \u0417\u0430\u0440\u0430\u043D\u0435\u0435 \u043F\u0440\u043E\u0448\u0443 \u043F\u0440\u043E\u0449\u0435\u043D\u0438\u044F, \u0435\u0441\u043B\u0438 \u044F \u0431\u0443\u0434\u0443 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043A\u0430\u043F\u0440\u0438\u0437\u043D\u044B\u043C...",
  "fall_1": "\u041D\u0435 \u0437\u0430\u0431\u0443\u0434\u044C \u043D\u0430 \u043E\u0441\u0435\u043D\u044C \u043F\u043E\u0441\u0430\u0434\u0438\u0442\u044C \u0432\u0441\u044F\u043A\u043E\u0433\u043E \u0440\u0430\u0437\u043D\u043E\u0433\u043E, ${\u0434\u043E\u0440\u043E\u0433\u043E\u0439^\u0434\u043E\u0440\u043E\u0433\u0430\u044F}$.#$e#\u0418\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u0441\u0435\u0439 \u0432\u0441\u0435 \u043A\u043B\u044E\u043A\u0432\u043E\u0439... ${\u0421\u0430\u043C^\u0421\u0430\u043C\u0430}$ \u0432\u044B\u0431\u0438\u0440\u0430\u0439. \u041C\u043D\u0435-\u0442\u043E \u043E\u0442\u043A\u0443\u0434\u0430 \u0437\u043D\u0430\u0442\u044C?",
  "fall_15": "\u0417\u0430\u0432\u0442\u0440\u0430 \u044F\u0440\u043C\u0430\u0440\u043A\u0430. \u0415\u0434\u0430 \u0431\u0443\u0434\u0435\u0442 \u043E\u0447\u0435\u043D\u044C \u0436\u0438\u0440\u043D\u043E\u0439 \u0438 \u0441\u043E\u043B\u0435\u043D\u043E\u0439, \u043D\u043E \u0438\u043D\u043E\u0433\u0434\u0430 \u043C\u043E\u0436\u043D\u043E \u0438 \u043E\u0431\u044A\u0435\u0441\u0442\u044C\u0441\u044F.$h",
  "fall_26": "\u041F\u0440\u0438\u0437\u043D\u0430\u044E, \u043D\u0430 \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A\u0435 \u0414\u043D\u044F \u0432\u0441\u0435\u0445 \u0434\u0443\u0445\u043E\u0432 \u0443 \u043C\u0435\u043D\u044F \u0441\u0432\u043E\u0434\u0438\u0442 \u0436\u0438\u0432\u043E\u0442... \u041D\u043E \u044F \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C \u0438\u0437\u043E \u0432\u0441\u0435\u0445 \u0441\u0438\u043B \u0431\u044B\u0442\u044C \u0441\u043C\u0435\u043B\u044B\u043C.",
  "winter_1": "\u0417\u0438\u043C\u043E\u0439 \u0432\u043E\u0437\u0434\u0443\u0445 \u043E\u0447\u0435\u043D\u044C \u0441\u0443\u0445\u043E\u0439. \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u0432 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u043A\u043E\u0436\u0430 \u0443 \u043D\u0430\u0441 \u0431\u044B\u0432\u0430\u0435\u0442 \u0442\u0430\u043A\u043E\u0439 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043D\u043D\u043E\u0439.#$e#\u041D\u0435 \u0432\u043E\u043B\u043D\u0443\u0439\u0441\u044F, \u044F \u0431\u0443\u0434\u0443 \u043D\u0430\u0442\u0438\u0440\u0430\u0442\u044C \u0442\u0435\u0431\u0435 \u0441\u043F\u0438\u043D\u0443 \u0442\u0440\u044E\u0444\u0435\u043B\u044C\u043D\u044B\u043C \u043C\u0430\u0441\u043B\u043E\u043C \u043A\u0430\u0436\u0434\u044B\u0439 \u0432\u0435\u0447\u0435\u0440.$l",
  "winter_7": "\u0417\u0430\u0433\u043B\u044F\u043D\u0435\u043C \u0437\u0430\u0432\u0442\u0440\u0430 \u043D\u0430 \u043B\u0435\u0434\u043E\u0432\u044B\u0439 \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A? \u041C\u043D\u0435 \u0442\u0430\u043A \u043D\u0440\u0430\u0432\u044F\u0442\u0441\u044F \u0438\u0433\u043B\u0443...",
  "winter_28": "\u041D\u0443, \u0437\u0430 \u0444\u0430\u043D\u0442\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0433\u043E\u0434. \u042F \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0443\u0432\u0435\u0440\u0435\u043D, \u0447\u0442\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0433\u043E\u0434 \u0431\u0443\u0434\u0435\u0442 \u0435\u0449\u0435 \u043B\u0443\u0447\u0448\u0435!$h"
}