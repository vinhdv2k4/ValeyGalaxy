{
  "Rainy_Day_0": "\u0422\u0435\u043C\u043D\u043E\u0442\u0430... \u0414\u043E\u0436\u0434\u044C... \u042F \u0442\u0430\u043A \u0432\u0437\u0432\u043E\u043B\u043D\u043E\u0432\u0430\u043D\u0430.$l",
  "Rainy_Day_1": "\u041E\u0439, \u0430 \u043F\u043E\u043C\u043D\u0438\u0448\u044C, \u043A\u0430\u043A \u043C\u044B \u0441\u044B\u0433\u0440\u0430\u043B\u0438 \u0434\u0443\u044D\u0442\u043E\u043C \u0443 \u043E\u0437\u0435\u0440\u0430? \u041F\u043E\u0433\u043E\u0434\u0430 \u043C\u043D\u0435 \u043D\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0430 \u043E \u0442\u043E\u043C \u0434\u043D\u0435.#$e#\u0412\u043E\u0442 \u0442\u0430\u043A \u0441\u044E\u0440\u043F\u0440\u0438\u0437 \u0432\u044B\u0448\u0435\u043B \u2014 \u043C\u0438\u043D\u0438-\u0430\u0440\u0444\u0430... \u0422\u0430\u043A\u043E\u0433\u043E \u044F \u043D\u0435 \u043E\u0436\u0438\u0434\u0430\u043B\u0430. \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0442\u044B \u043C\u043D\u0435 \u0442\u0430\u043A \u043D\u0440\u0430\u0432\u0438\u0448\u044C\u0441\u044F.$l",
  "Rainy_Day_2": "\u041F\u0440\u0438\u0432\u0435\u0442! \u042F \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0430\u0441\u044C \u043F\u043E\u0440\u0430\u043D\u044C\u0448\u0435 \u0438 \u043F\u043E\u0431\u0440\u043E\u0434\u0438\u043B\u0430 \u043D\u0435\u043C\u043D\u043E\u0433\u043E. \u042F \u043D\u0430\u0448\u043B\u0430 \u0432\u043E\u0442 \u044D\u0442\u043E \u0438 \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u043B\u0430 \u043E \u0442\u0435\u0431\u0435.[768 767 769 66 82]#$e#\u0414\u0443\u043C\u0430\u0435\u0448\u044C, \u0442\u044B \u0441\u043C\u043E\u0436\u0435\u0448\u044C \u043D\u0430\u0439\u0442\u0438 \u0447\u0442\u043E-\u0442\u043E \u043F\u043E\u043B\u0443\u0447\u0448\u0435? \u042F \u0442\u0430\u043A \u043D\u0435 \u0434\u0443\u043C\u0430\u044E!$h",
  "Rainy_Day_3": "\u0421\u0435\u0433\u043E\u0434\u043D\u044F, \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u043D\u0435\u043F\u043B\u043E\u0445\u043E\u0439 \u0434\u0435\u043D\u044C \u0434\u043B\u044F \u043F\u043E\u0445\u043E\u0434\u0430 \u0432 \u043F\u0435\u0449\u0435\u0440\u044B? \u0422\u043E\u043B\u044C\u043A\u043E \u0431\u0443\u0434\u044C \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u0435\u0439.#$e#\u0415\u0441\u043B\u0438 \u0440\u0435\u0448\u0438\u0448\u044C \u043F\u043E\u0439\u0442\u0438, \u0432\u043E\u0437\u044C\u043C\u0438 \u0441 \u0441\u043E\u0431\u043E\u0439 \u043F\u0430\u0440\u0443 \u042D\u043B\u0438\u043A\u0441\u0438\u0440\u043E\u0432 \u0436\u0438\u0437\u043D\u0438.",
  "Rainy_Day_4": "\u041C\u043E\u0436\u0435\u0442, \u043F\u043E\u0438\u0433\u0440\u0430\u0442\u044C \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0432 \u00AB\u041F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435 \u041A\u043E\u0440\u043E\u043B\u044F \u041F\u0440\u0435\u0440\u0438\u0439\u00BB... \u041A\u043B\u044F\u043D\u0443\u0441\u044C, \u043E\u0434\u043D\u0430\u0436\u0434\u044B \u044F \u0435\u0433\u043E \u0432\u0441\u0435\u0433\u043E \u043F\u0440\u043E\u0439\u0434\u0443.$h",
  "patio_Abigail": "%\u0410\u0431\u0438\u0433\u0435\u0439\u043B \u0441\u0435\u0439\u0447\u0430\u0441 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0443\u0432\u043B\u0435\u0447\u0435\u043D\u0430 \u0441\u0432\u043E\u0435\u0439 \u043C\u0435\u043B\u043E\u0434\u0438\u0435\u0439.",
  "Rainy_Day_Abigail": "\u0412 \u0442\u0430\u043A\u043E\u0439 \u0434\u0435\u043D\u044C \u0441\u043D\u0430\u0440\u0443\u0436\u0438 \u0432\u0441\u0435 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u0435\u0435, \u043D\u0435 \u0434\u0443\u043C\u0430\u0435\u0448\u044C?",
  "Rainy_Night_0": "\u042F \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0430 \u043D\u0430 \u043B\u0435\u0441 \u043F\u043E\u0434 \u0434\u043E\u0436\u0434\u0435\u043C... \u041A\u043B\u044F\u043D\u0443\u0441\u044C, \u044F \u0432\u0438\u0434\u0435\u043B\u0430, \u043A\u0430\u043A \u0447\u0442\u043E-\u0442\u043E \u0447\u0435\u0440\u043D\u0435\u0435 \u0447\u0435\u0440\u043D\u043E\u0433\u043E \u0434\u0432\u0438\u0433\u0430\u043B\u043E\u0441\u044C \u043C\u0435\u0436\u0434\u0443 \u0434\u0435\u0440\u0435\u0432\u044C\u0435\u0432.$6",
  "Rainy_Night_1": "\u0412 \u0442\u0430\u043A\u0443\u044E \u043D\u043E\u0447\u044C \u043C\u043E\u0436\u043D\u043E \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u043F\u0440\u0438\u0432\u0438\u0434\u0435\u043D\u0438\u0439...",
  "Rainy_Night_2": "\u0427\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044C? \u0427\u0442\u043E-\u0442\u043E \u0437\u0430\u043C\u0435\u0440\u043B\u043E \u0432 \u0434\u043E\u0436\u0434\u0435...",
  "Rainy_Night_3": "\u0422\u0430\u043A\u0438\u043C\u0438 \u0432\u0435\u0447\u0435\u0440\u0430\u043C\u0438 \u044F \u043B\u044E\u0431\u043B\u044E \u043F\u0440\u0438\u0433\u043B\u0443\u0448\u0438\u0442\u044C \u0441\u0432\u0435\u0442 \u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043B\u0443\u0448\u0430\u0442\u044C...$8",
  "Rainy_Night_4": "\u042F \u0440\u0435\u0448\u0438\u043B\u0430 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u0441\u0443\u043F \u043D\u0430 \u0443\u0436\u0438\u043D. \u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u043E\u043D \u0432\u044B\u0448\u0435\u043B \u043D\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u0435\u0440\u0437\u043A\u0438\u043C. [199 218 219 727 730]$h",
  "Rainy_Night_5": "\u041F\u0440\u0438\u0432\u0435\u0442! \u041F\u043E\u0445\u043E\u0436\u0435, \u0442\u044B \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043C\u043D\u043E\u0433\u043E \u0442\u0440\u0443\u0434\u0438\u0448\u044C\u0441\u044F. \u041F\u043E\u043C\u043E\u0447\u044C \u0442\u0435\u0431\u0435 \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u0438\u0442\u044C\u0441\u044F?^\u041C\u043D\u043E\u0433\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0448\u044C \u0441\u0435\u0433\u043E\u0434\u043D\u044F? \u0422\u044B \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0448\u044C \u0442\u0430\u043A \u043C\u0438\u043B\u043E, \u043A\u043E\u0433\u0434\u0430 \u0443\u0441\u0442\u0430\u0435\u0448\u044C \u043D\u0435\u043C\u043D\u043E\u0433\u043E.$h",
  "Rainy_Night_Abigail": "\u041C\u044B \u0431\u044B\u0441\u0442\u0440\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0437\u0430\u0441\u043D\u0435\u043C \u043F\u043E\u0434 \u0448\u0443\u043C \u0434\u043E\u0436\u0434\u044F.",
  "Indoor_Day_0": "\u041C\u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u043D\u0440\u0430\u0432\u0438\u043B\u043E\u0441\u044C \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E, \u0435\u0449\u0435 \u0437\u0430\u0434\u043E\u043B\u0433\u043E \u0434\u043E \u0442\u0432\u043E\u0435\u0433\u043E \u043F\u0440\u0438\u0435\u0437\u0434\u0430. \u0410 \u0442\u0435\u043F\u0435\u0440\u044C \u044F \u043C\u043E\u0433\u0443 \u0433\u0443\u043B\u044F\u0442\u044C \u043F\u043E \u0444\u0435\u0440\u043C\u0435 \u043A\u043E\u0433\u0434\u0430 \u0437\u0430\u0445\u043E\u0447\u0443!$h",
  "Indoor_Day_1": "\u041F\u0440\u0438\u0432\u0435\u0442, @. \u0421\u043E\u0431\u0438\u0440\u0430\u0435\u0448\u044C\u0441\u044F \u0432 \u043B\u0435\u0441? \u0423 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u0434\u043B\u044F \u0442\u0435\u0431\u044F \u043A\u043E\u0435-\u0447\u0442\u043E...[286 287 205 732]#$e#\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u044D\u0442\u043E, \u0435\u0441\u043B\u0438 \u0441\u0442\u0430\u043D\u0435\u0442 \u0442\u044F\u0436\u0435\u043B\u043E. \u0421 \u044D\u0442\u0438\u043C \u0442\u0435\u0431\u0435 \u0431\u0443\u0434\u0435\u0442 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0435\u0435.",
  "Indoor_Day_2": "\u0421\u043E\u0431\u0438\u0440\u0430\u0435\u0448\u044C\u0441\u044F \u0432 \u0448\u0430\u0445\u0442\u0443? \u0421\u043B\u0443\u0448\u0430\u0439... \u0415\u0441\u043B\u0438 \u043D\u0430\u0439\u0434\u0435\u0448\u044C \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0432\u043A\u0443\u0441\u043D\u0435\u043D\u044C\u043A\u043E\u0435, \u0437\u0430\u0445\u0432\u0430\u0442\u0438 \u0438 \u043C\u043D\u0435 \u043A\u0443\u0441\u043E\u0447\u0435\u043A!$h",
  "Indoor_Day_3": "\u041F\u0440\u0438\u0432\u0435\u0442! \u042F \u0432\u043E\u0442 \u0434\u0443\u043C\u0430\u044E, \u0447\u0435\u043C \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0437\u0430\u043D\u044F\u0442\u044C\u0441\u044F. \u042F \u043D\u0435 \u043F\u0440\u0438\u0432\u044B\u043A\u043B\u0430 \u043A \u0442\u0430\u043A\u043E\u0439 \u0441\u0432\u043E\u0431\u043E\u0434\u0435!",
  "Indoor_Day_4": "\u0422\u044B \u0432\u0435\u0434\u044C \u043D\u0435 \u0432\u043E\u0437\u0440\u0430\u0436\u0430\u0435\u0448\u044C, \u0435\u0441\u043B\u0438 \u044F \u0431\u0443\u0434\u0443 \u0438\u043D\u043E\u0433\u0434\u0430 \u0443\u043A\u0440\u0430\u0448\u0430\u0442\u044C \u0434\u043E\u043C? \u042F \u0432\u0441\u0435 \u0435\u0449\u0435 \u0440\u0430\u0434\u0443\u044E\u0441\u044C, \u0447\u0442\u043E \u0443 \u043C\u0435\u043D\u044F \u0442\u0435\u043F\u0435\u0440\u044C \u0446\u0435\u043B\u044B\u0439 \u0434\u043E\u043C \u0434\u043B\u044F \u044D\u0442\u043E\u0433\u043E.",
  "Indoor_Day_Abigail": "\u0423 \u043D\u0430\u0441 \u043D\u0430 \u0444\u0435\u0440\u043C\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442 \u0447\u0442\u043E-\u0442\u043E \u043D\u043E\u0432\u043E\u0435... \u041E\u0431\u043E\u0436\u0430\u044E.",
  "Indoor_Night_0": "\u0423 \u043C\u0435\u043D\u044F \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0431\u044B\u043B \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0434\u0435\u043D\u044C. \u0417\u0434\u0435\u0441\u044C \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E\u0435, \u0435\u0441\u043B\u0438 \u0445\u043E\u0440\u043E\u0448\u043E \u043F\u0440\u0438\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C\u0441\u044F.",
  "Indoor_Night_1": "\u041F\u0440\u0438\u0432\u0435\u0442! \u041F\u043E\u0432\u0435\u0434\u0430\u0439 \u043C\u043D\u0435, \u043A\u0430\u043A \u043F\u0440\u043E\u0448\u0435\u043B \u0442\u0432\u043E\u0439 \u0434\u0435\u043D\u044C? \u0411\u044B\u043B\u043E \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E\u0435?$h",
  "Indoor_Night_2": "\u0420\u0430\u043D\u044C\u0448\u0435 \u044F \u0431\u044B\u043B\u0430 \u0441\u043E\u0432\u043E\u0439, \u043D\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u044F \u0432\u043E\u0448\u043B\u0430 \u0432 \u0440\u0438\u0442\u043C \u0436\u0438\u0437\u043D\u0438 \u043D\u0430 \u0444\u0435\u0440\u043C\u0435. \u041E\u043D \u0442\u0430\u043A\u043E\u0439 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439.",
  "Indoor_Night_3": "*\u0417\u0435\u0432\u0430\u0435\u0442*... \u042F \u0433\u043E\u0442\u043E\u0432\u0430 \u0441\u043A\u043E\u0440\u043E \u043F\u043E\u0439\u0442\u0438 \u0441\u043F\u0430\u0442\u044C.$h",
  "Indoor_Night_4": "\u0417\u0432\u0443\u043A\u0438 \u043D\u043E\u0447\u0438 \u0437\u0434\u0435\u0441\u044C \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u0433\u0440\u043E\u043C\u0447\u0435. \u042D\u0442\u043E \u043C\u043D\u0435 \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043D\u0430\u0434\u043E\u0435\u0441\u0442.",
  "Indoor_Night_Abigail": "\u041D\u0443 \u0447\u0442\u043E, \u0441\u043A\u043E\u0440\u043E \u0441\u043F\u0430\u0442\u044C? \u042F \u0432\u043A\u043B\u044E\u0447\u0438\u043B\u0430 \u043D\u0430\u043C \u043F\u043E\u0434\u043E\u0433\u0440\u0435\u0432 \u0432 \u043E\u0434\u0435\u044F\u043B\u0435...$l",
  "Outdoor_0": "\u041C\u044F\u0433\u043A\u0438\u0439 \u0432\u0435\u0442\u0435\u0440\u043E\u043A \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0440\u0430\u0437\u043D\u043E\u0441\u0438\u0442 \u0433\u043E\u0440\u043D\u044B\u0439 \u0432\u043E\u0437\u0434\u0443\u0445 \u043F\u043E \u0432\u0441\u0435\u0439 \u0434\u043E\u043B\u0438\u043D\u0435. \u041E\u043D \u043F\u0430\u0445\u043D\u0435\u0442 \u0441\u043E\u0441\u043D\u043E\u0439 \u0438 \u0448\u0430\u043B\u0444\u0435\u0435\u043C.",
  "Outdoor_1": "\u0425\u043C-\u043C... \u0414\u0443\u043C\u0430\u044E, \u0443 \u043D\u0430\u0441 \u0442\u0443\u0442 \u043F\u043E\u043B\u043D\u043E \u043C\u0435\u0441\u0442\u0430, \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0437\u0432\u043E\u0434\u0438\u0442\u044C \u0441\u043B\u0430\u0439\u043C\u043E\u0432!",
  "Outdoor_2": "\u041D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C \u0432 \u0447\u0438\u0441\u0442\u043E\u0442\u0435 \u0434\u0435\u0434\u0443\u0448\u043A\u0438\u043D \u043C\u0435\u043C\u043E\u0440\u0438\u0430\u043B. \u0412 \u043D\u0435\u043C \u0435\u0441\u0442\u044C \u0447\u0442\u043E-\u0442\u043E \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0435, \u044F \u044D\u0442\u043E \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E.",
  "Outdoor_3": "\u041A\u0440\u0443\u0442\u043E, \u0447\u0442\u043E \u043D\u0430 \u043D\u0430\u0448\u0435\u0439 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438 \u0435\u0441\u0442\u044C \u043F\u0435\u0449\u0435\u0440\u0430. \u042F \u0432\u0441\u0435\u0433\u0434\u0430 \u043C\u0435\u0447\u0442\u0430\u043B\u0430 \u043E \u0442\u0430\u043A\u043E\u043C.$h",
  "Outdoor_4": "\u042F \u0432\u0441\u0435\u0433\u0434\u0430 \u0437\u0430\u0431\u044B\u0432\u0430\u044E \u0432\u0437\u044F\u0442\u044C \u0441 \u0441\u043E\u0431\u043E\u0439 \u043F\u0435\u0440\u0435\u043A\u0443\u0441\u0438\u0442\u044C. *\u0411\u0443\u0440\u0447\u0430\u043D\u0438\u0435*$h",
  "Outdoor_Abigail": "\u042F \u043F\u043E\u043A\u0430 \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u0431\u0443\u0434\u0443 \u0437\u0434\u0435\u0441\u044C, \u043B\u0430\u0434\u043D\u043E?#$e#\u0417\u0434\u0435\u0441\u044C \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0445 \u0436\u0443\u0447\u043A\u043E\u0432, \u0438 \u0435\u0449\u0435 \u043C\u043D\u043E\u0433\u043E \u0447\u0435\u0433\u043E. *\u0425\u0438\u0445\u0438\u043A\u0430\u0435\u0442*$h",
  "funLeave_Abigail": "\u041F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u044E, \u044F \u043F\u043E\u0439\u0434\u0443 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0432 \u0433\u043E\u0440\u043E\u0434. \u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0440\u0430\u0437\u043C\u044F\u0442\u044C \u043D\u043E\u0433\u0438.",
  "funReturn_Abigail": "\u041F\u0440\u0438\u0432\u0435\u0442! \u041A\u0430\u043A \u043F\u0440\u043E\u0448\u0435\u043B \u0442\u0432\u043E\u0439 \u0434\u0435\u043D\u044C? \u041C\u043E\u0439 \u2014 \u0445\u043E\u0440\u043E\u0448\u043E. \u041F\u0440\u043E\u0433\u0443\u043B\u043A\u0430 \u0431\u044B\u043B\u0430 \u0442\u0430\u043A\u043E\u0439 \u043E\u0441\u0432\u0435\u0436\u0430\u044E\u0449\u0435\u0439.$h",
  "OneKid_3": "\u0414\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u043D\u0435 \u0432\u0435\u0440\u0438\u0442\u0441\u044F, \u0447\u0442\u043E \u044F \u2014 \u00AB\u043C\u0430\u043C\u0430\u00BB. \u0416\u0438\u0437\u043D\u044C \u0442\u0430\u043A\u0430\u044F \u0441\u0442\u0440\u0430\u043D\u043D\u0430\u044F.$h",
  "TwoKids_0": "%kid1 \u0438 %kid2 \u0443\u0436\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438 \u0441\u0432\u043E\u0438 \u0448\u043E\u043A\u043E\u043B\u0430\u0434\u043D\u044B\u0435 \u0445\u043B\u043E\u043F\u044C\u044F. \u041E\u043D\u0438 \u043F\u0440\u044F\u043C\u043E \u0432\u0438\u0437\u0436\u0430\u043B\u0438 \u043E\u0442 \u0432\u043E\u0441\u0442\u043E\u0440\u0433\u0430!",
  "TwoKids_2": "\u041C\u043D\u0435 \u0441\u043D\u0438\u043B\u043E\u0441\u044C, \u0447\u0442\u043E %kid2 \u0442\u0435\u043F\u0435\u0440\u044C \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u044B\u0439 \u043E\u0445\u043E\u0442\u043D\u0438\u043A \u043D\u0430 \u0447\u0443\u0434\u043E\u0432\u0438\u0449. \u042F \u0434\u0430\u0436\u0435 \u0437\u0430\u0434\u0443\u043C\u0430\u043B\u0430\u0441\u044C \u043E \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0435 \u0434\u0435\u0442\u0441\u043A\u043E\u0439 \u0431\u0440\u043E\u043D\u0438.",
  "TwoKids_3": "\u041A\u0440\u0443\u0442\u043E\u0439 \u0441\u0442\u0430\u0440\u044B\u0439 \u0434\u043E\u043C, \u0434\u0432\u043E\u0435 \u0434\u0435\u0442\u0435\u0439 \u0438 \u0437\u0430\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u0444\u0435\u0440\u043C\u0430. \u041D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0434\u0443\u043C\u0430\u043B\u0430, \u0447\u0442\u043E \u0442\u0430\u043A \u0434\u0430\u043B\u0435\u043A\u043E \u0437\u0430\u0439\u0434\u0443, \u043D\u043E... \u041D\u0430\u0448\u0430 \u0436\u0438\u0437\u043D\u044C \u0435\u0449\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F.$h",
  "Good_1": "\u0422\u044B \u044D\u0442\u043E ${\u0441\u043B\u044B\u0448\u0430\u043B^\u0441\u043B\u044B\u0448\u0430\u043B\u0430}$? \u0418\u043D\u043E\u0433\u0434\u0430 \u044F \u0433\u043E\u0442\u043E\u0432\u0430 \u0431\u0438\u0442\u044C\u0441\u044F \u043E\u0431 \u0437\u0430\u043A\u043B\u0430\u0434, \u0447\u0442\u043E \u0432 \u043D\u0430\u0448\u0435\u043C \u0434\u043E\u043C\u0435 \u043F\u0440\u0438\u0432\u0438\u0434\u0435\u043D\u0438\u044F.$u",
  "Good_2": "\u0413\u043E\u0440\u043E\u0441\u043A\u043E\u043F \u0412\u0435\u043B\u0432\u0438\u043A\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0441\u0443\u043B\u0438\u0442 \u043C\u043D\u0435 \u0445\u043E\u0440\u043E\u0448\u0435\u0435. \u042F \u0433\u043E\u0442\u043E\u0432\u0430 \u043A\u043E \u0432\u0441\u0435\u043C\u0443!",
  "Good_3": "\u0414\u0430\u0436\u0435 \u043D\u0435 \u043F\u043E\u043C\u043D\u044E, \u043A\u043E\u0433\u0434\u0430 \u044F \u043A\u0440\u0430\u0441\u0438\u043B\u0430\u0441\u044C \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0440\u0430\u0437... \u041A\u043B\u044F\u043D\u0443\u0441\u044C, \u044D\u0442\u043E\u0442 \u0446\u0432\u0435\u0442 \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0432\u044B\u0446\u0432\u0435\u0442\u0430\u0435\u0442...",
  "Good_4": "\u042F \u0440\u0430\u0434\u0430, \u0447\u0442\u043E \u043F\u0435\u0440\u0435\u0434 \u043F\u0435\u0440\u0435\u0435\u0437\u0434\u043E\u043C \u0443 \u043C\u0435\u043D\u044F \u0431\u044B\u043B\u0430 \u043F\u0430\u0440\u0430 \u0442\u044F\u0436\u0435\u043B\u044B\u0445 \u0441\u0430\u043F\u043E\u0433. \u0422\u044F\u0436\u0435\u043B\u043E \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044C, \u043A\u0430\u043A\u043E\u0432\u043E \u043B\u0430\u0437\u0430\u0442\u044C \u043F\u043E \u0433\u0440\u044F\u0437\u0438 \u0432 \u043A\u0435\u0434\u0430\u0445.$h",
  "Good_5": "\u042F \u0442\u0443\u0442 \u043B\u044E\u0431\u0443\u044E\u0441\u044C \u0442\u0432\u043E\u0438\u043C \u043F\u043E\u0434\u0430\u0440\u043A\u043E\u043C, \u041A\u0443\u043B\u043E\u043D\u043E\u043C \u0420\u0443\u0441\u0430\u043B\u043A\u0438. \u042F \u0431\u0443\u0434\u0443 \u043D\u043E\u0441\u0438\u0442\u044C \u0435\u0433\u043E \u0441 \u0433\u043E\u0440\u0434\u043E\u0441\u0442\u044C\u044E \u0434\u043E \u0441\u0430\u043C\u043E\u0433\u043E \u0433\u0440\u043E\u0431\u0430.$l",
  "Good_6": "\u041F\u0440\u0438\u0432\u0435\u0442. \u042F \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u0437\u0430 \u0441\u0435\u0431\u044F \u043F\u043E\u0441\u0442\u043E\u044F\u0442\u044C, \u043D\u043E \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E \u0438\u043D\u043E\u0433\u0434\u0430 \u0432\u043E\u043B\u043D\u0443\u044E\u0441\u044C \u0437\u0430 \u0442\u0435\u0431\u044F. \u0412 \u043C\u0438\u0440\u0435 \u043F\u043E\u043B\u043D\u043E \u0447\u0443\u0434\u043E\u0432\u0438\u0449.$6#$e#\u041F\u0440\u043E\u0441\u0442\u043E \u043E\u0431\u0435\u0449\u0430\u0439 \u043C\u043D\u0435, \u0447\u0442\u043E \u0431\u0443\u0434\u0435\u0448\u044C \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u0435\u0435. \u041D\u0435 \u0445\u043E\u0447\u0443 \u0442\u0435\u0431\u044F \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C.",
  "Good_7": "@? \u042F \u043F\u0440\u043E\u0441\u0442\u043E \u0445\u043E\u0442\u0435\u043B\u0430 \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C \u0442\u0435\u0431\u044F \u0437\u0430 \u0440\u0430\u0431\u043E\u0442\u0443, \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0442\u044B \u0434\u0435\u043B\u0430\u0435\u0448\u044C \u0440\u0430\u0434\u0438 \u043D\u0430\u0441. \u042F \u043E\u0447\u0435\u043D\u044C \u0442\u043E\u0431\u043E\u0439 \u0433\u043E\u0440\u0436\u0443\u0441\u044C.$l",
  "Neutral_0": "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0442\u044B \u0432\u0441\u0435 \u0435\u0449\u0435 \u0431\u0443\u0434\u0435\u0448\u044C \u043C\u0435\u043D\u044F \u043B\u044E\u0431\u0438\u0442\u044C, \u043A\u043E\u0433\u0434\u0430 \u044F \u043F\u043E\u0441\u0442\u0430\u0440\u0435\u044E \u0438 \u0441\u043C\u043E\u0440\u0449\u0443\u0441\u044C. \u042D\u0442\u043E \u0432\u0435\u0434\u044C \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u0441\u043B\u0443\u0447\u0438\u0442\u0441\u044F!",
  "Neutral_1": "\u041A\u0430\u043A \u0434\u0443\u043C\u0430\u0435\u0448\u044C, \u0442\u0432\u043E\u0439 \u0434\u0435\u0434\u0443\u0448\u043A\u0430 \u0431\u044B \u043D\u0430\u043C\u0438 \u0433\u043E\u0440\u0434\u0438\u043B\u0441\u044F?",
  "Neutral_6": "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043A\u0430\u043A \u0434\u0435\u043B\u0430 \u0432 \u043D\u0430\u0448\u0435\u043C \u0441\u0442\u0430\u0440\u043E\u043C \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435? \u041D\u0430\u0434\u043E \u0431\u0443\u0434\u0435\u0442 \u0437\u0430\u0439\u0442\u0438 \u043A \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u044F\u043C \u0432 \u0433\u043E\u0441\u0442\u0438.",
  "Neutral_7": "\u0415\u0441\u043B\u0438 \u0442\u044B \u0443\u0439\u0434\u0435\u0448\u044C \u0432 \u043C\u0438\u0440 \u0434\u0443\u0445\u043E\u0432, \u044F \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u044E \u0442\u0435\u0431\u0435 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u043C\u0435\u043C\u043E\u0440\u0438\u0430\u043B \u0440\u044F\u0434\u043E\u043C \u0441 \u0434\u0435\u0434\u0443\u0448\u043A\u0438\u043D\u044B\u043C.",
  "Neutral_8": "\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u0431\u044B \u043C\u044B \u043D\u0438 \u0443\u0431\u0438\u0440\u0430\u043B\u0438\u0441\u044C, \u0432 \u0434\u043E\u043C\u0435 \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E \u043E\u043F\u044F\u0442\u044C \u0431\u0443\u0434\u0435\u0442 \u0433\u0440\u044F\u0437\u043D\u043E.#$e#\u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u043D\u0430 \u0444\u0435\u0440\u043C\u0435 \u043F\u043E-\u0434\u0440\u0443\u0433\u043E\u043C\u0443 \u043D\u0438\u043A\u0430\u043A.",
  "Neutral_9": "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043F\u0440\u043E\u0436\u0438\u0432\u0435\u043C \u043B\u0438 \u043C\u044B \u0437\u0434\u0435\u0441\u044C \u0432\u0441\u044E \u0436\u0438\u0437\u043D\u044C? \u041C\u043D\u0435 \u044D\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u043D\u0430\u0441\u043A\u0443\u0447\u0438\u0442\u044C.",
  "Bad_7": "\u0420\u0430\u043D\u044C\u0448\u0435 \u044F \u0431\u044B\u043B\u0430 \u0434\u043B\u044F \u0442\u0435\u0431\u044F \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0439, \u0442\u0432\u043E\u0438\u043C \u043B\u0443\u0447\u0448\u0438\u043C \u0434\u0440\u0443\u0433\u043E\u043C... \u0410 \u0442\u0435\u043F\u0435\u0440\u044C \u0442\u044B \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0448\u044C \u043E\u0431\u043E \u043C\u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u043E\u0433\u0434\u0430, \u043A\u043E\u0433\u0434\u0430 \u0445\u043E\u0447\u0435\u0448\u044C \u043F\u043E\u0435\u0441\u0442\u044C.$s",
  "Bad_8": "\u0412 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0432\u0440\u0435\u043C\u044F \u0442\u044B \u043E\u0442 \u043C\u0435\u043D\u044F \u043E\u0442\u0441\u0442\u0440\u0430\u043D\u044F\u0435\u0448\u044C\u0441\u044F... \u0427\u0442\u043E \u0441 \u0442\u043E\u0431\u043E\u0439 \u043D\u0435 \u0442\u0430\u043A? \u0422\u044B \u0442\u0435\u043F\u0435\u0440\u044C \u0431\u0443\u0434\u0442\u043E \u0431\u043E\u043B\u043E\u0442\u043D\u044B\u0439 \u0434\u0443\u0445...$s",
  "Bad_9": "\u041C\u043E\u0436\u0435\u0442, \u044F \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043B\u0430 \u043B\u0443\u0447\u0448\u0435\u0433\u043E... \u041F\u043E\u043A\u0430 \u044F \u043D\u0435 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0430 \u0442\u0435\u0431\u044F, \u043C\u044B \u0431\u044B\u043B\u0438 \u0445\u043E\u0440\u043E\u0448\u0438\u043C\u0438 \u0434\u0440\u0443\u0437\u044C\u044F\u043C\u0438 \u0441 \u0421\u0435\u0431\u0430\u0441\u0442\u0438\u0430\u043D\u043E\u043C. \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u044D\u0442\u043E \u043E\u043D \u0431\u044B\u043B \u043C\u043E\u0438\u043C \u0441\u0443\u0436\u0435\u043D\u044B\u043C...$s",
  "spring_1": "\u041D\u0443 \u043A\u0430\u043A, \u0435\u0441\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u043F\u043B\u0430\u043D\u044B \u043D\u0430 \u043D\u043E\u0432\u044B\u0439 \u0433\u043E\u0434?",
  "spring_12": "\u041E\u0439, \u0437\u0430\u0432\u0442\u0440\u0430 \u0436\u0435 \u044F\u0438\u0447\u043D\u044B\u0439 \u0444\u0435\u0441\u0442\u0438\u0432\u0430\u043B\u044C. \u041F\u0440\u043E\u0441\u0442\u0438, \u043D\u043E \u044F \u043D\u0435 \u0431\u0443\u0434\u0443 \u0442\u0435\u0431\u0435 \u043F\u043E\u0434\u0434\u0430\u0432\u0430\u0442\u044C\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0442\u043E\u043C\u0443, \u0447\u0442\u043E \u043C\u044B \u0436\u0435\u043D\u0430\u0442\u044B!$h#$e#\u042F \u043F\u043B\u0430\u043D\u0438\u0440\u0443\u044E \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u044C \u0432 \u043E\u0445\u043E\u0442\u0435 \u0437\u0430 \u044F\u0439\u0446\u0430\u043C\u0438. \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u043C\u0435\u043D\u044F \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u044C!",
  "spring_2": "\u0423 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C \u043D\u043E\u0432\u043E\u0433\u043E\u0434\u043D\u0438\u0435 \u0437\u0430\u0440\u043E\u043A\u0438? \u042F \u0432\u043E\u0442 \u0445\u043E\u0447\u0443 \u0441\u0431\u0440\u043E\u0441\u0438\u0442\u044C \u043F\u0430\u0440\u0443 \u043A\u0438\u043B\u043E\u0433\u0440\u0430\u043C\u043C.$h",
  "summer_1": "\u042F \u043B\u0435\u0433\u043A\u043E \u043E\u0431\u0433\u043E\u0440\u0430\u044E \u043D\u0430 \u0441\u043E\u043B\u043D\u0446\u0435, \u0442\u0430\u043A \u0447\u0442\u043E \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0431\u044B\u0442\u044C \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u0435\u0435.#$e#\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0442\u0435\u0431\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u043C\u043E\u044F \u0431\u043B\u0435\u0434\u043D\u043E\u0441\u0442\u044C!$h",
  "summer_4": "\u0421\u043C\u043E\u0442\u0440\u0438 \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438 \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u044B\u0439 \u0443\u0434\u0430\u0440, \u043B\u044E\u0431\u043E\u0432\u044C \u043C\u043E\u044F.#$e#\u041F\u0435\u0439 \u043C\u043D\u043E\u0433\u043E \u0432\u043E\u0434\u044B \u0438 \u043D\u0435 \u043F\u0435\u0440\u0435\u0442\u0440\u0443\u0436\u0434\u0430\u0439\u0441\u044F.",
  "summer_8": "\u041F\u0440\u043E\u0441\u0442\u0438 \u0437\u0430 \u0442\u0430\u043A\u043E\u0439 \u0437\u0430\u043F\u0430\u0445... \u042F \u043D\u043E\u0447\u044C\u044E \u0441\u0438\u043B\u044C\u043D\u043E \u043F\u043E\u0442\u0435\u044E \u043E\u0442 \u0436\u0430\u0440\u044B.",
  "summer_15": "\u0412\u043E\u0442 \u0438 \u043B\u0435\u0442\u043E... \u0422\u0435\u043F\u0435\u0440\u044C \u0432 \u0434\u043E\u043C\u0435 \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u043B\u043D\u043E \u043C\u0443\u0445.#$e#\u041D\u0435 \u0432\u043E\u043B\u043D\u0443\u0439\u0441\u044F, \u044F \u0441 \u043D\u0438\u043C\u0438 \u0440\u0430\u0437\u0431\u0435\u0440\u0443\u0441\u044C. \u042D\u0442\u043E \u0432\u0435\u0441\u0435\u043B\u043E!$h",
  "fall_6": "\u0410\u0445... \u041E\u0441\u0435\u043D\u044C. \u042D\u0442\u043E, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u043C\u043E\u0435 \u043B\u044E\u0431\u0438\u043C\u043E\u0435 \u0432\u0440\u0435\u043C\u044F \u0433\u043E\u0434\u0430. \u0415\u0435 \u0446\u0432\u0435\u0442\u0430 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0442 \u043A \u043C\u043E\u0438\u043C \u0432\u043E\u043B\u043E\u0441\u0430\u043C, \u0442\u044B \u0442\u0430\u043A \u043D\u0435 \u0434\u0443\u043C\u0430\u0435\u0448\u044C?",
  "fall_1": "\u042D\u0442\u043E\u0442 \u0437\u0430\u043F\u0430\u0445 \u043D\u0435 \u0441\u043F\u0443\u0442\u0430\u0442\u044C \u043D\u0438 \u0441 \u0447\u0435\u043C... \u0413\u0440\u0438\u0431\u044B, \u0433\u043D\u0438\u044E\u0449\u0438\u0435 \u043B\u0438\u0441\u0442\u044C\u044F, \u0442\u044B\u043A\u0432\u0430. \u042D\u0442\u043E \u043E\u0441\u0435\u043D\u044C. \u0420\u0430\u0437\u0432\u0435 \u043D\u0435 \u0447\u0443\u0434\u0435\u0441\u043D\u043E?",
  "fall_2": "\u041C\u043E\u0436\u043D\u043E, \u043C\u044B \u0432 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u0431\u0443\u0434\u0435\u043C \u0432\u044B\u0440\u0430\u0449\u0438\u0432\u0430\u0442\u044C \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0435 \u0442\u044B\u043A\u0432\u044B? \u0421\u043E\u043B\u043D\u044B\u0448\u043A\u043E, \u043D\u0443 \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430?$h",
  "fall_20": "\u041B\u044E\u0431\u043E\u0432\u044C \u043C\u043E\u044F... \u0422\u044B \u0434\u043B\u044F \u043C\u0435\u043D\u044F \u0434\u043E\u0440\u043E\u0436\u0435, \u0447\u0435\u043C \u043F\u043E\u043B\u043D\u044B\u0439 \u0441\u0443\u043D\u0434\u0443\u043A \u043A\u0432\u0430\u0440\u0446\u0430.#$e#\u0410 \u0435\u0441\u043B\u0438 \u0432 \u0441\u0443\u043D\u0434\u0443\u043A\u0435 \u0430\u043C\u0435\u0442\u0438\u0441\u0442\u044B? \u0425\u043C-\u043C... \u0410 \u043D\u0430\u0434 \u044D\u0442\u0438\u043C \u0443\u0436\u0435 \u043D\u0430\u0434\u043E \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u044C.$h",
  "winter_3": "\u041D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435, \u043C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F \u043F\u043E\u0433\u043E\u0434\u0430. \u0421\u0440\u0430\u0437\u0443 \u0435\u0441\u0442\u044C \u043F\u043E\u0432\u043E\u0434 \u0443\u0441\u0442\u0440\u043E\u0438\u0442\u044C\u0441\u044F \u043F\u043E\u0443\u044E\u0442\u043D\u0435\u0435!$h",
  "winter_15": "\u0412\u0435\u0441\u0435\u043B\u043E \u0431\u0440\u043E\u0434\u0438\u0442\u044C \u0437\u0438\u043C\u043E\u0439 \u043F\u043E \u0434\u043E\u043B\u0438\u043D\u0435! \u041F\u043E\u0434 \u0441\u043D\u0435\u0436\u043D\u044B\u043C \u043E\u0434\u0435\u044F\u043B\u043E\u043C \u0432\u0441\u0435 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043F\u043E-\u0434\u0440\u0443\u0433\u043E\u043C\u0443. \u0418 \u0442\u0430\u043A \u0442\u0438\u0445\u043E \u0432\u043E\u043A\u0440\u0443\u0433...",
  "spring_Abigail": "\u041F\u0443\u0441\u043A\u0430\u0439 \u043C\u043D\u0435 \u0438 \u043D\u0440\u0430\u0432\u044F\u0442\u0441\u044F \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0430 \u0433\u043E\u0434\u0430, \u043D\u043E \u0432 \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u043C \u0438\u0442\u043E\u0433\u0435 \u044F \u0432\u0441\u0435\u0433\u0434\u0430 \u0440\u0430\u0434\u0443\u044E\u0441\u044C \u043F\u0440\u0438\u0445\u043E\u0434\u0443 \u0432\u0435\u0441\u043D\u044B.",
  "summer_Abigail": "\u041D\u0443 \u0432\u043E\u0442... \u0421\u0435\u0439\u0447\u0430\u0441 \u0431\u044B \u0442\u043E\u0440\u0442\u0430 \u0448\u043E\u043A\u043E\u043B\u0430\u0434\u043D\u043E\u0433\u043E.",
  "fall_Abigail": "\u041C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0438\u043B\u0438 \u043E\u0442 \u0442\u0435\u0431\u044F \u043F\u0430\u0445\u043D\u0435\u0442 \u0442\u044B\u043A\u0432\u043E\u0439? \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u044D\u0442\u043E \u044F \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0440\u0430\u0437\u043C\u0435\u0447\u0442\u0430\u043B\u0430\u0441\u044C...$h",
  "winter_Abigail": "\u041F\u043E\u043C\u043D\u0438\u0448\u044C, \u043A\u0430\u043A \u043C\u044B \u0438\u0433\u0440\u0430\u043B\u0438 \u0432\u043C\u0435\u0441\u0442\u0435 \u0443 \u043C\u0435\u043D\u044F \u0434\u043E\u043C\u0430 \u0432 \u00AB\u041A\u043E\u0440\u043E\u043B\u044F \u041F\u0440\u0435\u0440\u0438\u0439\u00BB, \u0434\u0430\u0432\u043D\u044B\u043C-\u0434\u0430\u0432\u043D\u043E? \u0425\u043E\u0440\u043E\u0448\u0438\u0435 \u0431\u044B\u043B\u0438 \u0432\u0440\u0435\u043C\u0435\u043D\u0430.$h",
  "spouseRoom_Abigail": "#$c .5#\u042F \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u0441\u0442\u0430\u043B\u0430 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0440\u0430\u043D\u044C\u0448\u0435 \u0442\u0435\u0431\u044F \u0438 \u043F\u043E\u043A\u043E\u0440\u043C\u0438\u043B\u0430 \u0414\u044D\u0432\u0438\u0434\u0430-\u043C\u043B\u0430\u0434\u0448\u0435\u0433\u043E. \u041E\u043D \u043E\u0447\u0435\u043D\u044C \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0439 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0441 \u0443\u0442\u0440\u0430.#$e#\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0442\u0435\u0431\u0435 \u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u043C\u0435\u0448\u0430\u0435\u0442 \u0437\u0430\u043F\u0430\u0445 \u043E\u0442 \u043C\u043E\u0440\u0441\u043A\u0438\u0445 \u0441\u0432\u0438\u043D\u043E\u043A."
}