{
  "Introduction": "\u0410! \u0412\u044B \u0432\u0435\u0434\u044C \u043D\u0435\u0434\u0430\u0432\u043D\u043E \u0437\u0434\u0435\u0441\u044C, \u0434\u0430?#$b#\u042F \u041C\u0430\u0440\u0443. \u042F \u043A\u0430\u043A \u0440\u0430\u0437 \u0445\u043E\u0442\u0435\u043B\u0430 \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u044C\u0441\u044F!$h#$e#\u0417\u043D\u0430\u0435\u0442\u0435, \u0432 \u0442\u0430\u043A\u043E\u043C \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u043C \u0433\u043E\u0440\u043E\u0434\u043A\u0435 \u043D\u043E\u0432\u043E\u0435 \u043B\u0438\u0446\u043E \u043C\u043E\u0436\u0435\u0442 \u0441\u0438\u043B\u044C\u043D\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0434\u0438\u043D\u0430\u043C\u0438\u043A\u0443 \u0441\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430. \u042D\u0442\u043E \u0442\u0430\u043A \u0437\u0434\u043E\u0440\u043E\u0432\u043E!",
  "FlowerDance_Accept": "\u0425\u0435-\u0445\u0435... \u041A\u043E\u043D\u0435\u0447\u043D\u043E! \u0412\u043D\u0435\u0437\u0430\u043F\u043D\u043E \u0442\u0430\u043D\u0446\u044B \u0443\u0436\u0435 \u043D\u0435 \u043A\u0430\u0436\u0443\u0442\u0441\u044F \u0442\u0430\u043A\u0438\u043C\u0438 \u0441\u043A\u0443\u0447\u043D\u044B\u043C\u0438.$h",
  "AcceptBirthdayGift_Positive": "\u042D\u0439, \u044D\u0442\u043E \u0447\u0442\u043E, \u043F\u043E\u0434\u0430\u0440\u043E\u043A? \u041A\u0430\u043A \u0437\u0434\u043E\u0440\u043E\u0432\u043E! \u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E \u043F\u043E\u043C\u043D\u0438\u0448\u044C!$h",
  "AcceptBirthdayGift_Negative": "\u042D\u0439, \u044D\u0442\u043E \u0447\u0442\u043E, \u043F\u043E\u0434\u0430\u0440\u043E\u043A? \u042D\u0442\u043E... \u041D\u0443 \u0434\u0430, \u043F\u043E\u0434\u0430\u0440\u043E\u043A! \u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E \u0445\u043E\u0442\u044F \u0431\u044B \u043F\u043E\u043C\u043D\u0438\u0448\u044C.",
  "AcceptGift_(O)StardropTea": "\u041C-\u043C... \u0414\u0430 \u043F\u043E\u0447\u0435\u043C\u0443 \u044D\u0442\u043E \u0442\u0430\u043A \u0432\u043A\u0443\u0441\u043D\u043E? \u042D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u0439 \u043F\u043E\u0434\u0430\u0440\u043E\u043A.",
  "AcceptGift_(O)787": "\u042D\u0442\u043E \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C \u043C\u043E\u0439 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u043F\u0440\u043E\u0435\u043A\u0442! \u0421\u043F\u0430\u0441\u0438\u0431\u043E, @!$h",
  "AcceptGift_(O)336": "\u0410\u0445, \u0447\u0438\u0441\u0442\u043E\u0435 \u0437\u043E\u043B\u043E\u0442\u043E... \u041D\u0435 \u0441\u0430\u043C\u044B\u0439 \u043A\u0440\u0435\u043F\u043A\u0438\u0439 \u043C\u0435\u0442\u0430\u043B\u043B, \u043D\u043E \u0443 \u043D\u0435\u0433\u043E \u0435\u0441\u0442\u044C \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0445 \u0441\u0432\u043E\u0439\u0441\u0442\u0432!$h",
  "AcceptGift_(O)337": "\u041E\u0433\u043E! \u0420\u0435\u0434\u043A\u0438\u0439 \u044D\u043B\u0435\u043C\u0435\u043D\u0442. \u0415\u0441\u0442\u044C \u0442\u0430\u043A\u0430\u044F \u0442\u0435\u043E\u0440\u0438\u044F, \u0447\u0442\u043E \u0432\u0435\u0441\u044C \u0438\u0440\u0438\u0434\u0438\u0439 \u0432 \u043D\u0430\u0448\u0435\u043C \u043C\u0438\u0440\u0435 \u0438\u0437 \u043C\u0435\u0442\u0435\u043E\u0440\u0438\u0442\u043E\u0432...$h",
  "AcceptGift_(O)122": "\u041E\u0433\u043E, \u043D\u0443 \u0438 \u0434\u0435\u043B\u0430! \u042F \u0434\u0435\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u0438\u0440\u0443\u044E \u044D\u0442\u043E \u0438 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u044E, \u0441\u043C\u043E\u0433\u0443 \u043B\u0438 \u044F \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u044D\u0442\u0443 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u044E \u0437\u0430\u043D\u043E\u0432\u043E.$h",
  "AcceptGift_(O)910": "\u041E\u0439! \u0421 \u044D\u0442\u0438\u043C \u043F\u043E\u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u0435\u0435! \u0422\u044B \u0447\u0442\u043E, \u0434\u0435\u0440\u0436\u0438\u0448\u044C \u044D\u0442\u043E \u0433\u043E\u043B\u044B\u043C\u0438 \u0440\u0443\u043A\u0430\u043C\u0438?$9#$b#... \u0418\u0437\u0432\u0438\u043D\u0438... \u0425\u0435-\u0445\u0435... \u0415\u0441\u043B\u0438 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0441 \u044D\u0442\u0438\u043C \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E, \u0442\u043E \u043E\u043D\u043E \u043E\u0442\u043B\u0438\u0447\u043D\u043E \u043F\u043E\u0434\u043E\u0439\u0434\u0435\u0442 \u043A \u043E\u0434\u043D\u043E\u0439 \u044D\u043A\u0437\u043E\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u043C\u0430\u0448\u0438\u043D\u0435, \u043D\u0430\u0434 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u044F \u0441\u0435\u0439\u0447\u0430\u0441 \u0440\u0430\u0431\u043E\u0442\u0430\u044E.",
  "dating_Maru": "\u042D\u043C-\u043C... \u0422\u043E\u043B\u044C\u043A\u043E \u043F\u0430\u043F\u0435 \u043C\u043E\u0435\u043C\u0443 \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438, \u043B\u0430\u0434\u043D\u043E? \u042F \u0441\u0430\u043C\u0430 \u0432\u0441\u0435 \u0435\u043C\u0443 \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443.",
  "dating_Maru_memory_oneday": "\u041C-\u043C-\u043C... \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043A\u0430\u043A-\u0442\u043E \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0435 \u043D\u0435 \u043C\u043E\u0433\u0443 \u0441\u043E\u0441\u0440\u0435\u0434\u043E\u0442\u043E\u0447\u0438\u0442\u044C\u0441\u044F.$l",
  "GreenRain": "\u042F \u0445\u043E\u0442\u0435\u043B\u0430 \u043F\u043E\u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C \u043E\u0431\u0440\u0430\u0437\u0446\u044B \u0441 \u043F\u0430\u043F\u043E\u0439, \u043D\u043E \u043C\u0430\u043C\u0430 \u043D\u0430\u0441\u0442\u043E\u044F\u043B\u0430, \u0447\u0442\u043E\u0431\u044B \u044F \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u0442\u0443\u0442...",
  "GreenRain_2": "\u0423 \u043D\u0430\u0441 \u0432\u044B\u0434\u0430\u043B\u0430\u0441\u044C \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0438\u0437\u0443\u0447\u0438\u0442\u044C \u0440\u0435\u0434\u043A\u0438\u0439 \u043F\u043E\u0433\u043E\u0434\u043D\u044B\u0439 \u0444\u0435\u043D\u043E\u043C\u0435\u043D... \u041A\u0430\u0436\u0434\u0430\u044F \u0441\u0435\u043A\u0443\u043D\u0434\u0430 \u043D\u0430 \u0441\u0447\u0435\u0442\u0443!",
  "eventSeen_9": "\u041D\u0430\u0434\u043E \u0431\u044B\u043B\u043E \u043F\u043E\u0431\u043E\u043B\u044C\u0448\u0435 \u043F\u043E\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u043D\u0430\u0434 \u044D\u0442\u0438\u043C, \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0442\u0435\u0431\u0435 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C...$s",
  "eventSeen_9_memory_oneweek": "\u041A\u0430\u043A \u0440\u0443\u043A\u0430?#$b#\u0414\u0430\u0439 \u0433\u043B\u044F\u043D\u0443... \u042D\u0439, \u043D\u0430\u043C\u043D\u043E\u0433\u043E \u043B\u0443\u0447\u0448\u0435!$h",
  "married_Sebastian": "\u042D\u0439, \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F, \u043C\u044B \u0442\u0435\u043F\u0435\u0440\u044C \u0431\u0440\u0430\u0442 \u0438 \u0441\u0435\u0441\u0442\u0440\u0430!$h^\u042D\u0439, \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F, \u043C\u044B \u0442\u0435\u043F\u0435\u0440\u044C \u0441\u0435\u0441\u0442\u0440\u044B!$h#$e#\u042F \u0440\u0430\u0434\u0430, \u0447\u0442\u043E \u0421\u0435\u0431\u0430\u0441\u0442\u0438\u0430\u043D \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u0432\u044B\u0431\u0440\u0430\u043B\u0441\u044F \u0438\u0437 \u043F\u043E\u0434\u0432\u0430\u043B\u0430...#$e#\u0416\u0435\u043B\u0430\u044E \u0441\u0447\u0430\u0441\u0442\u044C\u044F!",
  "married_Penny": "\u042D\u0439, \u043C\u043E\u0438 \u043F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F!$h#$b#\u041F\u043E\u043C\u043D\u044E \u0442\u043E\u0442 \u0434\u0435\u043D\u044C, \u043A\u043E\u0433\u0434\u0430 \u041F\u0435\u043D\u043D\u0438 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B\u0430 \u043C\u043D\u0435 \u043E \u0447\u0443\u0432\u0441\u0442\u0432\u0430\u0445 \u043A \u0442\u0435\u0431\u0435...#$b#\u041E\u043D\u0430 \u0442\u0430\u043A \u0441\u0442\u0435\u0441\u043D\u044F\u043B\u0430\u0441\u044C, \u043D\u043E \u044F \u0441\u0440\u0430\u0437\u0443 \u043F\u043E\u043D\u044F\u043B\u0430, \u0447\u0442\u043E \u043D\u0430\u043C\u0435\u0440\u0435\u043D\u0438\u044F \u0435\u0435 \u0441\u0435\u0440\u044C\u0435\u0437\u043D\u044B... \u041E\u043D\u0430 \u0441\u043B\u043E\u0432\u0430\u043C\u0438 \u043D\u0430 \u0432\u0435\u0442\u0435\u0440 \u043D\u0435 \u0440\u0430\u0437\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442\u0441\u044F!",
  "married_Harvey": "\u0410 \u044F \u0435\u0449\u0435 \u0434\u0443\u043C\u0430\u043B\u0430, \u0447\u0442\u043E \u0442\u044B \u0442\u0430\u043A \u0447\u0430\u0441\u0442\u043E \u0432 \u043A\u043B\u0438\u043D\u0438\u043A\u0443 \u0437\u0430\u0445\u043E\u0434\u0438\u0448\u044C, \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u0432\u0440\u043E\u0434\u0435 \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435... \u0422\u0435\u043F\u0435\u0440\u044C-\u0442\u043E \u044F \u043D\u0430\u0447\u0438\u043D\u0430\u044E \u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C...",
  "Resort_Entering": "\u0412\u0438\u043B\u043B\u0438 \u043E\u0431\u043C\u043E\u043B\u0432\u0438\u043B\u0441\u044F, \u0447\u0442\u043E \u0442\u044B ${\u043F\u043E\u043C\u043E\u0433\u0430\u043B^\u043F\u043E\u043C\u043E\u0433\u0430\u043B\u0430}$ \u0447\u0438\u043D\u0438\u0442\u044C \u043B\u043E\u0434\u043A\u0443. \u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0442\u0435\u0431\u0435 \u0437\u0430 \u044D\u0442\u043E!",
  "Resort_Leaving": "\u042D\u0442\u043E \u0431\u044B\u043B\u043E \u0432\u0435\u0441\u0435\u043B\u043E!",
  "Resort": "\u042F \u0442\u0443\u0442 \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0432\u0438\u0434\u043E\u0432 \u043C\u043E\u0440\u0441\u043A\u0438\u0445 \u0437\u0432\u0435\u0437\u0434. \u0411\u043E\u043B\u044C\u0448\u0438\u0435 \u0444\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u044B\u0435 \u2014 \u043C\u043E\u0438 \u043B\u044E\u0431\u0438\u043C\u044B\u0435, \u043D\u043E \u043E\u043D\u0438 \u0432\u043E\u043E\u0431\u0449\u0435 \u0432\u0441\u0435 \u043E\u0447\u0435\u043D\u044C \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0435!",
  "Resort_Towel": "*\u043E\u0445\u0430\u0435\u0442*... \u042D\u0442\u043E \u0436\u0435 \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u043E\u0435 \u0437\u0430\u0442\u043C\u0435\u043D\u0438\u0435!$3#$b#\u0410... \u041D\u0435. \u042D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0432\u043E\u0435 \u0442\u0435\u043B\u043E \u0441\u043E\u043B\u043D\u0446\u0435 \u0437\u0430\u0441\u043B\u043E\u043D\u0438\u043B\u043E.",
  "Resort_Towel_2": "\u0422\u0443\u0442 \u043C\u044B \u0442\u0430\u043A \u0434\u0430\u043B\u0435\u043A\u043E \u043E\u0442 \u0446\u0438\u0432\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u0438.#$b#\u041F\u0440\u043E\u0441\u0442\u043E \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044C, \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0442\u0443\u0442 \u043D\u043E\u0447\u044C\u044E \u043D\u0430 \u043D\u0435\u0431\u0435 \u0437\u0432\u0435\u0437\u0434.#$e#\u041A\u0442\u043E \u0437\u043D\u0430\u0435\u0442, \u043C\u043E\u0436\u0435\u0442, \u043C\u044B \u0434\u0430\u0436\u0435 \u0443\u0432\u0438\u0434\u0438\u043C \u043B\u0435\u0442\u0430\u044E\u0449\u0443\u044E \u0442\u0430\u0440\u0435\u043B\u043A\u0443, \u0434\u0430 \u043D\u0435 \u043E\u0434\u043D\u0443!$h",
  "Resort_Bar": "\u041C-\u043C-\u043C... \u041F\u043E\u0447\u0435\u043C\u0443 \u0442\u0440\u043E\u043F\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0444\u0440\u0443\u043A\u0442\u044B \u0442\u0430\u043A\u0438\u0435 \u0432\u043A\u0443\u0441\u043D\u044B\u0435?",
  "Resort_Shore": "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u0442 \u043B\u0438 \u043C\u043D\u0435 \u0412\u0438\u043B\u043B\u0438 \u043F\u0440\u0438\u0432\u0435\u0437\u0442\u0438 \u0441\u044E\u0434\u0430 \u043C\u043E\u0439 \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F...#\u0422\u0443\u0442 \u043D\u0435\u0431\u043E \u0442\u0430\u043A\u043E\u0435 \u0447\u0438\u0441\u0442\u043E\u0435, \u044F \u043E\u0442\u0441\u044E\u0434\u0430, \u043F\u043E-\u043C\u043E\u0435\u043C\u0443, \u0434\u0430\u0436\u0435 \u0433\u043E\u0440\u043E\u0434 \u041F\u0435\u043B\u0438\u043A\u0430\u043D \u0432\u0438\u0436\u0443.#\u041C\u043E\u0436\u0435\u0442, \u043E\u0442\u0441\u044E\u0434\u0430 \u044F \u0434\u0430\u0436\u0435 \u0443\u0432\u0438\u0436\u0443 \u0442\u0435\u0431\u044F \u0438 \u0442\u0432\u043E\u044E \u0444\u0435\u0440\u043C\u0443 \u00AB%farm\u00BB!",
  "FlowerDance_Accept_Spouse": "\u041A\u043E\u043D\u0435\u0447\u043D\u043E... *\u0428\u0435\u043F\u043E\u0442\u043E\u043C* \u0422\u043E\u043B\u044C\u043A\u043E \u0434\u0430\u0432\u0430\u0439 \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u0439\u0434\u0435\u043C \u0434\u043E\u043C\u043E\u0439 \u0438 \u0431\u0443\u0434\u0435\u043C \u0441\u0438\u0434\u0435\u0442\u044C \u0432\u043C\u0435\u0441\u0442\u0435 \u043F\u043E\u0434 \u043F\u043B\u0435\u0434\u043E\u043C?..$l",
  "FlowerDance_Decline": "\u042F \u043F\u043E\u043B\u044C\u0449\u0435\u043D\u0430! \u041D\u043E... \u041D\u0435\u0442.",
  "divorced": "\u041D\u0430\u043C \u043D\u0435\u0447\u0435\u0433\u043E \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0443 \u0441\u043A\u0430\u0437\u0430\u0442\u044C.$a",
  "breakUp": "\u0421\u043E \u043C\u043D\u043E\u0439 \u0442\u0435\u0431\u0435 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0445\u043E\u0440\u043E\u0448\u043E, \u0434\u0430?$a#$b#\u041B\u0430\u0434\u043D\u043E...$s",
  "dumped_Girls": "\u041D\u0430\u0434\u043E \u0436\u0435, \u0442\u044B \u0435\u0449\u0435 \u0441\u043C\u0435\u0435\u0448\u044C \u0441\u043E \u043C\u043D\u043E\u0439 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C!$a",
  "secondChance_Girls": "\u0423\u0432\u0430\u0436\u0430\u0442\u044C \u044F \u0442\u0435\u0431\u044F \u0441\u0442\u0430\u043B\u0430 \u043F\u043E\u043C\u0435\u043D\u044C\u0448\u0435, @... \u041D\u043E \u044F \u0442\u0435\u0431\u044F \u043F\u0440\u043E\u0449\u0430\u044E.$s",
  "Mon": "\u041A\u043E\u0433\u0434\u0430 \u044F \u043D\u0435 \u043C\u043E\u0433\u0443 \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u044C \u043A\u0430\u043A\u0443\u044E-\u043D\u0438\u0431\u0443\u0434\u044C \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u0437\u0430\u0434\u0430\u0447\u0443, \u044F \u0432\u0441\u0435\u0433\u0434\u0430 \u0438\u0434\u0443 \u0433\u0443\u043B\u044F\u0442\u044C.#$e#\u0423\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E, \u043A\u0430\u043A \u0441\u0438\u043B\u044C\u043D\u043E \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u043C\u043E\u0447\u044C \u0441\u043C\u0435\u043D\u0430 \u043E\u0431\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438.",
  "Tue": "\u0412\u044B \u0441 \u043C\u043E\u0435\u0439 \u043C\u0430\u043C\u043E\u0439 \u0443\u0436\u0435 \u0437\u043D\u0430\u043A\u043E\u043C\u044B? \u041E\u043D\u0430 \u0437\u0434\u0435\u0441\u044C \u043F\u043B\u043E\u0442\u043D\u0438\u043A.",
  "Wed": "\u041F\u043E \u0432\u0442\u043E\u0440\u043D\u0438\u043A\u0430\u043C \u0438 \u0447\u0435\u0442\u0432\u0435\u0440\u0433\u0430\u043C \u044F \u0440\u0430\u0431\u043E\u0442\u0430\u044E \u0432 \u043A\u043B\u0438\u043D\u0438\u043A\u0435 \u0443 \u0425\u0430\u0440\u0432\u0438.#$b#\u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u0435\u043C\u0443 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F, \u0447\u0442\u043E \u044F \u0440\u044F\u0434\u043E\u043C, \u0435\u0441\u043B\u0438 \u0432\u0434\u0440\u0443\u0433 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435 \u0432\u044B\u0439\u0434\u0435\u0442 \u0438\u0437 \u0441\u0442\u0440\u043E\u044F!$h#$e#\u0424\u0435\u0440\u043C\u0435\u0440\u043E\u043C, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u0431\u044B\u0442\u044C \u043E\u0447\u0435\u043D\u044C \u043F\u0440\u043E\u0441\u0442\u043E, \u0434\u0430?",
  "Thu": "\u042D\u0442\u0438\u043C \u043B\u0435\u0442\u043E\u043C \u044F \u043F\u043B\u0430\u043D\u0438\u0440\u0443\u044E \u043C\u043D\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u0437\u0430 \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F\u043E\u043C.",
  "Thu4": "\u0418\u043D\u043E\u0433\u0434\u0430, \u043A\u043E\u0433\u0434\u0430 \u044F \u0441\u043C\u043E\u0442\u0440\u044E \u0432 \u0441\u0432\u043E\u0439 \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F, \u043C\u043D\u0435 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0436\u0443\u0442\u043A\u043E... \u0411\u0443\u0434\u0442\u043E \u0431\u044B \u043D\u0430\u043C \u043D\u0435\u043B\u044C\u0437\u044F \u043D\u0430 \u0432\u0441\u0435 \u044D\u0442\u043E \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C.#$e#\u0413\u043B\u0443\u043F\u043E, \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u044F \u0437\u043D\u0430\u044E...$h",
  "Sat": "\u0412\u044B \u0443\u0436\u0435 \u0437\u043D\u0430\u043A\u043E\u043C\u044B \u0441 \u043C\u043E\u0438\u043C \u043F\u0430\u043F\u043E\u0439, \u0414\u0435\u043C\u0435\u0442\u0440\u0438\u0443\u0441\u043E\u043C? \u041E\u043D \u0443\u0447\u0435\u043D\u044B\u0439. \u041C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E \u043F\u043E\u043C\u043E\u0433\u0430\u0442\u044C \u0435\u043C\u0443 \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438.",
  "Sat2": "\u0422\u0430\u043A \u043F\u0440\u0438\u044F\u0442\u043D\u043E, \u043A\u043E\u0433\u0434\u0430 \u043C\u043E\u0436\u043D\u043E \u0447\u0442\u043E-\u0442\u043E \u0441\u0430\u043C\u043E\u043C\u0443 \u043F\u043E\u0447\u0438\u043D\u0438\u0442\u044C \u0432\u043C\u0435\u0441\u0442\u043E \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B \u0432\u044B\u043A\u0438\u0434\u044B\u0432\u0430\u0442\u044C \u043D\u0430 \u0441\u0432\u0430\u043B\u043A\u0443.",
  "Sat4": "\u041A\u0442\u043E-\u0442\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u0447\u0442\u043E \u00AB\u0432\u043E\u043B\u0448\u0435\u0431\u0441\u0442\u0432\u0430 \u043D\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442\u00BB... \u041D\u043E \u0437\u0430\u0434\u0443\u043C\u044B\u0432\u0430\u043B\u0438\u0441\u044C \u043B\u0438 \u043E\u043D\u0438 \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u043E \u043F\u0440\u0438\u0440\u043E\u0434\u0435 \u043C\u0430\u0433\u043D\u0435\u0442\u0438\u0437\u043C\u0430?",
  "Sat6": "\u0418\u043D\u043E\u0433\u0434\u0430 \u043F\u0440\u043E\u0441\u0442\u043E \u0434\u0438\u0432\u0443 \u0434\u0430\u0435\u0448\u044C\u0441\u044F, \u043A\u0430\u043A \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u043E\u0435 \u0442\u0435\u043B\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0431\u0435\u0440\u0435\u0442 \u0438 \u00AB\u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442\u00BB.",
  "Sat8": "\u0417\u043D\u0430\u0435\u0448\u044C, \u044F \u0442\u0443\u0442 \u0434\u0443\u043C\u0430\u043B\u0430... \u043D\u0438\u043A\u0430\u043A\u0430\u044F \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u044F \u0432 \u043C\u0438\u0440\u0435 \u043D\u0435 \u0437\u0430\u043C\u0435\u043D\u0438\u0442 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u043E\u0439 \u0434\u0440\u0443\u0436\u0431\u044B.",
  "Fri": "\u041F\u0440\u043E\u0441\u0442\u0438, \u0435\u0441\u043B\u0438 \u044F \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u0441\u0435\u043C \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u0430... \u0423 \u043C\u0435\u043D\u044F \u0431\u043E\u043B\u044F\u0442 \u0440\u0443\u043A\u0438 \u043E\u0442 \u0432\u0447\u0435\u0440\u0430\u0448\u043D\u0435\u0439 \u0440\u0430\u0431\u043E\u0442\u044B.#$c .5# \u041C\u043D\u0435 \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0442\u0430\u0441\u043A\u0430\u0442\u044C \u0434\u0435\u0441\u044F\u0442\u044C \u043A\u043E\u0440\u043E\u0431\u043E\u043A \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u0438\u0445 \u043A\u0430\u0440\u0442\u043E\u0447\u0435\u043A \u043D\u0430 \u0447\u0435\u0440\u0434\u0430\u043A!#$e#\u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0447\u0435\u0442\u044B\u0440\u0435 \u0447\u0430\u0441\u0430 \u0441\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0438\u0441\u0442\u043E\u0440\u0438\u0438 \u0431\u043E\u043B\u0435\u0437\u043D\u0435\u0439! ",
  "Sun": "\u041F\u0440\u0438\u0432\u0435\u0442!#$q 3/4 Sun_01_old#\u0422\u0435\u0431\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u043D\u0430 \u0444\u0435\u0440\u043C\u0435?#$r 3 0 Sun_01_01#\u0414\u0430.#$r 4 0 Sun_01_02#\u041D\u0435\u0442.",
  "Sun_01_old": "$p 3#\u042D\u0439, \u0435\u0449\u0435 \u043E\u0434\u043D\u0430 \u043D\u0435\u0434\u0435\u043B\u044F \u043D\u0430 \u0444\u0435\u0440\u043C\u0435 \u043F\u043E\u0437\u0430\u0434\u0438! \u041F\u043E\u0445\u043E\u0436\u0435, \u0434\u0435\u043B\u0430 \u0443 \u0442\u0435\u0431\u044F \u0438\u0434\u0443\u0442 \u043D\u0435\u043F\u043B\u043E\u0445\u043E.$h|\u0415\u0449\u0435 \u043E\u0434\u043D\u0430 \u0443\u0442\u043E\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u043D\u0435\u0434\u0435\u043B\u044F \u043D\u0430 \u0444\u0435\u0440\u043C\u0435, \u0434\u0430? \u0423 \u0442\u0435\u0431\u044F, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u043F\u043E\u043B\u043D\u043E \u0440\u0430\u0431\u043E\u0442\u044B...$s",
  "Sun_01_01": "\u041D\u0443 \u0438 \u0445\u043E\u0440\u043E\u0448\u043E, \u0434\u0430?$h",
  "Sun_01_02": "\u041E\u0439! \u041F\u0440\u043E\u0441\u0442\u0438... \u0422\u044B \u043D\u0435 \u0434\u0443\u043C\u0430\u0435\u0448\u044C \u043E \u0442\u043E\u043C, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u043D\u044F\u0442\u044C\u0441\u044F \u0447\u0435\u043C-\u0442\u043E \u0434\u0440\u0443\u0433\u0438\u043C?..$s",
  "Tue2": "\u0417\u0430\u0445\u043E\u0434\u0438 \u043A \u043D\u0430\u043C, \u0435\u0441\u043B\u0438 \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F \u0440\u0430\u0441\u0448\u0438\u0440\u0438\u0442\u044C \u0437\u0434\u0430\u043D\u0438\u044F \u043D\u0430 \u0444\u0435\u0440\u043C\u0435.#$e#\u0412\u0441\u0435\u0433\u0434\u0430 \u043F\u0440\u0438\u044F\u0442\u043D\u043E, \u043A\u043E\u0433\u0434\u0430 \u0434\u043E\u043C\u0430 \u0433\u043E\u0441\u0442\u0438.",
  "Fri4": "\u041C\u043E\u044F \u043C\u0430\u043C\u0430 \u2014 \u043F\u043B\u043E\u0442\u043D\u0438\u043A, \u0430 \u043F\u0430\u043F\u0430 \u2014 \u0443\u0447\u0435\u043D\u044B\u0439. \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u043B\u043E\u0433\u0438\u0447\u043D\u043E, \u0447\u0442\u043E \u044F \u043B\u044E\u0431\u043B\u044E \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C \u0432\u0441\u044F\u043A\u0438\u0435 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430.",
  "Fri6": "\u041C\u043E\u0439 \u043F\u0430\u043F\u0430 \u043E\u0447\u0435\u043D\u044C \u043B\u043E\u0433\u0438\u0447\u043D\u044B\u0439, \u0430 \u043C\u0430\u043C\u0430 \u0441\u0438\u043B\u044C\u043D\u043E \u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442\u0441\u044F \u043D\u0430 \u0438\u043D\u0442\u0443\u0438\u0446\u0438\u044E. \u0418\u043D\u043E\u0433\u0434\u0430 \u044D\u0442\u043E \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u0442 \u043A \u0440\u0430\u0437\u043D\u043E\u0433\u043B\u0430\u0441\u0438\u044F\u043C...$s",
  "Mon6": "\u0418\u043D\u043E\u0433\u0434\u0430 \u0433\u043E\u043B\u043E\u0432\u0430 \u0443 \u043C\u0435\u043D\u044F \u0442\u0430\u043A \u0437\u0430\u0431\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0432\u0441\u044F\u043A\u043E\u0439 \u0435\u0440\u0443\u043D\u0434\u043E\u0439, \u0447\u0442\u043E \u044F \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435 \u043C\u043E\u0433\u0443 \u0434\u0443\u043C\u0430\u0442\u044C. \u0421 \u0442\u043E\u0431\u043E\u0439 \u0442\u0430\u043A\u043E\u0435 \u0441\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F?#$e#\u0421\u0432\u0435\u0436\u0438\u0439 \u0432\u043E\u0437\u0434\u0443\u0445 \u043E\u0431\u044B\u0447\u043D\u043E \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442.",
  "Wed8": "\u042F \u0440\u0430\u0434\u0430, \u0447\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u044E \u0432 \u043A\u043B\u0438\u043D\u0438\u043A\u0435... \u0427\u0443\u0432\u0441\u0442\u0432\u0443\u044E, \u0447\u0442\u043E \u043F\u043E\u043C\u043E\u0433\u0430\u044E \u043B\u044E\u0434\u044F\u043C.#$e#\u0414\u043E\u043A\u0442\u043E\u0440 \u0425\u0430\u0440\u0432\u0438... \u041E\u043D \u043C\u0438\u043B\u044B\u0439, \u043D\u043E \u043D\u0435 \u043C\u043E\u0439 \u0442\u0438\u043F\u0430\u0436...",
  "Thu10": "\u041E, @! \u0425\u043E\u0447\u0435\u0448\u044C \u043E \u0447\u0435\u043C-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C?$l",
  "Event_Hospital_1": "\u0415\u0449\u0435 \u043A\u0430\u043A \u0443\u0437\u043D\u0430\u0435\u0442! \u0410\u043D\u0430\u043B\u0438\u0437\u044B \u0431\u0435\u0437\u043D\u0430\u0434\u0435\u0436\u043D\u043E \u0438\u0441\u043F\u043E\u0440\u0447\u0435\u043D\u044B!%fork$s",
  "Event_Hospital_2": "\u041B\u0430\u0434\u043D\u043E. \u0421\u0432\u0430\u043B\u044E \u0432\u0438\u043D\u0443 \u043D\u0430 \u0442\u0435\u0431\u044F.$u",
  "Event_Hospital_3": "\u0418 \u0442\u043E \u0432\u0435\u0440\u043D\u043E... \u041D\u0443\u0436\u043D\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u044C \u0435\u043C\u0443 \u043F\u0440\u0430\u0432\u0434\u0443.%fork$u",
  "Event_Space1": "\u0423\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E, \u043F\u0440\u0430\u0432\u0434\u0430?",
  "Event_Space2": "\u041C\u043E\u0436\u043D\u043E \u0438 \u0442\u0430\u043A \u0441\u043A\u0430\u0437\u0430\u0442\u044C...$s#$b#\u041D\u043E \u044D\u0442\u043E \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E, \u043F\u0440\u0430\u0432\u0434\u0430?",
  "Event_Cut1": "\u0427\u0442\u043E, \u043D\u0435\u0442?$8#$b#\u041D\u0443, \u043C\u043D\u0435 \u043E\u0442 \u044D\u0442\u043E\u0433\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043B\u0435\u0433\u0447\u0435. \u0421\u043F\u0430\u0441\u0438\u0431\u043E.",
  "Event_Cut2": "\u041E\u0439-\u043E\u0439... \u041C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C-\u043E\u0447\u0435\u043D\u044C \u0436\u0430\u043B\u044C.$s",
  "event_robot1": "\u0421\u043F\u0430\u0441\u0438\u0431\u043E. \u042D\u0442\u043E \u043C\u043D\u043E\u0433\u043E \u0434\u043B\u044F \u043C\u0435\u043D\u044F \u0437\u043D\u0430\u0447\u0438\u0442, @.#$b#\u042F \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430 \u2014 \u044D\u0442\u043E \u043D\u0435 \u0442\u0432\u043E\u0435... \u041D\u043E \u044F \u0446\u0435\u043D\u044E, \u0447\u0442\u043E \u0442\u044B \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u0435\u0448\u044C\u0441\u044F \u043C\u043E\u0438\u043C \u0437\u0430\u043D\u044F\u0442\u0438\u0435\u043C.#$b#\u0425\u043E\u0442\u0435\u043B\u0430 \u0431\u044B \u044F \u043A\u0430\u043A-\u043D\u0438\u0431\u0443\u0434\u044C \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u044D\u0442\u0443 \u0443\u0441\u043B\u0443\u0433\u0443.$l",
  "event_robot2": "\u0427\u0442\u043E? \u042D\u0442\u043E \u043F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u043E\u043D\u0430 \u043F\u0440\u044F\u043C\u043E \u0441\u043A\u0430\u0437\u0430\u043B\u0430, \u0447\u0442\u043E \u043D\u0435 \u0445\u043E\u0447\u0435\u0442 \u0431\u044B\u0442\u044C \u0440\u0430\u0431\u043E\u043C? \u041A\u0430\u043A \u0431\u0435\u0441\u0447\u0443\u0432\u0441\u0442\u0432\u0435\u043D\u043D\u043E...%fork$a",
  "event_robot3": "\u0425\u0435...$8#$b#\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u043E\u043D \u0442\u0430\u043A \u043F\u0440\u044F\u043C\u043E \u0438 \u0441\u043A\u0430\u0437\u0430\u043B, \u0434\u0430?$l#$b#... \u042D\u043C...$l",
  "event_robot4": "...$8#$b#@...$8",
  "event_robot_explain1": "...$s#$b#\u0412 \u044D\u0442\u043E\u043C \u0435\u0441\u0442\u044C \u0441\u043C\u044B\u0441\u043B, \u044F \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0437\u0430\u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0440\u043E\u0432\u0430\u043B\u0430 \u0435\u0435, \u0447\u0442\u043E\u0431\u044B \u043E\u043D\u0430 \u0432\u0435\u043B\u0430 \u0441\u0435\u0431\u044F \u043A\u0430\u043A \u0447\u0435\u043B\u043E\u0432\u0435\u043A... \u041D\u043E \u0435\u0435 \u043D\u0435\u0439\u0440\u043E\u043D\u043D\u0430\u044F \u0441\u0435\u0442\u044C \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043B\u043E\u0436\u043D\u0430, \u0447\u0442\u043E \u044F \u043D\u0435 \u043C\u043E\u0433\u0443 \u0431\u044B\u0442\u044C \u0443\u0432\u0435\u0440\u0435\u043D\u0430, \u043D\u0435 \u0437\u0430\u0440\u043E\u0434\u0438\u043B\u043E\u0441\u044C \u043B\u0438 \u0432 \u043D\u0435\u0439 \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0435.$8#$b#\u041A \u0442\u043E\u043C\u0443 \u0436\u0435, \u043D\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043B\u0438 \u0432\u044B\u0441\u043E\u043A\u043E\u043C\u0435\u0440\u043D\u043E \u043F\u043E\u043B\u0430\u0433\u0430\u0442\u044C, \u0447\u0442\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0435, \u043F\u043E\u0434\u043E\u0431\u043D\u043E\u0435 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u043E\u043C\u0443, \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u044B\u043C \u0432\u0438\u0434\u043E\u043C \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F? \u041C\u043E\u0437\u0433 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430 \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043E\u0442 \u043D\u0430\u0448\u0435\u0433\u043E, \u043D\u043E \u044D\u0442\u043E \u043D\u0435 \u0437\u043D\u0430\u0447\u0438\u0442, \u0447\u0442\u043E \u043C\u043E\u0436\u043D\u043E \u0438\u043C \u043F\u0440\u0435\u043D\u0435\u0431\u0440\u0435\u0447\u044C.$8",
  "event_robot_explain2": "\u041F\u043E\u043D\u044F\u0442\u043D\u043E. \u0428\u0443\u0442\u043A\u0430 \u0432\u044B\u0448\u043B\u0430 \u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u0441\u043C\u0435\u0448\u043D\u0430\u044F.$a",
  "event_robot_explain3": "\u042D\u0442\u043E \u0443\u0436\u0430\u0441\u043D\u043E! \u0427\u0442\u043E \u043D\u0430 \u0442\u0435\u0431\u044F \u043D\u0430\u0448\u043B\u043E, @?$a#$b#\u042F \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u0431\u0443\u0434\u0443 \u043E\u0431 \u044D\u0442\u043E\u043C \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0435... \u0422\u044B \u0432\u0435\u0434\u0435\u0448\u044C \u0441\u0435\u0431\u044F \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0441\u0442\u0440\u0430\u043D\u043D\u043E.$a",
  "summer_1": "\u0421\u0435\u0439\u0447\u0430\u0441 \u0441\u0430\u043C\u044B\u0439 \u0441\u0435\u0437\u043E\u043D, \u0447\u0442\u043E\u0431\u044B \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043D\u0430 \u0437\u0432\u0435\u0437\u0434\u044B.",
  "summer_Mon": "\u0425\u043C-\u043C... \u041A\u0430\u043A\u043E\u0435 \u0431\u044B \u043C\u043D\u0435 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u044D\u0442\u0438\u043C \u043B\u0435\u0442\u043E\u043C?",
  "summer_Mon6": "\u041F\u0440\u0438\u0445\u043E\u0434\u0438 \u043A\u043E \u043C\u043D\u0435 \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0443, \u0435\u0441\u043B\u0438 \u0437\u0430\u0445\u043E\u0447\u0435\u0448\u044C \u043F\u043E\u0432\u043E\u0437\u0438\u0442\u044C\u0441\u044F \u0441 \u043C\u043E\u0438\u043C\u0438 \u0438\u0437\u043E\u0431\u0440\u0435\u0442\u0435\u043D\u0438\u044F\u043C\u0438.",
  "summer_Tue": "\u0421\u0435\u0431\u0430\u0441\u0442\u0438\u0430\u043D \u2014 \u043C\u043E\u0439 \u0431\u0440\u0430\u0442, \u0435\u0441\u043B\u0438 \u0442\u044B \u0435\u0449\u0435 \u043D\u0435 \u0432 \u043A\u0443\u0440\u0441\u0435.#$e#\u041C\u044B \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E \u043D\u0435 \u043F\u043E\u0445\u043E\u0436\u0438.",
  "summer_Tue4": "\u0421\u0435\u0431\u0430\u0441\u0442\u0438\u0430\u043D \u0440\u0435\u0434\u043A\u043E \u0441\u043E \u043C\u043D\u043E\u0439 \u0440\u0430\u0437\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0442. \u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043E\u043D \u043C\u0435\u043D\u044F \u0432\u043E\u043E\u0431\u0449\u0435 \u043B\u044E\u0431\u0438\u0442 \u0445\u043E\u0442\u044C \u043D\u0435\u043C\u043D\u043E\u0433\u043E?#$e#\u0413\u0440\u0443\u0441\u0442\u043D\u043E \u044D\u0442\u043E \u2014 \u044F \u0445\u043E\u0447\u0443, \u0447\u0442\u043E\u0431\u044B \u0443 \u043C\u0435\u043D\u044F \u0431\u044B\u043B \u0431\u0440\u0430\u0442, \u043D\u043E \u043E\u043D \u0432\u0435\u0434\u0435\u0442 \u0441\u0435\u0431\u044F \u0442\u0430\u043A, \u0431\u0443\u0434\u0442\u043E \u044F \u0435\u043C\u0443 \u043D\u0435 \u0441\u0435\u0441\u0442\u0440\u0430.",
  "summer_Wed": "\u041A\u0430\u043A \u0442\u0435\u0431\u0435 \u043B\u0435\u0442\u043E?#$e#\u042D\u0442\u043E\u0442 \u0433\u043E\u0434 \u0432\u044B\u0434\u0430\u043B\u0441\u044F \u0442\u0430\u043A\u0438\u043C \u0442\u0435\u043F\u043B\u044B\u043C.$h",
  "summer_Wed4": "\u041C\u044B \u0441 \u041F\u0435\u043D\u043D\u0438 \u0432\u0435\u0434\u0435\u043C \u0441\u0435\u0437\u043E\u043D\u043D\u044B\u0439 \u043A\u043D\u0438\u0436\u043D\u044B\u0439 \u043A\u043B\u0443\u0431.#$b#\u041D\u0430\u0441 \u043F\u043E\u043A\u0430 \u0434\u0432\u043E\u0435, \u043D\u043E \u043C\u044B \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E \u0441 \u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u0435\u043C \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u0435\u043C \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043D\u043D\u043E\u0435!",
  "summer_Thu": "\u041F\u0440\u043E\u0441\u0442\u0438, \u044F \u0437\u0430\u0434\u0443\u043C\u0430\u043B\u0430\u0441\u044C \u043E \u0441\u0432\u043E\u0438\u0445 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430\u0445.#$q 35/36 Thu_01_old#\u042F \u0440\u0435\u0448\u0438\u043B\u0430, \u0447\u0442\u043E \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u043E\u0441\u0442\u0440\u043E\u044E \u0440\u043E\u0431\u043E\u0442\u0430.#$r 35 30 Thu_0#\u0423 \u0442\u0435\u0431\u044F \u044D\u0442\u043E \u0437\u0430\u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F.#$r 36 -50 Thu_01_01#\u041D\u0443\u0436\u043D\u043E \u0431\u044B\u0442\u044C \u0440\u0435\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u043D\u0435\u0435.#$r 35 40 Thu_01_02#\u0417\u0432\u0443\u0447\u0438\u0442 \u043D\u0435\u043F\u0440\u043E\u0441\u0442\u043E.",
  "Thu_01_old": "\u0415\u0449\u0435 \u0443\u0432\u0438\u0434\u0438\u043C\u0441\u044F.",
  "Thu_0": "\u041F\u0440\u0430\u0432\u0434\u0430? \u0422\u044B \u0442\u043E\u0447\u043D\u043E \u043D\u0435 \u043F\u044B\u0442\u0430\u0435\u0448\u044C\u0441\u044F \u043C\u043D\u0435 \u043F\u043E\u043B\u044C\u0441\u0442\u0438\u0442\u044C?",
  "Thu_01_01": "\u0414\u0443\u043C\u0430\u0435\u0448\u044C, \u0443 \u043C\u0435\u043D\u044F \u043D\u0435 \u0432\u044B\u0439\u0434\u0435\u0442?$s",
  "Thu_01_02": "\u0422\u0430\u043A \u0438 \u0435\u0441\u0442\u044C, \u043D\u043E \u044F \u043B\u044E\u0431\u043B\u044E \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u0438!$h",
  "summer_Sat": "\u0421\u043B\u0443\u0448\u0430\u0439, \u0430 \u0443 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C \u043A\u0430\u043A\u0438\u0435-\u043D\u0438\u0431\u0443\u0434\u044C \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0435 \u0438\u0441\u0442\u043E\u0440\u0438\u0438 \u0441 \u0444\u0435\u0440\u043C\u044B?#$e#\u0412\u0438\u0434\u0438\u043C\u043E, \u043D\u0435\u0442.",
  "summer_Fri": "\u042F \u0432\u0447\u0435\u0440\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430 \u0432 \u043A\u043B\u0438\u043D\u0438\u043A\u0435. \u0423 \u043D\u0430\u0441 \u043D\u0435 \u0431\u044B\u043B\u043E \u043D\u0438 \u0435\u0434\u0438\u043D\u043E\u0433\u043E \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u0430.#$e#\u0412\u0438\u0434\u0438\u043C\u043E, \u043B\u0435\u0442\u043E\u043C \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u043C\u0435\u043D\u044C\u0448\u0435 \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u044C \u0437\u0430\u0431\u043E\u043B\u0435\u0442\u044C.",
  "summer_Sun": "\u0422\u044B, \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C, \u0441\u0435\u0439\u0447\u0430\u0441 \u0432\u044B\u0440\u0430\u0449\u0438\u0432\u0430\u0435\u0448\u044C \u0432\u0441\u044F\u043A\u0438\u0435 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0435 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F.#$b#\u041F\u0430\u043F\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u0447\u0442\u043E \u0432 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u0433\u043E\u0434\u0430 \u0432 \u0434\u043E\u043B\u0438\u043D\u0435 \u0440\u0430\u0441\u0442\u0435\u0442 \u043C\u043D\u043E\u0433\u043E \u044D\u043A\u0437\u043E\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439.",
  "summer_Fri2": "\u041E\u0439, \u0430 \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0438 \u043C\u043D\u0435 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u0440\u043E \u0444\u0435\u0440\u043C\u0443.#$e#\u041E\u0447\u0435\u043D\u044C \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E!",
  "summer_Wed2": "\u041C\u043D\u0435 \u043E\u0434\u043D\u043E\u0439 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0447\u0442\u043E \u0442\u0443\u0442 \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E \u0441\u0442\u0430\u043B\u043E \u043E\u0447\u0435\u043D\u044C \u0436\u0430\u0440\u043A\u043E?#$e#\u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u0434\u0430.",
  "summer_Sun6": "\u041A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u044F \u0441\u0442\u0430\u043D\u0443 \u0438\u0437\u043E\u0431\u0440\u0435\u0442\u0430\u0442\u0435\u043B\u0435\u043C \u043C\u0438\u0440\u043E\u0432\u043E\u0433\u043E \u043A\u043B\u0430\u0441\u0441\u0430.$u#$e#\u0422\u0435\u0431\u0435 \u043F\u043E\u0432\u0435\u0437\u043B\u043E \u0434\u0440\u0443\u0436\u0438\u0442\u044C \u0441\u043E \u043C\u043D\u043E\u0439!#$b#... \u042F \u0448\u0443\u0447\u0443.",
  "summer_Tue8": "@, \u043D\u0435\u043F\u043B\u043E\u0445\u043E \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0448\u044C \u0441\u0435\u0433\u043E\u0434\u043D\u044F.$h",
  "summer_Thu10": "\u041A\u0430\u043A \u0442\u0435\u0431\u0435 \u0443\u0434\u0430\u0435\u0442\u0441\u044F \u0438\u043C\u0435\u0442\u044C \u0442\u0430\u043A\u0438\u0435 \u043C\u044F\u0433\u043A\u0438\u0435 \u0440\u0443\u043A\u0438 \u043F\u0440\u0438 \u0432\u0441\u0435\u0445 \u0442\u0432\u043E\u0438\u0445 \u0444\u0435\u0440\u043C\u0435\u0440\u0441\u043A\u0438\u0445 \u0437\u0430\u0431\u043E\u0442\u0430\u0445?",
  "fall_Mon": "\u0422\u044B \u043C\u043D\u043E\u0433\u043E \u0438\u0441\u0441\u043B\u0435\u0434\u0443\u0435\u0448\u044C \u0448\u0430\u0445\u0442\u0443? \u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u0442\u0430\u043C \u043C\u043D\u043E\u0433\u043E \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0445 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432.",
  "fall_Tue": "\u0414\u0435\u0440\u0435\u0432\u044C\u044F \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0442\u0430\u043A\u0438\u0435 \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0435!$h",
  "fall_Thu": "\u0421\u0435\u0439\u0447\u0430\u0441 \u0432 \u0434\u0440\u0443\u0433\u0438\u0445 \u0447\u0430\u0441\u0442\u044F\u0445 \u0441\u0432\u0435\u0442\u0430 \u0432\u0435\u0441\u043D\u0430. \u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E!",
  "fall_Wed": "\u0424\u0443... \u041D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u043C\u043D\u0435 \u0437\u0430\u0432\u0442\u0440\u0430 \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0443.",
  "fall_Fri": "\u0413\u043E\u0442\u043E\u0432\u0430 \u043F\u043E\u0441\u043F\u043E\u0440\u0438\u0442\u044C, \u0432 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u0433\u043E\u0434\u0430 \u0432 \u043A\u043B\u0438\u043D\u0438\u043A\u0435 \u0431\u0443\u0434\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0430\u0440\u043E\u0434\u0443.$s#$e#\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0432\u0441\u0435 \u0431\u0443\u0434\u0443\u0442 \u0437\u0434\u043E\u0440\u043E\u0432\u044B.",
  "fall_Sat": "\u0412\u0441\u0435 \u044D\u0442\u0438 \u043E\u043F\u0430\u0432\u0448\u0438\u0435 \u043B\u0438\u0441\u0442\u044C\u044F \u043F\u043E\u0441\u043B\u0443\u0436\u0430\u0442 \u043F\u0438\u0449\u0435\u0439 \u0433\u0440\u0438\u0431\u0430\u043C \u0438 \u0434\u0440\u0443\u0433\u0438\u043C \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u043C \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u0430\u043C.$u#$e#\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043F\u0440\u0430\u0432\u0434\u0430?",
  "fall_Sun": "\u041D\u0443, \u0437\u0430 \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u0443\u044E \u0445\u043E\u0440\u043E\u0448\u0443\u044E \u043D\u0435\u0434\u0435\u043B\u044E!",
  "fall_Tue2": "@, \u043C\u043D\u0435 \u0442\u0430\u043A \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F, \u043A\u0430\u043A \u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0442 \u0441\u0435\u0439\u0447\u0430\u0441 \u0434\u0435\u0440\u0435\u0432\u044C\u044F!#$e#\u042F \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0442\u0435\u0431\u0435 \u043E\u043D\u0438 \u0442\u043E\u0436\u0435 \u043D\u0440\u0430\u0432\u044F\u0442\u0441\u044F.",
  "fall_Wed4": "\u0415\u0441\u043B\u0438 \u0443 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C \u043D\u0435\u043D\u0443\u0436\u043D\u044B\u0439 \u043C\u0435\u0442\u0430\u043B\u043B, \u043E\u043D \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F \u043C\u043D\u0435 \u0434\u043B\u044F \u043C\u043E\u0438\u0445 \u043F\u0440\u043E\u0435\u043A\u0442\u043E\u0432.#$e#\u041D\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u0435\u0441\u043B\u0438 \u043E\u043D \u0442\u0435\u0431\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043D\u0435 \u043D\u0443\u0436\u0435\u043D.",
  "fall_Fri6": "\u0412 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0432\u0440\u0435\u043C\u044F \u044F \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0430 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u043E\u043F\u0442\u0438\u043C\u0438\u0441\u0442\u0438\u0447\u043D\u043E...$h",
  "fall_Mon8": "\u0417\u0430\u0445\u043E\u0434\u0438 \u0437\u0430\u0432\u0442\u0440\u0430 \u043A\u043E \u043C\u043D\u0435 \u0432 \u043A\u043B\u0438\u043D\u0438\u043A\u0443. \u042F \u0440\u0430\u0431\u043E\u0442\u0430\u044E \u0441 10:00 \u0434\u043E 16:00.$h",
  "fall_Thu10": "\u0423 \u0442\u0435\u0431\u044F \u043B\u0438\u0441\u0442\u0438\u043A \u0437\u0430\u0441\u0442\u0440\u044F\u043B \u0432 \u0432\u043E\u043B\u043E\u0441\u0430\u0445. \u0414\u0430\u0439 \u0441\u043D\u0438\u043C\u0443.#$e#...$h",
  "winter_1": "\u041E\u0445, \u043A\u0430\u043A \u0436\u0435 \u0445\u043E\u043B\u043E\u0434\u043D\u043E...$s",
  "winter_Mon": "\u041A\u0430\u043A \u0442\u0435\u0431\u0435 \u043C\u043E\u0439 \u0441\u043D\u0435\u0433\u043E\u0432\u0438\u043A?$h",
  "winter_Tue": "\u0412 \u0442\u0430\u043A\u0443\u044E \u043F\u043E\u0433\u043E\u0434\u0443 \u0443 \u043C\u0435\u043D\u044F \u0432\u0435\u0447\u043D\u043E \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u043A\u0443\u0434\u0440\u0438... \u041E\u0445.",
  "winter_Wed": "\u041F\u043E\u0436\u0430\u043B\u0443\u0439, \u0437\u0438\u043C\u0430 \u2014 \u0445\u043E\u0440\u043E\u0448\u0435\u0435 \u0432\u0440\u0435\u043C\u044F, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u043D\u0430\u0434 \u043C\u043E\u0438\u043C\u0438 \u0438\u0437\u043E\u0431\u0440\u0435\u0442\u0435\u043D\u0438\u044F\u043C\u0438.#$e#\u041C\u043E\u0436\u0435\u0442, \u044F \u0441\u043C\u043E\u0433\u0443 \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0447\u0442\u043E-\u0442\u043E \u043F\u043E\u043B\u0435\u0437\u043D\u043E\u0435 \u0434\u043B\u044F \u0444\u0435\u0440\u043C\u0435\u0440\u043E\u0432?",
  "winter_Thu": "\u041F\u0440\u0438\u0432\u0435\u0442! \u041A\u0430\u043A \u0434\u0435\u043B\u0430?#$e#\u0421\u0435\u0439\u0447\u0430\u0441 \u0441\u0430\u043C\u043E\u0435 \u0432\u0440\u0435\u043C\u044F \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C \u043F\u0435\u0449\u0435\u0440\u044B.#$e#\u042F \u0431\u044B \u0438 \u0441\u0430\u043C\u0430 \u0441\u0445\u043E\u0434\u0438\u043B\u0430, \u043D\u043E \u043F\u0430\u043F\u0430 \u0432\u044B\u0439\u0434\u0435\u0442 \u0438\u0437 \u0441\u0435\u0431\u044F, \u0435\u0441\u043B\u0438 \u0443\u0437\u043D\u0430\u0435\u0442.",
  "winter_Fri": "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0432 \u044D\u0442\u043E\u043C \u0433\u043E\u0434\u0443 \u0442\u044B \u043D\u0435 \u0437\u0430\u0431\u043E\u043B\u0435\u0435\u0448\u044C \u0433\u0440\u0438\u043F\u043F\u043E\u043C.",
  "winter_Sat": "\u0423 \u0442\u0435\u0431\u044F \u0443\u0436\u0435 \u0435\u0441\u0442\u044C \u043F\u043B\u0430\u0432\u0438\u043B\u044C\u043D\u0430\u044F \u043F\u0435\u0447\u044C?#$e#\u0421 \u0435\u0435 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442\u044C \u0441\u044B\u0440\u044C\u0435 \u0432 \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0435 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B. \u0420\u0443\u0434\u0443 \u0432 \u0441\u043B\u0438\u0442\u043A\u0438, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440.$u",
  "winter_Sun": "\u041A\u043E\u0433\u0434\u0430 \u0442\u0430\u043A \u0445\u043E\u043B\u043E\u0434\u043D\u043E, \u043C\u0435\u043D\u044F \u043A\u043B\u043E\u043D\u0438\u0442 \u0432 \u0441\u043E\u043D...",
  "winter_Sat2": "\u0421\u043B\u0443\u0448\u0430\u0439, \u0435\u0441\u043B\u0438 \u0443 \u0442\u0435\u0431\u044F \u043D\u0430 \u0444\u0435\u0440\u043C\u0435 \u043F\u043E\u043B\u043E\u043C\u0430\u0435\u0442\u0441\u044F \u043A\u0430\u043A\u0430\u044F-\u043D\u0438\u0431\u0443\u0434\u044C \u043C\u0430\u0448\u0438\u043D\u0430, \u0441\u043A\u0430\u0436\u0438 \u043C\u043D\u0435.$h",
  "winter_Tue4": "\u0423 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C \u043A\u0430\u043A\u0438\u0435-\u043D\u0438\u0431\u0443\u0434\u044C \u0438\u0434\u0435\u0438, \u043A\u0430\u043A\u043E\u0435 \u044F \u043C\u043E\u0433\u0443 \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E?#$e#\u041C\u0433\u043C. \u042F \u0434\u043E\u0432\u0435\u0440\u044F\u044E \u0442\u0432\u043E\u0435\u043C\u0443 \u043C\u043D\u0435\u043D\u0438\u044E.",
  "winter_Fri6": "\u0417\u0434\u043E\u0440\u043E\u0432\u043E \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0448\u044C \u0441\u0435\u0433\u043E\u0434\u043D\u044F. \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u044D\u0442\u043E \u0438\u0437-\u0437\u0430 \u0441\u0432\u0435\u0436\u0435\u0433\u043E \u0437\u0438\u043C\u043D\u0435\u0433\u043E \u0432\u043E\u0437\u0434\u0443\u0445\u0430.",
  "winter_Mon8": "\u041F\u0440\u0438\u0432\u0435\u0442, @!$h#$e#\u0421\u043B\u0443\u0448\u0430\u0439, \u0442\u0435\u0431\u0435 \u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0447\u0442\u043E \u043C\u043E\u0439 \u0441\u043D\u0435\u0433\u043E\u0432\u0438\u043A \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u043E\u0445\u043E\u0436 \u043D\u0430 \u0442\u0435\u0431\u044F?",
  "winter_Thu10": "@, \u043F\u043E\u0434\u043E\u0439\u0434\u0438 \u043F\u043E\u0431\u043B\u0438\u0436\u0435. \u041C\u043D\u0435 \u0445\u043E\u043B\u043E\u0434\u043D\u043E.$l#$e#\u0423 \u043C\u0435\u043D\u044F \u0442\u0430\u043A \u0441\u043E\u0445\u043D\u0435\u0442 \u043A\u043E\u0436\u0430 \u043D\u0430 \u0440\u0443\u043A\u0430\u0445 \u0438\u0437-\u0437\u0430 \u0437\u0438\u043C\u043D\u0435\u0433\u043E \u0432\u043E\u0437\u0434\u0443\u0445\u0430. \u041F\u0440\u043E\u0441\u0442\u0438.$l"
