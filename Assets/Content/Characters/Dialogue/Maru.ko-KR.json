  "Thu10": "\uC624, @! \uD639\uC2DC \uB098\uB791 \uD558\uACE0 \uC2F6\uC740 \uC598\uAE30\uAC00 \uC788\uB294 \uAC70\uC57C?$l",
  "Event_Hospital_1": "\uB2F9\uC5F0\uD788 \uCC28\uC774\uB97C \uC54C\uACA0\uC9C0! \uC774 \uC0D8\uD50C\uC740 \uC644\uC804\uD788 \uB9DD\uCE5C \uAC70\uB77C\uACE0!%fork$s",
