  "Sat6": "\uC778\uCCB4\uC5D0 \uB300\uD574 \uC0DD\uAC01\uD574 \uBCF4\uBA74 \uC774\uAC8C \u0027\uC791\uB3D9\uD55C\uB2E4\u0027\uB77C\uB294 \uC0AC\uC2E4\uC774 \uBBFF\uAE30 \uC5B4\uB824\uC6CC.",
  "Sat8": "\uC788\uC9C0, \uB0B4\uAC00 \uC0DD\uAC01\uD574 \uBD24\uB294\uB370... \uC138\uC0C1\uC5D0 \uAE30\uC220\uC774 \uC544\uBB34\uB9AC \uBC1C\uC804\uD588\uC5B4\uB3C4, \uC9C4\uC9DC \uCE5C\uAD6C\uB9CC\uD55C \uAC74 \uC5C6\uC5B4.",
