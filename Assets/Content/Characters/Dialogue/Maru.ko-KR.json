  "Sat2": "\uBB54\uAC00\uB97C \uADF8\uB0E5 \uBC84\uB9AC\uB294 \uB300\uC2E0\uC5D0, \uB0B4 \uC190\uC73C\uB85C \uC218\uB9AC\uB97C \uD558\uBA74 \uC815\uB9D0 \uB9CC\uC871\uC2A4\uB7FD\uB354\uB77C.",
