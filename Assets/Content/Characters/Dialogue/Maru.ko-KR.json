  "summer_Tue": "\uC138\uBC14\uC2A4\uCC2C\uC740 \uB0B4 \uC774\uBD80 \uC624\uBE60\uC57C, \uC774\uBBF8 \uC54C\uACE0 \uC788\uACA0\uC9C0\uB9CC.#$e#\uC6B0\uB9B0 \uC644\uC804\uD788 \uB2E4\uB974\uAC8C \uC0DD\uACBC\uC9C0.",
  "summer_Tue4": "\uC138\uBC14\uC2A4\uCC2C\uC740 \uB098\uD55C\uD14C \uAC70\uC758 \uB9D0\uC744 \uC548 \uD574. \uB0B4\uAC00 \uC2EB\uC740 \uAC78\uAE4C?#$e#\uC880 \uC2AC\uD37C, \uC624\uBE60\uAC00 \uC788\uC5C8\uC73C\uBA74 \uC88B\uACA0\uB294\uB370 \uC804\uD600 \uC624\uBE60 \uAC19\uC9C0 \uC54A\uC544.",
