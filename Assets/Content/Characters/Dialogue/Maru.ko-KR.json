  "Event_Cut1": "\uADF8\uB798?$8#$b#\uC74C, \uAE30\uBD84\uC774 \uC870\uAE08 \uB098\uC544\uC9C0\uAE34 \uD588\uC5B4. \uACE0\uB9C8\uC6CC.",
  "Event_Cut2": "\uC624 \uC548\uB3FC! \uC544\uC544... \uC815\uB9D0 \uB108\uBB34 \uBBF8\uC548\uD574.$s",
  "event_robot1": "\uACE0\uB9C8\uC6CC. \uB098\uD55C\uD14C \uC815\uB9D0 \uC758\uBBF8\uAC00 \uCEE4, @.#$b#\uAE30\uACC4\uAC00 \uB124 \uAD00\uC2EC\uC0AC\uB294 \uC544\uB2C8\uB780 \uAC78 \uC54C\uC9C0\uB9CC... \uB0B4\uAC00 \uD558\uB294 \uC77C\uC5D0 \uAD00\uC2EC\uC744 \uBCF4\uC5EC\uC918\uC11C \uACE0\uB9C8\uC6CC.#$b#\uB098\uB3C4 \uC774 \uC740\uD61C\uB97C \uC5B4\uB5BB\uAC8C \uAC1A\uC544\uC57C \uD560 \uD150\uB370.$l",
  "event_robot2": "\uBB50? \uC544\uC8FC \uB300\uB193\uACE0 \uB178\uC608\uAC00 \uB418\uACE0 \uC2F6\uC9C0 \uC54A\uB2E4\uACE0 \uB9D0\uD55C \uB2E4\uC74C\uC5D0? \uB108\uBB34 \uB0C9\uD608\uD55C\uC774\uB2E4...%fork$a",
  "event_robot3": "\uD5E4...$8#$b#\uADF8\uB798 \uADF8\uB7F0 \uC2DD\uC73C\uB85C \uB9D0\uC500\uD558\uC2DC\uAE34 \uD588\uC9C0, \uADF8\uCE58?$l#$b#...\uC74C...$l",
  "event_robot4": "...$8#$b#@...$8",
  "event_robot_explain1": "...$s#$b#\uB124 \uB9D0\uC774 \uB9DE\uAE34 \uD574, \uB0B4\uAC00 \uC778\uAC04\uC801\uC73C\uB85C \uD589\uB3D9\uD558\uAC8C \uC124\uACC4\uD558\uAE34 \uD588\uC9C0... \uD558\uC9C0\uB9CC \uC2E0\uACBD \uD68C\uB85C\uB9DD\uC774 \uC6CC\uB099 \uBCF5\uC7A1\uD574\uC11C, \uC54C\uC544\uC11C \uC758\uC2DD\uC774 \uBC1C\uD604\uB418\uC9C0 \uC54A\uC558\uB2E4\uACE0 \uD655\uC2E0\uD560 \uC218 \uC5C6\uC5B4.$8#$b#\uAC8C\uB2E4\uAC00, \uC778\uAC04\uC801\uC778 \uC758\uC2DD\uC744 \uAC00\uC838\uC57C\uB9CC \uC874\uC7AC\uC758 \uAC00\uCE58\uAC00 \uC788\uB2E4\uACE0 \uAC00\uC815\uD558\uB294 \uAC83\uB3C4 \uC880 \uC624\uB9CC\uD55C \uC0DD\uAC01\uC778 \uAC83 \uAC19\uC9C0 \uC54A\uC544? \uCEF4\uD4E8\uD130 \uB1CC\uAC00 \uC6B0\uB9AC\uC640 \uB2E4\uB974\uC9C0\uB9CC, \uADF8\uB807\uB2E4\uACE0 \uBB34\uC2DC\uD560 \uC218 \uC788\uB294 \uAC74 \uC544\uB0D0.$8",
  "event_robot_explain2": "\uADF8\uB807\uAD6C\uB098. \uADFC\uB370 \uADF8\uB807\uAC8C \uC7AC\uBBF8\uC788\uB294 \uB18D\uB2F4\uC740 \uC544\uB2C8\uC5C8\uC5B4.$a",
  "event_robot_explain3": "\uB054\uCC0D\uD55C\uAC78! @, \uB108 \uC65C \uADF8\uB798?$a#$b#\uB098 \uADF8\uB0E5 \uC774 \uB300\uD654\uAC00 \uC788\uC5C8\uB2E4\uB294 \uC0AC\uC2E4\uC744 \uC78A\uB3C4\uB85D \uD560\uAC8C... \uB108 \uC9C0\uAE08 \uB108\uB2F5\uC9C0 \uC54A\uC544.$a",
  "summer_1": "\uC774\uBC88 \uC5EC\uB984\uC740 \uBCC4\uC744 \uAD00\uCC30\uD558\uAE30\uC5D0 \uC815\uB9D0 \uC88B\uC740 \uACC4\uC808\uC774 \uB420 \uAC70\uC57C.",
  "summer_Mon": "\uD760... \uC774\uBC88 \uC5EC\uB984\uC740 \uC5B4\uB5A4 \uAE30\uACC4\uB97C \uC190\uBCF4\uACE0 \uB180\uAE4C?",
