  "summer_Tue8": "@, \uC624\uB298 \uC608\uB9AC\uD574 \uBCF4\uC774\uB124.$h",
  "summer_Thu10": "\uB18D\uC7A5\uC5D0\uC11C \uADF8\uB807\uAC8C \uC77C\uD558\uACE0\uB3C4 \uC5B4\uB5BB\uAC8C \uC190\uC774 \uADF8\uB807\uAC8C \uBD80\uB4DC\uB7EC\uC6CC?",
