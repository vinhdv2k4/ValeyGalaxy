  "Thu_01_old": "\uB098\uC911\uC5D0 \uB610 \uBCF4\uC790.",
  "Thu_0": "\uC815\uB9D0? \uADF8\uB0E5 \uB098\uD55C\uD14C \uC544\uCCA8\uD558\uB294 \uAC8C \uC544\uB2C8\uACE0?",
  "Thu_01_01": "\uB0B4\uAC00 \uBABB\uD560 \uAC83 \uAC19\uC544?$s",
  "Thu_01_02": "\uB124 \uB9D0\uC774 \uB9DE\uC544, \uD558\uC9C0\uB9CC \uC5B4\uB824\uC6B4 \uC77C\uC5D0 \uB3C4\uC804\uD558\uB294 \uAC8C \uC88B\uC740 \uAC78!$h",
  "summer_Sat": "\uC57C, \uD639\uC2DC \uC7AC\uBC0C\uB294 \uB18D\uC7A5 \uC774\uC57C\uAE30 \uC788\uC5B4?#$e#\uC5C6\uB098 \uBCF4\uB124.",
  "summer_Fri": "\uC5B4\uC81C \uBCD1\uC6D0\uC5D0\uC11C \uC77C\uD588\uC5B4. \uD658\uC790\uAC00 \uD55C \uBA85\uB3C4 \uC548 \uC624\uB354\uB77C\uACE0.#$e#\uC5EC\uB984\uC5D0\uB294 \uC0AC\uB78C\uB4E4\uC774 \uB35C \uC544\uD508\uAC00 \uBD10.",
