  "summer_Wed2": "\uAC11\uC790\uAE30 \uB354\uC6CC\uC84C\uB2E4\uACE0 \uB290\uAEF4\uC9C0\uB294 \uC0AC\uB78C \uB098\uBFD0\uC774\uC57C?#$e#\uC9C4\uC9DC \uB098\uB9CC \uADF8\uB7F0\uAC00 \uBD10.",
