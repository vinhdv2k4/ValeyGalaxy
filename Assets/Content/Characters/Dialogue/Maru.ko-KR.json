  "fall_Sun": "\uC57C, \uB610 \uAD1C\uCC2E\uC740 \uD55C\uC8FC\uB97C \uC704\uD558\uC5EC! *\uAC74\uBC30*",
  "fall_Tue2": "@, \uB531 \uC9C0\uAE08 \uB098\uBB34 \uBAA8\uC2B5\uC774 \uB108\uBB34 \uB9C8\uC74C\uC5D0 \uB4E0\uB2E4!#$e#\uB108\uB3C4 \uB9C8\uC74C\uC5D0 \uB4E4\uC9C0?",
