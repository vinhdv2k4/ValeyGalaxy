  "Sun": "\uC548\uB155!#$q 3/4 Sun_01_old#\uB18D\uC7A5\uC5D0\uC11C \uC77C\uD558\uB294 \uAC74 \uC7AC\uBC0C\uC5B4?#$r 3 0 Sun_01_01#\uC751.#$r 4 0 Sun_01_02#\uC544\uB2C8.",
  "Sun_01_old": "$p 3#\uC624, \uB18D\uC7A5 \uC77C\uC774 \uD55C\uC8FC \uB354 \uC9C4\uCC99\uC774 \uC788\uC5C8\uB124! \uC77C\uC774 \uC798 \uD480\uB824\uAC00\uB294 \uAC83 \uAC19\uC544.$h|\uB18D\uC7A5\uC5D0\uC11C \uB610 \uC9C0\uCE58\uB294 \uD55C\uC8FC\uB97C \uB9C8\uCCE4\uAD6C\uB098? \uC815\uB9D0 \uC77C\uC774 \uB9CE\uC744 \uAC83 \uAC19\uC544...$s",
  "Sun_01_01": "\uADF8\uAC70 \uC88B\uC740 \uAC70\uC9C0, \uADF8\uCE58?$h",
  "Sun_01_02": "\uC73C\uC545! \uC720\uAC10\uC774\uB124. \uD639\uC2DC \uB2E4\uB978 \uC77C\uC744 \uD560 \uC0DD\uAC01\uC740 \uD574\uBD24\uC5B4...?$s",
  "Tue2": "\uAC74\uBB3C\uC744 \uC5C5\uADF8\uB808\uC774\uB4DC\uD558\uACE0 \uC2F6\uC73C\uBA74 \uC6B0\uB9AC \uC9D1\uC5D0 \uBC29\uBB38\uD574\uC918.#$e#\uC190\uB2D8\uC774 \uCC3E\uC544\uC624\uB294 \uAC74 \uC5B8\uC81C\uB77C\uB3C4 \uC88B\uB354\uB77C.",
  "Fri4": "\uC5C4\uB9C8\uB294 \uBAA9\uC218\uC2DC\uACE0 \uC544\uBE60\uB294 \uACFC\uD559\uC790\uC154. \uB0B4\uAC00 \uC774\uB7F0\uC800\uB7F0 \uAE30\uAE30\uB97C \uB9CC\uB4E4\uAE30 \uC88B\uC544\uD558\uB294 \uAC8C \uB9D0\uC774 \uB418\uB124.",
  "Fri6": "\uC544\uBE60\uB294 \uC544\uC8FC \uB17C\uB9AC\uC801\uC774\uACE0, \uC5C4\uB9C8\uB294 \uC544\uC8FC \uC9C1\uAC10\uC801\uC774\uC154. \uAC00\uB054 \uADF8\uB7F0 \uCC28\uC774 \uB54C\uBB38\uC5D0 \uAC08\uB4F1\uC774 \uC0DD\uAE30\uAE30\uB3C4 \uD574...$s",
  "Mon6": "\uAC00\uB054 \uBA38\uB9BF\uC18D\uC774 \uC4F8\uBAA8\uC5C6\uB294 \uC0DD\uAC01\uC73C\uB85C \uC5B4\uC218\uC120\uD574\uC838\uC11C \uC0DD\uAC01\uD558\uAE30\uB3C4 \uD798\uB4E4\uC5B4\uC838. \uD639\uC2DC \uB108\uB3C4 \uADF8\uB798?#$e#\uADF8\uB7F4 \uB54C\uB294 \uC2E0\uC120\uD55C \uBC14\uB78C\uC744 \uC42C\uBA74 \uB3C4\uC6C0\uC774 \uB418\uB354\uB77C\uACE0.",
