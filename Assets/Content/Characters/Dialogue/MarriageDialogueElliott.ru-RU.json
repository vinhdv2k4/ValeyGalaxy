{
  "Rainy_Day_0": "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E \u0432\u0434\u043E\u0445\u043D\u043E\u0432\u0435\u043D\u0438\u0435... \u041F\u043E\u0436\u0430\u043B\u0443\u0439, \u043F\u043E\u043F\u0438\u0448\u0443 \u043D\u0435\u043C\u043D\u043E\u0433\u043E.",
  "Rainy_Day_1": "\u041F\u0443\u0441\u043A\u0430\u0439 \u0438 \u043E\u0447\u0435\u043D\u044C \u043E\u0442\u0434\u0430\u043B\u0435\u043D\u043D\u043E, \u043D\u043E \u0448\u0443\u043C \u0434\u043E\u0436\u0434\u044F \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442 \u043C\u043D\u0435 \u043E \u043C\u043E\u0435\u043C \u0434\u043E\u043C\u0438\u043A\u0435 \u043D\u0430 \u043F\u043B\u044F\u0436\u0435.#$e#\u0424\u0435\u0440\u043C\u0430 \u0437\u0430\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F, \u043D\u043E \u044F \u0441\u043A\u0443\u0447\u0430\u044E \u043F\u043E \u0436\u0438\u0437\u043D\u0438 \u0443 \u043E\u043A\u0435\u0430\u043D\u0430.",
  "Rainy_Day_2": "\u042F \u0432\u0441\u0442\u0430\u043B \u043F\u043E\u0440\u0430\u043D\u044C\u0448\u0435 \u0438 \u0441\u0434\u0435\u043B\u0430\u043B \u043A\u043E\u0444\u0435.[395]#$e#\u042F \u043D\u0430\u0445\u043E\u0436\u0443, \u0447\u0442\u043E \u0447\u0430\u0448\u043A\u0430 \u044D\u0442\u043E\u0433\u043E \u0438\u0437\u044B\u0441\u043A\u0430\u043D\u043D\u043E\u0433\u043E \u043D\u0430\u043F\u0438\u0442\u043A\u0430 \u0434\u0435\u043B\u0430\u0435\u0442 \u0440\u0430\u043D\u043D\u0435\u0435 \u0443\u0442\u0440\u043E \u043D\u0430\u043C\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u044F\u0442\u043D\u0435\u0435.",
  "Rainy_Day_3": "\u041F\u043E\u0436\u0430\u043B\u0443\u0439, \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u043F\u043E\u0441\u0438\u0436\u0443 \u0434\u043E\u043C\u0430, \u043B\u044E\u0431\u043E\u0432\u044C \u043C\u043E\u044F. \u041E\u0442 \u0434\u043E\u0436\u0434\u044F \u0443 \u043C\u0435\u043D\u044F \u0441\u043B\u0430\u0431\u0435\u044E\u0442 \u0432\u043E\u043B\u043E\u0441\u044B.",
  "Rainy_Day_4": "\u041F\u0438\u0441\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0435 \u0432\u0434\u043E\u0445\u043D\u043E\u0432\u0435\u043D\u0438\u0435 \u2014 \u043A\u0430\u043A \u043F\u043E\u0433\u043E\u0434\u0430... \u041E\u043D\u043E \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0438 \u0443\u0445\u043E\u0434\u0438\u0442 \u0441\u043F\u043E\u043D\u0442\u0430\u043D\u043D\u043E. \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E \u0441\u0435\u0431\u044F \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E \u043F\u0443\u0441\u0442\u044B\u043C.$s#$e#\u041F\u043E\u0436\u0430\u043B\u0443\u0439, \u043F\u043E\u0447\u0438\u0442\u0430\u044E \u043A\u043B\u0430\u0441\u0441\u0438\u043A\u0443, \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0441\u0448\u0435\u0432\u0435\u043B\u0438\u0442\u044C \u0441\u0432\u043E\u044E \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u043A\u0443\u044E \u0436\u0438\u043B\u043A\u0443.",
  "patio_Elliott": "\u0410\u0445, \u043A\u0430\u043A\u043E\u0439 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u0434\u0435\u043D\u044C \u0434\u043B\u044F \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u043A\u043D\u0438\u0433\u0443... \u041D\u0435 \u043F\u0440\u0430\u0432\u0434\u0430 \u043B\u0438, \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u043A\u0430 \u043C\u043E\u044F?",
  "Rainy_Night_0": "\u0414\u043E\u0431\u0440\u044B\u0439 \u0432\u0435\u0447\u0435\u0440. \u041F\u0440\u043E\u0434\u0443\u043A\u0442\u0438\u0432\u043D\u044B\u043C \u043B\u0438 \u0432\u044B\u0434\u0430\u043B\u0441\u044F \u0434\u0435\u043D\u044C, @?^\u0414\u043E\u0431\u0440\u044B\u0439 \u0432\u0435\u0447\u0435\u0440. \u041F\u0440\u043E\u0434\u0443\u043A\u0442\u0438\u0432\u043D\u044B\u043C \u043B\u0438 \u0432\u044B\u0434\u0430\u043B\u0441\u044F \u0434\u0435\u043D\u044C, \u043B\u044E\u0431\u043E\u0432\u044C \u043C\u043E\u044F?",
  "Rainy_Night_1": "\u0422\u044B \u043F\u0440\u043E\u0441\u0442\u043E ${\u043B\u0435\u0434\u044F\u043D\u043E\u0439^\u043B\u0435\u0434\u044F\u043D\u0430\u044F}$! ${\u0414\u0430\u0432\u0430\u0439^\u0414\u0430\u0439}$ \u044F \u0442\u0435\u0431\u044F \u0441\u043E\u0433\u0440\u0435\u044E.$l",
  "Rainy_Night_2": "\u042F \u043B\u0443\u0447\u0448\u0435 \u043C\u043D\u043E\u0433\u0438\u0445 \u0432\u043B\u0430\u0434\u0435\u044E \u0441\u043B\u043E\u0432\u043E\u043C, \u043D\u043E \u043D\u0435 \u043C\u043E\u0433\u0443 \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u0442\u044C \u043D\u0443\u0436\u043D\u044B\u0445 \u0441\u043B\u043E\u0432 \u0434\u043B\u044F \u0442\u0432\u043E\u0435\u0433\u043E \u043E\u0431\u0430\u044F\u043D\u0438\u044F.$l^\u042F \u043B\u0443\u0447\u0448\u0435 \u043C\u043D\u043E\u0433\u0438\u0445 \u0432\u043B\u0430\u0434\u0435\u044E \u0441\u043B\u043E\u0432\u043E\u043C, \u043D\u043E \u043D\u0435 \u043C\u043E\u0433\u0443 \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u0442\u044C \u043D\u0443\u0436\u043D\u044B\u0445 \u0441\u043B\u043E\u0432 \u0434\u043B\u044F \u0442\u0432\u043E\u0435\u0439 \u043A\u0440\u0430\u0441\u043E\u0442\u044B.$l",
  "Rainy_Night_3": "\u0427\u0435\u043C \u044F \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0441\u044F? \u042F \u0441\u043A\u0430\u0436\u0443 \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u043D\u043E... \u0427\u0442\u043E\u0431\u044B \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0442\u044C \u0442\u0430\u043A\u0443\u044E \u043C\u0443\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E \u0444\u0438\u0433\u0443\u0440\u0443, \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u043C\u043D\u043E\u0433\u043E \u0442\u0440\u0443\u0434\u0430!",
  "Rainy_Night_4": "\u042F \u0432\u0435\u0441\u044C \u0434\u0435\u043D\u044C \u043F\u0440\u043E\u043C\u0435\u0447\u0442\u0430\u043B \u043E\u0431 \u043E\u043A\u0435\u0430\u043D\u0435. \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0443 \u043D\u0430\u0441 \u043C\u043E\u0440\u0435\u043F\u0440\u043E\u0434\u0443\u043A\u0442\u044B.[198 202 727 728]$h",
  "Indoor_Day_0": "\u0421 \u0442\u0435\u0445 \u043F\u043E\u0440, \u043A\u0430\u043A \u043C\u044B \u0432\u043C\u0435\u0441\u0442\u0435, \u044F \u043D\u0430\u0447\u0430\u043B \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u043B\u0443\u0447\u0448\u0435 \u0441\u043B\u0435\u0434\u0438\u0442\u044C \u0437\u0430 \u0441\u043E\u0431\u043E\u0439. \u0425\u043E\u043B\u043E\u0441\u0442\u044F\u0446\u043A\u0430\u044F \u0436\u0438\u0437\u043D\u044C \u0431\u044B\u043B\u0430 \u043D\u0435 \u043E\u0447\u0435\u043D\u044C-\u0442\u043E \u0437\u0434\u043E\u0440\u043E\u0432\u043E\u0439.",
  "Indoor_Day_1": "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E, @! \u042F \u0441\u0432\u0430\u0440\u0438\u043B \u043D\u0430\u043C \u043A\u043E\u0444\u0435.[395]#$e#\u042F \u043F\u043E\u043D\u044F\u043B, \u0447\u0442\u043E \u0445\u043E\u0447\u0443 \u043D\u0430\u0441\u043B\u0430\u0436\u0434\u0430\u0442\u044C\u0441\u044F \u044D\u0442\u0438\u043C \u043A\u0440\u0435\u043F\u043A\u0438\u043C \u0432\u043A\u0443\u0441\u043E\u043C \u043A\u0430\u0436\u0434\u043E\u0435 \u0443\u0442\u0440\u043E.",
  "Indoor_Day_2": "\u0415\u0441\u043B\u0438 \u043D\u0430\u0439\u0434\u0435\u0448\u044C \u0432 \u0434\u043E\u043C\u0435 \u043F\u0430\u0443\u043A\u0430, \u043D\u0435 \u0434\u0430\u0432\u0438 \u0435\u0433\u043E! \u041F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u0437\u043E\u0432\u0438 \u043C\u0435\u043D\u044F, \u0438 \u044F \u0432\u044B\u043F\u0443\u0449\u0443 \u0431\u0435\u0434\u043D\u044F\u0436\u043A\u0443 \u043D\u0430 \u043F\u0440\u0438\u0440\u043E\u0434\u0443.",
  "Indoor_Day_3": "\u0414\u0435\u043D\u044C \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0431\u0443\u0434\u0435\u0442 \u0440\u0430\u0441\u0447\u0443\u0434\u0435\u0441\u043D\u044B\u0439... \u042F \u044D\u0442\u043E \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E!$h#$e#\u0423 \u043C\u0435\u043D\u044F \u0432 \u043D\u043E\u0441\u0443 \u0431\u044B\u0432\u0430\u0435\u0442 \u0442\u0430\u043A\u043E\u0435 \u043E\u0441\u043E\u0431\u043E\u0435 \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435...",
  "Indoor_Day_4": "\u041C\u043D\u0435 \u0447\u0430\u0441\u0442\u043E \u0441\u043D\u0438\u0442\u0441\u044F \u043A\u043E\u0448\u043C\u0430\u0440, \u0433\u0434\u0435 \u0442\u044B \u0431\u0440\u0435\u0435\u0448\u044C \u043C\u0435\u043D\u044F \u043F\u043E\u0434 \u00AB\u0435\u0436\u0438\u043A\u00BB. \u0422\u044B \u0432\u0435\u0434\u044C \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u0441\u043E \u043C\u043D\u043E\u0439 \u0442\u0430\u043A \u043D\u0435 \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u0448\u044C, \u043F\u0440\u0430\u0432\u0434\u0430?$s#$e#\u042F \u0442\u0435\u0431\u0435 \u0434\u043E\u0432\u0435\u0440\u044F\u044E.",
  "Indoor_Night_0": "\u041D\u0438 \u044F\u0440\u0447\u0430\u0439\u0448\u0430\u044F \u0437\u0438\u043C\u043D\u044F\u044F \u0437\u0432\u0435\u0437\u0434\u0430, \u043D\u0438 \u0431\u043B\u0435\u0441\u043A \u0438\u0440\u0438\u0434\u0438\u0435\u0432\u043E\u0439 \u0436\u0438\u043B\u044B... \u041D\u0438\u0447\u0442\u043E \u043D\u0435 \u0441\u0440\u0430\u0432\u043D\u0438\u0442\u0441\u044F \u0441 \u043C\u043E\u0438\u043C \u0447\u0443\u0434\u0435\u0441\u043D\u044B\u043C \u043C\u0443\u0436\u0435\u043C.$l^\u041D\u0438 \u044F\u0440\u0447\u0430\u0439\u0448\u0430\u044F \u0437\u0438\u043C\u043D\u044F\u044F \u0437\u0432\u0435\u0437\u0434\u0430, \u043D\u0438 \u0430\u0440\u043E\u043C\u0430\u0442\u043D\u0430\u044F \u0441\u043A\u0430\u0437\u043E\u0447\u043D\u0430\u044F \u0440\u043E\u0437\u0430... \u041D\u0438\u0447\u0442\u043E \u043D\u0435 \u0441\u0440\u0430\u0432\u043D\u0438\u0442\u0441\u044F \u0441 \u0442\u0432\u043E\u0435\u0439 \u043F\u043B\u0435\u043D\u044F\u044E\u0449\u0435\u0439 \u043A\u0440\u0430\u0441\u043E\u0442\u043E\u0439.$l",
  "Indoor_Night_1": "\u0422\u0440\u0435\u0441\u043A \u0433\u043E\u0440\u044F\u0449\u0435\u0433\u043E \u0434\u0435\u0440\u0435\u0432\u0430 \u0441\u043E\u0437\u0434\u0430\u0435\u0442 \u0432 \u0434\u043E\u043C\u0435 \u0447\u0443\u0434\u0435\u0441\u043D\u0443\u044E \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0443... \u041A\u0430\u0436\u0434\u0430\u044F \u0434\u0435\u0440\u0435\u0432\u044F\u0448\u043A\u0430 \u0433\u043E\u0440\u0438\u0442 \u043F\u043E-\u0441\u0432\u043E\u0435\u043C\u0443.",
  "Indoor_Night_2": "\u0423 \u043C\u0435\u043D\u044F \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u043B\u043E\u0441\u044C \u0432\u044B\u0440\u0430\u0441\u0442\u0438\u0442\u044C \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0432 \u0441\u0432\u043E\u0435\u043C \u0441\u0442\u0430\u0440\u043E\u043C \u0434\u043E\u043C\u0438\u043A\u0435. \u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u044F \u0437\u0430 \u0442\u043E\u0431\u043E\u0439 \u044F \u043D\u0430\u0443\u0447\u0443\u0441\u044C \u0447\u0435\u043C\u0443-\u043D\u0438\u0431\u0443\u0434\u044C.#$e#\u0412 \u044D\u0442\u043E\u043C \u0434\u0435\u043B\u0435 \u0442\u044B \u2014 \u043C\u0430\u0441\u0442\u0435\u0440, \u0430 \u044F \u2014 \u0441\u043A\u0440\u043E\u043C\u043D\u044B\u0439 \u043F\u043E\u0434\u043C\u0430\u0441\u0442\u0435\u0440\u044C\u0435.",
  "Indoor_Night_3": "\u041A\u043E\u0433\u0434\u0430 \u043F\u0435\u0440\u0435\u0434\u043E \u043C\u043D\u043E\u0439 \u0442\u0432\u043E\u0439 \u043B\u0438\u043A, \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u0435\u043D \u043A\u0430\u043A \u0432 \u0440\u0430\u044E \u0446\u0432\u0435\u0442\u043D\u0438\u043A... \u043D\u0435\u0432\u0435\u0434\u043E\u043C \u0431\u043E\u043B\u0435 \u043D\u043E\u0447\u0438 \u0441\u0442\u0440\u0430\u0445, \u0440\u0430\u0441\u0441\u0435\u044F\u043D \u0447\u0438\u0441\u0442\u044B\u043C \u0441\u0432\u0435\u0442\u043E\u043C \u043F\u0440\u0430\u0445.#$e#\u0422\u043E\u043B\u044C\u043A\u043E \u0441\u0442\u0438\u0445\u0430\u043C\u0438 \u044F \u043C\u043E\u0433\u0443 \u043F\u043E\u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u043E\u043F\u0438\u0441\u0430\u0442\u044C \u0441\u0432\u043E\u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u0430 \u043A \u0442\u0435\u0431\u0435.$l",
  "Indoor_Night_4": "${\u041B\u044E\u0431\u0438\u043C\u044B\u0439^\u041B\u044E\u0431\u0438\u043C\u0430\u044F}$... \u042F \u043D\u0435 \u043F\u0440\u043E\u043C\u0435\u043D\u044F\u043B \u0431\u044B \u0442\u0435\u0431\u044F \u0438 \u043D\u0430 100 \u0438\u0440\u0438\u0434\u0438\u0435\u0432\u044B\u0445 \u0441\u043B\u0438\u0442\u043A\u043E\u0432.#$e#\u0418 \u043D\u0435 \u043D\u0430 1000...#$e#\u0414\u0430\u0436\u0435 \u043D\u0435 \u043D\u0430 10,000 \u0441\u043B\u0438\u0442\u043A\u043E\u0432, \u043D\u0435\u0442.$7#$e#...$7#$e#\u041D\u0435\u0442, \u0434\u0430\u0436\u0435 \u043D\u0435 \u043D\u0430 100,000!$a#$e#...$s#$e#\u0421\u0442\u043E\u043F... \u041C\u0438\u043B\u043B\u0438\u043E\u043D \u0441\u043B\u0438\u0442\u043A\u043E\u0432 \u0447\u0438\u0441\u0442\u043E\u0433\u043E \u0438\u0440\u0438\u0434\u0438\u044F?.. \u041D\u0435 \u0432\u044B\u043D\u0443\u0436\u0434\u0430\u0439 \u043C\u0435\u043D\u044F \u0434\u0435\u043B\u0430\u0442\u044C \u044D\u0442\u043E\u0433\u043E...$8",
  "Outdoor_0": "\u041C\u043E\u0438 \u0441\u0430\u043C\u044B\u0435 \u0431\u0443\u0440\u043D\u044B\u0435 \u0444\u0430\u043D\u0442\u0430\u0437\u0438\u0438 \u0432\u043E\u043F\u043B\u043E\u0449\u0435\u043D\u044B... \u0422\u043E\u043B\u044C\u043A\u043E \u0432\u0437\u0433\u043B\u044F\u043D\u0438 \u043D\u0430 \u044D\u0442\u043E\u0442 \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u044B\u0439 \u043B\u0430\u043D\u0434\u0448\u0430\u0444\u0442!",
  "Outdoor_1": "\u041F\u043B\u043E\u0434\u043E\u0440\u043E\u0434\u043D\u0430\u044F \u043F\u043E\u0447\u0432\u0430 \u043F\u043E\u0434 \u043D\u043E\u0433\u0430\u043C\u0438, \u0441\u0432\u0435\u0436\u0438\u0439 \u0432\u043E\u0437\u0434\u0443\u0445 \u0432 \u043B\u0435\u0433\u043A\u0438\u0445, \u0442\u0435\u043F\u043B\u043E \u0441\u043E\u043B\u043D\u0446\u0430 \u043B\u0430\u0441\u043A\u0430\u0435\u0442 \u043A\u043E\u0436\u0443... \u0416\u0438\u0437\u043D\u044C \u0445\u043E\u0440\u043E\u0448\u0430.",
  "Outdoor_2": "\u041F\u043E\u0436\u0430\u043B\u0443\u0439, \u044F \u043E\u0441\u0442\u0430\u043D\u0443\u0441\u044C \u0437\u0434\u0435\u0441\u044C \u0438 \u043D\u0430\u043F\u0438\u0448\u0443 \u0441\u0442\u0438\u0445\u0438. \u0423 \u043C\u0435\u043D\u044F \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E\u0435 \u0432\u0434\u043E\u0445\u043D\u043E\u0432\u0435\u043D\u0438\u0435! \u0422\u044B \u0437\u0430\u043D\u0438\u043C\u0430\u0439\u0441\u044F \u0434\u0435\u043B\u0430\u043C\u0438, \u0430 \u043E\u0431\u043E \u043C\u043D\u0435 \u043D\u0435 \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0439\u0441\u044F.",
  "Outdoor_3": "\u0415\u0441\u043B\u0438 \u044F \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435 \u0431\u0443\u0434\u0443 \u0448\u0435\u0432\u0435\u043B\u0438\u0442\u044C\u0441\u044F, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043B\u0443\u0447\u0435\u0437\u0430\u0440\u043D\u0430\u044F \u0431\u0430\u0431\u043E\u0447\u043A\u0430 \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0438\u0442 \u043C\u043E\u0439 \u043D\u043E\u0441, \u0438\u0437\u0431\u0440\u0430\u0432 \u0435\u0433\u043E \u0441\u0432\u043E\u0438\u043C \u043C\u0435\u0441\u0442\u043E\u043C \u0434\u043B\u044F \u043E\u0442\u0434\u044B\u0445\u0430.",
  "Outdoor_4": "\u042F \u0432\u044B\u043F\u0438\u043B \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E \u043A\u043E\u0444\u0435... \u0412\u043E \u0440\u0442\u0443 \u0441\u0443\u0445\u043E, \u043A\u0430\u043A \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u0435 \u041A\u0430\u043B\u0438\u043A\u043E.$s#$e#\u041E\u0439... \u041F\u0440\u043E\u0441\u0442\u0438 \u0437\u0430 \u043A\u043E\u0444\u0435\u0439\u043D\u043E\u0435 \u0434\u044B\u0445\u0430\u043D\u0438\u0435.$7",
  "OneKid_0": "\u041A\u0430\u043A \u0442\u0430\u043C %kid1, \u0443 \u0432\u0430\u0441 \u0431\u044B\u043B\u043E \u0432\u0440\u0435\u043C\u044F \u043F\u043E\u0438\u0433\u0440\u0430\u0442\u044C? \u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u0441\u043E \u0432\u0442\u043E\u0440\u044B\u043C \u0440\u0435\u0431\u0435\u043D\u043A\u043E\u043C \u043D\u0430\u043C \u043E\u0431\u043E\u0438\u043C \u0441\u0442\u0430\u043D\u0435\u0442 \u043B\u0435\u0433\u0447\u0435.",
  "OneKid_1": "\u041C\u0430\u043B\u044E\u0442\u043A\u0430 %kid1 \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u0442 \u0437\u0434\u0435\u0441\u044C \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E\u0435 \u0434\u0435\u0442\u0441\u0442\u0432\u043E. \u0417\u0434\u0435\u0441\u044C \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0432\u0441\u0435\u0433\u043E \u043C\u043E\u0436\u043D\u043E \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C.",
  "OneKid_3": "\u0423\u0445\u043E\u0434 \u0437\u0430 \u0434\u0435\u0442\u044C\u043C\u0438 \u2014 \u043D\u0435 \u0441\u0430\u043C\u0430\u044F \u043C\u043E\u044F \u0441\u0438\u043B\u044C\u043D\u0430\u044F \u0441\u0442\u043E\u0440\u043E\u043D\u0430... \u041D\u043E \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C \u0431\u044B\u0442\u044C \u0445\u043E\u0440\u043E\u0448\u0438\u043C \u043E\u0442\u0446\u043E\u043C.",
  "TwoKids_0": "%kid1 \u0438 %kid2 \u0443\u0436\u0435 \u043F\u043E\u043A\u0443\u0448\u0430\u043B\u0438. \u0414\u043B\u044F \u0442\u0430\u043A\u0438\u0445 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0445 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0439 \u043E\u043D\u0438 \u043D\u0430 \u0434\u0438\u0432\u043E \u0433\u0440\u043E\u043C\u043A\u043E \u043A\u0440\u0438\u0447\u0430\u0442!",
  "TwoKids_1": "\u041A\u043B\u044F\u043D\u0443\u0441\u044C, \u044F \u0441\u043B\u044B\u0448\u0430\u043B, \u043A\u0430\u043A %kid1... \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F \u0441\u043A\u0430\u0437\u0430\u0442\u044C \u00AB\u041F\u0430... \u043F\u0430\u00BB.$h",
  "TwoKids_2": "%kid1, \u0442\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0441\u043A\u043E\u0440\u0435\u0435 \u043D\u0430\u0443\u0447\u0438\u0442\u044C\u0441\u044F \u0447\u0438\u0442\u0430\u0442\u044C! \u042D\u0442\u043E \u0432\u0435\u0434\u044C \u043B\u0443\u0447\u0448\u0438\u0439 \u0441\u043F\u043E\u0441\u043E\u0431 \u043F\u043E\u0437\u043D\u0430\u0442\u044C \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u0439 \u043C\u0438\u0440.",
  "TwoKids_3": "\u041C\u044B \u0445\u043E\u0440\u043E\u0448\u043E \u043F\u043E\u0442\u0440\u0443\u0434\u0438\u043B\u0438\u0441\u044C, @. \u0414\u0435\u043B\u0430 \u043D\u0430 \u0444\u0435\u0440\u043C\u0435 \u0438\u0434\u0443\u0442 \u0437\u0430\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E, \u0430 \u0437\u0434\u043E\u0440\u043E\u0432\u044B\u0435 \u0434\u0435\u0442\u0438 \u0440\u0430\u0434\u0443\u044E\u0442 \u043D\u0430\u0441. \u0411\u044B\u0442\u044C \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u0435\u0435 \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E.",
  "Good_0": "@... \u042F \u0442\u0430\u043A \u0433\u043E\u0440\u0436\u0443\u0441\u044C \u0442\u0432\u043E\u0438\u043C \u0442\u0440\u0443\u0434\u043E\u043C. \u041C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u0441 \u0442\u043E\u0431\u043E\u0439 \u043F\u043E\u0432\u0435\u0437\u043B\u043E.$l",
  "Good_1": "\u042F \u0442\u0430\u0439\u043A\u043E\u043C \u043D\u0430\u043F\u0438\u0441\u0430\u043B \u0446\u0435\u043B\u0443\u044E \u043A\u043D\u0438\u0433\u0443 \u0441\u0442\u0438\u0445\u043E\u0432 \u043E \u043C\u043E\u0435\u0439 \u043B\u044E\u0431\u0432\u0438 \u043A \u0442\u0435\u0431\u0435.$l",
  "Good_2": "\u042F \u043F\u043E\u043F\u0430\u043B \u0432 \u044D\u0442\u0443 \u0434\u043E\u043B\u0438\u043D\u0443 \u0432 \u043F\u043E\u0438\u0441\u043A\u0430\u0445 \u0431\u0430\u0448\u043D\u0438 \u0438\u0437 \u0441\u043B\u043E\u043D\u043E\u0432\u043E\u0439 \u043A\u043E\u0441\u0442\u0438, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043C\u043E\u0438 \u0442\u0430\u043B\u0430\u043D\u0442\u044B \u043C\u043E\u0433\u043B\u0438 \u0431\u044B \u0431\u0435\u0437\u0440\u0430\u0437\u0434\u0435\u043B\u044C\u043D\u043E \u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0431\u0430\u043B. \u041D\u043E \u043D\u0430\u0448\u0435\u043B \u044F \u043B\u0438\u0448\u044C \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u0435 \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u0430. \u0422\u044B \u2014 ${\u043C\u043E\u0439 \u0441\u043F\u0430\u0441\u0438\u0442\u0435\u043B\u044C^\u043C\u043E\u044F \u0441\u043F\u0430\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u0438\u0446\u0430}$.$l",
  "Good_3": "\u041E\u0433\u043E, \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0442\u044B \u043D\u0435\u043E\u0442\u0440\u0430\u0437\u0438\u043C! \u0422\u044B \u043F\u043E\u0431\u0440\u0438\u043B\u0441\u044F? \u041B\u0438\u043D\u0438\u044F \u043F\u043E\u0434\u0431\u043E\u0440\u043E\u0434\u043A\u0430 \u043F\u0440\u043E\u0441\u0442\u043E \u0431\u0435\u0437\u0443\u043F\u0440\u0435\u0447\u043D\u0430.$l^\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0442\u0432\u043E\u0438 \u0436\u0435\u043D\u0441\u043A\u0438\u0435 \u0447\u0430\u0440\u044B \u043D\u0435\u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0438\u043C\u044B. \u042F \u043D\u0435 \u043C\u043E\u0433\u0443 \u043E\u0442\u0432\u0435\u0441\u0442\u0438 \u043E\u0442 \u0442\u0435\u0431\u044F \u0433\u043B\u0430\u0437.$l",
  "Good_4": "\u0412 \u0442\u0432\u043E\u0435 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E \u0441\u0435\u0431\u044F \u0442\u0430\u043A\u0438\u043C \u0431\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u043D\u044B\u043C. \u041D\u043E \u043A\u043E\u0433\u0434\u0430 \u044F \u0441\u043B\u044B\u0448\u0443 \u0448\u0430\u0433\u0438 \u0442\u0432\u043E\u0438\u0445 \u0433\u0440\u044F\u0437\u043D\u044B\u0445 \u0441\u0430\u043F\u043E\u0433 \u043F\u043E \u0434\u0435\u0440\u0435\u0432\u0443, \u043C\u043E\u0435 \u0441\u0435\u0440\u0434\u0446\u0435 \u0432\u043E\u0441\u0441\u0442\u0430\u0435\u0442 \u0438\u0437 \u043F\u0435\u043F\u043B\u0430.",
  "Good_5": "\u042F \u0437\u0430\u043D\u0438\u043C\u0430\u044E\u0441\u044C \u043C\u0435\u0434\u0438\u0442\u0430\u0446\u0438\u0435\u0439 \u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F. \u041F\u043E\u043B\u0435\u0437\u043D\u043E \u0434\u043B\u044F \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u0442\u0432\u0430.",
  "Good_6": "\u0411\u0443\u0434\u044C \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u0435\u0439! \u0418\u043D\u043E\u0433\u0434\u0430 \u044F \u0437\u0430 \u0442\u0435\u0431\u044F \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u044E. \u0412 \u044D\u0442\u043E\u043C \u043C\u0438\u0440\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u0435\u0441\u0442\u044C \u043B\u044E\u0434\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0445\u043E\u0442\u044F\u0442 \u0442\u043E\u0431\u043E\u0439 \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F.",
  "funLeave_Elliott": "\u0414\u0443\u043C\u0430\u044E, \u044F \u0441\u0445\u043E\u0436\u0443 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0430 \u043F\u043B\u044F\u0436. \u0412\u0441\u0435\u0433\u0434\u0430 \u043F\u0440\u0438\u044F\u0442\u043D\u043E \u0441\u043D\u043E\u0432\u0430 \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u043E\u043A\u0435\u0430\u043D.",
  "funReturn_Elliott": "\u042F \u043F\u0440\u0438\u044F\u0442\u043D\u043E \u043F\u0440\u043E\u0432\u0435\u043B \u0432\u0440\u0435\u043C\u044F \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u0435 \u043D\u0430 \u043F\u043B\u044F\u0436\u0435. \u042F \u0441\u043C\u043E\u0442\u0440\u0435\u043B, \u043A\u0430\u043A \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442 \u0438 \u0443\u0445\u043E\u0434\u044F\u0442 \u0432\u043E\u043B\u043D\u044B, \u043F\u0440\u044F\u043C\u043E \u043A\u0430\u043A \u0432 \u0441\u0442\u0430\u0440\u044B\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0430.",
  "spring_1": "\u041C\u043E\u0439 \u0437\u0430\u0440\u043E\u043A \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0433\u043E\u0434 \u2014 \u043F\u0438\u0441\u0430\u0442\u044C, \u043F\u0438\u0441\u0430\u0442\u044C, \u0438 \u0435\u0449\u0435 \u0440\u0430\u0437 \u043F\u0438\u0441\u0430\u0442\u044C! \u041C\u043D\u0435 \u043D\u0435\u043B\u044C\u0437\u044F \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0432\u0430\u0442\u044C \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C\u0441\u044F.",
  "spring_12": "\u0421\u0442\u0440\u0430\u043D\u043D\u043E, \u043D\u043E \u0432\u0435\u0441\u043D\u043E\u0439 \u043C\u043D\u0435 \u0447\u0430\u0441\u0442\u043E \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0433\u0440\u0430\u043D\u0430\u0442\u043E\u0432.",
  "spring_23": "\u041C\u043D\u0435 \u043D\u0435 \u0442\u0435\u0440\u043F\u0438\u0442\u0441\u044F \u043F\u043E\u0442\u0430\u043D\u0446\u0435\u0432\u0430\u0442\u044C \u0441 \u0442\u043E\u0431\u043E\u0439 \u0437\u0430\u0432\u0442\u0440\u0430, \u043B\u044E\u0431\u043E\u0432\u044C \u043C\u043E\u044F.",
  "summer_1": "\u041A\u043E\u0433\u0434\u0430 \u0441\u0438\u044F\u0435\u0442 \u0441\u043E\u043B\u043D\u0446\u0435, \u0438 \u0431\u0430\u0431\u043E\u0447\u043A\u0438 \u0442\u0430\u043D\u0446\u0443\u044E\u0442 \u043D\u0430 \u0432\u0435\u0442\u0440\u0443, \u0441\u043B\u043E\u0436\u043D\u043E \u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F \u0432 \u0434\u0443\u0440\u043D\u043E\u043C \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0438.$h",
  "summer_10": "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u0445\u043E\u0442\u0435\u043B \u0432\u0437\u044F\u0442\u044C \u0435\u0449\u0435 \u043E\u0434\u043D\u0443 \u0431\u0443\u0442\u044B\u043B\u043A\u0443 \u0447\u0435\u0440\u043D\u0438\u043B \u0432 \u0441\u0432\u043E\u0435\u043C \u0434\u043E\u043C\u0438\u043A\u0435, \u043D\u043E \u043F\u043E\u0442\u043E\u043C \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u043B, \u0447\u0442\u043E \u0437\u0430\u0432\u0442\u0440\u0430 \u043B\u0443\u0430\u0443. \u0412\u043E\u0442 \u0437\u0430\u0432\u0442\u0440\u0430 \u0438 \u0437\u0430\u0431\u0435\u0440\u0443.",
  "summer_27": "\u0412\u0441\u0435 \u0445\u043E\u0440\u043E\u0448\u0435\u0435 \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F, \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u0440\u0430\u0434\u043E\u0441\u0442\u043D\u044B\u0435 \u043B\u0435\u0442\u043D\u0438\u0435 \u0434\u0435\u043D\u044C\u043A\u0438. \u041A\u043B\u044E\u0447 \u043A \u0441\u0447\u0430\u0441\u0442\u044C\u044E \u2014 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u044C \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u044B \u043D\u0435 \u043E\u0441\u0443\u0436\u0434\u0430\u044F.",
  "fall_1": "\u0411\u043B\u0430\u0433\u043E\u043B\u0435\u043F\u0438\u0435 \u043E\u0441\u0435\u043D\u0438... \u041B\u0438\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439 \u0431\u0430\u043D\u043A\u0435\u0442 \u0434\u043B\u044F \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0438\u0437 \u0447\u0443\u0432\u0441\u0442\u0432... \u0412\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0430\u044F \u043F\u043E\u044D\u0437\u0438\u044F \u0432\u0441\u0435\u0445 \u0432\u0440\u0435\u043C\u0435\u043D \u0431\u044B\u043B\u0430 \u0432\u0434\u043E\u0445\u043D\u043E\u0432\u043B\u0435\u043D\u0430 \u043E\u0441\u0435\u043D\u044C\u044E.",
  "fall_15": "\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0437\u0430\u0432\u0442\u0440\u0430 \u044F \u043D\u0435\u043D\u0430\u0434\u043E\u043B\u0433\u043E \u0437\u0430\u0431\u0443\u0434\u0443 \u043E \u0433\u043E\u0440\u0434\u043E\u0441\u0442\u0438 \u0438 \u0436\u0430\u0434\u043D\u043E \u0432\u043E\u043F\u044C\u044E\u0441\u044C \u0432 \u0441\u043E\u0447\u043D\u044B\u0439 \u0441\u044D\u043D\u0434\u0432\u0438\u0447 \u0441 \u0431\u0430\u0440\u0431\u0435\u043A\u044E.",
  "fall_26": "\u0422\u044B \u043D\u0435 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043D\u0435\u0448\u044C \u043B\u044E\u0431\u0438\u0442\u044C \u043C\u0435\u043D\u044F, \u0435\u0441\u043B\u0438 \u043D\u0430 \u0414\u0435\u043D\u044C \u0432\u0441\u0435\u0445 \u0434\u0443\u0445\u043E\u0432 \u044F \u0432\u044B\u0433\u043B\u0443\u0448\u0443 \u043B\u0438\u0442\u0440\u043E\u0432 \u0441\u0435\u043C\u044C \u0442\u044B\u043A\u0432\u0435\u043D\u043D\u043E\u0433\u043E \u044D\u043B\u044F? \u0418\u043D\u043E\u0433\u0434\u0430 \u0443 \u043C\u0443\u0436\u0447\u0438\u043D \u0431\u044B\u0432\u0430\u044E\u0442 \u043F\u0440\u0438\u043C\u0438\u0442\u0438\u0432\u043D\u044B\u0435 \u043F\u043E\u0437\u044B\u0432\u044B...",
  "winter_1": "\u0417\u0438\u043C\u0430 \u2014 \u043E\u0442\u043B\u0438\u0447\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F, \u0447\u0442\u043E\u0431\u044B \u0447\u0438\u0442\u0430\u0442\u044C \u043A\u043D\u0438\u0433\u0438 \u0438 \u0438\u0433\u0440\u0430\u0442\u044C \u043D\u0430 \u0444\u043E\u0440\u0442\u0435\u043F\u0438\u0430\u043D\u043E. \u041D\u0435 \u0437\u0430\u0431\u0443\u0434\u044C \u0438\u043D\u043E\u0433\u0434\u0430 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F \u0438 \u043D\u0430\u0441\u043B\u0430\u0434\u0438\u0442\u044C\u0441\u044F \u043F\u0430\u0440\u043E\u0439 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0445 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0439.",
  "winter_7": "\u042F \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u043E\u0434\u0437\u0430\u0431\u044B\u043B \u043E\u0441\u043D\u043E\u0432\u044B, \u043D\u043E \u0437\u0430\u0432\u0442\u0440\u0430 \u044F \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E \u043F\u043E\u0443\u0447\u0430\u0441\u0442\u0432\u0443\u044E \u0432 \u0440\u044B\u0431\u043E\u043B\u043E\u0432\u043D\u043E\u043C \u0441\u043E\u0440\u0435\u0432\u043D\u043E\u0432\u0430\u043D\u0438\u0438! \u041A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442 \u0443 \u0442\u0435\u0431\u044F \u0431\u0443\u0434\u0435\u0442 \u0442\u0430\u043A \u0441\u0435\u0431\u0435, \u043B\u044E\u0431\u043E\u0432\u044C \u043C\u043E\u044F.",
  "winter_28": "\u0421 \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u044E\u0449\u0438\u043C \u043D\u043E\u0432\u044B\u043C \u0433\u043E\u0434\u043E\u043C, \u043C\u043E\u044F \u043B\u044E\u0431\u043E\u0432\u044C. \u041F\u0440\u0438\u043C\u0438 \u043E\u0442 \u043C\u0435\u043D\u044F \u044D\u0442\u043E\u0442 \u043F\u043E\u0434\u0430\u0440\u043E\u043A. [348]"
}