{
  "Rainy_Day_0": "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u0447\u0442\u043E \u0441\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F \u0441 \u043B\u0435\u0442\u0430\u044E\u0449\u0438\u043C\u0438 \u043D\u0430\u0441\u0435\u043A\u043E\u043C\u044B\u043C\u0438 \u0432 \u0434\u043E\u0436\u0434\u044C? \u0420\u0430\u0437\u0432\u0435 \u0434\u043E\u0436\u0434\u0438\u043D\u043A\u0438 \u0438\u0445 \u043D\u0435 \u0441\u0431\u0438\u0432\u0430\u044E\u0442?",
  "Rainy_Day_1": "\u0422\u0430\u043A\u043E\u0439 \u0434\u0435\u043D\u044C \u2014 \u0431\u0443\u0434\u0442\u043E \u0434\u0430\u0440 \u043E\u0442 \u043C\u0430\u0442\u0443\u0448\u043A\u0438-\u043F\u0440\u0438\u0440\u043E\u0434\u044B.",
  "Rainy_Day_2": "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E... \u042D\u0442\u043E\u0442 \u043F\u043E\u0434\u0430\u0440\u043E\u043A \u0442\u0435\u0431\u0435. \u041D\u0435 \u0432\u043E\u043B\u043D\u0443\u0439\u0441\u044F, \u044F \u0443\u0436\u0435 \u043E\u0447\u0438\u0441\u0442\u0438\u043B\u0430 \u0435\u0433\u043E \u0431\u043B\u0430\u0433\u043E\u0432\u043E\u043D\u0438\u0435\u043C \u0438\u0437 \u0448\u0430\u043B\u0444\u0435\u044F.[428 440 444 338 207]",
  "Rainy_Day_3": "\u042F \u0445\u043E\u0442\u0435\u043B\u0430 \u0432\u044B\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u043F\u043E\u043F\u0443\u0433\u0430\u044F \u043D\u0430 \u0432\u043E\u043B\u044E, \u043D\u043E \u0435\u0433\u043E \u043A\u0440\u044B\u043B\u043E \u0442\u0430\u043A \u0438 \u043D\u0435 \u0437\u0430\u0436\u0438\u043B\u043E \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E. \u041D\u043E \u043E\u043D, \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0434\u043E\u0432\u043E\u043B\u0435\u043D. \u042F \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F \u0435\u043C\u0443 \u0443\u0434\u0435\u043B\u044F\u044E.#$e#\u041E\u043D \u0441\u043A\u0430\u0437\u0430\u043B \u043C\u043D\u0435, \u0447\u0442\u043E \u0435\u043C\u0443 \u0437\u0434\u0435\u0441\u044C \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F.",
  "Rainy_Day_4": "\u042F \u0442\u0435\u0431\u0435 \u043E\u0431 \u044D\u0442\u043E\u043C \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430, \u043D\u043E... \u0412 \u0434\u0435\u043D\u044C \u0442\u0432\u043E\u0435\u0433\u043E \u043F\u0435\u0440\u0435\u0435\u0437\u0434\u0430 \u043C\u043D\u0435 \u043F\u0440\u0438\u0441\u043D\u0438\u043B\u0441\u044F \u0441\u043E\u043D \u043E \u0442\u0435\u0431\u0435. \u042F \u0442\u043E\u0433\u0434\u0430 \u0441\u0440\u0430\u0437\u0443 \u043F\u043E\u043D\u044F\u043B\u0430 \u2014 \u0434\u043E\u0440\u043E\u0433\u0438 \u043D\u0430\u0448\u0438\u0445 \u0436\u0438\u0437\u043D\u0435\u0439 \u043F\u0435\u0440\u0435\u0441\u0435\u043A\u0443\u0442\u0441\u044F.$4",
  "Rainy_Night_0": "\u041A\u0430\u0436\u0434\u043E\u0435 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435 \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u043E \u0438 \u043F\u043E-\u0441\u0432\u043E\u0435\u043C\u0443 \u043A\u0440\u0430\u0441\u0438\u0432\u043E... \u0422\u044B \u043D\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0448\u044C? \u0418\u043D\u043E\u0433\u0434\u0430 \u0431\u044B\u0432\u0430\u0435\u0442 \u0442\u0430\u043A \u043F\u0440\u043E\u0441\u0442\u043E \u043E\u0431 \u044D\u0442\u043E\u043C \u0437\u0430\u0431\u044B\u0442\u044C.",
  "patio_Emily": "\u0417\u0434\u0435\u0441\u044C \u043C\u043E\u0435 \u043B\u044E\u0431\u0438\u043C\u043E\u0435 \u043C\u0435\u0441\u0442\u043E \u0434\u043B\u044F \u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0439 \u043C\u0435\u0434\u0438\u0442\u0430\u0446\u0438\u0438.#$e#\u042F \u0432\u0438\u0437\u0443\u0430\u043B\u0438\u0437\u0438\u0440\u0443\u044E \u044D\u043D\u0435\u0440\u0433\u0438\u044E \u0438\u0437 \u044D\u0442\u043E\u0433\u043E \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0441\u0430\u0434\u0430, \u0438 \u043A\u0430\u043A \u043E\u043D\u0430 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u0441\u043A\u0432\u043E\u0437\u044C \u043C\u043E\u0435 \u0442\u0435\u043B\u043E.",
  "Rainy_Night_1": "\u042F \u0441\u043B\u044B\u0448\u0443, \u043A\u0430\u043A \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u043C\u0435\u0436\u0434\u0443 \u0441\u043E\u0431\u043E\u0439... \u041E\u043D\u0438 \u0442\u0430\u043A \u0440\u0430\u0434\u044B \u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0435\u043C\u0443 \u0434\u043E\u0436\u0434\u044E!",
  "Rainy_Night_2": "\u041A\u0430\u043A \u043F\u0440\u043E\u0448\u0435\u043B \u0442\u0432\u043E\u0439 \u0434\u0435\u043D\u044C, @? \u0412\u044B\u0433\u043B\u044F\u0434\u0438\u0448\u044C \u043C\u043E\u043A\u0440\u043E.",
  "Rainy_Night_3": "\u041C\u043E\u0439 \u0434\u0435\u043D\u044C \u043F\u0440\u043E\u0448\u0435\u043B \u043E\u0447\u0435\u043D\u044C \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E. \u0410 \u0442\u0432\u043E\u0439?",
  "Rainy_Night_4": "\u0425\u043E\u0447\u0435\u0448\u044C \u0434\u0435\u0441\u0435\u0440\u0442\u0430? \u042D\u0442\u043E \u043C\u043E\u0439 \u043E\u0441\u043E\u0431\u044B\u0439 \u0440\u0435\u0446\u0435\u043F\u0442, \u0438\u0437 \u0441\u044B\u0440\u044B\u0445 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u043E\u0432, \u0431\u0435\u0437 \u0433\u043B\u044E\u0442\u0435\u043D\u0430, \u043F\u043E\u0434\u0441\u043B\u0430\u0449\u0435\u043D\u043D\u044B\u0439 \u043A\u0430\u043A\u0442\u0443\u0441\u043E\u0432\u044B\u043C \u0441\u0438\u0440\u043E\u043F\u043E\u043C.[232 234 223 220]$h",
  "Rainy_Night_5": "\u0410 \u0442\u0435\u0431\u044F \u0448\u0443\u043C \u0434\u043E\u0436\u0434\u044F \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043F\u043E\u0433\u0440\u0443\u0436\u0430\u043B \u0432 \u0442\u0440\u0430\u043D\u0441?",
  "Indoor_Day_0": "\u0415\u0449\u0435 \u043E\u0434\u0438\u043D \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u0434\u0435\u043D\u044C \u043D\u0430 \u0444\u0435\u0440\u043C\u0435 \u00AB%farm\u00BB... \u042F \u0432\u0435\u0440\u044E, \u0447\u0442\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043F\u0440\u043E\u0438\u0437\u043E\u0439\u0434\u0435\u0442 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0445\u043E\u0440\u043E\u0448\u0435\u0435!$h",
  "Indoor_Day_1": "\u0412\u043E\u0442, \u0432\u043E\u0437\u044C\u043C\u0438. \u042D\u0442\u043E \u0442\u0435\u0431\u0435.[428 440 444 338 207 395 749]",
  "Indoor_Day_2": "\u041E\u0439, \u043A\u0442\u043E \u0443 \u043D\u0430\u0441 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u044B\u0441\u043F\u0430\u043B\u0441\u044F... \u0412\u044B\u0433\u043B\u044F\u0434\u0438\u0448\u044C \u0431\u043E\u0434\u0440\u043E.$h",
  "Indoor_Day_3": "\u0413\u043E\u0440\u043E\u0441\u043A\u043E\u043F \u0443 \u043C\u0435\u043D\u044F \u043D\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0435 \u043E\u0447\u0435\u043D\u044C... \u041D\u043E \u044F \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C, \u0447\u0442\u043E\u0431\u044B \u0432\u0441\u0435 \u043F\u0440\u043E\u0448\u043B\u043E \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E \u043B\u0443\u0447\u0448\u0435, \u043A\u0430\u043A \u0432\u0441\u0435\u0433\u0434\u0430. \u0417\u0430 \u0440\u0430\u0431\u043E\u0442\u0443!",
  "Indoor_Day_4": "\u0423\u0444-\u0444... \u042F \u043F\u0435\u0440\u0435\u0435\u043B\u0430 \u043C\u0430\u0444\u0444\u0438\u043D\u043E\u0432 \u0438\u0437 \u043E\u0442\u0440\u0443\u0431\u0435\u0439 \u043D\u0430 \u0437\u0430\u0432\u0442\u0440\u0430\u043A.$s",
  "Indoor_Night_0": "\u0423 \u0442\u0435\u0431\u044F \u043D\u0430 \u0440\u0443\u0431\u0430\u0448\u043A\u0435 \u043D\u043E\u0432\u0430\u044F \u0434\u044B\u0440\u043A\u0430? \u041D\u0438\u0447\u0435\u0433\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0433\u043E, \u044F \u043C\u043E\u0433\u0443 \u0437\u0430\u0448\u0438\u0442\u044C.",
  "Indoor_Night_1": "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C \u0434\u043E\u043C\u043E\u0439, @. \u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0442\u0432\u043E\u0439 \u0434\u0435\u043D\u044C \u043F\u0440\u043E\u0448\u0435\u043B \u0447\u0443\u0434\u0435\u0441\u043D\u043E.",
  "Indoor_Night_2": "\u0423\u0436\u0435 \u043F\u043E\u0440\u0430 \u0441\u043F\u0430\u0442\u044C? \u041E\u0445, \u0434\u0435\u043D\u044C \u0441\u043D\u043E\u0432\u0430 \u0443\u043F\u043B\u044B\u043B \u043E\u0442 \u043C\u0435\u043D\u044F.$u",
  "Indoor_Night_3": "\u0410\u0445, \u044D\u0442\u043E\u0442 \u0430\u0440\u043E\u043C\u0430\u0442! \u0422\u0430\u043A\u043E\u0439 \u0431\u044B\u0432\u0430\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u0443 \u0442\u0435\u0431\u044F.$h#$e#\u042D\u0442\u043E \u043F\u0440\u0438\u044F\u0442\u043D\u044B\u0439 \u0437\u0430\u043F\u0430\u0445.",
  "Indoor_Night_4": "\u042F \u0432\u0435\u0437\u0434\u0435 \u043F\u043E\u0434\u043C\u0435\u043B\u0430, \u043F\u043E\u043C\u044B\u043B\u0430 \u043E\u043A\u043D\u0430, \u0432\u044B\u0442\u0435\u0440\u043B\u0430 \u043F\u044B\u043B\u044C \u0438 \u0432\u044B\u043C\u044B\u043B\u0430 \u0445\u043E\u043B\u043E\u0434\u0438\u043B\u044C\u043D\u0438\u043A. \u0414\u0435\u043D\u044C \u043F\u0440\u043E\u0448\u0435\u043B \u043E\u0447\u0435\u043D\u044C \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0438\u0432\u043D\u043E!",
  "Outdoor_0": "\u042F \u043B\u044E\u0431\u043B\u044E \u0432\u0441\u0442\u0430\u0432\u0430\u0442\u044C \u0440\u0430\u043D\u043E. \u0412\u043E\u0437\u0434\u0443\u0445 \u0432 \u0442\u0430\u043A\u043E\u0435 \u0432\u0440\u0435\u043C\u044F \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u0441\u0432\u0435\u0436\u0438\u0439, \u0438 \u043F\u0440\u0438\u0440\u043E\u0434\u0430 \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u0430\u043A\u0442\u0438\u0432\u043D\u0435\u0435.",
  "Outdoor_1": "\u0427\u0442\u043E \u0443 \u043D\u0430\u0441 \u043D\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0432 \u043F\u043B\u0430\u043D\u0430\u0445, ${\u0434\u043E\u0440\u043E\u0433\u043E\u0439^\u0434\u043E\u0440\u043E\u0433\u0430\u044F}$?",
  "Outdoor_2": "\u041E\u0439, \u043E\u0439! \u0415\u0449\u0435 \u043E\u0434\u043D\u0443 \u0432\u0438\u0436\u0443!$h#$e#\u042F \u0442\u0443\u0442 \u0441\u0447\u0438\u0442\u0430\u044E \u0431\u0435\u043B\u043E\u0447\u0435\u043A.",
  "Outdoor_3": "\u041D\u0435\u043C\u043D\u043E\u0433\u043E \u0441\u043E\u043B\u043D\u0446\u0430 \u043F\u043E\u0439\u0434\u0435\u0442 \u0442\u0435\u0431\u0435 \u043D\u0430 \u043F\u043E\u043B\u044C\u0437\u0443. \u0422\u044B \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043E \u043A\u043E\u0440\u043E\u0447\u043A\u0438 \u043D\u0435 \u0437\u0430\u0433\u043E\u0440\u0430\u0439, \u043B\u0430\u0434\u043D\u043E?",
  "Outdoor_4": "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E! \u042F \u0432\u0441\u0435 \u0434\u0443\u043C\u0430\u043B\u0430, \u043A\u043E\u0433\u0434\u0430 \u0436\u0435 \u0442\u044B \u0432\u044B\u043B\u0435\u0437\u0435\u0448\u044C \u0438\u0437-\u043F\u043E\u0434 \u043E\u0434\u0435\u044F\u043B\u0430!$h#$e#\u041D\u0438\u0447\u0435\u0433\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0433\u043E, @... \u0422\u044B \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u0435\u0448\u044C \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B \u0445\u043E\u0440\u043E\u0448\u043E \u0432\u044B\u0441\u043F\u0430\u0442\u044C\u0441\u044F.",
  "OneKid_0": "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, %kid1 \u0432\u044B\u0440\u0430\u0441\u0442\u0435\u0442 \u0434\u043E\u0431\u0440\u044B\u043C \u0438 \u0437\u0430\u0431\u043E\u0442\u043B\u0438\u0432\u044B\u043C \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C. \u042D\u0442\u043E \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u0432\u0430\u0436\u043D\u0435\u0435, \u0447\u0435\u043C \u0445\u043E\u0440\u043E\u0448\u0438\u0435 \u043E\u0446\u0435\u043D\u043A\u0438 \u0432 \u0448\u043A\u043E\u043B\u0435.",
  "OneKid_1": "\u0425\u0432\u0430\u0442\u0438\u0442 \u043D\u0430\u043C \u043E\u0434\u043D\u043E\u0433\u043E \u0440\u0435\u0431\u0435\u043D\u043A\u0430 \u0438\u043B\u0438 \u0432\u044B\u0440\u0430\u0441\u0442\u0438\u043C \u0432\u0442\u043E\u0440\u043E\u0433\u043E?#$e#\u041B\u0430\u0434\u043D\u043E, \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C, \u043A\u0443\u0434\u0430 \u043F\u0440\u0438\u0432\u0435\u0434\u0435\u0442 \u043D\u0430\u0441 \u0441\u0443\u0434\u044C\u0431\u0430.",
  "OneKid_3": "\u042F \u0437\u0430\u0436\u0433\u043B\u0430 \u0431\u043B\u0435\u0434\u043D\u043E-\u0437\u0435\u043B\u0435\u043D\u0443\u044E \u0441\u0432\u0435\u0447\u043A\u0443 \u0438 \u043F\u043E\u0442\u0440\u044F\u0441\u043B\u0430 \u043D\u0430\u0434 \u0434\u0435\u0442\u0441\u043A\u043E\u0439 \u043A\u0440\u043E\u0432\u0430\u0442\u043A\u043E\u0439 \u0432\u0435\u0442\u043E\u0447\u043A\u043E\u0439 \u043C\u044F\u0442\u044B. \u0422\u0435\u043F\u0435\u0440\u044C %kid1 \u043C\u043E\u0436\u0435\u0442 \u043D\u0435 \u0431\u043E\u044F\u0442\u044C\u0441\u044F \u0437\u043B\u044B\u0445 \u0434\u0443\u0445\u043E\u0432.",
  "TwoKids_1": "\u0411\u043E\u043B\u044C\u0448\u043E\u0439 \u0434\u043E\u043C, \u0434\u0432\u043E\u0435 \u0434\u0435\u0442\u0435\u0439 \u0438 \u043F\u043E\u043F\u0443\u0433\u0430\u0439... \u0421\u043A\u0443\u0447\u0430\u0442\u044C \u043D\u0435\u043A\u043E\u0433\u0434\u0430!",
  "TwoKids_2": "\u0414\u0430, \u0432\u043E\u043B\u043E\u0441\u044B %kid2 \u044F\u0432\u043D\u043E \u0443\u043D\u0430\u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u043E\u0442 \u0442\u0435\u0431\u044F...$u",
  "TwoKids_3": "\u0414\u0435\u0442\u0438 \u0443\u0436\u0435 \u043F\u043E\u0435\u043B\u0438 \u0445\u043B\u043E\u043F\u044C\u044F \u0438\u0437 \u043A\u0438\u043D\u0432\u044B \u0441 \u043A\u043E\u0437\u044C\u0438\u043C \u043C\u043E\u043B\u043E\u043A\u043E\u043C. \u041D\u0435 \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0439\u0441\u044F, \u0441\u043E\u0441\u0440\u0435\u0434\u043E\u0442\u043E\u0447\u044C\u0441\u044F \u043D\u0430 \u0444\u0435\u0440\u043C\u0435!",
  "Good_1": "\u0416\u0438\u0442\u044C \u0432\u043C\u0435\u0441\u0442\u0435 \u0442\u0430\u043A \u0432\u0435\u0441\u0435\u043B\u043E! \u042F \u0432\u0441\u0435\u0433\u0434\u0430 \u0434\u0443\u043C\u0430\u043B\u0430, \u0447\u0442\u043E \u0432\u0441\u044E \u0436\u0438\u0437\u043D\u044C \u0431\u0443\u0434\u0443 \u043E\u0434\u043D\u0430.",
  "Good_2": "\u0411\u044B\u0442\u044C \u0432\u043C\u0435\u0441\u0442\u0435 \u043D\u0430\u043C \u0431\u044B\u043B\u043E \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043E \u0441\u0443\u0434\u044C\u0431\u043E\u0439... \u042F \u0432\u0441\u0435\u043C \u0441\u0435\u0440\u0434\u0446\u0435\u043C \u0432\u0435\u0440\u044E \u0432 \u044D\u0442\u043E!",
  "Good_3": "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E ${\u043F\u0440\u0438\u043D\u044F\u043B^\u043F\u0440\u0438\u043D\u044F\u043B\u0430}$ \u043C\u0435\u043D\u044F \u0432 \u0441\u0432\u043E\u0439 \u0434\u043E\u043C. \u041C\u043D\u0435 \u0442\u0430\u043A \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u043D\u043E\u0432\u0430\u044F \u0436\u0438\u0437\u043D\u044C \u0437\u0434\u0435\u0441\u044C.$4",
  "Good_4": "\u0412\u0438\u0431\u0440\u0430\u0446\u0438\u0438 \u043D\u0430\u0448\u0438\u0445 \u044D\u043D\u0435\u0440\u0433\u0438\u0439 \u0432 \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E\u043C \u0440\u0435\u0437\u043E\u043D\u0430\u043D\u0441\u0435. \u0422\u044B \u0447\u0442\u043E, \u043D\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044C?",
  "Good_5": "\u042F \u0442\u0443\u0442 \u043B\u044E\u0431\u043E\u0432\u0430\u043B\u0430\u0441\u044C \u0441\u0432\u043E\u0438\u043C \u0441\u0432\u0430\u0434\u0435\u0431\u043D\u044B\u043C \u0430\u043C\u0443\u043B\u0435\u0442\u043E\u043C... \u0420\u0430\u043A\u0443\u0448\u043A\u0430 \u0442\u0430\u043A\u0430\u044F \u043A\u0440\u0430\u0441\u0438\u0432\u0430\u044F! \u042F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E, \u043A\u0430\u043A \u043E\u0442 \u043D\u0435\u0435 \u0438\u0441\u0445\u043E\u0434\u0438\u0442 \u0447\u0438\u0441\u0442\u0430\u044F \u044D\u043D\u0435\u0440\u0433\u0438\u044F \u0433\u043E\u043B\u0443\u0431\u043E\u0433\u043E \u0446\u0432\u0435\u0442\u0430.$l",
  "Good_6": "\u041C\u043D\u0435 \u0432\u0447\u0435\u0440\u0430 \u043F\u0440\u0438\u0441\u043D\u0438\u043B\u0441\u044F \u0435\u0449\u0435 \u043E\u0434\u0438\u043D \u0441\u043E\u043D \u043E \u043D\u0430\u0441. \u041C\u044B \u0437\u0430\u043B\u0435\u0437\u043B\u0438 \u043D\u0430 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435 \u0434\u0435\u0440\u0435\u0432\u043E \u0438 \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u0432\u043D\u0438\u0437 \u043D\u0430 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u0435\u0439\u0448\u0443\u044E \u0437\u0435\u043B\u0435\u043D\u0443\u044E \u0434\u043E\u043B\u0438\u043D\u0443. \u041C\u043D\u0435 \u0447\u0430\u0441\u0442\u043E \u0441\u043D\u0438\u0442\u0441\u044F \u044D\u0442\u043E\u0442 \u0441\u043E\u043D.#$e#\u042F \u043D\u0435 \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u043E\u043D \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442, \u043D\u043E \u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E, \u0447\u0442\u043E \u044D\u0442\u043E \u0434\u043E\u0431\u0440\u044B\u0439 \u0437\u043D\u0430\u043A.",
  "Neutral_0": "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u043A\u043E\u0433\u0434\u0430 \u044F \u0441\u0442\u0430\u043D\u0443 \u0441\u0442\u0430\u0440\u0430\u044F, \u0438 \u043A\u043E\u0433\u0434\u0430 \u0432\u043E\u043B\u043E\u0441\u044B \u043C\u043E\u0438 \u0432\u044B\u0446\u0432\u0435\u0442\u0443\u0442 \u0434\u043E \u0446\u0432\u0435\u0442\u0430 \u0441\u0442\u0430\u043B\u0438, \u0442\u044B \u0432\u0441\u0435 \u0435\u0449\u0435 \u0431\u0443\u0434\u0435\u0448\u044C \u043C\u0435\u043D\u044F \u043B\u044E\u0431\u0438\u0442\u044C.",
  "Neutral_8": "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0443 \u043C\u0435\u043D\u044F \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E \u043D\u0435\u0442 \u0432\u0434\u043E\u0445\u043D\u043E\u0432\u0435\u043D\u0438\u044F.$s",
  "funLeave_Emily": "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u043F\u043E\u0439\u0434\u0443 \u0432 \u0433\u043E\u0440\u043E\u0434, \u0430 \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u043C\u043E\u0433\u0443 \u0413\u0430\u0441\u0443 \u0432 \u0441\u0430\u043B\u0443\u043D\u0435. \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E \u0434\u043D\u044F.",
  "funReturn_Emily": "\u0414\u0435\u043D\u044C \u043F\u0440\u043E\u0448\u0435\u043B \u0445\u043E\u0440\u043E\u0448\u043E... \u0417\u0434\u043E\u0440\u043E\u0432\u043E \u0438\u043D\u043E\u0433\u0434\u0430 \u0432\u044B\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0438\u0437 \u0434\u043E\u043C\u0430.",
  "spring_2": "\u041C\u043E\u0438 \u0434\u0440\u0443\u0437\u044C\u044F-\u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u043A \u0436\u0438\u0437\u043D\u0438. \u042F \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u0430.",
  "spring_1": "\u0421 \u043D\u043E\u0432\u044B\u043C \u0433\u043E\u0434\u043E\u043C, ${\u0434\u043E\u0440\u043E\u0433\u043E\u0439^\u0434\u043E\u0440\u043E\u0433\u0430\u044F}$. \u041F\u0443\u0441\u0442\u044C \u044D\u0442\u043E\u0442 \u0433\u043E\u0434 \u0431\u0443\u0434\u0435\u0442 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u044B\u043C.$4",
  "spring_22": "\u0425\u043C-\u043C... \u041C\u043E\u0436\u0435\u0442, \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0430 \u0443\u0436\u0438\u043D \u0441\u0430\u043B\u0430\u0442 \u0438\u0437 \u0441\u0432\u0435\u0436\u0435\u0439 \u0434\u0438\u043A\u043E\u0439 \u0437\u0435\u043B\u0435\u043D\u0438?",
  "summer_20": "\u042D\u043D\u0435\u0440\u0433\u0438\u044F \u0432 \u043D\u0430\u0448\u0438\u0445 \u0442\u0435\u043B\u0430\u0445 \u0442\u0430\u043A\u0430\u044F \u0436\u0435 \u043D\u0435\u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u0430\u044F, \u043A\u0430\u043A \u0438 \u0432\u0440\u0435\u043C\u0435\u043D\u0430 \u0433\u043E\u0434\u0430. \u041F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E \u0440\u0438\u0442\u043C\u0430 \u2014 \u043F\u0435\u0440\u0432\u044B\u0439 \u0448\u0430\u0433 \u043A\u043E \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0439 \u0433\u0430\u0440\u043C\u043E\u043D\u0438\u0438.",
  "summer_2": "\u0414\u0430 \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0438\u0442 \u0442\u0435\u0431\u044F \u0418\u043E\u0431\u0430 \u0432 \u044D\u0442\u043E\u0442 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u0434\u0435\u043D\u044C.$7",
  "fall_1": "\u041F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u0433\u043E\u0434\u0430 \u0443\u0436\u0435 \u043F\u043E\u0437\u0430\u0434\u0438, \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0448\u044C?",
  "fall_25": "\u041F\u043E \u0437\u0430\u043C\u044B\u0441\u043B\u0443 \u043F\u0440\u0438\u0440\u043E\u0434\u044B, \u043D\u0430\u0448\u0438 \u0442\u0435\u043B\u0430 \u00AB\u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u044B\u00BB \u043D\u0430 \u0432\u0440\u0435\u043C\u0435\u043D\u0430 \u0433\u043E\u0434\u0430. \u042D\u0442\u043E \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0435 \u0438 \u043E\u0441\u0435\u043D\u043D\u0438\u0435 \u0446\u0432\u0435\u0442\u0430 \u043F\u043E\u0431\u0443\u0436\u0434\u0430\u044E\u0442 \u043D\u0430\u0441 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C\u0441\u044F \u043A \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0439 \u0437\u0438\u043C\u0435.#$e#\u0414\u043B\u044F \u043D\u0430\u0448\u0438\u0445 \u0434\u0430\u043B\u0435\u043A\u0438\u0445 \u043F\u0440\u0435\u0434\u043A\u043E\u0432 \u044D\u0442\u043E \u0447\u0443\u0432\u0441\u0442\u0432\u043E \u0431\u044B\u043B\u043E \u0432\u0441\u0435\u043E\u0431\u044A\u0435\u043C\u043B\u044E\u0449\u0438\u043C \u0438 \u0436\u0438\u0437\u043D\u0435\u043D\u043D\u043E \u0432\u0430\u0436\u043D\u044B\u043C. \u041C\u044B \u0436\u0435 \u0435\u0434\u0432\u0430 \u043E\u0449\u0443\u0449\u0430\u0435\u043C \u044D\u0442\u043E \u0432 \u0448\u0443\u043C\u0435 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439 \u0436\u0438\u0437\u043D\u0438.",
  "winter_15": "\u0412 \u0442\u0430\u043A\u0438\u0435 \u0434\u043D\u0438 \u043C\u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u043A\u043E\u0440\u0438\u0446\u044B, \u043C\u0443\u0441\u043A\u0430\u0442\u0430, \u0433\u0432\u043E\u0437\u0434\u0438\u043A\u0438 \u0438 \u043A\u0430\u0440\u0434\u0430\u043C\u043E\u043D\u0430.",
  "winter_5": "\u041E\u0445... \u041F\u043E\u0447\u0435\u043C\u0443 \u0432 \u043C\u0438\u0440\u0435 \u0434\u043E\u043B\u0436\u043D\u044B \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C \u0432\u043E\u0439\u043D\u0430 \u0438 \u043D\u0435\u043D\u0430\u0432\u0438\u0441\u0442\u044C?$s",
  "winter_2": "\u042F \u0432\u0441\u0435 \u0434\u0443\u043C\u0430\u044E \u043E \u0431\u0435\u0434\u043D\u044B\u0445 \u0431\u0435\u043B\u043E\u0447\u043A\u0430\u0445, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u0435\u0439\u0447\u0430\u0441 \u043C\u0435\u0440\u0437\u043D\u0443\u0442 \u0442\u0430\u043C, \u0441\u043D\u0430\u0440\u0443\u0436\u0438.$s",
  "spring_Emily": "\u042F \u043F\u0440\u0435\u0434\u0432\u043A\u0443\u0448\u0430\u044E \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0439 \u0433\u043E\u0434 \u0436\u0438\u0437\u043D\u0438 \u043D\u0430 \u0444\u0435\u0440\u043C\u0435, @!$h",
  "fall_Emily": "\u041D\u0430 \u0437\u0430\u0432\u0442\u0440\u0430\u043A \u0431\u044B\u043B \u0441\u0443\u043F\u0435\u0440-\u043F\u0438\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u044C, \u0438 \u0442\u0435\u043F\u0435\u0440\u044C \u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E \u0441\u0435\u0431\u044F \u0437\u0430-\u0430\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E!$h",
  "summer_Emily": "\u0423\u0444! \u0416\u0430\u0440\u043A\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F, \u043D\u043E \u0437\u0430\u0442\u043E \u0442\u0430\u043A \u0437\u0434\u043E\u0440\u043E\u0432\u043E, \u043F\u0440\u0430\u0432\u0434\u0430?#$e#\u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0430\u043C \u043F\u043E\u043F\u0430\u0434\u0443\u0442\u0441\u044F \u0434\u0438\u043A\u0438\u0435 \u043F\u043E\u043F\u0443\u0433\u0430\u0438.",
  "winter_Emily": "\u041E\u0439, \u0443 \u043C\u0435\u043D\u044F \u043E\u043F\u044F\u0442\u044C \u0432\u043E\u043B\u043E\u0441\u044B \u0441\u043C\u0435\u0440\u0437\u043B\u0438\u0441\u044C.$s",
  "spouseRoom_Emily": "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u043F\u043E\u0431\u0443\u0434\u0443 \u0441 \u043F\u043E\u043F\u0443\u0433\u0430\u0439\u0447\u0438\u043A\u043E\u043C. \u041E\u043D \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0441\u043C\u043E\u0436\u0435\u0442 \u043B\u0435\u0442\u0430\u0442\u044C, \u0438 \u044D\u0442\u043E \u0440\u0430\u0437\u0431\u0438\u0432\u0430\u0435\u0442 \u043C\u043D\u0435 \u0441\u0435\u0440\u0434\u0446\u0435.$u"
}