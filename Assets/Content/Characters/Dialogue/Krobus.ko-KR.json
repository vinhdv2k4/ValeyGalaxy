  "Wed6": "\uD30C\uC774\uD504\uB9CC \uC798 \uCC3E\uC544\uC11C \uADC0\uB97C \uB300\uBCF4\uBA74, \uADF8 \uC5B4\uB290 \uC9D1\uC774\uAC74 \uC548\uC5D0\uC11C \uC5B4\uB5A4 \uC18C\uB9AC\uAC00 \uB098\uB294\uC9C0 \uB4E4\uC744 \uC218 \uC788\uC5B4.#$b#\uADF8\uB807\uB2E4\uACE0 \uC5FF\uB4E3\uACA0\uB2E4\uB294 \uAC74 \uC544\uB0D0!$3",
  "Thu": "\uC544\uBB34\uD55C\uD14C\uB3C4 \uB098\uC5D0 \uB300\uD574\uC11C \uB9D0\uD558\uC9C0 \uB9D0\uC544 \uC918.#$b#\uC778\uAC04\uB4E4\uC740 \uC790\uC2E0\uC774 \uC774\uD574\uD558\uC9C0 \uBABB\uD558\uB294 \uAC83\uB4E4\uC744 \uD30C\uAD34\uD558\uB294 \uACBD\uD5A5\uC774 \uC788\uC9C0.",
