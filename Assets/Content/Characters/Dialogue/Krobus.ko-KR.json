  "Tue": "\uBCF4\uD1B5 \uD587\uBE5B\uC5D0 \uB178\uCD9C\uB418\uAE30\uC5D4 \uB0B4\uAC00 \uB108\uBB34 \uC608\uBBFC\uD574.#$b#\uC5EC\uAE30 \uC870\uAC74\uC774 \uB531 \uC644\uBCBD\uD574.#$e#\uBB50\uB77C\uB3C4 \uC0B4\uB798?",
  "Mon": "\uC81C\uBC1C, \uB180\uB77C\uC9C0 \uB9C8. \uB09C \uB2E4\uB978 \uC560\uB4E4\uD558\uACE0 \uB2EC\uB77C.#$e#\uB09C \uC0AC\uB78C\uB4E4\uC744 \uC624\uB798 \uAD00\uCC30\uD588\uC5B4. \uC1FC\uD551\uD558\uB294 \uAC78 \uC88B\uC544\uD55C\uB2E4\uB294 \uAC78 \uC54C\uC544. \uB0B4 \uBB3C\uD488\uB4E4 \uC880 \uBCFC\uB798?",
