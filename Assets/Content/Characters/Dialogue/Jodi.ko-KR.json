  "summer_Thu": "\uC9D1\uC548\uC77C\uC740 \uB05D\uC774 \uC5C6\uB294 \uAC8C \uC88C\uC808\uAC10\uC744 \uC8FC\uB294 \uAC83 \uAC19\uC544.#$e#\uBC14\uB2E5\uCCAD\uC18C\uD558\uACE0 \uB2E4\uC74C\uB0A0\uC774 \uB418\uBA74, \uB2E4\uC2DC \uB354\uB7EC\uC6CC\uC838\uC788\uC5B4.",
  "summer_Sun": "\uB300\uCCB4 \uC800\uB141\uC740 \uBB58 \uB9CC\uB4E4\uC5B4\uC57C \uD558\uC9C0?#$e#*\uD55C\uC228*...",
  "fall_Thu": "\uC544\uC774\uB4E4 \uB108\uBB34 \uC624\uB0D0\uC624\uB0D0 \uD0A4\uC6B4 \uAC70 \uC544\uB2CC\uAC00 \uBAB0\uB77C. \uC9D1\uC548\uC77C\uC744 \uC2DC\uD0A8 \uC801\uC774 \uC5C6\uAC70\uB4E0.#$e#\uC5B4\uB9B0 \uC2DC\uC808\uC744 \uC880 \uB354 \uC790\uC720\uB86D\uAC8C \uC990\uAE38 \uC218 \uC788\uC5C8\uC73C\uBA74 \uD558\uB294 \uB9C8\uC74C\uC774\uC5C8\uC73C\uB2C8\uAE4C. \uBB50, \uC0D8\uC740 \uC774\uC81C \uC131\uC778\uC774\uB098 \uB2E4\uB984\uC5C6\uC9C0.#$b#\uAC8C\uC73C\uB978 \uB9C8\uC74C\uAC00\uC9D0\uC744 \uAC00\uC9C0\uAC8C \uB41C \uAC74 \uC544\uB2CC\uAC00 \uBAA8\uB974\uACA0\uB124. \uADF8\uB7FC \uC548\uB418\uB294\uB370.$s#$e#\uBD80\uBAA8\uAC00 \uB418\uB294 \uAC74 \uC26C\uC6B4 \uC77C\uC774 \uC544\uB0D0.",
  "fall_Thu_inlaw_Sam": "\uC0D8 \uB18D\uC7A5\uC5D0\uC11C \uADF8\uB0E5 \uBE48\uB465\uAC70\uB9AC\uACE0 \uC788\uB2C8, \uC544\uB2C8\uBA74 \uC880 \uB3C4\uC6C0\uC774 \uB418\uB2C8?",
  "fall_Sun": "\uCE90\uB864\uB77C\uC778\uACFC \uB098\uB294 \uC88B\uC740 \uCE5C\uAD6C\uC57C. \uADF8\uB140\uD55C\uD14C\uB294 \uBAA8\uB4E0 \uAC78 \uB2E4 \uC774\uC57C\uAE30\uD574\uC918.",
  "fall_Sun2": "\uBD80\uBAA8\uAC00 \uB418\uBA74, \uC608\uC804\uC758 \uC0B6\uC740 \uACFC\uAC70\uB85C \uB0A8\uACA8\uB46C\uC57C \uD574.#$e#\uC5B4\uCA4C\uBA74 \uADF8\uAC8C \uC804\uBD80 \uC0AC\uC2E4\uC740 \uC544\uB2C8\uC9C0\uB9CC... \uC870\uC2EC\uD558\uC9C0 \uC54A\uC73C\uBA74, \uADF8\uB7F4 \uC218\uB3C4 \uC788\uC5B4.",
  "winter_Mon": "\uC5B4\uB838\uC744 \uB54C \uB208\uC5D0\uC11C \uB178\uB294 \uAC78 \uC815\uB9D0 \uC88B\uC544\uD588\uB294\uB370. \uC5C4\uB9C8\uB85C\uC11C \uADF8 \uAC10\uC815\uC744 \uD55C \uBC88 \uB354 \uB290\uB084 \uC218 \uC788\uC5B4\uC11C \uCC38 \uC88B\uC544.$h",
  "winter_Tue": "\uC548\uB155. \uC0AC\uB78C\uB4E4\uC774 \uB9E4\uC77C \uB18D\uC7A5\uC5D0 \uB300\uD574 \uBB3C\uC5B4\uBCF4\uB294 \uAC70 \uD639\uC2DC \uC9C8\uB9AC\uB2C8?#$e#\uB098\uB77C\uBA74 \uADF8\uB7F4 \uAC83 \uAC19\uC544.",
  "winter_Tue6": "*\uD55C\uC228*... \uAC00\uB054\uC740 \uB098 \uD63C\uC790\uB9CC\uC758 \uC0B6\uC744 \uAFC8\uAFD4... \uB0B4\uAC00 \uB3CC\uBD10\uC57C \uD560 \uAC00\uC871\uC774 \uC5C6\uB294 \uADF8\uB7F0 \uC0B6\uC740. \uB054\uCC0D\uD55C \uAC74\uAC00?$s#$e#\uC544\uBB34\uD55C\uD14C\uB3C4 \uB9D0\uD558\uC9C0 \uB9D0\uC544 \uC918.$4",
  "winter_Wed2": "\uC7AC\uBBF8\uB85C \uBB50 \uD558\uB0D0\uACE0? \uD750\uC74C... \uC88B\uC740 \uC9C8\uBB38\uC774\uC57C.#$e#\uC7A0\uC790\uB294 \uAC70 \uC88B\uC544\uD574.$s",
  "winter_Wed4_2": "\uCF04\uD2B8\uAC00 \uC9D1\uC5D0 \uB3CC\uC544\uC628 \uC9C0 \uC880 \uB418\uC5C8\uB294\uB370, \uC544\uC9C1 \uB9C8\uC74C\uC774 \uBD88\uC548\uD574 \uBCF4\uC5EC.$s",
  "winter_Thu": "\uC0D8\uC774 \uC74C\uC545 \uD55C\uB2E4\uACE0 \uC880 \uB9CE\uC774 \uC2DC\uB04C\uC2DC\uB04C\uD558\uB354\uB77C. \uC774\uC6C3\uB4E4\uC5D0\uAC8C \uD3D0\uB97C \uB07C\uCE58\uBA74 \uC548 \uB418\uB294\uB370.",
  "winter_Thu_inlaw_Sam": "\uC0D8\uC740 \uC694\uC998 \uC5B4\uB54C? \uC778\uC815\uD560\uB9CC\uD55C \uAC8C, \uC0D8\uC774 \uC774\uC0AC \uB098\uAC00\uACE0 \uB098\uC11C \uC694\uB9AC\uD558\uACE0 \uCCAD\uC18C\uD560\uAC8C \uB9CE\uC774 \uC904\uAE34 \uD588\uC5B4...",
  "winter_Thu8": "\uCF04\uD2B8\uAC00 \uAD70\uC778\uC774\uACE0 \uD574\uC11C \uC6B0\uB9AC \uACB0\uD63C\uC744 \uC880 \uAE09\uD558\uAC8C \uD558\uAE34 \uD588\uC5B4... \uC80A\uC74C\uACFC \uC790\uC720\uB97C \uB204\uB824\uBCFC \uAE30\uD68C\uAC00 \uAC70\uC758 \uC5C6\uC5C8\uC9C0, \uAC8C\uB2E4\uAC00 \uC774\uC820 \uB108\uBB34 \uB2A6\uC5C8\uC5B4.$s#$e#\uB124\uAC8C \uC774\uB7F0 \uB9D0\uC744 \uD558\uACE0 \uC788\uB2E4\uB294 \uAC8C \uBBFF\uAE30\uC9C0 \uC54A\uB294\uB2E4.$4",
  "winter_Fri": "\uAC00\uB054\uC740 \uD734\uAC00 \uAC00\uB294 \uAC83\uB3C4 \uC88B\uC744 \uAC83 \uAC19\uC544...$s",
  "winter_Sun": "\uB0B4\uAC00 \uB3C8\uC774 \uB9CE\uC558\uB2E4\uBA74 \uAC00\uC7A5 \uBA3C\uC800 \uAC00\uC815\uBD80\uC640 \uC694\uB9AC\uC0AC\uB97C \uACE0\uC6A9\uD558\uACA0\uC5B4.#$e#\uC5B4\uBA38 \uC138\uC0C1\uC5D0, \uADF8\uAC70 \uB108\uBB34 \uC88B\uC744 \uAC83 \uAC19\uB2E4!$h",
  "fall_Mon6": "\uB0B4\uAC00 \uBCF5\uBC1B\uC558\uB2E4\uB294 \uAC78 \uC885\uC885 \uAE30\uC5B5\uD574\uC57C\uACA0\uC5B4. \uC5EC\uAE30 \uC0DD\uD65C\uC740 \uC815\uB9D0 \uC88B\uC544. \uC138\uC0C1\uC5D4 \uBA39\uC744\uAC8C \uBD80\uC871\uD55C \uC0AC\uB78C\uB4E4\uB3C4 \uC788\uB294 \uAC78.$s"
}