  "eventSeen_101": "\uBD88\uC30D\uD55C \uD074\uB9B0\uD2B8... \uB4E3\uAE30\uB860 \uC644\uC804 \uC5D0\uBC00\uB9AC\uD55C\uD14C \uBE60\uC9C4 \uAC83 \uAC19\uB358\uB370, \uC5D0\uBC00\uB9AC\uB294 \uADF8\uB0E5 \uCE5C\uAD6C\uB85C \uC0DD\uAC01\uD55C\uB2E4\uB354\uB77C...",
  "eventSeen_58": "\uB3D9\uB124 \uC544\uC90C\uB9C8\uB4E4\uC774\uB791 \uB9E4\uC8FC \uC5D0\uC5B4\uB85C\uBE45 \uC218\uC5C5\uC744 \uB4E3\uACE0 \uC788\uC5B4...#$b#\uCD5C\uADFC \uC0C8\uB85C\uC6B4 \uC0AC\uB78C\uC774 \uD569\uB958\uD588\uB294\uB370, \uADF8 \uB0A8\uC790\uAC00 \uC808\uB300\uB85C \uC790\uAE30 \uC815\uCCB4\uB294 \uACF5\uAC1C\uD558\uC9C0 \uB9D0\uB77C\uACE0 \uB9F9\uC138\uD558\uAC8C \uD588\uB2E8\uB2E4!",
  "eventSeen_3102768": "\uD398\uB2C8\uB294 \uC815\uB9D0 \uC88B\uC740 \uC544\uC774\uB780\uB2E4. \uD55C\uB3D9\uC548 \uBE48\uC13C\uD2B8\uB97C \uAC00\uB974\uCCD0 \uC92C\uB294\uB370, \uBE48\uC13C\uD2B8\uAC00 \uBB34\uCC99 \uB9C8\uC74C\uC5D0 \uB4E4\uC5B4 \uD558\uB354\uB77C\uACE0.",
  "cc_Bus": "\uBC84\uC2A4\uAC00 \uB2E4\uC2DC \uC6B4\uD589 \uC911\uC774\uB77C\uBA70. \uBD84\uBA85 \uD338\uC774 \uAE30\uBED0\uD558\uACA0\uC9C0...#$b#\uC9C1\uC7A5\uC744 \uC783\uC740 \uB4A4\uB85C \uC220\uC744 \uB9CE\uC774 \uB9C8\uC168\uB2E4\uB358\uB370... \uC774\uC81C \uAD1C\uCC2E\uC544\uC84C\uC73C\uBA74 \uC88B\uACA0\uB124.",
  "reject_864": "\uC774\uAC8C \uBB50\uC57C? \uCF04\uD2B8 \uB3D9\uB8CC \uC0AC\uC9C4\uC778 \uAC83 \uAC19\uC740\uB370. \uCF04\uD2B8\uD55C\uD14C \uC9C1\uC811 \uBCF4\uC5EC\uC8FC\uBA74 \uBB54\uAC00 \uC598\uAE30\uD574 \uC8FC\uB824\uB098?",
  "Mon": "\uC9D1\uC548 \uC0B4\uB9BC\uC740 \uC5B4\uB824\uC6B4 \uC77C\uC774\uC9C0... \uD558\uC9C0\uB9CC \uB204\uAD70\uAC00 \uD558\uAE34 \uD574\uC57C \uD574.#$e#\uC751?",
  "Mon6": "\uAC00\uC871\uC774 \uC788\uB294 \uAC74 \uC88B\uC9C0\uB9CC... \uC80A\uC740 \uC2DC\uC808\uC758 \uC790\uC720\uAC00 \uADF8\uB9BD\uC9C0 \uC54A\uB2E4\uACE0 \uD558\uBA74 \uAC70\uC9D3\uB9D0\uC774\uACA0\uC9C0...$s",
  "2_1": "\uB0B4 \uB0A8\uD3B8 \uCF04\uD2B8\uB294 \uAD70\uC778\uC774\uC57C, \uC9C0\uAE08\uC740 \uD574\uC678\uC5D0\uC11C \uC77C\uD558\uACE0 \uC788\uC5B4. \uADF8\uB798\uC11C \uC9C0\uAE08 \uC5EC\uAE30\uC5D0 \uC5C6\uB294 \uAC70\uACE0.#$b#\uD30C\uACAC\uC774 \uB05D\uB098\uBA74 \uC548\uC804\uD558\uAC8C \uB3CC\uC544\uC62C \uAC70\uB780 \uAC78 \uC54C\uC544!!#$e#\uD639\uC2DC \uD544\uC694\uD55C \uAC70 \uC788\uB2C8?",
  "Tue": "\uAC74\uAC15\uD558\uAC8C \uC9C0\uB0B4\uB824\uBA74 \uC6B4\uB3D9\uC774 \uC911\uC694\uD558\uC9C0. \uB09C \uAF2D \uC6B4\uB3D9\uD560 \uC2DC\uAC04\uC744 \uB530\uB85C \uB9C8\uB828\uD558\uB294 \uD3B8\uC774\uC57C.#$e#\uBD80\uBAA8\uB85C\uC11C \uB09C \uB098 \uC790\uC2E0\uC5D0\uAC8C \uD560\uC560\uD560 \uC2DC\uAC04\uC774 \uB9CE\uC9C0 \uC54A\uC544. \uADF8\uB798\uC11C \uC77C\uBD84\uC77C\uCD08\uAC00 \uC911\uC694\uD558\uC9C0.",
  "Wed4": "\uBC16\uC5D0\uC11C \uC880 \uB354 \uB9CE\uC740 \uC2DC\uAC04\uC744 \uBCF4\uB0B4\uACE0 \uC2F6\uC9C0\uB9CC, \uD560 \uC77C\uC774 \uB108\uBB34 \uB9CE\uC740\uAC78.#$e#\uC190\uC774 \uB108\uBB34 \uAC70\uCE60\uC5B4\uC9C0\uB294 \uAC83 \uAC19\uC544\uC11C \uACE0\uBB34\uC7A5\uAC11\uC744 \uC4F0\uAE30 \uC2DC\uC791\uD588\uC5B4.#$e#\uB098\uC774\uAC00 \uB4E4\uC218\uB85D, \uAC74\uAC15\uD558\uAC8C \uC9C0\uB0B4\uB294\uB370 \uB178\uB825\uC774 \uB354 \uD544\uC694\uD574.$s#$e#\uADF8\uB7FC, \uC548\uB155!",
  "Wed": "\uBB50\uB77C\uACE0? \uC9C0\uAE08 \uBC8C\uC368 %time\uB77C\uACE0? \uC5B4\uBA38\uB098!#$e#\uC544\uC9C1 \uD560 \uC77C\uC774 \uC794\uB729 \uB0A8\uC558\uB294\uB370!$s",
  "Thu6": "\uC2DC\uAC04\uC774 \uC65C \uC774\uB807\uAC8C \uBE68\uB9AC \uAC00\uB294 \uAC70 \uAC19\uC9C0? *\uD55C\uC228*#$e#\uC0D8\uC774 \uAE30\uC800\uADC0 \uCC2C \uC544\uAC00\uC600\uB358 \uB54C\uAC00 \uAE30\uC5B5\uB098. \uCC38 \uADC0\uC5EC\uC6B4 \uC544\uC774\uC600\uC9C0.$s#$e#\uB0B4\uAC00 \uC774\uB7F0 \uC598\uAE30 \uD588\uB2E4\uACE0\uB294 \uD558\uC9C0 \uB9D0\uACE0.$h#$e#\uB098\uB791 \uC598\uAE30\uD558\uB294 \uAC70 \uC7AC\uBC0C\uAD6C\uB098, \uADF8\uCE58?",
  "Thu": "\uB108 \uB18D\uBD80\uB77C\uACE0 \uD588\uC9C0? \uD765\uBBF8\uB86D\uB124.#$e#\uB098 \uB18D\uBD80\uB294 \uB9CC\uB098\uBCF8 \uC801 \uC5C6\uC5B4.#$e#\uB098\uC911\uC5D0 \uC5B8\uC81C \uCC44\uC18C \uAE30\uB974\uB294 \uBC95\uB3C4 \uC54C\uB824\uC904 \uC218 \uC788\uACA0\uB2E4.$h",
  "Fri": "$d Joja#\uC870\uC790 \uB9C8\uD2B8 \uC74C\uC2DD\uC774 \uADF8\uB807\uAC8C \uAC74\uAC15\uD55C \uC74C\uC2DD\uC740 \uC544\uB2D0\uC9C0\uB77C\uB3C4, \uAC00\uACA9\uC774 \uB108\uBB34 \uC800\uB834\uD574\uC11C \uB2E4\uB978 \uACF3\uC744 \uAC00\uAE30 \uD798\uB4E4\uC5B4.|\uD53C\uC5D0\uB974\uB124\uC11C \uC0B0 \uC2DD\uC7AC\uB8CC\uAC00 \uC870\uC790 \uB9C8\uD2B8 \uBB3C\uD488\uBCF4\uB2E4 \uD6E8\uC52C \uC2E0\uC120\uD558\uACE0 \uAC74\uAC15\uC5D0 \uC88B\uC544. \uADF8\uB7F0\uB370 \uC2FC \uC870\uC790 \uAC00\uACA9\uC774 \uC880 \uADF8\uB9BD\uAE30\uB294 \uD574.",
  "Sat": "\uC548\uB155.#$e#\uD544\uC694\uD55C \uAC70 \uC788\uC5B4?",
  "Sat4": "\uADF8 \uC624\uB798\uB41C \uB18D\uC7A5\uC744 \uAC1C\uC120\uD558\uB824 \uD55C\uB2E4\uB2C8 \uB4E3\uAE30 \uAE30\uC05C \uC18C\uC2DD\uC774\uB2E4.#$e#\uBAA8\uB4E0 \uAC8C \uC815\uB9AC\uB418\uBA74, \uC6B0\uB9AC \uB9C8\uC744\uC5D0 \uB9CE\uC740 \uC88B\uC740 \uC601\uD5A5\uC744 \uC904 \uAC70\uC57C!$h#$e#\uB124\uAC00 \uD560 \uC77C\uC774 \uB9CE\uAE34 \uD558\uACA0\uB2E4 \uADFC\uB370.#$e#\uC548\uB155.",
  "Mon2": "$d kent#\uC5B4\uC81C \uB0A8\uD3B8\uC774 \uBB34\uC0AC\uD788 \uB3CC\uC544\uC628 \uAC83\uC744 \uAC10\uC0AC\uB4DC\uB9AC\uAE30 \uC704\uD574 \uC694\uBC14\uC758 \uC81C\uB2E8\uC5D0 \uB2E4\uB140\uC654\uC5B4.|\uC5B4\uC81C \uB0A8\uD3B8\uC774 \uBB34\uC0AC\uD788 \uB3CC\uC544\uC62C \uC218 \uC788\uB3C4\uB85D \uAE30\uB3C4\uB97C \uC62C\uB9AC\uB7EC \uC694\uBC14\uC758 \uC81C\uB2E8\uC5D0 \uB2E4\uB140\uC654\uC5B4.#$e#\uAE0D\uC815\uC801\uC778 \uD0DC\uB3C4\uB97C \uC720\uC9C0\uD558\uACE0 \uC2F6\uC740\uB370, \uAC00\uB054 \uD798\uB4E4\uC5B4.$s",
  "Sun": "#$c .5#\uC624\uB298\uC740 \uC9D1\uC548\uC77C \uC880 \uC26C\uB824\uACE0.$h#$e#\uD558\uB8E8 \uD734\uAC00 \uB0B4\uB294 \uAC70\uC9C0.$h#$e#\uBC16\uC5D0\uC11C \uC2DC\uAC04 \uC548 \uBCF4\uB0C8\uB2E4\uAC00\uB294, \uBBF8\uCE58\uB294 \uC218\uAC00 \uC788\uC5B4!#$e#\uAC8C\uB2E4\uAC00 \uB2E4\uB9AC\uAC00 \uB108\uBB34 \uB9D0\uB791\uB9D0\uB791\uD574\uC9C0\uAE34 \uC2EB\uC5B4.",
  "Sun8": "\uC644\uC804\uD788 \uC790\uC720\uB85C\uC6B4 \uAFC8\uC744 \uAFE8\uC5B4, \uB098 \uC774\uC678\uC758 \uC758\uBB34\uB294 \uC804\uD600 \uC5C6\uB294...#$b#...\uADF8\uB7EC\uACE0 \uAE68\uC11C \uD558\uB8E8 \uC885\uC77C \uC9D1\uC548\uC77C\uC744 \uD574\uC57C \uD55C\uB2E4\uB294 \uAC78 \uAE68\uB2EC\uC558\uC9C0...$s#$e#\uD558\uC9C0\uB9CC \uAC00\uC815\uC744 \uAFB8\uB9B0 \uAC78 \uD6C4\uD68C\uD558\uB294 \uAC74 \uC544\uB0D0, @... \uC0D8\uACFC \uBE48\uC13C\uD2B8\uB294 \uB098\uC758 \uBAA8\uB4E0 \uAC83\uC778\uAC78!",
  "summer_Mon": "\uC5EC\uB984\uC774 \uC88B\uAE34 \uD558\uC9C0\uB9CC, \uC77C\uAC70\uB9AC\uB3C4 \uB354 \uB9CE\uC544.#$e#\uC9D1\uC548\uC77C\uBFD0\uB9CC \uC544\uB2C8\uB77C \uC815\uC6D0\uB3C4 \uAC00\uAFD4\uC57C \uD558\uB294 \uAC78!",
  "summer_Tue": "\uC548\uB155.#$e#\uBB54\uAC00 \uD544\uC694\uD55C \uAC70 \uC788\uC5B4? \uB098 \uC9C0\uAE08\uC740 \uC880 \uBC14\uBE60\uC11C.",
