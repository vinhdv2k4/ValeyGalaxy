{
  "SpouseStardrop": "\u042F \u0445\u043E\u0442\u0435\u043B \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C \u0442\u0435\u0431\u044F \u0437\u0430 \u0442\u043E, \u0447\u0442\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u0436\u0438\u0432\u0443 \u0443 \u0442\u0435\u0431\u044F. \u0412\u043E\u0442, \u0432\u043E\u0437\u044C\u043C\u0438.$h",
  "4_*": "...\u0422\u044B \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043B \u0442\u0430\u043A\u0438\u0445 \u0436\u0435, \u043A\u0430\u043A \u044F, \u0432 \u0448\u0430\u0445\u0442\u0430\u0445? \u0418\u0437\u0432\u0438\u043D\u0438, \u0435\u0441\u043B\u0438 \u043E\u043D\u0438 \u043D\u0430 \u0442\u0435\u0431\u044F \u043D\u0430\u043F\u0430\u0434\u0430\u043B\u0438. \u041F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C, \u043C\u044B \u043F\u0440\u0438\u0432\u044B\u043A\u043B\u0438 \u0431\u043E\u044F\u0442\u044C\u0441\u044F \u043B\u044E\u0434\u0435\u0439... \u0423 \u043D\u0430\u0441 \u0441 \u043D\u0438\u043C\u0438 \u0431\u044B\u043B\u043E \u043C\u043D\u043E\u0433\u043E... \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u044B\u0445 \u0432\u0441\u0442\u0440\u0435\u0447.#$e#\u0422\u044B \u0436\u0435 \u0432\u0435\u0434\u044C... \u041D\u0435 \u0443\u0431\u0438\u043B \u043D\u0438\u043A\u043E\u0433\u043E \u0438\u0437 \u043C\u043E\u0438\u0445 \u0434\u0440\u0443\u0437\u0435\u0439, \u0434\u0430?",
  "AcceptBirthdayGift_Positive": "\u041E, \u0434\u0430\u0440 \u043D\u0430 \u0434\u0435\u043D\u044C \u043C\u043E\u0435\u0433\u043E \u0432\u044B\u043B\u0443\u043F\u043B\u0435\u043D\u0438\u044F. \u0421\u043F\u0430\u0441\u0438\u0431\u043E!$h",
  "GreenRain": "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0442\u0435\u0447\u0435\u043D\u0438\u0435 \u0432\u043E\u0434\u044B \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0441\u0438\u043B\u044C\u043D\u043E\u0435... \u0427\u0442\u043E \u0442\u0430\u043C \u0432\u043E\u043E\u0431\u0449\u0435 \u043D\u0430\u0432\u0435\u0440\u0445\u0443 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442?",
  "AcceptBirthdayGift_Negative": "\u041E\u0439... \u0418 \u0443 \u0432\u0430\u0441 \u044D\u0442\u043E \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u00AB\u043F\u043E\u0434\u0430\u0440\u043A\u043E\u043C \u043D\u0430 \u0434\u0435\u043D\u044C \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F\u00BB? \u041D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E \u044F \u043B\u044E\u0434\u0435\u0439...$s",
  "AcceptGift_(O)StardropTea": "\u042D\u0442\u043E \u0447\u0442\u043E, \u0447\u0430\u0439 \u0438\u0437 \u0417\u0432\u0435\u0437\u0434\u043D\u043E\u0439 \u043A\u0430\u043F\u043B\u0438? \u0421\u043F\u0430\u0441\u0438\u0431\u043E! \u041E\u0442 \u043E\u0434\u043D\u043E\u0439 \u043A\u0430\u043F\u043B\u0438 \u043A\u043E\u043C\u043D\u0430\u0442\u0430 \u0432\u0435\u0441\u044C \u0434\u0435\u043D\u044C \u0432\u043A\u0443\u0441\u043D\u043E \u043F\u0430\u0445\u043D\u0435\u0442.",
  "AcceptGift_(O)Book_Void": "\u042D\u0439, \u0441\u043C\u043E\u0442\u0440\u0438! \u0422\u0430\u043C \u0432\u0441\u0435 \u043C\u043E\u0438 \u0434\u0440\u0443\u0437\u044C\u044F!$h#$b#\u041F\u043E\u0441\u0442\u043E\u0439, \u044D\u0442\u043E \u0447\u0442\u043E, \u044F...?$7",
  "AcceptGift_(O)879": "\u041F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u043F\u0430\u0440\u0444\u044E\u043C \u0432 \u0434\u0430\u0440? \u041E, @... \u042F \u043A\u0440\u0430\u0441\u043D\u0435\u044E, \u043D\u043E \u0442\u044B, \u0441\u043A\u043E\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043E, \u044D\u0442\u043E\u0433\u043E \u043D\u0435 \u0432\u0438\u0434\u0438\u0448\u044C...$4",
  "AcceptGift_(O)308": "\u041F\u0430\u0445\u043D\u0435\u0442 \u0447\u0443\u0434\u0435\u0441\u043D\u043E! \u041F\u043E\u043B\u043E\u0432\u0438\u043D\u0443 \u044F \u0441\u044A\u0435\u043C, \u0430 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u043E\u0439 \u043D\u0430\u043C\u0430\u0436\u0443 \u0441\u0432\u043E\u0435 \u0442\u0435\u043B\u043E...$h",
  "8_*": "\u0422\u044B\u0441\u044F\u0447\u0435\u043B\u0435\u0442\u043D\u044F\u044F \u0432\u043E\u0439\u043D\u0430 \u043C\u0435\u0436\u0434\u0443 \u043C\u043E\u0438\u043C \u043D\u0430\u0440\u043E\u0434\u043E\u043C \u0438 \u0414\u0432\u0430\u0440\u0444\u0430\u043C\u0438 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0430\u0441\u044C \u043D\u0435 \u0442\u0430\u043A \u0434\u0430\u0432\u043D\u043E. \u041D\u043E \u043E\u0431\u0435 \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u043F\u0440\u0435\u0437\u0438\u0440\u0430\u044E\u0442 \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430.",
  "15_*": "\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043D\u0435 \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0439 \u043C\u043E\u0435\u0433\u043E \u043C\u0435\u0441\u0442\u043E\u043D\u0430\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F \u043D\u0438\u043A\u043E\u043C\u0443. \u0415\u0441\u043B\u0438 \u0434\u0432\u0430\u0440\u0444\u044B \u043E\u0431\u043E \u043C\u043D\u0435 \u0443\u0437\u043D\u0430\u044E\u0442, \u043E\u043D\u0438 \u0442\u043E\u0447\u043D\u043E \u043F\u0440\u0438\u0448\u043B\u044E\u0442 \u043A\u043E \u043C\u043D\u0435 \u0443\u0431\u0438\u0439\u0446\u0443.",
  "18_*": "\u042F \u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C \u0442\u0443\u0442 \u0432\u043D\u0438\u0437\u0443 \u043D\u0435 \u0448\u0443\u043C\u0435\u0442\u044C. \u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044C, \u0447\u0442\u043E \u0431\u044B \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E, \u0435\u0441\u043B\u0438 \u0431\u044B \u0436\u0438\u0442\u0435\u043B\u0438 \u0433\u043E\u0440\u043E\u0434\u0430 \u0443\u0441\u043B\u044B\u0448\u0430\u043B\u0438 \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0435 \u0437\u0432\u0443\u043A\u0438 \u0438\u0437 \u043A\u0430\u043D\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438...",
