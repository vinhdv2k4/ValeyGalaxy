  "eventSeen_691039": "...\u042F \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u043E\u0431\u0438\u0442, \u043D\u043E \u0436\u0438\u0432.",
  "reject_868": "\u041E\u0439, \u044D\u0442\u043E \u0436\u0435 \u0410\u0440\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043E\u0441\u043A\u043E\u043B\u043E\u043A! \u041E\u0447\u0435\u043D\u044C \u0440\u0435\u0434\u043A\u0438\u0439 \u0432\u043E\u043B\u0448\u0435\u0431\u043D\u044B\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442.#$b#\u041D\u0430 \u0442\u0432\u043E\u0435\u043C \u043C\u0435\u0441\u0442\u0435 \u044F \u0431\u044B \u043E\u0442\u043D\u0435\u0441 \u0435\u0433\u043E \u0412\u043E\u043B\u0448\u0435\u0431\u043D\u0438\u043A\u0443!",
  "Wed": "\u042F \u043D\u0430\u0445\u043E\u0436\u0443 \u0437\u0434\u0435\u0441\u044C \u0440\u0430\u0437\u043D\u044B\u0435 \u0432\u0435\u0449\u0438 \u0438 \u043F\u0440\u043E\u0434\u0430\u044E \u0438\u0445. \u041A\u0443\u043F\u0438\u0448\u044C \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C?",
  "Wed6": "\u0415\u0441\u043B\u0438 \u043F\u0440\u0438\u043B\u043E\u0436\u0438\u0448\u044C \u0443\u0445\u043E \u043A \u043D\u0443\u0436\u043D\u043E\u0439 \u0442\u0440\u0443\u0431\u0435 \u2014 \u0442\u043E \u0443\u0441\u043B\u044B\u0448\u0438\u0448\u044C, \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442 \u0432 \u043B\u044E\u0431\u043E\u043C \u0434\u043E\u043C\u0435 \u043F\u0440\u044F\u043C\u043E \u043E\u0442\u0441\u044E\u0434\u0430.#$b#\u041D\u043E \u044F \u0431\u044B \u043D\u0435 \u0441\u0442\u0430\u043B \u043F\u043E\u0434\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u0442\u044C!$3",
  "Thu": "\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043D\u0438\u043A\u043E\u043C\u0443 \u043E\u0431\u043E \u043C\u043D\u0435 \u043D\u0435 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0439.#$b#\u041B\u044E\u0434\u0438 \u0438\u043C\u0435\u044E\u0442 \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u043E \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u0442\u044C \u0442\u043E, \u0447\u0435\u0433\u043E \u043E\u043D\u0438 \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E\u0442.",
  "Thu6": "\u041F\u0440\u043E\u0448\u0443, \u043D\u0435 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0439 \u043E\u0431\u043E \u043C\u043D\u0435 \u043D\u0438\u043A\u043E\u043C\u0443.#$b#\u041C\u043D\u043E\u0433\u0438\u0435 \u043B\u044E\u0434\u0438 \u0431\u043E\u044F\u0442\u0441\u044F \u0442\u0435\u043D\u0435\u0432\u043E\u0433\u043E \u043D\u0430\u0440\u043E\u0434\u0430... \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u043D\u0435\u0441\u043F\u0440\u043E\u0441\u0442\u0430.$s#$b#\u0412 \u043B\u044E\u0431\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435, \u0435\u0441\u043B\u0438 \u0433\u043E\u0440\u043E\u0436\u0430\u043D\u0435 \u043F\u0440\u043E\u0437\u043D\u0430\u044E\u0442 \u043E\u0431\u043E \u043C\u043D\u0435, \u0442\u043E \u043C\u043D\u0435 \u0441\u0442\u0430\u043D\u0435\u0442 \u043D\u0435\u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E \u0442\u0443\u0442 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F.",
  "Tue": "\u042F \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u0435\u043D \u043A \u0441\u043E\u043B\u043D\u0446\u0443, \u0447\u0442\u043E\u0431\u044B \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u044C \u043D\u0430\u0432\u0435\u0440\u0445 \u0434\u043D\u0435\u043C.#$b#\u0417\u0434\u0435\u0441\u044C \u0436\u0435 \u0443\u0441\u043B\u043E\u0432\u0438\u044F \u0431\u0435\u0437\u0443\u043F\u0440\u0435\u0447\u043D\u044B\u0435.#$e#\u041A\u0443\u043F\u0438\u0448\u044C \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C?",
  "Mon": "\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043D\u0435 \u0442\u0440\u0435\u0432\u043E\u0436\u044C\u0441\u044F. \u042F \u043D\u0435 \u0442\u0430\u043A\u043E\u0439, \u043A\u0430\u043A \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435.#$e#\u042F \u043C\u043D\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043F\u0440\u043E\u0432\u0435\u043B \u0432 \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0438 \u0437\u0430 \u043B\u044E\u0434\u044C\u043C\u0438. \u042F \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0432\u044B \u043B\u044E\u0431\u0438\u0442\u0435 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u044C. \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0448\u044C \u043C\u043E\u0439 \u0442\u043E\u0432\u0430\u0440?",
  "Mon2": "\u0422\u044B \u0441\u043D\u043E\u0432\u0430 \u0437\u0434\u0435\u0441\u044C? \u041F\u043E\u043B\u0430\u0433\u0430\u044E, \u044D\u0442\u043E \u0432\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0432 \u043C\u043E\u044E \u0442\u0435\u043E\u0440\u0438\u044E \u043E \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u043E\u043C \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0438.",
  "Mon6": "\u0022\u041A\u0440\u043E\u0431\u0443\u0441\u0022 \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u0022\u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044F\u0449\u0438\u0439 \u043F\u043E \u043C\u043E\u0441\u0442\u0443\u0022 \u043D\u0430 \u043D\u0430\u0448\u0435\u043C \u044F\u0437\u044B\u043A\u0435.",
  "Sat": "\u041F\u043E \u043F\u044F\u0442\u043D\u0438\u0446\u0430\u043C \u044F \u0445\u0440\u0430\u043D\u044E \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0435 \u0432 \u0437\u043D\u0430\u043A \u043F\u0440\u0435\u0434\u0430\u043D\u043D\u043E\u0441\u0442\u0438 \u0418\u043E\u0431\u0435.",
  "Sat4": "\u0425\u043E\u0442\u0435\u043B\u043E\u0441\u044C \u0431\u044B \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043D\u0430 \u043C\u0438\u0440 \u0441\u043D\u0430\u0440\u0443\u0436\u0438, \u043D\u043E \u0442\u0430\u043C \u0434\u043B\u044F \u043C\u0435\u043D\u044F \u043D\u0435\u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E.$s",
  "Sat8": "\u042F \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043F\u043E\u0439\u043C\u0443, \u043A\u0430\u043A \u044D\u0442\u043E \u2014 \u0431\u044B\u0442\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C... \u041D\u043E \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u044B \u0441 \u0442\u043E\u0431\u043E\u0439 \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442 \u043C\u043D\u0435 \u0445\u043E\u0442\u044F \u0431\u044B \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u044C\u0441\u044F \u043A \u044D\u0442\u043E\u043C\u0443.",
  "Sun": "... \u041F\u0440\u043E\u0441\u0442\u0438, \u044F \u0432\u0441\u0435 \u0435\u0449\u0435 \u043F\u043E\u0431\u0430\u0438\u0432\u0430\u044E\u0441\u044C \u043B\u044E\u0434\u0435\u0439. \u041D\u043E \u0434\u043B\u044F \u0442\u0435\u0431\u044F \u043C\u043E\u0439 \u043C\u0430\u0433\u0430\u0437\u0438\u043D \u0432\u0441\u0435 \u0435\u0449\u0435 \u043E\u0442\u043A\u0440\u044B\u0442.",
  "Sun4": "\u0422\u044B \u043D\u0435 \u0442\u0430\u043A\u043E\u0439, \u043A\u0430\u043A \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u043B\u044E\u0434\u0438, \u0434\u0430?",
  "Sun8": "\u0422\u0435\u0431\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u043C\u043D\u0435 \u0433\u043B\u0430\u0437\u0430 \u043D\u0430 \u043C\u0438\u0440 \u043B\u044E\u0434\u0435\u0439. \u042F \u044D\u0442\u043E \u0446\u0435\u043D\u044E.",
