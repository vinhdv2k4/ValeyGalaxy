{
  "Introduction": "\u0410\u0445, \u0434\u0430. \u042F \u0434\u0430\u0432\u043D\u043E \u043F\u0440\u0435\u0434\u0432\u0438\u0434\u0435\u043B \u0442\u0432\u043E\u0435 \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u0435, @.#$e#\u041E\u0434\u043D\u0430\u043A\u043E, \u0442\u0432\u043E\u044F \u0441\u0443\u0434\u044C\u0431\u0430 \u0431\u0435\u0437\u0440\u0430\u0437\u0434\u0435\u043B\u044C\u043D\u043E \u0432 \u0442\u0432\u043E\u0438\u0445 \u0440\u0443\u043A\u0430\u0445.",
  "AcceptGift_(O)StardropTea": "\u0422\u0430\u043A, \u0447\u0442\u043E \u044D\u0442\u043E \u0442\u0443\u0442 \u0443 \u043D\u0430\u0441? \u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u0440\u0435\u0434\u043A\u0438\u0439 \u0441\u0438\u043B\u044C\u043D\u044B\u0439 \u044D\u043B\u0438\u043A\u0441\u0438\u0440. \u0414\u0430, \u0431\u0443\u0434\u0435\u0442 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u043C \u0434\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435\u043C \u043A \u043C\u043E\u0435\u0439 \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u0438 \u0440\u0435\u0430\u0433\u0435\u043D\u0442\u043E\u0432.",
  "accept_868": "\u0410... \u0410\u0440\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043E\u0441\u043A\u043E\u043B\u043E\u043A.#$b#\u0414\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u043C\u043E\u0449\u043D\u043E\u0435 \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u043E, \u0438 \u043A \u0442\u043E\u043C\u0443 \u0436\u0435 \u043F\u0440\u043E\u0447\u043D\u043E \u0441\u0432\u044F\u0437\u0430\u043D\u043E \u0441 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u043C \u043B\u044C\u0434\u0430.#$b#\u042F \u0431\u044B \u0432\u0437\u044F\u043B \u0435\u0433\u043E \u0441\u0435\u0431\u0435, \u0435\u0441\u043B\u0438 \u0442\u044B \u043D\u0435 \u043F\u0440\u043E\u0442\u0438\u0432.#$b#...#$b#...\u042D\u043C...\u0422\u044B \u0432\u0441\u0435 \u0435\u0449\u0435 \u0437\u0434\u0435\u0441\u044C. \u0410. \u0422\u044B \u0445\u043E\u0447\u0435\u0448\u044C \u0447\u0435\u0433\u043E-\u0442\u043E \u0432\u0437\u0430\u043C\u0435\u043D?#$b#...\u0412\u043E\u0442, \u0432\u043E\u0437\u044C\u043C\u0438.",
  "MovieInvitation": "\u0425\u043C... \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u044F \u0441\u043C\u043E\u0433\u0443 \u0441\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0442\u0435\u0431\u0435 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044E... \u0434\u0430. \u042F \u043F\u043E\u044F\u0432\u043B\u044E\u0441\u044C, \u043A\u043E\u0433\u0434\u0430 \u0442\u044B \u043F\u0440\u0438\u0431\u0443\u0434\u0435\u0448\u044C \u0442\u0443\u0434\u0430. \u0414\u043E \u0432\u0441\u0442\u0440\u0435\u0447\u0438.",
  "GreenRain": "\u041A\u043E\u043D\u0435\u0447\u043D\u043E, \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u044B\u0435 \u0434\u043E\u0436\u0434\u0438 \u043C\u043E\u0433\u0443\u0442 \u0432\u044B\u0437\u044B\u0432\u0430\u0442\u044C \u043E\u043F\u0430\u0441\u0435\u043D\u0438\u044F, \u043D\u043E \u0432 \u044D\u0442\u043E\u0442 \u0434\u0435\u043D\u044C \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E \u043D\u0435\u0447\u0435\u0433\u043E \u0431\u043E\u044F\u0442\u044C\u0441\u044F.#$e#\u041D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u0441\u0435 \u0436\u0438\u0432\u043E\u0435 \u0440\u0430\u0434\u0443\u0435\u0442\u0441\u044F \u0438 \u043F\u0440\u0430\u0437\u0434\u043D\u0443\u0435\u0442.",
  "GreenRain_2": "\u041F\u0440\u0438\u0440\u043E\u0434\u0430 \u2014 \u0432\u0435\u043B\u0438\u043A\u0430\u044F \u0441\u0438\u043B\u0430, \u0441 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043B\u0443\u0447\u0448\u0435 \u043D\u0435 \u0437\u0430\u0438\u0433\u0440\u044B\u0432\u0430\u0442\u044C.#$e#\u0418\u0437\u0432\u0438\u043D\u0438, \u043D\u043E \u0443 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u0432\u0430\u0436\u043D\u044B\u0435 \u0434\u0435\u043B\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u043C\u0438 \u043C\u043E\u0436\u043D\u043E \u0437\u0430\u043D\u044F\u0442\u044C\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F.",
  "married": "\u0421\u0432\u0430\u0434\u044C\u0431\u0430... \u0434\u0430? \u041C\u043E\u043B\u044E\u0441\u044C, \u0447\u0442\u043E\u0431\u044B \u0442\u0435\u0431\u044F \u043D\u0435 \u043F\u043E\u0441\u0442\u0438\u0433\u043B\u0430 \u043C\u043E\u044F \u0443\u0447\u0430\u0441\u0442\u044C...",
  "roommates_Krobus": "\u0411\u0443\u0434\u0435\u0442 \u0441\u043B\u043E\u0436\u043D\u043E \u0436\u0438\u0442\u044C \u0441 \u0442\u0430\u043A\u0438\u043C \u0441\u043E\u0441\u0435\u0434\u043E\u043C, \u043A\u0430\u043A \u041A\u0440\u043E\u0431\u0443\u0441. \u041D\u043E \u0443\u0432\u0435\u0440\u0435\u043D, \u0447\u0442\u043E \u0432\u0430\u043C \u043E\u0431\u043E\u0438\u043C \u044D\u0442\u043E \u043F\u043E\u0439\u0434\u0435\u0442 \u043D\u0430 \u043F\u043E\u043B\u044C\u0437\u0443.#$e#\u041F\u0440\u0438\u0437\u043D\u0430\u044E, \u043C\u043D\u0435 \u0443\u0436\u0430\u0441\u043D\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043A\u0430\u043A\u0438\u0435 \u043F\u043B\u043E\u0434\u044B \u0441\u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0438\u043D\u0435\u0441\u0442\u0438 \u044D\u0442\u0430 \u0434\u0440\u0443\u0436\u0431\u0430.",
  "Mon": "\u041E, \u0434\u0430. \u042F \u0443\u0432\u0438\u0434\u0435\u043B \u043C\u043D\u043E\u0433\u043E\u0435 \u0438\u0437 \u0442\u0432\u043E\u0435\u0433\u043E \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043E, ${\u044E\u043D\u044B\u0439^\u044E\u043D\u0430\u044F}$ @.#$e#\u041D\u043E \u0435\u0441\u043B\u0438 \u044F \u0442\u0435\u0431\u0435 \u043E\u0431 \u044D\u0442\u043E\u043C \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443, \u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u044F \u0431\u0443\u0434\u0443\u0442 \u0441\u0430\u043C\u044B\u043C\u0438 \u0441\u0435\u0440\u044C\u0435\u0437\u043D\u044B\u043C\u0438.",
  "Mon4": "\u041F\u0440\u0438\u0440\u043E\u0434\u0430 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0441\u0432\u043E\u0438 \u0441\u0435\u043A\u0440\u0435\u0442\u044B \u0442\u043E\u043B\u044C\u043A\u043E \u0437\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u043C\u0438 \u0432\u043B\u0430\u0434\u0435\u043D\u0438\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430.",
  "Mon8": "\u0412 \u043C\u0438\u0440\u0435 \u0432\u0441\u0435 \u0435\u0449\u0435 \u0435\u0441\u0442\u044C \u043C\u0435\u0441\u0442\u0430, \u043D\u0435\u0437\u0430\u043F\u044F\u0442\u043D\u0430\u043D\u043D\u044B\u0435 \u043A\u043E\u043D\u0446\u0435\u043F\u0442\u043E\u043C \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E \u043C\u044B\u0448\u043B\u0435\u043D\u0438\u044F, \u0433\u0434\u0435 \u0432\u043E\u043B\u0448\u0435\u0431\u0441\u0442\u0432\u043E \u0432\u0441\u0435 \u0435\u0449\u0435 \u0436\u0438\u0432\u0435\u0435 \u0432\u0441\u0435\u0445 \u0436\u0438\u0432\u044B\u0445...",
  "Sat6": "\u041D\u0430\u0443\u0447\u043D\u044B\u0435 \u0438\u0437\u044B\u0441\u043A\u0430\u043D\u0438\u044F, \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u043C\u043E\u0433\u0443\u0442 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u0442\u043E\u0447\u043D\u043E \u043E\u043F\u0438\u0441\u0430\u0442\u044C \u043D\u044B\u043D\u0435\u0448\u043D\u044E\u044E \u043A\u0430\u0440\u0442\u0438\u043D\u0443 \u043C\u0438\u0440\u0430, \u043D\u043E \u0434\u0440\u0435\u0432\u043D\u0438\u0435 \u0442\u0430\u0439\u043D\u044B \u0435\u0439 \u043D\u0435 \u043E\u043F\u0438\u0441\u0430\u0442\u044C \u043D\u0438\u043A\u043E\u0433\u0434\u0430...",
  "Tue": "\u0415\u0441\u043B\u0438 \u0442\u0435\u0431\u0435 \u043D\u0435\u0447\u0435\u0433\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u044C \u0432\u0430\u0436\u043D\u043E\u0433\u043E, \u043F\u0440\u043E\u0448\u0443 \u2014 \u043E\u0441\u0442\u0430\u0432\u044C \u043C\u0435\u043D\u044F. \u0423 \u043C\u0435\u043D\u044F \u043C\u043D\u043E\u0433\u043E \u0440\u0430\u0431\u043E\u0442\u044B.",
  "Tue4": "\u042F \u0434\u043E\u0432\u0435\u0440\u044F\u044E \u0442\u0435\u0431\u0435 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E, \u0447\u0442\u043E\u0431\u044B \u0432\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0432 \u0441\u0432\u043E\u0439 \u043F\u043E\u0434\u0432\u0430\u043B. \u041E\u0431\u0440\u0430\u0449\u0430\u0439\u0441\u044F \u0431\u0435\u0440\u0435\u0436\u043D\u043E \u0441 \u0442\u0435\u043C, \u0447\u0442\u043E \u0442\u0430\u043C \u0443\u0432\u0438\u0434\u0438\u0448\u044C.",
  "Tue8": "\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E, @. \u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0442\u044B \u043D\u0435 \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0443\u0435\u0448\u044C\u0441\u044F \u0432 \u0442\u0435\u043C\u043D\u044B\u0445 \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0430\u0445?",
  "Tue10": "\u0415\u0441\u043B\u0438 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u2014 \u043F\u0440\u043E\u0434\u0443\u043A\u0442 \u0440\u0430\u0437\u0443\u043C\u0430, \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F, \u0442\u043E\u0442, \u043A\u0442\u043E \u043E\u0432\u043B\u0430\u0434\u0435\u0435\u0442 \u0441\u0438\u043B\u043E\u0439 \u0440\u0430\u0437\u0443\u043C\u0430, \u0441\u043C\u043E\u0436\u0435\u0442 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0438 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C...",
  "Wed": "\u042F\u0437\u044B\u043A \u0441\u0442\u0438\u0445\u0438\u0439 \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u043D\u044F\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043F\u0443\u0441\u0442\u044F \u0433\u043E\u0434\u044B \u0435\u0433\u043E \u0438\u0437\u0443\u0447\u0435\u043D\u0438\u044F.#$e#\u0410 \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043D\u0430 \u0438\u0445 \u044F\u0437\u044B\u043A\u0435, \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u043F\u043E\u0441\u0432\u044F\u0442\u0438\u0442\u044C \u0443\u0447\u0435\u043D\u0438\u044E \u0446\u0435\u043B\u0443\u044E \u0436\u0438\u0437\u043D\u044C.#$e#\u0410 \u0442\u0435\u043F\u0435\u0440\u044C \u043F\u0440\u043E\u0448\u0443 \u043C\u0435\u043D\u044F \u0438\u0437\u0432\u0438\u043D\u0438\u0442\u044C...",
  "Thu": "\u041C\u043D\u043E\u0433\u0438\u0435 \u0442\u0430\u0439\u043D\u044B \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0442 \u043D\u0430\u0441. \u0415\u0441\u043B\u0438 \u0436\u0435\u043B\u0430\u0435\u0448\u044C \u0438\u0445 \u043F\u043E\u0437\u043D\u0430\u0442\u044C, \u043D\u0443\u0436\u043D\u043E \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u0435.",
  "Thu10": "\u041E\u0431 \u044D\u0442\u043E\u043C \u043D\u0438\u043A\u043E\u043C\u0443 \u043D\u0435\u043B\u044C\u0437\u044F \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C... \u0423 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u043F\u0440\u0438\u0447\u0438\u043D\u044B \u043F\u043E\u043B\u0430\u0433\u0430\u0442\u044C, \u0447\u0442\u043E \u043E\u0434\u043D\u0430 \u0438\u0437 \u043C\u0435\u0441\u0442\u043D\u044B\u0445 \u0436\u0438\u0442\u0435\u043B\u044C\u043D\u0438\u0446 \u2014 \u043C\u043E\u044F \u0434\u043E\u0447\u044C...#$e#\u042F \u043C\u043E\u0433\u0443 \u043E\u0448\u0438\u0431\u0430\u0442\u044C\u0441\u044F... \u0422\u0430\u043A\u043E\u0435 \u0441\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F, \u043F\u0443\u0441\u043A\u0430\u0439 \u0438 \u0440\u0435\u0434\u043A\u043E.",
  "Fri": "\u042F \u0434\u0443\u043C\u0430\u044E, \u043C\u0435\u0441\u0442\u043D\u044B\u0435 \u0436\u0438\u0442\u0435\u043B\u0438 \u0431\u043E\u044F\u0442\u0441\u044F \u043C\u0435\u043D\u044F.#$e#\u041F\u0440\u0438\u0441\u043A\u043E\u0440\u0431\u043D\u043E... \u041D\u043E, \u043F\u043E\u043B\u0430\u0433\u0430\u044E, \u044D\u0442\u043E \u0432 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u043E\u0439 \u043F\u0440\u0438\u0440\u043E\u0434\u0435 \u2014 \u0431\u043E\u044F\u0442\u044C\u0441\u044F \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E.",
  "Fri6": "\u041A\u043E\u0433\u0434\u0430-\u0442\u043E \u0434\u0430\u0432\u043D\u043E \u044F \u0431\u044B\u043B \u0436\u0435\u043D\u0430\u0442. \u041F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u044F \u0440\u0430\u0441\u0441\u0442\u0430\u043B\u0441\u044F \u0441 \u0436\u0435\u043D\u043E\u0439, \u043E\u043D\u0430 \u043D\u0430\u0447\u0430\u043B\u0430 \u043B\u0435\u0442\u0430\u0442\u044C \u0432\u043E\u043A\u0440\u0443\u0433 \u0433\u043E\u0440\u043E\u0434\u0430 \u0438 \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0442\u044C \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0438\u044F \u043D\u0430 \u0432\u0441\u0435 \u043F\u043E\u0434\u0440\u044F\u0434.#$e#\u041D\u0435 \u0441\u0430\u043C\u044B\u0439 \u0437\u0440\u0435\u043B\u044B\u0439 \u0441\u043F\u043E\u0441\u043E\u0431 \u0441\u043E\u0432\u043B\u0430\u0434\u0430\u0442\u044C \u0441 \u0433\u043D\u0435\u0432\u043E\u043C.",
  "Sat": "\u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E. \u0421\u0435\u0439\u0447\u0430\u0441 \u0442\u044B \u0441\u0442\u043E\u0438\u0448\u044C \u043D\u0430\u0434 \u043C\u043E\u0433\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043F\u043E\u043B\u0435\u043C.#$e#\u042F \u0432\u0435\u0434\u044C \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0430\u043A \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043B \u0437\u0434\u0435\u0441\u044C \u0441\u0432\u043E\u0435 \u0436\u0438\u043B\u0438\u0449\u0435, \u0437\u043D\u0430\u0435\u0448\u044C \u043B\u0438.",
  "Sat2": "\u0415\u0441\u0442\u044C \u043A\u0430\u043A\u043E\u0439-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441 \u0441 \u043B\u0435\u0441\u043D\u044B\u043C\u0438 \u0434\u0443\u0445\u0430\u043C\u0438?",
  "Sun": "\u0418\u043D\u043E\u0433\u0434\u0430 \u044F \u0442\u0430\u0439\u043D\u043E \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u044E \u0437\u0430 \u043C\u0435\u0441\u0442\u043D\u044B\u043C\u0438 \u0436\u0438\u0442\u0435\u043B\u044F\u043C\u0438.#$e#\u042F \u043D\u0430\u0434\u0435\u044E\u0441\u044C \u043D\u0430\u0439\u0442\u0438 \u0441\u0435\u0431\u0435 \u0443\u0447\u0435\u043D\u0438\u043A\u0430. \u041A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u044F \u043F\u043E\u043A\u0438\u043D\u0443 \u043C\u0438\u0440 \u0441\u043C\u0435\u0440\u0442\u043D\u044B\u0445, \u043D\u043E \u043C\u043E\u0438 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0438\u0437\u044B\u0441\u043A\u0430\u043D\u0438\u044F \u0434\u043E\u043B\u0436\u043D\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C\u0441\u044F."
}