  "summer_Tue": "\uC548\uB155\uD558\uC2E0\uAC00, \uB0AF\uC120 \uC774.",
  "summer_Tue2": "\uC624, \uBBF8\uC2A4\uD130 @(\uC774)\uAD6C\uBA3C.^\uC624, \uBBF8\uC2A4 @(\uC774)\uAD6C\uBA3C.#$e#\uB0B4 \uB3C4\uC6C0\uC774 \uD544\uC694\uD55C \uAC70\uC57C?",
  "summer_Tue6": "\uB098\uB3C4 \uD55C\uB54C\uB294 \uB108\uCC98\uB7FC \uAFC8\uACFC \uD76C\uB9DD\uC774 \uC788\uC5C8\uC9C0... \uADFC\uB370 \uC9C0\uAE08\uC740 \uC774\uB807\uB2E4.$s#$e#\uC778\uC0DD\uC774 \uD56D\uC0C1 \uAE30\uB300\uD55C \uAC83\uCC98\uB7FC \uB418\uC9C4 \uC54A\uC544.#$e#\uBB50 \uC5B4\uCA4C\uACA0\uC5B4. \uAC00\uC9C0\uC9C0 \uBABB\uD55C \uAC83\uC5D0 \uC9D1\uCC29\uD558\uB294 \uAC83\uB3C4 \uC758\uBBF8\uAC00 \uC5C6\uC9C0.",
  "summer_Wed": "\uB3D9\uB124 \uC606\uC5D0 \uBC14\uB85C \uB18D\uC7A5\uC774 \uC788\uB294 \uAC74 \uCC38 \uC88B\uC740 \uC77C\uC774\uC57C.",
  "summer_Wed4": "\uB124 \uB18D\uC7A5\uC774 \uC815\uB9D0 \uC798\uB418\uBA74 \uC9C0\uC5ED \uACBD\uC81C\uB97C \uBD81\uB3CB\uC6B8 \uC218 \uC788\uACA0\uB2E4.#$e#\uADF8\uB7FC \uB2E4\uB4E4 \uC9C1\uC5C5\uC774 \uC0DD\uAE38 \uD14C\uACE0, \uC6B0\uB9AC \uBAA8\uB450 \uD589\uBCF5\uD574\uC9C0\uB294 \uAC70\uC9C0, \uB9DE\uC9C0?",
  "summer_Thu": "\uC624, \uC548\uB155\uD558\uC2E0\uAC00, \uB18D\uBD80 \uC591\uBC18.#$e#\uB09C \uC798 \uBAA8\uB974\uB294 \uC0AC\uB78C\uD558\uACE0 \uC218\uB2E4 \uB5A0\uB294 \uD3B8\uC774 \uC544\uB2C8\uB77C.",
  "summer_Thu4": "\uD56D\uC0C1 \uC5B4\uCA4C\uB2E4 \uBCF4\uBA74 \uC8FC\uC810\uC5D0 \uAC00\uAC8C \uB418\uB294 \uAC83 \uAC19\uB2E8 \uB9D0\uC774\uC9C0.#$e#\uC9D1\uC774\uB791 \uB108\uBB34 \uAC00\uAE4C\uC6CC. \uC774\uB7F0 \uC0C1\uD669\uC740 \uAC74\uAC15\uD558\uC9C0 \uBABB\uD574.",
  "summer_Fri": "...\uC751?#$e#\uC798\uC0DD\uAE34 \uC80A\uC740\uC774\uAD6C\uBA3C. \uC65C \uB098\uAC19\uC774 \uB299\uC740 \uC544\uC90C\uB9C8\uB791 \uB300\uD654\uD558\uB294\uB370 \uC2DC\uAC04\uC744 \uB0AD\uBE44\uD558\uB294 \uAC70\uC57C?^\uC774\uC058\uC7A5\uD55C \uC544\uAC00\uC528\uAD6C\uBA3C. \uC65C \uB098 \uAC19\uC740 \uC0AC\uB78C\uC774\uB791 \uB300\uD654\uD558\uB290\uB77C \uC2DC\uAC04\uC744 \uB0AD\uBE44\uD558\uB294 \uAC70\uC57C?",
  "summer_Sat2": "\uC9D1 \uC606\uC5D0 \uC788\uB294 \uB299\uC740 \uAC1C\uB294 \uC2E0\uACBD \uC4F0\uC9C0 \uB9C8.#$b#\uD654\uB09C \uD45C\uC815\uC73C\uB85C \uCCD0\uB2E4\uBCFC \uB54C\uB294 \uC788\uC9C0\uB9CC, \uBC31 \uB144\uC774 \uC9C0\uB098\uB3C4 \uADF8 \uBC15\uC2A4\uC5D0\uC11C \uB098\uC624\uC9C4 \uC54A\uC744 \uAC70\uC57C.#$b#\uC774\uB984\uC774 \uBB50\uB0D0\uACE0? \uB354\uC2A4\uD2F0.",
  "summer_Sat": "\uB204\uAC00 \uB0B4 \uC55E\uB730\uC5D0 \uBD88\uB9CC\uC774 \uC788\uC5C8\uB098 \uBD10... \uC5C9\uB9DD\uC774\uB77C\uACE0 \uD588\uB2E4\uB354\uB77C\uACE0. \uB108\uC600\uB0D0?$u#$e#\uD750\uC74C...",
  "fall_Tue": "\uB0B4\uAC00 \uB110 \uC880 \uC54C\uC558\uB2E4\uBA74, \uC598\uAE30\uB97C \uD560 \uC758\uD5A5\uC774 \uC788\uC744 \uC218\uB3C4 \uC788\uC9C0.",
  "fall_Tue4": "\uB098\uB3C4 \uD55C\uB54C\uB294 \uC80A\uC5C8\uB2E4. \uBBFF\uAE30 \uD798\uB4E4\uC9C0, \uC5B4?#$e#\uB098\uC774 \uB4E4\uACE0\uB098\uBA74 \uC2DC\uAC04\uC740 \uCC38 \uBE68\uB9AC \uC9C0\uB098\uAC00.$s",
  "fall_Wed": "*\uD55C\uC228*... \uC624\uB298 \uBC24\uC740 \uB0C9\uB3D9\uC2DD\uD488\uC774\uB098 \uC804\uC790\uB808\uC778\uC9C0\uC5D0 \uB3CC\uB824\uBA39\uC5B4\uC57C\uACA0\uB124.$s",
  "fall_Thu": "\uB098\uD55C\uD14C\uB294 \uD398\uB2C8\uBFD0\uC774\uC57C, \uB108\uB3C4 \uD398\uB2C8\uD55C\uD14C\uB294 \uC798\uD574\uC918\uC57C \uD574.",
  "fall_Fri": "\uB9E4\uC77C \uADF8\uB0E5 \uB611\uAC19\uC740 \uC77C\uC0C1\uC774 \uBC18\uBCF5\uC774\uC57C...$s#$e#\uB18D\uBD80, \uB108\uB3C4 \uADF8\uB7F0 \uAE30\uBD84 \uB4E4 \uB54C \uC788\uC5B4?",
  "fall_Sat": "\uD639\uC2DC \uC120\uD589\uC744 \uBCA0\uD480\uC5B4\uC11C \uB0B4 \uC9D1\uC548 \uC815\uB9AC \uC880 \uD574\uC904\uB798?#$e#\uB18D\uB2F4\uC774\uC57C.$h",
  "fall_Sun": "\uB108 \uC9C0\uAE08 \uD560 \uC77C\uC740 \uC5C6\uB0D0?#$e#\uB9C8\uC744\uC5D0 \uC885\uC77C \uCD95 \uB298\uC5B4\uC838\uC788\uC9C0 \uC54A\uACE0 \uC9C1\uC5C5\uC774 \uC788\uB2E4\uB294 \uC0AC\uC2E4\uC5D0 \uAC10\uC0AC\uD574\uC57C \uD574.",
  "fall_Sun4": "\uD2B8\uB7ED \uAE30\uC0AC \uC2DC\uC808\uC774 \uADF8\uB9AC\uC6CC, \uC628 \uACC4\uACE1\uC744 \uB204\uBE44\uBA70 \uC0AC\uB78C\uB4E4 \uB9CC\uB098\uACE0 \uB77C\uB514\uC624 \uB4E3\uACE0 \uADF8\uB7AC\uB294\uB370.#$e#\uC2DC\uAC04\uC774 \uB9CE\uC774 \uBCC0\uD588\uC9C0.",
  "winter_Mon": "\uB18D\uC7A5\uC5D0 \uB3FC\uC9C0\uB294 \uC880 \uC788\uC5B4?",
  "winter_Tue": "\uB098\uD55C\uD14C \uBB50 \uC6D0\uD558\uB294 \uAC70 \uC788\uB0D0, \uAF2C\uB9C8\uC57C? \uB2E4\uB978 \uB370\uC11C \uCC3E\uC544\uBD10.",
  "winter_Tue4": "\uD398\uB2C8\uAC00 \uC55E\uC73C\uB85C \uC0B4\uC544\uAC08 \uAE38\uC774 \uD3B8\uD588\uC73C\uBA74 \uC88B\uACA0\uC5B4. \uB124\uAC00 \uC5B8\uC820\uAC00 \uC544\uC774\uAC00 \uC0DD\uAE34\uB2E4\uBA74 \uB0B4\uAC00 \uC5B4\uB5A4 \uAE30\uBD84\uC778\uC9C0 \uC54C \uAC70\uC57C.#$e#...\uACA8\uC6B8 \uCC38 \uAC74\uC870\uD574. \uD53C\uBD80\uAC00 \uB9D0\uB9B0 \uC591\uD53C\uC9C0 \uAC19\uAD6C\uBA3C.",
  "winter_Tue4_inlaw_Penny": "\uB108 \uADF8 \uC624\uB798\uB41C \uB18D\uC7A5\uC5D0\uC11C \uD338\uD55C\uD14C \uC798\uD574\uC918\uC57C \uD574. \uB098\uD55C\uD14C\uB294 \uD338 \uD558\uB098\uBFD0\uC774\uB2E4!",
  "winter_Wed": "\uAF2C\uB9C8\uC57C. \uBB50 \uD558\uB0D0?#$e#\uB098\uC57C \uB9E8\uB0A0 \uADF8\uB807\uB4EF \uADF8\uB0E5 \uC2DC\uAC04 \uBCF4\uB0B4\uACE0 \uC788\uC9C0.",
  "winter_Thu": "\uC5C4\uCCAD \uCDA5\uB124. \uC8FC\uC810 \uAC00\uBA74 \uC880 \uB728\uB048\uD574\uC9C0\uACA0\uC9C0, \uC548 \uADF8\uB7EC\uB0D0? \uD5E4\uD5E4.#$e#\uB108\uB3C4 \uB098\uC911\uC5D0 \uC8FC\uC810 \uB4E4\uB7EC\uC11C \uD589\uBCF5 \uAC00\uB4DD\uD55C \uD55C\uC794\uD558\uACE0 \uAC00\uC9C0 \uADF8\uB798?",
  "winter_Fri": "\uD398\uB2C8\uB294 \uC624\uB798\uB41C \uCC45\uC744 \uCC38 \uC88B\uC544\uD55C\uB2E8 \uB9D0\uC774\uC9C0. \uD655\uC2E4\uD788 \uB098\uBCF4\uB2E8 \uBA38\uB9AC\uAC00 \uC88B\uC544.#$e#\uAE30\uC05C \uC77C\uC774\uC57C.",
  "winter_Sat": "\uAC15\uC774 \uBC14\uB85C \uC606\uC774\uB2C8, \uB09A\uC2DC\uB77C\uB3C4 \uBC30\uC6CC\uC57C \uD560\uAE4C \uBD10.",
  "winter_Sun": "\uC640... \uC55E\uB730\uC774 \uC815\uB9D0 \uB09C\uC7A5\uD310\uC774\uB124.$s"
}