{
  "Introduction": "\u041E\u0447\u0435\u043D\u044C \u043F\u0440\u0438\u044F\u0442\u043D\u043E \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u044C\u0441\u044F \u0441 \u0432\u0430\u043C\u0438. \u042F \u0425\u0430\u0440\u0432\u0438, \u043C\u0435\u0441\u0442\u043D\u044B\u0439 \u0432\u0440\u0430\u0447.#$e#\u042F \u043F\u0440\u043E\u0432\u043E\u0436\u0443 \u043C\u0435\u0434\u043E\u0441\u043C\u043E\u0442\u0440\u044B \u0438 \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u0438\u0435 \u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u044B \u0434\u043B\u044F \u0432\u0441\u0435\u0445 \u0436\u0438\u0442\u0435\u043B\u0435\u0439 \u0433\u043E\u0440\u043E\u0434\u0430 \u041F\u0435\u043B\u0438\u043A\u0430\u043D\u0430. \u041E\u0447\u0435\u043D\u044C \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430.#$e#\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u0438 \u0432\u0430\u0448\u0430 \u0440\u0430\u0431\u043E\u0442\u0430 \u043F\u0440\u0438\u043D\u0435\u0441\u0435\u0442 \u0432\u0430\u043C \u0442\u0430\u043A\u043E\u0435 \u0436\u0435 \u0443\u0434\u043E\u0432\u043B\u0435\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0435.$h",
  "AcceptBirthdayGift_Positive": "\u041E\u0439! \u0411\u043E\u043B\u044C\u0448\u043E\u0435 \u0441\u043F\u0430\u0441\u0438\u0431\u043E! \u042F \u0438 \u043D\u0435 \u0434\u0443\u043C\u0430\u043B, \u0447\u0442\u043E \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u043E\u043C\u043D\u0438\u0442, \u0447\u0442\u043E \u0443 \u043C\u0435\u043D\u044F \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0434\u0435\u043D\u044C \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F.$h",
  "AcceptBirthdayGift_Negative": "\u041E\u0439! \u042D\u0442\u043E... \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u043E. \u042F \u0438 \u043D\u0435 \u0434\u0443\u043C\u0430\u043B, \u0447\u0442\u043E \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u043E\u043C\u043D\u0438\u0442, \u0447\u0442\u043E \u0443 \u043C\u0435\u043D\u044F \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0434\u0435\u043D\u044C \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F.",
  "AcceptGift_(O)StardropTea": "\u042D\u0442\u043E \u043C\u043D\u0435? \u0411\u043E\u043B\u044C\u0448\u0430\u044F \u0447\u0435\u0441\u0442\u044C. \u0421\u043F\u0430\u0441\u0438\u0431\u043E!",
  "FlowerDance_Accept": "\u0410\u0445! \u0422\u044B... \u0445\u043E\u0447\u0435\u0448\u044C \u043F\u043E\u0442\u0430\u043D\u0446\u0435\u0432\u0430\u0442\u044C \u0441\u043E \u043C\u043D\u043E\u0439?$4#$b#...\u0414\u0430, \u044F \u0441\u043E\u0433\u043B\u0430\u0441\u0435\u043D!$h",
  "GreenRain": "\u042F \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u043B \u0430\u043F\u0442\u0435\u0447\u043A\u0443, \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0430 \u0441\u043B\u0443\u0447\u0430\u0439. \u0410\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E \u0442\u0430\u043C!",
  "GreenRain_2": "\u0412 \u043F\u0435\u0440\u0432\u044B\u0439 \u0440\u0430\u0437 \u043C\u044B \u0432\u0441\u0435 \u043F\u043E\u0434\u0443\u043C\u0430\u043B\u0438, \u0447\u0442\u043E \u0434\u043E\u0436\u0434\u044C \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u043E\u043F\u0430\u0441\u0435\u043D.#$b#\u041D\u043E \u0432\u0434\u0440\u0443\u0433 \u043E\u043D \u043D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435 \u043F\u043E\u043B\u0435\u0437\u0435\u043D \u0434\u043B\u044F \u0442\u0435\u043B\u0430? \u041A\u0442\u043E \u0437\u043D\u0430\u0435\u0442... \u0420\u0430\u0441\u0442\u0435\u043D\u0438\u044F \u0432\u043E\u043D \u043A\u0430\u043A \u0445\u043E\u0440\u043E\u0448\u043E \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u044E\u0442.",
  "AcceptGift_(O)432": "\u042D\u0442\u043E \u043C\u043D\u0435? \u0421\u043F\u0430\u0441\u0438\u0431\u043E! \u041F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E \u043F\u043E\u0439\u0434\u0435\u0442 \u043A\u0430\u043A \u043F\u043E\u0441\u044B\u043F\u043A\u0430 \u043D\u0430 \u043F\u0430\u0441\u0442\u0443.$h",
  "AcceptGift_(O)348": "\u041C\u043D\u0435? \u041F\u043E\u0434\u0430\u0440\u043E\u043A! \u041F\u0440\u043E\u0441\u0442\u043E \u043A\u0440\u044B\u0448\u0435\u0441\u043D\u043E\u0441\u043D\u043E!$h#$b#\u0417\u043D\u0430\u0435\u0448\u044C, \u044F \u0431\u044B \u043D\u0435 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u043E\u0432\u0430\u043B \u043F\u0438\u0442\u044C \u0430\u043B\u043A\u043E\u0433\u043E\u043B\u044C \u0441 \u0442\u043E\u0447\u043A\u0438 \u0437\u0440\u0435\u043D\u0438\u044F \u0444\u0438\u0437\u0438\u043E\u043B\u043E\u0433\u0438\u0438, \u0432\u0435\u0434\u044C \u043E\u043D \u043F\u043B\u043E\u0445\u043E \u0432\u043B\u0438\u044F\u0435\u0442 \u043D\u0430 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C...#$b#\u041D\u043E \u0432\u0441\u0435 \u0436\u0435 \u043D\u0435\u0442 \u043D\u0438\u0447\u0435\u0433\u043E \u043B\u0443\u0447\u0448\u0435, \u0447\u0435\u043C \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u0438\u0442\u044C\u0441\u044F \u0438 \u0432\u044B\u043F\u0438\u0442\u044C \u0431\u043E\u043A\u0430\u043B\u044C\u0447\u0438\u043A \u0441\u043B\u0430\u0432\u043D\u043E\u0433\u043E \u0432\u0438\u043D\u0430 \u0438\u0437 \u0414\u043E\u043B\u0438\u043D\u044B \u0421\u0442\u0430\u0440\u0434\u044C\u044E!$h",
  "eventSeen_56_memory_fourweeks": "\u042F \u0440\u0430\u0431\u043E\u0442\u0430\u044E \u043D\u0430\u0434 \u00AB\u0421\u043F\u0440\u0430\u0432\u043E\u0447\u043D\u0438\u043A\u043E\u043C \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445\u00BB \u0443\u0436\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043B\u0435\u0442. \u042F \u0445\u043E\u0447\u0443 \u043E\u043F\u0438\u0441\u0430\u0442\u044C \u043A\u0430\u0436\u0434\u044B\u0439 \u0432\u0438\u0434 \u0432 \u0414\u043E\u043B\u0438\u043D\u0435!",
  "eventSeen_56_memory_twoweeks": "\u041E\u0434\u043D\u0430\u0436\u0434\u044B \u044F \u043F\u044B\u0442\u0430\u043B\u0441\u044F \u0441\u0430\u043C \u0437\u0430\u043C\u0430\u0440\u0438\u043D\u043E\u0432\u0430\u0442\u044C \u043E\u0433\u0443\u0440\u0446\u044B...$s#$e#\u042D\u043C, \u0442\u0430\u043A \u0441\u043A\u0430\u0436\u0443... \u041B\u044F\u0433\u0443\u0448\u043A\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043C\u044B \u043F\u0440\u0435\u043F\u0430\u0440\u0438\u0440\u043E\u0432\u0430\u043B\u0438 \u0432 \u0441\u0440\u0435\u0434\u043D\u0435\u0439 \u0448\u043A\u043E\u043B\u0435, \u043F\u0430\u0445\u043B\u0438 \u043A\u0430\u043A \u0440\u043E\u0437\u044B \u043F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u044D\u0442\u0438\u043C...",
  "eventSeen_56": "\u0420\u0430\u0431\u043E\u0442\u0430\u044F \u0434\u043E\u043A\u0442\u043E\u0440\u043E\u043C \u0432 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u043C \u0433\u043E\u0440\u043E\u0434\u043A\u0435, \u0442\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435 \u043C\u043E\u0436\u0435\u0448\u044C \u043D\u0435 \u043D\u0430\u0447\u0430\u0442\u044C \u043E\u0431\u0449\u0430\u0442\u044C\u0441\u044F \u0441 \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u0430\u043C\u0438. \u0423 \u044D\u0442\u043E\u0433\u043E \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C \u043A\u0430\u043A \u0445\u043E\u0440\u043E\u0448\u0438\u0435, \u0442\u0430\u043A \u0438 \u043F\u043B\u043E\u0445\u0438\u0435 \u0441\u0442\u043E\u0440\u043E\u043D\u044B...",
  "eventSeen_58_memory_oneweek": "\u0427\u0442\u043E \u0436, \u0442\u044B \u0442\u0435\u043F\u0435\u0440\u044C \u0437\u043D\u0430\u0435\u0448\u044C \u043C\u043E\u0439 \u0441\u0435\u043A\u0440\u0435\u0442, \u0442\u0430\u043A \u0447\u0442\u043E \u043C\u043E\u0436\u043D\u043E \u0441\u043E\u043E\u0431\u0449\u0438\u0442\u044C \u043E \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441\u0435... \u041D\u0430 \u043F\u0440\u043E\u0448\u043B\u043E\u0439 \u043D\u0435\u0434\u0435\u043B\u0435 \u044F \u0437\u0430\u043F\u044B\u0445\u0430\u043B\u0441\u044F \u043D\u0430\u043C\u043D\u043E\u0433\u043E \u043C\u0435\u043D\u044C\u0448\u0435 \u043D\u0430 \u0430\u044D\u0440\u043E\u0431\u0438\u043A\u0435!",
  "eventSeen_58_memory_twoweeks": "\u042F \u0445\u043E\u0440\u043E\u0448\u043E \u043F\u043E\u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0441\u044F \u043D\u0430 \u0430\u044D\u0440\u043E\u0431\u0438\u043A\u0435, \u0442\u0430\u043A \u0447\u0442\u043E \u0432\u043F\u043E\u043B\u043D\u0435 \u043C\u043E\u0433\u0443 \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u044C \u0441\u0435\u0431\u0435 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u0430\u0441\u0442\u044B \u043F\u0440\u0438\u043C\u0430\u0432\u0435\u0440\u044B \u043D\u0430 \u0443\u0436\u0438\u043D...$h",
  "eventSeen_58_memory_fourweeks": "\u041D\u0435 \u0437\u043D\u0430\u044E, \u043F\u043E\u0447\u0435\u043C\u0443 \u044F \u0441\u0442\u044B\u0434\u0438\u043B\u0441\u044F \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u0445\u043E\u0436\u0443 \u043D\u0430 \u0442\u0430\u043D\u0446\u0435\u0432\u0430\u043B\u044C\u043D\u0443\u044E \u0430\u044D\u0440\u043E\u0431\u0438\u043A\u0443. \u041C\u043E\u0438 \u043D\u043E\u0433\u0438 \u0441\u0442\u0430\u043B\u0438 \u0442\u0430\u043A\u0438\u043C\u0438 \u043A\u0440\u0435\u043F\u043A\u0438\u043C\u0438, \u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E \u0441\u0435\u0431\u044F \u0441\u043C\u0435\u043B\u044B\u043C, \u043A\u0430\u043A \u043B\u0435\u0432!",
  "eventSeen_571102_memory": "\u042F \u043D\u0438\u043A\u043E\u043C\u0443 \u0434\u043E \u044D\u0442\u043E\u0433\u043E \u043D\u0435 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B \u043E \u0441\u0432\u043E\u0435\u043C \u0441\u0430\u043C\u043E\u043B\u0435\u0442\u043D\u043E\u043C \u0445\u043E\u0431\u0431\u0438... \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u0441 \u0442\u043E\u0431\u043E\u0439 \u043C\u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u043E.",
  "eventSeen_571102_memory_oneweek": "\u041A\u0430\u043A \u0432\u0440\u0430\u0447, \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u043C\u043E\u0447\u044C \u0441\u0432\u043E\u0438\u043C \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u0430\u043C \u043B\u0438\u0448\u044C \u0434\u043E \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u043E\u0439 \u0441\u0442\u0435\u043F\u0435\u043D\u0438...#$e#\u0412 \u043F\u0440\u043E\u0448\u043B\u043E\u043C \u044F \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u043B \u043E\u0448\u0438\u0431\u043A\u0443, \u0431\u0443\u0434\u0443\u0447\u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0432\u043E\u0432\u043B\u0435\u0447\u0435\u043D\u043D\u044B\u043C \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E. \u0411\u043E\u043B\u044C\u0448\u0435 \u044F \u0442\u0430\u043A\u043E\u0433\u043E \u043D\u0435 \u0434\u043E\u043F\u0443\u0449\u0443...$s",
  "dating_Harvey": "\u041D\u0438\u043A\u043E\u0433\u0434\u0430 \u0442\u0430\u043A \u0440\u0430\u043D\u044C\u0448\u0435 \u0441\u0435\u0431\u044F \u043D\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B...$l",
  "dating_Harvey_memory_oneday": "\u042F \u0442\u0430\u043A \u043C\u043D\u043E\u0433\u043E \u043E \u0442\u0435\u0431\u0435 \u0434\u0443\u043C\u0430\u044E, \u0447\u0442\u043E \u043F\u043E\u0447\u0442\u0438 \u043D\u0435 \u043C\u043E\u0433\u0443 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C.$l",
  "dating_Maru_memory_oneday": "\u041C\u0430\u0440\u0443 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043A\u0430\u043A\u0430\u044F-\u0442\u043E \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0432\u0435\u0441\u0435\u043B\u0430\u044F... \u0421\u043B\u044B\u0448\u0430\u043B, \u0447\u0442\u043E \u0442\u044B \u0438\u043C\u0435\u0435\u0448\u044C \u043A \u044D\u0442\u043E\u043C\u0443 \u043A\u0430\u043A\u043E\u0435-\u0442\u043E \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0435.",
  "married_Maru": "\u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u044E \u0441\u043E \u0441\u0432\u0430\u0434\u044C\u0431\u043E\u0439, @. \u041C\u0430\u0440\u0443 \u0443\u0436\u0435 \u0441\u043A\u0430\u0437\u0430\u043B\u0430 \u043C\u043D\u0435, \u0447\u0442\u043E \u043E\u043D\u0430 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0432 \u043A\u043B\u0438\u043D\u0438\u043A\u0435. \u042F \u0430\u0436 \u0432\u044B\u0434\u043E\u0445\u043D\u0443\u043B!",
  "married_Harvey": "\u042D\u0442\u043E \u0441\u0430\u043C\u044B\u0439 \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u044B\u0439 \u043C\u043E\u043C\u0435\u043D\u0442 \u0432 \u043C\u043E\u0435\u0439 \u0436\u0438\u0437\u043D\u0438...$l",
  "Resort_Entering": "\u041A\u0440\u0435\u043C \u043E\u0442 \u0437\u0430\u0433\u0430\u0440\u0430? \u0412\u0437\u044F\u043B...#$b#\u0428\u0438\u0440\u043E\u043A\u043E\u043F\u043E\u043B\u0430\u044F \u0448\u043B\u044F\u043F\u0430? \u0412\u0437\u044F\u043B...",
  "Resort_Leaving": "\u0415\u0441\u043B\u0438 \u0441\u0433\u043E\u0440\u0438\u0448\u044C \u043D\u0430 \u0441\u043E\u043B\u043D\u0446\u0435, \u0442\u0432\u043E\u0438 \u0441\u0442\u0440\u0430\u0434\u0430\u043D\u0438\u044F \u0441\u043C\u044F\u0433\u0447\u0438\u0442 \u043A\u0440\u0435\u043C \u0441 \u0430\u043B\u043E\u044D \u0432\u0435\u0440\u0430.",
  "Resort_Shore": "\u042F \u043F\u0440\u043E\u0447\u0435\u0441\u0430\u043B \u0432\u0435\u0441\u044C \u043F\u043B\u044F\u0436 \u043D\u0430 \u043D\u0430\u043B\u0438\u0447\u0438\u0435 \u043E\u0441\u043A\u043E\u043B\u043A\u043E\u0432. \u041C\u044B \u0436\u0435 \u043D\u0435 \u0445\u043E\u0442\u0438\u043C, \u0447\u0442\u043E\u0431\u044B \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u043E\u0440\u0435\u0437\u0430\u043B\u0441\u044F!",
  "Resort_Chair": "\u0418\u043D\u043E\u0433\u0434\u0430 \u0445\u043E\u0440\u043E\u0448\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0432\u043E\u0442 \u0442\u0430\u043A \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C.#$b#\u0413\u043B\u0430\u0432\u043D\u0430\u044F \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430 \u0432 \u0442\u043E\u043C, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u043D\u0430 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u0432\u0441\u0435 \u0441\u0432\u043E\u0438 \u0437\u0430\u0431\u043E\u0442\u044B...$s",
  "Resort_Bar": "\u0412 \u0442\u0430\u043A\u0443\u044E \u0436\u0430\u0440\u0443 \u043E\u0447\u0435\u043D\u044C \u0432\u0430\u0436\u043D\u043E \u043F\u0438\u0442\u044C \u043C\u043D\u043E\u0433\u043E \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u0438. \u041D\u0443\u0436\u043D\u043E \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0413\u0430\u0441\u0430, \u0435\u0441\u0442\u044C \u043B\u0438 \u0443 \u043D\u0435\u0433\u043E \u0442\u0443\u0442 \u043A\u043E\u043A\u043E\u0441\u043E\u0432\u0430\u044F \u0432\u043E\u0434\u0430!$h",
  "Resort": "\u042F \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443 \u0442\u0435\u0431\u0435 \u043E\u0434\u0438\u043D \u0441\u0432\u043E\u0439 \u0441\u0435\u043A\u0440\u0435\u0442... \u042F \u043C\u043E\u0433\u0443 \u043F\u043B\u0430\u0432\u0430\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u0441 \u043D\u0430\u0440\u0443\u043A\u0430\u0432\u043D\u0438\u0447\u043A\u0430\u043C\u0438.$s",
  "FlowerDance_Accept_Spouse": "\u042F \u0432\u0435\u0441\u044C \u0434\u0435\u043D\u044C \u044D\u0442\u043E\u0433\u043E \u0436\u0434\u0443! \u0422\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0432\u0435\u0442\u0438\u0448\u044C\u0441\u044F \u044D\u0442\u0438\u043C \u0432\u0435\u0441\u0435\u043D\u043D\u0438\u043C \u0434\u043D\u0435\u043C, \u043B\u044E\u0431\u043E\u0432\u044C \u043C\u043E\u044F.$l",
  "FlowerDance_Decline": "\u0410! \u041F\u0440\u043E\u0441\u0442\u0438... \u0423 \u043C\u0435\u043D\u044F, \u044D-\u044D... \u041F\u043B\u0430\u043D\u044B \u043F\u0440\u0438\u0433\u043B\u0430\u0441\u0438\u0442\u044C \u0434\u0440\u0443\u0433\u0443\u044E.$s",
  "divorced": "\u042F... \u042F \u043D\u0435 \u043C\u043E\u0433\u0443 \u043D\u0430 \u0442\u0435\u0431\u044F \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C. \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0445\u0432\u0430\u0442\u0438\u0442 \u043C\u0435\u043D\u044F \u043C\u0443\u0447\u0430\u0442\u044C.$s",
  "breakUp": "... \u0422... \u0422\u044B...?$s#$b#*\u0441\u0433\u043B\u0430\u0442\u044B\u0432\u0430\u0435\u0442*... \u041C\u043D\u0435... \u041C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0447\u0442\u043E \u043C\u043D\u0435 \u0441\u0435\u0439\u0447\u0430\u0441 \u043F\u043E\u043F\u043B\u043E\u0445\u0435\u0435\u0442...$s",
  "dumped_Guys": "\u0423 \u043C\u0435\u043D\u044F \u043F\u043E\u043B\u043D\u043E \u0440\u0430\u0431\u043E\u0442\u044B. \u041D\u0435 \u043C\u043E\u0433\u0443 \u0440\u0430\u0437\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044C.$s",
  "secondChance_Guys": "\u042F \u043D\u0435 \u0445\u043E\u0447\u0443 \u0440\u0430\u0437\u0440\u044B\u0432\u0430\u0442\u044C \u0441 \u0442\u043E\u0431\u043E\u0439 \u0432\u0441\u044F\u043A\u0438\u0435 \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F, @. \u0425\u043E\u0447\u0443 \u0437\u0430\u0431\u044B\u0442\u044C \u0432\u0441\u0451, \u0447\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C.$s",
  "Mon": "\u0423 \u043D\u0430\u0441 \u0432 \u043A\u043B\u0438\u043D\u0438\u043A\u0435 \u043F\u0440\u043E\u0434\u0430\u044E\u0442\u0441\u044F \u043A\u043E\u0435-\u043A\u0430\u043A\u0438\u0435 \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u044B \u0431\u0435\u0437 \u0440\u0435\u0446\u0435\u043F\u0442\u0430. \u0417\u0430\u0445\u043E\u0434\u0438, \u0435\u0441\u043B\u0438 \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044C, \u0447\u0442\u043E \u0441\u0438\u043B\u044B \u043D\u0430 \u0438\u0441\u0445\u043E\u0434\u0435.#$b#\u042F \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u0430 \u043D\u0430 \u0444\u0435\u0440\u043C\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043C\u043D\u043E\u0433\u043E \u0441\u0438\u043B... \u041D\u0435 \u043F\u0435\u0440\u0435\u0442\u0440\u0443\u0434\u0438\u0441\u044C!",
  "Mon2": "\u042F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E, \u0447\u0442\u043E \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u0435\u043D \u0437\u0430 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0432 \u044D\u0442\u043E\u043C \u0433\u043E\u0440\u043E\u0434\u0435... \u042D\u0442\u043E \u0442\u044F\u0436\u0435\u043B\u043E.#$e#\u0421\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u043E \u0443 \u043D\u0430\u0441 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0435, \u0438 \u044F \u0440\u0430\u0434, \u0447\u0442\u043E \u043C\u043E\u0433\u0443 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C \u0441 \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u0430\u043C\u0438 \u0445\u043E\u0440\u043E\u0448\u0438\u0435 \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F.",
  "Mon6": "\u041C\u043D\u0435 \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C \u0431\u044B \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u0432 \u0434\u043E\u043B\u0438\u043D\u0435 \u0421\u0442\u0430\u0440\u0434\u044C\u044E \u043F\u043E\u0434\u043E\u043B\u044C\u0448\u0435. \u041D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E \u044F \u043D\u0430\u0447\u0438\u043D\u0430\u044E \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C \u0441\u0435\u0431\u044F \u0447\u0430\u0441\u0442\u044C\u044E \u0441\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430.#$e#\u041F\u0440\u0438\u044F\u0442\u043D\u043E \u0437\u043D\u0430\u0442\u044C, \u0447\u0442\u043E \u0442\u044B \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0448\u044C \u043F\u043E\u043B\u044C\u0437\u0443.",
  "Mon10": "\u0410! \u041F\u0440\u0438\u0432\u0435\u0442, @.$l#$e#\u0423 \u0442\u0435\u0431\u044F... \u0435\u0441\u0442\u044C \u043A\u0430\u043A\u0438\u0435-\u0442\u043E \u0432\u043E\u043F\u0440\u043E\u0441\u044B \u043F\u043E \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u043E\u0439 \u0447\u0430\u0441\u0442\u0438?$l",
  "Tue": "\u0415\u0441\u043B\u0438 \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044C \u0441\u0435\u0431\u044F \u043D\u0435\u0432\u0430\u0436\u043D\u043E, \u0437\u0430\u0445\u043E\u0434\u0438.#$e#\u041F\u0440\u0430\u0432\u0434\u0430, \u0442\u044B \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0430 \u043F\u0438\u043A\u0435 \u043C\u043E\u043B\u043E\u0434\u043E\u0441\u0442\u0438. \u0414\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u043D\u0435 \u0431\u0443\u0434\u0435\u0448\u044C \u0441\u043B\u0435\u0434\u0438\u0442\u044C \u0437\u0430 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435\u043C, \u0442\u043E, \u0441\u043A\u043E\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043E, \u043D\u0435 \u0437\u0430\u0431\u043E\u043B\u0435\u0435\u0448\u044C.$h",
  "Tue8": "$query PLAYER_NPC_RELATIONSHIP current any married roommate#\u041D\u0435 \u043F\u0435\u0440\u0435\u0442\u0440\u0443\u0434\u0438\u0441\u044C, @. \u042D\u0442\u043E \u0442\u0435\u0431\u0435 \u0432\u0440\u0430\u0447 \u0433\u043E\u0432\u043E\u0440\u0438\u0442!#$e#\u0415\u0441\u043B\u0438 \u043D\u0430\u0448\u0438 \u0444\u0435\u0440\u043C\u0435\u0440\u044B \u043D\u0430\u0447\u043D\u0443\u0442 \u0431\u043E\u043B\u0435\u0442\u044C, \u0442\u043E \u043E\u0442\u043A\u0443\u0434\u0430 \u043D\u0430\u043C \u0442\u043E\u0433\u0434\u0430 \u0431\u0440\u0430\u0442\u044C \u0435\u0434\u0443? \u0411\u0435\u0437 \u0442\u0435\u0431\u044F \u043D\u0438\u043A\u0430\u043A!$h|\u041D\u0435 \u043F\u0435\u0440\u0435\u0442\u0440\u0443\u0434\u0438\u0441\u044C, @. \u042D\u0442\u043E \u0442\u0435\u0431\u0435 \u0432\u0440\u0430\u0447 \u0433\u043E\u0432\u043E\u0440\u0438\u0442!#$e#\u041C\u043D\u0435 \u0432\u0430\u0436\u043D\u043E \u0442\u0432\u043E\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435.$l",
  "Wed4": "\u042F \u0431\u044B \u0445\u043E\u0442\u0435\u043B \u0443\u0437\u043D\u0430\u0442\u044C \u0442\u0435\u0431\u044F \u043F\u043E\u043B\u0443\u0447\u0448\u0435, @. \u0417\u0430\u0431\u0443\u0434\u0435\u043C \u043F\u043E\u043A\u0430 \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u044F \u0432\u0440\u0430\u0447, \u0430 \u0442\u044B \u2014 \u043F\u0430\u0446\u0438\u0435\u043D\u0442.",
  "Wed6": "\u041F\u0440\u0438\u044F\u0442\u043D\u043E, \u043A\u043E\u0433\u0434\u0430 \u0443 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C \u0434\u0440\u0443\u0433 \u0432 \u0433\u043E\u0440\u043E\u0434\u0435.$h",
  "Wed8": "\u0422\u044B \u043F\u0440\u044F\u043C\u043E \u0441\u0432\u0435\u0442\u0438\u0448\u044C\u0441\u044F \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435\u043C. \u042D\u0442\u043E \u0445\u043E\u0440\u043E\u0448\u043E.$h",
  "Wed": "\u041D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439 \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u0442\u044C \u0440\u043E\u0442 \u0440\u0443\u043A\u043E\u0439, \u043A\u043E\u0433\u0434\u0430 \u0447\u0438\u0445\u0430\u0435\u0448\u044C.#$e#\u0410 \u043F\u043E\u0442\u043E\u043C \u043D\u0435 \u0437\u0430\u0431\u0443\u0434\u044C \u0432\u044B\u043C\u044B\u0442\u044C \u0440\u0443\u043A\u0438.",
  "Thu8": "$query PLAYER_NPC_RELATIONSHIP current any married roommate#\u041C\u043D\u0435, \u043A\u0430\u043A \u0432\u0440\u0430\u0447\u0443, \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B \u0432\u0441\u0435 \u043F\u043B\u044E\u0441\u044B \u0434\u043E\u043C\u0430\u0448\u043D\u0438\u0445 \u043E\u0431\u0435\u0434\u043E\u0432. \u041D\u043E \u044F \u0432\u0435\u0447\u043D\u043E \u0442\u0430\u043A \u0437\u0430\u043D\u044F\u0442, \u0447\u0442\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043D\u0430 \u0433\u043E\u0442\u043E\u0432\u043A\u0443 \u043D\u0435 \u043E\u0441\u0442\u0430\u0435\u0442\u0441\u044F.$s|\u0423 \u0432\u0440\u0430\u0447\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u043C\u043D\u043E\u0433\u043E \u0440\u0430\u0431\u043E\u0442\u044B. \u042F \u043F\u0438\u0442\u0430\u044E\u0441\u044C \u043D\u0435 \u0442\u0430\u043A\u043E\u0439 \u0437\u0434\u043E\u0440\u043E\u0432\u043E\u0439 \u043F\u0438\u0449\u0435\u0439, \u043A\u0430\u043A \u043C\u043D\u0435 \u0431\u044B \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B\u043E.$s#$e#\u041C\u043D\u0435 \u0431\u044B\u043B\u043E \u0431\u044B \u043F\u0440\u043E\u0449\u0435, \u0435\u0441\u043B\u0438 \u0431\u044B \u044F \u0436\u0438\u043B \u043D\u0435 \u043E\u0434\u0438\u043D.$l",
  "Thu": "\u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043E\u0447\u0435\u043D\u044C \u0432\u0430\u0436\u043D\u043E, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439 \u043F\u0438\u0442\u0430\u0442\u044C\u0441\u044F \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E. \u041F\u043E\u0441\u0442\u0430\u0440\u0430\u0439\u0441\u044F \u0435\u0441\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435 \u043E\u0432\u043E\u0449\u0435\u0439!#$e#\u0414\u043E\u043C\u0430\u0448\u043D\u044F\u044F \u043F\u0438\u0449\u0430 \u043B\u0443\u0447\u0448\u0435 \u0432\u0441\u0435\u0433\u043E. \u0422\u044B \u0443\u043C\u0435\u0435\u0448\u044C \u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C?",
  "Fri": "\u041F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u0434\u0435\u043D\u044C, \u043D\u0435 \u043F\u0440\u0430\u0432\u0434\u0430 \u043B\u0438?#$e#\u0425\u043E\u0442\u0435\u043B\u043E\u0441\u044C \u0431\u044B \u043C\u043D\u0435, \u0447\u0442\u043E\u0431\u044B \u0443 \u043C\u0435\u043D\u044F \u0431\u044B\u043B\u043E \u043C\u0435\u043D\u044C\u0448\u0435 \u0440\u0430\u0431\u043E\u0442\u044B.$s",
  "Fri4": "\u0415\u0441\u043B\u0438 \u0436\u0435\u043B\u0430\u0435\u0448\u044C \u0437\u0430\u0433\u043B\u044F\u043D\u0443\u0442\u044C \u0432 \u043C\u043E\u0438 \u0430\u043F\u0430\u0440\u0442\u0430\u043C\u0435\u043D\u0442\u044B, \u044F \u043D\u0435 \u043F\u0440\u043E\u0442\u0438\u0432. \u042F \u0436\u0438\u0432\u0443 \u043D\u0430\u0434 \u043A\u043B\u0438\u043D\u0438\u043A\u043E\u0439.",
  "Fri10": "\u0417\u0430\u0445\u043E\u0434\u0438, \u0435\u0441\u043B\u0438 \u043D\u0443\u0436\u0435\u043D \u0431\u0443\u0434\u0435\u0442 \u0430\u043D\u043E\u043D\u0438\u043C\u043D\u044B\u0439 \u043E\u0441\u043C\u043E\u0442\u0440.$l",
  "Sat": "\u042F \u043C\u043E\u0433\u0443 \u0447\u0435\u043C-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u043E\u043C\u043E\u0447\u044C?#$e#\u041F\u043E\u043A\u0430.",
  "Sat4": "\u042F \u043F\u0440\u0438\u0435\u0445\u0430\u043B \u0441\u044E\u0434\u0430, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043C\u043D\u0435 \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0430 \u0433\u043E\u0440\u043E\u0434\u043A\u0430. \u0410 \u0435\u0449\u0435 \u0437\u0434\u0435\u0441\u044C \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B \u043A\u043E \u0432\u0441\u0435\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0435\u043C\u0443 \u043F\u043E\u0434\u0445\u043E\u0434\u0443 \u043A \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u0430\u043C.#$e#\u041C\u043D\u0435 \u0437\u0434\u0435\u0441\u044C \u043E\u0447\u0435\u043D\u044C \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F.$h",
  "Sat10": "*\u0412\u0437\u0434\u044B\u0445\u0430\u0435\u0442*... \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u044F \u0441\u0442\u0430\u0440\u0435\u044E...#$e#\u0427\u0435\u043C \u0441\u0442\u0430\u0440\u0448\u0435 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0448\u044C\u0441\u044F, \u0442\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u0442\u044F\u0436\u043A\u0438\u0445 \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0439 \u043D\u0430\u043A\u0430\u043F\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F. \u041F\u043E\u0440\u043E\u0439 \u0441 \u043D\u0438\u043C\u0438 \u0442\u0440\u0443\u0434\u043D\u043E \u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F.$s#$e#\u0410 \u0440\u044F\u0434\u043E\u043C \u0441 \u0442\u043E\u0431\u043E\u0439, \u044F \u0431\u0443\u0434\u0442\u043E \u0438 \u0441\u0430\u043C \u043C\u043E\u043B\u043E\u0434\u0435\u044E.$l",
  "Sun": "\u0425\u043C-\u043C... \u042F \u0435\u0434\u0432\u0430 \u0441\u0432\u043E\u0436\u0443 \u043A\u043E\u043D\u0446\u044B \u0441 \u043A\u043E\u043D\u0446\u0430\u043C\u0438. \u0421\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u0430\u043B\u043E \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u043E\u0432.#$e#\u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u043D\u0443\u0436\u043D\u043E \u043D\u0430\u0431\u0438\u0440\u0430\u0442\u044C \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u043E\u0432 \u0438\u0437 \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0445 \u0433\u043E\u0440\u043E\u0434\u043E\u0432...",
  "Sun6": "\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044C, \u0447\u0442\u043E \u0436\u0438\u0437\u043D\u044C \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u0430 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0432 \u0442\u0432\u043E\u0438\u0445 \u0440\u0443\u043A\u0430\u0445, \u0430 \u0442\u0435\u0431\u0435 \u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0435\u0435 \u0443\u0434\u0435\u0440\u0436\u0430\u0442\u044C... \u042D\u0442\u043E \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F \u0441 \u0442\u043E\u0431\u043E\u0439 \u043D\u0430 \u0432\u0441\u044E \u0436\u0438\u0437\u043D\u044C.$s",
  "event_george1": "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, @.$h#$b#\u0412\u0438\u0434\u0438\u0442\u0435, \u0414\u0436\u043E\u0440\u0434\u0436, \u044F \u043F\u0440\u043E\u0441\u0442\u043E \u0445\u043E\u0447\u0443 \u0432\u0430\u043C \u043F\u043E\u043C\u043E\u0447\u044C.",
  "event_george2": "\u041E\u0445...$s#$b#\u041F\u043E\u0441\u043B\u0443\u0448\u0430\u0439\u0442\u0435, \u0414\u0436\u043E\u0440\u0434\u0436. \u0415\u0441\u043B\u0438 \u0432\u044B \u0431\u0443\u0434\u0435\u0442\u0435 \u0442\u0430\u043A \u0441\u0435\u0431\u044F \u0432\u0435\u0441\u0442\u0438, \u043C\u043D\u0435 \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C \u043E\u0431 \u044D\u0442\u043E\u043C \u0432\u0430\u0448\u0435\u0439 \u0436\u0435\u043D\u0435. \u041D\u0435 \u0434\u0443\u043C\u0430\u044E, \u0447\u0442\u043E \u043E\u043D\u0430 \u043E\u0431\u0440\u0430\u0434\u0443\u0435\u0442\u0441\u044F.",
  "event_aerobics1": "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, @. \u042F \u044D\u0442\u043E \u0446\u0435\u043D\u044E.$h",
  "event_aerobics2": "\u042D\u0445... \u041A\u0430\u043A \u0433\u0440\u0443\u0431\u043E.$s",
  "event_heart1": "\u0411\u043E\u0438\u0448\u044C\u0441\u044F \u0431\u043E\u043B\u044C\u043D\u0438\u0446 \u0438 \u0432\u0440\u0430\u0447\u0435\u0439?#$b#\u041F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u0439\u0441\u044F \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u0438\u0442\u044C\u0441\u044F. \u042F \u0442\u043E\u043B\u044C\u043A\u043E \u0445\u043E\u0447\u0443 \u043F\u043E\u043C\u043E\u0447\u044C.$h",
  "event_heart2": "\u041B\u0430\u0434\u043D\u043E. \u042D\u0442\u043E \u043B\u043E\u0433\u0438\u0447\u043D\u043E.",
  "event_heart3": "\u042D-\u044D... \u041B\u0430\u0434\u043D\u043E... \u041A\u0430\u043A \u0441\u043A\u0430\u0436\u0435\u0448\u044C.$s",
  "event_grave1": "... \u0412\u0435\u0440\u043D\u043E.#$b#... \u0421\u043F\u0430\u0441\u0438\u0431\u043E.",
  "event_grave2": "\u042D\u0445...$s",
  "summer_Mon": "\u041D\u0435\u043C\u043D\u043E\u0433\u043E \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u043E\u0433\u043E \u0441\u0432\u0435\u0442\u0430 \u0442\u0435\u0431\u0435 \u043D\u0435 \u043F\u043E\u0432\u0440\u0435\u0434\u0438\u0442. \u0422\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u0439\u0441\u044F \u043D\u0435 \u043E\u0431\u0433\u043E\u0440\u0435\u0442\u044C#$e#\u041B\u0430\u0434\u043D\u043E. \u041F\u043E\u043A\u0430! \u0411\u0435\u0440\u0435\u0433\u0438 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435.",
  "summer_Thu": "\u0424\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0443\u043F\u0440\u0430\u0436\u043D\u0435\u043D\u0438\u044F \u0432\u0430\u0436\u043D\u044B, \u043D\u043E \u043D\u0435 \u043F\u0435\u0440\u0435\u0442\u0440\u0443\u0434\u0438\u0441\u044C, \u0430 \u0442\u043E \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0448\u044C \u0443 \u043C\u0435\u043D\u044F \u0432 \u043A\u043B\u0438\u043D\u0438\u043A\u0435!#$e#\u041D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439 \u043F\u0440\u0438\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u0442\u044C\u0441\u044F \u043A \u0441\u0432\u043E\u0435\u043C\u0443 \u0442\u0435\u043B\u0443.",
  "summer_Fri": "\u041B\u044E\u0434\u0438 \u0440\u0435\u0434\u043A\u043E \u0431\u043E\u043B\u0435\u044E\u0442 \u043B\u0435\u0442\u043E\u043C. \u042D\u0442\u043E \u0445\u043E\u0440\u043E\u0448\u043E, \u043D\u043E \u0438 \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E \u044F \u043E\u0442 \u044D\u0442\u043E\u0433\u043E \u043C\u0435\u043D\u044C\u0448\u0435.",
  "fall_Fri": "\u0422\u044B \u0438\u0441\u0441\u043B\u0435\u0434\u0443\u0435\u0448\u044C \u0448\u0430\u0445\u0442\u0443, @?#$e#\u041E\u043F\u0430\u0441\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E. \u042F \u0431\u044B \u043D\u0435 \u0441\u043E\u0432\u0435\u0442\u043E\u0432\u0430\u043B \u0442\u0443\u0434\u0430 \u0445\u043E\u0434\u0438\u0442\u044C.",
  "fall_Sat": "\u041E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u0430\u044F \u0435\u0434\u0430 \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u0442\u0435\u0431\u0435 \u0432 \u0440\u0430\u0431\u043E\u0442\u0435.#$e#\u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u00AB\u041E\u0431\u0435\u0434 \u0444\u0435\u0440\u043C\u0435\u0440\u0430\u00BB \u0434\u0430\u0441\u0442 \u0442\u0435\u0431\u0435 \u0441\u0438\u043B \u0434\u043B\u044F \u043F\u043E\u043B\u0438\u0432\u0430 \u0438 \u0441\u0431\u043E\u0440\u0430 \u0443\u0440\u043E\u0436\u0430\u044F!",
  "winter_Wed": "\u0421\u0435\u0439\u0447\u0430\u0441 \u0431\u0443\u0448\u0443\u0435\u0442 \u0433\u0440\u0438\u043F\u043F, \u0431\u0443\u0434\u044C \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u0435\u0435.#$e#\u0427\u0430\u0449\u0435 \u043C\u043E\u0439 \u0440\u0443\u043A\u0438.",
  "winter_Sun": "\u041D\u0435\u0445\u043E\u0440\u043E\u0448\u043E \u0442\u0430\u043A\u043E\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C, \u043D\u043E \u0432 \u0441\u0435\u0437\u043E\u043D \u0433\u0440\u0438\u043F\u043F\u0430 \u044F \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u0431\u043E\u043B\u044C\u0448\u0435.#$e#\u041D\u0443, \u0435\u0441\u043B\u0438 \u0431\u044B \u043B\u044E\u0434\u0438 \u043D\u0435 \u0431\u043E\u043B\u0435\u043B\u0438, \u044F \u0431\u044B \u0440\u0430\u0437\u043E\u0440\u0438\u043B\u0441\u044F.#$e#\u041D\u0435 \u043F\u043E\u0434\u0443\u043C\u0430\u0439 \u043D\u0438\u0447\u0435\u0433\u043E \u0442\u0430\u043A\u043E\u0433\u043E! \u042F \u0445\u043E\u0447\u0443, \u0447\u0442\u043E\u0431\u044B \u043B\u044E\u0434\u0438 \u0431\u044B\u043B\u0438 \u0437\u0434\u043E\u0440\u043E\u0432\u044B... \u041F\u0440\u0430\u0432\u0434\u0430!"
}