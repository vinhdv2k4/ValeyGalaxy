{
  "Introduction": "\u042D-\u044D... \u041F\u0440\u0438\u0432\u0435\u0442. \u041C\u0435\u043D\u044F \u0437\u043E\u0432\u0443\u0442 \u041A\u043B\u0438\u043D\u0442.#$e#\u042F \u2014 \u043C\u0435\u0441\u0442\u043D\u044B\u0439 \u043A\u0443\u0437\u043D\u0435\u0446. \u0415\u0441\u043B\u0438 \u043D\u0443\u0436\u043D\u043E \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u044C \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B, \u044D\u0442\u043E \u043F\u043E \u043C\u043E\u0435\u0439 \u0447\u0430\u0441\u0442\u0438.",
  "AcceptBirthdayGift_Positive": "\u041C\u043D\u0435 \u043D\u0435\u0447\u0430\u0441\u0442\u043E \u0434\u0430\u0440\u044F\u0442 \u043F\u043E\u0434\u0430\u0440\u043A\u0438 \u043D\u0430 \u0434\u0435\u043D\u044C \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F. \u041C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u043F\u0440\u0438\u044F\u0442\u043D\u043E, @. \u0421\u043F\u0430\u0441\u0438\u0431\u043E.",
  "AcceptBirthdayGift_Negative": "\u042D\u0442\u043E \u0447\u0442\u043E, \u043F\u043E\u0434\u0430\u0440\u043E\u043A \u043D\u0430 \u0434\u0435\u043D\u044C \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F? \u041A\u0430\u043A\u043E\u0439... \u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0439 \u0432\u044B\u0431\u043E\u0440. \u0427\u0442\u043E \u0436, \u0441\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E \u043D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0435\u0448\u044C.",
  "AcceptGift_(O)StardropTea": "\u0422\u044B \u0434\u0430\u0440\u0438\u0448\u044C \u044D\u0442\u043E... \u043C\u043D\u0435? \u041D\u0435 \u0434\u0443\u043C\u0430\u044E, \u0447\u0442\u043E \u044F \u044D\u0442\u043E\u0433\u043E \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u044E... \u043D\u043E \u0441\u043F\u0430\u0441\u0438\u0431\u043E.",
  "AcceptGift_(O)SkillBook_3": "\u041E, \u043B\u044E\u0431\u043E\u043F\u044B\u0442\u043D\u043E... \u0412 \u0434\u043E\u043B\u0438\u043D\u0435 \u0442\u0430\u043A\u0438\u0435 \u043A\u043D\u0438\u0433\u0438 \u043D\u0435 \u0442\u0430\u043A-\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u044C.#$b#\u041F\u043E\u0445\u043E\u0436\u0435, \u0432 \u043D\u0435\u0439 \u0435\u0441\u0442\u044C \u043A\u0443\u0447\u0430 \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0445 \u0441\u043E\u0432\u0435\u0442\u043E\u0432. \u0421\u043F\u0430\u0441\u0438\u0431\u043E, @.",
  "mineArea_40": "\u0410, \u0441\u0443\u0434\u044F \u043F\u043E \u0437\u0430\u0440\u0443\u0431\u043A\u0430\u043C \u043D\u0430 \u0442\u0432\u043E\u0435\u0439 \u043A\u0438\u0440\u043A\u0435, \u0433\u043B\u0443\u0431\u0438\u043D\u044B \u0448\u0430\u0445\u0442 \u0443\u0436\u0435 \u043E\u0442\u043A\u0440\u044B\u043B\u0438 \u0442\u0435\u0431\u0435 \u0441\u0432\u043E\u0438 \u043D\u0435\u0434\u0440\u0430.#$e#\u0415\u0441\u043B\u0438 \u0441\u0442\u0430\u043D\u0435\u0442 \u0442\u0440\u0443\u0434\u043D\u043E \u0440\u0430\u0437\u0431\u0438\u0432\u0430\u0442\u044C \u043A\u0430\u043C\u043D\u0438, \u043F\u0440\u0438\u0445\u043E\u0434\u0438 \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u044C \u043A\u0438\u0440\u043A\u0443. \u042F \u043F\u043E\u043C\u043E\u0433\u0443.",
  "GreenRain": "\u0412 \u0442\u0430\u043A\u0438\u0445 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F\u0445 \u043B\u044E\u0434\u0438 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u0441\u0432\u043E\u044E \u0438\u0441\u0442\u0438\u043D\u043D\u0443\u044E \u043F\u0440\u0438\u0440\u043E\u0434\u0443.#$e#\u042F \u0437\u0430\u0449\u0438\u0449\u0443 \u042D\u043C... \u0422\u043E \u0435\u0441\u0442\u044C \u044F \u0437\u0430\u0449\u0438\u0449\u0443 \u0432\u0441\u0435\u0445 \u043E\u0442 \u044D\u0442\u043E\u0439 \u0442\u043E\u043A\u0441\u0438\u0447\u043D\u043E\u0439 \u043D\u0430\u043F\u0430\u0441\u0442\u0438!",
  "GreenRainFinished": "\u0412\u043E\u0442 \u043D\u0435\u0437\u0430\u0434\u0430\u0447\u0430. \u0410 \u044F-\u0442\u043E \u0434\u0443\u043C\u0430\u043B, \u0447\u0442\u043E \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u0441\u043C\u043E\u0433\u0443 \u043F\u043E\u0433\u0435\u0440\u043E\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C. \u0427\u0442\u043E \u0436... \u0412\u0435\u0440\u043D\u0443\u0441\u044C \u043A \u0441\u0432\u043E\u0435\u043C\u0443 \u0442\u043E\u0447\u0438\u043B\u044C\u043D\u043E\u043C\u0443 \u043A\u0430\u043C\u043D\u044E.",
  "GreenRain_2": "\u041F\u043B\u043E\u0445\u043E \u0442\u0430\u043A \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C, \u043D\u043E \u0438\u043D\u043E\u0433\u0434\u0430 \u043C\u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F, \u0447\u0442\u043E\u0431\u044B \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0431\u0435\u0434\u0441\u0442\u0432\u0438\u0435, \u0430 \u043D\u0435 \u044D\u0442\u043E\u0442 \u0433\u043B\u0443\u043F\u044B\u0439 \u0437\u0435\u043B\u0435\u043D\u044B\u0439 \u0434\u043E\u0436\u0434\u044C.#$b#\u0427\u0442\u043E\u0431\u044B \u0432\u0441\u0435 \u0441 \u043D\u043E\u0433 \u043D\u0430 \u0433\u043E\u043B\u043E\u0432\u0443 \u043F\u0435\u0440\u0435\u0432\u0435\u0440\u043D\u0443\u043B\u043E\u0441\u044C, \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C?#$b#\u042F \u043D\u0435 \u0445\u043E\u0447\u0443, \u0447\u0442\u043E\u0431\u044B \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B...#$b#\u041F\u0440\u043E\u0441\u0442\u043E \u0445\u043E\u0447\u0443 \u0441\u043D\u043E\u0432\u0430 \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C \u0441\u0435\u0431\u044F \u0436\u0438\u0432\u044B\u043C... \u0418 \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u043C...",
  "mineArea_121": "\u041B\u044E\u0431\u043E\u043F\u044B\u0442\u043D\u043E. \u042F \u0432\u0438\u0436\u0443 \u043C\u0435\u043B\u043A\u0438\u0435 \u0447\u0430\u0441\u0442\u0438\u0446\u044B \u0438\u0440\u0438\u0434\u0438\u044F \u043D\u0430 \u0442\u0432\u043E\u0435\u0439 \u043A\u0438\u0440\u043A\u0435... \u041A\u0430\u043A \u0442\u0430\u043C \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u043D\u044B\u0445 \u043F\u0435\u0449\u0435\u0440\u0430\u0445, \u0430?#$e#\u0412\u0441\u0435\u0433\u0434\u0430 \u0445\u043E\u0442\u0435\u043B \u043F\u043E\u0432\u044B\u043F\u043B\u0430\u0432\u043B\u044F\u0442\u044C \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0438\u0437 \u0438\u0440\u0438\u0434\u0438\u044F. \u0415\u0433\u043E \u043D\u0435 \u0442\u0430\u043A-\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u044C.",
  "eventSeen_101_memory_oneweek": "\u042D\u043C\u0438\u043B\u0438 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430 \u043E \u043D\u0430\u0448\u0435\u043C \u043D\u0435\u0434\u0430\u0432\u043D\u0435\u043C \u0441\u0432\u0438\u0434\u0430\u043D\u0438\u0438?#$b#\u0421\u0442\u043E\u0439... \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438. \u041B\u0443\u0447\u0448\u0435 \u043D\u0435 \u0437\u043D\u0430\u0442\u044C. \u041C\u043E\u0436\u0435\u0442, \u044F \u0435\u0449\u0435 \u0441\u043C\u043E\u0433\u0443 \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0441\u0435\u0431\u0435 \u0434\u043E\u0441\u0442\u043E\u0438\u043D\u0441\u0442\u0432\u043E.$s",
  "dating_Emily": "\u042D... \u044D\u0442\u043E... \u0441\u043B\u044B\u0448\u0430\u043B, \u0447\u0442\u043E \u0432\u044B \u0441 \u042D\u043C\u0438\u043B\u0438 \u0442\u0435\u043F\u0435\u0440\u044C \u0432\u043C\u0435\u0441\u0442\u0435. \u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u044E.$s",
  "married_Emily": "%\u041A\u043B\u0438\u043D\u0442 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0441\u0435\u0431\u0435 \u043F\u043E\u0434 \u043D\u043E\u0433\u0438 \u0438 \u043C\u043E\u043B\u0447\u0438\u0442.",
  "divorced_Emily": "\u0412 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0432\u0440\u0435\u043C\u044F \u0432 \u043C\u0435\u043D\u044F \u0431\u0443\u0434\u0442\u043E \u0441\u043D\u043E\u0432\u0430 \u0432\u0441\u0435\u043B\u0438\u043B\u0430\u0441\u044C \u043D\u0430\u0434\u0435\u0436\u0434\u0430.",
  "Resort_Entering": "\u042F \u043D\u0430\u0434\u0435\u043D\u0443 \u0441\u0432\u043E\u0438 \u043E\u0441\u043E\u0431\u044B\u0435 \u043A\u0440\u0430\u0441\u043D\u044B\u0435 \u043F\u043B\u0430\u0432\u043A\u0438. \u041F\u043E \u0438\u0434\u0435\u0435, \u043E\u043D\u0438 \u0434\u043E\u043B\u0436\u043D\u044B \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0442\u044C \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435.",
  "Resort_Leaving": "\u041D\u0443, \u0432\u044B\u0448\u043B\u043E \u0432\u0441\u0435 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043D\u0435 \u0442\u0430\u043A, \u043A\u0430\u043A \u044F \u043E\u0436\u0438\u0434\u0430\u043B...",
  "Resort_Shore": "\u041E \u043D\u0435\u0442... \u042F \u0437\u0430\u0431\u044B\u043B \u043F\u043E\u0434\u0441\u0442\u0440\u0438\u0447\u044C \u043D\u043E\u0433\u0442\u0438 \u043D\u0430 \u043D\u043E\u0433\u0430\u0445.$s",
  "Resort_Shore_2": "\u042F \u0434\u0443\u043C\u0430\u043B, \u0447\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u0430 \u0432 \u043A\u0443\u0437\u043D\u0438\u0446\u0435 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u043B\u0430 \u043C\u0435\u043D\u044F \u043A \u043B\u044E\u0431\u043E\u0439 \u0436\u0430\u0440\u0435, \u043D\u043E, \u0431\u043B\u0438\u043D, \u0442\u0443\u0442 \u044F \u043F\u043E\u0442\u0435\u044E \u0432 \u0442\u0430\u043A\u0438\u0445 \u043C\u0435\u0441\u0442\u0430\u0445, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0438 \u043F\u043E\u0442\u0435\u0442\u044C-\u0442\u043E \u043D\u0435 \u0434\u043E\u043B\u0436\u043D\u044B\u0022.$s#$e#\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u044D\u0442\u043E\u0433\u043E \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B...#$e#%\u0422\u0435\u043B\u043E \u041A\u043B\u0438\u043D\u0442\u0430 \u0431\u043B\u0435\u0441\u0442\u0438\u0442....",
  "Resort_Chair": "\u0423\u0444... \u0412\u0441\u0435 \u0442\u0435\u043B\u043E \u0434\u043E \u043A\u043E\u0440\u043E\u0447\u043A\u0438 \u043E\u0431\u0433\u043E\u0440\u0435\u043B\u043E.$s",
  "Resort_Bar": "\u0415\u0441\u0442\u044C \u0445\u043E\u0447\u0443...$s",
  "Resort": "*\u0432\u0437\u0434\u044B\u0445\u0430\u0435\u0442*... \u041D\u0430 \u043F\u043B\u044F\u0436\u0435 \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u043B\u044E\u0434\u0435\u0439, \u0430 \u043C\u043D\u0435 \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E \u043E\u0434\u0438\u043D\u043E\u043A\u043E...$s",
  "reject_868": "\u0425\u043C... \u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0439 \u043A\u0430\u043C\u0435\u043D\u044C, \u044F \u0442\u0430\u043A\u043E\u0433\u043E \u0440\u0430\u043D\u044C\u0448\u0435 \u043D\u0435 \u0432\u0438\u0434\u0435\u043B.#$b#\u041D\u043E \u044F \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E \u043D\u0435 \u0437\u043D\u0430\u044E, \u0441 \u043A\u0430\u043A\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u043A \u043D\u0435\u043C\u0443 \u043F\u043E\u0434\u0441\u0442\u0443\u043F\u0438\u0442\u044C\u0441\u044F. \u042F \u0431\u043E\u043B\u044C\u0448\u0435 \u0441\u043F\u0435\u0446 \u043F\u043E \u043E\u0431\u044B\u0447\u043D\u044B\u043C \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430\u043C, \u0430 \u043D\u0435 \u043F\u043E \u0432\u043E\u043B\u0448\u0435\u0431\u043D\u044B\u043C.",
  "cc_Minecart": "\u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u0441\u0442\u0430\u0440\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0432\u0430\u0433\u043E\u043D\u0435\u0442\u043E\u043A \u043E\u043F\u044F\u0442\u044C \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430. \u041D\u0430 \u043D\u0438\u0445 \u0442\u0435\u043F\u0435\u0440\u044C \u043E\u0447\u0435\u043D\u044C \u0443\u0434\u043E\u0431\u043D\u043E \u0435\u0437\u0434\u0438\u0442\u044C \u0432 \u0448\u0430\u0445\u0442\u044B \u0438 \u043E\u0431\u0440\u0430\u0442\u043D\u043E.#$b#\u041D\u043E \u043F\u0440\u0438\u0432\u044B\u043A\u0430\u0442\u044C \u043A \u043D\u0438\u043C \u043D\u0435 \u0441\u0442\u043E\u0438\u0442... \u041A\u0430\u043A \u043D\u0430\u0447\u0430\u043B\u0438 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C, \u0442\u0430\u043A \u0436\u0435 \u043C\u043E\u0433\u0443\u0442 \u0438 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0442\u044C...",
  "Mon": "\u0410\u0433\u0430. \u041A\u0443\u0437\u043D\u0435\u0446 \u044F.#$e#\u0418 \u043E\u0442\u0435\u0446 \u043C\u043E\u0439 \u0431\u044B\u043B \u043A\u0443\u0437\u043D\u0435\u0446\u043E\u043C.#$e#\u0414\u0435\u0434 \u043C\u043E\u0439 \u0442\u043E\u0436\u0435 \u043A\u0443\u0437\u043D\u0435\u0446\u043E\u043C \u0431\u044B\u043B.$u#$q 9/9 Mon_old#\u0421\u043F\u043E\u0440\u0438\u043C, \u0442\u044B \u043D\u0435 \u0434\u043E\u0433\u0430\u0434\u0430\u0435\u0448\u044C\u0441\u044F, \u043A\u0435\u043C \u0431\u044B\u043B \u043C\u043E\u0439 \u043F\u0440\u0430\u0434\u0435\u0434...#$r 9 30 Mon_9#\u041A\u0443\u0437\u043D\u0435\u0446\u043E\u043C.#$r 9 50 Mon_clown#\u041D\u0435\u043B\u0435\u043F\u044B\u043C \u043A\u043B\u043E\u0443\u043D\u043E\u043C.#$r 9 -50 Mon_rude#\u0421\u0430\u0440\u043A\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043F\u0440\u0438\u0434\u0443\u0440\u043A\u043E\u043C.",
  "Mon_old": "\u0418 \u0434\u0430, \u043C\u043E\u0439 \u043F\u0440\u0430\u0434\u0435\u0434 \u0442\u043E\u0436\u0435 \u0431\u044B\u043B \u043A\u0443\u0437\u043D\u0435\u0446\u043E\u043C.",
  "Mon_9": "\u041E\u0442\u043A\u0443\u0434\u0430 \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C?$u",
  "Mon_clown": "\u0425\u0430-\u0445\u0430-\u0445\u0430-\u0445\u0430. \u0428\u0443\u0442\u043A\u0430 \u0447\u0442\u043E \u043D\u0430\u0434\u043E.$h",
  "Mon_rude": "\u041E\u0433\u043E. \u041A\u0430\u043A \u0433\u0440\u0443\u0431\u043E. \u042F \u043F\u0440\u043E\u0441\u0442\u043E \u0445\u043E\u0442\u0435\u043B \u043F\u043E\u0448\u0443\u0442\u0438\u0442\u044C, \u0430 \u0442\u044B \u0432\u043E\u0442 \u0442\u0430\u043A \u0432\u0441\u0435 \u043D\u0430\u043A\u0430\u043B\u044F\u0435\u0448\u044C.",
  "Mon4": "\u0420\u0430\u0434\u0443\u0439\u0441\u044F \u0442\u043E\u043C\u0443, \u0447\u0442\u043E \u0442\u044B \u0444\u0435\u0440\u043C\u0435\u0440, @. \u041B\u0443\u0447\u0448\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0432\u0435\u0441\u044C \u0434\u0435\u043D\u044C \u043D\u0430 \u0441\u0432\u0435\u0436\u0435\u043C \u0432\u043E\u0437\u0434\u0443\u0445\u0435, \u0447\u0435\u043C \u0443 \u0440\u0430\u0441\u043A\u0430\u043B\u0435\u043D\u043D\u043E\u0439 \u043F\u0435\u0447\u0438.#$e#\u042F \u0441\u0442\u0430\u043B \u043A\u0443\u0437\u043D\u0435\u0446\u043E\u043C \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0442\u043E\u043C\u0443, \u0447\u0442\u043E \u043E\u0442\u0435\u0446 \u043C\u0435\u043D\u044F \u0432\u044B\u043D\u0443\u0434\u0438\u043B.",
  "Tue": "\u0415\u0441\u043B\u0438 \u0445\u043E\u0447\u0435\u0448\u044C \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u044C \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B, \u0442\u043E \u043F\u0440\u0438\u043D\u0435\u0441\u0438 \u043C\u043D\u0435 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0435 \u0441\u043B\u0438\u0442\u043A\u0438.#$e#\u0418, \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F \u043E\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0441\u0430\u043C\u0443 \u0440\u0430\u0431\u043E\u0442\u0443.",
  "Wed": "\u041F\u0440\u0438\u0432\u0435\u0442. \u0427\u0442\u043E \u0442\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E?",
  "Wed6": "\u041E, \u043F\u0440\u0438\u0432\u0435\u0442, @. \u041F\u0440\u043E\u0441\u0442\u0438, \u0435\u0441\u043B\u0438 \u044F \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0437\u0430\u043F\u0430\u0447\u043A\u0430\u043D. \u042F \u0432\u0441\u0435 \u0443\u0442\u0440\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0443 \u043F\u0435\u0447\u0438.$h#$e#\u0422\u0435\u0431\u0435 \u0447\u0442\u043E-\u0442\u043E \u043D\u0443\u0436\u043D\u043E? \u0418\u043B\u0438 \u0442\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u0433\u043B\u044F\u043D\u0443\u0442\u044C?",
  "Thu": "\u0414\u0435\u043B\u0430 \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0432\u0440\u0435\u043C\u044F \u0438\u0434\u0443\u0442 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E.#$e#\u0422\u0435\u0431\u0435 \u0431\u044B \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u044C. \u0414\u0435\u043D\u044C\u0433\u0438 \u043C\u043D\u0435 \u0431\u044B \u043D\u0435 \u043F\u043E\u043C\u0435\u0448\u0430\u043B\u0438.",
  "Thu8": "\u0421\u043B\u044B\u0448\u0430\u043B, \u0443 \u042D\u043C\u0438\u043B\u0438 \u043F\u043E\u0434\u0440\u0443\u0433\u0430 \u0432 \u043F\u0443\u0441\u0442\u043D\u044B\u0435 \u0436\u0438\u0432\u0435\u0442. \u0417\u043D\u0430\u0435\u0448\u044C \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043E \u043D\u0435\u0439?#$e#\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u0443 \u043D\u0435\u0435 \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0435\u0441\u0442\u044C?..$s",
  "Fri": "\u041F\u043E\u0433\u043E\u0434\u0430 \u0434\u043B\u044F \u043C\u0435\u043D\u044F \u043D\u0435 \u043E\u0447\u0435\u043D\u044C-\u0442\u043E \u0432\u0430\u0436\u043D\u0430. \u041E\u0431\u044B\u0447\u043D\u043E \u044F \u0446\u0435\u043B\u044B\u0439 \u0433\u043E\u0434 \u0442\u043E\u0440\u0447\u0443 \u0443 \u0441\u0435\u0431\u044F \u0432 \u043A\u0443\u0437\u043D\u0438\u0446\u0435.#$e#\u0422\u043E\u0441\u043A\u043B\u0438\u0432\u043E, \u043F\u0440\u0430\u0432\u0434\u0430?",
  "Fri8": "\u041D\u0443\u0436\u043D\u043E \u043D\u0430\u043A\u043E\u043F\u0438\u0442\u044C \u0438 \u043A\u0443\u043F\u0438\u0442\u044C \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440...#$e#\u041C\u043E\u0436\u0435\u0442, \u044F \u0441\u043C\u043E\u0433\u0443 \u043D\u0430\u0439\u0442\u0438 \u0441\u0435\u0431\u0435 \u0434\u0435\u0432\u0443\u0448\u043A\u0443 \u0432 \u044D\u0442\u043E\u043C \u0432\u0430\u0448\u0435\u043C \u00AB\u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442\u0435\u00BB...$s#$e#\u0427\u0442\u043E? \u041D\u0435 \u043D\u0430\u0434\u043E \u043D\u0430 \u043C\u0435\u043D\u044F \u0442\u0430\u043A \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C! \u041D\u0435 \u0432\u0441\u0435 \u0442\u0443\u0442 \u043A\u0440\u0443\u0442\u044B\u0435, \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u0438 \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0435 \u0444\u0435\u0440\u043C\u0435\u0440\u044B, \u0437\u043D\u0430\u0435\u0448\u044C \u043B\u0438!$u#$e#\u0427\u0442\u043E \u0436 \u0442\u0430\u043A\u0438\u043C, \u043A\u0430\u043A \u044F, \u0434\u0435\u043B\u0430\u0442\u044C? *\u0441\u0442\u043E\u043D\u0435\u0442*$s",
  "Sat": "\u0418\u043D\u043E\u0433\u0434\u0430 \u044F \u0434\u0443\u043C\u0430\u044E \u043E \u0442\u043E\u043C, \u043A\u0430\u043A \u0436\u0435 \u044F \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u0432 \u044D\u0442\u043E\u043C \u0433\u043E\u0440\u043E\u0434\u043A\u0435.$u",
  "Sat6": "\u0427\u0435\u0440\u0442 \u0432\u043E\u0437\u044C\u043C\u0438, \u044F \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0441\u0442\u0430\u0440, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u043D\u044F\u0442\u044C\u0441\u044F \u0447\u0435\u043C-\u0442\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u043C. \u0412\u0441\u0435, \u0447\u0442\u043E \u043C\u043D\u0435 \u043E\u0441\u0442\u0430\u0435\u0442\u0441\u044F \u2014 \u0433\u043E\u0434\u044B \u0438 \u0433\u043E\u0434\u044B \u043F\u043E\u0442\u043D\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B \u0443 \u0436\u0430\u0440\u043A\u043E\u0439 \u043F\u0435\u0447\u0438.",
  "Sat10": "\u041A\u0430\u043A \u0442\u0430\u043C \u0442\u0432\u043E\u0439 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442?#$b#\u0415\u0441\u043B\u0438 \u043D\u0443\u0436\u043D\u043E \u0447\u0442\u043E \u043F\u043E\u0447\u0438\u043D\u0438\u0442\u044C, \u043F\u0440\u0438\u0445\u043E\u0434\u0438 \u043A\u043E \u043C\u043D\u0435 \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D. \u0414\u0430\u044E \u043F\u043E\u0436\u0438\u0437\u043D\u0435\u043D\u043D\u0443\u044E \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u044E!",
  "Sun": "\u0420\u0430\u0437\u0432\u0435 \u0442\u0435\u0431\u0435 \u043D\u0435\u0447\u0435\u043C \u0437\u0430\u043D\u044F\u0442\u044C\u0441\u044F?",
  "Sun4": "\u041A\u0430\u043A \u0442\u0430\u043C \u0442\u0432\u043E\u0438 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B?",
  "Sun8": "\u041D\u0435 \u0437\u043D\u0430\u044E, \u0432 \u043A\u0443\u0440\u0441\u0435 \u043B\u0438 \u043B\u044E\u0434\u0438, \u0434\u0430 \u0438 \u0432\u043E\u043E\u0431\u0449\u0435 \u0437\u0430\u0431\u043E\u0442\u0438\u0442 \u043B\u0438 \u044D\u0442\u043E \u0438\u0445, \u043D\u043E \u044F \u043E\u0447\u0435\u043D\u044C \u0433\u043E\u0440\u0436\u0443\u0441\u044C \u0441\u0432\u043E\u0435\u0439 \u0440\u0430\u0431\u043E\u0442\u043E\u0439.#$e#\u042F \u0432\u0435\u0434\u044C... \u041A\u043E\u0433\u0434\u0430 \u043C\u0435\u043B\u043A\u0438\u043C \u0431\u044B\u043B \u2014 \u0438 \u043D\u0435 \u0434\u0443\u043C\u0430\u043B \u043A\u0443\u0437\u043D\u0435\u0446\u043E\u043C \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F. \u041D\u043E \u0432\u043E\u0442 \u043E\u043D \u044F. \u0418 \u044F \u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C \u043F\u0440\u0435\u0443\u0441\u043F\u0435\u0442\u044C \u0432 \u0441\u0432\u043E\u0435\u0439 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u0438.",
  "event_advice1": "\u041B\u0430\u0434\u043D\u043E... \u0411\u0443\u0434\u0443 \u0438\u043C\u0435\u0442\u044C \u0432 \u0432\u0438\u0434\u0443.",
  "event_advice2": "\u0412 \u044D\u0442\u043E\u043C \u0438 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430... \u042F \u0432\u0435\u0434\u0443 \u0441\u0435\u0431\u044F \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E... \u041D\u043E \u0442\u043E\u043B\u043A\u0443 \u043E\u0442 \u044D\u0442\u043E\u0433\u043E \u043D\u0438\u043A\u0430\u043A\u043E\u0433\u043E.$s",
  "Mon8": "\u042F \u043D\u0435 \u043B\u044E\u0431\u043B\u044E \u044D\u0442\u043E \u043F\u0440\u0438\u0437\u043D\u0430\u0432\u0430\u0442\u044C, \u043D\u043E \u044F \u0440\u0430\u0434, \u0447\u0442\u043E \u043F\u0430\u043F\u0430 \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043B \u043C\u0435\u043D\u044F \u0432\u0437\u044F\u0442\u044C\u0441\u044F \u0437\u0430 \u043A\u0443\u0437\u043D\u0435\u0447\u043D\u043E\u0435 \u0434\u0435\u043B\u043E. \u0423 \u043C\u0435\u043D\u044F \u0445\u043E\u0442\u044F \u0431\u044B \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u044F \u0435\u0441\u0442\u044C.#$e#\u0415\u0441\u043B\u0438 \u0431\u044B \u043D\u0435 \u044D\u0442\u043E, \u044F \u0431\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0438\u0434\u0435\u043B \u0432\u0441\u0435 \u0434\u043D\u0438 \u043D\u0430\u043F\u0440\u043E\u043B\u0435\u0442 \u0438 \u043E \u0441\u0432\u043E\u0435\u0439 \u0442\u044F\u0436\u0435\u043B\u043E\u0439 \u0434\u043E\u043B\u0435 \u0432\u0437\u0434\u044B\u0445\u0430\u043B.$s"
}