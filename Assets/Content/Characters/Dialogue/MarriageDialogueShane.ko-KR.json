  "TwoKids_0": "\uC560\uB4E4 \uBC8C\uC368 \uD53C\uC790 \uB9DB \uC2DC\uB9AC\uC5BC \uBA39\uC600\uC5B4. \uD55C\uB3D9\uC548 \uBC30\uBD80\uB97C \uAC70\uC57C.",
