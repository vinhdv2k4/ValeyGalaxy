  "funReturn_Shane": "\uB098 \uB540\uB098, \uBBF8\uC548... \uC640 \uC0B0\uCC45 \uC9C4\uC9DC... \uC5B4, \uB098 \uC6B4\uB3D9 \uB108\uBB34 \uC548 \uD588\uC5B4.$6",
  "spring_1": "\uC6B0\uC6B0... \uBA38\uB9AC\uAC00 \uC9C0\uB048\uAC70\uB824. \uC5B4\uC82F\uBC24\uC5D0 \uC5BC\uB9C8\uB098 \uB9C8\uC2E0 \uAC70\uC9C0?",
  "spring_12": "\uB2EC\uAC40 \uCD95\uC81C\uAC00 \uB0B4\uAC00 \uC81C\uC77C \uC88B\uC544\uD558\uB294 \uCD95\uC81C\uC77C \uAC70\uC57C... \uADFC\uB370 \uB0B4\uAC00 \uC5B4\uB5A4\uC9C0 \uC54C\uC796\uC544, \uB2ED\uC5D0 \uAD00\uB828\uB41C \uAC70\uB77C\uBA74 \uB2E4 \uC88B\uC544\uD574\uC11C.$h",
  "spring_23": "\uC624, \uB9DE\uB2E4. \uB0B4\uC77C \uBD04\uAF43 \uBB34\uB3C4\uD68C\uAD6C\uB098. \uBB50, \uB124\uAC00 \uAE30\uC05C \uC77C\uC774\uB77C\uBA74 \uB098\uB3C4 \uAE30\uBED0.",
  "summer_1": "\uC774\uB9D8\uB54C \uC5F4\uB300 \uC2DD\uBB3C\uC774 \uBCF4\uC774\uB294 \uAC8C \uC88B\uB354\uB77C. \uACC4\uACE1\uC774 \uC6B0\uAC70\uC9C4 \uB290\uB08C\uC774 \uB4E4\uC5B4.",
  "summer_10": "\uB0B4\uC77C \uB8E8\uC544\uC6B0 \uB54C\uAE4C\uC9C0 \uAD76\uC744\uAE4C \uBD10. \uBC30\uB97C \uBE44\uC6CC\uB194\uC57C \uB728\uB048\uD55C \uC2A4\uD504\uB85C \uAF49 \uCC44\uC6B8 \uC218 \uC788\uC9C0.$h",
  "summer_27": "\uAC00\uC744\uC5D0\uB294 \uC5B4\uB5A4 \uACC4\uD68D\uC774 \uC788\uC5B4? \uB09C \uB0B4 \uC2DD\uB2E8\uC5D0 \uC640\uC778\uC744 \uB354 \uB9CE\uC774 \uD3EC\uD568\uC2DC\uD0A4\uB824\uACE0.",
  "fall_1": "\uD760... \uAC00\uC744\uC774 \uC628 \uAC78 \uCD95\uD558\uD558\uAE30 \uC704\uD574 \uD638\uBC15 \uC5D0\uC77C \uBA87 \uC0C1\uC790 \uC0B4\uAE4C...$6",
  "fall_15": "\uB09C \uD56D\uC0C1 \uADF8\uB7AC\uB4EF\uC774 \uB0B4\uC77C \uD488\uD3C9\uD68C \uB54C \uB9C8\uB2C8 \uB3C4\uC640\uC8FC\uB824\uACE0. \uC790\uAE30\uB294 \uD3B8\uD558\uAC8C \uB180\uB2E4 \uAC00.$6",
  "fall_17": "\uC815\uB9D0 \uB0B4 \uB098\uC774\uAC00 \uB290\uAEF4\uC9C0\uAE30 \uC2DC\uC791\uD588\uC5B4... \uC804\uD600 \uD3B8\uD55C \uC0AC\uC2E4\uC774 \uC544\uB2C8\uC57C.",
  "winter_1": "\uACA8\uC6B8\uC5D0 \uD070 \uACC4\uD68D \uC788\uC5B4? \uB09C \uC544\uB9C8 \uD2F0\uBE44 \uB9CE\uC774 \uBCF4\uACE0 \uC9D1\uC5D0\uC11C \uB180\uC9C0 \uC54A\uC744\uAE4C.",
  "winter_28": "\uBB50, \uD55C \uD574\uAC00 \uB610 \uC9C0\uB098\uAC14\uB124... \uB09C \uC880 \uB354 \uB299\uC5B4 \uBCF4\uC774\uB294 \uC815\uB3C4\uAC00 \uB2E4\uC57C.$6"
}