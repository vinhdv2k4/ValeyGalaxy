{
  "LeoDeparture": "\uC0B4 \uACF3\uC744 \uCC3E\uC544\uC57C \uD574...$s#$b#\uADF8\uB798\uB3C4 \uACC4\uD68D\uC774 \uC788\uC5B4... \uCE5C\uAD6C\uB4E4\uD55C\uD14C \uC2E0\uC138 \uC880 \uC838\uC57C\uC9C0.",
  "AcceptGift_(O)StardropTea": "\uC6B0\uC640, \uD669\uAE08 \uD638\uB450\uB791 \uB9DB\uC774 \uB611\uAC19\uB2E4! \uCD5C\uACE0\uB2E4!",
  "GreenRain": "\uC774 \uB0A0\uC528 \uC88B\uC544... \uCD95\uCD95\uD574. \uC9D1\uC5D0 \uC788\uB358 \uC232\uC774 \uC0DD\uAC01\uB098.",
  "Thu8": "\uCC98\uC74C\uC5D0\uB294 \uBCC4\uB85C\uC600\uC5B4... \uC12C\uC744 \uB5A0\uB098\uC11C \uCC98\uC74C \uAC00\uBCF4\uB294 \uACF3\uC73C\uB85C \uAC04\uB2E4\uB294 \uAC8C.$s#$e#\uD558\uC9C0\uB9CC, \uC810\uC810 \uC775\uC219\uD574\uC84C\uC5B4.#$b#\uB098 \uC801\uC751 \uC798\uD558\uB294 \uC0AC\uB78C\uC774\uC57C!$h",
  "Thu10": "\uCC98\uC74C\uC5D0\uB294 \uB108\uBB34 \uB0AF\uC120 \uACF3\uC5D0 \uC640\uC11C \uC774\uBC29\uC778\uC774 \uB41C \uB290\uB08C\uC774\uC5C8\uC5B4. \uD558\uC9C0\uB9CC \uC774\uC81C\uB294 \uCE5C\uAD6C \uB9CE\uC774 \uC0DD\uACBC\uC5B4!$h#$b#\uB4DC\uB514\uC5B4 \uB0B4\uAC00 \uC788\uC744 \uACF3\uC744 \uCC3E\uC740 \uAE30\uBD84\uC774\uC57C...",
  "Tue": "\uD398\uB2C8 \uC120\uC0DD\uB2D8\uAED8\uC11C \uD559\uAD50 \uACF5\uBD80 \uB9CE\uC774 \uAC00\uB974\uCCD0\uC8FC\uACE0 \uC788\uC5B4. \uC815\uB9D0 \uC88B\uC740 \uBD84\uC774\uC154...#$e#...\uB2E4\uD589\uD788\uB3C4 \uC61B \uC0B6\uC5D0\uC11C \uBA87 \uAC00\uC9C0 \uAE30\uC5B5\uC774 \uB098\uAE34 \uD574... \uC12C\uC5D0 \uB3C4\uCC29\uD558\uC9C0 \uC804\uC758 \uC0B6... \uADF8\uB798\uC11C \uB108\uBB34 \uC5B4\uB835\uC9C4 \uC54A\uC544.#$e#\uD398\uB2C8 \uC120\uC0DD\uB2D8\uAED8\uC11C \uB0B4\uAC00 \uB9CE\uC774 \uC54C\uACE0 \uC788\uB2E4\uACE0 \uCE6D\uCC2C\uD574 \uC92C\uC5B4!",
  "Tue10": "\uBD84\uBA85 \uCC98\uC74C\uC5D0\uB294 \uC7AC\uC2A4\uB791 \uBE48\uC13C\uD2B8\uB294 \uB0B4\uAC00 \uC774\uC0C1\uD558\uB2E4 \uC0DD\uAC01\uD588\uC744 \uAC70\uC57C. \uC2E4\uC218\uB85C \uC218\uC5C5 \uC911\uC5D0 \uB0B4\uAC00 \uC9F9\uC9F9\uAC70\uB838\uAC70\uB4E0...$s#$e#\uB2E4\uB4E4 \uD070 \uBCC0\uD654\uC600\uC744 \uAC70\uC57C. \uC774\uC820 \uCE5C\uD55C \uCE5C\uAD6C\uAC00 \uB418\uC5C8\uC5B4!$h",
  "18": "\uB0B4\uAC00 \uCC98\uC74C \uB3C4\uCC29\uD588\uC744 \uB54C \uB77C\uC774\uB108\uC2A4 \uC544\uC800\uC528\uAC00 \uB098\uBB47\uC78E\uC73C\uB85C \uC637\uC744 \uB9CC\uB4E4\uC5B4\uC92C\uC5B4, \uC544\uC800\uC528 \uC637\uCC98\uB7FC...#$b#\uADFC\uB370 \uB098\uB791 \uB108\uBB34 \uC548 \uC5B4\uC6B8\uB838\uC5B4... \uD138 \uB09C \uB9DD\uACE0 \uAC19\uC558\uC5B4!$h#$e#\uB09C \uADF8\uB0E5 \uB0B4 \uAE43\uD138 \uC637 \uC785\uC744 \uAC70\uC57C.",
  "Wed": "\uB77C\uC774\uB108\uC2A4 \uC544\uC800\uC528\uB791 \uD398\uB2C8 \uC120\uC0DD\uB2D8\uD55C\uD14C \uC774 \uC138\uC0C1 \uBAA8\uB4E0 \uAC78 \uBC30\uC6B8 \uAC70\uC57C!$h#$e#\uB8E8\uC774\uC2A4 \uC2DC\uC7A5\uB2D8\uC774 \uB0B4\uAC00 \uACE7 \u0027\uB2E4\uC7AC\uB2E4\uB2A5\uD55C \uC2DC\uBBFC\u0027\uC774 \uB420 \uAC70\uB798... \uBB34\uC2A8 \uB73B\uC778\uC9C0\uB294 \uBAA8\uB974\uACA0\uC9C0\uB9CC.",
  "Thu": "\uC5EC\uAE30 \uC0AC\uB294 \uC2E0\uAE30\uD55C \uC0C8\uB4E4 \uB2E4 \uBCF8 \uC801 \uC788\uC5B4?#$e#\uC798 \uB4E4\uC5B4\uBCF4\uBA74, \uBB54\uAC00 \uC54C\uB824\uC904\uC9C0\uB3C4 \uBAB0\uB77C.",
  "winter_Thu": "\uC774 \uACC4\uACE1\uC758 \uC0C8\uB4E4\uC740 \uCD94\uC6B4 \uB0A0\uC528\uC5D0 \uC775\uC219\uD55C\uAC00 \uBD10.#$e#\uB098\uB3C4 \uB530\uB73B\uD55C \uAE43\uD138 \uC788\uC5C8\uC73C\uBA74 \uC88B\uACA0\uC5B4...$s",
  "4": "\uD558\uB298\uC744 \uB098\uB294 \uD070 \uB9DD\uACE0\uB97C \uBD24\uC5B4. \uB77C\uC774\uB108\uC2A4 \uC544\uC800\uC528 \uB9D0\uB85C\uB294 \uC5F4\uAE30\uAD6C\uB798!$u#$b#\uB09C \uC0C8\uB4E4\uB9CC \uD558\uB298\uC744 \uB0A0 \uC218 \uC788\uB2E4 \uC0DD\uAC01\uD588\uB294\uB370...",
  "Fri": "\uB77C\uC774\uB108\uC2A4 \uC544\uC800\uC528\uAC00 \uACC4\uACE1\uC5D0\uC11C \uB098\uB294 \uC57C\uC0DD \uC74C\uC2DD\uC5D0 \uB300\uD574 \uC54C\uB824\uC8FC\uACE0 \uC788\uC5C8\uC5B4. \uB9DB\uC788\uB294 \uAC70 \uC815\uB9D0 \uB9CE\uC544!$h#$e#\uADF8\uB798\uB3C4... \uB9E4\uC77C \uC544\uCE68 \uD669\uAE08 \uD638\uB450 \uBA39\uB358 \uAC74 \uC880 \uADF8\uB9AC\uC6CC...$s",
  "winter_Fri": "\uB77C\uC774\uB108\uC2A4 \uC544\uC800\uC528\uAC00 \uBC31\uB7C9\uAE08 \uBC14\uB978 \uC0DD\uC120 \uB9CC\uB4DC\uB294 \uBC95\uC744 \uC54C\uB824\uC92C\uC5B4...#$b#\uB9CE\uC774 \uBA39\uC73C\uBA74 \uC774\uBC88 \uACA8\uC6B8\uC5D0 \uB530\uB73B\uD558\uAC8C \uBCF4\uB0BC \uC218 \uC788\uB2E4\uACE0 \uD588\uC5B4!$h",
  "Fri8": "\uB77C\uC774\uB108\uC2A4 \uC0BC\uCD0C\uC774 \uB0B4\uAC00 \uC0DD\uC120\uC744 \uBA39\uAE30 \uC804\uC5D0 \u0027\uC694\uB9AC\u0027\uD574\uC57C \uD55C\uB314\uC5B4...$s#$b#\uC544\uC9C1\uC740 \uC775\uC219\uD574\uC9C0\uAE30 \uD798\uB4E4\uC5B4... \uB108\uBB34 \uAC74\uC870\uD574...$s",
  "Mon": "\uC548\uB155, @. \uC12C\uC5D0\uC11C \uBCF4\uB2C8\uAE4C \uC88B\uB2E4, \uC61B\uB0A0 \uC0DD\uAC01\uB098. \uC7AC\uBC0C\uC5B4!#$e#\uB098 \uC0AC\uC2E4 \uB110 \uCC98\uC74C \uBD24\uC744 \uB54C \uC880 \uBB34\uC11C\uC6E0\uC5B4... \uB0B4 \uC778\uC0DD\uC774 \uBCC0\uD560 \uAC70\uB780 \uAC78 \uC54C\uC558\uAC70\uB4E0.$u",
  "Sun": "\uC788\uC9C0, \uC2A4\uD0C0\uB4C0 \uBC38\uB9AC\uAC00 \uB0B4 \uC0C8 \uC9D1\uC774\uC9C0\uB9CC... \uC12C\uB3C4 \uC5B8\uC81C\uAE4C\uC9C0\uB098 \uB0B4 \uC9D1\uC77C \uAC70\uC57C.#$e#\uB2E4\uC2DC \uBC29\uBB38\uD560 \uC218 \uC788\uC5B4\uC11C \uC88B\uC544.",
  "Sat": "\uC5B8\uC820\uAC00 \uC8FC\uC8FC \uC2DC\uD2F0\uC5D0 \uAC00\uBCFC \uC218 \uC788\uC744\uAE4C...$u#$b#\uD558\uC9C0\uB9CC \uB09C \uC544\uC9C1 \uC900\uBE44\uAC00 \uC548\uB410\uC5B4. \uC774 \uC138\uC0C1\uC740 \uB0B4\uAC8C \uB108\uBB34\uB098 \uC774\uC0C1\uD55C \uACF3\uC774\uC57C, \uB09C \uC5EC\uAE30 \uC788\uB294 \uAC8C \uD3B8\uD55C\uAC78!$h",
  "Sun10": "\uC575\uBB34\uC0C8\uB4E4\uC774 \uD669\uAE08 \uD638\uB450 \uB9CE\uC774 \uCC3E\uC544\uC918\uC11C \uACE0\uB9D9\uB300. \uB2E4\uB4E4 \uB9DB\uC788\uAC8C \uBA39\uACE0 \uC788\uC5B4.$h",
  "Sat10": "@? \uC74C... \uBB3C\uC5B4\uBCF4\uAE30 \uC880 \uBD80\uB044\uB7EC\uC6B4\uB370...$u#$b#\uD639\uC2DC... \uC7AC\uC2A4\uAC00 \uB098 \uAC19\uC740 \uC0AC\uB78C\uC744 \uC88B\uC544\uD560 \uC218 \uC788\uC744\uAE4C?$u#$b#\uC544\uB2C8\uBA74 \uB098 \uB108\uBB34 \uC774\uC0C1\uD574?$s#$e#\uD558\uD558\uD558... \uBB50 \uC5B4\uB54C. \uC5B8\uC820\uAC04 \uC54C\uAC8C \uB418\uACA0\uC9C0.$h"
