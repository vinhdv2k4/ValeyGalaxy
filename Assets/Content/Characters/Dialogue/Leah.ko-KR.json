  "Fri6": "\uAC00\uB054 \uC774\uC0C1\uD55C \uAE30\uBD84\uC774 \uB4E4\uC5B4. \uBA38\uB9AC\uAC00 \uC644\uC804\uD788 \uBE48 \uB290\uB08C... \uADF8\uB9AC\uACE0 \uB9C8\uC74C\uC774 \uD3B8\uC548\uD574\uC838, \uD589\uBCF5\uD55C \uAE30\uBD84\uB3C4 \uB4E4\uACE0.#$e#\uC544\uB2C8, \uC7A0\uAE50\uB9CC! \uC640\uC778\uC744 \uB9C8\uC2DC\uB294 \uAC70\uB791\uC740 \uBB34\uAD00\uD558\uB2E4\uACE0!$h",
  "Fri8": "\uAC00\uB054 \uB2E4\uB978 \uC0AC\uB78C\uC774 \uB41C\uB2E4\uBA74 \uC5B4\uB5A4 \uAE30\uBD84\uC77C\uAE4C \uC0DD\uAC01\uD574 \uBCF8 \uC801 \uC788\uC5B4?#$e#\uC0DD\uAC01\uD558\uB294 \uAC8C \uC5EC\uC804\uD788 \uBE44\uC2B7\uD560 \uC9C0, \uC544\uB2C8\uBA74 \uADF9\uB2E8\uC801\uC73C\uB85C \uC0DD\uAC01\uC758 \uBC29\uD5A5\uC774 \uBCC0\uD560\uC9C0 \uB9D0\uC774\uC57C.#$e#\uB108\uBB34 \uC2E0\uACBD \uC4F0\uC9C4 \uB9C8, \uB09C \uAC00\uB054 \uC774\uC0C1\uD55C \uC0DD\uAC01\uC744 \uD574\uC11C...$h",
  "Sat": "\uACC4\uC808\uB9C8\uB2E4 \uC0C8\uB85C\uC6B4 \uC7A5\uC2DD\uC744 \uD558\uB294 \uC77C\uC740 \uC815\uB9D0 \uC7AC\uBC0C\uC5B4.",
  "Sat8": "$query PLAYER_NPC_RELATIONSHIP current any married roommate#\uB098\uB3C4 \uC791\uBB3C\uC744 \uAE38\uB7EC\uBCFC\uAE4C \uD588\uB294\uB370, \uC544\uBB34\uB798\uB3C4 \uACF5\uAC04\uC744 \uB9CC\uB4E4\uB824\uACE0 \uC57C\uC0DD \uC2DD\uBB3C\uC744 \uC798\uB77C\uB0BC \uC0DD\uAC01\uC744 \uD558\uB2C8 \uBABB\uD558\uACA0\uB354\uB77C\uACE0.|\uB18D\uC7A5\uC77C \uB108\uBB34 \uC7AC\uBC0C\uC744 \uAC70 \uAC19\uC544. \uB098\uB3C4 \uC5B8\uC820\uAC00 \uD574\uBCF4\uACE0 \uC2F6\uC5B4.$l",
  "Sun": "\uB0B4 \uC624\uB450\uB9C9\uC5D0\uC11C \uCFF5\uCF85\uAC70\uB9AC\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4\uBA74, \uC544\uB9C8 \uADF8\uB0E5 \uB0B4\uAC00 \uC870\uAC01\uC0C1 \uC791\uC5C5\uD558\uB294 \uC18C\uB9AC\uC77C \uAC70\uC57C.",
  "Sun8": "\uD639\uC2DC \uBAA8\uC591\uC774 \uC2E0\uAE30\uD55C \uC720\uBAA9\uC744 \uBC1C\uACAC\uD55C\uB2E4\uBA74, \uB0B4\uAC00 \uC720\uC6A9\uD558\uAC8C \uC4F8 \uC218 \uC788\uC744\uAC70\uC57C.#$e#\uB124\uAC00 \uC92C\uB2E4\uB294 \uC0AC\uC2E4\uC774 \uADF8 \uB098\uBB34\uB97C \uD2B9\uBCC4\uD558\uAC8C \uB9CC\uB4E4\uACA0\uC9C0.",
  "event_sculpt1": "...\uBB50?$7#$b#\uC624! \uC751, \uB9DE\uC544, \uBC14\uB85C \uADF8\uAC70\uC57C!$h",
  "event_sculpt2": "\uADF8\uAC83\uB3C4 \uB098\uC05C \uACAC\uD574\uB294 \uC544\uB2C8\uB124... \uB0A0\uAC83\uC758, \uC788\uB294 \uADF8\uB300\uB85C\uC758 \uC790\uC5F0\uC5D0 \uB9CE\uC740 \uC544\uB984\uB2E4\uC6C0\uC774 \uC788\uB2E4\uACE0 \uC0DD\uAC01\uD574!#$b#\uD558\uC9C0\uB9CC \uC778\uAC04\uC73C\uB85C\uC11C \uC6B0\uB9AC\uAC00 \uC8FC\uBCC0 \uC138\uC0C1\uC744 \uC5B4\uB5BB\uAC8C \uD574\uC11D\uD558\uACE0 \uD615\uC131\uD558\uB294\uC9C0\uB3C4 \uD765\uBBF8\uAC00 \uC788\uC5B4... \uB2EC\uB9AC \uB9D0\uD558\uC790\uBA74 \u0027\uC608\uC220\u0027\uC5D0 \uAD00\uC2EC\uC774 \uC788\uB2E4\uB294 \uB9D0\uC774 \uB418\uB124.",
  "event_sculpt3": "\uC774 \uB3FC\uC9C0\uAC19\uC740 \uB188!%fork$a^\uC624! \uB108...? \uB098\uB3C4.$6#$b#\uB098\uAC00!$a^\uC54C\uBA74 \uC88B\uC9C0.$l",
  "event_parents1": "\uB124 \uB9D0\uC774 \uB9DE\uC544... \uB09C \uADF8\uACF3\uC5D0\uC11C \uD589\uBCF5\uD560 \uC218 \uC5C6\uC5C8\uC744 \uAC70\uC57C.$u#$b#\uC6B0\uB9AC \uBAA8\uB450\uB97C \uC704\uD574 \uC88B\uC740 \uBC29\uD5A5\uC774\uC5C8\uC5B4... \uC9C0\uC18D \uBD88\uAC00\uB2A5\uD55C \uAD00\uACC4\uB97C \uB05D\uB0B4\uB294 \uAC74 \uC544\uC9C1 \uC80A\uACE0 \uC735\uD1B5\uC131 \uC788\uC744 \uB54C\uAC00 \uB0AB\uC9C0.$u",
  "event_parents2": "\uC880 \uB0C9\uD639\uD558\uC9C0\uB9CC... \uADF8\uB798, \uB9DE\uC544. \uC6B0\uB9B0 \uAC00\uCE58\uAD00\uC774 \uB2EC\uB790\uC5B4.$u",
  "event_parents3": "\uADF8\uB798? \uADF8\uB7FC \uADF8\uB0E5 \uC5EC\uAE30\uB3C4 \uB5A0\uB098\uBC84\uB9AC\uACA0\uC5B4!%fork$a",
  "event_parents4": "*\uD55C\uC228*...$s#$b#\uB124 \uB9D0\uB3C4 \uB9DE\uC544... \uC880 \uC774\uAE30\uC801\uC774\uC5C8\uC5B4. \uADFC\uB370 \uB0B4\uAC00 \uD589\uBCF5\uD558\uACE0 \uC2F6\uC740 \uAC8C \uD0D3\uD560\uB9CC\uD55C \uC77C\uC778\uAC00? \uC73C... \uB09C \uC798 \uBAA8\uB974\uACA0\uC5B4...$s",
  "event_parents5": "*\uD55C\uC228*...$s#$b#\uB124\uAC00 \uB9DE\uC744 \uC218\uB3C4 \uC788\uACA0\uB2E4... \uC778\uAC04\uC740 \uC774\uAE30\uC801\uC774\uB2C8\uAE4C. \uBAA8\uB974\uACA0\uC5B4. $s#$b#\uB108\uBB34 \uC624\uB798 \uC0DD\uAC01\uD558\uBA74 \uC548 \uB418\uACA0\uC9C0. \uC6B0\uB9AC \uBAA8\uB450 \uB54C\uB54C\uB85C \uC5B4\uB824\uC6B4 \uACB0\uC815\uC744 \uB0B4\uB824\uC57C \uD558\uB2C8\uAE4C.$s",
  "summer_1": "\uACF5\uAE30 \uC911\uC5D0 \uD37C\uC9C0\uB294 \uACFC\uC77C \uB0C4\uC0C8\uB85C \uC5EC\uB984\uC774 \uC654\uB2E4\uB294 \uAC78 \uC54C \uC218 \uC788\uC9C0!$h",
  "summer_Mon": "\uC544\uCE68\uC5D0 \uC57C\uC0DD \uACFC\uC77C \uCC3E\uC558\uB294\uB370!#$e#\uBBF8\uC548, \uC9C0\uAE08\uC740 \uB0A8\uC740 \uAC8C \uC5C6\uC5B4.$s#$e#\uACC4\uC18D \uCC3E\uC544\uBD10, \uBD84\uBA85 \uBB54\uAC00 \uCC3E\uC744 \uC218 \uC788\uC744 \uAC70\uC57C.",
  "summer_Tue": "\uB18D\uC7A5 \uB3D9\uBB3C \uC18C\uB9AC \uC815\uB9D0 \uC88B\uC9C0, \uC548 \uADF8\uB798?",
  "summer_Tue4": "\uC778\uC0DD\uC5D0\uC11C \uC18C\uBC15\uD55C \uAC83\uB4E4\uC774 \uCD5C\uACE0\uC9C0: \uAC00\uBCBC\uC6B4 \uC5EC\uB984\uCCA0 \uC0B0\uB4E4\uBC14\uB78C, \uC7A5\uC5C4\uD55C \uAD6C\uB984, \uC2A4\uD0C0\uB4C0 \uBC38\uB9AC \uB808\uB4DC \uAC00\uB4DD\uD55C \uC794..",
  "summer_Thu6": "\uB0B4\uAC00 \uC57C\uC0DD \uACFC\uC77C\uC740 \uC798 \uCC3E\uC544. \uC5B8\uC81C \uD55C\uBC88 \uB9DB\uC788\uB294 \uACFC\uC77C \uC0D0\uB7EC\uB4DC \uB9CC\uB4E4\uC5B4\uC904\uAC8C.$h",
  "summer_Fri": "\uC218\uC561 \uCC44\uCDE8\uAE30\uB97C \uC368\uC11C \uB098\uBB34\uC5D0\uC11C \uBC14\uB85C \uC2DC\uB7FD\uC774\uB098 \uB2E4\uB978 \uC720\uC6A9\uD55C \uC561\uC744 \uBAA8\uC744 \uC218 \uC788\uC5B4.#$e#\uC880 \uC624\uB798 \uAC78\uB9AC\uB294 \uC791\uC5C5\uC774\uC9C0\uB9CC, \uACB0\uACFC\uBB3C\uC774 \uADF8\uB9CC\uD55C \uAC00\uCE58\uAC00 \uC788\uC9C0.",
  "summer_Fri2": "\uB108\uBB34 \uC9C1\uC124\uC801\uC778 \uB9D0\uC740 \uC880 \uADF8\uB807\uC9C0\uB9CC, \uC6B0\uB9AC\uAC00 \uC790\uC5F0\uC744 \uC874\uC911\uD558\uC9C0 \uC54A\uB294\uB2E4\uBA74, \uC6B0\uB9AC \uC190\uC790 \uC190\uB140\uB4E4\uC740 \uC8FD\uC740 \uBAA9\uC228\uC774\uB098 \uB2E4\uB984\uC5C6\uC5B4.#$e#\uB10C \uADF8\uB807\uAC8C \uC0DD\uAC01 \uC548 \uD574?",
  "summer_Fri4": "\uAC00\uB054 \uC232\uC744 \uAC77\uB2E4\uAC00... \uBA48\uCDB0 \uC11C\uC11C... \uADF8\uB0E5 \uC790\uC5F0\uC758 \uC544\uB984\uB2E4\uC6C0\uC744 \uAC10\uD0C4\uD558\uB294 \uB54C\uAC00 \uC788\uC5B4?#$e#\uC774 \uC138\uC0C1\uC774 \uC5BC\uB9C8\uB098 \uBA4B\uC9C4 \uACF3\uC778\uC9C0 \uC78A\uC744 \uB54C\uAC00 \uC788\uC9C0...",
  "summer_Fri6": "\uC548\uB155, @. \uADF8 \uD070 \uB18D\uC7A5\uC5D0\uC11C \uC678\uB85C\uC6B4 \uC801\uC740 \uC5C6\uC5B4?#$e#\uB300\uD654 \uC0C1\uB300\uAC00 \uD544\uC694\uD558\uBA74 \uC5B8\uC81C\uB77C\uB3C4 \uB0B4 \uC624\uB450\uB9C9\uC5D0 \uB180\uB7EC\uC640.$h",
  "summer_Sat": "\uC9D1 \uC606\uC5D0 \uBB3C\uC774 \uD750\uB974\uACE0 \uC788\uC5B4\uC11C \uC5EC\uB984\uC5D0 \uADF8\uB098\uB9C8 \uC2DC\uC6D0\uD55C \uAC70 \uAC19\uC544.#$e#\uB098 \uB354\uC704 \uC798 \uD0C0\uB294 \uD3B8\uC774\uC57C.",
  "summer_Sat4": "\uC5B4\uB290 \uC5EC\uB984 \uBC24\uC5D0 \uB108\uBB34 \uB354\uC6CC\uC11C \uCE68\uB300\uC5D0\uC11C \uB6F0\uCCD0\uB098\uC640 \uBC14\uB85C \uAC15\uC5D0 \uB6F0\uC5B4\uB4E0 \uC801\uC774 \uC788\uC5B4!#$e#\uC544\uBB34\uB3C4 \uBABB \uBD24\uC5B4\uC57C \uD558\uB294\uB370!$h",
  "summer_Sun": "\uC774\uB807\uAC8C \uB530\uB73B\uD558\uACE0 \uAC8C\uC73C\uB978 \uB0A0\uC5D0\uB294 \uBB58 \uD574\uC57C \uC88B\uC744\uAE4C? *\uD55C\uC228*#$e#\uB531\uD788 \uC0DD\uAC01\uB098\uB294 \uAC70 \uC5C6\uC5B4?",
  "fall_1": "\uACC4\uC808 \uC815\uB9D0 \uBE68\uB9AC \uBC14\uB00C\uB124!#$e#\uCDA9\uACA9\uC801\uC774\uC57C.",
  "fall_Mon": "#$c .5#\uC8FC\uB9D0\uC5D0 \uC57C\uC0DD \uBC84\uC12F\uC744 \uCC3E\uC558\uC5B4!#$e#\uC624\uB298 \uC544\uCE68\uC73C\uB85C \uC57C\uC0DD \uBC84\uC12F\uC774\uB791 \uACC4\uB780 \uC794\uB729 \uBA39\uC5C8\uC5B4... \uC544\uC9C1\uB3C4 \uBC30\uBD88\uB7EC.#$e#\uB545 \uC798 \uBCF4\uACE0 \uB2E4\uB2C8\uBA74 \uB108\uB3C4 \uBC84\uC12F \uC880 \uCC3E\uC744 \uAC70\uC57C... \uD655\uC2E0\uD574.",
  "fall_Tue": "\uB099\uC5FD\uC73C\uB85C \uCF5C\uB77C\uC8FC\uB97C \uB9CC\uB4E4 \uC218 \uC788\uC73C\uB824\uB098?#$e#\uC0C9\uC774 \uB2E4\uC591\uD558\uAC8C \uB108\uBB34 \uC608\uBED0... \uC608\uC220 \uD504\uB85C\uC81D\uD2B8\uB85C\uC11C\uC758 \uC7A0\uC7AC\uB825\uC5D0 \uB300\uD574\uC11C \uC790\uAFB8 \uC0DD\uAC01\uD558\uAC8C \uB3FC.$h",
  "fall_Tue4": "\uBCF8\uC778\uC774 \uBBFF\uAC74 \uB9D0\uAC74, \uBAA8\uB450\uB4E4 \uB3C5\uD2B9\uD558\uACE0 \uD765\uBBF8\uB85C\uC6B4 \uAD00\uC810\uC744 \uAC00\uC9C0\uACE0 \uC788\uC5B4. \uB10C \uADF8\uB807\uAC8C \uC0DD\uAC01 \uC548 \uD574?#$e#\uBB3C\uB860, \uB0B4\uAC00 \uC874\uC911\uD558\uAE30 \uD798\uB4E0 \uC758\uACAC\uC744 \uAC00\uC9C4 \uC0AC\uB78C\uB4E4\uB3C4 \uC788\uC9C0\uB9CC.",
  "fall_Wed": "\uAC15\uAC00\uC5D0 \uC0B4\uC544\uC11C \uB108\uBB34 \uC88B\uC544.#$e#\uBC24\uB9C8\uB2E4 \uBB3C \uD750\uB974\uB294 \uC794\uC794\uD55C \uC18C\uB9AC\uB97C \uB4E4\uC73C\uBA70 \uC7A0\uB4E4\uC5B4.",
  "fall_Thu6": "\uC5B8\uC81C \uD55C\uBC88 \uBC84\uC12F\uBCF6\uC74C \uC694\uB9AC\uD574\uC918\uC57C\uACA0\uB2E4.$h",
  "fall_Fri": "\uC9D1\uC5D0 \uC8FC\uBC29\uC740 \uC788\uC5B4?#$e#\uC8FC\uBC29\uC774 \uC788\uB2E4\uBA74, \uBCC4\uC758\uBCC4 \uB9DB\uC788\uB294 \uC74C\uC2DD\uC744 \uD574\uBA39\uC744 \uC218 \uC788\uC5B4.$h",
  "fall_Fri6": "\uB300\uD654 \uC0C1\uB300\uAC00 \uD544\uC694\uD558\uBA74 \uC5B8\uC81C\uB4E0\uC9C0 \uB0B4 \uC624\uB450\uB9C9\uC5D0 \uCC3E\uC544\uC640.$h",
  "fall_Sat": "\uC7A5\uC2DD\uC740 \uADF8 \uACC4\uC808\uC758 \uB290\uB08C\uC744 \uB450\uB4DC\uB7EC\uC9C0\uAC8C \uD574\uC8FC\uC9C0. \uD560 \uAC00\uCE58\uAC00 \uC788\uB294 \uC804\uD1B5\uC774\uB77C\uACE0 \uB09C \uC0DD\uAC01\uD574.",
  "fall_Sun": "\uC5EC\uAE34 \uAC78\uC5B4 \uB2E4\uB2C8\uAE30 \uC88B\uC740 \uACF3\uC774 \uB9CE\uC544.#$e#\uB2E4\uB9AC \uC880 \uD3B4\uACE0 \uB2E4\uB2C8\uB294 \uAC74 \uAE30\uBD84\uC774 \uC88B\uC544.",
  "fall_Sun4": "\uC5EC\uAE30 \uC544\uB984\uB2E4\uC6B4 \uD3ED\uD3EC\uB4E4\uC774 \uC788\uB294\uAC8C \uB108\uBB34 \uC88B\uB354\uB77C.#$e#\uAC00\uB054 \uADF8\uB0E5 \uAC00\uB9CC\uD788 \uBC14\uB77C\uBCF8 \uC801 \uC788\uC5B4? \uB9C8\uC74C\uC774 \uD3B8\uC548\uD574\uC838...",
  "winter_Mon": "\uBAA8\uB4E0 \uAC8C \uAE68\uB057\uD55C \uB208\uC73C\uB85C \uB4A4\uB36E\uC778 \uD48D\uACBD\uC774 \uB108\uBB34 \uB9C8\uC74C\uC5D0 \uB4E4\uC5B4.",
  "winter_Tue": "\uB0B4 \uC791\uC740 \uC624\uB450\uB9C9 \uC548\uC740 \uC880 \uCD94\uC6CC\uC9C0\uB354\uB77C.$s#$e#\uAC70\uB300\uD55C \uC774\uBD88 \uBC11\uC5D0 \uD30C\uACE0\uB4E4\uC5B4\uC788\uC73C\uBA74 \uADF8\uB798\uB3C4 \uB09C \uAD1C\uCC2E\uC544.$h",
  "winter_Wed": "\uC624\uB298 \uC774\uB978 \uC544\uCE68\uC5D0 \uB208\uD1A0\uB07C\uB97C \uBD24\uC5B4! \uD76C\uADC0\uD55C \uAC70\uC9C0, \uADF8\uCE58?",
  "winter_Thu": "\uBA39\uC744\uB9CC\uD55C \uC2E0\uC120\uD55C \uC74C\uC2DD\uC744 \uCC3E\uAE30 \uD798\uB4E4\uC5B4.#$e#\uC694\uC998 \uBE75\uC744 \uB9CE\uC774 \uBA39\uACE0 \uC788\uC5B4.$s",
  "winter_Thu6": "*\uD55C\uC228*... \uACA8\uC6B8\uC5D0\uB294 \uC2E0\uC120\uD55C \uC74C\uC2DD\uC744 \uAD6C\uD558\uAE30 \uD798\uB4E4\uC5B4.#$e#\uB18D\uC7A5\uC5D0\uB294 \uADF8\uB798\uB3C4 \uBAA8\uC544\uB454 \uC74C\uC2DD \uB9CE\uACA0\uB2E4, \uB9DE\uC9C0?",
  "winter_Fri": "\uC5EC\uAE30\uC11C \uC9C0\uB0B4\uBCF4\uB2C8 \uC2DC\uAC04\uC774 \uB354 \uCC9C\uCC9C\uD788 \uD750\uB974\uB294 \uAC83 \uAC19\uC544.#$e#\uB3C4\uC2DC\uC5D0 \uC0B4 \uB54C\uB294 \uC77C \uB144\uC774 \uB208 \uAE5C\uBE61\uD560 \uC0AC\uC774 \uC9C0\uB098\uAC14\uB294\uB370.",
  "winter_Fri6": "\uB18D\uAC00\uC5D0 \uC788\uB2E4 \uBCF4\uBA74 \uCD94\uC6CC\uC9C8 \uB54C\uB294 \uC5C6\uC5B4?#$e#\uB0B4 \uD03C\uD2B8 \uB36E\uACE0 \uC0AC\uC774\uB2E4 \uB9C8\uC2DC\uACE0 \uC2F6\uC73C\uBA74 \uC5B8\uC81C\uB77C\uB3C4 \uB0B4 \uC624\uB450\uB9C9\uC5D0 \uB180\uB7EC\uC640.$h",
  "winter_Sat": "\uC548\uB155. \uBB54\uAC00 \uD544\uC694\uD55C \uAC70 \uC788\uC5B4?",
  "winter_Sat2": "\uC548\uB155, @. \uD2B9\uBCC4\uD788 \uD558\uACE0 \uC2F6\uC740 \uC598\uAE30 \uC788\uC5B4?",
  "winter_Sun": "\uD639\uC2DC \uD558\uB8E8 \uC544\uC608 \uC26C\uB294 \uB0A0\uB3C4 \uC788\uC5B4?#$e#\uAE30\uBD84\uC774 \uC0C1\uCF8C\uD574\uC9C0\uB294 \uD734\uC2DD\uC774\uC9C0.",
  "winter_Sun4": "\uAC00\uB054\uC740 \uD558\uB8E8 \uC885\uC77C \uC26C\uB294 \uAC83\uB3C4 \uC88B\uC544.#$b#\uC601\uD63C\uC744 \uC704\uD574\uC11C\uB3C4 \uC88B\uC9C0\uB9CC, \uC7A5\uAE30\uC801\uC73C\uB85C\uB3C4 \uB354 \uC0DD\uC0B0\uC801\uC77C \uAC70\uC57C!"
