  "summer_Sun": "\uADF8... \uB18D\uAC00\uB97C \uAFB8\uBBF8\uB294 \uAC78 \uC88B\uC544\uD558\uB098\uC694?#$e#\uC790\uC2E0\uB9CC\uC758 \uAFB8\uBC00 \uC7A5\uC18C\uAC00 \uC788\uB294 \uAC74 \uCC38 \uC88B\uC740 \uAC83 \uAC19\uC544\uC694.",
  "summer_Sat": "\uC548\uB155\uD558\uC138\uC694. \uC5B4,\uC74C...$u#$b#\uC0B0\uC774 \uC624\uB298 \uCC38 \uBCF4\uAE30 \uC88B\uB124\uC694, \uC548 \uADF8\uB7F0\uAC00\uC694?$u",
  "fall_Mon": "\uC548\uB155\uD558\uC138\uC694... \uC74C, \uC694\uC998 \uAD1C\uCC2E\uB098\uC694?$u",
  "fall_Mon4": "\uB9C8\uC744\uC5D0\uC11C \uC720\uC77C\uD558\uAC8C \uD2B8\uB808\uC77C\uB7EC\uC5D0 \uC0AC\uB294 \uAC00\uC871\uC774\uB780 \uC0AC\uC2E4\uC774 \uC880 \uBD80\uB044\uB7EC\uC6CC\uC694.$u#$e#\uC5B8\uC820\uAC04 \uC88B\uC740 \uC9D1\uC5D0\uC11C \uC0B4 \uC218 \uC788\uC5C8\uC73C\uBA74 \uC88B\uACA0\uC5B4\uC694.$s",
  "fall_Tue4": "\uC9C0\uAE08 \uB18D\uC7A5 \uC815\uB9D0 \uC608\uBED0 \uBCF4\uC5EC\uC694.$h",
  "fall_Thu6": "\uC5B4\uBA38\uB2C8\uAED8\uC11C \uAC74\uAC15\uC744 \uC798 \uC548 \uCC59\uAE30\uC154\uC694...$u#$e#\uAC71\uC815\uB418\uB124\uC694.$u",
  "fall_Fri": "\uAC00\uC744\uC740 \uB098\uD55C\uD14C\uB294 \uC880 \uC2AC\uD508 \uACC4\uC808\uC774\uC5D0\uC694...$s",
  "fall_Fri6": "\uB0B4\uAC00 \uC5B4\uB838\uC744 \uB54C, \uC544\uBC84\uC9C0\uAED8\uC11C \u0027\uAC07\uD78C\u0027 \uB290\uB08C\uC744 \uBC1B\uB294\uB2E4\uBA74\uC11C \uC6B0\uB9B4 \uBC84\uB9AC\uACE0 \uB5A0\uB0AC\uC5B4\uC694. \uADF8 \uD6C4\uB85C \uBCF8 \uC801\uC774 \uC5C6\uC5B4\uC694.$s#$b#\uBD88\uD3B8\uD558\uAC8C \uD588\uB2E4\uBA74 \uBBF8\uC548\uD574\uC694... \uADF8\uB0E5 \uC774 \uACC4\uC808\uC774 \uB418\uBA74 \uC0DD\uAC01\uC774 \uB2E4\uC2DC \uB098\uB124\uC694.$u#$e#\uD558\uC5EC\uD2BC... \uB18D\uC7A5\uC5D0\uC11C \uC9C0\uB0B4\uB294 \uAC74 \uC694\uC998 \uC5B4\uB5A4\uAC00\uC694?",
  "fall_Sun10": "@! \uBBF8\uB798\uC5D0 \uB300\uD574\uC11C \uC0DD\uAC01\uD574\uBCF4\uACE0 \uC788\uC5C8\uC5B4\uC694...#$e#10\uB144 \uD6C4 \uC790\uC2E0\uC758 \uBAA8\uC2B5\uC740 \uC5B4\uB5A8 \uAC83 \uAC19\uC544\uC694?$l#$e#\uB098\uB3C4 \uBA87 \uAC00\uC9C0 \uC0DD\uAC01\uD574\uBCF8 \uAC8C \uC788\uC5B4\uC694...$u",
  "fall_Sat8": "@\uC528, \uC548\uB155\uD558\uC138\uC694.$h#$e#\uB18D\uAC00\uB294 \uCCAD\uC18C\uD558\uAE30 \uC218\uC6D4\uD558\uACA0\uC694.",
  "winter_Fri": "...\uB124?$u",
  "winter_Fri2": "\uB77C\uC774\uB108\uC2A4\uB791 \uCE5C\uD55C\uAC00\uC694? \uC0B0\uC911\uC5D0 \uD150\uD2B8\uB97C \uCE58\uACE0 \uC9C0\uB0B4\uACE0 \uC788\uC8E0.#$e#\uB2E4\uB4E4 \uADF8\uB97C \uBB34\uC2DC\uD574\uC694, \uB531\uD558\uAC8C\uB3C4. \uC815\uB9D0 \uC88B\uC740 \uBD84\uC778\uB370... \uC870\uAE08 \uD2B9\uC774\uD558\uAE34 \uD558\uC9C0\uB9CC\uC694.#$e#\uC774 \uACC4\uC808\uC5D0 \uD150\uD2B8\uC5D0\uC11C \uC9C0\uB0B4\uBA74 \uBB34\uCC99 \uCD94\uC6B8 \uAC70\uC608\uC694.",
  "winter_Tue4": "\uBD04\uC5D0 \uB18D\uC7A5\uC774 \uC5B4\uB5A4 \uBAA8\uC2B5\uC77C\uC9C0 \uAE30\uB300\uD558\uACE0 \uC788\uC5B4\uC694.#$e#\uC815\uB9D0 \uC2F1\uC2F1\uD558\uACE0 \uC544\uB984\uB2E4\uC6B8 \uAC70\uC608\uC694.$h",
  "winter_Tue": "\uACA8\uC6B8\uC5D0\uB294 \uB418\uB3C4\uB85D \uC2E4\uB0B4\uC5D0 \uC788\uC73C\uB824\uACE0 \uD574\uC694. \uCD94\uC6B4 \uAC74 \uC815\uB9D0 \uC9C8\uC0C9\uC774\uC5D0\uC694.",
  "winter_Thu": "\uC624... \uC548\uB155\uD558\uC138\uC694. \uD558\uACE0 \uC2F6\uC740 \uC598\uAE30\uAC00 \uC788\uB098\uC694?$u#$e#\uD765\uBBF8\uB85C\uC6B4 \uC720\uBB3C\uC774\uB098 \uAD11\uBB3C\uC744 \uCC3E\uC73C\uBA74 \uAC74\uD130\uAC00 \uBD84\uBA85 \uBC15\uBB3C\uAD00\uC5D0 \uC804\uC2DC\uD560 \uAC70\uC608\uC694.#$e#\uAE30\uC99D\uD558\uB294 \uBD84\uB4E4\uAED8 \uB4DC\uB9B4 \uD2B9\uBCC4\uD55C \uC120\uBB3C\uB3C4 \uC788\uB2E4\uACE0 \uC598\uAE30\uD574\uC92C\uC5B4\uC694.",
  "winter_Mon": "25\uC77C \uB0A0 \uC6B0\uB9AC \uACA8\uC6B8 \uBCC4\uC758 \uB9CC\uCC2C\uC774 \uC788\uC744 \uAC70\uC608\uC694. \uB0B4\uAC00 \uC81C\uC77C \uC88B\uC544\uD558\uB294 \uD589\uC0AC\uC608\uC694.#$e#\uB2F9\uC2E0\uC758 \uC0B6\uC5D0\uC11C \uC88B\uC740 \uAC83\uB4E4\uC5D0 \uB300\uD55C \uAC10\uC0AC\uB97C \uD45C\uD558\uB294 \uC2DC\uAC04\uC778 \uAC8C \uB9DE\uC9C0\uB9CC... \uB300\uBD80\uBD84 \uC0AC\uB78C\uB4E4\uC740 \uADF8\uB0E5 \uB290\uAE0B\uD558\uAC8C \uC26C\uACE0 \uC120\uBB3C\uC744 \uC11C\uB85C \uB098\uB204\uB294 \uC2DC\uAE30\uC8E0."
}