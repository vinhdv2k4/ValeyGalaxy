  "Wed2": "\uADF8\uAC70 \uC54C\uC544\uC694? \uC544\uC774\uB4E4 \uB370\uB9AC\uACE0 \uACAC\uD559 \uD55C\uBC88 \uAC00\uC57C\uACA0\uC5B4\uC694. \uC232\uC774\uB77C\uB358\uAC00.#$e#\uCD08\uBE59 \uAC15\uC0AC\uAC00 \uC788\uB294 \uAC83\uB3C4 \uC88B\uACA0\uB124\uC694... \uC790\uC5F0\uC5D0 \uB300\uD574 \uB9CE\uC774 \uC544\uB294 \uC0AC\uB78C\uC73C\uB85C?#$e#\uBBF8\uC548\uD574\uC694, \uC18C\uB9AC \uB0B4\uC11C \uC0DD\uAC01\uD558\uACE0 \uC788\uC5C8\uC5B4\uC694.",
  "GreenRain": "\uAD1C\uCC2E\uC73C\uC138\uC694? \uB2E4\uB4E4 \uC774\uAC8C \uBB34\uC2A8 \uC77C\uC778\uAC00 \uAC71\uC815\uD558\uACE0 \uC788\uC5B4\uC694...$3",
  "GreenRain_2": "\uC774 \uC774\uC0C1\uD55C \uB0A0\uC528\uB294 \uC544\uC774\uB4E4\uC774 \uC790\uC5F0\uC5D0 \uB300\uD55C \uAD00\uC2EC\uC744 \uD0A4\uC6B0\uAE30 \uC88B\uC740 \uAE30\uD68C\uC778 \uAC83 \uAC19\uC544\uC694!$h",
  "Wed4": "\uB09C \uD3C9\uC0DD \uD3A0\uB9AC\uCEE8 \uB9C8\uC744\uC5D0 \uC0B4\uC558\uC5B4\uC694. \uBBFF\uACA8\uC694?#$e#\uC800 \uBC16\uC758 \uC138\uC0C1\uC5D4 \uBD84\uBA85 \uB0B4\uAC00 \uACBD\uD5D8\uD574\uBCF4\uC9C0 \uBABB\uD560 \uAC83\uB4E4\uC774 \uB9CE\uACA0\uC8E0.",
  "Thu": "\uC774\uB807\uAC8C \uC791\uC740 \uB9C8\uC744\uC5D0 \uB3C4\uC11C\uAD00\uC774 \uC788\uB294 \uAC74 \uCC38 \uD589\uC6B4\uC774\uC5D0\uC694.#$e#\uCC45\uC5D0 \uD479 \uBE60\uC838\uC788\uC73C\uBA74, \uC0B6\uC758 \uD604\uC2E4\uC744 \uC78A\uAE30 \uC27D\uC8E0.$u#$e#...\uB0B4\uAC00 \uADF8\uB798\uC11C \uCC45\uC744 \uADF8\uB807\uAC8C \uB9CE\uC774 \uC77D\uB294 \uAC78\uAE4C.$s#$e#...\uBBF8\uC548\uD574\uC694. \uB9D0\uC744 \uB108\uBB34 \uB9CE\uC774 \uD588\uC8E0.",
  "Thu6": "\uC815\uC6D0\uC744 \uAC00\uAFB8\uACE0 \uC2F6\uC9C0\uB9CC, \uC55E\uB730\uC774 \uB108\uBB34 \uC5C9\uB9DD\uC774\uB124\uC694.$u#$e#\uC5B8\uC820\uAC00 \uC815\uC6D0\uC744 \uB458 \uC218 \uC788\uB294 \uACF3\uC5D0 \uC0B4\uAC8C \uB420\uC9C0\uB3C4 \uBAA8\uB974\uB294 \uC77C\uC774\uC8E0.#$e#\uB18D\uC7A5\uC5D0\uC11C \uC9C0\uB0BC\uC9C0\uB3C4 \uBAB0\uB77C\uC694! *\uD788\uD788*$h",
  "Fri": "\uAC00\uB054 \uB545\uC744 \uD30C\uBCF4\uBA74 \uC2E0\uAE30\uD55C \uBB3C\uAC74\uC744 \uCC3E\uC744 \uC218\uB3C4 \uC788\uC5B4\uC694.#$e#\uD55C \uBC88\uC740 \uC815\uB9D0 \uC624\uB798\uB41C \uB3C4\uC790\uAE30\uB97C \uCC3E\uC558\uC5B4\uC694. \uAC74\uD130\uC5D0\uAC8C \uAC00\uC838\uAC00\uBCF4\uB2C8 \uCC9C\uB144\uC740 \uB354 \uB41C \uBB3C\uAC74\uC774\uB77C\uACE0 \uD558\uB354\uAD70\uC694.",
  "Fri8": "\uC9D1\uC548\uC77C\uC5D0 \uB300\uD574 \uB108\uBB34 \uBD88\uD3C9\uD558\uBA74 \uC548 \uB418\uACA0\uC8E0... \uC138\uC0C1\uC5D4 \uC815\uB9D0 \uC5B4\uB824\uC6B4 \uBB38\uC81C\uB97C \uACAA\uB294 \uC0AC\uB78C\uB4E4\uC774 \uC788\uB294\uB370, \uC124\uAC70\uC9C0\uB9CC\uC73C\uB85C \uC774\uB807\uAC8C \uBD88\uD3C9\uD558\uB2E4\uB2C8...$s",
  "Fri4": "\uC124\uAC70\uC9C0, \uC124\uAC70\uC9C0, \uC124\uAC70\uC9C0. \uC73C... \uC5B4\uBA38\uB2C8\uAED8\uC11C \uD56D\uC0C1 \uC8FC\uC810\uC5D0\uC11C \uB2A6\uAC8C\uAE4C\uC9C0 \uACC4\uC2DC\uBA74\uC11C \uC219\uCDE8\uAC00 \uC788\uC9C0 \uC54A\uC73C\uC168\uB2E4\uBA74, \uC9D1\uC548\uC77C\uB3C4 \uC880 \uB3C4\uC640\uC8FC\uC168\uC744 \uD150\uB370.$s",
  "Sat": "\uC774 \uB9C8\uC744\uC740 \uCC38 \uC791\uC544\uC694. \uACB0\uAD6D \uB2E4\uB4E4 \uB9CC\uB098\uACE0 \uC54C\uAC8C \uB418\uC8E0.#$e#\uB3C4\uC2DC\uC5D0\uC11C \uC0AC\uB294 \uAC74 \uC5B4\uB5A4 \uB290\uB08C\uC77C\uAE4C \uAD81\uAE08\uD558\uB124\uC694.",
  "Sat2": "$d Joja#\uC870\uC790 \uB9C8\uD2B8\uAC00 \uC0DD\uAE34 \uB4A4\uB85C \uB9CE\uC740 \uAC8C \uBCC0\uD588\uC5B4\uC694. \uD53C\uC5D0\uB974\uB124 \uAC00\uAC8C \uC0C1\uD669\uC774 \uB9CE\uC774 \uC548 \uC88B\uC544\uC84C\uC5B4\uC694. \uD558\uC9C0\uB9CC \uC5B4\uBA38\uB2C8\uB294 \uC870\uC790 \uB9C8\uD2B8\uB97C \uC815\uB9D0 \uC88B\uC544\uD558\uC154\uC694. \uAC00\uACA9\uC774 \uC2F8\uC11C, \uD53C\uC5D0\uB974\uB124\uC11C \uC7A5\uC744 \uBCFC \uB54C\uBCF4\uB2E4 \uB354 \uB9CE\uC774 \uC0B4 \uC218 \uC788\uC5B4\uC694.|\uC870\uC790 \uB9C8\uD2B8\uAC00 \uBB38 \uB2EB\uC740 \uD6C4\uB85C \uC5B4\uBA38\uB2C8\uAED8\uC11C \uBD88\uD3C9\uC774 \uB298\uC73C\uC168\uC5B4\uC694. \uD558\uC9C0\uB9CC \uB09C \uC88B\uC740 \uC77C\uC774\uB77C \uC0DD\uAC01\uD574\uC694. \uC801\uC5B4\uB3C4 \uC608\uC804\uB9CC\uD07C \uC870\uC790 \uCF5C\uB77C\uB97C \uB9CE\uC774 \uB9C8\uC2DC\uC9C4 \uC54A\uACA0\uC8E0.",
  "Sun": "\uC548\uB155\uD558\uC138\uC694. \uC73C\uC74C...$u#$b#\uC624\uB298 \uB0A0\uC528 \uCC38 \uD765\uBBF8\uB86D\uC9C0 \uC54A\uB098\uC694?#$e#\uBBF8\uC548\uD574\uC694...$u",
