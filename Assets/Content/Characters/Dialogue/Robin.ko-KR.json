  "Sun": "\uB4DC\uBBF8\uD2B8\uB9AC\uC6B0\uC2A4\uAC00 \uBB34\uC2A8 \uACFC\uD559 \uC2E4\uD5D8\uC744 \uD558\uB2E4\uAC00 \uC9D1\uC744 \uD3ED\uD30C\uC2DC\uD0A4\uC9C0 \uC54A\uC544\uC57C \uD560 \uD150\uB370.#$e#\uC0AC\uC2E4 \uC815\uD655\uD788 \uC5B4\uB5A4 \uC5F0\uAD6C\uB97C \uD558\uB294\uC9C0 \uC798 \uBAA8\uB974\uACA0\uC5B4. \uBB54\uAC00 \uC2DD\uBB3C\uACFC \uAD00\uB828\uB41C \uAC83 \uAC19\uC740\uB370.",
  "Sun2": "#$1 RobinDem#\uC5B4\uC82F\uBC24\uC5D0 \uB0A8\uD3B8\uC774 \uC2E4\uD5D8\uC744 \uD558\uB2E4\uAC00 \uC9D1\uC5D0 \uBD88\uC774 \uBD99\uC5C8\uC5B4. \uBE44\uCEE4\uAC00 \uD130\uC9C0\uB354\uB2C8 \uC11C\uAE4C\uB798 \uCABD\uC73C\uB85C \uBD88\uB369\uC774\uAC00 \uB0A0\uC544\uAC14\uC5B4! \uC694\uBC14\uAED8 \uAC10\uC0AC\uD55C \uAC8C \uC5EC\uAE38 \uC9C0\uC744 \uB54C \uB0B4\uD654\uC131 \uB77C\uCEE4\uB85C \uCE60\uD588\uC9C0.$u#$e#\uC5EC\uAE30 \uB0C4\uC0C8\uAC00 \uC880 \uC774\uC0C1\uD558\uB2E4\uBA74 \uBBF8\uC548\uD574, @. \uB0A8\uD3B8\uC758 \uAE30\uC774\uD55C \uACFC\uD559 \uD504\uB85C\uC81D\uD2B8 \uB54C\uBB38\uC774\uC57C...",
  "Sun6": "\uC548\uB155 @! \uBC18\uAC00\uC6CC.#$e#\uC774\uC81C \uC9C4\uC9DC \uACF5\uB3D9\uCCB4\uC758 \uC8FC\uC694 \uC778\uC6D0\uC774 \uB418\uC5C8\uB124, \uC548 \uADF8\uB798?",
  "event_wood1": "\uC88B\uC544, \uADF8\uB7FC \uC774 \uCCAD\uC0AC\uC9C4\uC740 \uB124\uAC8C\uB294 \uAC04\uB2E8\uD560 \uAC70\uC57C!$h",
  "event_wood2": "\uADF8\uB807\uB2E4\uBA74, \uC2DC\uC791\uD558\uAE30 \uB531 \uC88B\uC740 \uCCAD\uC0AC\uC9C4\uC774 \uD558\uB098 \uC788\uC9C0!",
  "summer_Mon": "\uBAA9\uC7AC\uB294 \uCC38 \uB300\uB2E8\uD55C \uBB3C\uC9C8\uC774\uC57C... \uB2E4\uC6A9\uB3C4\uB85C \uC4F8 \uC218 \uC788\uACE0, \uAC12\uC2F8\uACE0, \uAC15\uD558\uACE0, \uD55C \uC870\uAC01 \uD55C \uC870\uAC01 \uC790\uC2E0\uB9CC\uC758 \uD2B9\uC131\uC774 \uC788\uC5B4!",
  "summer_Tue": "\uB18D\uC7A5\uC5D0 \uC788\uB294 \uAC74\uBB3C \uC5C5\uADF8\uB808\uC774\uB4DC\uAC00 \uD544\uC694\uD558\uBA74, \uB098\uD55C\uD14C \uBB3C\uC5B4\uBD10!#$e#\uD504\uB85C\uC81D\uD2B8\uB97C \uC9C4\uD589\uD558\uB824\uBA74 \uBAA9\uC7AC\uB791 \uB3CC\uC744 \uCDA9\uBD84\uD788 \uC81C\uACF5\uD574\uC918\uC57C \uD574. \uB3C8\uB3C4 \uB4E4 \uAC70\uACE0.#$e#\uD558\uC9C0\uB9CC \uACB0\uACFC\uB294 \uBD84\uBA85 \uB9CC\uC871\uC2A4\uB7EC\uC6B8 \uAC70\uC57C!$h",
  "summer_Fri": "\uC2A4\uD0C0\uB4C0 \uBC38\uB9AC\uB294 \uC138\uACC4 \uB2E4\uB978 \uACF3\uB4E4\uACFC \uC880 \uB3D9\uB5A8\uC5B4\uC9C4 \uD3B8\uC774\uC57C.#$e#\uC7A5\uB2E8\uC810\uC774 \uC788\uC5B4.",
  "fall_Mon": "#$1 RobinMaru#\uB9C8\uB8E8\uB294 \uBCF4\uC11D\uC744 \uC88B\uC544\uD574. \uBC1C\uBA85\uD488\uC5D0 \uC0AC\uC6A9\uD558\uB354\uB77C\uACE0.#$e#\uADF8\uB798, \uB9C8\uB8E8\uB791\uC740 \uCE5C\uD558\uAC8C \uC9C0\uB0B4?",
  "fall_Thu": "\uAF2D \uC5C5\uADF8\uB808\uC774\uB4DC\uB97C \uD558\uB824\uB294 \uAC8C \uC544\uB2C8\uB354\uB77C\uB3C4, \uC5B8\uC81C\uB4E0 \uBC29\uBB38 \uC624\uB294 \uAC74 \uD658\uC601\uC774\uC57C!$h#$e#\uC5EC\uAE30 \uC0B0\uC911\uC774\uB77C \uC880 \uB108\uBB34 \uC870\uC6A9\uD574\uC9C0\uB354\uB77C\uACE0.",
  "fall_Fri": "\uC6B0\uB9AC \uC9D1 \uB4A4\uCABD\uC5D0 \uC0AC\uB294 \uC57C\uC0DD\uC778 \uB9CC\uB098\uBD24\uB2C8?$s#$e#\uC0AC\uC2E4 \uB09C \uADF8\uB807\uAC8C \uC2E0\uACBD \uC4F0\uB294 \uD3B8\uC740 \uC544\uB0D0, \uC6B0\uB9AC\uB97C \uAD34\uB86D\uD788\uB294 \uAC83\uB3C4 \uC544\uB2C8\uACE0.",
  "winter_Mon": "\uC57C, \uB098\uBB34 \uCE90\uC11C \uBAA8\uC73C\uAE30 \uB531 \uC88B\uC740 \uC2DC\uAE30\uB124.#$e#\uC9D1\uC744 \uC5C5\uADF8\uB808\uC774\uB4DC\uD560 \uB9CC\uD07C \uB9CE\uC774 \uBAA8\uC744 \uC218\uB3C4 \uC788\uACA0\uB2E4!",
  "winter_Fri": "\uB0B4\uAC00 \uBAA9\uC218\uAC00 \uB418\uACE0 \uC2F6\uB2E4\uACE0 \uC598\uAE30\uD588\uC744 \uB54C \uBD80\uBAA8\uB2D8\uAED8\uC11C \uB9CE\uC774 \uB2F9\uD639\uC2A4\uB7EC\uC6CC\uD558\uC168\uC5B4.#$e#\uC0AC\uACE0\uBC29\uC2DD\uC774 \uC880 \uC804\uD1B5\uC801\uC778 \uBD84\uB4E4\uC774\uC168\uC5B4.",
  "winter_Fri_inlaw_Sebastian": "\uB18D\uC7A5\uC5D0\uC11C \uC9C0\uB0B4\uB294 \uAC74 \uC138\uBE44\uC5D0\uAC8C \uC815\uB9D0 \uAC74\uAC15\uD55C \uC0B6\uC774\uB77C\uACE0 \uC0DD\uAC01\uD574.",
  "winter_Sat": "\uC6B0\uB9AC \uC9D1 \uC815\uB9D0 \uC544\uB984\uB2E4\uC6B4 \uACF3\uC5D0 \uC788\uC9C0 \uC54A\uC544?#$e#\uAC13 \uB208\uC774 \uB0B4\uB9B0 \uB4A4\uC5D0 \uBAA8\uB4E0 \uAC8C \uB108\uBB34 \uACE0\uC694\uD574 \uBCF4\uC5EC."
