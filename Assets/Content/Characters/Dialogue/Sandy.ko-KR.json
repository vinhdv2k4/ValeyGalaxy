  "Wed": "\uC624 \uC548\uB155 \uC548\uB155! \uB9C8\uC744\uC5D0\uC11C \uC5D0\uBC00\uB9AC \uBCF4\uBA74 \uB0B4 \uC548\uBD80 \uC804\uD574\uC904\uB798?#$e#\uACE0\uB9C8\uC6CC!$h",
  "Thu": "\uC800\uCABD\uC5D0 \uC788\uB294 \uC218\uC0C1\uD574 \uBCF4\uC774\uB294 \uC0AC\uB78C? \uB09C \uC598\uAE30 \uD558\uBA74 \uC548 \uB418\uB294 \uAC70\uB77C\uC11C.#$e#\uADF8\uAC74 \uADF8\uB807\uACE0... \uACC4\uACE1 \uCABD \uB0A0\uC528\uB294 \uC5B4\uB54C?",
  "Fri": "\uC790\uAE30\uC57C, \uC5EC\uAE30\uC120 \uB18D\uC0AC\uC9C0\uC5B4\uB3C4 \uBCC4 \uC18C\uC6A9\uC5C6\uC744 \uAC70\uC57C.#$e#\uBB50, \uC120\uC778\uC7A5 \uB18D\uC7A5\uC744 \uCC28\uB9B4 \uAC70 \uC544\uB2CC \uC774\uC0C1.$h",
  "Sat": "\uC548\uB155\uD558\uC138\uC694! \uCE7C\uB9AC\uCF54 \uC0AC\uB9C9 \uCD5C\uACE0\uC758 \uBA85\uC18C, \uC0CC\uB514\uC758 \uC624\uC544\uC2DC\uC2A4\uC5D0 \uC624\uC2E0 \uAC78 \uD658\uC601\uD569\uB2C8\uB2E4!#$e#*\uC18C\uACE4* \uC5B4\uB54C, \uD504\uB85C \uAC19\uC9C0?$h#$e#\uC544, \uC6B0\uB9AC \uACC4\uC808 \uC528\uC557\uB3C4 \uAF2D \uBCF4\uACE0 \uAC00.#$e#\uC5B4\uBA38, \uBAA9\uB9D0\uB77C \uBCF4\uC778\uB2E4. \uC5EC\uAE30, \uCC28\uAC00\uC6B4 \uC6B0\uC720 \uD55C\uC794 \uB9C8\uC154\uBD10. [184]#$e#\uB9DB\uC788\uC9C0, \uADF8\uCE58?$h",
