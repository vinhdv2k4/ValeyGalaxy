  "Thu2": "\uC800\uCABD\uC5D0 \uC788\uB294 \uC218\uC0C1\uD574 \uBCF4\uC774\uB294 \uC0AC\uB78C? \uB09C \uC9C4\uC9DC \uC598\uAE30 \uD558\uBA74 \uC548 \uB418\uB294 \uAC70\uB77C\uC11C.#$e#\uADF8\uAC74 \uADF8\uB807\uACE0... \uACC4\uACE1 \uCABD \uB0A0\uC528\uB294 \uC5B4\uB54C?",
  "Thu4": "\uC57C... \uB110 \uBBFF\uC5B4\uB3C4 \uB420 \uAC83 \uAC19\uC544\uC11C. \uBE44\uBC00 \uC9C0\uD0AC \uC218 \uC788\uC9C0, \uADF8\uCE58?#$b#*\uC18C\uACE4* \uC800 \uB4A4\uCABD\uC5D0 \uC788\uB294 \uB0A8\uC790... \uBB34\uC2A8 \uD68C\uC6D0\uC81C \uD074\uB7FD\uC774\uC57C. \uB098\uB3C4 \uB4E4\uC5B4\uAC00 \uBCF8 \uC801\uC740 \uC5C6\uB294\uB370, \uB098\uD55C\uD14C \uC6D4\uC138\uB97C \uC6CC\uB099 \uB9CE\uC774 \uC8FC\uACE0 \uC788\uC5B4\uC11C \uBCC4\uB2E4\uB978 \uAC74 \uC548 \uBB3C\uC5B4\uBCF4\uACE0 \uC788\uC5B4.#$e#\uADF8\uC73C\uC73C\uC73C\uB798\uC11C! \uC694\uC998 \uACC4\uACE1 \uCABD \uB0A0\uC528\uB294 \uC5B4\uB54C?",
  "Fri4": "\uB0B4 \uC774\uB984 \uC0AC\uC2E4 \uC0CC\uB514 \uC544\uB2C8\uB2E4. \uADF8\uB0E5 \uC601\uC5C5\uC0C1 \uC88B\uC544\uC11C \uC4F0\uB294 \uAC70\uC57C.#$e#\uADFC\uB370 \uB2E4\uB4E4 \uC0CC\uB514\uB77C\uACE0 \uBD88\uB7EC\uC11C, \uC774\uC81C \uC775\uC219\uD574\uC84C\uC5B4.",
  "Wed8": "\uC0AC\uB9C9\uC5D0 \uC774\uB807\uAC8C \uC790\uC8FC \uC624\uBA74 \uB3C8 \uB9CE\uC774 \uB4E4\uC9C0 \uC54A\uC544?#$e#\uB098 \uC815\uB9D0 \uB9CE\uC774 \uBCF4\uACE0 \uC2F6\uC740 \uAC70\uAD6C\uB098? \uD750\uC74C... $h||*\uD734\uC6B0*... \uC2A4\uD0C0\uB4C0 \uBC38\uB9AC\uC758 \uC608\uC05C \uAF43\uB4E4\uC774 \uB108\uBB34 \uBCF4\uACE0 \uC2F6\uB2E4...$s",
  "Sun8": "\uC548\uB155 \uC548\uB155, \uC790\uAE30\uC57C. \uC6C5, \uC774 \uD070 \uAC00\uAC8C\uC5D0 \uB098\uBFD0\uC774\uC9C0. \uD750\uC74C...#$e#\uBB50, \uC800\uCABD\uC5D0 \uC788\uB294 \uC800 \uC624\uC2F9\uD55C \uB0A8\uC790 \uBE7C\uACE0\uB294 \uB9D0\uC774\uC9C0. \uADFC\uB370 \uAF3C\uC9DD\uB3C4 \uC548 \uD574\uC11C, \uC800\uAE30 \uC788\uB2E4\uB294 \uAC78 \uAE5C\uBE61\uD558\uACE4 \uD574.",
  "Wed10": "\uC5B4\uBA38, @(\uC774)\uC796\uC544! \uBD10\uC11C \uB108\uBB34 \uBC18\uAC11\uB2E4, \uC598. \uB2E4\uC2DC\uB294 \uC548 \uB3CC\uC544\uC624\uB294 \uC904 \uC54C\uC558\uC5B4!#$e#\uB0B4\uAC00 \uAC00\uAC8C\uB9CC \uC548 \uBD10\uB3C4 \uB410\uB2E4\uBA74 \uB108 \uBCF4\uB7EC \uACC4\uACE1\uC73C\uB85C \uD558\uB8E8 \uC774\uD2C0 \uC815\uB3C4 \uAC08 \uD150\uB370... \uB18D\uC7A5\uC5D0 \uB108\uB791 \uB098\uB791 \uB2E8\uB458\uC774.$s#$e#\uB098 \uC6B0\uC6B8\uD574\uC9C0\uC9C0 \uC54A\uAC8C \uC880 \uB354 \uC790\uC8FC \uBCF4\uB7EC \uC624\uB780 \uB9D0\uC774\uC57C.$h",
