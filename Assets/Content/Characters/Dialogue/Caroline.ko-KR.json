  "Mon_inlaw_Abigail": "\uC548\uB155, @. \uACB0\uD63C\uC0DD\uD65C\uC740 \uC990\uAC81\uB2C8? \uADF8\uB7EC\uAE38 \uBC14\uB780\uB2E4!",
  "Mon8": "#$1 Caroline23#\uC6B0\uB9AC\uAC00 \uCC98\uC74C \uD3A0\uB9AC\uCEE8 \uB9C8\uC744\uC73C\uB85C \uC774\uC0AC \uC654\uC744 \uB54C \uC885\uC885 \uB9C8\uBC95\uC0AC\uC758 \uD0D1\uC73C\uB85C \uBAB0\uB798 \uC0B0\uCC45 \uAC00\uACE4 \uD588\uC5B4. \uD53C\uC5D0\uB974\uD55C\uD150 \uC598\uAE30\uD558\uC9C0 \uB9D0\uC544, \uC9C8\uD22C\uC2EC\uC774 \uC880 \uB9CE\uAC70\uB4E0.#$e#\uC560\uBE44\uAC8C\uC77C\uC740 \uC6B0\uB9AC\uAC00 \uD3A0\uB9AC\uCEE8 \uB9C8\uC744\uC5D0 \uC624\uACE0 \uC77C \uB144\uCBE4 \uD6C4\uC5D0 \uD0DC\uC5B4\uB0AC\uC5B4. \uC560\uBE44\uAC00 \uC774 \uACC4\uACE1 \uBC16\uC758 \uC0B6\uC744 \uACBD\uD5D8\uD560 \uB0A0\uC774 \uC62C\uAE4C?",
  "Tue": "\uC232\uC5D0\uC11C \uC57C\uC0DD \uACE0\uCD94\uB0C9\uC774\uB97C \uBCF8 \uC801 \uC788\uC5B4.#$e#\uCC44\uC9D1\uC740 \uC7AC\uBBF8\uB3C4 \uC788\uACE0 \uB3C8\uB3C4 \uBC8C \uC218 \uC788\uB294 \uD65C\uB3D9\uC774\uC9C0. \uC544\uB2C8\uBA74 \uCC3E\uC544\uB0B8 \uAC78 \uBA39\uAC70\uB098 \uC120\uBB3C\uD560 \uC218\uB3C4 \uC788\uACE0.",
  "Wed": "\uC548\uB155. \uB18D\uC7A5\uC5D0 \uD544\uC694\uD55C \uBB3C\uD488\uC740 \uB2E4 \uC788\uB2C8?#$e#\uC544\uB2C8\uB77C\uBA74, \uC6B0\uB9AC\uAC00 \uB3C4\uC640\uC904 \uC218\uB3C4 \uC788\uC5B4.#$e#\uC720\uC6A9\uD55C \uBB3C\uD488\uC744 \uB2E4\uC591\uD558\uAC8C \uD314\uACE0 \uC788\uC73C\uB2C8\uAE4C.",
  "Thu": "#$1 Caroline1#\uD750\uC74C... \uC624\uB298 \uC800\uB141\uC740 \uD53C\uC5D0\uB974\uAC00 \uB9CC\uB4E4\uAC8C \uD560 \uC218 \uC788\uC73C\uB824\uB098.#$e#\uD750\uC74C... \uC624\uB298 \uC800\uB141\uC740 \uBB50 \uB9CC\uB4E4\uC9C0?#$e#\uADF8\uB0E5 \uC220\uC9D1\uC5D0\uC11C \uD3EC\uC7A5\uD574\uC62C\uAE4C \uC2F6\uB124.",
  "Fri": "\uB0A0\uC528\uAC00 \uCC38 \uC88B\uB124.#$e#\uC774\uB7F0 \uB0A0\uC5D4 \uACF5\uACF5\uB18D\uC6D0\uC5D0\uC11C \uC5D0\uBE14\uB9B0\uC744 \uB3D5\uACE4 \uD574.#$e#\uB098\uC774\uC5D0 \uBE44\uD574 \uAC15\uD558\uAE34 \uD558\uC2DC\uC9C0\uB9CC, \uB3C4\uC6C0\uC744 \uB9C8\uB2E4\uD558\uC2DC\uC9C4 \uC54A\uC73C\uB2C8\uAE4C.",
  "Sat": "\uC560\uBE44\uAC8C\uC77C\uC774 \uC720\uB3C5 \uC554\uC6B8\uD55C \uAC83\uC5D0 \uC9C0\uB098\uCE58\uAC8C \uAD00\uC2EC\uC774 \uB9CE\uC740 \uAC83 \uAC19\uC544. \uB098\uB9CC \uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uB294 \uAC74\uAC00?#$e#\uC5B4\uCA4C\uBA74 \uC774\uD574\uD558\uAE30\uC5D4 \uB0B4\uAC00 \uB098\uC774\uAC00 \uB108\uBB34 \uB9CE\uC544\uC9C4 \uAC78\uC9C0\uB3C4.",
  "Sat_inlaw_Abigail": "\uC560\uBE44\uAC8C\uC77C\uC774 \uC774\uC0AC \uB098\uAC04 \uB4A4\uB85C \uC800\uB141\uC2DC\uAC04\uC774 \uB9CE\uC774 \uC870\uC6A9\uD574\uC84C\uC5B4...#$e#\uC544\uB2C8, \uC785\uC744 \uC5F4\uACE0 \uC74C\uC2DD\uC744 \uC539\uC5B4\uC11C \uADF8\uB807\uB2E4\uB294 \uAC8C \uC544\uB2C8\uB77C!$h",
  "Sat2": "\uC560\uBE44\uB294 \uD56D\uC0C1 \uCD08\uC790\uC5F0\uC801\uC778 \uAC83\uC5D0 \uC774\uC0C1\uD558\uAC8C \uAD00\uC2EC\uC774 \uB9CE\uC558\uC5B4. \uC5B4\uB514\uC11C \uADF8\uB7F0 \uCDE8\uD5A5\uC774 \uC0DD\uAE34 \uAC74\uC9C0 \uC798 \uBAA8\uB974\uACA0\uC5B4...",
  "Sat4": "\uC560\uBE44\uB294 \uD56D\uC0C1 \uCD08\uC790\uC5F0\uC801\uC778 \uAC83\uC5D0 \uC774\uC0C1\uD558\uAC8C \uAD00\uC2EC\uC774 \uB9CE\uC558\uC5B4. \uC5B4\uB514\uC11C \uADF8\uB7F0 \uCDE8\uD5A5\uC774 \uC0DD\uAE34 \uAC74\uC9C0 \uC798 \uBAA8\uB974\uACA0\uC5B4...",
  "Sat6": "#$1 Caroline12#\uC6B0\uB9AC\uAC00 \uC5EC\uAE30 \uCC98\uC74C \uC774\uC0AC \uC654\uC744 \uB54C, \uB09C \uC790\uB9AC \uC7A1\uB294\uB370 \uC2DC\uAC04\uC774 \uC880 \uAC78\uB838\uC5B4... \uC544\uC9C1 \uC0B4\uB9BC\uC744 \uD560 \uB9C8\uC74C\uC758 \uC900\uBE44\uAC00 \uC548\uB410\uC5C8\uC9C0.#$e#\uD53C\uC5D0\uB974\uB294 \uC880 \uC804\uD1B5\uC801\uC774\uC57C... \uD558\uC9C0\uB9CC \uC88B\uC740 \uC0AC\uB78C\uC774\uC57C. \uC57C\uC2EC \uC788\uC9C0\uB9CC, \uD56D\uC0C1 \uAC00\uC871\uC744 \uBA3C\uC800 \uC0DD\uAC01\uD558\uACE0.",
  "Sun": "\uC624\uB298 \uB09C \uADF8\uB0E5 \uC26C\uBA74\uC11C \uAE0D\uC815\uC801\uC778 \uC0DD\uAC01\uC744 \uD560 \uAC70\uC57C.#$e#\uB108\uB3C4 \uADF8\uB0E5 \uC26C\uB294 \uB0A0\uC774 \uC788\uC5B4?",
  "Wed6": "\uC2A4\uD0C0\uB4C0 \uBC38\uB9AC\uB3C4 \uC88B\uC9C0\uB9CC, \uC880 \uB354 \uB9CE\uC740 \uC0AC\uB78C\uB4E4\uC744 \uB9CC\uB0AC\uC73C\uBA74 \uC88B\uACA0\uC5B4.#$e#\uC6B0\uB9AC\uAC00 \uCE5C\uD574\uC838\uC11C \uAE30\uBED0.",
  "summer_Mon": "\uC218\uC694\uC77C\uC740 \uAC00\uAC8C\uB97C \uB2EB\uC544.#$e#\uD639\uC2DC \uAE09\uD560 \uB54C \uAE4C\uBA39\uC744 \uC218\uB3C4 \uC788\uC73C\uB2C8\uAE4C, \uC798 \uAE30\uC5B5\uD574\uB450\uACE0.",
  "summer_Tue": "\uC694\uC998 \uC232\uC5D0\uC11C \uC57C\uC0DD \uACFC\uC77C\uC774 \uB9CE\uC774 \uBCF4\uC774\uB354\uB77C.#$e#\uCC44\uC9D1\uC740 \uC7AC\uBBF8\uB3C4 \uC788\uACE0 \uB3C8\uB3C4 \uBC8C \uC218 \uC788\uB294 \uD65C\uB3D9\uC774\uC9C0. \uC544\uB2C8\uBA74 \uCC3E\uC544\uB0B8 \uAC78 \uBA39\uAC70\uB098 \uC120\uBB3C\uD560 \uC218\uB3C4 \uC788\uACE0.",
