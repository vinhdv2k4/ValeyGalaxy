  "summer_Sat": "\uB098\uB9CC \uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uB294 \uAC74\uC9C0 \uBAA8\uB974\uACA0\uB294\uB370, \uC560\uBE44\uAC8C\uC77C \uB108\uBB34 \uCC3D\uBC31\uD574 \uBCF4\uC774\uC9C0 \uC54A\uC544?#$e#\uC5B4\uCA4C\uBA74 \uADF8\uB0E5 \uB0B4\uAC00 \uB108\uBB34 \uAC71\uC815\uD558\uB294 \uAC78\uC9C0\uB3C4.",
  "summer_Sat_inlaw_Abigail": "\uC560\uBE44\uAC8C\uC77C\uC740 \uC694\uC998 \uAC74\uAC15\uD558\uB2C8? \uD56D\uC0C1 \uADF8\uB807\uAC8C \uCC3D\uBC31\uD588\uC5B4\uC11C. \uB18D\uC7A5 \uC0DD\uD65C\uC774 \uC880 \uC548\uC0C9\uC5D0 \uD65C\uB825\uC744 \uBD88\uC5B4\uB123\uC5C8\uC73C\uBA74 \uC88B\uACA0\uB2E4.",
  "summer_Sun": "\uC624\uB298 \uB09C \uADF8\uB0E5 \uC26C\uBA74\uC11C \uAE0D\uC815\uC801\uC778 \uC0DD\uAC01\uC744 \uD560 \uAC70\uC57C.#$e#\uB108\uB3C4 \uADF8\uB0E5 \uC26C\uB294 \uB0A0\uC774 \uC788\uC5B4?",
  "summer_Wed6": "\uB098\uC774\uAC00 \uB4E4\uC218\uB85D \uC2DC\uAC04\uC774 \uC810\uC810 \uB354 \uBE68\uB9AC \uAC00\uB294 \uB290\uB08C\uC774\uC57C...$s",
  "fall_Mon": "\uAC00\uC744\uC774 \uC560\uBE44\uAC00 \uC81C\uC77C \uC88B\uC544\uD558\uB294 \uACC4\uC808\uC774\uB77C, \uBC29\uC5D0\uC11C \uC880 \uB354 \uC790\uC8FC \uB098\uC624\uAE38 \uBC14\uB77C\uACE0 \uC788\uC5B4.",
  "fall_Mon_inlaw_Abigail": "\uC560\uBE44\uAC00 \uC5EC\uAE30\uC11C \uC628\uB77C\uC778 \uC218\uC5C5\uC744 \uB4E3\uACE4 \uD588\uB294\uB370, \uADF8\uB807\uAC8C \uBAB0\uB450\uD558\uB294 \uB290\uB08C\uC740 \uC544\uB2C8\uC5C8\uC5B4...#$e#\uC790\uC720\uB85C\uC6B4 \uC601\uD63C\uC774\uC57C, \uD53C\uC5D0\uB974\uB97C \uB9CC\uB098\uAE30 \uC804\uC758 \uB098\uCC98\uB7FC. \uC544\uB9C8 \uB124 \uB18D\uC7A5\uC5D0\uC11C \uC815\uB9D0 \uCD5C\uACE0\uC758 \uC2DC\uAC04\uC744 \uBCF4\uB0B4\uACE0 \uC788\uC744 \uAC70\uC57C.",
  "fall_Tue": "\uBC84\uC12F\uC5D0\uC11C \uC2DD\uC6A9 \uBC84\uC12F\uC744 \uBD24\uC5B4#$e#\uCC44\uC9D1\uC740 \uC7AC\uBBF8\uB3C4 \uC788\uACE0 \uB3C8\uB3C4 \uBC8C \uC218 \uC788\uB294 \uD65C\uB3D9\uC774\uC9C0. \uC544\uB2C8\uBA74 \uCC3E\uC544\uB0B8 \uAC78 \uBA39\uAC70\uB098 \uC120\uBB3C\uD560 \uC218\uB3C4 \uC788\uACE0.",
  "fall_Sat": "\uB098\uB9CC \uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uB294 \uAC74\uC9C0\uB294 \uBAA8\uB974\uACA0\uB294\uB370, \uC560\uBE44\uAC8C\uC77C \uAC8C\uC784 \uB108\uBB34 \uB9CE\uC774 \uD558\uC9C0 \uC54A\uB2C8?#$e#\uADF8\uB0E5 \uB0B4 \uC0AC\uACE0\uBC29\uC2DD\uC774 \uB108\uBB34 \uC61B\uB0A0 \uC2DD\uC778 \uAC78\uAE4C.",
  "fall_Wed6": "\uC0AC\uC2E4, \uB098\uB3C4 \uC608\uC804\uC5D0 \uB18D\uBD80\uAC00 \uB418\uACE0 \uC2F6\uC5C8\uB2E4? \uBB50, \uC0AC\uC2E4 \uBAA9\uC7A5 \uC8FC\uC778\uC774 \uB418\uACE0 \uC2F6\uC740 \uAC70\uC600\uC9C0.#$e#\uC5B4\uB838\uC744 \uB54C \uC11C\uBD80 \uC601\uD654\uB97C \uD56D\uC0C1 \uC0AC\uB791\uD588\uC5C8\uC5B4.",
  "winter_Tue": "\uACA8\uC6B8\uC774 \uC880 \uB0C9\uD639\uD560 \uC218\uB3C4 \uC788\uC9C0\uB9CC, \uC6B4\uC774 \uC88B\uB2E4\uBA74 \uAD1C\uCC2E\uC740 \uBFCC\uB9AC\uB97C \uCE98 \uC218\uB3C4 \uC788\uC5B4.#$e#\uCC44\uC9D1\uC740 \uC7AC\uBBF8\uB3C4 \uC788\uACE0 \uB3C8\uB3C4 \uBC8C \uC218 \uC788\uB294 \uD65C\uB3D9\uC774\uC9C0. \uC544\uB2C8\uBA74 \uCC3E\uC544\uB0B8 \uAC78 \uBA39\uAC70\uB098 \uC120\uBB3C\uD560 \uC218\uB3C4 \uC788\uACE0.",
  "winter_Fri": "\uC544\uC9C1 \uCDA5\uAE34 \uD558\uC9C0\uB9CC, \uC885\uC885 \uACF5\uACF5\uB18D\uC6D0\uC5D0 \uAC00\uC11C \uD654\uB2E8\uC744 \uD655\uC778\uD558\uACE4 \uD574.#$e#\uADF8\uB0E5 \uBD04\uC774 \uC624\uAE30 \uC804\uC5D0 \uB108\uBB34 \uC190\uC0C1\uB418\uC9C4 \uC54A\uB098 \uD655\uC778\uD558\uB824\uACE0.",
  "winter_Sat": "\uC560\uBE44 \uC6D0\uB798 \uBA38\uB9AC\uC0C9\uC774 \uB354 \uC798 \uC5B4\uC6B8\uB9B4 \uAC83 \uAC19\uC9C0 \uC54A\uC544?#$e#\uC6D0\uB798\uB294 \uC5F0\uD55C \uC801\uAC08\uC0C9 \uBA38\uB9AC\uC600\uC5B4.",
  "winter_Wed6": "\uC0C8\uD574\uAC00 \uAE30\uB300\uB418\uB2C8?#$e#\uB124\uAC00 \uB18D\uC7A5 \uC77C\uB85C \uB300\uC131\uACF5\uD560 \uAC70\uB77C\uACE0 \uB09C \uC608\uC0C1\uD574.$h"
}