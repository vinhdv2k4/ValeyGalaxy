  "Resort_Chair": "%\uCE90\uB864\uB77C\uC778\uC774 \uB0AE\uC7A0\uC744 \uC790\uB824 \uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.",
  "Resort_Bar": "\uAC70\uC2A4\uD55C\uD14C \uB9DB\uC788\uB294 \uAC70 \uC544\uBB34\uAC70\uB098 \uB9CC\uB4E4\uC5B4\uB2EC\uB77C\uACE0 \uD558\uB2C8\uAE4C, \uB9DD\uACE0 \uC81C\uC2A4\uD2B8\uAC00 \uB4E4\uC5B4\uAC04 \uC544\uC774\uC2A4 \uB179\uCC28\uB97C \uB9CC\uB4E4\uC5B4\uC92C\uC5B4. \uB108\uBB34 \uC88B\uC544!$h",
