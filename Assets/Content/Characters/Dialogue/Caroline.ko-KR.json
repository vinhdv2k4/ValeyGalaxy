  "eventSeen_719926": "\uC880 \uD3B8\uC548\uD574\uC84C\uB2C8? \uB2F9\uC5F0\uD788 \uADF8\uB807\uACA0\uC9C0...",
  "houseUpgrade_1": "$y \u0027\uC0C8 \uC8FC\uBC29\uC744 \uB9C8\uB828\uD588\uB2E4\uACE0 \uB4E4\uC5C8\uC5B4! \uC55E\uC73C\uB85C \uC694\uB9AC \uB9CE\uC774 \uD560 \uC608\uC815\uC774\uB2C8?_\uADF8\uB7EC\uB824\uACE0\uC694!_\uC694\uB9AC\uD560 \uC904 \uC54C\uBA74 \uC720\uC6A9\uD558\uC9C0. \uB18D\uC7A5\uC5D0\uC11C \uBC14\uB85C \uD0A4\uC6B4 \uC2F1\uC2F1\uD55C \uC791\uBB3C\uB3C4 \uC788\uC73C\uB2C8 \uB531 \uC88B\uB124!_\uC544\uB1E8, \uADF8\uB0E5 \uBCF4\uAE30 \uC88B\uC73C\uB77C\uACE0 \uC788\uB294 \uAC70\uC608\uC694_\uADF8\uB807\uAD6C\uB098. \uADF8\uB798\uB3C4 \uC2DD\uC0AC\uB294 \uCC59\uACA8\uC11C \uBA39\uACE0... \uAC74\uAC15 \uC0DD\uAC01\uD574\uC57C\uC9C0.\u0027",
  "achievement_15": "\uB124 \uB18D\uC7A5 \uCABD\uC5D0\uC11C \uC88B\uC740 \uB0C4\uC0C8\uAC00 \uB098\uB358\uB370, \uC8FC\uBC29 \uC798 \uD65C\uC6A9\uD558\uACE0 \uC788\uAD6C\uB098!$h",
