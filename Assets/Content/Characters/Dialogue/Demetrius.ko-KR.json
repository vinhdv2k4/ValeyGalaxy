  "summer_Thu": "\uB18D\uC7A5 \uC77C\uC740 \uC694\uC998 \uC5B4\uB54C? \uC9C0\uAE08 \uD1A0\uB9C8\uD1A0 \uC2DC\uC98C\uC774\uC9C0, \uADF8\uCE58?#$e#\uC57C\uC678\uC5D0\uC11C \uD558\uB8E8 \uC885\uC77C \uC2DD\uBB3C \uBCF4\uBA74\uC11C \uC77C\uD558\uB294 \uAC74 \uCC38 \uD3C9\uD654\uB85C\uC6B8 \uAC70 \uAC19\uC544.",
  "summer_Fri": "$p 40#\uB9C8\uB8E8\uB791 \uB4A4\uB730\uC5D0 \uC788\uB294 \uB9DD\uC6D0\uACBD \uC368\uBD24\uB2E4\uBA70?|\uB9C8\uB8E8\uB791 \uCE5C\uD574\uC9C0\uBA74 \uBD84\uBA85 \uB4A4\uB730\uC5D0 \uC788\uB294 \uB9DD\uC6D0\uACBD \uC5B4\uB5BB\uAC8C \uC4F0\uB294\uC9C0 \uC54C\uB824\uC904 \uAC70\uC57C.#$e#\uD765\uBBF8\uC9C4\uC9C4\uD558\uC9C0?",
  "summer_Fri_inlaw_Maru": "\uB538\uC544\uC774\uAC00 \uC218\uD559\uC774\uB791 \uACFC\uD559 \uACF5\uBD80\uB294 \uAFB8\uC900\uD788 \uD558\uACE0 \uC788\uC5B4\uC57C \uD560 \uD150\uB370!",
  "summer_Sat": "\uD760... \uC2A4\uD2B8\uB9AC\uACE0\uB77D\uD1A4 \uC591\uC744 \uB298\uB9B4 \uC218 \uC788\uB2E4\uBA74, \uADE0\uADFC \uC131\uC7A5\uB3C4 \uBE44\uB840\uD558\uB294 \uD6A8\uACFC\uAC00 \uC788\uC73C\uB824\uB098?$u#$b#\uC624! \uBBF8\uC548. \uB370\uC774\uD130 \uC880 \uACF0\uACF0\uC774 \uC0DD\uAC01\uD558\uB2E4\uAC00 \uB124\uAC00 \uC628 \uC904\uB3C4 \uBAB0\uB790\uB124.#$e#\uBB58 \uB3C4\uC640\uC904\uAE4C?",
  "summer_Mon6": "\uB09C \uC6B0\uB9AC \uC778\uB958\uC758 \uC9C4\uCC99\uC5D0 \uAE30\uC5EC\uD558\uACE0 \uC2F6\uC5B4\uC11C \uACFC\uD559\uC790\uAC00 \uB418\uC5C8\uC5B4.#$e#\uBB3C\uB860, \uB108\uC640 \uAC19\uC740 \uB18D\uBD80\uB4E4\uC774 \uC5C6\uC5C8\uB354\uB77C\uBA74 \uBD88\uAC00\uB2A5\uD55C \uC77C\uC774\uC5C8\uACA0\uC9C0\uB9CC.$h",
  "fall_Mon": "\uC77C \uB144 \uC911 \uC774\uB9D8\uB54C \uB09C \uADE0\uC0C1\uC885 \uC5F0\uAD6C\uC5D0 \uC9D1\uC911\uD574.",
  "fall_Tue": "\uACFC\uD559 \uB355\uC5D0 \uC6B0\uB9B0 \uC790\uC5F0\uC5D0 \uB300\uD574 \uC54C\uAC8C \uB41C \uAC8C \uB9CE\uC9C0.#$e#\uD558\uC9C0\uB9CC \uD56D\uC0C1 \uB354 \uBC30\uC6B8 \uC810\uC774 \uB9CE\uC544.",
  "fall_Thu": "\uB18D\uC7A5 \uC77C\uC740 \uC694\uC998 \uC5B4\uB54C? \uC9C0\uAE08 \uC625\uC218\uC218 \uC2DC\uC98C\uC774\uC9C0, \uADF8\uCE58?#$e#\uC57C\uC678\uC5D0\uC11C \uD558\uB8E8 \uC885\uC77C \uC2DD\uBB3C \uBCF4\uBA74\uC11C \uC77C\uD558\uB294 \uAC74 \uCC38 \uD3C9\uD654\uB85C\uC6B8 \uAC70 \uAC19\uC544.",
  "fall_Fri": "\uB9C8\uB8E8\uB294 \uCC38 \uC790\uAE30 \uC7A5\uBE44\uB4E4 \uC190\uBCF4\uB294\uB370 \uC2DC\uAC04\uC744 \uB9CE\uC774 \uBCF4\uB0B4.#$e#\uC804\uB150\uD558\uB294 \uBAA8\uC2B5\uC774 \uCC38 \uBCF4\uAE30 \uC88B\uC544.",
  "fall_Fri_inlaw_Maru": "\uC544\uC9C1\uB3C4 \uB9C8\uB8E8\uC758 \uBE44\uBC00 \uB85C\uBD07 \uC77C\uC740 \uC5B4\uB9AC\uB465\uC808\uD574... \uC124\uB9C8 \uC804\uBD80 \uAFC8\uC774\uC5C8\uB098?",
  "fall_Sat": "\uC5B4\uB514 \uBCF4\uC790... \uC9C8\uC18C\uACE0\uC815\uB7C9\uC774 \uC120\uCDA9 \uBD84\uBE44\uBB3C\uC758 \uC601\uD5A5\uC744 \uBC1B\uB294 \uAC78\uC9C0\uB3C4...$u#$b#\uC624! \uBBF8\uC548. \uB370\uC774\uD130 \uC880 \uACF0\uACF0\uC774 \uC0DD\uAC01\uD558\uB2E4\uAC00 \uB124\uAC00 \uC628 \uC904\uB3C4 \uBAB0\uB790\uB124.#$e#\uBB58 \uB3C4\uC640\uC904\uAE4C?",
  "fall_Wed6": "\uC548\uB155 @. \uBC29\uBB38\uD558\uB7EC \uC640 \uC904 \uB54C\uB9C8\uB2E4 \uBC18\uAC00\uC6CC.#$e#\uC0AC\uC2E4 \uC5F0\uAD6C\uC2E4 \uC77C\uC740 \uC880 \uC678\uB85C\uC6B4 \uD3B8\uC774\uB77C \uC190\uB2D8\uC774 \uC624\uBA74 \uC88B\uB354\uB77C\uACE0.",
  "winter_Mon": "\uC9C0\uAE08\uC740 \uC5F0\uAD6C \uC7A0\uAE50 \uC26C\uB294 \uC911\uC774\uC57C.",
  "winter_Tue": "\uC9D1 \uD655\uC7A5\uACF5\uC0AC\uB97C \uD558\uACE0 \uC2F6\uB2E4\uBA74 \uC544\uB0B4\uB791 \uC598\uAE30\uD574\uBD10.",
  "winter_Wed": "\uC9D1\uC5D0 \uC8FC\uBC29 \uC124\uCE58\uD588\uC5B4?#$e#\uC694\uB9AC\uB3C4 \uC57D\uAC04 \uC2E4\uD5D8\uC2E4 \uC77C\uC774\uB791 \uBE44\uC2B7\uD558\uC9C0.",
  "winter_Thu": "\uB18D\uC7A5\uC5D0 \uB3D9\uBB3C\uB3C4 \uC788\uC5B4?",
  "winter_Fri": "\uC548\uB155.#$e#%\uB4DC\uBBF8\uD2B8\uB9AC\uC6B0\uC2A4\uB294 \uC0AC\uC0C9\uC5D0 \uC7A0\uACA8\uC788\uB294 \uB4EF\uD558\uB2E4.",
  "winter_Sat": "\uC5B4\uB514 \uBCF4\uC790... \uACC4\uC808\uBCC4 \uC9C8\uC18C\uB7C9\uC744 \uAC1C\uBCC4\uC2DD \uD568\uC218\uB85C \uBAA8\uB378\uB9C1 \uD560 \uC218 \uC788\uB2E4\uBA74...$u#$b#\uC624! \uBBF8\uC548. \uB370\uC774\uD130 \uC880 \uACF0\uACF0\uC774 \uC0DD\uAC01\uD558\uB2E4\uAC00 \uB124\uAC00 \uC628 \uC904\uB3C4 \uBAB0\uB790\uB124.#$e#\uBB58 \uB3C4\uC640\uC904\uAE4C?",
  "winter_Sun": "\uC774 \uADFC\uBC29\uC5D0\uC11C \uBAA9\uC7AC\uB791 \uB3CC\uC744 \uB9C8\uC74C\uAECF \uAC00\uC838\uAC00\uB3C4 \uC88B\uC544.",
  "winter_Fri4": "\uBC29\uBB38\uD574\uC918\uC11C \uACE0\uB9C8\uC6CC. \uCF69\uACFC \uC2DD\uBB3C \uC678\uC5D0 \uB2E4\uB978 \uC0DD\uAC01\uC744 \uC880 \uD574\uC57C\uACA0\uC5B4.#$e# \uADF8\uB798, \uC694\uC998\uC740 \uBB50\uD558\uACE0 \uC9C0\uB0B4?#$e#\uADF8\uAC70 \uD765\uBBF8\uB85C\uC6B4\uAC78."
}