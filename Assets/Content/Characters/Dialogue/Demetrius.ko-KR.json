  "reject_865": "\uACFC\uC77C\uD558\uACE0 \uC18C\uAE08? \uD2B9\uC774\uD55C \uC870\uD569\uC774\uB124...$s",
  "pamHouseUpgradeAnonymous": "\uD338\uC758 \uC0C8 \uC9D1 \uBE44\uC6A9\uC744 \uB204\uAC00 \uC9C0\uBD88\uD588\uB294\uC9C0 \uB85C\uBE48\uC774 *\uB098\uD55C\uD14C\uB3C4* \uC598\uAE30\uB97C \uC548 \uD574\uC8FC\uB294 \uAC70 \uC788\uC9C0!#$e#\uC0AC\uC2E4 \uADF8\uB0E5 \uD654\uB09C \uCC99\uD558\uB294 \uAC70\uC57C, \uB85C\uBE48\uC774 \uBE44\uBC00\uC744 \uC798 \uC9C0\uCF1C\uC900\uB2E4\uB294 \uC0AC\uC2E4\uC774 \uAE30\uBED0...$h",
  "Mon": "\uB9C8\uB8E8\uAC00 \uAC00\uB054 \uC2E4\uD5D8\uC2E4\uC5D0\uC11C \uB0A0 \uB3C4\uC640\uC8FC\uACE4 \uD574... \uCC29\uD55C \uC544\uC774\uC57C.",
  "Mon_inlaw_Maru": "\uB9C8\uB8E8\uC758 \uB3C4\uC6C0 \uC5C6\uC774 \uAF3C\uAF3C\uD55C \uC2E4\uD5D8\uC744 \uD558\uAE30 \uC5B4\uB824\uC6CC...#$b#\uD558\uC9C0\uB9CC \uB0B4 \uC2E4\uD5D8\uBCF4\uB2E4 \uADF8\uB140\uC758 \uD589\uBCF5\uC774 \uD6E8\uC52C \uB354 \uC911\uC694\uD574!",
  "Tue": "\uC774 \uACC4\uACE1\uC758 \uC0DD\uD0DC\uACC4\uB294 \uCC38 \uC0DD\uAE30 \uB118\uCE58\uACE0 \uB2E4\uC591\uD574. \uC5EC\uAE30 \uC774\uC0AC \uC624\uACE0 \uC2F6\uC5C8\uB358 \uC774\uC720 \uC911 \uD558\uB098\uC9C0.",
  "Wed": "\uB10C \uC544\uB9C8 \uB18D\uC7A5\uC5D0\uC11C \uD765\uBBF8\uB85C\uC6B4 \uC2DD\uBB3C \uB9CE\uC774 \uAE30\uB974\uACE0 \uC788\uACA0\uC9C0?#$e#\uD558\uB8E8\uCBE4 \uBC29\uBB38\uD574\uC11C \uD55C\uBC88 \uC870\uC0AC\uD574\uBCFC\uAE4C \uC2F6\uC5B4.",
  "Thu": "\uB18D\uC7A5 \uC77C\uC740 \uC5B4\uB54C? \uC694\uC998 \uD30C\uC2A4\uB2D9 \uCCA0\uC774\uC9C0, \uADF8\uCE58?#$e#\uC57C\uC678\uC5D0\uC11C \uD558\uB8E8 \uC885\uC77C \uC2DD\uBB3C \uBCF4\uBA74\uC11C \uC77C\uD558\uB294 \uAC74 \uCC38 \uD3C9\uD654\uB85C\uC6B8 \uAC70 \uAC19\uC544.",
  "Fri": "\uB85C\uBE48\uC740 \uC880 \uB2E4\uD608\uC9C8\uC801\uC778 \uBA74\uC774 \uC788\uC5B4. \uADF8\uB0E5 \uC560\uB2F9\uCD08\uC5D0 \uD654\uB97C \uC548 \uB098\uAC8C \uD558\uB294 \uAC8C \uC88B\uC544.#$e#\uB0B4\uAC00 \uC774\uB7F0 \uC598\uAE30 \uD588\uB2E4\uACE0\uB294 \uB9D0\uD558\uC9C0 \uB9D0\uACE0.$h",
  "Sat": "\uC5B4\uB514 \uBCF4\uC790... \uADFC\uAD8C\uC5D0 \uC788\uB294 \uD654\uD569\uBB3C\uC774 \uD0C4\uC18C-13\uB7C9\uC774 \uCDA9\uBD84\uD558\uB2E4\uBA74...$u#$b#\uC624! \uBBF8\uC548. \uB370\uC774\uD130 \uC880 \uACF0\uACF0\uC774 \uC0DD\uAC01\uD558\uB2E4\uAC00 \uB124\uAC00 \uC628 \uC904\uB3C4 \uBAB0\uB790\uB124.#$e#\uBB58 \uB3C4\uC640\uC904\uAE4C?",
  "Sun": "\uC8FC\uAE30\uC801\uC73C\uB85C \uD734\uC2DD\uC744 \uCDE8\uD558\uB294 \uAC8C \uC88B\uC544.#$e#\uB18D\uC7A5\uC5D0\uC11C \uC0DD\uD65C\uD558\uBA74 \uADF8\uAC8C \uC5B4\uB824\uC6B8 \uC218\uB294 \uC788\uACA0\uB2E4, \uADFC\uB370.#$e#\uBB50, \uADF8\uB798\uB3C4 \uACA8\uC6B8\uC5D0\uB294 \uC791\uBB3C \uAC71\uC815\uC744 \uD560 \uD544\uC694\uAC00 \uC5C6\uC73C\uB2C8\uAE4C.",
  "Fri4": "\uB85C\uBE48\uC740 \uC880 \uB2E4\uD608\uC9C8\uC801\uC778 \uBA74\uC774 \uC788\uC5B4. \uADF8\uB0E5 \uC560\uB2F9\uCD08\uC5D0 \uD654\uB97C \uC548 \uB098\uAC8C \uD558\uB294 \uAC8C \uC88B\uC544.#$e#...\uB9CC\uC57D \uB0B4\uAC00 \uB85C\uBE48\uC758 \uAE30\uBD84\uC744 \uC218\uB7C9\uD654\uD560 \uC218 \uC788\uB2E4\uBA74, \uC0AC\uC778 \uACE1\uC120\uC73C\uB85C \uBCC0\uB3D9\uB7C9\uC744 \uBAA8\uB378\uB9C1 \uD560 \uC218\uB3C4 \uC788\uACA0\uB294\uB370...$u",
