{
  "Introduction": "\uC548\uB155\uD558\uC138\uC694! \uB09C \uB4DC\uBBF8\uD2B8\uB9AC\uC6B0\uC2A4\uB77C\uACE0 \uD574\uC694, \uC774 \uC9C0\uC5ED \uACFC\uD559\uC790\uC774\uACE0 \uD55C \uAC00\uC815\uC758 \uC544\uBC84\uC9C0\uC8E0. \uC778\uC0AC\uD558\uB7EC \uC640\uC918\uC11C \uACE0\uB9C8\uC6CC\uC694!#$e#\uB09C \uC9D1\uC5D0 \uC788\uB294 \uC5F0\uAD6C\uC2E4\uC5D0\uC11C \uD604\uC9C0 \uC2DD\uBB3C\uACFC \uB3D9\uBB3C\uC744 \uACF5\uBD80\uD558\uACE0 \uC788\uC5B4\uC694.#$b#\uD639\uC2DC \uC6B0\uB9AC \uB538 \uB9C8\uB8E8\uB97C \uB9CC\uB098\uBD24\uB098\uC694? \uB9C8\uB8E8\uB294 \uBB34\uCC99 \uB9CC\uB098\uACE0 \uC2F6\uC5B4 \uD558\uB358\uB370.",
  "AcceptGift_(O)StardropTea": "\uC624, \uC774\uAC74 \uD76C\uADC0\uD55C \uBB3C\uC9C8\uC774\uB124. \uC774\uAC74 \uC5F0\uAD6C\uC2E4\uB85C \uAC00\uC838\uAC00\uC11C... \uC5B4... \uC790\uC138\uD788 \uBD84\uC11D\uD574 \uBD10\uC57C\uACA0\uC5B4.",
  "AcceptBirthdayGift_Positive": "\uC120\uBB3C!... \uADF8\uAC83\uB3C4 \uCD5C\uC801\uC758 \uD0C0\uC774\uBC0D\uC5D0. \uC624\uB298\uC740 \uB0B4 \uCD9C\uC0B0\uC744 \uAE30\uB150\uD558\uB294 \uB0A0\uC774\uAC70\uB4E0. \uACE0\uB9C8\uC6CC!$h",
  "AcceptBirthdayGift_Negative": "\uC120\uBB3C!... \uADF8\uAC83\uB3C4 \uCD5C\uC801\uC758 \uD0C0\uC774\uBC0D\uC5D0. \uC624\uB298\uC740 \uB0B4 \uCD9C\uC0B0\uC744 \uAE30\uB150\uD558\uB294 \uB0A0\uC774\uAC70\uB4E0.$h#$b#\uC774\uAC8C \uBB54\uC9C0 \uBCFC\uAE4C... $h#$b#...\uC624.$s",
  "AcceptGift_(O)107": "\uC640\uC6B0, \uC628\uC804\uD55C \uACF5\uB8E1\uC54C\uC774\uB77C\uB2C8! \uBB34\uCC99 \uD76C\uADC0\uD55C \uACAC\uBCF8\uC774\uC9C0. \uC774\uC81C, \uC774\uAC78 \uBD80\uD654\uC2DC\uD0AC \uBC29\uBC95\uB9CC \uC788\uB2E4\uBA74...",
  "Resort_Entering": "\uBC8C\uC368 \uD76C\uADC0\uD55C \uAC8C\uB97C \uD55C \uB9C8\uB9AC \uBD24\uC5B4. \uC5EC\uAE30 \uB108\uBB34 \uC88B\uB2E4.$h",
  "GreenRain": "\uB09C \uAC71\uC815\uD558\uC9C0 \uC54A\uC544\uB3C4 \uB3FC, @. \uC0D8\uD50C\uC744 \uBAA8\uC73C\uB294 \uC911\uC774\uC57C. \uC77C\uC0DD\uC77C\uB300\uC758 \uAE30\uD68C\uC77C \uC218\uB3C4 \uC788\uC5B4!$7#$e#\uC5B4... \uD639\uC2DC \uB0B4 \uC640\uC774\uD504\uAC00 \uBB3C\uC5B4\uBCF4\uBA74 \uB09C \uAD1C\uCC2E\uB2E4\uACE0 \uC804\uD574\uC918, \uC54C\uC558\uC9C0?$7",
  "GreenRain_2": "\uBE44\uB97C \uB9DE\uC544\uB3C4 \uBB38\uC81C\uB294 \uC5C6\uB294 \uAC83 \uAC19\uC544\uC11C \uC62C\uD574\uB294 \uAC71\uC815\uD558\uC9C0 \uC54A\uC73C\uB824\uACE0 \uD574.",
  "firstVisit_Desert": "\uCD5C\uADFC \uB124\uAC00 \uCE7C\uB9AC\uCF54 \uC0AC\uB9C9\uC744 \uBC29\uBB38\uD588\uB2E8 \uC598\uAE30\uB97C \uB4E4\uC5C8\uC5B4. \uD765\uBBF8\uB85C\uC6B4 \uC18C\uC2DD\uC774\uC57C! \uBD84\uBA85 \uBC29\uBB38\uD558\uB294 \uB3D9\uC548 \uC0AC\uB9C9 \uD2B9\uC720\uC758 \uC0DD\uBA85\uCCB4\uB97C \uB9CE\uC774 \uBD24\uACA0\uC9C0.",
  "questComplete_104_memory_oneday": "\uBA5C\uB860 \uC5F0\uAD6C \uC5B4\uB5BB\uAC8C \uB418\uC5B4\uAC00\uB0D0\uACE0? \uB9DE\uC544, \uC5B4... \uB0B4\uAC00... \u0027\uBD84\uC11D\u0027\uD574\uBCF8 \uACB0\uACFC, \uB300\uB7C9\uC601\uC591\uC18C \uBD84\uD3EC\uAC00 \uCD5C\uC801\uC774\uB77C\uB294 \uC0AC\uC2E4\uC740 \uC54C\uACA0\uC5B4...",
  "purchasedAnimal_Dinosaur": "\uB2E4\uC2DC \uB9D0\uD574\uBD10!? \uC131\uACF5\uC801\uC73C\uB85C \uACF5\uB8E1\uC54C\uC744 \uBD80\uD654\uC2DC\uCF30\uB2E4\uACE0? \uC804\uB840 \uC5C6\uB294 \uC77C\uC774\uC57C!$5#$e#\uC5EC\uAE30, \uB0B4 \uCEE4\uD53C \uBC1B\uC544, \uB098 \uC9C0\uAE08 \uB108\uBB34 \uD765\uBD84\uD574\uC11C... \uB354 \uBABB \uB9C8\uC2DC\uACA0\uB2E4. [253]",
  "dating_Maru": "\uADF8\uB798, \uB9C8\uB8E8\uC5D0\uAC8C \uC18C\uC2DD \uB4E4\uC5C8\uC5B4. \uADF8\uB807\uAC8C \uAE30\uC05C \uC18C\uC2DD\uC740 \uC544\uB2C8\uC9C0\uB9CC, \uB124\uAC00 \uB0B4 \uC0DD\uAC01\uC744 \uBC14\uAFC0 \uC218 \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB974\uC9C0.$u",
  "married_Maru": "*\uD55C\uC228*... @, \uB0B4 \uB538\uC774 \uC774\uC820 \uB2E4 \uC790\uB790\uB2E4\uB294 \uC0AC\uC2E4\uC744 \uBC1B\uC544\uB4E4\uC774\uAE30\uB85C \uD588\uC5B4. \uACB0\uD63C \uCD95\uD558\uD55C\uB2E4.$s",
  "married_Sebastian": "\uACB0\uD63C \uCD95\uD558\uD574. \uACB0\uD63C\uC2DD \uC774\uD6C4\uB85C \uB85C\uBE48\uC774 \uACC4\uC18D \uC6B8\uB354\uB77C\uACE0. \u0027\uAE30\uC068\uC758 \uB208\uBB3C\u0027\uC774\uB77C\uB358\uB370! \uD76C\uD55C\uD55C \uAC1C\uB150\uC774\uC9C0...#$e#\uD760, \uC9C0\uD558\uC2E4\uB3C4 \uBE44\uC5C8\uACA0\uB2E4, \uC5F0\uAD6C\uC2E4\uC744 \uD655\uC7A5\uD560 \uCC28\uB840\uC778\uAC00...$u",
  "eventSeen_65_memory_oneweek": "$y \u0027\uB3D9\uAD74 \uC2E4\uD5D8\uC740 \uC798 \uC9C4\uD589\uB418\uACE0 \uC788\uC5B4? \uAC00\uCE58 \uC788\uB294 \uC0DD\uC0B0\uBB3C\uC774 \uC788\uC5C8\uC5B4?_\uB124_\uC544! \uB0B4 \uCD08\uAE30 \uC774\uB860\uBCF4\uB2E4 \uC801\uD569\uD55C \uC870\uAC74\uC774 \uAC16\uCDB0\uC838\uC788\uB2E4\uB294 \uC758\uBBF8\uACA0\uAD70... \uD760..._\uC544\uB2C8\uC694_\uADF8\uB798, \uADF8\uB798\uB3C4 \uC885\uC885 \uD655\uC778\uD574 \uBD10. \uBD84\uBA85 \uBB54\uAC00 \uC5BB\uC744 \uC218 \uC788\uC744 \uAC70\uB77C \uD655\uC2E0\uD574.\u0027",
  "eventSeen_65_memory_twoweeks": "\uB18D\uC7A5\uC5D0 \uB3D9\uAD74 \uD655\uC778\uD558\uB294 \uAC70 \uC78A\uC9C0 \uB9D0\uACE0! \uC9C0\uAE08\uCBE4\uC774\uBA74 \uBD84\uBA85 \uBB54\uAC00 \uC720\uC6A9\uD55C \uAC8C \uC788\uC744 \uAC70\uC57C.",
