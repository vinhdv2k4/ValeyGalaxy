  "Thu": "\uC6B0\uB9AC \uC8FC\uBCC0\uC5D0\uB294 \uB9CE\uC740 \uC2E0\uBE44\uD55C \uAC83\uB4E4\uC774 \uC788\uC9C0. \uBC1C\uACAC\uD558\uACE0 \uC2F6\uB2E4\uBA74 \uB048\uAE30\uAC00 \uD544\uC694\uD558\uB2E4\uB124.",
  "Thu10": "\uADF8 \uB204\uAD6C\uC5D0\uAC8C\uB3C4 \uB9D0\uD558\uC9C0 \uB9D0\uAC8C... \uD558\uC9C0\uB9CC \uC774 \uC9C0\uC5ED \uC8FC\uBBFC \uC911 \uD55C \uBA85\uC774 \uB0B4 \uB538\uC774\uB77C \uC0DD\uAC01\uB418\uB124...#$e#\uB0B4\uAC00 \uC798\uBABB \uC0DD\uAC01\uD55C \uAC78 \uC218\uB3C4 \uC788\uB124\uB9CC... \uB4DC\uBB3C\uC9C0\uB9CC, \uAC00\uB054 \uADF8\uB7F0 \uC77C\uB3C4 \uC788\uC9C0.",
  "Fri": "\uC8FC\uBBFC\uB4E4\uC774 \uB098\uB97C \uB450\uB824\uC6CC\uD558\uB294 \uAC83 \uAC19\uB124.#$e#\uC548\uD0C0\uAE5D\uC9C0\uB9CC, \uBBF8\uC9C0\uC758 \uAC83\uC744 \uB450\uB824\uC6CC\uD558\uB294 \uAC83\uC774 \uC778\uAC04\uB2E4\uC6B4 \uAC83\uC774\uC9C0.",
  "Fri6": "\uB098\uB3C4 \uC624\uB798\uC804\uC5D0 \uACB0\uD63C\uC774\uB780 \uAC78 \uD588\uC5C8\uB2E4\uB124. \uC544\uB0B4\uC640 \uB0B4\uAC00 \uAC08\uB77C\uC9C4 \uB4A4\uB85C, \uADF8\uB140\uB294 \uC2DC\uACE8 \uC0C1\uACF5\uC744 \uB0A0\uC544\uB2E4\uB2C8\uBA70 \uBCF4\uC774\uB294 \uBAA8\uB4E0 \uAC83\uC744 \uC800\uC8FC\uD588\uC9C0.#$e#\uBD84\uB178\uB97C \uD45C\uD558\uB294 \uBC29\uBC95\uCE58\uACE4 \uC5B4\uB978\uC2A4\uB7EC\uC6B4 \uD589\uB3D9\uC740 \uC544\uB2C8\uC9C0.",
  "Sat": "\uC8FC\uC758\uD558\uAC8C, \uC790\uB128 \uC9C0\uAE08 \uAC15\uB825\uD55C \uB9C8\uBC95\uC7A5 \uC704\uC5D0 \uC11C\uC788\uB124.#$e#\uADF8\uB798\uC11C \uB0B4\uAC00 \uC5EC\uAE30\uC5D0 \uB0B4 \uC624\uB450\uB9C9\uC744 \uC9C0\uC5C8\uC9C0.",
  "Sat2": "\uC790\uB124, \uC232\uC758 \uC601\uB839\uB4E4\uACFC \uC9C4\uCC99\uC740 \uC880 \uC788\uC5C8\uB098?",
  "Sun": "\uAC00\uB054 \uBE44\uBC00\uB9AC\uC5D0 \uC8FC\uBBFC\uB4E4\uC744 \uAD00\uCC30\uD55C\uB2E4\uB124.#$e#\uACAC\uC2B5\uC0DD\uC744 \uCC3E\uC73C\uB824 \uD558\uACE0 \uC788\uC5B4. \uC5B8\uC820\uAC00 \uB098\uB294 \uC774\uC2B9\uC744 \uB5A0\uB0A0 \uAC83\uC774\uC9C0\uB9CC, \uB0B4 \uC2E0\uBE44\uC758 \uCD94\uAD6C\uB294 \uACC4\uC18D\uB418\uC5B4\uC57C \uD574."
