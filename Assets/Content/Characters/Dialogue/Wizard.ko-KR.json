  "Tue10": "\uD604\uC2E4\uC774 \uB9C8\uC74C\uC744 \uD1B5\uD574 \uAD6C\uCD95\uB41C \uAC83\uC774\uB77C\uBA74, \uB9C8\uC74C\uC744 \uB2E4\uC2A4\uB9B4 \uC904 \uC54C\uBA74 \uD604\uC2E4\uC744 \uB2E4\uC2A4\uB9B4 \uC904 \uC54C\uAC8C \uB418\uC9C0...",
