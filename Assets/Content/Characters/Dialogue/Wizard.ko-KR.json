  "GreenRain_2": "\uC790\uC5F0\uC758 \uAC15\uB825\uD55C \uD798\uC744 \uC5C5\uC2E0\uC5EC\uAE30\uBA74 \uC548 \uB41C\uB2E4\uB124.#$e#\uC2E4\uB840\uD558\uACA0\uB124, \uB0B4\uAC90 \uC624\uB298\uB9CC \uD560 \uC218 \uC788\uB294 \uC77C\uC774 \uC788\uC5B4\uC11C.",
