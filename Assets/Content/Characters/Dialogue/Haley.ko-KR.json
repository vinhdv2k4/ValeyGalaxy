  "winter_Thu6": "\uC62C\uBD04\uC5D0 \uCE58\uB9C8 \uC880 \uAE30\uBD80\uD560\uAE4C \uBD10.#$e#\uCE58\uB9C8\uAC00 \uBC8C\uC368 1,000\uAC1C\uB294 \uC788\uC73C\uB2C8.$h#$e#...\uBB50?",
  "winter_Sun6": "\uC74C, \uD639\uC2DC \uC54C\uB809\uC2A4 \uBCF4\uBA74 \uB098 \uC624\uB298 \uBC14\uC058\uB2E4\uACE0 \uC598\uAE30\uD574\uC904 \uC218 \uC788\uC5B4?#$e#\uACE0\uB9C8\uC6CC.",
  "winter_Mon8": "\uC2A4\uD0C0\uB4C0 \uBC38\uB9AC\uAC00 \uB0A0\uC528\uAC00 \uC880 \uB354 \uB530\uB73B\uD588\uC73C\uBA74 \uC88B\uACA0\uB2E4.#$e#\uB2E4\uB978 \uB370\uB85C \uC774\uC0AC \uAC08 \uC218\uB3C4 \uC788\uAE34 \uD558\uC9C0\uB9CC, \uADF8\uB7EC\uBA74...",
  "winter_Fri8": "\uB18D\uC7A5\uC5D0 \uC5B8\uC820\uAC04 \uC870\uB791\uB9D0 \uB4E4\uC77C \uC0DD\uAC01 \uC788\uC5B4 \uD639\uC2DC?",
