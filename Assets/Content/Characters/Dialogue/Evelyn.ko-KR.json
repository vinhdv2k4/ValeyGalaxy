{
  "Introduction": "\uC5B4\uBA38, \uC548\uB155 \uC598\uC57C, \uC6B0\uB9AC \uC8FC\uBBFC \uC911 \uD558\uB098\uAC00 \uB41C \uAC78 \uD658\uC601\uD55C\uB2E4! #$b#\uC6D0\uD55C\uB2E4\uBA74 \uB098\uB97C \u0027\uD560\uB9E4\u0027\uB77C\uACE0 \uBD88\uB7EC\uB3C4 \uAD1C\uCC2E\uB2E8\uB2E4.$h",
  "AcceptGift_(O)StardropTea": "\uC624, \uB098\uD55C\uD14C \uC8FC\uB824\uB294 \uAC70\uB2C8? \uB108\uBB34 \uACE0\uB9D9\uB2E4, \uC544\uAC00\uC57C. \uC815\uB9D0 \uD2B9\uBCC4\uD55C \uC120\uBB3C\uC774\uAD6C\uB098!",
  "AcceptGift_(O)170": "\uACE0\uB9D9\uB2E4, \uC544\uAC00\uC57C. \uB0B4 \uB3CB\uBCF4\uAE30\uAC00 \uC5B4\uB514 \uAC14\uB098 \uC885\uC77C \uCC3E\uACE0 \uC788\uC5C8\uB2E8\uB2E4...#$b#\uC138\uC0C1\uC5D0! \uB108\uBB34 \uB354\uB7EC\uC6CC\uC84C\uAD6C\uB098...",
  "GreenRain": "\uC870\uC9C0, \uB0B4 \uC0AC\uB791... \uC774\uAC8C \uB05D\uC778 \uAC78\uAE4C\uC694? \uC88B\uC740 \uC0B6\uC774\uC5C8\uC5B4, \uD558\uC9C0\uB9CC \uAC00\uAE30 \uC804\uC5D0 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC54C\uB809\uC2A4\uB97C \uD55C \uBC88 \uB354 \uBCF4\uACE0 \uC2F6\uAD6C\uB098...$s%noturn",
  "GreenRainFinished": "\uC624, \uC774\uB7F0... \uBAA8\uB4E0 \uAC8C \uD070\uC77C \uC5C6\uC774 \uB9C8\uBB34\uB9AC\uB418\uC5B4\uC11C \uAE30\uC058\uB2E8\uB2E4. \uC2EC\uC9C0\uC5B4 \uB0B4 \uAF43\uB4E4\uC740 \uADF8 \uC5B4\uB290 \uB54C\uBCF4\uB2E4 \uAC74\uAC15\uD574 \uBCF4\uC774\uB294\uAD6C\uB098!",
  "GreenRain_2": "\uAF43\uB4E4\uC774 \uC774 \uBE44\uB97C \uC815\uB9D0 \uC88B\uC544\uD558\uB294\uAD6C\uB098...",
  "AcceptGift_Positive_forage_item_beach": "\uACE0\uB9D9\uB2E4, \uC544\uAC00\uC57C. \uB2EC\uCF64\uD55C \uCD94\uC5B5\uC774 \uB5A0\uC624\uB974\uB294\uAD6C\uB098...",
  "reject_867": "\uC624, \uBD84\uBA85 \uC870\uC9C0\uAC00 \uD765\uBBF8\uB85C\uC6CC\uD560 \uBB3C\uAC74\uC774\uAD6C\uB098!",
  "cropMatured_591": "\uC9C1\uC811 \uAE30\uB978 \uD2A4\uB9BD\uC740 \uC815\uB9D0 \uC0AC\uB791\uC2A4\uB7EC\uC6B4 \uBD04\uCCA0 \uC120\uBB3C\uC774\uC9C0.",
  "cc_Complete": "\uB9C8\uC744 \uD68C\uAD00\uC774 \uB2E4\uC2DC \uACE0\uCCD0\uC9C0\uB2E4\uB2C8, \uC0AC\uB791\uC2A4\uB7FD\uAD6C\uB098. \uC61B\uB0A0 \uCD94\uC5B5\uC774 \uB108\uBB34\uB098\uB3C4 \uB9CE\uC740 \uD2B9\uBCC4\uD55C \uACF3\uC774\uC9C0.",
  "married": "\uACB0\uD63C\uD588\uB2E4\uB2C8, \uACBD\uC0AC\uAD6C\uB098 \uC544\uAC00\uC57C.$h#$e#\uC80A\uC740 \uC0AC\uB78C\uB4E4\uC774 \uC0AC\uB791\uD558\uB294 \uBAA8\uC2B5\uC744 \uBCF4\uBA74 \uB098 \uAC19\uC740 \uD560\uBA38\uB2C8\uB294 \uB9C8\uC74C\uC774 \uB530\uB73B\uD574\uC9C4\uB2E8\uB2E4.",
  "divorce": "\uB2E4\uC74C\uC5D0 \uACB0\uD63C\uD560 \uB54C\uB294 \uAF2D \uC798 \uB9DE\uB294 \uC0C1\uB300\uC640 \uD558\uAC70\uB77C...$s",
  "reject_866": "\uC815\uB9D0 \uC608\uC05C \uC7A5\uBBF8\uAD6C\uB098, \uC598\uC57C. \uC5D0\uBC00\uB9AC\uC5D0\uAC8C \uBCF4\uC5EC\uC918 \uBCF4\uC558\uB2C8? \uADF8 \uC544\uC774 \uC0DD\uAC01\uC774 \uB098\uB294\uAD6C\uB098.",
  "pamHouseUpgrade": "\uC624, \uC544\uAC00\uC57C... \uD338\uC5D0\uAC8C \uC544\uB984\uB2E4\uC6B4 \uC0C8 \uC9D1\uC744 \uC120\uBB3C\uD574\uC8FC\uB2E4\uB2C8, \uC0C1\uB0E5\uD558\uAD6C\uB098!$h#$e#\uC0AC\uB78C\uB4E4\uC774 \uC11C\uB85C\uC11C\uB85C \uB3C4\uC640\uC8FC\uB294 \uAC83\uC744 \uBCF4\uBA74 \uB9C8\uC74C\uC774 \uCC38 \uB530\uB73B\uD574\uC9C0\uB294\uAD6C\uB098...",
  "pamHouseUpgradeAnonymous": "\uB0B4\uAC00 \uADF8\uB0E5 \uC5B4\uB9AC\uC11D\uC740 \uBC14\uBCF4 \uB299\uC740\uC774\uC778 \uAC78 \uC218\uB3C4 \uC788\uC9C0\uB9CC... \uB204\uAC00 \uD338\uC5D0\uAC8C \uC9D1\uC744 \uB9C8\uB828\uD574\uC8FC\uC5C8\uB294\uC9C0 \uC54C \uAC83 \uAC19\uAD6C\uB098... *\uC719\uD06C*",
  "MovieInvitation": "\uC5B4\uBA38! \uC815\uB9D0 \uBA4B\uC9C4 \uC81C\uC548\uC774\uAD6C\uB098, \uC598\uC57C. \uADF8\uB798... \uAC19\uC774 \uC601\uD654\uB97C \uBCF4\uBA74 \uC815\uB9D0 \uC88B\uACA0\uAD6C\uB098!$h#$b#\uBA3C\uC800 \uAC00 \uC788\uC73C\uB834, \uADF9\uC7A5\uC5D0\uC11C \uB9CC\uB098\uC790\uAFB8\uB098.",
  "Mon": "\uC5B4\uBA38\uB098! \uCC38 \uC0AC\uB791\uC2A4\uB7EC\uC6B4 \uB0A0\uC774\uAD6C\uB098.$u",
  "Tue": "\uB0B4 \uB0A8\uD3B8 \uC870\uC9C0\uB294 \uB108\uBB34 \uC2E0\uACBD \uC4F0\uC9C0 \uB9D0\uAC70\uB77C. \uCC98\uC74C \uBCF4\uB294 \uC0AC\uB78C\uD55C\uD14C \uADF8\uB807\uAC8C \uCE5C\uC808\uD558\uC9C4 \uC54A\uC544\uC11C.#$e#\uB354 \uC798 \uC54C\uAC8C \uB418\uBA74 \uBD84\uBA85 \uB9C8\uC74C\uC744 \uC5F4 \uAC70\uC57C.#$e#\uBD84\uBA85 \uC5B8\uC820\uAC00\uB294 \uB458\uC774 \uC88B\uC740 \uCE5C\uAD6C\uAC00 \uB420 \uC218 \uC788\uC744 \uAC70\uC57C!$h#$e#\uB0A8\uD3B8\uC5D0 \uB300\uD574 \uAD81\uAE08\uD55C \uAC8C \uB9CE\uC544 \uBCF4\uC5EC\uC11C \uD55C\uAC00\uC9C0 \uBE44\uBC00\uC744 \uC54C\uB824\uC8FC\uB9C8: \uB9AC\uD06C\uB97C \uC815\uB9D0 \uC88B\uC544\uD55C\uB2E8\uB2E4! \uC774\uB9D8\uB54C \uC0B0\uC5D0 \uB09C\uB2E8\uB2E4.",
  "Wed": "#$1 evelynGarden1#\uC5B4\uC81C \uB9C8\uC744 \uC815\uC6D0\uC5D0\uC11C \uB108\uBB34\uB098 \uC544\uB984\uB2E4\uC6B4 \uB098\uBE44 \uD55C \uAC00\uC871\uC774 \uD587\uBCD5\uC744 \uCB10\uB294 \uAC83\uC744 \uBD24\uB2E8\uB2E4.$k#$e#\uC2DC\uC7A5\uB2D8\uAED8\uC11C \uB098\uB97C \uB9C8\uC744 \uACF5\uACF5\uB18D\uC6D0 \uCC45\uC784\uC790\uB85C \uB450\uC5C8\uC9C0.#$e#\uBA87 \uC8FC\uC9F8 \uAC00\uAFBC \uD654\uB2E8\uC774\uB2C8, \uBC1F\uC9C0 \uC54A\uB3C4\uB85D \uC870\uC2EC\uD558\uB834!",
  "Thu": "\uC624\uB298\uC740 \uCFE0\uD0A4\uB97C \uAD6C\uC6B8 \uAC70\uB780\uB2E4. \uBD04\uC5D0\uB294 \uAF43 \uBAA8\uC591\uC73C\uB85C \uB9CC\uB4E4\uBA74 \uC7AC\uBBF8\uC788\uB354\uAD6C\uB098.$h#$e#\uC5B4\uCA4C\uBA74 \uC5B8\uC820\uAC00 \uB0B4 \uB808\uC2DC\uD53C\uB97C \uC54C\uB824\uC904 \uC218\uB3C4 \uC788\uACA0\uB2E4.",
  "Fri": "\uC870\uC9C0\uB294 \uD558\uB8E8 \uC885\uC77C \uC800 \uB9DD\uD560 \uD14C\uB808\uBE44 \uC55E\uC5D0\uB9CC \uC549\uC544\uC788\uC9C0.#$e#\uC880 \uB354 \uC790\uC8FC \uC678\uCD9C\uD588\uC73C\uBA74 \uC88B\uC73C\uB828\uB9CC. \uC0C1\uCF8C\uD55C \uACF5\uAE30\uAC00 \uCC38 \uC0AC\uB78C\uD55C\uD14C \uC88B\uC740 \uAC74\uB370 \uB9D0\uC774\uC57C.",
  "Sat": "\uAD6C\uB984 \uAD6C\uACBD\uC744 \uCC38 \uC88B\uC544\uD588\uC5C8\uB294\uB370, \uC694\uC998\uC740 \uB208\uC5D0 \uC798 \uBCF4\uC774\uC9C0 \uC54A\uB354\uAD6C\uB098.#$e# \uB208\uC774 \uC608\uC804 \uAC19\uC9C0 \uC54A\uC740 \uAC8C\uC57C.$s",
  "Sun": "\uBC14\uB2E4 \uADFC\uCC98\uC5D0 \uC788\uC5B4\uC11C \uCC38 \uC88B\uC740 \uC77C\uC774\uC57C. \uBC14\uB2E4 \uC18C\uB9AC \uB355\uBD84\uC5D0 \uC7A0\uC5D0 \uD479 \uB4E0\uB2E8\uB2E4.#$e#\uC5B4\uB838\uC744 \uB550 \uC370\uBB3C\uC774 \uBE60\uC9C0\uBA74 \uC870\uAC00\uBE44\uB97C \uCC3E\uC73C\uB7EC \uB2E4\uB2C8\uACE4 \uD588\uC9C0. \uADF8\uB9AC\uC6B4 \uCD94\uC5B5\uC774\uC57C...",
  "Tue6": "\uC2DC\uAC04\uC744 \uB0B4\uC11C \uB098\uC640 \uC870\uC9C0\uB97C \uBC29\uBB38\uD574\uC918\uC11C \uB108\uBB34 \uC88B\uAD6C\uB098.#$e#\uC8FC\uBCC0\uC5D0 \uC80A\uC740 \uC0AC\uB78C\uC774 \uC5C6\uB2E4\uBA74, \uC6B0\uB9AC\uB3C4 \uB354 \uBE68\uB9AC \uB299\uC744 \uAC70\uC57C.$h",
  "Event_cookies1": "\uACE0\uB9C8\uC6CC\uB77C!$h",
  "Event_cookies2": "\uBB50\uB77C\uACE0 \uD588\uB2C8, \uC544\uAC00\uC57C? \uBD84\uBA85 \u0027\uD558\uD0A4 \uD37D\u0027\uC774\uB77C\uACE0 \uD55C \uAC83 \uAC19\uC740\uB370. *\uD55C\uC228* \uADC0\uAC00 \uC608\uC804 \uAC19\uC9C0 \uC54A\uAD6C\uB098.$s",
  "summer_Mon": "\uBA4B\uC9C4 \uB0A0\uC528 \uB355\uC5D0 \uAE30\uC6B4\uC774 \uB098\uB294\uAD6C\uB098.$u",
  "summer_Mon_inlaw_Alex": "\uB0B4 \uC190\uC8FC\uB294 \uC694\uC998 \uC5B4\uB5BB\uAC8C \uC9C0\uB0B4\uB2C8? \uB18D\uC7A5\uC5D0\uC11C \uC9C0\uB0B4\uB294 \uAC83\uC744 \uB9C8\uC74C\uC5D0 \uB4E4\uC5B4 \uD560 \uAC83 \uAC19\uAD6C\uB098.#$e#\uD589\uBCF5\uD560 \uC790\uACA9\uC774 \uC788\uB294 \uC544\uC774\uC57C... \uCC29\uD55C \uC544\uC774\uC9C0.",
  "summer_Tue": "\uC870\uC9C0\uB294 \uC5EC\uB984\uC5D0\uB294 \uC880 \uB35C \uD234\uD234\uB304\uB2E8\uB2E4. \uB0A0\uC528\uAC00 \uB530\uB73B\uD574\uC9C0\uBA74 \uBF08\uAC00 \uBD80\uB4DC\uB7EC\uC6CC\uC9C0\uB294 \uAC74\uC9C0.#$e#\uB108\uB294 \uBAA8\uB97C \uC218\uB3C4 \uC788\uC9C0\uB9CC, \uB09C \uC54C\uC9C0. 60\uB144\uC744 \uAC19\uC774 \uC9C0\uB0C8\uC73C\uB2C8!",
  "summer_Wed": "\uC2DC\uC7A5\uB2D8\uAED8\uC11C \uB098\uB97C \uB9C8\uC744 \uACF5\uACF5\uB18D\uC6D0 \uCC45\uC784\uC790\uB85C \uB450\uC5C8\uB2E8\uB2E4.#$e#\uBA87 \uB2EC\uC9F8 \uAC00\uAFBC \uD654\uB2E8\uC774\uB2C8, \uBC1F\uC9C0 \uC54A\uB3C4\uB85D \uC870\uC2EC\uD558\uB834!",
  "summer_Thu": "\uC624\uB298\uC740 \uCFE0\uD0A4\uB97C \uAD6C\uC6B8 \uAC70\uB780\uB2E4. \uC57C\uC790\uC218 \uBAA8\uC591\uC758 \uCF54\uCF54\uB11B \uCFE0\uD0A4\uB780\uB2E4!$h#$e#\uC5B4\uCA4C\uBA74 \uC5B8\uC820\uAC00 \uB0B4 \uB808\uC2DC\uD53C\uB97C \uC54C\uB824\uC904 \uC218\uB3C4 \uC788\uACA0\uAD6C\uB098.",
  "summer_Sat": "\uC870\uC2EC\uD558\uAC70\uB77C, \uC598\uC57C. \uD587\uBCD5\uC5D0 \uD0C8 \uC218\uB3C4 \uC788\uC5B4!",
  "summer_Sun": "\uC2A4\uC704\uD2B8\uD53C \uCCA0\uC774\uB780\uB2E4.#$e#\uCC38 \uC88B\uC740 \uD5A5\uC774 \uB098\uC9C0 \uC54A\uB2C8?",
  "summer_Thu4": "\uB0B4\uAC00 \uCFE0\uD0A4\uB97C \uAD7D\uAE30 \uC2DC\uC791\uD558\uBA74 \uAF2D \uC190\uB2D8\uC774 \uB354 \uB9CE\uC774 \uC624\uB294 \uAC83 \uAC19\uAD6C\uB098.#$e#\uB0B4 \uC5B4\uBA38\uB2C8\uAED8\uC11C \uB808\uC2DC\uD53C\uB97C \uC54C\uB824\uC8FC\uC168\uB2E8\uB2E4.",
  "fall_Mon": "\uD574\uAC00 \uC9C0\uB0A0\uC218\uB85D \uACC4\uC808\uC758 \uC9C4\uAC00\uB97C \uC810\uC810 \uC54C\uAC8C \uB418\uB294 \uAC83 \uAC19\uAD6C\uB098. \uC80A\uC5C8\uC744 \uB54C\uB294 \uC27D\uAC8C \uB193\uCE58\uB358 \uAC83\uB4E4\uC774\uC9C0.",
  "fall_Tue": "\uC870\uC9C0\uC758 \uC624\uD2B8\uBC00\uC5D0 \uAC74\uD3EC\uB3C4\uB97C \uB123\uAE30 \uC2DC\uC791\uD588\uB294\uB370... \uC804\uD600 \uC5B8\uAE09\uC774 \uC5C6\uB354\uAD6C\uB098. \uC774\uB7F0 \uAC78 \uB208\uCE58\uCC44\uAE34 \uD558\uB294 \uAC78\uAE4C?",
  "fall_Wed": "\uC2DC\uC7A5\uB2D8\uAED8\uC11C \uB098\uB97C \uB9C8\uC744 \uACF5\uACF5\uB18D\uC6D0 \uCC45\uC784\uC790\uB85C \uB450\uC5C8\uB2E8\uB2E4.#$e#\uAC00\uC744\uAF43\uC740 \uC5F0\uC57D\uD558\uB2C8, \uB9C9 \uBC1F\uACE0 \uB2E4\uB2C8\uC9C4 \uB9D0\uB834! \uC544\uC774\uB4E4\uC774 \uC5B4\uB5A4\uC9C0\uB294 \uC798 \uC54C\uACE0 \uC788\uB2E8\uB2E4.",
  "fall_Thu": "\uC624\uB298\uC740 \uCFE0\uD0A4\uB97C \uAD6C\uC6B8 \uAC70\uB780\uB2E4. \uC790\uADF8\uB9C8\uD55C \uD638\uBC15 \uBAA8\uC591\uC73C\uB85C \uB9CC\uB4E4\uC5C8\uC9C0.$h#$e#\uC5B4\uCA4C\uBA74 \uC5B8\uC820\uAC00 \uB0B4 \uB808\uC2DC\uD53C\uB97C \uC54C\uB824\uC904 \uC218\uB3C4 \uC788\uACA0\uB2E4.",
  "fall_Sat": "\uC54C\uB809\uC2A4\uB791 \uCE5C\uD558\uB2C8?#$e#\uAC00\uB054 \uADF8 \uC544\uC774 \uB54C\uBB38\uC5D0 \uAC71\uC815\uC774 \uD0DC\uC0B0\uC774\uB780\uB2E4.",
  "fall_Sat_inlaw_Alex": "\uC624, \uC548\uB155 \uB0B4 \uC544\uAC00\uC57C. \uC774\uC820 \uB108\uB3C4 \uB0B4 ${\uC190\uC8FC^\uC190\uB140}$ \uAC19\uB2E8\uB2E4.$h",
  "fall_Sun": "\uB0B4 \uC2DC\uB825\uC774 \uC608\uC804 \uAC19\uC9C4 \uC54A\uC9C0\uB9CC, \uD6C4\uAC01\uC740 \uC544\uC9C1 \uB6F0\uC5B4\uB098\uB2E8\uB2E4!#$e#\uB099\uC5FD\uACFC \uBC84\uC12F \uD5A5\uAE30\uB97C \uB9E1\uC73C\uBA74, \uB0B4\uAC00 \uC18C\uB140 \uB54C \uB180\uB358 \uC232\uC774 \uAE30\uC5B5\uB098.",
  "winter_Mon": "\uC5BC\uC74C\uC5D0 \uBBF8\uB044\uB7EC\uC9C0\uC9C0 \uC54A\uB3C4\uB85D \uC870\uC2EC\uD558\uB824\uBB34\uB098, \uC544\uAC00\uC57C.",
  "winter_Tue": "\uCDA5\uC9C0 \uC54A\uB2C8? \uC637 \uC880 \uB354 \uB450\uAECD\uAC8C \uC785\uC5B4\uC57C\uC9C0, \uC544\uAC00\uC57C!#$e#\uC774\uB7F0 \uB0A0\uC528\uB294 \uC601 \uB0B4 \uAD00\uC808\uC5D0 \uC88B\uC9C0 \uC54A\uC544\uC11C...$s",
  "winter_Wed": "\uC815\uC6D0\uC744 \uC790\uC8FC \uAC00\uAFB8\uB7EC \uAC00\uC9C0\uB9CC, \uC9C0\uAE08\uC740 \uB208\uC73C\uB85C \uB4A4\uB36E\uC5EC\uC788\uB354\uAD6C\uB098.#$e#\uADF8\uB798\uB3C4 \uAC00\uB054 \uD655\uC778\uD558\uB7EC \uAC00\uBCF4\uB294 \uD3B8\uC774\uB780\uB2E4.",
  "winter_Thu": "\uC624\uB298 \uCFE0\uD0A4\uB97C \uAD6C\uC6B8 \uACC4\uD68D\uC774\uB780\uB2E4. \uC791\uC740 \uACA8\uC6B8 \uBCC4 \uBAA8\uC591\uC73C\uB85C.$h#$e#\uC5B8\uC820\uAC00 \uB0B4 \uB808\uC2DC\uD53C\uB97C \uC54C\uB824\uC8FC\uB294 \uB0A0\uC774 \uC62C \uC218\uB3C4 \uC788\uACA0\uC9C0.",
  "winter_Sat": "\uC6B0\uB9B0 \uC5EC\uAE30 30\uB144 \uB118\uAC8C \uC0B4\uC558\uB2E8\uB2E4.#$e#\uADF8\uB3D9\uC548 \uB9CE\uC740 \uC0AC\uB78C\uB4E4\uC774 \uC624\uAC14\uC9C0. \uB124 \uD560\uC544\uBC84\uC9C0\uB3C4. \uCC38 \uC88B\uC740 \uBD84\uC774\uC57C... *\uD55C\uC228*",
  "winter_Sat6": "\uC624... \uB0B4 \uC544\uAC00\uC57C. \uD560\uC544\uBC84\uC9C0 \uB208\uC744 \uC3D9 \uBE7C\uB2EE\uC558\uAD6C\uB098...$s#$e#\uADF8\uB798... \uADF8\uB798... \uC544\uC8FC \uC798 \uC54C\uB358 \uC0AC\uC774\uC9C0.",
  "winter_Sun": "\uB530\uB73B\uD558\uAC8C \uC9C0\uB0BC \uC218 \uC788\uAC8C \uB728\uAC70\uC6B4 \uC2A4\uD504\uB97C \uB9CC\uB4E4\uC5B4\uB450\uB834.#$e#\uC678\uD22C \uAF2D \uCC59\uACA8 \uC785\uACE0!",
  "winter_Sat8": "@, \uC870\uC9C0\uC640 \uB0B4\uAC00 \uC774 \uC9D1\uC5D0\uC11C 30\uB144\uAC04 \uC9C0\uB0C8\uB2E4\uACE0 \uC598\uAE30\uD574\uC900 \uC801 \uC788\uB2C8?#$e#\uB108\uB3C4 \uC624\uB798\uB3C4\uB85D \uC5EC\uAE30\uC11C \uC9C0\uB0C8\uC73C\uBA74 \uC88B\uACA0\uB2E8\uB2E4.$h"
