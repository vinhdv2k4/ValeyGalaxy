{
  "Rainy_Day_0": "\u0422\u0435\u0431\u0435 \u043D\u0440\u0430\u0432\u044F\u0442\u0441\u044F \u0434\u043E\u0436\u0434\u043B\u0438\u0432\u044B\u0435 \u0434\u043D\u0438, \u0442\u0430\u043A \u0436\u0435 \u043A\u0430\u043A \u0438 \u043C\u043D\u0435, @?",
  "Rainy_Day_1": "\u041C\u044B \u0442\u0430\u043A\u0438\u0435 \u0440\u0430\u0437\u043D\u044B\u0435... \u041D\u043E \u044D\u0442\u043E \u043D\u0435 \u0442\u0430\u043A \u0441\u0442\u0440\u0430\u0448\u043D\u043E.",
  "Rainy_Day_2": "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E, @. \u042F \u0432\u0441\u0442\u0430\u043B \u043F\u043E\u0440\u0430\u043D\u044C\u0448\u0435 \u0438 \u043D\u0430\u0448\u0435\u043B \u0434\u043B\u044F \u0442\u0435\u0431\u044F \u0432\u043E\u0442 \u044D\u0442\u043E. [305 308 203 795 397]#$e#\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u044D\u0442\u043E \u043D\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0441\u0442\u0440\u0430\u043D\u043D\u043E.",
  "Rainy_Day_3": "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u0430 \u0432\u043E\u043B\u0448\u0435\u0431\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442 \u043E... \u043D\u0430\u0441? \u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u043E\u043D \u0443\u043C\u0435\u0435\u0442 \u0445\u0440\u0430\u043D\u0438\u0442\u044C \u0441\u0435\u043A\u0440\u0435\u0442\u044B.$s",
  "Rainy_Day_4": "\u041A\u0430\u043A \u0431\u044B \u044F \u043D\u0438 \u0441\u0442\u0430\u0440\u0430\u043B\u0441\u044F \u0431\u044B\u0442\u044C \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u043D\u044B\u043C, \u0438\u043D\u043E\u0433\u0434\u0430 \u043C\u0435\u043D\u044F \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E \u0442\u044F\u043D\u0435\u0442 \u0441\u043E\u0432\u0435\u0440\u0448\u0430\u0442\u044C \u0433\u0430\u0434\u043E\u0441\u0442\u0438...$6#$e#\u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u044D\u0442\u043E \u0447\u0435\u0440\u0442\u0430 \u043C\u043E\u0435\u0433\u043E \u043D\u0430\u0440\u043E\u0434\u0430.",
  "Rainy_Day_Krobus": "\u0410\u0445, \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0438\u0434\u0435\u0442 \u0434\u043E\u0436\u0434\u044C \u0438 \u0432\u043B\u0430\u0436\u043D\u043E\u0441\u0442\u044C \u043F\u043E\u0432\u044B\u0441\u0438\u043B\u0430\u0441\u044C... \u041C\u043D\u0435 \u0442\u0430\u043A \u043D\u0430\u043C\u043D\u043E\u0433\u043E \u043B\u0443\u0447\u0448\u0435.",
  "Rainy_Night_0": "\u0412 \u0442\u0430\u043A\u0443\u044E \u043D\u043E\u0447\u044C \u043B\u044E\u0434\u0438 \u043C\u043E\u0433\u0443\u0442 \u0432\u044B\u0433\u043B\u044F\u043D\u0443\u0442\u044C \u0432 \u043E\u043A\u043D\u043E \u0438 \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u043E\u0447\u0435\u0440\u0442\u0430\u043D\u0438\u044F \u043D\u0435\u044F\u0441\u043D\u043E\u0439 \u0444\u0438\u0433\u0443\u0440\u044B \u043D\u0430 \u0443\u043B\u0438\u0446\u0435. \u041F\u043E\u0434\u0443\u043C\u0430\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E... \u042D\u0442\u043E \u043C\u043E\u0433\u0443 \u0431\u044B\u0442\u044C \u044F.$7",
  "Rainy_Night_1": "\u0415\u0441\u043B\u0438 \u0431\u044B \u0442\u0435\u043D\u0435\u0432\u043E\u0439 \u043D\u0430\u0440\u043E\u0434\u0435\u0446 \u0443\u0437\u043D\u0430\u043B \u043E \u043D\u0430\u0448\u0438\u0445 \u0441 \u0442\u043E\u0431\u043E\u0439 \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F\u0445... \u043C\u0435\u043D\u044F \u0431\u044B \u00AB\u043D\u0430\u043A\u0430\u0437\u0430\u043B\u0438\u00BB.$s#$e#\u0417\u043D\u0430\u0435\u0448\u044C \u0436\u0435, \u043E\u043D\u0438 \u0442\u0435\u0440\u043F\u0435\u0442\u044C \u043D\u0435 \u043C\u043E\u0433\u0443\u0442 \u043B\u044E\u0434\u0435\u0439.",
  "Rainy_Night_2": "\u0414\u0430 \u0441 \u0442\u0435\u0431\u044F \u0432\u043E\u0434\u0430 \u0440\u0443\u0447\u044C\u044F\u043C\u0438 \u0442\u0435\u0447\u0435\u0442! \u0420\u0430\u0437\u0432\u0435 \u044D\u0442\u043E \u043D\u0435 \u043E\u043F\u0430\u0441\u043D\u043E \u0434\u043B\u044F \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u0435\u0439 \u0442\u0432\u043E\u0435\u0433\u043E \u0432\u0438\u0434\u0430?$s",
  "Rainy_Night_3": "\u042F \u0443\u0436\u0435 \u043F\u043E\u0443\u0436\u0438\u043D\u0430\u043B, \u043D\u043E \u0442\u044B \u0442\u0430\u043A\u043E\u0435 \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E \u043D\u0435 \u0435\u0448\u044C... \u0418\u0437\u0432\u0438\u043D\u0438.",
  "Rainy_Night_4": "\u042F \u0438\u0449\u0443 \u043D\u043E\u0432\u044B\u0439 \u0434\u043E\u043C \u0441 \u0442\u043E\u0433\u043E \u0441\u0430\u043C\u043E\u0433\u043E \u0434\u043D\u044F, \u043A\u0430\u043A \u043F\u043E\u043A\u0438\u043D\u0443\u043B \u0441\u0432\u043E\u0439 \u043D\u0430\u0440\u043E\u0434... \u0442\u0435\u043F\u0435\u0440\u044C \u0443 \u043C\u0435\u043D\u044F \u0442\u043E\u0436\u0435 \u0435\u0441\u0442\u044C \u0441\u0432\u043E\u0435 \u043C\u0435\u0441\u0442\u043E. \u042D\u0442\u043E \u043E\u0447\u0435\u043D\u044C \u043C\u043D\u043E\u0433\u043E \u0434\u043B\u044F \u043C\u0435\u043D\u044F \u0437\u043D\u0430\u0447\u0438\u0442.",
  "Rainy_Night_5": "\u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u043C\u043E\u0439 \u043D\u0430\u0440\u043E\u0434 \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F \u0437\u0434\u0435\u0441\u044C \u043E\u0447\u0435\u043D\u044C \u0434\u0430\u0432\u043D\u043E, \u043A\u043E\u0433\u0434\u0430 \u0432\u0435\u043B\u0438\u043A\u0438\u0439 \u043A\u0430\u0442\u0430\u043A\u043B\u0438\u0437\u043C \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B \u0434\u0443\u0445\u0430\u043C \u0438\u0437 \u043F\u0443\u0441\u0442\u043E\u0442\u044B \u043F\u0440\u043E\u043D\u0438\u043A\u0430\u0442\u044C \u0432 \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0439 \u043C\u0438\u0440.",
  "Rainy_Night_Krobus": "\u0417\u0432\u0443\u043A \u0434\u043E\u0436\u0434\u044F \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442 \u043C\u043D\u0435 \u043E \u043A\u0430\u043D\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438... \u0442\u0430\u043A \u0443\u0441\u043F\u043E\u043A\u0430\u0438\u0432\u0430\u0435\u0442.#$e#\u041A\u0430\u043D\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044F \u0431\u044B\u043B\u0430 \u043C\u043E\u0438\u043C \u043F\u0440\u0438\u044E\u0442\u043E\u043C... \u0442\u0430\u043C \u044F \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B \u0441\u0435\u0431\u044F \u0432 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438. \u041D\u043E \u043D\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0439... \u0412 \u043C\u043E\u0435\u043C \u043D\u043E\u0432\u043E\u043C \u0434\u043E\u043C\u0435 \u043C\u043D\u0435 \u0442\u0430\u043A \u0436\u0435 \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u043E.",
  "Indoor_Day_0": "\u042F \u0431\u044B \u043F\u043E\u043C\u043E\u0433\u0430\u043B \u0442\u0435\u0431\u0435, \u0435\u0441\u043B\u0438 \u043C\u043E\u0433 \u0432\u044B\u0439\u0442\u0438 \u0438\u0437 \u0434\u043E\u043C\u0430... \u041D\u043E \u0432\u043C\u0435\u0441\u0442\u043E \u044D\u0442\u043E\u0433\u043E \u044F \u0431\u0443\u0434\u0443 \u043E\u0447\u0435\u043D\u044C \u0441\u0442\u0430\u0440\u0430\u0442\u044C\u0441\u044F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C \u0441\u0430\u043C \u0434\u043E\u043C \u0432 \u0447\u0438\u0441\u0442\u043E\u0442\u0435.",
  "Indoor_Day_1": "\u042F \u043E\u0447\u0435\u043D\u044C \u0441\u0442\u0430\u0440\u0430\u043B\u0441\u044F \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0443\u044E \u0435\u0434\u0443... [203 204 651 225]#$e#\u041C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u0435\u0441\u0442\u044C \u043F\u043E\u043F\u043E\u0437\u0436\u0435, \u043D\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0439...",
  "Indoor_Day_2": "\u041C\u043D\u0435 \u0445\u043E\u0440\u043E\u0448\u043E \u0442\u0443\u0442, \u0432 \u0434\u043E\u043C\u0435. \u041C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C \u0432\u0440\u0435\u043C\u044F \u0432 \u0445\u043E\u0440\u043E\u0448\u0435\u043C \u043C\u0435\u0441\u0442\u0435... \u041C\u043D\u0435 \u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u00AB\u0433\u0443\u043B\u044F\u0442\u044C\u00BB, \u043A\u0430\u043A \u043B\u044E\u0434\u044F\u043C.#$e#\u041D\u043E \u044F \u043F\u043E\u043D\u0438\u043C\u0430\u044E, \u0447\u0442\u043E \u0442\u0435\u0431\u0435 \u044D\u0442\u043E \u043D\u0443\u0436\u043D\u043E. \u041F\u0440\u043E\u0448\u0443 \u0442\u0435\u0431\u044F, \u043D\u0435 \u043D\u0430\u0434\u043E \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E \u0441\u0438\u0434\u0435\u0442\u044C \u0434\u043E\u043C\u0430 \u0441\u043E \u043C\u043D\u043E\u0439 \u0438\u0437-\u0437\u0430 \u0447\u0443\u0432\u0441\u0442\u0432\u0430 \u0432\u0438\u043D\u044B.$3",
  "Indoor_Day_3": "\u042F \u0445\u043E\u0447\u0443 \u0446\u0435\u043B\u044B\u0439 \u0434\u0435\u043D\u044C \u043F\u0440\u043E\u0441\u0438\u0434\u0435\u0442\u044C \u0432 \u0443\u0433\u043B\u0443, \u0441\u0436\u0430\u0432\u0448\u0438\u0441\u044C \u0432 \u043A\u043E\u043C\u043E\u0447\u0435\u043A...#$e#\u0427\u0442\u043E? \u041A\u0430\u043A \u0442\u0430\u043A, \u0432\u044B \u0442\u0430\u043A\u0438\u043C \u043D\u0435 \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442\u0435\u0441\u044C?$3",
  "Indoor_Day_4": "\u041F\u043E \u043F\u044F\u0442\u043D\u0438\u0446\u0430\u043C \u044F \u043C\u043E\u043B\u0447\u0443 \u0432 \u0437\u043D\u0430\u043A \u043F\u0440\u0435\u0434\u0430\u043D\u043D\u043E\u0441\u0442\u0438 \u0418\u043E\u0431\u0435. \u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0442\u0435\u0431\u044F \u044D\u0442\u043E \u043D\u0435 \u043D\u0430\u043F\u0440\u044F\u0433\u0430\u0435\u0442.",
  "Indoor_Day_Krobus": "\u0425\u043E\u0442\u0435\u043B \u0431\u044B \u044F \u043F\u043E\u043C\u043E\u0433\u0430\u0442\u044C \u043F\u043E \u0444\u0435\u0440\u043C\u0435, \u043D\u043E \u044F \u043D\u0435 \u043C\u043E\u0433\u0443 \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u044C \u043D\u0430\u0440\u0443\u0436\u0443 \u0432 \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u0443\u044E \u043F\u043E\u0433\u043E\u0434\u0443...",
  "Indoor_Night_0": "\u042F \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0438\u0437\u0431\u0430\u0432\u0438\u043B \u0434\u043E\u043C \u043E\u0442 \u0436\u0443\u043A\u043E\u0432... \u0418\u0437\u0432\u0438\u043D\u0438, \u044F \u0442\u0435\u0431\u0435 \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u0438\u043B! *\u0447\u0430\u0432\u043A*$7",
  "Indoor_Night_1": "\u0423 \u0442\u0435\u0431\u044F \u043F\u043B\u043E\u0442\u043D\u043E\u0435 \u0442\u0435\u043B\u043E... \u041C\u043D\u0435 \u0438\u043D\u043E\u0433\u0434\u0430 \u0442\u043E\u0436\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0438\u043C\u0435\u0442\u044C \u043A\u043E\u0441\u0442\u0438...$s",
  "Indoor_Night_2": "\u041F\u043E\u0440\u043E\u0439 \u044F \u0437\u0430\u0434\u0430\u044E\u0441\u044C \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u043C, \u043C\u043E\u0433\u0443\u0442 \u043B\u0438 \u0432\u043E\u043E\u0431\u0449\u0435 \u043B\u044E\u0434\u0438 \u0438 \u0442\u0435\u043D\u0435\u0432\u043E\u0439 \u043D\u0430\u0440\u043E\u0434 \u043C\u0438\u0440\u043D\u043E \u0441\u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C... \u0418\u0434\u0435\u044F \u0445\u043E\u0440\u043E\u0448\u0430\u044F, \u043D\u043E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u043B\u0438 \u044D\u0442\u043E?$s#$e#\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0447\u0442\u043E \u0434\u0430...",
  "Indoor_Night_3": "\u0418\u043D\u043E\u0433\u0434\u0430 \u044F \u0437\u0430\u0434\u0443\u043C\u044B\u0432\u0430\u044E\u0441\u044C \u043D\u0430\u0434 \u0442\u0435\u043C, \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0432\u0441\u0435\u0433\u043E \u044F \u0443\u0437\u043D\u0430\u043B \u043E \u043B\u044E\u0434\u044F\u0445 \u043E\u0442 \u0442\u0435\u0431\u044F...#$b#\u0425\u043E\u0442\u0435\u043B \u0431\u044B \u044F, \u0447\u0442\u043E\u0431\u044B \u043C\u043E\u0438 \u0442\u0435\u043D\u0435\u0432\u044B\u0435 \u0441\u043E\u0431\u0440\u0430\u0442\u044C\u044F \u0441\u043C\u043E\u0433\u043B\u0438 \u0442\u043E\u0436\u0435 \u0438\u0441\u043F\u044B\u0442\u0430\u0442\u044C \u044D\u0442\u043E \u0447\u0443\u0432\u0441\u0442\u0432\u043E.",
  "Indoor_Night_4": "\u042F \u0445\u043E\u0447\u0443 \u0431\u044B\u0442\u044C \u0445\u043E\u0440\u043E\u0448\u0438\u043C \u0441\u043E\u0436\u0438\u0442\u0435\u043B\u0435\u043C, \u043D\u043E \u044F \u043D\u0435 \u0437\u043D\u0430\u044E, \u0432\u0441\u0435 \u043B\u0438 \u044F \u0434\u0435\u043B\u0430\u044E \u0445\u043E\u0440\u043E\u0448\u043E... *\u0441\u0442\u043E\u043D* $s#$e#\u041C\u043D\u0435 \u0438\u043D\u043E\u0433\u0434\u0430 \u0441\u043B\u043E\u0436\u043D\u043E \u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u0435 \u044D\u043C\u043E\u0446\u0438\u0438. \u041D... \u041D\u043E... \u0422\u0435\u0431\u0435 \u0436\u0435 \u0441\u043E \u043C\u043D\u043E\u0439 \u0445\u043E\u0440\u043E\u0448\u043E \u0436\u0438\u0432\u0435\u0442\u0441\u044F?#$e#\u0425\u043E\u0440\u043E\u0448\u043E!$7",
  "Indoor_Night_Krobus": "\u041F\u0440\u0438\u0432\u0435\u0442, @. \u0421 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435\u043C. \u041F\u043E\u0445\u043E\u0436\u0435, \u0443 \u0442\u0435\u0431\u044F \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0431\u044B\u043B\u043E \u043C\u043D\u043E\u0433\u043E \u0440\u0430\u0431\u043E\u0442\u044B!$h",
  "Outdoor_0": "\u042F \u0441\u043C\u043E\u0433\u0443 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u043E\u0431\u044B\u0442\u044C \u0441 \u0442\u043E\u0431\u043E\u0439 \u0441\u043D\u0430\u0440\u0443\u0436\u0438... \u041D\u043E \u0435\u0441\u043B\u0438 \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u043E\u0434\u043E\u0439\u0434\u0435\u0442, \u043C\u043D\u0435 \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F \u0441\u043F\u0440\u044F\u0442\u0430\u0442\u044C\u0441\u044F!",
  "Outdoor_1": "\u042F \u0440\u0435\u0434\u043A\u043E \u043A\u043E\u0433\u0434\u0430 \u043C\u043E\u0433\u0443 \u0432\u044B\u0439\u0442\u0438 \u043D\u0430\u0440\u0443\u0436\u0443!",
  "Outdoor_2": "\u041A\u0430\u043A\u043E\u0439 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u0434\u0435\u043D\u044C!$h",
  "Outdoor_3": "\u041E\u0442\u043A\u0440\u044B\u0442\u044B\u0435 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430 \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442 \u043C\u0435\u043D\u044F \u043D\u0435\u0440\u0432\u043D\u0438\u0447\u0430\u0442\u044C...$s",
  "Outdoor_4": "\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u0438\u0434\u0438 \u043F\u043E \u0441\u0432\u043E\u0438\u043C \u0434\u0435\u043B\u0430\u043C. \u042F \u043E\u0441\u0442\u0430\u043D\u0443\u0441\u044C \u0442\u0443\u0442 \u0438 \u0431\u0443\u0434\u0443 \u043E\u0445\u0440\u0430\u043D\u044F\u0442\u044C \u0434\u043E\u043C.",
  "Outdoor_Krobus": "\u042F \u043F\u043E\u0434\u043E\u0436\u0434\u0443 \u0442\u0443\u0442 \u0438 \u043F\u043E\u0432\u044B\u0441\u043B\u0435\u0436\u0438\u0432\u0430\u044E \u0436\u0443\u043A\u043E\u0432.#$e#\u042F \u0432\u0435\u0434\u044C \u0435\u0449\u0435 \u043D\u0435 \u0437\u0430\u0432\u0442\u0440\u0430\u043A\u0430\u043B!",
  "OneKid_3": "\u041D\u0435 \u0437\u043D\u0430\u044E \u043A\u0430\u043A, \u043D\u043E \u0418\u043E\u0431\u0430 \u043F\u043E\u0441\u043B\u0430\u043B \u0432 \u044D\u0442\u043E\u0442 \u0434\u043E\u043C \u00AB\u0440\u0435\u0431\u0435\u043D\u043A\u0430\u00BB...",
  "TwoKids_0": "\u041D\u0435 \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0439\u0441\u044F, %kid1 \u0438 %kid2 \u0443\u0436\u0435 \u043F\u043E\u0435\u043B\u0438 \u043E\u043C\u043B\u0435\u0442 \u0438\u0437 \u043F\u0443\u0441\u0442\u043E\u0442\u043D\u044B\u0445 \u044F\u0438\u0446.",
  "TwoKids_2": "\u042F \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u044E\u0441\u044C \u043E \u0431\u0443\u0434\u0443\u0449\u0435\u043C \u043D\u0430\u0448\u0438\u0445 \u0434\u0435\u0442\u0435\u0439... \u041D\u043E \u043C\u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0432\u0435\u0440\u0438\u0442\u044C, \u0447\u0442\u043E \u0418\u043E\u0431\u0430 \u043E \u043D\u0438\u0445 \u043F\u043E\u0437\u0430\u0431\u043E\u0442\u0438\u0442\u0441\u044F.",
  "TwoKids_3": "\u0412 \u044D\u0442\u043E\u0442 \u0434\u043E\u043C \u043F\u043E\u0441\u043B\u0430\u043B\u0438 \u0440\u0435\u0431\u0435\u043D\u043A\u0430 \u0443\u0436\u0435 \u0432\u043E \u0432\u0442\u043E\u0440\u043E\u0439 \u0440\u0430\u0437... \u0422\u0430\u043A \u0437\u043D\u0430\u0447\u0438\u0442, \u0418\u043E\u0431\u0430 \u043E\u0434\u043E\u0431\u0440\u044F\u0435\u0442 \u044D\u0442\u043E\u0442 \u043D\u0435\u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043E\u043D\u043D\u044B\u0439 \u0436\u0438\u0442\u0435\u0439\u0441\u043A\u0438\u0439 \u0441\u043E\u044E\u0437?",
  "Good_1": "\u041C\u043E\u0435 \u0442\u0435\u043B\u043E \u0447\u0442\u043E-\u0442\u043E \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442... \u044D\u0442\u043E \u0447\u0442\u043E... \u00AB\u043F\u043B\u0430\u0442\u043E\u043D\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043B\u044E\u0431\u043E\u0432\u044C\u00BB?$l#$b#... \u041E\u0439, \u043F\u043E\u0433\u043E\u0434\u0438... \u042F \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u044E \u043A\u043E\u0436\u0443.$s",
  "Good_2": "\u042F \u043D\u0430\u0443\u0447\u0438\u043B\u0441\u044F \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u044C \u043B\u044E\u0434\u0435\u0439... \u043D\u043E \u043E\u0442 \u0414\u0432\u0430\u0440\u0444\u043E\u0432 \u043C\u0435\u043D\u044F \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u0432\u043E\u0440\u043E\u0442\u0438\u0442.$a",
  "Good_3": "\u041D\u043E\u0447\u044C\u044E \u044F \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0441\u044F \u043E\u0442 \u0442\u0432\u043E\u0438\u0445 \u043F\u043E\u043A\u0443\u0441\u044B\u0432\u0430\u043D\u0438\u0439, \u0430 \u043F\u043E\u0442\u043E\u043C \u0443\u0441\u043B\u044B\u0448\u0430\u043B: \u00AB\u0447\u0435\u0440\u043D\u044B\u0435 \u043B\u0430\u043A \u0438 \u0440\u0438\u0441\u00BB... \u0447\u0442\u043E \u0432\u0441\u0435 \u044D\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u043B\u043E?$3",
  "Good_0": "\u041D\u0430\u0448\u0438 \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F \u043B\u0443\u0447\u0448\u0435, \u0438 \u044D\u0442\u043E \u043C\u0435\u043D\u044F \u0440\u0430\u0434\u0443\u0435\u0442.$h",
  "Good_5": "\u042F \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0430\u0441\u043B\u0430\u0436\u0434\u0430\u043B\u0441\u044F \u043D\u0430\u0448\u0438\u043C \u0434\u043E\u043C\u043E\u043C... \u043A\u0430\u043A\u043E\u0435 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E.$l",
  "Neutral_0": "\u042F \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043F\u043E\u0441\u0442\u0430\u0440\u0435\u044E, \u0430 \u0432\u043E\u0442 \u0442\u044B \u043F\u043E\u0441\u0442\u0430\u0440\u0435\u0435\u0448\u044C. \u0418\u043D\u043E\u0433\u0434\u0430 \u044D\u0442\u043E \u043C\u0435\u043D\u044F \u043F\u0435\u0447\u0430\u043B\u0438\u0442... \u041D\u043E \u044D\u0442\u043E \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E.$s",
