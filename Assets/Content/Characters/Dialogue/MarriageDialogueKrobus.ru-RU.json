  "Bad_2": "\u0422\u0435\u0431\u0435 \u0432\u0441\u0435 \u0435\u0449\u0435 \u0440\u0430\u0434\u043E\u0441\u0442\u043D\u043E \u0436\u0438\u0442\u044C \u0441\u043E \u043C\u043D\u043E\u0439?$s",
  "Bad_4": "\u041C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0442\u0435\u0431\u0435 \u0431\u044B\u043B\u043E \u0431\u044B \u0432\u0435\u0441\u0435\u043B\u0435\u0435 \u0436\u0438\u0442\u044C \u0441 \u0434\u0440\u0443\u0433\u0438\u043C \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C...$s",
  "Bad_5": "\u042F \u0437\u0430\u043C\u0435\u0442\u0438\u043B, \u0447\u0442\u043E \u0442\u044B \u0432\u0435\u0434\u0435\u0448\u044C \u0441\u0435\u0431\u044F \u043F\u043E-\u0438\u043D\u043E\u043C\u0443... \u0427\u0442\u043E \u044D\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u0442? *\u0441\u0442\u043E\u043D*$s",
  "Bad_6": "\u0422\u0435\u0431\u0435 \u043E\u0442\u0432\u0435\u0434\u0435\u043D\u0430 \u043B\u0438\u0448\u044C \u043E\u0434\u043D\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u0430\u044F \u0436\u0438\u0437\u043D\u044C... \u0422\u044B \u0442\u043E\u0447\u043D\u043E \u0445\u043E\u0447\u0435\u0448\u044C \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u0435\u0435 \u0441 \u0442\u0430\u043A\u0438\u043C \u0443\u0436\u0430\u0441\u043D\u044B\u043C \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435\u043C, \u043A\u0430\u043A \u044F?$s",
  "Bad_7": "\u0421\u043A\u043E\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043E, \u0442\u0430\u043A\u0438\u0435 \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F \u0434\u043E\u043B\u0433\u043E \u043D\u0435 \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u0442...$s",
  "Bad_8": "\u041F\u043E\u0445\u043E\u0436\u0435, \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0432\u0440\u0435\u043C\u044F \u0442\u0435\u0431\u044F \u0447\u0442\u043E-\u0442\u043E \u043D\u0435 \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442...$s",
  "Bad_9": "\u042F \u0441\u043A\u0443\u0447\u0430\u044E \u043F\u043E \u043A\u0430\u043D\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438.$s",
