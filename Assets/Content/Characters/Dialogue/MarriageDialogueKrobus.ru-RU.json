  "spring_1": "\u041A\u0430\u043A\u0438\u0435 \u043F\u043B\u0430\u043D\u044B \u043D\u0430 \u043D\u043E\u0432\u044B\u0439 \u0433\u043E\u0434, @?",
  "spring_23": "\u0422\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E \u0437\u0430\u0432\u0442\u0440\u0430 \u0441\u0445\u043E\u0434\u0438\u0442\u044C \u043D\u0430 \u0426\u0432\u0435\u0442\u043E\u0447\u043D\u044B\u0435 \u0442\u0430\u043D\u0446\u044B! \u041E\u0431\u043E \u043C\u043D\u0435 \u043D\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0439.",
  "summer_1": "\u042F \u043C\u043E\u0433\u0443 \u043E\u0447\u0435\u043D\u044C \u0431\u044B\u0441\u0442\u0440\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u043E\u0436\u043E\u0433 \u0432 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u0433\u043E\u0434\u0430, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0431\u044B\u0442\u044C \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C.",
  "summer_8": "\u041C-\u043C-\u043C... \u041A\u0430\u043A\u043E\u0439 \u043F\u0440\u0438\u044F\u0442\u043D\u044B\u0439 \u0437\u0430\u043F\u0430\u0445. \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u0442\u0432\u043E\u0435 \u0442\u0435\u043B\u043E \u0441\u0438\u043B\u044C\u043D\u043E \u0432\u0441\u043F\u043E\u0442\u0435\u043B\u043E \u0437\u0430 \u043D\u043E\u0447\u044C...$h",
  "summer_15": "\u0421\u0435\u0439\u0447\u0430\u0441 \u043B\u0435\u0442\u043E... \u0410 \u044D\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u0442, \u0447\u0442\u043E \u0432 \u0434\u043E\u043C\u0435 \u043F\u043E\u043B\u043D\u043E \u043C\u0443\u0445.#$e#\u041D\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0439. \u042F \u043E \u043D\u0438\u0445 \u043F\u043E\u0437\u0430\u0431\u043E\u0447\u0443\u0441\u044C. \u0412 \u043D\u0438\u0445 \u043C\u043D\u043E\u0433\u043E \u0431\u0435\u043B\u043A\u0430!$h",
  "fall_8": "\u041D\u0435 \u0445\u043E\u0447\u0443 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0438\u0447\u0435\u0433\u043E \u0434\u0435\u043B\u0430\u0442\u044C.",
  "fall_15": "\u0410 \u0447\u0442\u043E \u0442\u044B \u0431\u0443\u0434\u0435\u0448\u044C \u0432\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0442\u044C \u043D\u0430 \u0441\u0432\u043E\u0435\u043C \u043B\u043E\u0442\u043A\u0435 \u0437\u0430\u0432\u0442\u0440\u0430 \u043D\u0430 \u044F\u0440\u043C\u0430\u0440\u043A\u0435?",
  "fall_24": "\u0415\u0441\u043B\u0438 \u044F \u043F\u0440\u0438\u0434\u0443 \u043D\u0430 \u0414\u0435\u043D\u044C \u0432\u0441\u0435\u0445 \u0434\u0443\u0445\u043E\u0432, \u043C\u0435\u043D\u044F \u0436\u0435 \u043D\u0435 \u043F\u043E\u0441\u0430\u0434\u044F\u0442 \u0432 \u043A\u043B\u0435\u0442\u043A\u0443...$s",
  "winter_28": "\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0437\u0430 \u043A\u0440\u043E\u0432, @. \u041D\u0430\u0434\u0435\u044E\u0441\u044C \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u0442\u0443\u0442 \u0435\u0449\u0435 \u043E\u0434\u0438\u043D \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u0433\u043E\u0434!$h",
  "spouseRoom_Krobus": "#$c .5#\u041D\u0430\u0448\u0430 \u0444\u0438\u0437\u0438\u043E\u043B\u043E\u0433\u0438\u044F \u0442\u0430\u043A\u0430\u044F \u0440\u0430\u0437\u043D\u0430\u044F, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0430\u043C \u0442\u0430\u043A \u0441\u043B\u043E\u0436\u043D\u043E \u0436\u0438\u0442\u044C \u0432\u043C\u0435\u0441\u0442\u0435, \u0434\u0430?#$e#\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0438\u0437\u043B\u0438\u0448\u043D\u044F\u044F \u0432\u043B\u0430\u0436\u043D\u043E\u0441\u0442\u044C \u0442\u0435\u0431\u044F \u043D\u0435 \u0442\u0440\u0435\u0432\u043E\u0436\u0438\u0442. \u0427\u0442\u043E\u0431\u044B \u0436\u0438\u0442\u044C \u0432\u043C\u0435\u0441\u0442\u0435, \u043D\u0430\u043C \u043D\u0443\u0436\u043D\u043E \u0438\u0434\u0442\u0438 \u043D\u0430 \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0438\u0441\u0441\u044B!",
  "spring_Krobus": "\u0421\u0435\u0439\u0447\u0430\u0441 \u00AB\u0432\u0435\u0441\u043D\u0430\u00BB, \u0442\u0430\u043A? \u042F \u0447\u0443\u044E \u0442\u0435\u0440\u043F\u043A\u0438\u0439 \u0430\u0440\u043E\u043C\u0430\u0442 \u0434\u0438\u043A\u043E\u0433\u043E \u0445\u0440\u0435\u043D\u0430.",
  "summer_Krobus": "\u0412\u044B \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0435 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u0433\u043E\u0434\u0430 \u00AB\u043B\u0435\u0442\u043E\u043C\u00BB, \u0432\u0435\u0440\u043D\u043E? \u0422\u0435\u043F\u043B\u043E \u0438 \u0432\u043B\u0430\u0436\u043D\u043E\u0441\u0442\u044C \u2014 \u044D\u0442\u043E \u0445\u043E\u0440\u043E\u0448\u043E, \u043B\u0438\u0448\u044C \u0441\u043E\u043B\u043D\u0446\u0435 \u043C\u0435\u0448\u0430\u0435\u0442.",
  "fall_Krobus": "\u0421\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0445\u043E\u043B\u043E\u0434\u043D\u0435\u0435 \u0438 \u043F\u0430\u0445\u043D\u0435\u0442 \u0441\u044B\u0440\u043E\u0441\u0442\u044C\u044E. \u0423 \u0432\u0430\u0441 \u044D\u0442\u043E \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u00AB\u043E\u0441\u0435\u043D\u044C\u00BB, \u0434\u0430?",
  "winter_Krobus": "\u0422\u0435\u043C\u043D\u043E\u0442\u0430, \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u043E\u0447\u0435\u043D\u044C \u0443\u0441\u043F\u043E\u043A\u0430\u0438\u0432\u0430\u0435\u0442. \u041D\u043E \u0431\u044B\u043B\u043E \u0431\u044B \u0445\u043E\u0442\u044C \u0447\u0443\u0442\u043E\u0447\u043A\u0443 \u043F\u043E\u0442\u0435\u043F\u043B\u0435\u0435!"
}