{
  "Introduction": "\u0410\u0445, \u043D\u043E\u0432\u044B\u0439 \u0444\u0435\u0440\u043C\u0435\u0440, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043C\u044B \u0432\u0441\u0435 \u0442\u0430\u043A \u0436\u0434\u0430\u043B\u0438... \u0438 \u0447\u044C\u0435 \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u0435 \u043E\u0437\u043D\u0430\u043C\u0435\u043D\u043E\u0432\u0430\u043B\u043E\u0441\u044C \u0441\u0442\u043E\u043B\u044C\u043A\u0438\u043C\u0438 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430\u043C\u0438!#$b#\u042F \u2014 \u042D\u043B\u043B\u0438\u043E\u0442... \u042F \u0436\u0438\u0432\u0443 \u0432 \u0434\u043E\u043C\u0438\u043A\u0435 \u043D\u0430 \u043F\u043B\u044F\u0436\u0435. \u041E\u0447\u0435\u043D\u044C \u043F\u0440\u0438\u044F\u0442\u043D\u043E \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u044C\u0441\u044F \u0441 \u0432\u0430\u043C\u0438.",
  "AcceptBirthdayGift_Positive": "\u042F \u043F\u043E\u043B\u044C\u0449\u0435\u043D, \u0447\u0442\u043E \u0442\u044B \u043F\u043E\u043C\u043D\u0438\u0448\u044C \u043E \u043C\u043E\u0435\u043C \u0434\u043D\u0435 \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F. \u0421\u043F\u0430\u0441\u0438\u0431\u043E!$h",
  "AcceptBirthdayGift_Negative": "\u0415\u0449\u0435 \u043E\u0434\u0438\u043D \u0433\u043E\u0434 \u043F\u0440\u043E\u0448\u0435\u043B, \u0435\u0449\u0435 \u043E\u0434\u0438\u043D \u0441\u0435\u0434\u043E\u0439 \u0432\u043E\u043B\u043E\u0441 \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F... \u0414\u0443\u043C\u0430\u044E, \u044D\u0442\u043E\u0442 \u043F\u043E\u0434\u0430\u0440\u043E\u043A \u043F\u043E\u0434\u0447\u0435\u0440\u043A\u043D\u0435\u0442 \u043C\u043E\u0435 \u0443\u0432\u044F\u0434\u0430\u043D\u0438\u0435.$s",
  "AcceptGift_(O)StardropTea": "\u0410\u0445, \u043A\u0430\u043A\u043E\u0439 \u043F\u043E\u0434\u0430\u0440\u043E\u043A! \u042D\u0442\u043E\u0442 \u0437\u0430\u043F\u0430\u0445 \u0442\u0430\u043A \u0432\u0434\u043E\u0445\u043D\u043E\u0432\u043B\u044F\u0435\u0442...",
  "FlowerDance_Accept": "\u041A\u043E\u043D\u0435\u0447\u043D\u043E... \u0421\u043E\u0447\u0442\u0443 \u0437\u0430 \u0447\u0435\u0441\u0442\u044C! \u041E\u0447\u0435\u043D\u044C \u0436\u0434\u0443.$h",
  "AcceptGift_Positive_forage_item_beach": "\u0410, \u0432\u0438\u0436\u0443, \u043F\u043B\u044F\u0436 \u043F\u043E\u0434\u0435\u043B\u0438\u043B\u0441\u044F \u0441 \u0442\u043E\u0431\u043E\u0439 \u0441\u0432\u043E\u0438\u043C\u0438 \u0441\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u0430\u043C\u0438... \u0425\u043E\u0440\u043E\u0448\u0435\u0435 \u0445\u043E\u0431\u0431\u0438. \u0421\u043F\u0430\u0441\u0438\u0431\u043E!",
  "AcceptGift_Positive_book_item": "\u0410, \u043A\u043D\u0438\u0433\u0430... \u0414\u0430, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435 \u044D\u0442\u0438\u0445 \u0441\u0442\u0440\u0430\u043D\u0438\u0446 \u0434\u0430\u0441\u0442 \u043C\u043D\u0435 \u043D\u043E\u0432\u0443\u044E \u043F\u0438\u0449\u0443 \u0434\u043B\u044F \u0443\u043C\u0430. \u0421\u043F\u0430\u0441\u0438\u0431\u043E.",
  "AcceptGift_(O)814": "\u0410\u0445, \u043F\u0443\u0437\u044B\u0440\u0435\u043A \u0445\u043E\u0440\u043E\u0448\u0438\u0445 \u0447\u0435\u0440\u043D\u0438\u043B. \u041F\u0438\u0441\u0430\u0442\u0435\u043B\u044E \u0438\u0445 \u0432\u0441\u0435\u0433\u0434\u0430 \u043C\u0430\u043B\u043E... \u0410 \u043E\u043D\u0438 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u0434\u043E\u0440\u043E\u0433\u0438\u0435. \u0421\u043F\u0430\u0441\u0438\u0431\u043E!$h",
  "AcceptGift_(O)444": "\u0418\u0437 \u044D\u0442\u043E\u0433\u043E \u0432\u044B\u0439\u0434\u0435\u0442 \u043E\u0442\u043B\u0438\u0447\u043D\u043E\u0435 \u043F\u0438\u0441\u0447\u0435\u0435 \u043F\u0435\u0440\u043E! \u0423 \u043C\u0435\u043D\u044F \u0443\u0436\u0435 \u043F\u0440\u0438\u043B\u0438\u0432 \u0432\u0434\u043E\u0445\u043D\u043E\u0432\u0435\u043D\u0438\u044F...$h",
  "SquidFest": "\u0420\u0435\u0434\u043A\u043E \u043A\u043E\u0433\u0434\u0430 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0448\u044C \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u043B\u044E\u0434\u0435\u0439 \u043D\u0430 \u043F\u043B\u044F\u0436\u0435. \u0418 \u0432\u0441\u0435 \u043E\u0442 \u043B\u044E\u0431\u0432\u0438 \u043A \u043A\u0430\u043B\u044C\u043C\u0430\u0440\u0430\u043C!",
  "firstVisit_ElliottHouse": "\u041E\u0439... \u0418\u0437\u0432\u0438\u043D\u0438, \u0447\u0442\u043E \u0443 \u043C\u0435\u043D\u044F \u0442\u0443\u0442 \u043D\u0435 \u0443\u0431\u0440\u0430\u043D\u043E. \u042F \u0438 \u043D\u0435 \u0434\u0443\u043C\u0430\u043B, \u0447\u0442\u043E \u043A\u0442\u043E-\u0442\u043E \u0437\u0430\u0439\u0434\u0435\u0442!",
  "AcceptGift_(O)154": "\u0424\u0443, \u043E\u043D\u043E \u0432\u0441\u0435 \u0435\u0449\u0435 \u0434\u0440\u044B\u0433\u0430\u0435\u0442\u0441\u044F! \u0423\u0431\u0435\u0440\u0438 \u044D\u0442\u0443 \u0436\u0443\u0442\u044C \u043E\u0442 \u043C\u0435\u043D\u044F \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0435!$6 [154]",
  "AcceptGift_(O)155": "\u0424\u0443, \u043E\u043D\u043E \u0432\u0441\u0435 \u0435\u0449\u0435 \u0434\u0440\u044B\u0433\u0430\u0435\u0442\u0441\u044F! \u0423\u0431\u0435\u0440\u0438 \u044D\u0442\u0443 \u0436\u0443\u0442\u044C \u043E\u0442 \u043C\u0435\u043D\u044F \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0435!$6 [155]",
  "dating_Elliott": "\u041A\u0430\u043A \u0436\u0430\u043B\u044C, \u0447\u0442\u043E \u044F \u043D\u0435 \u043F\u0435\u0440\u0432\u044B\u0439 \u043F\u043E\u0434\u0430\u0440\u0438\u043B \u0442\u0435\u0431\u0435 \u0431\u0443\u043A\u0435\u0442!$l",
  "dating_Elliott_memory_oneday": "%\u042D\u043B\u043B\u0438\u043E\u0442 \u0448\u0435\u043F\u0447\u0435\u0442 \u0432\u0430\u043C \u043D\u0430 \u0443\u0445\u043E \u043C\u0438\u043B\u044B\u0439 \u0441\u0435\u043A\u0440\u0435\u0442.",
  "married_Elliott": "\u0423 \u0442\u0435\u0431\u044F \u0442\u0435\u043F\u0435\u0440\u044C \u0435\u0441\u0442\u044C \u0441\u0430\u043C\u044B\u0439 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u0446\u0432\u0435\u0442\u043E\u043A \u0433\u043E\u0440\u043E\u0434\u0430 \u041F\u0435\u043B\u0438\u043A\u0430\u043D\u0430... \u0417\u0430\u0431\u043E\u0442\u044C\u0441\u044F \u043E \u043D\u0435\u043C \u0441 \u0432\u0435\u043B\u0438\u043A\u043E\u0439 \u043B\u044E\u0431\u043E\u0432\u044C\u044E.",
  "wonIceFishing": "\u041A\u0442\u043E \u044D\u0442\u043E \u0442\u0443\u0442 \u0443 \u043D\u0430\u0441, \u043F\u0435\u0440\u0432\u044B\u0439 \u0440\u044B\u0431\u0430\u043A \u0432 \u0433\u043E\u0440\u043E\u0434\u0435! \u041F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C \u0443 \u0442\u0435\u0431\u044F \u043D\u0430 \u0441\u043B\u0430\u0432\u0443.$h#$e#\u042F \u0442\u0435\u0431\u0435 \u0432 \u043F\u043E\u0434\u043C\u0435\u0442\u043A\u0438 \u043D\u0435 \u0433\u043E\u0436\u0443\u0441\u044C, \u043D\u043E \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C \u043F\u0440\u0438\u043D\u044F\u0442\u044C \u0443\u0447\u0430\u0441\u0442\u0438\u0435.",
  "purchasedAnimal_Duck": "\u0410 \u0442\u044B \u0432 \u043A\u0443\u0440\u0441\u0435, \u0447\u0442\u043E \u0443\u0442\u0438\u043D\u044B\u043C\u0438 \u043F\u0435\u0440\u044C\u044F\u043C\u0438 \u043E\u0447\u0435\u043D\u044C \u0443\u0434\u043E\u0431\u043D\u043E \u043F\u0438\u0441\u0430\u0442\u044C?",
  "eventSeen_39": "\u0422\u044B \u043C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0448\u044C... \u0410 \u0442\u0435\u043F\u0435\u0440\u044C \u0434\u0430\u0439-\u043A\u0430 \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u044C...",
  "eventSeen_40_memory_oneday": "\u041D\u0435 \u0442\u0430\u043A \u0434\u0430\u0432\u043D\u043E \u044F \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E \u043F\u043E\u0441\u0438\u0434\u0435\u043B \u0432 \u0421\u0430\u043B\u0443\u043D\u0435... \u041F\u0435\u0447\u0435\u043D\u044C \u043C\u043E\u044F, \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u0431\u044B\u043B\u0430 \u044D\u0442\u043E\u043C\u0443 \u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u0440\u0430\u0434\u0430...",
  "Resort_Entering": "\u0412\u043E\u0442 \u044D\u0442\u043E \u043C\u044B \u043F\u043E\u043F\u043B\u0430\u0432\u0430\u043B\u0438!",
  "Resort_Leaving": "\u0423\u0432\u0438\u0434\u0438\u043C\u0441\u044F \u0432 \u0434\u043E\u043B\u0438\u043D\u0435.",
  "Resort_Leaving_2": "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u043A\u043E \u043C\u043D\u0435 \u0432 \u043E\u0434\u0435\u0436\u0434\u0443 \u0441\u043D\u043E\u0432\u0430 \u043A\u0440\u0430\u0431 \u043D\u0435 \u0437\u0430\u043F\u043E\u043B\u0437.$s#$b#\u041F\u0440\u043E\u0441\u0442\u043E \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044C, \u0432\u044B\u043B\u0435\u0437\u0430\u0435\u0448\u044C \u0442\u0430\u043A\u043E\u0439 \u0438\u0437 \u043A\u0430\u0440\u043C\u0430\u043D\u0430 \u0438 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C, \u0447\u0442\u043E \u0442\u044B \u0437\u0430 \u0441\u043E\u0442\u043D\u0438 \u043C\u0438\u043B\u044C \u043E\u0442 \u0441\u0432\u043E\u0435\u0433\u043E \u0434\u043E\u043C\u0430!$h#$e#\u0425\u043C... \u0410 \u044D\u0442\u043E \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0441\u044E\u0436\u0435\u0442 \u0434\u043B\u044F \u0440\u043E\u043C\u0430\u043D\u0430...",
  "Resort_Chair": "\u042F \u043D\u0435\u043D\u0430\u0434\u043E\u043B\u0433\u043E \u043F\u0440\u0438\u0441\u0435\u043B, \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0442\u0435\u0440\u0435\u0442\u044C\u0441\u044F \u043A\u043E\u043A\u043E\u0441\u043E\u0432\u044B\u043C \u043C\u0430\u0441\u043B\u043E\u043C.$h",
  "Resort_Bar": "\u0413\u0430\u0441, \u0432\u0441\u0435\u043C \u043D\u0430\u043F\u0438\u0442\u043A\u0438 \u0437\u0430 \u043C\u043E\u0439 \u0441\u0447\u0435\u0442!#$b#*\u0438\u043A*... \u041E\u0439... \u0423 \u043C\u0435\u043D\u044F \u0438 \u0437\u043E\u043B\u043E\u0442\u0430-\u0442\u043E \u043D\u0435\u0442.$s#$b#\u0425\u0435-\u0445\u0435... \u041D\u0443 \u0434\u0430 \u043B\u0430\u0434\u043D\u043E!",
  "Resort_Wander": "\u042F \u0441\u043B\u044B\u0448\u0430\u043B, \u0447\u0442\u043E \u043F\u043E \u043D\u043E\u0447\u0430\u043C \u043D\u0430 \u044D\u0442\u043E\u0442 \u0431\u0435\u0440\u0435\u0433 \u0432\u044B\u0441\u0430\u0436\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u043F\u0438\u0440\u0430\u0442\u044B. \u0418 \u0447\u0442\u043E \u044D\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0442\u0430 \u0435\u0449\u0435 \u0434\u0438\u0447\u044C!",
  "Resort": "\u0414\u043E\u043B\u0436\u0435\u043D \u043F\u0440\u0438\u0437\u043D\u0430\u0442\u044C, \u044D\u0442\u043E\u0442 \u043F\u043B\u044F\u0436 \u0434\u0430\u0436\u0435 \u043C\u0435\u043D\u044F \u043F\u043E\u0440\u0430\u0437\u0438\u043B \u0432 \u0441\u0430\u043C\u043E\u0435 \u0441\u0435\u0440\u0434\u0446\u0435.",
  "Resort_2": "\u0411\u043E\u0436\u0435! \u0414\u0430 \u0443 \u043C\u0435\u043D\u044F \u0432 \u0432\u043E\u043B\u043E\u0441\u0430\u0445 \u0432\u043E\u0434\u043E\u0440\u043E\u0441\u043B\u0438 \u0437\u0430\u043F\u0443\u0442\u0430\u043B\u0438\u0441\u044C.#$e#\u0412\u043E\u0442 \u043F\u043E\u044D\u0442\u043E\u043C\u0443-\u0442\u043E \u044F \u0438 \u043D\u0435 \u043C\u043E\u0433\u0443 \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u0438\u0442\u044C\u0441\u044F \u043D\u0430 \u043F\u043B\u044F\u0436\u0435.",
  "FlowerDance_Accept_Spouse": "\u0414\u0430... \u041B\u044E\u0431\u0432\u0438 \u0441\u0432\u043E\u0435\u0439 \u043C\u043E\u0433\u0443 \u043B\u0438 \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C \u044F? \u041C\u043E\u0433\u0443 \u043B\u0438 \u044F \u043E\u0442\u0432\u0435\u0440\u0433\u043D\u0443\u0442\u044C \u0441\u043B\u0430\u0434\u043A\u0438\u0435 \u0432\u0435\u0441\u043D\u044B \u043E\u0431\u044A\u044F\u0442\u044C\u044F?",
  "FlowerDance_Decline": "\u041F\u0440\u043E\u0448\u0443 \u043F\u0440\u043E\u0449\u0435\u043D\u0438\u044F... \u041D\u0435 \u0441\u0435\u0433\u043E\u0434\u043D\u044F.$s",
  "divorced": "...$s#$e#\u0417\u0430\u0447\u0435\u043C \u0442\u044B \u043C\u0443\u0447\u0430\u0435\u0448\u044C \u043C\u0435\u043D\u044F? \u0420\u0430\u0437\u0432\u0435 \u0442\u044B \u043D\u0435 \u0432\u0438\u0434\u0438\u0448\u044C, \u0447\u0442\u043E \u0432\u0441\u0435 \u043C\u043E\u0438 \u043C\u0435\u0447\u0442\u044B \u0438 \u043D\u0430\u0434\u0435\u0436\u0434\u044B \u0440\u0430\u0437\u0431\u0438\u0442\u044B \u0442\u043E\u0431\u043E\u0439 \u0432\u0434\u0440\u0435\u0431\u0435\u0437\u0433\u0438?$s",
  "dumped_Guys": "\u0423\u0445\u043E\u0434\u0438. \u0412\u0438\u0434\u0435\u0442\u044C \u0442\u0435\u0431\u044F \u043D\u0435 \u043C\u043E\u0433\u0443.$s",
  "secondChance_Guys": "\u0422\u044B \u0442\u0430\u043A \u0441\u0438\u043B\u044C\u043D\u043E \u043C\u0435\u043D\u044F ${\u0440\u0430\u043D\u0438\u043B^\u0440\u0430\u043D\u0438\u043B\u0430}$... \u041D\u043E \u044F \u0433\u043E\u0442\u043E\u0432 \u0437\u0430\u0431\u044B\u0442\u044C \u043F\u0440\u043E \u043F\u0440\u043E\u0448\u043B\u043E\u0435.$s",
  "breakUp": "\u0410\u0445... \u0423\u0432\u044F\u0434\u0448\u0438\u0439 \u0431\u0443\u043A\u0435\u0442. \u041C\u043D\u0435 \u0442\u0430\u043A \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0432\u0438\u0434\u0435\u0442\u044C \u0435\u0433\u043E...$s#$b#\u041F\u043E\u0445\u043E\u0436\u0435, \u0442\u0435\u043F\u0435\u0440\u044C \u043C\u043D\u0435 \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F \u043E\u0431\u0440\u0430\u0442\u0438\u0442\u044C \u0441\u0432\u043E\u0439 \u0432\u0437\u0433\u043B\u044F\u0434 \u043D\u0430 \u043D\u043E\u0432\u044B\u0435 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u044B...$s",
  "Mon": "\u042F \u0438 \u0441\u0430\u043C \u043D\u0435\u0434\u0430\u0432\u043D\u043E \u0432 \u044D\u0442\u043E\u043C \u0433\u043E\u0440\u043E\u0434\u0435, \u043D\u043E \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E \u0441\u0435\u0431\u044F \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043A\u0430\u043A \u0434\u043E\u043C\u0430.$h#$e#\u042F \u043F\u0440\u0438\u0435\u0445\u0430\u043B \u0441\u044E\u0434\u0430 \u0432\u0441\u0435\u0433\u043E \u0437\u0430 \u0433\u043E\u0434 \u0434\u043E \u0442\u0435\u0431\u044F.",
  "Mon4": "\u042F \u043D\u0430\u0434\u0435\u044E\u0441\u044C, \u0447\u0442\u043E \u0438 \u0434\u043B\u044F \u0442\u0435\u0431\u044F \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E \u0443\u0436\u0435 \u043A\u0430\u043A \u0434\u043E\u043C.",
  "Tue": "\u0418\u043D\u043E\u0433\u0434\u0430 \u0432 \u0433\u043E\u043B\u043E\u0432\u0443 \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0438\u0439\u0442\u0438 \u043E\u0442\u043B\u0438\u0447\u043D\u0430\u044F \u0438\u0434\u0435\u044F, \u043A\u043E\u0433\u0434\u0430 \u0435\u0435 \u043C\u0435\u043D\u044C\u0448\u0435 \u0432\u0441\u0435\u0433\u043E \u0436\u0434\u0435\u0448\u044C... \u041D\u043E \u0435\u0435 \u043C\u043E\u0436\u043D\u043E \u0443\u043F\u0443\u0441\u0442\u0438\u0442\u044C, \u0435\u0441\u043B\u0438 \u043C\u044B\u0441\u043B\u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0437\u0430\u043D\u044F\u0442\u044B \u0447\u0435\u043C-\u0442\u043E \u0434\u0440\u0443\u0433\u0438\u043C.#$e#\u041D\u0443, \u0442\u0435\u043F\u0435\u0440\u044C \u043C\u043D\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043D\u0443\u0436\u043D\u043E \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0440\u0430\u0431\u043E\u0442\u0435.",
  "Tue6": "\u041D\u0435\u0436\u043D\u043E\u0435 \u0442\u0440\u0435\u043D\u0438\u0435 \u0440\u0443\u0447\u043A\u0438 \u043E \u0431\u0443\u043C\u0430\u0433\u0443 \u2014 \u043C\u0443\u0437\u044B\u043A\u0430 \u0434\u043B\u044F \u043C\u043E\u0435\u0439 \u0434\u0443\u0448\u0438.$u#$b#\u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u044F \u0438\u0437\u0431\u0440\u0430\u043B \u044D\u0442\u043E\u0442 \u043F\u043B\u044F\u0436 \u0441\u0435\u0431\u0435 \u0434\u043E\u043C\u043E\u043C, \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0432 \u0442\u0438\u0448\u0438\u043D\u0435 \u0438 \u043F\u043E\u043A\u043E\u0435.",
  "Wed": "\u041B\u0435\u0441 \u2014 \u0447\u0443\u0434\u0435\u0441\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E. \u0422\u0435\u0431\u0435 \u0443\u0436\u0435 \u0434\u043E\u0432\u0435\u043B\u043E\u0441\u044C \u0442\u0430\u043C \u043F\u043E\u0431\u044B\u0432\u0430\u0442\u044C?",
  "Wed8": "\u041F\u0440\u043E\u0441\u0442\u0438, \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u0432 \u0434\u0443\u0440\u043D\u043E\u043C \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0438 \u0434\u0443\u0445\u0430.$s#$e#\u041C\u043D\u0435 \u0431\u044B \u0442\u0430\u043A \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C, \u0447\u0442\u043E\u0431\u044B \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043C \u0431\u044B\u043B\u043E \u0431\u043E\u043B\u044C\u0448\u0435 \u044F\u0441\u043D\u043E\u0441\u0442\u0438.$s#$e#\u042F \u043D\u0435 \u0445\u043E\u0447\u0443 \u0441\u043E\u0441\u0442\u0430\u0440\u0438\u0442\u044C\u0441\u044F \u043E\u0434\u0438\u043D\u043E\u043A\u0438\u043C \u043E\u0442\u0448\u0435\u043B\u044C\u043D\u0438\u043A\u043E\u043C \u043D\u0430 \u044D\u0442\u043E\u043C \u043F\u043B\u044F\u0436\u0435...$s",
  "Thu2": "\u042F \u0432\u0441\u0435 \u043D\u0438\u043A\u0430\u043A \u043D\u0435 \u043D\u0430\u0439\u0434\u0443 \u0432\u0434\u043E\u0445\u043D\u043E\u0432\u0435\u043D\u0438\u0435, \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0447\u0430\u0442\u044C \u043F\u0438\u0441\u0430\u0442\u044C \u0441\u0432\u043E\u0439 \u0440\u043E\u043C\u0430\u043D...$s",
  "Thu4": "\u0412 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0432\u0440\u0435\u043C\u044F \u044F \u043F\u043E\u043B\u043E\u043D \u043D\u0430\u0434\u0435\u0436\u0434. \u0411\u044B\u0442\u044C \u043C\u043E\u0436\u0435\u0442, \u044D\u0442\u043E \u0438\u0437-\u0437\u0430 \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u044B \u043F\u043E\u0433\u043E\u0434\u044B.",
  "Thu6": "\u0418\u043D\u043E\u0433\u0434\u0430 \u044F \u0434\u0443\u043C\u0430\u044E, \u0447\u0442\u043E \u044F \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0432\u044B\u0441\u043E\u043A\u043E\u0433\u043E \u043E \u0441\u0435\u0431\u0435 \u043C\u043D\u0435\u043D\u0438\u044F, \u0438 \u0447\u0442\u043E \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439 \u0443 \u043C\u0435\u043D\u044F \u043D\u0435\u0442 \u043D\u0438\u043A\u0430\u043A\u0438\u0445...$s#$e#\u041D\u0435\u0442, \u043D\u0435\u0442... \u042F \u043D\u0435 \u043F\u044B\u0442\u0430\u044E\u0441\u044C \u043D\u0430\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u043A\u043E\u043C\u043F\u043B\u0438\u043C\u0435\u043D\u0442\u044B. \u0425\u043E\u0442\u044F \u0438 \u043D\u0435 \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0441\u044C \u043E\u0442 \u043D\u0438\u0445...",
  "Thu8": "#$1 elliottApol#\u0417\u0434\u0435\u0441\u044C, \u043D\u0430 \u043F\u043B\u044F\u0436\u0435, \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043E\u0434\u0438\u043D\u043E\u043A\u043E... \u041F\u043E\u0442\u043E\u043C\u0443 \u044F \u043F\u0440\u043E\u0448\u0443 \u043F\u0440\u043E\u0449\u0435\u043D\u0438\u044F, \u0435\u0441\u043B\u0438 \u044F \u0431\u044B\u043B \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043F\u0440\u044F\u043C \u043F\u0440\u0438 \u043D\u0430\u0448\u0435\u0439 \u043F\u0435\u0440\u0432\u043E\u0439 \u0432\u0441\u0442\u0440\u0435\u0447\u0435. \u041C\u043D\u0435 \u043B\u0438\u0448\u044C \u043E\u0447\u0435\u043D\u044C \u0441\u0438\u043B\u044C\u043D\u043E \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C \u0438\u043C\u0435\u0442\u044C \u0434\u0440\u0443\u0433\u0430.$k#$e#\u041E\u0447\u0435\u043D\u044C \u043F\u0440\u0438\u044F\u0442\u043D\u043E \u0438\u043C\u0435\u0442\u044C \u0442\u0430\u043A\u043E\u0433\u043E \u0431\u043B\u0438\u0437\u043A\u043E\u0433\u043E \u0434\u0440\u0443\u0433\u0430, \u043A\u0430\u043A \u0442\u044B.",
  "Thu": "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439, @.#$e#\u0412\u0441\u0435 \u043B\u0438 \u0445\u043E\u0440\u043E\u0448\u043E?",
  "Fri": "\u0421\u0432\u0435\u0436\u0438\u0439 \u0432\u043E\u0437\u0434\u0443\u0445 \u044D\u0442\u043E\u0439 \u0434\u043E\u043B\u0438\u043D\u044B \u043F\u043E\u043B\u0435\u0437\u0435\u043D \u0434\u043B\u044F \u0442\u0435\u043B\u0430 \u0438 \u0443\u043C\u0430.#$e#\u041D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F \u043F\u0440\u043E\u0433\u0443\u043B\u043A\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u043E\u0434\u0440\u0438\u0442.",
  "Fri4": "\u041E... \u041D\u0435 \u043F\u043E\u0434\u043D\u043E\u0441\u0438 \u0444\u0430\u043A\u0435\u043B \u0442\u0430\u043A \u0431\u043B\u0438\u0437\u043A\u043E \u043A \u043C\u043E\u0438\u043C \u0432\u043E\u043B\u043E\u0441\u0430\u043C...$8",
  "Fri8": "\u042F \u043F\u0440\u0438\u0437\u043D\u0430\u044E\u0441\u044C... \u041C\u043D\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0442\u0440\u0430\u0442\u0438\u0442\u044C \u043F\u043E \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0447\u0430\u0441\u043E\u0432 \u043A\u0430\u0436\u0434\u044B\u043C \u0443\u0442\u0440\u043E\u043C, \u0447\u0442\u043E\u0431\u044B \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0432\u043E\u043B\u043E\u0441\u044B \u0432 \u0442\u0430\u043A\u043E\u0439 \u043A\u0440\u0430\u0441\u043E\u0442\u0435.",
  "Sat": "\u041F\u043E\u0436\u0430\u043B\u0443\u0439, \u0442\u0435\u0431\u0435 \u0431\u044B \u043D\u0435 \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u043E\u0441\u044C \u0432 \u043C\u043E\u0435\u043C \u0434\u043E\u043C\u0438\u043A\u0435. \u0422\u0430\u043C \u0442\u0435\u043C\u043D\u043E \u0438 \u043F\u043E\u043B\u043D\u043E \u043F\u0430\u0443\u043A\u043E\u0432.$s",
  "Sat4": "\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043F\u0440\u043E\u0441\u0442\u0438, \u0447\u0442\u043E \u043C\u043E\u0439 \u0434\u043E\u043C\u0438\u043A \u0432 \u0442\u0430\u043A\u043E\u043C \u043F\u043B\u0430\u0447\u0435\u0432\u043D\u043E\u043C \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438.",
  "Sat6": "\u0418\u043D\u043E\u0433\u0434\u0430 \u043B\u044E\u0434\u0438 \u0431\u044B\u0432\u0430\u044E\u0442 \u0441\u0442\u0435\u0441\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B. \u041E\u0434\u0430\u0440\u0438\u0432\u0430\u0439 \u0438\u0445 \u0441\u0432\u043E\u0438\u043C \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435\u043C, \u0438 \u0438\u043C \u0441\u0442\u0430\u043D\u0435\u0442 \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u043E \u0441 \u0442\u043E\u0431\u043E\u0439.#$e#\u0412\u0441\u0435 \u0445\u043E\u0442\u044F\u0442 \u0438\u043C\u0435\u0442\u044C \u0434\u0440\u0443\u0437\u0435\u0439, \u0434\u0430\u0436\u0435 \u0442\u043E\u0442 \u0443\u0433\u0440\u044E\u043C\u044B\u0439 \u043A\u0443\u0437\u043D\u0435\u0446.",
  "Sun": "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439. \u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0436\u0438\u0437\u043D\u044C \u043D\u0430 \u0444\u0435\u0440\u043C\u0435 \u043E\u043F\u0440\u0430\u0432\u0434\u044B\u0432\u0430\u0435\u0442 \u0442\u0432\u043E\u0438 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u044F?",
  "Sun6": "\u041E, @! \u042F \u043A\u0430\u043A \u0440\u0430\u0437 \u043D\u0430\u0434\u0435\u044F\u043B\u0441\u044F \u0442\u0435\u0431\u044F \u0443\u0432\u0438\u0434\u0435\u0442\u044C.#$e#\u0412\u0441\u0435\u0433\u0434\u0430 \u043F\u0440\u0438\u044F\u0442\u043D\u043E \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C\u0441\u044F \u0441 \u0442\u043E\u0431\u043E\u0439.$h",
  "event_idea1": "\u0414\u0435\u0442\u0435\u043A\u0442\u0438\u0432, \u0445\u043C? \u0416\u0430\u043D\u0440 \u0432\u043E\u043B\u043D\u0443\u044E\u0449\u0438\u0439, \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u043E. \u042F \u044D\u0442\u043E \u0437\u0430\u043F\u043E\u043C\u043D\u044E.",
  "event_idea2": "\u0410\u0445, \u043E\u0434\u0438\u043D \u0438\u0437 \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0436\u0430\u043D\u0440\u043E\u0432. \u042F \u044D\u0442\u043E \u0437\u0430\u043F\u043E\u043C\u043D\u044E.",
  "event_idea3": "\u041D\u0438 \u0437\u0430 \u0447\u0442\u043E \u0431\u044B \u043D\u0435 \u0434\u043E\u0433\u0430\u0434\u0430\u043B\u0441\u044F! \u041F\u043E\u043B\u0430\u0433\u0430\u044E, \u0434\u0430\u0436\u0435 \u043B\u044E\u0434\u0438 \u0441\u0430\u043C\u044B\u0445 \u00AB\u043F\u0440\u0438\u0437\u0435\u043C\u043B\u0435\u043D\u043D\u044B\u0445\u00BB \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u0439 \u0438\u043D\u043E\u0433\u0434\u0430 \u043B\u044E\u0431\u044F\u0442 \u043F\u043E\u043C\u0435\u0447\u0442\u0430\u0442\u044C \u043E \u0437\u0432\u0435\u0437\u0434\u0430\u0445.$h#$b#\u042F \u044D\u0442\u043E \u0437\u0430\u043F\u043E\u043C\u043D\u044E.",
  "event_boat1": "... \u042F \u0431\u043E\u044F\u043B\u0441\u044F, \u0447\u0442\u043E \u0442\u044B \u043D\u0435 \u0441\u043C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C \u0442\u0430\u043A\u043E\u0435 \u043A \u0434\u0440\u0443\u0433\u043E\u043C\u0443 \u043C\u0443\u0436\u0447\u0438\u043D\u0435.$l^\u0418 \u0434\u043B\u044F \u043C\u0435\u043D\u044F \u0442\u043E\u0436\u0435.$l",
  "event_boat2": "\u0410\u0445! \u041F\u0440\u043E\u0441\u0442\u0438 \u043C\u0435\u043D\u044F...$8%fork",
  "event_toast1": "\u041D\u0443... \u041B\u0430\u0434\u043D\u043E.#$b#@, \u0437\u0430 \u0442\u0435\u0431\u044F!",
  "event_toast2": "\u041E\u0442\u043B\u0438\u0447\u043D\u0430\u044F \u043C\u044B\u0441\u043B\u044C!$h#$b#\u0417\u0430 \u043D\u0430\u0441!",
  "event_toast3": "\u0425\u043C-\u043C-\u043C... \u0414\u0430\u0432\u0430\u0439 \u043B\u0443\u0447\u0448\u0435 \u0431\u0435\u0437 \u0442\u043E\u0441\u0442\u0430.$a",
  "event_toast4": "\u0410\u0445, \u0437\u0430 \u0433\u0430\u0440\u043C\u043E\u043D\u0438\u0447\u043D\u043E\u0435 \u0431\u0443\u0434\u0443\u0449\u0435\u0435 \u043D\u0430\u0448\u0435\u0433\u043E \u0441\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430... \u041A\u0430\u043A\u0430\u044F \u0431\u043B\u0430\u0433\u043E\u043D\u0440\u0430\u0432\u043D\u0430\u044F \u043C\u044B\u0441\u043B\u044C.#$b#\u0417\u0430 \u0433\u043E\u0440\u043E\u0434 \u041F\u0435\u043B\u0438\u043A\u0430\u043D!",
  "summer_Mon": "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0443\u0442\u0440\u043E\u043C \u043C\u0435\u043D\u044F \u0440\u0430\u0437\u0431\u0443\u0434\u0438\u043B \u043D\u0435\u0436\u043D\u044B\u0439 \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u044B\u0439 \u043B\u0443\u0447\u0438\u043A. \u041D\u0438\u043A\u043E\u0433\u0434\u0430 \u0435\u0449\u0435 \u043D\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B \u0441\u0435\u0431\u044F \u0442\u0430\u043A \u0441\u0432\u0435\u0436\u043E.$u#$e#\u041F\u0440\u043E\u0441\u0442\u0438, \u0435\u0441\u043B\u0438 \u0442\u0435\u0431\u0435 \u044D\u0442\u043E \u043D\u0435\u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E.",
  "summer_Mon4": "\u042F \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0022\u0447\u0443\u0434\u0430\u043A\u043E\u0432\u0430\u0442\u0022.#$e#\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0442\u0435\u0431\u044F \u044D\u0442\u043E \u043D\u0435 \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0438\u0442.$h",
  "summer_Mon6": "@, \u044F \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0442\u044B \u0432\u0435\u0440\u0438\u0448\u044C \u0432 \u043C\u043E\u0438 \u043F\u0438\u0441\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438. \u042D\u0442\u043E \u043C\u043D\u043E\u0433\u043E \u0434\u043B\u044F \u043C\u0435\u043D\u044F \u0437\u043D\u0430\u0447\u0438\u0442.$h",
  "summer_Tue": "\u042F \u043D\u0430\u0448\u0435\u043B \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0445 \u0440\u0430\u043A\u0443\u0448\u0435\u043A \u043F\u0435\u0440\u0435\u0434 \u0441\u0432\u043E\u0438\u043C \u0434\u043E\u043C\u043E\u043C.#$e#\u041F\u043E\u043B\u0430\u0433\u0430\u044E, \u0440\u0435\u0434\u043A\u0438\u0435 \u0438\u0445 \u0440\u0430\u0437\u043D\u043E\u0432\u0438\u0434\u043D\u043E\u0441\u0442\u0438 \u0432\u0435\u0441\u044C\u043C\u0430 \u0446\u0435\u043D\u043D\u044B.",
  "summer_Tue6": "\u042F \u043F\u0438\u0448\u0443 \u0432 \u043D\u0430\u0434\u0435\u0436\u0434\u0435 \u043F\u0440\u0438\u043A\u043E\u0441\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0443\u043C\u0430\u043C \u0434\u0440\u0443\u0433\u0438\u0445 \u0447\u0435\u0440\u0435\u0437 \u0432\u0440\u0435\u043C\u044F \u0438 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E.$u#$e#\u041E\u0445... \u0412\u0440\u0435\u043C\u0435\u043D\u0430, \u043E\u0434\u043D\u0430\u043A\u043E, \u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F. \u041B\u044E\u0434\u0438 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0447\u0438\u0442\u0430\u044E\u0442 \u043A\u043D\u0438\u0433.$s",
  "summer_Wed": "\u0414\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C, \u043E\u0447\u0435\u043D\u044C \u043F\u0440\u0438\u044F\u0442\u043D\u043E \u0432\u0438\u0434\u0435\u0442\u044C, \u043A\u0430\u043A \u0440\u0430\u0441\u0442\u0443\u0442 \u0442\u0432\u043E\u0438 \u043F\u043E\u0441\u0435\u0432\u044B, \u043E\u0442 \u0437\u0435\u0440\u043D\u0430 \u0434\u043E \u043F\u043B\u043E\u0434\u0430.#$e#\u0422\u044B \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u043D\u0430\u0434\u0435\u043B\u044F\u0435\u0448\u044C \u043F\u043B\u043E\u0434 \u0441\u0432\u043E\u0435\u0439 \u0441\u0443\u0449\u043D\u043E\u0441\u0442\u044C\u044E.$u",
  "summer_Thu": "\u0411\u043E\u0436\u0435! \u0412 \u043C\u043E\u0438\u0445 \u0442\u0443\u0444\u043B\u044F\u0445 \u043F\u043E\u043B\u043D\u043E \u043F\u0435\u0441\u043A\u0430.$s#$e#\u0412 \u044D\u0442\u043E\u043C \u0437\u0430\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430 \u0436\u0438\u0437\u043D\u0438 \u043D\u0430 \u043F\u043B\u044F\u0436\u0435.",
  "summer_Fri": "@? \u0422\u044B \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0448\u044C \u043E\u0437\u0430\u0434\u0430\u0447\u0435\u043D\u043D\u043E.#$b#\u0414\u0443\u043C\u0430\u044E, \u043E\u0442 \u0433\u043E\u0440\u044F\u0447\u0435\u0433\u043E \u043B\u0435\u0442\u043D\u0435\u0433\u043E \u0432\u043E\u0437\u0434\u0443\u0445\u0430 \u0443 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0438\u0437 \u043D\u0430\u0441 \u043C\u043E\u0436\u0435\u0442 \u0437\u0430\u043A\u0440\u0443\u0436\u0438\u0442\u044C\u0441\u044F \u0433\u043E\u043B\u043E\u0432\u0430.",
  "summer_Sat": "\u0421\u043E\u043B\u043D\u0446\u0435 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0441\u0435\u0440\u0434\u0438\u0442\u043E... \u0411\u043E\u044E\u0441\u044C, \u043C\u043E\u044F \u043A\u043E\u0436\u0430 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u0430 \u0434\u043B\u044F \u0442\u0430\u043A\u043E\u0433\u043E.",
  "summer_Sun": "\u0422\u044B \u0437\u0434\u0435\u0441\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u044F \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0441\u043E \u043C\u043D\u043E\u0439? \u041A\u0430\u043A\u043E\u0439 \u0434\u043E\u0431\u0440\u044B\u0439 \u043F\u043E\u0441\u0442\u0443\u043F\u043E\u043A.$h",
  "summer_Sun4": "\u0417\u0430\u0445\u043E\u0434\u0438 \u043A\u043E \u043C\u043D\u0435 \u0432 \u0434\u043E\u043C\u0438\u043A \u043A\u043E\u0433\u0434\u0430 \u043F\u043E\u0436\u0435\u043B\u0430\u0435\u0448\u044C. \u041A\u043E\u043C\u043F\u0430\u043D\u0438\u044F \u043D\u0435 \u0431\u0443\u0434\u0435\u0442 \u043C\u043D\u0435 \u043B\u0438\u0448\u043D\u0435\u0439.$h",
  "fall_Mon": "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439, @.#$e#\u041D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439 \u0438\u043D\u043E\u0433\u0434\u0430 \u043E\u0442\u0434\u044B\u0445\u0430\u0442\u044C \u043E\u0442 \u0440\u0430\u0431\u043E\u0442\u044B.",
  "fall_Mon4": "\u041F\u0440\u0438\u0445\u043E\u0434\u0438 \u043A\u043E \u043C\u043D\u0435, \u0435\u0441\u043B\u0438 \u0437\u0430\u0445\u043E\u0447\u0435\u0448\u044C \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C \u043E\u0442 \u0442\u0440\u0443\u0434\u043E\u0432.$h#$e#\u042F \u043E\u0431\u044B\u0447\u043D\u043E \u0431\u044B\u0432\u0430\u044E \u0443 \u0441\u0435\u0431\u044F \u0434\u043E\u043C\u0430.",
  "fall_Tue": "\u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u0434\u0430\u0432\u043D\u044B\u043C-\u0434\u0430\u0432\u043D\u043E \u0437\u0434\u0435\u0441\u044C \u0440\u0430\u0437\u0431\u0438\u043B\u0441\u044F \u043F\u0438\u0440\u0430\u0442\u0441\u043A\u0438\u0439 \u043A\u043E\u0440\u0430\u0431\u043B\u044C, \u043F\u043E\u043B\u043D\u044B\u0439 \u043D\u0430\u0433\u0440\u0430\u0431\u043B\u0435\u043D\u043D\u043E\u0433\u043E \u0437\u043E\u043B\u043E\u0442\u0430.",
  "GreenRain": "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u043D\u0435 \u0431\u0443\u0434\u0435\u043C \u0434\u0440\u0430\u043C\u0430\u0442\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C... \u0413\u0430\u0441! \u0414\u0430\u0432\u0430\u0439 \u0437\u0430\u043A\u0430\u0436\u0435\u043C \u0432\u044B\u043F\u0438\u0432\u043A\u0438 \u043D\u0430 \u0432\u0441\u0435\u0445, \u0447\u0442\u043E\u0431\u044B \u0443\u0441\u043F\u043E\u043A\u043E\u0438\u0442\u044C \u043D\u0435\u0440\u0432\u044B!%noturn",
  "GreenRain_2": "\u0410\u0445, \u0435\u0449\u0435 \u043E\u0434\u0438\u043D \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u044B\u0439 \u0434\u0435\u043D\u044C. \u042D\u0442\u043E, \u043C\u044F\u0433\u043A\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u044C, \u0432\u0435\u0441\u044C\u043C\u0430 \u0431\u043E\u0434\u0440\u0438\u0442!",
  "fall_Tue8": "@, \u044F \u043A\u0430\u043A \u0440\u0430\u0437 \u0434\u0443\u043C\u0430\u043B \u043E \u0442\u0435\u0431\u0435.$l#$e#\u041C\u043E\u0436\u0435\u0442, \u0442\u044B \u044D\u0442\u043E \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044C.$h#$e#\u0418\u0442\u0430\u043A! \u041F\u043E\u0432\u0435\u0434\u0430\u0439 \u043C\u043D\u0435, \u043A\u0430\u043A \u043F\u0440\u043E\u0448\u0435\u043B \u0442\u0432\u043E\u0439 \u0434\u0435\u043D\u044C?",
  "fall_Wed8": "\u042F \u0431\u044B \u043D\u0435 \u0432\u043E\u0437\u0440\u0430\u0436\u0430\u043B \u043F\u0440\u043E\u0442\u0438\u0432 \u0436\u0438\u0437\u043D\u0438 \u043D\u0430 \u0444\u0435\u0440\u043C\u0435.#$e#\u0421\u043F\u043E\u043A\u043E\u0439\u043D\u0430\u044F \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0430 \u0444\u0435\u0440\u043C\u044B \u043C\u043E\u0436\u0435\u0442 \u0441\u0442\u0430\u0442\u044C \u0445\u043E\u0440\u043E\u0448\u0438\u043C \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u043E\u043C \u043B\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043D\u043E\u0433\u043E \u0432\u0434\u043E\u0445\u043D\u043E\u0432\u0435\u043D\u0438\u044F, \u0442\u044B \u0442\u0430\u043A \u043D\u0435 \u0434\u0443\u043C\u0430\u0435\u0448\u044C?$h",
  "fall_Thu": "\u0411\u043E\u0436\u0435! \u041F\u043E\u0445\u043E\u0436\u0435, \u0432 \u043A\u0430\u0440\u043C\u0430\u043D\u0435 \u043C\u043E\u0435\u0439 \u0440\u0443\u0431\u0430\u0448\u043A\u0438 \u043F\u043E\u0441\u0435\u043B\u0438\u043B\u0441\u044F \u043A\u0440\u043E\u0448\u0435\u0447\u043D\u044B\u0439 \u043A\u0440\u0430\u0431\u0438\u043A.$l#$e#\u0412 \u044D\u0442\u043E\u043C \u0437\u0430\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430 \u0436\u0438\u0437\u043D\u0438 \u043D\u0430 \u043F\u043B\u044F\u0436\u0435.",
  "fall_Fri4": "\u0423 \u043C\u0435\u043D\u044F \u0437\u0430\u0442\u0435\u043A\u043B\u0438 \u043D\u043E\u0433\u0438, \u044F \u0432\u0441\u044E \u043D\u043E\u0447\u044C \u0441\u0438\u0434\u0435\u043B \u0437\u0430 \u043F\u0438\u0441\u044C\u043C\u0435\u043D\u043D\u044B\u043C \u0441\u0442\u043E\u043B\u043E\u043C.$s#$e#\u0418\u043D\u043E\u0433\u0434\u0430 \u044F \u0437\u0430\u0432\u0438\u0434\u0443\u044E \u0442\u0435\u0431\u0435, @.",
  "fall_Fri": "\u0423 \u043C\u0435\u043D\u044F \u0437\u0430\u0442\u0435\u043A\u043B\u0438 \u043D\u043E\u0433\u0438, \u044F \u0432\u0441\u0435 \u0443\u0442\u0440\u043E \u0441\u0438\u0434\u0435\u043B \u0437\u0430 \u043F\u0438\u0441\u044C\u043C\u0435\u043D\u043D\u044B\u043C \u0441\u0442\u043E\u043B\u043E\u043C.$s",
  "fall_Fri10": "@, \u043A\u043E\u0433\u0434\u0430 \u0442\u044B \u0440\u044F\u0434\u043E\u043C... \u042F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u044B\u0439 \u0442\u0432\u043E\u0440\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u043E\u0434\u044A\u0435\u043C.$l#$e#\u042F \u0437\u043D\u0430\u044E... \u042D\u0442\u043E \u0441\u0442\u0440\u0430\u043D\u043D\u043E, \u043D\u043E \u044D\u0442\u043E \u0442\u0430\u043A.",
  "fall_Sat": "\u0412 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u0433\u043E\u0434\u0430 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0432\u0435\u0442\u0440\u0435\u043D\u043E. \u0427\u0443\u0434\u0435\u0441\u043D\u043E!$h",
  "fall_Sun": "\u041D\u0443\u0436\u043D\u043E \u043D\u0435 \u0437\u0430\u0431\u044B\u0442\u044C \u043F\u043E\u043B\u0438\u0442\u044C \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F. \u0418 \u043D\u0430 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u2014 \u043D\u0435 \u0441\u043E\u043B\u0435\u043D\u043E\u0439 \u0432\u043E\u0434\u043E\u0439!",
  "winter_Mon": "\u0422\u044B \u0437\u0434\u0435\u0441\u044C, \u0432 \u0442\u0430\u043A\u043E\u0439 \u043C\u043E\u0440\u043E\u0437, \u0440\u0430\u0434\u0438 \u043C\u0435\u043D\u044F?#$e#\u042F \u043D\u0435 \u043F\u0440\u043E\u0442\u0438\u0432 \u043F\u0435\u0440\u0435\u0434\u044B\u0448\u043A\u0438 \u043E\u0442 \u0441\u0432\u043E\u0438\u0445 \u043E\u0434\u0438\u043D\u043E\u043A\u0438\u0445 \u0442\u0440\u0443\u0434\u043E\u0432.",
  "winter_Mon4": "@, \u0442\u044B \u0437\u0434\u0435\u0441\u044C \u0440\u0430\u0434\u0438 \u043C\u0435\u043D\u044F, \u043F\u0440\u043E\u0439\u0434\u044F \u0447\u0435\u0440\u0435\u0437 \u0432\u0435\u0441\u044C \u044D\u0442\u043E\u0442 \u0441\u043D\u0435\u0433?#$e#\u042D\u0442\u043E \u0447\u0435\u0441\u0442\u044C \u0434\u043B\u044F \u043C\u0435\u043D\u044F!$h",
  "winter_Tue": "\u041B\u044E\u0434\u0438 \u0442\u044B\u0441\u044F\u0447\u0435\u043B\u0435\u0442\u0438\u044F\u043C\u0438 \u0432\u044B\u0436\u0438\u0432\u0430\u043B\u0438 \u043D\u0430 \u0434\u0430\u0440\u0430\u0445 \u043C\u043E\u0440\u044F.#$e#\u042F \u0436\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0445\u043E\u0436\u0443 \u0437\u0430 \u0435\u0434\u043E\u0439 \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D.$s",
  "winter_Tue10": "@, \u0443 \u043C\u0435\u043D\u044F \u0431\u044B\u043B\u043E \u0447\u0443\u0432\u0441\u0442\u0432\u043E, \u0447\u0442\u043E \u0442\u044B \u043F\u0440\u0438\u0434\u0435\u0448\u044C.#$e#\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043C\u044B \u0441\u0432\u044F\u0437\u0430\u043D\u044B \u043F\u043E\u0442\u0443\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0435\u0439 \u043D\u0438\u0442\u044C\u044E.$l",
  "-winter_Wed": "\u0414\u0435\u043D\u044C \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0431\u044B\u0432\u0430\u0435\u0442 \u0441\u043A\u0443\u0447\u043D\u044B\u043C, \u043A\u043E\u0433\u0434\u0430 \u0441\u043B\u0435\u0434\u0443\u0435\u0448\u044C \u043A\u0430\u043F\u0440\u0438\u0437\u0430\u043C \u0441\u0432\u043E\u0435\u0433\u043E \u0432\u043E\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F.$u#$e#\u041F\u0440\u043E\u0441\u0442\u0438, \u044F \u043E\u043F\u044F\u0442\u044C \u0431\u043E\u043B\u0442\u0430\u044E \u043E \u0435\u0440\u0443\u043D\u0434\u0435?",
  "winter_Thu": "\u0421\u0434\u0435\u043B\u0430\u0439 \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439 \u0432\u0434\u043E\u0445. \u0427\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044C? \u042D\u0442\u043E \u0437\u0430\u043F\u0430\u0445 \u043C\u043E\u0440\u044F.#$e#\u041A\u0430\u043A\u0438\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0430 \u043E\u043D \u0443 \u0442\u0435\u0431\u044F \u0432\u044B\u0437\u044B\u0432\u0430\u0435\u0442?",
  "winter_Thu6": "\u0421\u0434\u0435\u043B\u0430\u0439 \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439 \u0432\u0434\u043E\u0445. \u0427\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044C? \u042D\u0442\u043E \u0437\u0430\u043F\u0430\u0445 \u043C\u043E\u0440\u044F.#$e#\u041A\u0430\u0436\u0434\u044B\u0439 \u0440\u0430\u0437, \u043A\u043E\u0433\u0434\u0430 \u044F \u0447\u0443\u044E \u0437\u0430\u043F\u0430\u0445 \u043C\u043E\u0440\u044F, \u044F \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u044E \u043E \u044E\u043D\u043E\u0441\u0442\u0438. \u041A\u043E\u0433\u0434\u0430 \u044F \u0431\u044B\u043B \u0440\u0435\u0431\u0435\u043D\u043A\u043E\u043C, \u043E\u043A\u0435\u0430\u043D \u043C\u0435\u043D\u044F \u043E\u0447\u0435\u043D\u044C \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0438\u043B.",
  "winter_Fri": "\u041C\u043D\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0435\u0436\u0435\u0434\u043D\u0435\u0432\u043D\u043E \u0440\u0430\u0441\u0447\u0435\u0441\u044B\u0432\u0430\u0442\u044C \u0432\u043E\u043B\u043E\u0441\u044B, \u0438\u043D\u0430\u0447\u0435 \u043E\u043D\u0438 \u0441\u043E\u0431\u044C\u044E\u0442\u0441\u044F \u0432 \u043A\u043E\u043B\u0442\u0443\u043D\u044B.#$e#\u042D\u0442\u043E \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0442\u0440\u0443\u0434.#$e#\u042F \u0443\u0434\u0438\u0432\u043B\u0435\u043D, \u043A\u0430\u043A \u044F \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u043D\u0435 \u0441\u0431\u0440\u0438\u043B \u0438\u0445 \u0432 \u0441\u0435\u0440\u0434\u0446\u0430\u0445.$h#$e#\u041F\u043E\u043B\u0430\u0433\u0430\u044E, \u044F \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u043B\u044F \u044D\u0442\u043E\u0433\u043E \u0442\u0449\u0435\u0441\u043B\u0430\u0432\u0435\u043D.",
  "winter_Sat": "\u042F \u0434\u0435\u043B\u0430\u044E \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0443\u044E \u0437\u0430\u0440\u044F\u0434\u043A\u0443 \u0434\u043E\u043C\u0430, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0441\u043D\u0430\u0440\u0443\u0436\u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0445\u043E\u043B\u043E\u0434\u043D\u043E.#$e#\u041F\u0440\u043E\u0441\u0442\u0438, \u0435\u0441\u043B\u0438 \u0432 \u0434\u043E\u043C\u0438\u043A\u0435 \u0432\u043B\u0430\u0436\u043D\u043E\u0432\u0430\u0442\u043E.$s",
  "winter_Sun": "\u041C\u043D\u0435 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u043D\u0443\u0436\u043D\u043E \u043D\u0430\u0442\u0435\u0440\u0435\u0442\u044C \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043F\u043E\u043B\u044B. \u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u043D\u0430 \u043D\u0438\u0445 \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442 \u0440\u0430\u0441\u0442\u0438 \u0432\u043E\u0434\u043E\u0440\u043E\u0441\u043B\u0438.$s#$e#\u0422\u044B \u0432\u044B\u0434\u0435\u043B\u044F\u0435\u0448\u044C \u0441\u0435\u0431\u0435 \u0432\u0440\u0435\u043C\u044F \u043D\u0430 \u0443\u0431\u043E\u0440\u043A\u0443?"
}