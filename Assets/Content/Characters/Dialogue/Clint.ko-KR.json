  "Sat": "\uAC00\uB054 \uC5B4\uCA4C\uB2E4 \uB0B4\uAC00 \uC774 \uB9C8\uC744\uC5D0 \uBA38\uBB3C\uAC8C \uB418\uC5C8\uB098 \uC2F6\uC5B4.$u",
