  "Thu2_2": "\uBB50, \uC544\uBC84\uC9C0\uAED8\uC11C \uB3CC\uC544\uC624\uC168\uC5B4. \uB9CC\uB098\uBD24\uC5B4?#$b#\uBB34\uC0AC\uD558\uC154\uC11C \uB2E4\uD589\uC774\uC57C.",
