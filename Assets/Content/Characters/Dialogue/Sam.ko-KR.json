  "Fri4": "\uC544\uBC84\uC9C0\uB294 \uB3C4\uC2DC\uC5D0\uC11C \uC9C0\uB0BC \uB550 \uC4F0\uB808\uAE30 \uCCAD\uC18C\uBD80 \uC168\uC5B4.#$e#\uB2E4\uB978 \uC0AC\uB78C\uB4E4\uC774 \uBCC4 \uC774\uC0C1\uD558\uACE0 \uB054\uCC0D\uD55C \uAC78 \uBC84\uB9B0\uB2E4\uACE0 \uD558\uC168\uC9C0.",
  "Fri10": "\uB098\uC774\uAC00 \uB4E4\uC218\uB85D \uC774 \uACC4\uACE1\uC5D0 \uC815\uC774 \uB354 \uB4DC\uB098 \uBD10.#$b#\uBB50... \uD2B9\uC815 \uC774\uC720 \uB54C\uBB38\uC5D0 \uD3B8\uACAC\uC774 \uC788\uC744 \uC218\uB3C4 \uC788\uC9C0\uB9CC.$10#$e#\uC544, \uADF8\uB798\uC11C, \uC624\uB298 \uD558\uB8E8\uB294 \uC5B4\uB54C?$h",
  "Sat4": "\uC544! \uD560\uBA38\uB2C8\uAED8 \uC804\uD654\uB4DC\uB824\uC57C \uD55C\uB2E4\uB294 \uAC70 \uBC29\uAE08 \uAE30\uC5B5\uB0AC\uB2E4. \uC88B\uC544, \uC78A\uC9C0 \uC54A\uB3C4\uB85D \uC190\uBAA9\uC5D0 \uACE0\uBB34\uC904 \uCC28\uC57C\uC9C0.#$e#\uB09C \uC774\uB7F0 \uC2DD\uC73C\uB85C \uAE30\uC5B5\uD560 \uC218 \uC788\uAC8C \uD574\uB450\uC9C0 \uC54A\uC73C\uBA74 \uC644\uC804\uD788 \uAE4C\uBA39\uC5B4.$h",
  "Sat": "\uD760. \uBD84\uBA85 \uBB54\uAC00 \uD558\uB824\uACE0 \uD588\uB2E4\uB294 \uAC8C \uAE30\uC5B5\uB0AC\uB294\uB370... \uADF8\uAC8C \uBB54\uC9C0 \uAE4C\uBA39\uC5C8\uC5B4.#$e#\uD56D\uC0C1 \uC788\uB294 \uC77C\uC774\uAE34 \uD574.",
  "Sun8": "\uAC00\uB054 \uC5C4\uB9C8\uAC00 \uC9C4\uC9DC\uB85C \uD589\uBCF5\uD55C\uC9C0 \uAD81\uAE08\uD574...$s#$e#\uD55C\uBC88 \uBB3C\uC5B4\uBD24\uB2E4\uAC00 \uBB54\uAC00 \uB0B4\uBA74\uC5D0 \uC544\uD514\uC744 \uC228\uAE30\uB294 \uAC83 \uAC19\uC740 \uB290\uB08C\uC774 \uB4E4\uC5C8\uC5B4.",
  "Sun": "\uC624, \uC624\uB298 \uB0A0\uC528 \uAD1C\uCC2E\uB124... \uADF8\uCE58?",
  "10": "\uC57C, \uC5B4\uC81C \uACBD\uAE30 \uBD24\uC5B4?#$b#\uC544\uB2C8 \uC7A0\uAE50, \uC9D1\uC5D0 \uD2F0\uBE44 \uC788\uAE34 \uD558\uC9C0...?",
  "14": "\uC5B4, \uBC29\uAE08 \uBB54\uAC00 \uC5ED\uACA8\uC6B4 \uAC78 \uBC1F\uC558\uC5B4... \uC774 \uC2E0\uBC1C \uC0B0\uC9C0 \uC5BC\uB9C8 \uC548 \uB410\uB294\uB370.$s",
  "spring_21": "\uAC00\uB054 \uBD04\uC5D0 \uAF43\uC78E\uC774 \uD718\uB0A0\uB9AC\uBA74 \uCF54\uAC00 \uD758\uB7EC.$s#$e#\uB09C \uAC1C\uC778\uC801\uC73C\uB85C \uC5EC\uB984\uC774 \uC81C\uC77C \uB9C8\uC74C\uC5D0 \uB4E4\uC5B4.",
  "Event_band1": "\uC57C, \uADF8\uAC70 \uC54C\uC544? \uB531 \uB0B4\uAC00 \uC0DD\uAC01\uD558\uB358 \uBC34\uB4DC \uC2A4\uD0C0\uC77C\uC774\uC57C.",
  "Event_band2": "\uC57C, \uADF8\uAC70 \uC54C\uC544? \uB531 \uB0B4\uAC00 \uC0DD\uAC01\uD558\uB358 \uBC34\uB4DC \uC2A4\uD0C0\uC77C\uC774\uC57C.",
  "Event_band3": "\uC57C, \uADF8\uAC70 \uC54C\uC544? \uB531 \uB0B4\uAC00 \uC0DD\uAC01\uD558\uB358 \uBC34\uB4DC \uC2A4\uD0C0\uC77C\uC774\uC57C.",
  "Event_band4": "\uC57C, \uADF8\uAC70 \uC54C\uC544? \uB531 \uB0B4\uAC00 \uC0DD\uAC01\uD558\uB358 \uBC34\uB4DC \uC2A4\uD0C0\uC77C\uC774\uC57C.",
  "event_room1": "\uC544, \uADF8\uB807\uAD6C\uB098.",
  "spring_12": "\uB0B4 \uB3D9\uC0DD\uC740 \uCD95\uC81C\uB97C \uC81C\uC77C \uC88B\uC544\uD558\uB294 \uAC83 \uAC19\uC544. \uB0B4\uC77C \uB2EC\uAC40 \uC0AC\uB0E5\uC5D0 \uB300\uD574 \uC624\uB298 \uD558\uB8E8 \uC885\uC77C \uC598\uAE30\uD588\uC5B4.",
  "spring_23": "\uBD04\uAF43 \uBB34\uB3C4\uD68C\uAC00 \uC624\uB298\uC774\uBA74 \uC77C \uC548 \uB098\uAC00\uB3C4 \uB418\uB294 \uAC74\uB370 \uB9D0\uC774\uC57C.$s",
  "winter_7": "\uD55C \uBC88\uC740, \uC5BC\uC74C\uCD95\uC81C \uC911\uC5D0 \uAC70\uC2A4\uAC00 \uAC15\uC5D0 \uBE60\uC84C\uC5B4. \uAC70\uC2A4 \uC544\uC800\uC528 \uBAB8 \uB370\uC6CC\uB4DC\uB9AC\uB824\uACE0 \uC8FC\uC810\uC5D0 \uC5C4\uCCAD \uD070 \uBD88\uB3C4 \uC9C0\uD3C8\uC5B4.#$e#\uB2E4\uC2DC\uB294 \uC544\uC800\uC528 \uC2A4\uD30C\uAC8C\uD2F0\uB97C \uB9DB\uBCFC\uC218 \uC5C6\uC744\uAE4C \uBD10 \uB2E4\uB4E4 \uC5C4\uCCAD \uAC71\uC815\uD588\uC5B4.",
  "fall_26": "\uC624\uB298 \uBC24\uC5D0, \uB2E4\uB4E4 \uC7A0\uB4E0 \uD6C4\uC5D0, \uC232\uC5D0 \uC0AC\uB294 \uADF8 \uC774\uC0C1\uD55C \uC544\uC800\uC528\uAC00 \uADC0\uC2E0\uC758 \uBBF8\uB85C\uB97C \uC124\uCE58\uD560 \uAC70\uC57C. \uD56D\uC0C1 \uC544\uBB34\uB3C4 \uBABB \uBCFC \uB54C \uC77C\uD558\uB354\uB77C\uACE0.",
  "summer_10": "\uB0B4\uC77C \uC26C\uB294 \uB0A0\uC774\uB2E4! \uC774\uB807\uAC8C \uD589\uBCF5\uD560 \uC218\uAC00 \uC788\uAD6C\uB098.$h",
  "winter_24": "\uACA8\uC6B8 \uBCC4\uC758 \uB9CC\uCC2C\uC740 \uC6D0\uB798\uB294 \uC0B4\uBA74\uC11C \uBC1B\uC740 \uC740\uD61C\uC5D0 \uB300\uD574 \uAC10\uC0AC\uD558\uB294 \uC2DC\uAE30\uC57C.#$b#\uB098? \uB09C \uC74C\uC2DD\uC5D0 \uC81C\uC77C \uAD00\uC2EC\uC774 \uAC00\uB354\uB77C\uACE0. \uD5E4\uD5E4.$h",
  "event_room2": "\uB9DE\uC544\uC694... \uADF8\uB807\uAC8C \uB41C \uAC70\uC608\uC694!",
  "event_snack1": "\uB9DE\uC544\uC694... \uADF8\uB807\uAC8C \uB410\uC5B4\uC694.$s",
  "event_snack2": "\uB9DE\uC544\uC694... \uADF8\uB807\uAC8C \uB41C \uAC70\uC608\uC694!",
  "event_snack3": "\uBB50\uB77C\uACE0!? \uAC70\uC9D3\uB9D0\uC774\uC5D0\uC694!$a",
  "summer_Mon2": "\uC57C, \uC798 \uC9C0\uB0B4?#$e#\uB098 \uBC30\uACE0\uD30C.#$e#\uB098\uC911\uC5D0 \uBCF4\uC790.",
  "summer_Mon6": "\uC0AC\uB9C9\uC5D0 \uAC00\uBCF8 \uC801 \uC788\uC5B4?#$e#\uAC70\uAE30\uC11C \uC880 \uC2E0\uAE30\uD55C \uAC83\uB4E4\uC744 \uCC3E\uC744 \uC218 \uC788\uC5B4. \uC5B4\uB838\uC744 \uB54C \uC544\uBC84\uC9C0\uAED8\uC11C \uB370\uB9AC\uACE0 \uAC04 \uC801 \uC788\uC5B4.",
  "summer_Mon": "\uC5EC\uB984\uC5D4 \uAF43\uAC00\uB8E8\uAC00 \uC880 \uC801\uC740 \uD3B8\uC774\uC57C... \uB0B4 \uCF54\uAC00 \uD589\uBCF5\uD574\uD558\uACE0 \uC788\uC5B4.",
  "summer_Tue": "\uC5B4, \uC548\uB155! \uB2E4\uC2DC \uBCF4\uB2C8 \uBC18\uAC11\uB124.#$e#\uADF8\uB7FC, \uB098\uC911\uC5D0 \uB610 \uBD10.",
  "summer_Tue4": "\uC548\uB155, @. \uC57C, \uC9C0\uAE08 \uC880 \uB180\uB798?#$e#\uB098 \uC5EC\uB984\uC5D0 \uAE30\uC6B4\uC774 \uB108\uBB34 \uB118\uCCD0\uC11C \uC7A0\uC744 \uC548\uC790\uB3C4 \uAD1C\uCC2E\uC544!",
  "summer_Wed": "\uC548\uB155. \uD558\uB8E8 \uC26C\uB294 \uAC70\uC57C?#$e#\uC7AC\uBC0C\uACA0\uB294\uAC78?",
  "summer_Wed2": "\uC5B4\uC82F\uBC24\uC5D0 \uCC9C\uC7A5\uC5D0 \uAC70\uBBF8\uB97C \uBD24\uC5B4. \uB530\uB73B\uD55C \uAC70 \uC9C4\uC9DC \uC88B\uC544\uD558\uB354\uB77C.#$e#\uC790\uB294 \uB3D9\uC548 \uC124\uB9C8 \uB0B4 \uC785\uC5D0 \uB4E4\uC5B4\uAC04 \uAC74 \uC544\uB2C8\uACA0\uC9C0...$s",
  "summer_Thu": "\uC544\uBC84\uC9C0\uAED8\uC11C \uC6B0\uB9AC \uC801\uB300\uAD6D\uC778 \uACE0\uD1A0\uB85C \uC81C\uAD6D\uC5D0 \uB300\uD574 \uC598\uAE30\uD574\uC8FC\uC168\uC5B4... \uBB34\uC790\uBE44\uD55C \uC0AC\uB78C\uB4E4 \uAC19\uB354\uB77C.",
  "summer_Thu6_2": "\uAC00\uB054 \uBC24\uC5D0 \uC544\uBE60\uAC00 \uBCF5\uB3C4\uB97C \uC11C\uC131\uC774\uB294 \uC18C\uB9AC\uAC00 \uB4E4\uB824.$s#$b#...\uADFC\uB370 \uBB34\uC2A8 \uC77C\uC778\uC9C0 \uB098\uD55C\uD14C\uB294 \uC598\uAE30\uD574 \uC8FC\uC9C0 \uC54A\uC73C\uC154.",
  "summer_Fri": "\uC788\uC9C0... \uC608\uC804\uC5D4 \uB3C4\uC2DC\uC5D0 \uC0B4\uC558\uB294\uB370, \uC5EC\uAE30 \uC5EC\uB984\uC774 \uD6E8\uC52C \uB0AB\uB2E4\uB294 \uAC74 \uC778\uC815\uD574\uC57C \uD574.$h#$e#\uB3C4\uC2DC\uB294 \uCF58\uD06C\uB9AC\uD2B8 \uB54C\uBB38\uC5D0 \uB108\uBB34 \uB365\uB354\uB77C.",
  "summer_Sun": "\uBC14\uB2E4 \uC704\uC5D0 \uC5F4\uAE30\uAD6C\uAC00 \uB5A0\uC788\uB294 \uAC8C \uBCF4\uC774\uBA74, \uC9C4\uC9DC \uC5EC\uB984\uC774 \uD55C\uCC3D\uC774\uB77C\uB294 \uAC78 \uC54C \uC218 \uC788\uC9C0.",
  "fall_Mon2": "\uC77C \uB144 \uC774\uB9D8\uB54C\uC5D0 \uC232\uC5D0\uC11C \uC0B0\uCC45\uD558\uB294 \uAC78 \uC88B\uC544\uD574. \uC628\uB3C4\uAC00 \uB531 \uC801\uB2F9\uD574.#$e#...$h",
  "fall_Mon": "\uC624, \uC548\uB155. \uC0C8 \uCE5C\uAD6C\uB294 \uC880 \uC0DD\uACBC\uC5B4?#$e#Bye.",
  "fall_Tue": "\uD56D\uC0C1 \uC774\uB9D8\uB54C \uC2E0\uBC1C\uC774 \uB2F3\uB294 \uAC70 \uAC19\uC544. \uBD10, \uBC1C\uAC00\uB77D\uC774 \uB098\uC654\uC5B4!$h#$e#\uC2A4\uCF00\uC774\uD2B8\uBCF4\uB4DC \uB108\uBB34 \uB9CE\uC774 \uD0C0\uBA74 \uC774\uB807\uAC8C \uB3FC.",
  "fall_9": "\uC628\uB77C\uC778\uC73C\uB85C \uC0C8 \uC2E0\uBC1C \uD55C \uCF24\uB808 \uC8FC\uBB38\uD588\uC5B4. \uAC19\uC740 \uC2A4\uD0C0\uC77C\uC774\uB77C \uBD84\uBA85 \uBC1C\uC5D0 \uB9DE\uC744 \uAC70\uC57C.",
  "fall_16": "\uB098 \uC628\uB77C\uC778\uC73C\uB85C \uC2E0\uBC1C \uC8FC\uBB38\uD55C\uC9C0 \uC77C\uC8FC\uC77C\uC774 \uB118\uC5C8\uB294\uB370! \uC9C4\uC9DC \uC624\uB798 \uAC78\uB9AC\uB124.#$e#\uC6B0\uB9AC\uAC00 \uC880 \uC678\uC9C4\uB370 \uC0B4\uACE0 \uC788\uAE34 \uD55C\uAC00 \uBD10.$s",
  "fall_23": "\uC544, \uC0C8 \uC2E0\uBC1C \uC2E0\uC73C\uB2C8 \uC88B\uB124. \uC870\uAE08 \uBEE3\uBEE3\uD558\uAE34 \uD55C\uB370, \uAE08\uBC29 \uAE38\uB4E4\uC5EC\uC9C8 \uAC70\uC57C. \uC774\uBC88 \uC8FC\uB9D0\uC5D0 \uADC0\uC2E0\uC758 \uBBF8\uB85C\uC5D0\uC11C \uD55C\uBC14\uD0D5 \uB6F0\uACE0 \uB098\uBA74 \uBC14\uB85C \uB418\uACA0\uC9C0.$h",
  "fall_Tue4": "\uC57C, @. \uC880 \uB180\uB2E4 \uAC08\uB798?#$e#\uC5B8\uC81C\uB4E0 \uB0B4\uD0AC \uB54C \uB180\uB7EC\uC640.",
  "fall_Wed": "\uC57C... \uBB54\uAC00 \uC88B\uC740 \uB0C4\uC0C8\uAC00 \uB09C\uB2E4, \uD53C\uC790 \uAC19\uC544.#$e#\uB0C4\uC0C8 \uB098? \uC5C4\uB9C8\uAC00 \uBB54\uAC00 \uC694\uB9AC\uD558\uACE0 \uC788\uB098 \uBD10.",
  "fall_Thu6_1": "\uC544\uBC84\uC9C0\uAED8\uC11C \uB0B4\uB144\uCBE4 \uB3CC\uC544\uC624\uC2E4 \uAC70 \uAC19\uC544.#$e#\uC5BC\uB9C8 \uC548 \uB0A8\uAE34 \uD588\uB124. \uAE30\uBD84 \uC880 \uC774\uC0C1\uD558\uB2E4.",
  "fall_Thu6": "\uC2AC\uC2AC \uB3C5\uB9BD\uD558\uB294 \uAC83\uB3C4 \uC0DD\uAC01\uD574\uC57C \uD558\uAE34 \uD558\uB294\uB370...$s#$e#...\uC5C4\uB9C8\uAC00 \uB9CC\uB4E4\uC5B4\uC8FC\uB294 \uC0DD\uC120 \uCE90\uC11C\uB864\uC774 \uB108\uBB34 \uBA39\uACE0 \uC2F6\uC744 \uAC83 \uAC19\uACE0...$s#$e#\uACB0\uC815 \uB0B4\uB9AC\uAE30 \uC2EB\uB2E4.",
  "fall_Thu": "\uAC00\uC744\uC5D0 \uAC70\uBBF8\uC904\uC774 \uBCF4\uC774\uAE30 \uC2DC\uC791\uD55C\uB2E4\uB294 \uAC70 \uB208\uCE58\uCC48 \uC801 \uC788\uC5B4?#$e#\uC77C\uCC0D \uC77C\uC5B4\uB098\uBA74 \uC774\uC2AC\uC774 \uB9FA\uD600\uC788\uB354\uB77C... \uC791\uC740 \uBCC4\uCC98\uB7FC.",
  "fall_Fri": "\uB098 \uC608\uC804\uC5D4 \uC8FC\uC8FC \uC2DC\uD2F0\uC5D0 \uC0B4\uC558\uC5C8\uC5B4. \uC81C\uC77C \uD070 \uCC28\uC774\uB294 \uC18C\uC74C\uC774\uC57C. \uB3C4\uC2DC\uC5D0\uC120 \uC870\uC6A9\uD55C \uC801\uC774 \uC5C6\uC9C0.#$e#\uD56D\uC0C1 \uC8FC\uBCC0\uC5D0 \uC0AC\uB78C\uB3C4 \uB9CE\uACE0. \uADF8\uB9AC\uACE0 \uBC24\uC5D0\uB3C4 \uB3C4\uC2DC \uBD88\uBE5B\uC73C\uB85C \uBC1D\uC544.#$e#\uADF8\uB798\uB3C4 \uC5B4\uB290 \uCABD\uC774 \uB9C8\uC74C\uC5D0 \uB4DC\uB294\uC9C0\uB294 \uC0AC\uB78C \uC131\uACA9\uB9C8\uB2E4 \uB2E4\uB978 \uAC70\uACA0\uC9C0.",
  "fall_Fri10": "\uB098 \uB3C4\uC2DC\uBCF4\uB2E4\uB294 \uC2DC\uACE8\uC774 \uB354 \uC88B\uC544\uC9C0\uAC8C \uB41C \uAC83 \uAC19\uC544.$h#$b#\uBB50... \uD2B9\uC815 \uC774\uC720 \uB54C\uBB38\uC5D0 \uD3B8\uACAC\uC774 \uC788\uC744 \uC218\uB3C4 \uC788\uC9C0\uB9CC.$10#$e#\uC544, \uADF8\uB798\uC11C, \uC624\uB298 \uD558\uB8E8\uB294 \uC5B4\uB54C?$h",
  "fall_Sat4": "\uC9D1\uC5D0\uC11C \uC81C\uC77C \uD070 \uBC29\uC744 \uD63C\uC790 \uC4F8 \uC218 \uC788\uB294 \uAC74 \uD589\uC6B4\uC774\uAE34 \uD574.#$e#\uB9CF\uC544\uB4E4\uC778 \uAC8C \uC88B\uC740 \uC810\uB3C4 \uC788\uAE34 \uD55C\uAC00 \uBD10.",
  "fall_Sat": "\uD760. \uBD84\uBA85 \uBB54\uAC00 \uD558\uB824\uACE0 \uD588\uB2E4\uB294 \uAC8C \uAE30\uC5B5\uB0AC\uB294\uB370... \uADF8\uAC8C \uBB54\uC9C0 \uAE4C\uBA39\uC5C8\uC5B4.#$e#\uD56D\uC0C1 \uC788\uB294 \uC77C\uC774\uAE34 \uD574.",
  "fall_Sun8": "\uAC00\uC744 \uCCAB \uC8FC\uAC00 \uBC8C\uC368 \uB05D\uB0AC\uC5B4. \uC57C, \uB108\uBB34 \uBE68\uB9AC \uC9C0\uB098\uAC14\uB2E4.$s#$e#\uBB50 \uC5B4\uCA0C\uB4E0. \uB124\uAC00 \uB098 \uBCF4\uB7EC \uC640\uC918\uC11C \uADF8\uB0E5 \uC88B\uB2E4!#$e#\uC694\uC998 \uBB50 \uC0C8\uB85C\uC6B4 \uC18C\uC2DD\uC740 \uC788\uC5B4?",
  "fall_Sun": "\uC77C\uC694\uC77C\uC5D0 \uC7AC\uBC0C\uAC8C \uB180\uAE30 \uD798\uB4E4\uC5B4... \uC790\uAFB8 \uB0B4\uC77C \uC77C\uD558\uB7EC \uAC00\uC57C \uD55C\uB2E4\uB294 \uC0DD\uAC01\uC774 \uB4E4\uC5B4.$s",
  "fall_14": "\uC548\uB155 @.#$e#\uD760.. \uB0B4\uAC00 \uBC29\uC5D0\uC11C \uC120\uC778\uC7A5\uC744 \uAE30\uB97C \uC218 \uC788\uC744\uAE4C?",
  "winter_Mon2": "\uB2E4\uB4E4 \uACA8\uC6B8\uC5D4 \uC2E4\uB0B4\uC5D0\uB9CC \uC788\uC73C\uB2C8\uAE4C, \uAE30\uD0C0\uB97C \uD070 \uC18C\uB9AC\uB85C \uCCD0\uB3C4 \uAD1C\uCC2E\uC544.$h",
  "winter_Mon": "\uC548\uB155... \uCDA5\uC9C0, \uADF8\uCE58?",
  "winter_Tue": "\uC5B4, \uC548\uB155! \uB2E4\uC2DC \uBD10\uC11C \uBC18\uAC11\uB124.#$e#\uC798 \uC9C0\uB0B4\uC9C0?",
  "winter_Tue4": "\uC548\uB155, @. \uC880 \uB180\uB2E4 \uAC08\uB798?#$e#\uBB50, \uC694\uC998\uC774 \uADF8\uB3D9\uC548 \uBD80\uC871\uD588\uB358 \uC7A0\uC744 \uBCF4\uCDA9\uD558\uAE30\uB3C4 \uC88B\uC740 \uC2DC\uAE30\uC9C0.$h",
  "winter_Wed": "$d Joja#\uC870\uC790 \uB9C8\uD2B8\uC5D0\uC11C \uC77C\uD558\uB294 \uAC74 \uC815\uB9D0 \uC2EB\uC9C0\uB9CC, \uB2EC\uB9AC \uC774 \uB9C8\uC744\uC5D0\uC11C \uB3C8\uC744 \uC5B4\uB5BB\uAC8C \uBC8C\uACA0\uC5B4?|\uBC15\uBB3C\uAD00\uC5D0\uC11C \uC77C\uD558\uAC8C \uB418\uC5B4\uC11C \uC815\uB9D0 \uB2E4\uD589\uC774\uC57C. \uADF8 \uC6B0\uC6B8\uD55C \uC870\uC790 \uB9C8\uD2B8\uBCF4\uB2E4 \uD6E8\uC52C \uD765\uBBF8\uB85C\uC6B4 \uC9C1\uC5C5\uC774\uC57C.",
  "winter_Thu6_1": "\uC544\uBC84\uC9C0\uAED8\uC11C \uC62C\uBD04\uC5D0 \uC624\uC2E0\uB300.#$e#\uB9C8\uC9C0\uB9C9\uC73C\uB85C \uBCF8 \uC9C0 3\uB144\uC774\uB098 \uB418\uC5C8\uC5B4. \uC880 \uAE30\uBD84\uC774 \uC774\uC0C1\uD560 \uAC70\uC57C.",
  "winter_Thu6": "\uC544\uBC84\uC9C0\uAED8\uC11C \uB3CC\uC544\uC624\uC2E0\uC9C0 \uC880 \uB418\uC5C8\uC5B4. \uC2AC\uC2AC \uB2E4\uC2DC \uC775\uC219\uD574\uC9C0\uB294 \uAC83 \uAC19\uC544.",
  "winter_Thu": "\uC544\uBC84\uC9C0\uB294 \uAD70\uB300\uC5D0 \uACC4\uC154, \uACE0\uD1A0\uB85C \uC81C\uAD6D\uC744 \uC0C1\uB300\uB85C \uC2F8\uC6B0\uACE0 \uC788\uACE0. \uADF8\uB798\uC11C \uC9C0\uAE08 \uC5EC\uAE30 \uC548 \uACC4\uC2E0 \uAC70\uC57C.#$e#\uADF8\uB798\uB3C4 \uACE7 \uB3CC\uC544\uC624\uC2E4 \uAC70\uC57C.",
  "winter_Thu_2": "\uACA8\uC6B8\uC774 \uC88B\uC740 \uC810 \uD558\uB098\uAC00... \uBAA8\uAE30\uAC00 \uC5C6\uB2E4\uB294 \uAC70\uC57C.",
  "winter_Fri": "\uB208\uC774 \uC81C\uC77C \uC548 \uC88B\uC740 \uAC8C \uBC1C\uC774 \uC816\uB294 \uAC70\uC9C0. \uB10C \uC7A5\uD654\uAC00 \uB450\uAEBC\uC6CC\uC11C \uC88B\uACA0\uB2E4.",
  "winter_Sat4": "\uC544, \uAE30\uD0C0\uC904 \uAC08\uC544\uC57C \uD55C\uB2E4\uB294 \uAC70 \uC9C0\uAE08 \uAE30\uC5B5\uB0AC\uB2E4.#$b#\uC88B\uC544, \uC624\uB298 \uBC24\uC5D0 \uAE4C\uBA39\uC9C0 \uC54A\uB3C4\uB85D \uC190\uBAA9\uC5D0 \uC801\uC5B4\uB194\uC57C\uC9C0.#$e#\uC774\uB7F0 \uC2DD\uC73C\uB85C \uAE30\uC5B5\uB098\uAC8C\uB054 \uC548 \uD558\uBA74 \uB09C \uD560 \uC77C\uC744 \uC644\uC804\uD788 \uAE4C\uBA39\uB354\uB77C\uACE0.$h",
  "winter_Sun8": "\uC370\uB9E4 \uD0C0\uB7EC \uAC00\uBA74 \uC7AC\uBC0C\uACA0\uB2E4, \uADF8\uCE58?#$e#\uADFC\uB370 \uC8FC\uBCC0\uC5D0 \uAD1C\uCC2E\uC740 \uC5B8\uB355\uC774 \uC5C6\uB124.$s#$e#\uAC8C\uB2E4\uAC00 \uB09C \uC370\uB9E4\uAC00 \uC5C6\uC5B4.#$e#\uC5B4, \uADF8\uB798\uC11C \uC694\uC998 \uC5B4\uB5BB\uAC8C \uC9C0\uB0B4?",
  "winter_Sun": "\uC9D1\uC548 \uB108\uBB34 \uC5B4\uC9C0\uB7FD\uD788\uC9C0 \uB9D0\uACE0, \uC5C4\uB9C8\uAC00 \uC794\uB729 \uD654\uB0BC \uAC70\uC57C."
}