{
  "Rainy_Day_0": "\uC624\uB298\uC740 \uAE30\uD0C0 \uCE58\uACE0 \uB180\uAE30 \uC88B\uC740 \uB0A0\uC778 \uAC83 \uAC19\uC740\uB370...#$e#\uC57C, \uB108\uB3C4 \uC26C\uACE0 \uC2F6\uC73C\uBA74 \uAC19\uC774 \uB180\uC790.",
  "Rainy_Day_1": "\uC138\uBC14\uC2A4\uCC2C\uC774\uB791 \uC560\uBE44\uAC8C\uC77C\uC774\uB791 \uC11C\uB85C \uC774\uC5B4\uC9C8 \uAC70 \uAC19\uC544?#$e#\uD5E4... \uB0B4\uAC00 \uACB0\uD63C\uD558\uACE0 \uB098\uB2C8\uAE4C \uB0A8\uB4E4\uB3C4 \uB2E4 \uACB0\uD63C\uC2DC\uD0A4\uB824\uACE0 \uD558\uACE0 \uC788\uB124.",
  "Rainy_Day_2": "\uC57C, \uC11C\uB78D\uC7A5\uC5D0\uC11C \uC774\uAC8C \uAD74\uB7EC\uB2E4\uB2C8\uB294 \uAC78 \uBC1C\uACAC\uD588\uC5B4. [90 88 86 535]#$e#\uB108\uB77C\uBA74 \uC4F8 \uC218 \uC788\uC744\uAE4C \uC2F6\uC5C8\uC5B4.",
  "Rainy_Day_3": "\uC544, \uC774\uB7F0. \uAD6C\uB984 \uB080 \uB0A0\uC740 \uC880 \uC9DC\uC99D \uB098\uB358\uB370...$7",
  "Rainy_Day_4": "\uC798 \uC7A4\uC5B4? \uBE57\uC18C\uB9AC\uB9CC \uB4E4\uC73C\uBA74 \uB09C \uC644\uC804\uD788 \uBED7\uC5B4\uC11C.",
  "patio_Sam": "*\uD55C\uC228*... \uB0B4\uAC00 \uC774\uAC78 \uC131\uACF5\uD560 \uC218\uB294 \uC788\uC744\uAE4C...$s",
  "Rainy_Night_0": "\uC57C, \uC624\uB298 \uD558\uB8E8 \uC5B4\uB560\uC5B4? \uB09C \uC624\uB298 \uB4B9\uAD74\uB4B9\uAD74\uD558\uBA74\uC11C \uB9CC\uD654 \uBD24\uB294\uB370... \uC815\uB9D0 \uC88B\uB354\uB77C\uACE0.$h",
  "Rainy_Night_1": "\uC624\uB298\uC740 \uAF64 \uC870\uC6A9\uD558\uAC8C \uBCF4\uB0C8\uC5B4... \uCF5C\uB77C, \uB0C9\uB3D9 \uD53C\uC790, \uBA87 \uC2DC\uAC04 \uAE30\uD0C0 \uC7A1\uACE0 \uB180\uACE0. \uC815\uB9D0 \uD479 \uC270 \uAE30\uBD84\uC774\uC57C.",
  "Rainy_Night_2": "\uC624\uB298 \uC544\uAE4C, \uC6B0\uB9AC\uAC00 \uD588\uB358 \uACF5\uC5F0 \uB179\uC74C\uD55C \uAC70 \uB4E4\uC5B4\uBCF4\uACE0 \uC788\uC5C8\uC5B4. \uAE30\uC5B5\uB098? \uC640, \uC9C4\uC9DC \uC5C9\uC131\uD588\uC5B4.#$b#\uB124\uAC00 \uAC70\uAE30 \uC788\uC5B4\uC11C \uB098 \uC880 \uAE34\uC7A5\uD588\uC5C8\uC5B4, \uC2E4\uC218\uD574\uC11C \uB124\uAC00 \uB0A0 \uB8E8\uC800\uB77C\uACE0 \uC0DD\uAC01\uD558\uAC8C \uB9CC\uB4E4\uACE0 \uC2F6\uC9C4 \uC54A\uC558\uAC70\uB4E0!$10",
  "Rainy_Night_3": "\uB0B4\uAC00 \uC5C6\uB2E4\uACE0 \uBE48\uC13C\uD2B8\uAC00 \uC678\uB86D\uC9C0 \uC54A\uC544\uC57C \uD560 \uD150\uB370... \uB0B4\uAC00 \uCC59\uACA8\uC918\uC57C \uD55C\uB2E4\uB294 \uAE30\uBD84\uC774 \uB4E4\uC5B4.$s#$e#\uD558\uC9C0\uB9CC \uC778\uC0DD\uC740 \uBCC0\uD558\uB294 \uAC70\uB2C8\uAE4C... \uADF8\uCE58? \uC544\uC774\uB4E4\uB3C4 \uACB0\uAD6D\uC5D4 \uADF8\uAC78 \uBC30\uC6CC\uC57C \uD574... \uC548 \uADF8\uB7EC\uBA74 \uC5B4\uB978\uC774 \uB418\uC5B4\uC11C \uB9DD\uAC00\uC9C8 \uAC70\uC57C.$7",
  "Rainy_Night_4": "\uC544, \uB0B4\uAC00 \uB0C9\uB3D9\uD53C\uC790 \uC624\uBE10\uC5D0 \uAD6C\uC6E0\uC5B4. \uC5EC\uAE30, \uB124 \uAC83. [206]$h",
  "Indoor_Day_0": "\uD734... \uB0B4 \uC61B \uC0B6\uC5D0\uC11C \uC804\uD600 \uADF8\uB9BD\uC9C0 \uC54A\uC740 \uAC8C \uD558\uB098 \uC788\uC9C0... \uC870\uC790 \uB9C8\uD2B8\uC5D0\uC11C \uC77C\uD558\uB294 \uAC70.",
  "Indoor_Day_1": "\uC57C, \uBBF9\uC2A4 \uD32C\uCF00\uC774\uD06C \uB9CC\uB4E4\uC5C8\uC5B4. \uB9DB\uC788\uAC8C \uB4DC\uC138\uC6A9. [211]$h#$e#\uBB50? \uB098 \uC694\uB9AC \uBC30\uC6B4 \uC801 \uC5C6\uC5B4... \uD56D\uC0C1 \uC5C4\uB9C8\uAC00 \uD588\uC5B4.",
  "Indoor_Day_2": "\uC57C. \uB0B4\uAC00 \uB18D\uB2F4 \uB9CE\uC774 \uD55C\uB2E4\uB294 \uAC74 \uC54C\uC9C0\uB9CC, \uB110 \uC0AC\uB791\uD558\uB294 \uB9C8\uC74C\uC740 \uC9C4\uC9C0\uD558\uB2E4\uB294 \uAC78 \uC54C\uC544\uC92C\uC73C\uBA74 \uD574...$l",
  "Indoor_Day_3": "\uC624\uB298 \uD070 \uACC4\uD68D\uC740 \uC788\uC5B4?#$e#\uC624, \uB09C \uC5C6\uC9C0... \uB09C \uD560 \uC77C\uC744 \uB300\uBD80\uBD84 \uC989\uD765\uC801\uC73C\uB85C \uACB0\uC815\uD558\uB2C8\uAE4C...",
  "Indoor_Day_4": "\uC74C... \uC5B8\uC820\uAC04 \uB18D\uC7A5 \uC77C\uB3C4 \uB3C4\uC640\uC8FC\uACE0 \uADF8\uB7F4\uAC8C. \uC624\uB298\uC740 \uAE30\uBD84\uC774 \uB108\uBB34 \uAC8C\uC744\uB7EC.$s#$e#\uD654 \uC548 \uB0AC\uC9C0?",
  "Indoor_Night_0": "\uC57C, \uC9C0\uCCD0 \uBCF4\uC778\uB2E4. \uC624\uB298 \uAE34\uC7A5 \uD480 \uC218 \uC788\uAC8C \uB3C4\uC640\uC904\uAC8C, \uC54C\uC558\uC9C0? \uB098\uC911\uC5D0 \uB9C8\uC0AC\uC9C0\uB77C\uB3C4 \uD574\uC904\uAE4C.",
  "Indoor_Night_1": "\uB09C \uC624\uB298 \uC5B4\uB560\uB0D0\uACE0? \uC624... \uC0AC\uC2E4 \uAE30\uC5B5\uC774 \uC798 \uC548 \uB098. \uD2B9\uBCC4\uD788 \uD55C\uAC74 \uC5C6\uC5B4. \uADF8\uB0E5 \uD479 \uC26C\uBA74\uC11C \uC798 \uBCF4\uB0C8\uC9C0.",
  "Indoor_Night_2": "\uC57C, \uCE68\uB300 \uC815\uB3C8 \uC548 \uD574\uC11C \uBBF8\uC548. \uB0B4\uAC00 \uC880 \uB300\uCDA9 \uD558\uB294 \uAC70 \uC54C\uC796\uC544... \uADF8\uB798\uC11C \uB098 \uC88B\uC544\uD558\uB294 \uAC70 \uB9DE\uC9C0?$h",
  "Indoor_Night_3": "\uC9D1\uC5D0\uC11C \uC0B4\uB358 \uAC8C \uADF8\uB9AC\uC6B4 \uAC8C \uC5C4\uB9C8\uAC00 \uB9CC\uB4E4\uC5B4\uC8FC\uB358 \uC0DD\uC120 \uCE90\uC11C\uB864\uC774\uC57C.",
  "Indoor_Night_4": "\uC798 \uC900\uBE44\uB294 \uB418\uC5C8\uC5B4? \uC624\uB79C\uB9CC\uC5D0 \uB0B4\uAC00 \uCE68\uB300 \uC815\uB3C8\uB3C4 \uD588\uC9C0...",
  "Outdoor_0": "\uC2A4\uCF00\uC774\uD2B8\uBCF4\uB4DC\uC5D0 \uC4F8 \uBE44\uD3EC\uC7A5\uB3C4\uB85C\uC6A9 \uBC14\uD034 \uC880 \uAD6C\uD560\uAE4C \uBD10. \uB8E8\uC774\uC2A4 \uC2DC\uC7A5\uB2D8\uC774 \uC5EC\uAE30\uC120 \uB098\uD55C\uD14C \uBB50\uB77C \uBABB\uD558\uC2DC\uACA0\uC9C0.$h",
  "Outdoor_1": "\uD56D\uC0C1 \uD558\uB298\uC744 \uC720\uC2EC\uD788 \uBCF4\uACE0 \uC788\uC5B4... \uC5B8\uC81C UFO\uAC00 \uC9C0\uB098\uAC08\uC9C0 \uBAA8\uB974\uB294 \uC77C\uC774\uAC70\uB4E0.",
  "Outdoor_2": "\uC548\uB155, @! \uB18D\uC7A5 \uC77C\uC5D0 \uB300\uD574 \uB354 \uC54C\uC558\uC73C\uBA74 \uB354 \uB3C4\uC640\uC904 \uC218 \uC788\uC744 \uD150\uB370. \uBBF8\uC548!#$e#\uC751\uC6D0\uD558\uB294 \uC0DD\uAC01\uC73C\uB85C \uB3C4\uC640\uC918 \uBCFC\uAC8C.$h",
  "Outdoor_3": "\uBB54\uAC00 \uACF5\uAE30 \uC911\uC5D0 \uB0B4\uAC8C \uAE0D\uC815\uC801\uC778 \uAE30\uC6B4\uC744 \uC8FC\uB294 \uAC8C \uC788\uC5B4... \uC544\uB2C8\uBA74 \uAC70\uC2A4\uC758 \uC624\uBE10\uC5D0\uC11C \uB098\uB294 \uD53C\uC790 \uB0C4\uC0C8\uAC00 \uC5EC\uAE30\uAE4C\uC9C0 \uC624\uB294 \uAC74\uAC00.",
  "Outdoor_4": "\uC640\uC6B0... \uC624\uB298 \uC815\uB9D0 \uBA4B\uC838 \uBCF4\uC774\uB294\uAC78, \uC9C4\uD759 \uC790\uAD6D\uC774 \uC624\uD788\uB824 \uB9E4\uB825\uC744 \uB354\uD574\uC8FC\uB294 \uAC83 \uAC19\uC544.$l",
  "OneKid_0": "%kid1(\uC774) \uAE30\uC800\uADC0\uB294 \uB0B4\uAC00 \uAC08\uAC8C... \uAC71\uC815\uD560 \uD544\uC694 \uC5C6\uC5B4. \uC774\uBBF8 \uD560 \uC77C\uC774 \uCDA9\uBD84\uD788 \uB9CE\uC796\uC544.",
  "OneKid_1": "\uC774\uC0C1\uD558\uC9C0\uB9CC, \uB0B4\uAC00 \uC544\uBE60\uB77C\uB294 \uC0AC\uC2E4\uC774 \uC815\uB9D0 \uB9C8\uC74C\uC5D0 \uB4E4\uC5B4!$h",
  "OneKid_3": "\uC6B0\uB9AC \uC544\uC774 \uD558\uB098 \uB354 \uAC00\uC9C0\uC790. \uC5EC\uAE30\uC11C \uBA48\uCD9C \uD544\uC694 \uC5C6\uC796\uC544?",
  "TwoKids_0": "\uB098 \uC624\uB298 \uC77C\uCC0D \uC77C\uC5B4\uB098\uC11C, \uC544\uC774\uB4E4 \uBC25 \uC8FC\uACE0 \uAE30\uC800\uADC0\uB3C4 \uAC08\uC558\uC5B4! \uC0C1\uD669 \uC815\uB9AC\uB418\uC5C8\uC9C0. \uC790\uAE30\uB294 \uC774\uC81C \uB3C8 \uBC84\uB294 \uC77C\uC5D0\uB9CC \uC9D1\uC911\uD558\uBA74 \uB3FC.$h#$e#\uB18D\uB2F4\uC774\uC9C0... \uB09C \uC790\uAE30 \uB3C8 \uB54C\uBB38\uC5D0 \uACB0\uD63C\uD55C \uAC8C \uC544\uB2C8\uC796\uC544.",
  "TwoKids_1": "\uC6B0\uB9AC \uC774\uC81C %kid2(\uC774)\uAC00 \uC788\uC73C\uB2C8 %kid1(\uC774)\uD55C\uD14C\uB3C4 \uAD00\uC2EC \uB9CE\uC774 \uC918\uC57C \uD574. \uC11C\uB85C \uC2DC\uC0D8\uC774 \uC0DD\uAE30\uBA74 \uC548 \uB418\uC9C0.",
  "TwoKids_2": "\uC544\uAE30 \uB458\uC774 \uB178\uB294 \uAC70 \uBCF4\uB2C8\uAE4C \uC7AC\uBC0C\uB2E4. \uB458\uC774 \uC0AC\uC774\uAC00 \uC544\uC8FC \uAC00\uAE4C\uC6B8 \uAC83 \uAC19\uC544.",
  "TwoKids_3": "\uB0B4\uAC00 \uC774\uB807\uAC8C \uAC00\uC815\uC801\uC778 \uB0A8\uC790\uAC00 \uB420 \uC904\uC740 \uBAB0\uB790\uB294\uB370, \uC6B0\uB9AC\uAC00 \uC774\uB8EC \uBAA8\uB4E0 \uAC83\uC774 \uB108\uBB34 \uB9CC\uC871\uC2A4\uB7EC\uC6CC. \uC778\uC0DD\uC740 \uCC38 \uBA4B\uC9C0\uAC8C \uAC00\uACE0 \uC788\uC5B4.$h",
  "Good_1": "\uC6B0\uB9AC \uBAB0\uB798 \uB0B4 \uBC29\uC5D0 \uC228\uC5B4\uB4E4\uC5B4\uAC14\uB358 \uB0A0 \uB2E4\uC2DC \uC0DD\uAC01\uD574\uBCF8 \uC801 \uC788\uC5B4? \uB09C \uC788\uC9C0, \uC790\uC8FC...$l",
  "Good_2": "\uADF8\uAC70 \uC54C\uC544, \uCC98\uC74C\uBD80\uD130 \uC6B0\uB9AC\uAC00 \uD568\uAED8\uD560 \uAC70\uB77C\uB294 \uB290\uB08C\uC744 \uBC1B\uC558\uC5B4. \uC6B0\uB9AC \uC0AC\uC774 \uBB54\uAC00 \uD2B9\uBCC4\uD55C \uAC8C \uC788\uC5B4.$l",
  "Good_3": "\uC640\uC6B0, \uC624\uB298 \uC815\uB9D0 \uC798\uC0DD\uACBC\uB294\uAC78! \uBA38\uB9AC \uBB54\uAC00 \uB2E4\uB974\uAC8C \uD55C \uAC70\uC57C?$l^\uC640\uC6B0, \uC624\uB298 \uAD49\uC7A5\uD788 \uC544\uB984\uB2E4\uC6B4\uAC78. \uBA38\uB9AC \uBB54\uAC00 \uB2E4\uB974\uAC8C \uD55C \uAC70\uC57C?$l",
  "Good_6": "\uD56D\uC0C1 \uC870\uC2EC\uD558\uACE0! \uB124\uAC00 \uAC00\uB054 \uB3D9\uAD74 \uD0D0\uD5D8\uD55C\uB2E4\uB294 \uAC70 \uC54C\uC544... \uAC70\uAE30\uC11C \uC7A1\uC544\uBA39\uD790 \uC218\uB3C4 \uC788\uB2E4\uACE0!",
  "Good_4": "\uC790\uAE30, \uAE30\uD0C0\uB85C \uC790\uAE30\uB97C \uC704\uD55C \uB178\uB798\uB97C \uB9CC\uB4E4\uB824\uACE0 \uD558\uACE0 \uC788\uC5C8\uB294\uB370. \uADFC\uB370 \uC774\uC81C \uC790\uAE30 \uC624\uB2C8\uAE4C \uB9C8\uC74C\uC774 \uB290\uAE0B\uD574\uC84C\uC5B4.#$e#\uBCF4\uD1B5 \uC678\uB85C\uC6B8 \uB54C \uAE30\uD0C0\uB97C \uCE58\uACE0 \uC2F6\uB354\uB77C\uACE0.",
  "Good_5": "\uC790\uAE30\uC57C, \uC598\uAE30\uD574\uC918! \uC790\uAE30 \uD558\uB8E8 \uC77C\uACFC \uC598\uAE30 \uB4E3\uB294 \uAC74 \uC5B8\uC81C\uB77C\uB3C4 \uD765\uBBF8\uB85C\uC6CC.",
  "funLeave_Sam": "\uB098 \uC624\uB298 \uB0B4 \uAC00\uC871\uB4E4 \uBCF4\uACE0 \uC62C\uAC8C, \uC54C\uC558\uC9C0? \uC800\uB141\uB54C \uC9D1\uC5D0 \uB2E4\uC2DC \uC62C \uAC70\uC57C.",
  "funReturn_Sam": "\uAC00\uC871\uC744 \uBCF4\uB294 \uAC74 \uC88B\uC9C0\uB9CC, \uC774\uC0C1\uD558\uAC8C \uC6B0\uC6B8\uD558\uAE30\uB3C4 \uD574. \uBB54\uAC00... \uC774\uC81C \uC6B0\uB9AC \uC778\uC0DD\uC774 \uC644\uC804\uD788 \uBD84\uB9AC\uB418\uC5B4\uC11C, \uBAA8\uB4E0 \uAC8C \uB354 \uD3C9\uC18C\uBCF4\uB2E4 \uACA9\uC2DD\uC744 \uB354 \uCC28\uB9AC\uAC8C \uB418\uB294 \uAE30\uBD84\uC774\uC57C.$7",
  "spring_1": "\uC74D... \uBD04... \uB0B4 \uCF54... \uC54C\uB7EC\uC9C0.$s",
  "spring_12": "\uB0B4\uC77C \uCD95\uC81C \uAE30\uB300\uD558\uACE0 \uC788\uC5B4? \uC138\uBC14\uC2A4\uCC2C \uB2E4\uC2DC \uBCF4\uBA74 \uC7AC\uBC0C\uC744 \uAC70 \uAC19\uC544.",
  "spring_23": "\uC544... \uB0B4\uC77C \uBD04\uAF43 \uBB34\uB3C4\uD68C\uAD6C\uB098, \uB9DE\uC9C0? \uACB0\uD63C\uD588\uC73C\uB2C8 \uC774\uC81C \uC548 \uD574\uB3C4 \uB41C\uB2E4\uACE0 \uC0DD\uAC01\uD588\uB294\uB370.#$e#\uC544\uBB34\uB834 \uC5B4\uB54C. \uC5B4\uB5BB\uAC8C \uBCF4\uBA74 \uC7AC\uBC0C\uAE30\uB3C4 \uD574.",
  "summer_1": "\uC5EC\uB984\uC5D0 \uAF43\uAC00\uB8E8\uAC00 \uC880 \uB35C \uB0A0\uB824\uC11C, \uCF54\uBD80\uD130 \uD589\uBCF5\uD558\uB2E4.$h",
  "summer_10": "\uB0B4\uC77C \uB8E8\uC544\uC6B0 \uC2A4\uD504\uC5D0 \uBB58 \uB123\uC744\uC9C0 \uC0DD\uAC01\uD574\uBD24\uC5B4?#$e#\uC9C4\uC9DC \uB9DB\uC5C6\uB294 \uAC70 \uB123\uC5B4\uBCF4\uBA74 \uC7AC\uBC0C\uACA0\uB2E4. \uC788\uC796\uC544 \uB9C9, \uB3C4\uC9C0\uC0AC\uB2D8\uD55C\uD14C \uC7A5\uB09C\uCE58\uB294 \uAC78\uB85C!$h#$e#\uBBF8\uC548...",
  "summer_27": "\uC5EC\uB984\uB3C4 \uC88B\uC9C0\uB9CC, \uC774\uC820 \uAC00\uC744\uC774 \uC640\uB3C4 \uC88B\uC744 \uAC83 \uAC19\uC544.#$e#\uC6B0\uB9AC \uB0B4\uC77C \uBC24 \uD574\uD30C\uB9AC \uBCF4\uB7EC \uAC08\uAE4C? \uC5B8\uC81C \uBD10\uB3C4 \uC7AC\uBC0C\uB354\uB77C.",
  "fall_1": "\uC628 \uACC4\uACE1\uC774 \uBC24\uC0AC\uC774 \uC804\uBD80 \uBC14\uB010 \uAC83 \uAC19\uC544... \uB4DC\uB514\uC5B4 \uAC00\uC744\uC774 \uC654\uB098 \uBCF4\uB124.",
  "fall_15": "\uC57C, \uB0B4\uC77C \uCD95\uC81C\uC57C. \uC0C8\uCD1D \uC3D8\uB358 \uC190\uBAA9\uC774 \uB179\uC2AC\uC9C0 \uC54A\uAC8C \uC5F0\uC2B5 \uC880 \uD574\uC57C \uD558\uB294\uB370...",
  "fall_26": "\uC5C4\uB9C8\uAC00 \uBE48\uC13C\uD2B8\uD55C\uD14C \uC720\uB839\uC758 \uBBF8\uB85C\uC5D0 \uB4E4\uC5B4\uAC00\uB294 \uAC78 \uD5C8\uB77D\uD574\uC8FC\uB824\uB098. \uC544\uB9C8 \uC544\uB2D0 \uAC70 \uAC19\uC9C0\uB9CC...$h#$e#\uBD88\uC30D\uD55C \uBE48\uC13C\uD2B8. \uC5B8\uC820\uAC00\uB294 \uC5B4\uB978\uC774 \uB420 \uD150\uB370...",
  "winter_1": "\uB0A0\uC774 \uCD94\uC6CC\uC11C \uBA38\uB9AC \uC824\uC774 \uC5BC\uC5B4\uBC84\uB824. \uAE30\uBD84\uC774 \uC88B\uC9C4 \uC54A\uC544.$s",
  "winter_7": "\uC6B0\uB9AC \uB0B4\uC77C \uC5BC\uC74C \uCD95\uC81C\uC5D0 \uC7A0\uAE50 \uB4E4\uB97C\uAE4C? \uB2E4\uB4E4 \uC624\uB79C\uB9CC\uC5D0 \uBCF4\uB294 \uAC83\uB3C4 \uC7AC\uBC0C\uC744 \uAC83 \uAC19\uC544...",
  "winter_28": "\uC6B0\uB9AC \uC815\uB9D0 \uC88B\uC740 \uD55C \uD574\uB97C \uBCF4\uB0C8\uC9C0, @... \uB05D\uB0AC\uB2E4\uB2C8 \uC880 \uC2AC\uD504\uB124.#$e#\uB0B4\uB144\uC740 \uB354 \uBA4B\uC9C0\uAC8C \uBCF4\uB0B4\uC57C\uC9C0!$h"
}