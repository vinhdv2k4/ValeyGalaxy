{
  "Introduction": "\u0417\u043D\u0430\u043A\u043E\u043C\u0438\u0448\u044C\u0441\u044F \u0441\u043E \u0432\u0441\u0435\u043C\u0438 \u0432 \u0433\u043E\u0440\u043E\u0434\u0435? \u0417\u0432\u0443\u0447\u0438\u0442 \u0443\u0442\u043E\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u043E.",
  "Resort": "\u0423\u0445 \u0442\u044B, \u0432\u043E\u0442 \u044D\u0442\u043E \u0437\u0434\u0430\u043D\u0438\u044F!$h#$b#\u0422\u043E\u0447\u043D\u043E \u0433\u043E\u0432\u043E\u0440\u044E, \u0438\u0445 \u0432\u043E\u0437\u0432\u043E\u0434\u0438\u043B \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u0437\u043D\u0430\u0442\u043E\u043A \u0441\u0432\u043E\u0435\u0433\u043E \u0434\u0435\u043B\u0430. \u042F \u043F\u043E\u0434 \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0438\u0435\u043C!",
  "AcceptGift_(O)StardropTea": "\u041F\u043E\u0433\u043E\u0434\u0438... \u042D\u0442\u043E \u043C\u043D\u0435? \u041A\u0430\u043A\u0430\u044F \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u0430\u044F \u0432\u0435\u0449\u044C! \u0421\u043F\u0430\u0441\u0438\u0431\u043E.",
  "AcceptGift_(O)Book_Woodcutting": "\u0427\u0442\u043E \u044D\u0442\u043E... \u00AB\u0421\u0435\u043A\u0440\u0435\u0442 \u0434\u0440\u043E\u0432\u043E\u0441\u0435\u043A\u0430\u00BB?.. \u042D\u043C, \u0447\u0442\u043E \u044D\u0442\u043E \u0437\u0430 \u043A\u043D\u0438\u0433\u0430 \u0442\u0430\u043A\u0430\u044F, @?$6#$b#\u0410, \u043E\u043D\u0430 \u043E \u043B\u0435\u0441\u043E\u0437\u0430\u0433\u043E\u0442\u043E\u0432\u043A\u0435! \u0425\u0430-\u0445\u0430-\u0445\u0430... \u041E \u0434\u0430, \u043E\u043D\u0430 \u043C\u043D\u0435 \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F. \u0421\u043F\u0430\u0441\u0438\u0431\u043E!$4",
  "AcceptGift_(O)SkillBook_2": "\u0410, \u00AB\u0415\u0436\u0435\u043D\u0435\u0434\u0435\u043B\u044C\u043D\u0438\u043A \u043B\u0435\u0441\u043D\u0438\u043A\u0430\u00BB... \u042F \u043A\u0430\u043A \u0440\u0430\u0437 \u0445\u043E\u0442\u0435\u043B\u0430 \u043A\u0443\u043F\u0438\u0442\u044C \u043D\u043E\u0432\u044B\u0439 \u0432\u044B\u043F\u0443\u0441\u043A! \u0422\u0430\u043C \u0435\u0441\u0442\u044C \u0440\u0443\u0431\u0440\u0438\u043A\u0430 \u043F\u043E \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0435 \u0434\u0440\u0435\u0432\u0435\u0441\u0438\u043D\u044B!#$b#\u041A\u0430\u043A \u0434\u0440\u043E\u0432\u043E\u0441\u0435\u043A \u0434\u0440\u043E\u0432\u043E\u0441\u0435\u043A\u0443 \u0441\u043A\u0430\u0436\u0443... \u0421\u043F\u0430\u0441\u0438\u0431\u043E.$h",
  "GreenRain": "\u0414\u0430 \u043E\u043D \u0441\u043E\u0448\u0435\u043B \u0441 \u0443\u043C\u0430! \u0417\u0430\u0447\u0435\u043C \u0432\u043E\u043E\u0431\u0449\u0435 \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u044C \u043D\u0430 \u0443\u043B\u0438\u0446\u0443? \u041A\u0442\u043E \u0437\u043D\u0430\u0435\u0442, \u0432\u0434\u0440\u0443\u0433 \u0442\u0430\u043C \u043E\u043F\u0430\u0441\u043D\u043E!$u%noturn",
  "GreenRainFinished": "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0414\u0435\u043C\u0435\u0442\u0440\u0438\u0443\u0441 \u0440\u0430\u0434 \u00AB\u043E\u0431\u0440\u0430\u0437\u0446\u0430\u043C\u00BB, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043E\u043D \u0441\u043E\u0431\u0440\u0430\u043B. \u041F\u043E\u0445\u043E\u0436\u0435, \u0435\u0433\u043E \u043D\u0430\u0443\u0447\u043D\u044B\u0439 \u043F\u0440\u043E\u0435\u043A\u0442\u0438\u043A \u0434\u043B\u044F \u043D\u0435\u0433\u043E \u0432\u0430\u0436\u043D\u0435\u0435 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439 \u0436\u0435\u043D\u044B. \u041F\u0444-\u0444.$6",
  "GreenRain_2": "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0430\u0441 \u0436\u0434\u0435\u0442 \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0445\u043E\u0440\u043E\u0448\u0435\u0439 \u0438 \u0440\u0430\u0437\u043D\u043E\u0439 \u0434\u0440\u0435\u0432\u0435\u0441\u0438\u043D\u044B. \u041D\u0435 \u043F\u043E\u0440\u0430 \u043B\u0438 \u0435\u0435 \u043D\u0430\u0440\u0443\u0431\u0438\u0442\u044C?",
  "divorced_Sebastian": "\u0421\u0435\u0431\u0430\u0441\u0442\u0438\u0430\u043D \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0432 \u0441\u0432\u043E\u0439 \u043F\u043E\u0434\u0432\u0430\u043B... \u0427\u0442\u043E \u043C\u0435\u0436\u0434\u0443 \u0432\u0430\u043C\u0438 \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E?$s",
  "divorced_Maru": "\u041C\u0430\u0440\u0443 \u043F\u0440\u043E\u043F\u043B\u0430\u043A\u0430\u043B\u0430 \u0432\u0441\u044E \u043D\u043E\u0447\u044C... \u041C\u044B \u0432\u0441\u0435 \u0442\u0430\u043A \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0435\u043D\u044B...$s",
  "married_Sebastian": "\u041E, \u043D\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0439... \u044D\u0442\u043E \u0441\u043B\u0435\u0437\u044B \u0440\u0430\u0434\u043E\u0441\u0442\u0438. \u042F \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0421\u0435\u0431\u0430\u0441\u0442\u0438\u0430\u043D \u0431\u0443\u0434\u0435\u0442 \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432 \u0441 \u0442\u043E\u0431\u043E\u0439 \u043D\u0430 \u0444\u0435\u0440\u043C\u0435 \u00AB%farm\u00BB!$h",
  "married_Maru": "\u041C\u044B \u0432\u0441\u0435 \u043E\u0447\u0435\u043D\u044C \u0441\u043A\u0443\u0447\u0430\u0435\u043C \u043F\u043E \u041C\u0430\u0440\u0443, \u043D\u043E \u043D\u0430\u0434\u0435\u044E\u0441\u044C, \u0447\u0442\u043E \u043C\u044B \u0431\u0443\u0434\u0435\u043C \u0447\u0430\u0441\u0442\u043E \u0432\u0438\u0434\u0435\u0442\u044C\u0441\u044F!",
  "houseUpgrade_1": "\u041E\u0431\u043D\u043E\u0432\u0438\u0442\u044C \u0442\u0432\u043E\u0439 \u0434\u043E\u043C \u0431\u044B\u043B\u043E \u043E\u0447\u0435\u043D\u044C \u043F\u0440\u0438\u044F\u0442\u043D\u043E. \u042D\u0442\u043E \u043E\u0434\u043D\u0430 \u0438\u0437 \u043C\u043E\u0438\u0445 \u043B\u0443\u0447\u0448\u0438\u0445 \u0440\u0430\u0431\u043E\u0442!$h#$e#\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0442\u0435\u0431\u0435 \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u0442\u0432\u043E\u044F \u043D\u043E\u0432\u0430\u044F \u043A\u0443\u0445\u043D\u044F.",
  "houseUpgrade_2": "\u041D\u0443 \u0438 \u0447\u0442\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u0431\u0443\u0434\u0435\u0448\u044C \u0434\u0435\u043B\u0430\u0442\u044C \u0441\u043E \u0432\u0441\u0435\u043C \u044D\u0442\u0438\u043C \u043D\u043E\u0432\u044B\u043C \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E\u043C \u0432 \u0441\u0432\u043E\u0435\u043C \u0434\u043E\u043C\u0435?#$e#\u0418\u043B\u0438 \u043B\u0443\u0447\u0448\u0435 \u043D\u0430\u0437\u044B\u0432\u0430\u0442\u044C \u0435\u0433\u043E... \u00AB\u043E\u0441\u043E\u0431\u043D\u044F\u043A\u043E\u043C\u00BB?$h",
  "houseUpgrade_3": "\u0412\u0438\u0436\u0443, \u0442\u044B \u0442\u0435\u043F\u0435\u0440\u044C \u0441\u0442\u0430\u0440\u044B\u043C\u0438 \u0432\u0438\u043D\u0430\u043C\u0438 \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0448\u044C\u0441\u044F? \u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u0431\u0438\u0437\u043D\u0435\u0441 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u043F\u0440\u0438\u0431\u044B\u043B\u044C\u043D\u044B\u0439... \u0415\u0441\u043B\u0438 \u0443\u043C\u0435\u0435\u0448\u044C \u0436\u0434\u0430\u0442\u044C.",
  "structureBuilt_Coop": "\u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u0441\u0430\u043C\u044B\u0439 \u043A\u0440\u0435\u043F\u043A\u0438\u0439 \u043A\u0443\u0440\u044F\u0442\u043D\u0438\u043A \u043D\u0430 \u043C\u043E\u0435\u0439 \u043F\u0430\u043C\u044F\u0442\u0438. \u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u043E\u043D \u0431\u0443\u0434\u0435\u0442 \u0434\u043E\u043B\u0433\u043E \u0442\u0435\u0431\u0435 \u0441\u043B\u0443\u0436\u0438\u0442\u044C!",
  "structureBuilt_Shed": "\u0423\u0436\u0435 \u0435\u0441\u0442\u044C \u043F\u043B\u0430\u043D\u044B \u043D\u0430 \u043D\u043E\u0432\u044B\u0439 \u0441\u0430\u0440\u0430\u0439? \u0421 \u043D\u0438\u043C \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0432\u0441\u0435\u0433\u043E \u043C\u043E\u0436\u043D\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C!",
  "structureBuilt_Coop_memory_oneweek": "\u041A\u0430\u043A \u0442\u0430\u043C \u043A\u0443\u0440\u044F\u0442\u043D\u0438\u043A \u043F\u043E\u0436\u0438\u0432\u0430\u0435\u0442? \u041E\u0447\u0435\u043D\u044C \u0445\u043E\u0447\u0443 \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0442\u0432\u043E\u0438\u0445 \u043D\u043E\u0432\u044B\u0445 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445!",
  "structureBuilt_Barn_memory_oneweek": "\u0422\u0435\u0431\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u0442\u0432\u043E\u0439 \u043D\u043E\u0432\u044B\u0439 \u0445\u043B\u0435\u0432? \u0414\u0443\u043C\u0430\u044E, \u0442\u0443\u0434\u0430 \u043C\u043E\u0436\u043D\u043E \u0437\u0430\u0441\u0435\u043B\u0438\u0442\u044C \u043A\u0443\u0447\u0443 \u043D\u043E\u0432\u044B\u0445 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445!",
  "structureBuilt_Slime Hutch": "*\u0443\u0444*... \u0412\u043E\u043B\u044C\u0435\u0440 \u0434\u043B\u044F \u0441\u043B\u0430\u0439\u043C\u043E\u0432 \u0441\u0442\u0440\u043E\u0438\u0442\u044C \u043D\u0435 \u0442\u0430\u043A-\u0442\u043E \u043B\u0435\u0433\u043A\u043E... \u041C\u043D\u0435 \u043F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0433\u043E \u0434\u0435\u043D\u044C \u0432 \u0441\u043F\u0430 \u043F\u043E\u043B\u043E\u0436\u0435\u043D!$h",
  "structureBuilt_Stable_memory_oneweek": "\u041D\u0443 \u043A\u0430\u043A, \u043E\u0431\u044A\u0435\u0437\u0436\u0430\u0435\u0448\u044C \u0433\u043E\u0440\u043E\u0434 \u043D\u0430 \u043D\u043E\u0432\u043E\u0439 \u043B\u043E\u0448\u0430\u0434\u043A\u0435?#$b#\u0421\u0434\u0430\u0435\u0442\u0441\u044F \u043C\u043D\u0435, \u0441\u043F\u0438\u043D\u0430 \u0438 \u0441\u0435\u0434\u0430\u043B\u0438\u0449\u0435 \u0442\u0435\u0431\u0435 \u0441\u043F\u0430\u0441\u0438\u0431\u043E \u043D\u0435 \u0441\u043A\u0430\u0436\u0443\u0442, \u043D\u043E \u0441\u043A\u043E\u0440\u043E \u043F\u0440\u0438\u0432\u044B\u043A\u043D\u0435\u0448\u044C.$h",
  "structureBuilt_Fish Pond": "\u042F \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B\u0430 \u0412\u0438\u043B\u043B\u0438 \u043F\u0440\u043E \u0442\u0432\u043E\u0439 \u0440\u044B\u0431\u043D\u044B\u0439 \u043F\u0440\u0443\u0434. \u041E\u043D \u0431\u044B\u043B \u043E\u0447\u0435\u043D\u044C \u0434\u043E\u0432\u043E\u043B\u0435\u043D.#$e#\u041E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C, \u0447\u0442\u043E \u0432 \u043C\u043E\u043B\u043E\u0434\u043E\u0441\u0442\u0438 \u043E\u043D \u0440\u0430\u0437\u0432\u043E\u0434\u0438\u043B \u043A\u0440\u0430\u0431\u043E\u0432. \u041D\u0430\u0437\u0432\u0430\u043B \u044D\u0442\u043E \u00AB\u0434\u043E\u0441\u0442\u043E\u0439\u043D\u043E\u0439 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0435\u0439\u00BB.$h",
  "Resort_Leaving": "\u0411\u044B\u043B\u043E \u0432\u0435\u0441\u0435\u043B\u043E!$h",
  "Resort_Shore": "\u042D\u0439, \u0441\u043C\u043E\u0442\u0440\u0438! \u041E\u0442\u0441\u044E\u0434\u0430 \u044F \u0432\u0438\u0436\u0443 \u0435\u0449\u0435 \u043E\u0434\u0438\u043D \u043E\u0441\u0442\u0440\u043E\u0432.",
  "Resort_Chair": "\u042D\u0439, @. \u0417\u043D\u0430\u0435\u0448\u044C, \u044F \u0442\u0443\u0442 \u0441\u0438\u0434\u0435\u043B\u0430 \u0438 \u0434\u0443\u043C\u0430\u043B\u0430, \u043A\u0430\u043A \u0445\u043E\u0440\u043E\u0448\u043E \u043F\u043E\u0448\u043B\u0438 \u0434\u0435\u043B\u0430 \u0432 \u0433\u043E\u0440\u043E\u0434\u0435 \u043F\u043E\u0441\u043B\u0435 \u0442\u0432\u043E\u0435\u0433\u043E \u043F\u0440\u0438\u0435\u0437\u0434\u0430.#$b#\u0422\u0435\u0431\u0435 \u0431\u044B \u0441\u0442\u043E\u0438\u043B\u043E \u0433\u043E\u0440\u0434\u0438\u0442\u044C\u0441\u044F \u0441\u0432\u043E\u0438\u043C\u0438 \u0441\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u044F\u043C\u0438!$h",
  "Resort_Bar": "\u0417\u0434\u0435\u0441\u044C \u0442\u0430\u043A \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u043B\u044F\u044E\u0449\u0435 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E...",
  "reject_865": "\u0412\u043A\u0443\u0441\u043D\u0430\u044F \u0441\u043E\u043B\u044C? \u0428\u0442\u0443\u043A\u0430 \u043A\u0440\u0443\u0442\u0430\u044F, \u043D\u043E \u043C\u043D\u0435 \u043D\u0438 \u043A \u0447\u0435\u043C\u0443.",
  "reject_866": "\u0425\u043C\u043C... \u041A\u043E\u0433\u0434\u0430 \u044F \u0434\u0443\u043C\u0430\u044E \u043E \u0446\u0432\u0435\u0442\u0430\u0445, \u044F \u0434\u0443\u043C\u0430\u044E \u043E\u0431 \u042D\u0432\u0435\u043B\u0438\u043D. \u041C\u043E\u0436\u0435\u0442, \u0442\u0435\u0431\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u044D\u0442\u043E \u0435\u0439?",
  "pamHouseUpgrade": "\u041D\u0430\u0448 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u043F\u043B\u0430\u043D, \u043F\u043E\u0445\u043E\u0436\u0435, \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B, \u0430? \u041F\u044D\u043C \u0438 \u041F\u0435\u043D\u043D\u0438 \u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0442 \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u044B\u043C\u0438.",
  "pamHouseUpgradeAnonymous": "\u041D\u0430\u0448 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u043F\u043B\u0430\u043D, \u043F\u043E\u0445\u043E\u0436\u0435, \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B, \u0430? \u041F\u044D\u043C \u0438 \u041F\u0435\u043D\u043D\u0438 \u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0442 \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u044B\u043C\u0438.",
  "MovieInvitation": "\u041E\u0439... \u0411\u0438\u043B\u0435\u0442\u044B \u043D\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0438\u0439 \u0441\u0435\u0430\u043D\u0441? \u0425\u043E\u0440\u043E\u0448\u043E! \u0423\u0432\u0438\u0434\u0438\u043C\u0441\u044F \u0442\u0430\u043C.$h",
  "cc_Bridge": "\u041F\u0440\u0438\u0432\u0435\u0442! \u041D\u043E\u0447\u044C\u044E \u044F \u0441\u043B\u044B\u0448\u0430\u043B\u0430 \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0439 \u0448\u0443\u043C, \u0443\u0442\u0440\u043E\u043C \u043F\u0440\u043E\u0441\u044B\u043F\u0430\u044E\u0441\u044C \u2014 \u0430 \u043C\u043E\u0441\u0442 \u0432 \u043A\u0430\u0440\u044C\u0435\u0440 \u043A\u0430\u043A \u043D\u043E\u0432\u0435\u043D\u044C\u043A\u0438\u0439!#$b#\u041A\u0430\u043A\u043E\u0439-\u0442\u043E \u043F\u043B\u043E\u0442\u043D\u0438\u043A \u043F\u0440\u043E\u0441\u0442\u043E \u0447\u0443\u0434\u043E \u0441\u043E\u0442\u0432\u043E\u0440\u0438\u043B!",
  "cc_Complete": "\u0421 \u0442\u043E\u0439 \u0441\u0430\u043C\u043E\u0439 \u043C\u0438\u043D\u0443\u0442\u044B, \u043A\u043E\u0433\u0434\u0430 \u0432\u044B \u0441\u043E\u0448\u043B\u0438 \u0441 \u0430\u0432\u0442\u043E\u0431\u0443\u0441\u0430, @, \u044F \u0437\u043D\u0430\u043B\u0430, \u0447\u0442\u043E \u0432\u044B \u0441\u0442\u0430\u043D\u0435\u0442\u0435 \u0433\u0435\u0440\u043E\u0435\u043C \u0433\u043E\u0440\u043E\u0434\u0430!$h",
  "cc_Begin": "\u041F\u0440\u0438\u0432\u0435\u0442! \u042F \u0441\u043B\u044B\u0448\u0430\u043B\u0430, \u041B\u044C\u044E\u0438\u0441 \u043F\u043E\u043A\u0430\u0437\u0430\u043B \u0432\u0430\u043C \u043A\u043B\u0443\u0431... \u0411\u044B\u043B\u043E \u0431\u044B \u0437\u0434\u043E\u0440\u043E\u0432\u043E, \u0435\u0441\u043B\u0438 \u0431\u044B \u0432\u044B \u0441\u043C\u043E\u0433\u043B\u0438 \u0435\u0433\u043E \u043F\u043E\u0447\u0438\u043D\u0438\u0442\u044C. \u0420\u0430\u043D\u044C\u0448\u0435 \u044D\u0442\u043E \u0431\u044B\u043B\u043E \u0442\u0430\u043A\u043E\u0435 \u043A\u0440\u0430\u0441\u0438\u0432\u043E\u0435 \u0437\u0434\u0430\u043D\u0438\u0435!",
  "Mon": "\u042F \u0442\u0435\u0431\u0435 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0430, \u0447\u0442\u043E \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043B\u0430 \u0432\u0435\u0441\u044C \u043D\u0430\u0448 \u0434\u043E\u043C \u0441 \u043D\u0443\u043B\u044F, \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0443?#$e#\u042D\u0442\u043E \u044F\u0432\u043D\u043E \u043E\u0434\u043D\u043E \u0438\u0437 \u043B\u0443\u0447\u0448\u0438\u0445 \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u0439 \u0437\u0430 \u043C\u043E\u044E \u043A\u0430\u0440\u044C\u0435\u0440\u0443.",
  "Tue": "\u0421\u043B\u0443\u0448\u0430\u0439, \u0435\u0441\u043B\u0438 \u0442\u0435\u0431\u0435 \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u044F\u0442\u0441\u044F \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B \u0438\u043B\u0438 \u0447\u0435\u0440\u0442\u0435\u0436\u0438, \u0442\u043E \u0437\u0430\u0445\u043E\u0434\u0438 \u043A\u043E \u043C\u043D\u0435 \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D!#$e#\u041A \u0442\u043E\u043C\u0443 \u0436\u0435, \u0434\u0435\u043D\u044C\u0433\u0438 \u043E\u0442 \u0442\u0432\u043E\u0438\u0445 \u043F\u043E\u043A\u0443\u043F\u043E\u043A \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u0442 \u043C\u0435\u0441\u0442\u043D\u0443\u044E \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0443.$h",
  "Wed": "\u041F\u0440\u0438\u0432\u0435\u0442\u0438\u043A, @.#$e#\u042F \u0442\u0443\u0442 \u0437\u0430\u043C\u0435\u0447\u0442\u0430\u043B\u0430\u0441\u044C \u043E \u043D\u043E\u0432\u044B\u0445 \u043F\u0440\u043E\u0435\u043A\u0442\u0430\u0445 \u043F\u043E \u0434\u0435\u0440\u0435\u0432\u0443.#$e#\u0423 \u0442\u0435\u0431\u044F \u0445\u043E\u0440\u043E\u0448\u043E \u0438\u0434\u0443\u0442 \u0434\u0435\u043B\u0430? \u0414\u0435\u0440\u0435\u0432\u043E \u0432 \u0434\u043E\u043C\u0435 \u0445\u043E\u0440\u043E\u0448\u043E \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F?",
  "Thu": "\u041C\u044B \u0432\u0441\u0435\u0433\u0434\u0430 \u0440\u0430\u0434\u044B \u0442\u0435\u0431\u044F \u0432\u0438\u0434\u0435\u0442\u044C, \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u0442\u044B \u0438 \u043D\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0448\u044C\u0441\u044F \u043D\u0438\u0447\u0435\u0433\u043E \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u044C.$h#$e#\u041D\u0430\u043C \u0438\u043D\u043E\u0433\u0434\u0430 \u0431\u044B\u0432\u0430\u0435\u0442 \u0442\u0430\u043A \u043E\u0434\u0438\u043D\u043E\u043A\u043E \u0432 \u0433\u043E\u0440\u0430\u0445.",
  "Fri": "\u0412\u044B \u0436\u0435 \u0441 \u0421\u0435\u0431\u0430\u0441\u0442\u0438\u0430\u043D\u043E\u043C \u0443\u0436\u0435 \u0437\u043D\u0430\u043A\u043E\u043C\u044B, \u0434\u0430? \u041E\u043D \u0436\u0438\u0432\u0435\u0442 \u0432\u043D\u0438\u0437\u0443.#$e#\u041E\u043D \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0441\u0442\u0435\u0441\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439, \u043D\u043E \u0435\u0441\u043B\u0438 \u0431\u044B\u0442\u044C \u0441 \u043D\u0438\u043C \u0434\u043E\u0431\u0440\u0435\u0435, \u0442\u043E \u043E\u043D \u043A \u0442\u0435\u0431\u0435 \u043F\u043E\u0442\u044F\u043D\u0435\u0442\u0441\u044F.",
  "Fri_inlaw_Sebastian": "\u042F \u0441\u043A\u0443\u0447\u0430\u044E \u043F\u043E \u0441\u0432\u043E\u0435\u043C\u0443 \u0421\u0435\u0431\u0431\u0438... \u0415\u0433\u043E \u0447\u0430\u0441\u0442\u043E \u043F\u043E\u043D\u0438\u043C\u0430\u043B\u0438 \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E, \u043D\u043E \u044F \u0432 \u043D\u0435\u0433\u043E \u0432\u0435\u0440\u0438\u043B\u0430.",
  "Fri4": "#$1 RobinSeb#\u042F \u043D\u0430\u0448\u043B\u0430 \u0443 \u0421\u0435\u0431\u0430\u0441\u0442\u0438\u0430\u043D\u0430 \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435 \u043F\u0435\u043F\u0435\u043B\u044C\u043D\u0438\u0446\u0443, \u043E\u0442 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043E\u0447\u0435\u043D\u044C \u0441\u0442\u0440\u0430\u043D\u043D\u043E \u043F\u0430\u0445\u043B\u043E. \u0421\u0442\u043E\u0438\u0442 \u043B\u0438 \u043C\u043D\u0435 \u043E\u0431 \u044D\u0442\u043E\u043C \u0432\u043E\u043B\u043D\u043E\u0432\u0430\u0442\u044C\u0441\u044F?#$e#\u0418\u043D\u043E\u0433\u0434\u0430 \u044F \u0432\u043E\u043B\u043D\u0443\u044E\u0441\u044C \u0437\u0430 \u0421\u0435\u0431\u0430\u0441\u0442\u0438\u0430\u043D\u0430... \u0414\u0440\u0443\u0437\u0435\u0439 \u0443 \u043D\u0435\u0433\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E, \u0438 \u043E \u0431\u0443\u0434\u0443\u0449\u0435\u043C \u0441\u0432\u043E\u0435\u043C \u043E\u043D \u043D\u0435 \u043E\u0447\u0435\u043D\u044C-\u0442\u043E \u0437\u0430\u0431\u043E\u0442\u0438\u0442\u0441\u044F...#$e#\u042F \u0431\u044B \u0441 \u043D\u0438\u043C \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430, \u043D\u043E \u043E\u043D \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043C\u043D\u0435 \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F.",
  "Fri4_inlaw_Sebastian": "\u0421\u0435\u0431\u0430\u0441\u0442\u0438\u0430\u043D \u0441\u043A\u0430\u0437\u0430\u043B \u043C\u043D\u0435, \u0447\u0442\u043E \u0431\u0440\u043E\u0441\u0430\u0435\u0442 \u043A\u0443\u0440\u0438\u0442\u044C! \u042F \u0442\u0430\u043A \u0438\u043C \u0433\u043E\u0440\u0436\u0443\u0441\u044C.",
  "Sat": "\u041D\u0430\u0448 \u0434\u043E\u043C \u0441\u0442\u043E\u0438\u0442 \u043D\u0430 \u0442\u0430\u043A\u043E\u043C \u043A\u0440\u0430\u0441\u0438\u0432\u043E\u043C \u0443\u0447\u0430\u0441\u0442\u043A\u0435, \u043F\u0440\u0430\u0432\u0434\u0430?#$e#\u042F \u043B\u044E\u0431\u043B\u044E \u0441\u0432\u0435\u0436\u0438\u0439 \u0432\u043E\u0437\u0434\u0443\u0445 \u0432 \u0433\u043E\u0440\u0430\u0445.",
  "Sun": "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0414\u0435\u043C\u0435\u0442\u0440\u0438\u0443\u0441 \u043D\u0435 \u0432\u0437\u043E\u0440\u0432\u0435\u0442 \u0434\u043E\u043C \u0441\u0432\u043E\u0438\u043C\u0438 \u043D\u0430\u0443\u0447\u043D\u044B\u043C\u0438 \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430\u043C\u0438.#$e#\u042F \u0434\u0430\u0436\u0435 \u043D\u0435 \u0437\u043D\u0430\u044E \u0442\u043E\u043B\u043A\u043E\u043C, \u043D\u0430\u0434 \u0447\u0435\u043C \u043E\u043D \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442. \u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u0447\u0442\u043E-\u0442\u043E \u043F\u0440\u043E \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F.",
  "Sun2": "#$1 RobinDem#\u0412\u0447\u0435\u0440\u0430 \u0432\u0435\u0447\u0435\u0440\u043E\u043C \u043C\u043E\u0439 \u043C\u0443\u0436\u0435\u043D\u0435\u043A \u0447\u0443\u0442\u044C \u043D\u0435 \u0441\u043F\u0430\u043B\u0438\u043B \u0434\u043E\u043C \u0441\u0432\u043E\u0438\u043C\u0438 \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430\u043C\u0438. \u0423 \u043D\u0435\u0433\u043E \u0432\u0437\u043E\u0440\u0432\u0430\u043B\u0430\u0441\u044C \u043A\u043E\u043B\u0431\u0430, \u0438 \u043E\u0433\u043E\u043D\u044C \u043F\u043E\u043B\u0435\u0442\u0435\u043B \u043F\u0440\u044F\u043C\u043E \u043A \u0431\u0430\u043B\u043A\u0430\u043C! \u0425\u0432\u0430\u043B\u0430 \u0418\u043E\u0431\u0435, \u044F \u0434\u043E\u0433\u0430\u0434\u0430\u043B\u0430\u0441\u044C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u043E\u0433\u043D\u0435\u0443\u043F\u043E\u0440\u043D\u044B\u0439 \u043B\u0430\u043A, \u043A\u043E\u0433\u0434\u0430 \u0441\u0442\u0440\u043E\u0438\u043B\u0430 \u0434\u043E\u043C.$u#$e#\u041F\u0440\u043E\u0441\u0442\u0438, \u0435\u0441\u043B\u0438 \u043F\u0430\u0445\u043D\u0435\u0442 \u0443 \u043D\u0430\u0441 \u0441\u0442\u0440\u0430\u043D\u043D\u043E, @. \u042D\u0442\u043E \u0432\u0441\u0435 \u0442\u043E\u0442 \u0447\u0443\u0434\u043D\u043E\u0439 \u043D\u0430\u0443\u0447\u043D\u044B\u0439 \u043F\u0440\u043E\u0435\u043A\u0442 \u043C\u043E\u0435\u0433\u043E \u043C\u0443\u0436\u0430...",
  "Sun6": "\u041F\u0440\u0438\u0432\u0435\u0442, @! \u0420\u0430\u0434\u0430 \u0442\u0435\u0431\u044F \u0432\u0438\u0434\u0435\u0442\u044C.#$e#\u0422\u044B \u0442\u0435\u043F\u0435\u0440\u044C \u043D\u0435\u043E\u0442\u044A\u0435\u043C\u043B\u0435\u043C\u0430\u044F \u0447\u0430\u0441\u0442\u044C \u043A\u043E\u043B\u043B\u0435\u043A\u0442\u0438\u0432\u0430 \u043D\u0430\u0448\u0435\u0433\u043E \u0433\u043E\u0440\u043E\u0434\u0430, \u043D\u0435 \u0434\u0443\u043C\u0430\u0435\u0448\u044C?",
  "event_wood1": "\u041E\u0442\u043B\u0438\u0447\u043D\u043E! \u0422\u043E\u0433\u0434\u0430 \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0447\u0442\u043E-\u0442\u043E \u043F\u043E \u044D\u0442\u043E\u043C\u0443 \u0447\u0435\u0440\u0442\u0435\u0436\u0443 \u0442\u0435\u0431\u0435 \u0431\u0443\u0434\u0435\u0442 \u0440\u0430\u0437 \u043F\u043B\u044E\u043D\u0443\u0442\u044C!$h",
  "event_wood2": "\u041D\u0443, \u0442\u043E\u0433\u0434\u0430 \u0443 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u0439 \u0447\u0435\u0440\u0442\u0435\u0436, \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0447\u0430\u0442\u044C!",
  "summer_Mon": "\u0414\u0435\u0440\u0435\u0432\u043E \u2014 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B... \u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u044B\u0439, \u043F\u0440\u043E\u0447\u043D\u044B\u0439, \u0434\u0435\u0448\u0435\u0432\u044B\u0439, \u0438 \u0443 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0438\u0437\u0434\u0435\u043B\u0438\u044F \u2014 \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0439 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440!",
  "summer_Tue": "\u0415\u0441\u043B\u0438 \u0442\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E \u0440\u0430\u0441\u0448\u0438\u0440\u0438\u0442\u044C \u0437\u0434\u0430\u043D\u0438\u044F \u043D\u0430 \u0444\u0435\u0440\u043C\u0435, \u0442\u044B \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043A\u0430\u0436\u0438!#$e#\u0422\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442 \u043F\u0440\u0438\u043D\u0435\u0441\u0442\u0438 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0434\u0440\u0435\u0432\u0435\u0441\u0438\u043D\u044B \u0438 \u043A\u0430\u043C\u043D\u044F. \u0410 \u0435\u0449\u0435 \u044D\u0442\u043E \u0441\u0442\u043E\u0438\u0442 \u0434\u0435\u043D\u0435\u0433.#$e#\u041D\u043E \u044F \u0443\u0432\u0435\u0440\u0435\u043D\u0430, \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u0442\u0435\u0431\u0435 \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F!$h",
  "summer_Fri": "\u041C\u044B \u0437\u0434\u0435\u0441\u044C \u043F\u043E\u0447\u0442\u0438 \u043E\u0442\u0440\u0435\u0437\u0430\u043D\u044B \u043E\u0442 \u043C\u0438\u0440\u0430, \u0432 \u0434\u043E\u043B\u0438\u043D\u0435 \u0421\u0442\u0430\u0440\u0434\u044C\u044E.#$e#\u0423 \u044D\u0442\u043E\u0433\u043E \u0435\u0441\u0442\u044C \u0441\u0432\u043E\u0438 \u043F\u043B\u044E\u0441\u044B \u0438 \u043C\u0438\u043D\u0443\u0441\u044B.",
  "fall_Mon": "#$1 RobinMaru#\u041C\u0430\u0440\u0443 \u043B\u044E\u0431\u0438\u0442 \u0434\u0440\u0430\u0433\u043E\u0446\u0435\u043D\u043D\u044B\u0435 \u043A\u0430\u043C\u043D\u0438. \u041E\u043D\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 \u0438\u0445 \u0432 \u0441\u0432\u043E\u0438\u0445 \u0438\u0437\u043E\u0431\u0440\u0435\u0442\u0435\u043D\u0438\u044F\u0445.#$e#\u0412\u044B \u0441 \u041C\u0430\u0440\u0443 \u0434\u0440\u0443\u0436\u0438\u0442\u0435?",
  "fall_Thu": "\u041C\u044B \u0432\u0441\u0435\u0433\u0434\u0430 \u0440\u0430\u0434\u044B \u0442\u0435\u0431\u044F \u0432\u0438\u0434\u0435\u0442\u044C, \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u0442\u044B \u0438 \u043D\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0448\u044C\u0441\u044F \u043D\u0438\u0447\u0435\u0433\u043E \u0437\u0430\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C.$h#$e#\u041D\u0430\u043C \u0438\u043D\u043E\u0433\u0434\u0430 \u0431\u044B\u0432\u0430\u0435\u0442 \u0442\u0430\u043A \u043E\u0434\u0438\u043D\u043E\u043A\u043E \u0432 \u0433\u043E\u0440\u0430\u0445.",
  "fall_Fri": "\u0422\u044B \u0437\u043D\u0430\u0435\u0448\u044C \u0442\u043E\u0433\u043E \u0434\u0438\u043A\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0436\u0438\u0432\u0435\u0442 \u0437\u0430 \u043D\u0430\u0448\u0438\u043C \u0434\u043E\u043C\u043E\u043C?$s#$e#\u041C\u043D\u0435-\u0442\u043E \u0431\u0435\u0437 \u0440\u0430\u0437\u043D\u0438\u0446\u044B, \u043B\u0438\u0448\u044C \u0431\u044B \u043E\u043D \u043D\u0430\u0441 \u043D\u0435 \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0438\u043B.",
  "winter_Mon": "\u041E, \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u0439 \u0434\u0435\u043D\u044C, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u0434\u0440\u0435\u0432\u0435\u0441\u0438\u043D\u0443.#$e#\u041C\u043E\u0436\u0435\u0442, \u0442\u044B \u0434\u0430\u0436\u0435 \u0437\u0430\u0433\u043E\u0442\u043E\u0432\u0438\u0448\u044C \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E, \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0441\u0448\u0438\u0440\u0438\u0442\u044C \u0434\u043E\u043C!",
  "winter_Fri": "\u041C\u043E\u0438 \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0438 \u043E\u0431\u0430\u043B\u0434\u0435\u043B\u0438, \u043A\u043E\u0433\u0434\u0430 \u044F \u0438\u043C \u0441\u043A\u0430\u0437\u0430\u043B\u0430, \u0447\u0442\u043E \u0445\u043E\u0447\u0443 \u0441\u0442\u0430\u0442\u044C \u043F\u043B\u043E\u0442\u043D\u0438\u043A\u043E\u043C.#$e#\u041E\u043D\u0438 \u0431\u044B\u043B\u0438 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0441\u0442\u0430\u0440\u043E\u043C\u043E\u0434\u043D\u044B\u043C\u0438.",
  "winter_Fri_inlaw_Sebastian": "\u0414\u0443\u043C\u0430\u044E, \u0436\u0438\u0437\u043D\u044C \u043D\u0430 \u0444\u0435\u0440\u043C\u0435 \u0434\u043B\u044F \u0421\u0435\u0431\u0431\u0438 \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u043F\u043E\u043B\u044C\u0437\u0443.",
  "winter_Sat": "\u041D\u0430\u0448 \u0434\u043E\u043C \u0441\u0442\u043E\u0438\u0442 \u043D\u0430 \u0442\u0430\u043A\u043E\u043C \u043A\u0440\u0430\u0441\u0438\u0432\u043E\u043C \u0443\u0447\u0430\u0441\u0442\u043A\u0435, \u043F\u0440\u0430\u0432\u0434\u0430?#$e#\u0412\u0441\u0435 \u0431\u0443\u0434\u0442\u043E \u0437\u0430\u043C\u0438\u0440\u0430\u0435\u0442, \u043A\u043E\u0433\u0434\u0430 \u0432\u044B\u043F\u0430\u0434\u0430\u0435\u0442 \u0441\u043D\u0435\u0433."
}