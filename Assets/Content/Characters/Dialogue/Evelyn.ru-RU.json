  "AcceptGift_(O)170": "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0437\u043E\u043B\u043E\u0442\u043A\u043E. \u042F \u0432\u0435\u0437\u0434\u0435 \u0438\u0441\u043A\u0430\u043B\u0430 \u0441\u0432\u043E\u0438 \u043E\u0447\u043A\u0438...#$b#\u041E\u0439-\u043E\u0439! \u041A\u0430\u043A\u0438\u0435 \u043E\u043D\u0438 \u0433\u0440\u044F\u0437\u043D\u044B\u0435...",
  "GreenRain": "\u0414\u0436\u043E\u0440\u0434\u0436, \u0434\u043E\u0440\u043E\u0433\u043E\u0439... \u042D\u0442\u043E \u043A\u043E\u043D\u0435\u0446? \u0423 \u043D\u0430\u0441 \u0431\u044B\u043B\u0430 \u0445\u043E\u0440\u043E\u0448\u0430\u044F \u0436\u0438\u0437\u043D\u044C, \u043D\u043E \u044F \u0431\u044B \u0445\u043E\u0442\u0435\u043B\u0430, \u0447\u0442\u043E\u0431\u044B \u0410\u043B\u0435\u043A\u0441 \u043D\u0430\u0448\u0435\u043B \u0441\u0435\u0431\u044F \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u044F \u0443\u0439\u0434\u0443...$s%noturn",
  "GreenRainFinished": "\u041E \u0431\u043E\u0436\u0435... \u042F \u0442\u0430\u043A \u0440\u0430\u0434\u0430, \u0447\u0442\u043E \u0432\u0441\u0435 \u043E\u0431\u043E\u0448\u043B\u043E\u0441\u044C. \u0410 \u043C\u043E\u0438 \u0446\u0432\u0435\u0442\u044B \u0442\u0435\u043F\u0435\u0440\u044C \u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0442 \u043B\u0443\u0447\u0448\u0435 \u043F\u0440\u0435\u0436\u043D\u0435\u0433\u043E!",
  "GreenRain_2": "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u0446\u0432\u0435\u0442\u0430\u043C \u044D\u0442\u043E\u0442 \u0434\u043E\u0436\u0434\u044C \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F...",
  "AcceptGift_Positive_forage_item_beach": "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0437\u043E\u043B\u043E\u0442\u043A\u043E. \u041D\u0430\u0432\u0435\u0432\u0430\u0435\u0442 \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F \u0434\u0430\u0432\u043D\u043E \u043C\u0438\u043D\u0443\u0432\u0448\u0438\u0445 \u0434\u043D\u0435\u0439...",
  "reject_867": "\u041E\u0439, \u0443\u0432\u0435\u0440\u0435\u043D\u0430, \u0414\u0436\u043E\u0440\u0434\u0436\u0430 \u044D\u0442\u043E \u0437\u0430\u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u0435\u0442!",
  "cropMatured_591": "\u0414\u043E\u043C\u0430\u0448\u043D\u0438\u0435 \u0442\u044E\u043B\u044C\u043F\u0430\u043D\u044B \u2014 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u0432\u0435\u0441\u0435\u043D\u043D\u0438\u0439 \u043F\u043E\u0434\u0430\u0440\u043E\u043A.",
  "cc_Complete": "\u0425\u043E\u0440\u043E\u0448\u043E, \u0447\u0442\u043E \u0441\u0442\u0430\u0440\u044B\u0439 \u043A\u043B\u0443\u0431 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438. \u0421 \u043D\u0438\u043C \u0441\u0432\u044F\u0437\u0430\u043D\u043E \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0439... \u041E\u0441\u043E\u0431\u043E\u0435 \u043C\u0435\u0441\u0442\u043E.",
  "married": "\u041E\u0447\u0435\u043D\u044C \u0437\u0430 \u0442\u0435\u0431\u044F \u0440\u0430\u0434\u0430.$h#$e#\u0421\u0442\u0430\u0440\u0443\u0448\u043A\u0430\u043C \u0432\u0440\u043E\u0434\u0435 \u043C\u0435\u043D\u044F \u043E\u0447\u0435\u043D\u044C \u0440\u0430\u0434\u043E\u0441\u0442\u043D\u043E \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u044C \u0437\u0430 \u0447\u0443\u0432\u0441\u0442\u0432\u0430\u043C\u0438 \u043C\u043E\u043B\u043E\u0434\u0435\u0436\u0438.",
  "divorce": "\u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0440\u0430\u0437 \u0432\u044B\u0431\u0438\u0440\u0430\u0439 \u0434\u043B\u044F \u0431\u0440\u0430\u043A\u0430 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0435\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430...$s",
  "reject_866": "\u041A\u0430\u043A\u0430\u044F \u043A\u0440\u0430\u0441\u0438\u0432\u0430\u044F \u0440\u043E\u0437\u0430, \u0434\u043E\u0440\u043E\u0433\u0443\u0448\u0430. \u0410 \u042D\u043C\u0438\u043B\u0438 \u0443\u0436\u0435 \u0435\u0435 \u0432\u0438\u0434\u0435\u043B\u0430? \u041E\u043D\u0430 \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442 \u043C\u043D\u0435 \u043E \u043D\u0435\u0439.",
  "pamHouseUpgrade": "\u041E\u0445, \u0434\u0443\u0448\u0435\u0447\u043A\u0430... \u0422\u0430\u043A \u043C\u0438\u043B\u043E, \u0447\u0442\u043E \u0442\u044B ${\u043A\u0443\u043F\u0438\u043B^\u043A\u0443\u043F\u0438\u043B\u0430}$ \u041F\u044D\u043C \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0439 \u043D\u043E\u0432\u044B\u0439 \u0434\u043E\u043C!$h#$e#\u0421\u0435\u0440\u0434\u0446\u0435 \u0440\u0430\u0434\u0443\u0435\u0442\u0441\u044F, \u043A\u043E\u0433\u0434\u0430 \u043B\u044E\u0434\u0438 \u0437\u0430\u0431\u043E\u0442\u044F\u0442\u0441\u044F \u0434\u0440\u0443\u0433 \u043E \u0434\u0440\u0443\u0433\u0435...",
  "pamHouseUpgradeAnonymous": "\u041F\u0443\u0441\u0442\u044C \u044F \u0438 \u0433\u043B\u0443\u043F\u0430\u044F \u0441\u0442\u0430\u0440\u0443\u0445\u0430... \u041D\u043E \u043C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u044F \u0437\u043D\u0430\u044E, \u043A\u0442\u043E \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B \u0437\u0430 \u043D\u043E\u0432\u044B\u0439 \u0434\u043E\u043C \u041F\u044D\u043C... *\u043F\u043E\u0434\u043C\u0438\u0433\u0438\u0432\u0430\u0435\u0442*",
  "MovieInvitation": "\u0423\u0445 \u0442\u044B! \u0422\u0430\u043A \u043C\u0438\u043B\u043E \u0441 \u0442\u0432\u043E\u0435\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B. \u041F\u043E\u0447\u0435\u043C\u0443 \u0431\u044B \u0438 \u043D\u0435\u0442... \u042F \u0431\u044B \u0441\u0445\u043E\u0434\u0438\u043B\u0430 \u0432 \u043A\u0438\u043D\u043E!$h#$b#\u0422\u044B \u0438\u0434\u0438, \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043C\u0441\u044F \u0443 \u043A\u0438\u043D\u043E\u0442\u0435\u0430\u0442\u0440\u0430.",
  "Mon": "\u0411\u043E\u0436\u0435 \u043C\u043E\u0439! \u041A\u0430\u043A\u043E\u0439 \u043C\u0438\u043B\u044B\u0439 \u0434\u0435\u043D\u0435\u043A.$u",
  "Tue": "\u041D\u0435 \u043E\u0431\u0440\u0430\u0449\u0430\u0439 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F \u043D\u0430 \u043C\u043E\u0435\u0433\u043E \u043C\u0443\u0436\u0435\u043D\u044C\u043A\u0430 \u0414\u0436\u043E\u0440\u0434\u0436\u0430. \u041E\u043D \u043D\u0435 \u0436\u0430\u043B\u0443\u0435\u0442 \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u0446\u0435\u0432.#$e#\u0415\u0441\u043B\u0438 \u0442\u044B \u0443\u0437\u043D\u0430\u0435\u0448\u044C \u0435\u0433\u043E \u043F\u043E\u0431\u043B\u0438\u0436\u0435, \u043E\u043D \u0438 \u043E\u0442\u0442\u0430\u0435\u0442.#$e#\u042F \u0443\u0432\u0435\u0440\u0435\u043D\u0430, \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u0432\u044B \u0441\u0442\u0430\u043D\u0435\u0442\u0435 \u0434\u043E\u0431\u0440\u044B\u043C\u0438 \u0434\u0440\u0443\u0437\u044C\u044F\u043C\u0438!$h#$e#\u0420\u0430\u0437 \u0443\u0436 \u0442\u0435\u0431\u0435 \u0442\u0430\u043A \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0435\u043D \u043C\u043E\u0439 \u043C\u0443\u0436, \u043E\u0442\u043A\u0440\u043E\u044E \u0442\u0435\u0431\u0435 \u043E\u0434\u0438\u043D \u0441\u0435\u043A\u0440\u0435\u0442\u0438\u043A: \u043E\u043D \u043E\u0447\u0435\u043D\u044C \u043B\u044E\u0431\u0438\u0442 \u043B\u0443\u043A-\u043F\u043E\u0440\u0435\u0439! \u041F\u043E\u0440\u0435\u0439 \u043A\u0430\u043A \u0440\u0430\u0437 \u0440\u0430\u0441\u0442\u0435\u0442 \u0432 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u0433\u043E\u0434\u0430 \u0432 \u0433\u043E\u0440\u0430\u0445.",
  "Wed": "#$1 evelynGarden1#\u0412\u0447\u0435\u0440\u0430 \u044F \u0432\u0438\u0434\u0435\u043B\u0430, \u043A\u0430\u043A \u043F\u0440\u0435\u043C\u0438\u043B\u0430\u044F \u0441\u0435\u043C\u0435\u0439\u043A\u0430 \u0431\u0430\u0431\u043E\u0447\u0435\u043A \u0433\u0440\u0435\u043B\u0430\u0441\u044C \u043D\u0430 \u0441\u043E\u043B\u043D\u044B\u0448\u043A\u0435 \u0432 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u043C \u0441\u0430\u0434\u0443.$k#$e#\u041D\u0430\u0448 \u0434\u043E\u0431\u0440\u044B\u0439 \u043C\u044D\u0440 \u043E\u0442\u0434\u0430\u043B \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u0441\u0430\u0434 \u043C\u043D\u0435 \u043D\u0430 \u043F\u043E\u043F\u0435\u0447\u0435\u043D\u0438\u0435.#$e#\u042F \u043C\u043D\u043E\u0433\u043E \u043D\u0435\u0434\u0435\u043B\u044C \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430 \u043D\u0430\u0434 \u043A\u043B\u0443\u043C\u0431\u0430\u043C\u0438, \u0442\u0430\u043A \u0447\u0442\u043E \u043D\u0435 \u0445\u043E\u0434\u0438 \u043F\u043E \u043D\u0438\u043C!",
  "Thu": "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u0431\u0443\u0434\u0443 \u043F\u0435\u0447\u044C \u043F\u0435\u0447\u0435\u043D\u044C\u0435. \u0412\u0435\u0441\u043D\u043E\u0439 \u044F \u043B\u044E\u0431\u043B\u044E \u043F\u0435\u0447\u044C \u043F\u0435\u0447\u0435\u043D\u044C\u043A\u0438 \u0432 \u0432\u0438\u0434\u0435 \u0446\u0432\u0435\u0442\u043E\u0447\u043A\u043E\u0432.$h#$e#\u041C\u043E\u0436\u0435\u0442, \u044F \u043A\u0430\u043A-\u043D\u0438\u0431\u0443\u0434\u044C \u0438 \u043F\u043E\u0434\u0435\u043B\u044E\u0441\u044C \u0441 \u0442\u043E\u0431\u043E\u0439 \u0440\u0435\u0446\u0435\u043F\u0442\u043E\u043C.",
  "Fri": "\u0414\u0436\u043E\u0440\u0434\u0436 \u0446\u0435\u043B\u044B\u043C\u0438 \u0434\u043D\u044F\u043C\u0438 \u0441\u0438\u0434\u0438\u0442 \u043F\u0435\u0440\u0435\u0434 \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u044B\u043C \u0442\u0435\u043B\u0435\u0432\u0438\u0437\u043E\u0440\u043E\u043C.#$e#\u0412\u043E\u0442 \u0431\u044B \u043E\u043D \u0432\u044B\u0445\u043E\u0434\u0438\u043B \u043D\u0430 \u0443\u043B\u0438\u0446\u0443 \u043F\u043E\u0447\u0430\u0449\u0435. \u0421\u0432\u0435\u0436\u0438\u0439 \u0432\u043E\u0437\u0434\u0443\u0445 \u043F\u043E\u0448\u0435\u043B \u0431\u044B \u0435\u043C\u0443 \u043D\u0430 \u043F\u043E\u043B\u044C\u0437\u0443.",
  "Sat": "\u0420\u0430\u043D\u044C\u0448\u0435 \u044F \u043B\u044E\u0431\u0438\u043B\u0430 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043D\u0430 \u043E\u0431\u043B\u0430\u043A\u0430, \u043D\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u044F \u0441 \u0442\u0440\u0443\u0434\u043E\u043C \u0438\u0445 \u0440\u0430\u0437\u043B\u0438\u0447\u0430\u044E.#$e# \u0413\u043B\u0430\u0437\u0430 \u0443 \u043C\u0435\u043D\u044F \u0443\u0436\u0435 \u043D\u0435 \u0442\u0435, \u0447\u0442\u043E \u043F\u0440\u0435\u0436\u0434\u0435.$s",
  "Sun": "\u0425\u043E\u0440\u043E\u0448\u043E \u0436\u0438\u0442\u044C \u0440\u044F\u0434\u043E\u043C \u0441 \u043E\u043A\u0435\u0430\u043D\u043E\u043C. \u0428\u0443\u043C \u043C\u043E\u0440\u044F \u0442\u0430\u043A \u0445\u043E\u0440\u043E\u0448\u043E \u0443\u0431\u0430\u044E\u043A\u0438\u0432\u0430\u0435\u0442.#$e#\u041A\u043E\u0433\u0434\u0430 \u043C\u044B \u0431\u044B\u043B\u0438 \u0434\u0435\u0442\u044C\u043C\u0438, \u043C\u044B \u0445\u043E\u0434\u0438\u043B\u0438 \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C \u0440\u0430\u043A\u0443\u0448\u043A\u0438 \u043F\u043E\u0441\u043B\u0435 \u043F\u0440\u0438\u043B\u0438\u0432\u0430. \u0412\u043E\u0442 \u0431\u044B\u043B\u0438 \u0432\u0440\u0435\u043C\u0435\u043D\u0430...",
  "Tue6": "\u041E\u0447\u0435\u043D\u044C \u043C\u0438\u043B\u043E, \u0447\u0442\u043E \u0442\u044B \u0437\u0430\u0445\u043E\u0434\u0438\u0448\u044C \u043A \u043D\u0430\u043C \u0441 \u0414\u0436\u043E\u0440\u0434\u0436\u0435\u043C \u0432 \u0433\u043E\u0441\u0442\u0438.#$e#\u041C\u044B \u0431\u044B \u0441\u043E\u0441\u0442\u0430\u0440\u0438\u043B\u0438\u0441\u044C \u043A\u0443\u0434\u0430 \u0431\u044B\u0441\u0442\u0440\u0435\u0435, \u0435\u0441\u043B\u0438 \u0431\u044B \u0432\u043E\u043A\u0440\u0443\u0433 \u043D\u0435 \u0431\u044B\u043B\u043E \u043C\u043E\u043B\u043E\u0434\u0435\u0436\u0438.$h",
  "Event_cookies1": "\u0421\u043F\u0430\u0441\u0438\u0431\u043E!$h",
  "Event_cookies2": "\u0427\u0442\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0448\u044C, \u0434\u0443\u0448\u0435\u0447\u043A\u0430? \u041A\u043B\u044F\u043D\u0443\u0441\u044C, \u043C\u043D\u0435 \u0431\u0443\u0434\u0442\u043E \u043F\u043E\u0441\u043B\u044B\u0448\u0430\u043B\u043E\u0441\u044C \u00AB\u0445\u043E\u043A\u043A\u0435\u0439\u043D\u0430\u044F \u0448\u0430\u0439\u0431\u0430\u00BB. \u041E\u0445... \u0421\u043B\u0443\u0445 \u0443 \u043C\u0435\u043D\u044F \u043D\u0435 \u0442\u043E\u0442, \u0447\u0442\u043E \u043F\u0440\u0435\u0436\u0434\u0435.$s",
  "summer_Mon": "\u0412 \u0442\u0430\u043A\u0443\u044E \u0447\u0443\u0434\u0435\u0441\u043D\u0443\u044E \u043F\u043E\u0433\u043E\u0434\u0443 \u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E \u0441\u0435\u0431\u044F \u0431\u043E\u0434\u0440\u0435\u0435.$u",
  "summer_Mon_inlaw_Alex": "\u041A\u0430\u043A \u0442\u0430\u043C \u043C\u043E\u0439 \u0432\u043D\u0443\u0447\u043E\u043A? \u041F\u043E\u0434\u0438, \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432 \u0436\u0438\u0442\u044C \u043D\u0430 \u0444\u0435\u0440\u043C\u0435.#$e#\u041E\u043D \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u043B \u0431\u044B\u0442\u044C \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u044B\u043C... \u041E\u043D \u0441\u043B\u0430\u0432\u043D\u044B\u0439 \u043C\u0430\u043B\u044C\u0447\u0438\u043A.",
  "summer_Tue": "\u0414\u0436\u043E\u0440\u0434\u0436 \u043B\u0435\u0442\u043E\u043C \u0432\u0441\u0435\u0433\u0434\u0430 \u043C\u0435\u043D\u0435\u0435 \u0441\u0432\u0430\u0440\u043B\u0438\u0432. \u0422\u0435\u043F\u043B\u0430\u044F \u043F\u043E\u0433\u043E\u0434\u0430 \u0434\u0435\u043B\u0430\u0435\u0442 \u0435\u0433\u043E \u043C\u044F\u0433\u0447\u0435.#$e#\u0422\u044B, \u043C\u043E\u0436\u0435\u0442, \u0438 \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u0448\u044C \u0440\u0430\u0437\u043D\u0438\u0446\u044B, \u043D\u043E \u044F-\u0442\u043E \u0432\u0438\u0436\u0443. \u042F \u0432\u043E\u0442 \u0443\u0436\u0435 \u0448\u0435\u0441\u0442\u044C\u0434\u0435\u0441\u044F\u0442 \u043B\u0435\u0442 \u0441 \u043D\u0438\u043C \u0437\u043D\u0430\u043A\u043E\u043C\u0430!",
  "summer_Wed": "\u041D\u0430\u0448 \u0434\u043E\u0431\u0440\u044B\u0439 \u043C\u044D\u0440 \u043E\u0442\u0434\u0430\u043B \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u0441\u0430\u0434 \u043C\u043D\u0435 \u043D\u0430 \u043F\u043E\u043F\u0435\u0447\u0435\u043D\u0438\u0435.#$e#\u042F \u043C\u0435\u0441\u044F\u0446\u0430\u043C\u0438 \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430 \u043D\u0430\u0434 \u043A\u043B\u0443\u043C\u0431\u0430\u043C\u0438, \u0442\u0430\u043A \u0447\u0442\u043E \u043D\u0435 \u0445\u043E\u0434\u0438 \u043F\u043E \u043D\u0438\u043C!",
  "summer_Thu": "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u0431\u0443\u0434\u0443 \u043F\u0435\u0447\u044C \u043F\u0435\u0447\u0435\u043D\u044C\u0435. \u041D\u0430 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u2014 \u043A\u043E\u043A\u043E\u0441\u043E\u0432\u043E\u0435, \u0432 \u0432\u0438\u0434\u0435 \u043F\u0430\u043B\u044C\u043C\u043E\u0447\u0435\u043A! \u0425\u0438-\u0445\u0438.$h#$e#\u041C\u043E\u0436\u0435\u0442, \u044F \u043A\u0430\u043A-\u043D\u0438\u0431\u0443\u0434\u044C \u0438 \u043F\u043E\u0434\u0435\u043B\u044E\u0441\u044C \u0441 \u0442\u043E\u0431\u043E\u0439 \u0440\u0435\u0446\u0435\u043F\u0442\u043E\u043C.",
  "summer_Sat": "\u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u0435\u0439 \u043D\u0430 \u0443\u043B\u0438\u0446\u0435, \u0434\u0443\u0448\u0435\u0447\u043A\u0430. \u0422\u0430\u043A \u043C\u043E\u0436\u043D\u043E \u0438 \u043E\u0431\u0433\u043E\u0440\u0435\u0442\u044C!",
  "summer_Sun": "\u0421\u0435\u0439\u0447\u0430\u0441 \u0446\u0432\u0435\u0442\u0435\u0442 \u0434\u0443\u0448\u0438\u0441\u0442\u044B\u0439 \u0433\u043E\u0440\u043E\u0448\u0435\u043A.#$e#\u041E\u043D \u0442\u0430\u043A \u0447\u0443\u0434\u0435\u0441\u043D\u043E \u043F\u0430\u0445\u043D\u0435\u0442, \u043D\u0435 \u043F\u0440\u0430\u0432\u0434\u0430 \u043B\u0438?",
  "summer_Thu4": "\u041A \u043D\u0430\u043C, \u043F\u043E\u0445\u043E\u0436\u0435, \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442 \u0431\u043E\u043B\u044C\u0448\u0435 \u0433\u043E\u0441\u0442\u0435\u0439, \u043A\u043E\u0433\u0434\u0430 \u044F \u043D\u0430\u0447\u0438\u043D\u0430\u044E \u043F\u0435\u0447\u044C \u043F\u0435\u0447\u0435\u043D\u044C\u0435.#$e#\u042D\u0442\u043E\u0442 \u0440\u0435\u0446\u0435\u043F\u0442 \u043C\u043D\u0435 \u0434\u043E\u0441\u0442\u0430\u043B\u0441\u044F \u043E\u0442 \u043C\u0430\u0442\u0435\u0440\u0438.",
  "fall_Mon": "\u0421 \u043A\u0430\u0436\u0434\u044B\u043C \u0433\u043E\u0434\u043E\u043C \u044F \u0432\u0441\u0435 \u0431\u043E\u043B\u044C\u0448\u0435 \u0446\u0435\u043D\u044E \u043A\u0430\u0436\u0434\u043E\u0435 \u0432\u0440\u0435\u043C\u044F \u0433\u043E\u0434\u0430. \u0414\u043B\u044F \u043C\u043E\u043B\u043E\u0434\u0435\u0436\u0438 \u0433\u043E\u0434 \u043B\u0435\u0433\u043A\u043E \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u043E\u043B\u0435\u0442\u0435\u0442\u044C \u043D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u043E.",
  "fall_Tue": "\u042F \u043A\u043B\u0430\u0434\u0443 \u0414\u0436\u043E\u0440\u0434\u0436\u0443 \u0432 \u043E\u0432\u0441\u044F\u043D\u043A\u0443 \u0438\u0437\u044E\u043C... \u041D\u043E \u043E\u043D \u0435\u0449\u0435 \u043D\u0438 \u0441\u043B\u043E\u0432\u043E\u043C \u043E\u0431 \u044D\u0442\u043E\u043C \u043D\u0435 \u043E\u0431\u043C\u043E\u043B\u0432\u0438\u043B\u0441\u044F. \u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043E\u043D \u0432\u043E\u043E\u0431\u0449\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442 \u0442\u0430\u043A\u0438\u0435 \u0432\u0435\u0449\u0438?",
  "fall_Wed": "\u041D\u0430\u0448 \u0434\u043E\u0431\u0440\u044B\u0439 \u043C\u044D\u0440 \u043E\u0442\u0434\u0430\u043B \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u0441\u0430\u0434 \u043C\u043D\u0435 \u043D\u0430 \u043F\u043E\u043F\u0435\u0447\u0435\u043D\u0438\u0435.#$e#\u041E\u0441\u0435\u043D\u043D\u0438\u0435 \u0446\u0432\u0435\u0442\u044B \u043E\u0447\u0435\u043D\u044C \u043D\u0435\u0436\u043D\u044B\u0435, \u0442\u0430\u043A \u0447\u0442\u043E \u043D\u0435 \u0442\u043E\u043F\u0447\u0438\u0441\u044C \u043F\u043E \u043D\u0438\u043C! \u042F \u0436\u0435 \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0432\u044B, \u0434\u0435\u0442\u043A\u0438, \u043B\u044E\u0431\u0438\u0442\u0435 \u0442\u0430\u043A \u0434\u0435\u043B\u0430\u0442\u044C.",
  "fall_Thu": "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u043F\u0435\u043A\u0443 \u043F\u0435\u0447\u0435\u043D\u044C\u0435. \u041E\u043D\u043E \u0431\u0443\u0434\u0435\u0442 \u0432 \u0444\u043E\u0440\u043C\u0435 \u0442\u044B\u043A\u043E\u0432\u043E\u043A.$h#$e#\u041C\u043E\u0436\u0435\u0442, \u044F \u043A\u0430\u043A-\u043D\u0438\u0431\u0443\u0434\u044C \u0438 \u043F\u043E\u0434\u0435\u043B\u044E\u0441\u044C \u0441 \u0442\u043E\u0431\u043E\u0439 \u0440\u0435\u0446\u0435\u043F\u0442\u043E\u043C.",
  "fall_Sat": "\u0412\u044B \u0441 \u0410\u043B\u0435\u043A\u0441\u043E\u043C \u0434\u0440\u0443\u0436\u0438\u0442\u0435?#$e#\u0418\u043D\u043E\u0433\u0434\u0430 \u044F \u0437\u0430 \u043D\u0435\u0433\u043E \u0442\u0430\u043A \u0432\u043E\u043B\u043D\u0443\u044E\u0441\u044C.",
  "fall_Sat_inlaw_Alex": "\u041E\u0439, \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439, ${\u043C\u043E\u0439 \u0445\u043E\u0440\u043E\u0448\u0438\u0439^\u043C\u043E\u044F \u0445\u043E\u0440\u043E\u0448\u0430\u044F}$. \u0422\u044B \u043C\u043D\u0435 \u0442\u0435\u043F\u0435\u0440\u044C \u043A\u0430\u043A ${\u0432\u043D\u0443\u043A^\u0432\u043D\u0443\u0447\u043A\u0430}$.$h",
  "fall_Sun": "\u041C\u043E\u0436\u0435\u0442, \u0433\u043B\u0430\u0437\u0430 \u0443 \u043C\u0435\u043D\u044F \u0438 \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442, \u043D\u043E \u043D\u043E\u0441 \u043F\u043E\u043A\u0430 \u0435\u0449\u0435 \u043D\u0435 \u043F\u043E\u0434\u0432\u043E\u0434\u0438\u043B!#$e#\u042F \u0447\u0443\u044E \u043E\u043F\u0430\u0432\u0448\u0443\u044E \u043B\u0438\u0441\u0442\u0432\u0443 \u0438 \u0433\u0440\u0438\u0431\u043E\u0447\u043A\u0438. \u042D\u0442\u0438 \u0437\u0430\u043F\u0430\u0445\u0438 \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0442 \u043C\u043D\u0435 \u043E \u043B\u0435\u0441\u0430\u0445, \u0432 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u044F \u0438\u0433\u0440\u0430\u043B\u0430 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0439 \u0434\u0435\u0432\u043E\u0447\u043A\u043E\u0439.",
  "winter_Mon": "\u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u0435\u0435, \u0434\u0443\u0448\u0435\u0447\u043A\u0430, \u043D\u0435 \u043F\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0438\u0441\u044C \u043D\u0430 \u043B\u044C\u0434\u0443.",
  "winter_Tue": "\u0422\u0435\u0431\u0435 \u043D\u0435 \u0445\u043E\u043B\u043E\u0434\u043D\u043E? \u041D\u0443\u0436\u043D\u043E \u043D\u043E\u0441\u0438\u0442\u044C \u043A\u0443\u0440\u0442\u043E\u0447\u043A\u0443 \u043F\u043E\u0442\u043E\u043B\u0449\u0435!#$e#\u041E\u0442 \u044D\u0442\u043E\u0439 \u043F\u043E\u0433\u043E\u0434\u044B \u0443 \u043C\u0435\u043D\u044F \u043A\u043E\u0441\u0442\u0438 \u043B\u043E\u043C\u0438\u0442...$s",
  "winter_Wed": "\u041E\u0431\u044B\u0447\u043D\u043E \u044F \u0445\u043B\u043E\u043F\u043E\u0447\u0443 \u0432 \u0441\u0430\u0434\u0443, \u043D\u043E \u0441\u0435\u0439\u0447\u0430\u0441 \u043E\u043D \u0432\u0435\u0441\u044C \u043F\u043E\u0434 \u0441\u043D\u0435\u0433\u043E\u043C.#$e#\u041D\u043E \u044F \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E \u0432\u0440\u0435\u043C\u044F \u043E\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044E, \u043A\u0430\u043A \u043E\u043D \u0442\u0430\u043C.",
  "winter_Thu": "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u043F\u0435\u043A\u0443 \u043F\u0435\u0447\u0435\u043D\u044C\u0435. \u0421\u0434\u0435\u043B\u0430\u043B\u0430 \u0435\u0433\u043E \u0432 \u0444\u043E\u0440\u043C\u0435 \u0437\u0438\u043C\u043D\u0435\u0439 \u0437\u0432\u0435\u0437\u0434\u044B.$h#$e#\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C \u044F \u043F\u043E\u0432\u0435\u0434\u0430\u044E \u0442\u0435\u0431\u0435 \u0441\u0432\u043E\u0439 \u0440\u0435\u0446\u0435\u043F\u0442.",
  "winter_Sat": "\u041C\u044B \u0436\u0438\u0432\u0435\u043C \u0437\u0434\u0435\u0441\u044C \u0443\u0436\u0435 \u0431\u043E\u043B\u044C\u0448\u0435 30-\u0442\u0438 \u043B\u0435\u0442.#$e#\u041C\u043D\u043E\u0433\u043E \u043D\u0430\u0440\u043E\u0434\u0443 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B\u043E \u0438 \u0443\u0445\u043E\u0434\u0438\u043B\u043E. \u0414\u0435\u0434\u0443\u0448\u043A\u0430 \u0442\u0432\u043E\u0439, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440. \u0426\u0430\u0440\u0441\u0442\u0432\u043E \u0435\u043C\u0443 \u043D\u0435\u0431\u0435\u0441\u043D\u043E\u0435... \u042D\u0445.",
  "winter_Sat6": "\u041E\u0439... \u0414\u0443\u0448\u0435\u0447\u043A\u0430. \u0423 \u0442\u0435\u0431\u044F \u0433\u043B\u0430\u0437\u0430 \u0442\u0432\u043E\u0435\u0433\u043E \u0434\u0435\u0434\u0443\u0448\u043A\u0438.$s#$e#\u0414\u0430... \u0414\u0430... \u042F \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0440\u043E\u0448\u043E \u0435\u0433\u043E \u0437\u043D\u0430\u043B\u0430.",
  "winter_Sun": "\u0421\u0432\u0430\u0440\u0438 \u0433\u043E\u0440\u044F\u0447\u0435\u0433\u043E \u0441\u0443\u043F\u0443, \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u0437\u0430\u043C\u0435\u0440\u0437\u0430\u0442\u044C.#$e#\u0418 \u043D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439 \u043D\u0430\u0434\u0435\u0432\u0430\u0442\u044C \u043A\u0443\u0440\u0442\u043A\u0443!",
  "winter_Sat8": "@, \u044F \u0442\u0435\u0431\u0435 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0430, \u0447\u0442\u043E \u043C\u044B \u0441 \u0414\u0436\u043E\u0440\u0434\u0436\u0435\u043C \u0436\u0438\u0432\u0435\u043C \u0432 \u044D\u0442\u043E\u043C \u0434\u043E\u043C\u0435 \u0443\u0436\u0435 30 \u043B\u0435\u0442?#$e#\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0442\u044B \u0437\u0434\u0435\u0441\u044C \u043E\u0441\u0442\u0430\u043D\u0435\u0448\u044C\u0441\u044F \u043D\u0430\u0434\u043E\u043B\u0433\u043E.$h"
