  "Fri": "\uC57C, \uB18D\uBD80\uB9E8, \uC798 \uC9C0\uB0B4?^\uC57C, \uB18D\uBD80\uAC78\uC774\uC796\uC544. \uC0C8 \uBC14\uC9C0\uC57C? \uC798 \uC5B4\uC6B8\uB9AC\uB294\uB370?#$e#\uC544, \uAE4C\uBA39\uC744\uBED4\uD588\uB2E4! \uC624\uB298 \uD314\uAD7D\uD600 \uD3B4\uAE30 \uD558\uB294 \uB0A0\uC774\uC9C0!#$e#\uD314\uAD7D\uD600 \uD3B4\uAE30 \uD560 \uB54C\uB9C8\uB2E4 \uB9E4\uBC88 \uD558\uB098\uC529 \uB354 \uB298\uB9AC\uACE0 \uC788\uC5B4. \uAF64 \uAD1C\uCC2E\uC740 \uC804\uB7B5\uC774\uC9C0, \uADF8\uCE58?",
  "Sat": "\uD314\uC774 \uC9C4\uC9DC \uC544\uD508\uB370, \uB098 \uAC19\uC740 \uC0AC\uB78C\uD55C\uD150 \uADF8\uAC8C \uC9C4\uCC99\uC774 \uC788\uB2E4\uB294 \uC2E0\uD638\uC9C0.#$e#\uC5B4\uC81C \uD314\uAD7D\uD600 \uD3B4\uAE30 \uD55C \uCC9C \uAC1C\uB294 \uD55C\uAC70 \uAC19\uC544.",
  "Sun": "\uC57C.#$e#\uBB50, \uC598\uAE30\uD558\uC790\uACE0? \uB098 \uC9C0\uAE08 \uBC14\uBE60.",
  "Sun2": "\uC57C, @.#$e#\uADF8\uB798, \uB124 \uC774\uB984 \uAE30\uC5B5\uD558\uACE0 \uC788\uC9C0.",
  "Sun4": "\uC57C, @.#$e#\uC624\uB298 \uD558\uB8E8 \uC5B4\uB54C?",
  "Fri4": "\uC57C, @. \uB4E4\uB7EC\uC918\uC11C \uAE30\uBED0.#$e#\uD560\uBA38\uB2C8\uB97C \uC0AC\uB791\uD55C\uB2E4\uACE0 \uB9D0\uD558\uB294 \uAC70 \uB09C \uC548 \uBD80\uB044\uB7EC\uC6CC!#$e#\uBC18\uBA74\uC5D0 \uD560\uC544\uBC84\uC9C0\uB294...#$e#\uB18D\uB2F4\uC774\uC57C.$h",
  "Tue6": "\uCE5C\uAD6C\uB4E4\uC774\uB791 \uD574\uBCC0\uC5D0\uC11C \uD65C\uAE30\uCC28\uAC8C \uBCF4\uB0B4\uB294 \uD558\uB8E8\uBCF4\uB2E4 \uC88B\uC740 \uAC8C \uC5C6\uC9C0... \uADF8\uCE58?",
  "Mon8": "\uADF8\uAC70 \uC54C\uC544, \uC608\uC804\uC5D0\uB294 \uBD80\uC640 \uBA85\uC608 \uC774\uB7F0 \uAC78 \uC6D0\uD588\uB294\uB370, \uC694\uC998\uC740 \uC880 \uB2E4\uB978 \uC0DD\uAC01\uC774 \uB4E4\uC5B4. \uACB0\uAD6D\uC5D0 \uC9C4\uC9DC \uB9CC\uC871\uC2A4\uB7EC\uC6B4 \uAC74 \uACB8\uD5C8\uD55C \uC791\uC740 \uC77C\uB4E4\uC778 \uAC70 \uAC19\uC544, \uC548 \uADF8\uB798?#$e#\uC544\uC9C1 \uD504\uB85C\uAC00 \uB418\uACE0 \uC2F6\uC9C0\uB9CC, \uADF8\uAC8C \uC138\uC0C1\uC5D0\uC11C \uC81C\uC77C \uC911\uC694\uD55C \uAC74 \uC544\uB0D0.",
  "Fri8": "\uC548\uB155 @. \uC624\uB298 \uB0A0\uB835\uD574 \uBCF4\uC774\uB124.$h^\uC57C @. \uC624\uB298 \uBA38\uB9AC \uC880 \uB2E4\uB974\uAC8C \uD588\uC5B4? \uBB54\uAC00 \uC790\uAFB8 \uB0B4 \uC2DC\uC120\uC744 \uC0AC\uB85C\uC7A1\uB294\uB370.$h",
  "Sat10": "\uC694\uC998 \uC9D1\uC911\uC774 \uC798 \uC548\uB418\uB294 \uAE30\uBD84\uC774\uC57C.$l",
  "Event_beach1": "\uADF8\uC57C \uB2F9\uC5F0\uD558\uC9C0. \uC548 \uADF8\uB7AC\uC73C\uBA74 \uB124\uAC00 \uBBF8\uCCE4\uB2E4\uACE0 \uC0DD\uAC01\uD588\uC744 \uAC70\uC57C. \uC544\uB2C8\uBA74 \uBB34\uC2A8 \uAD34\uC9DC\uAC70\uB098.",
  "Event_beach2": "\uADF8\uB798? \uB108 \uBB54 \uAD34\uC9DC\uAD6C\uB098.$a#$b#\uBBF8\uC548.",
  "Event_books1": "\uC544\uB0D0, \uC548 \uADF8\uB798! \uADF8\uB0E5 \uB098 \uAE30\uBD84 \uC88B\uC73C\uB77C\uACE0 \uD558\uB294 \uC18C\uB9AC\uC9C0.$a",
  "Event_books2": "\uADF8\uB798, \uB124 \uB9D0\uC774 \uB9DE\uB294 \uAC70 \uAC19\uC544...$s",
  "Event_books3": "\uAC70\uAE30\uC11C \uB098\uB791 \uB3D9\uC758\uD558\uBA74 \uC548 \uB418\uC9C0.$a",
  "event_box1": "\uB9DE\uC544... \uB098\uB3C4 \uC54C\uC544. \uB0B4\uAC00 \uADF8\uB798\uC11C \uC6B4\uB3D9\uC73C\uB85C \uC131\uACF5\uD558\uB824\uACE0 \uC774\uB807\uAC8C \uB2E8\uB2E8\uD788 \uACB0\uC2EC\uD55C \uAC70\uC57C...$9#$b#\uADFC\uB370 \uC131\uACF5\uC744 \uD558\uAC74 \uC548 \uD558\uAC74... \uB0B4\uAC00 \uCD5C\uC120\uC744 \uB2E4\uD558\uBA74 \uC790\uB791\uC2A4\uB7EC\uC6CC\uD558\uC2E4 \uAC70\uB77C \uC0DD\uAC01\uD574. \uACE0\uB9C8\uC6CC.",
  "event_box2": "\uC57C... \uADF8\uB798\uB3C4 \uC5B4\uBA38\uB2C8 \uAE30\uC77C\uC778\uB370! \uB108\uBB34\uD588\uB2E4...$a",
  "event_box3": "...\uACE0\uB9C8\uC6CC, @.#$b#\uB108... \uB108 \uB2E4\uB978 \uB0A8\uC790\uC560\uB4E4\uC774\uB791 \uC880 \uB2E4\uB974\uB2E4. \uC880 \uB354 \uC138\uC2EC\uD574.$l^\uC774 \uB3D9\uB124\uC5D0\uC11C \uB108\uB791 \uC81C\uC77C \uC0AC\uC774\uAC00 \uAC00\uAE4C\uC6CC\uC9C4\uAC70 \uAC19\uC544... #$b#\uAE30\uBED0.^\uB9D0\uB85C \uD558\uAE34 \uC880 \uC465\uC2A4\uB7EC\uC6B4 \uAC74\uAC00?$l",
  "event_box4": "\uAE30\uBD84\uC774 \uC804\uD600 \uB098\uC544\uC9C0\uC9C0 \uC54A\uC796\uC544, \uBA4D\uCCAD\uC544.$a",
  "Event_parents1": "\uADF8\uAC70 \uD765\uBBF8\uB85C\uC6B4 \uC0DD\uAC01\uC778\uB370...",
  "Event_parents2": "\uADF8\uB7F4 \uB9AC\uAC00 \uC5C6\uC796\uC544!$a",
  "Event_parents3": "...\uB124 \uB9D0\uC774 \uB9DE\uB294 \uAC70 \uAC19\uAE30\uB3C4... \uBAA8\uB974\uACA0\uB2E4.$s",
  "summer_1": "\uC57C. \uC77C \uB144 \uC911 \uCD5C\uACE0\uB294 \uC5ED\uC2DC \uC5EC\uB984\uC778 \uAC70 \uAC19\uC544.#$e#\uC9C0\uAE08\uC774 \uB531 \uC88B\uC740 \uAC8C \uC544\uC9C1 \uC5EC\uB984\uC774 \uB9CE\uC774 \uB0A8\uC558\uB2E4\uB294 \uAC70\uC57C. \uADF8\uB7FC \uB098\uC911\uC5D0 \uB610 \uBD10.",
  "summer_Mon": "\uC57C, \uB18D\uBD80\uB9E8. \uB108 \uC880 \uD0C4 \uAC70 \uAC19\uB2E4.^\uC57C \uB18D\uBD80\uAC78. \uD0DC\uB2DD \uC798 \uB410\uB124.$h#$e#\uC774\uBC88 \uC5EC\uB984\uC5D0 \uC5F0\uC2B5 \uC81C\uB300\uB85C \uD558\uBA74, \uD504\uB85C \uB418\uB294 \uAC83\uB3C4 \uC26C\uC6CC\uC9C0\uACA0\uC9C0.#$e#\uADF8\uB7FC \uB108\uB3C4 \uB098 \uC548\uB2E4\uACE0 \uC790\uB791\uD560 \uC218 \uC788\uC5B4. \uBA4B\uC9C0\uC9C0, \uC548 \uADF8\uB798?",
  "summer_Tue": "\uC219\uB140\uB4E4\uC774 \uB0B4 \uBA38\uB9AC\uB97C \uC774\uB807\uAC8C \uC548 \uC88B\uC544\uD588\uB2E4\uBA74, \uB2F9\uC7A5\uC774\uB77C\uB3C4 \uB2E4 \uBC00\uC5B4\uBC84\uB9B4 \uD150\uB370.#$e#*\uD55C\uC228*... \uC0B6\uC774 \uCC38 \uD798\uB4E0 \uB54C\uAC00 \uC788\uC5B4.",
  "summer_Wed": "\uC57C \uB18D\uBD80\uB9E8, \uC9C8\uBB38\uC774 \uC788\uC5B4.^\uC57C \uB18D\uBD80\uAC78, \uC9C8\uBB38\uC774 \uC788\uC5B4.#$b#$q 52/53 summer_Wed_01_old#\uB0B4\uAC00 \uD504\uB85C \uC120\uC218\uAC00 \uB420 \uC218 \uC788\uB2E4\uACE0 \uC0DD\uAC01\uD574?#$r 52 30 summer_Wed_01_01#\uC2A4\uD3EC\uCE20\uACC4\uC758 \uC804\uC124\uC774 \uB420 \uC6B4\uBA85\uC774\uC57C#$r 52 0 summer_Wed_01_02#\uAE00\uC384, \uC5F0\uC2B5 \uB9CE\uC774 \uD55C\uB2E4\uBA74#$r 53 -50 summer_Wed_01_03#\uC544\uB2C8, \uC6EC\uB9CC\uD558\uBA74 \uC2E4\uD328\uD558\uACE0 \uADF8\uB0E5 \uD310\uB9E4\uC0AC\uC6D0\uC774 \uB420 \uAC70\uC57C",
  "summer_Wed_01_old": "$p 52#\uC57C, \uB0B4\uAC00 \uD504\uB85C \uC120\uC218\uB418\uBA74 \uB124\uAC00 \uB0B4 \uCCAB \uBC88\uC9F8 \u0022\uD32C\u0022\uC774\uC5C8\uB2E4\uACE0 \uB9D0\uD560 \uC218 \uC788\uC744\uAC70\uC57C. \uB098\uC058\uC9C0 \uC54A\uC9C0?|\uC57C, \uB124\uAC00 \uD2C0\uB838\uB2E4\uB294 \uAC78 \uBCF4\uC5EC\uC8FC\uB824\uACE0 \uC694\uC998 \uB450 \uBC30\uB85C \uC5F4\uC2EC\uD788 \uC5F0\uC2B5\uD558\uACE0 \uC788\uC5B4. \uB531 \uAE30\uB2E4\uB824.$a",
  "summer_Wed_01_01": "\uADF8\uB798, \uBC14\uB85C \uADF8\uAC70\uC57C!$h#$e#\uB108 \uC0DD\uAC01\uBCF4\uB2E4 \uAD1C\uCC2E\uC740\uB370?",
  "summer_Wed_01_02": "\uBB50, \uB0B4\uAC00 \uC6CC\uB099 \uC798\uD558\uB2C8\uAE4C \uADF8\uB807\uAC8C \uB9CE\uC774 \uC5F0\uC2B5\uD560 \uD544\uC694\uB294 \uC5C6\uC744 \uAC70\uC57C.$u",
  "summer_Wed_01_03": "\uBBF8\uCE5C \uC18C\uB9AC\uC57C. \uADF8\uB0E5 \uB0B4\uAC00 \uC7AC\uB2A5\uC774 \uB9CE\uACE0 \uC778\uAE30\uAC00 \uC88B\uB2E4\uACE0 \uC2DC\uAE30\uD558\uB294 \uAC70\uC9C0.$a^\uB9D0\uB3C4 \uC548 \uB418\uB294 \uC18C\uB9AC. \uB108\uB294 \uC0C1\uC0C1\uB3C4 \uD560 \uC218 \uC5C6\uB294 \uC815\uB3C4\uB85C \uB0B4\uAC00 \uC778\uAE30\uAC00 \uB9CE\uC544\uC11C \uC9C8\uD22C\uD558\uB294 \uAC70\uC9C0, \uC774 \uAD34\uBB3C\uC544.$a#$e#\uB098\uD55C\uD14C\uC11C \uB5A8\uC5B4\uC838.$a",
  "summer_Thu": "\uC57C, \uB18D\uC7A5\uC5D0\uC11C \uB9E4\uC77C \uC77C\uD574\uC11C \uD798 \uC880 \uC4F0\uACA0\uB294\uAC78.^\uC57C, \uB18D\uC7A5\uC5D0\uC11C \uB9E4\uC77C \uC77C\uD574\uC11C \uAF64 \uAC74\uAC15\uD558\uACA0\uC5B4.#$e#\uADF8\uB7EC\uB2E4 \uC5B4\uB290 \uB0A0 \uB0B4 \uC218\uC900\uAE4C\uC9C0 \uC62C \uC218 \uC788\uC744\uC9C0\uB3C4 \uBAB0\uB77C. \uAE30\uB300\uD560\uB9CC\uD558\uC9C0, \uC548 \uADF8\uB798?#$e#\uD45C\uC815\uC774 \uC65C \uADF8\uB798?",
  "summer_Fri": "\uC6D0\uD558\uB294 \uAC8C \uBB50\uC57C?#$e#\uB09C \uC9C0\uAE08 \uB354 \uC911\uC694\uD55C \uD560 \uC77C\uC774 \uC788\uC5B4.",
  "summer_Sat": "\uC73C\uC74C... \uC5B4\uB514\uC11C \uBC14\uBCA0\uD050 \uB0C4\uC0C8\uAC00 \uB098\uB294\uB370.#$e#\uC81C\uAE30\uB784, \uBC84\uAC70 \uBA39\uACE0 \uC2F6\uB124.",
  "summer_Sun": "\uC61B \uC2E0\uBC1C\uC5D0 \uBB34\uC2A8 \uAC08\uC0C9 \uC790\uAD6D\uC774 \uC788\uAE38\uB798 \uC5B4\uC81C \uC0C8 \uC2E0\uBC1C\uC744 \uC0C0\uC5B4.#$b#\uADF8\uB0E5 \uC4F0\uB808\uAE30\uD1B5\uC5D0 \uBC84\uB838\uC5B4. \uAE30\uBD80\uB97C \uD558\uC790\uB2C8 \uBB54 \uC774\uC0C1\uD55C \uB188\uC774 \uB0B4 \uC2E0\uBC1C\uC744 \uC2E0\uC744 \uC0DD\uAC01\uC774 \uC2EB\uB354\uB77C\uACE0, \uBB54 \uB9D0\uC778\uC9C0 \uC54C\uC9C0?#$e#...\uBB50?$a",
  "summer_Sun4": "\uC5B4 \uC57C... \uB108 \uC2E0\uBC1C\uC774 \uC880 \uB354\uB7FD\uB2E4... \uADFC\uB370 \uBB50, \uAD1C\uCC2E\uC544!#$e#\uC0AC\uB78C\uB9C8\uB2E4 \uCDE8\uD5A5\uC774 \uB2E4\uB978 \uAC70\uACA0\uC9C0.",
  "summer_Thu4": "\uC57C, \uC774\uBC88 \uC5EC\uB984 \uBAB8 \uC880 \uC7A1\uD788\uB098 \uBCF4\uB124!#$b#\uB18D\uC7A5 \uC77C \uB355 \uC880 \uBCF4\uACE0 \uC788\uB098 \uBD10, \uADF8\uCE58?",
  "summer_Mon4": "\uC57C, \uD0DC\uB2DD \uC798 \uB410\uB2E4.",
  "summer_Fri6": "\uBC29\uC774 \uC880 \uC9C0\uC800\uBD84\uD574\uC11C \uBBF8\uC548\uD574.$s#$e#\uCCAD\uC18C\uD558\uB294 \uAC78 \uAE30\uC5B5\uD558\uB294 \uAC8C \uB108\uBB34 \uC5B4\uB824\uC6CC. \uAC1C\uC120\uD558\uB824\uACE0 \uB178\uB825\uD558\uACE0\uB294 \uC788\uC5B4, \uADF8\uB798\uB3C4.",
  "summer_Wed8": "\uC788\uC9C0, \uB098\uB3C4 \uB18D\uACBD\uC0DD\uD65C \uADF8\uB807\uAC8C \uC2EB\uC9C4 \uC54A\uC744 \uAC70 \uAC19\uC544... \uC2A4\uD3EC\uCE20\uB791 \uBE44\uC2B7\uD55C \uC810\uB3C4 \uB9CE\uC544 \uBCF4\uC5EC.#$e#\uB0B4\uAC00 \uC2E4\uC678\uD65C\uB3D9\uC744 \uC990\uAE30\uACE0 \uC190\uC73C\uB85C \uC9C1\uC811 \uBB58 \uD558\uB294 \uAC8C \uC88B\uC544\uC11C.",
  "summer_Sat10": "\uC694\uC998 \uCC45\uC744 \uC880 \uB354 \uC77D\uC5B4\uBCF4\uB824\uB294 \uC911\uC774\uC57C... \uC6B4\uB3D9\uC5D0 \uB108\uBB34 \uC9D1\uCC29\uD574\uC11C \uBA87 \uB144 \uB3D9\uC548 \uB1CC\uB97C \uBC29\uCE58\uD55C \uB290\uB08C\uC774\uC57C.",
  "fall_1": "\uADF8\uB798, \uB0A0\uC774 \uCD94\uC6CC\uC9C0\uACE0 \uC788\uAE34 \uD574... \uD558\uC9C0\uB9CC \uC544\uC9C1 \uC6B4\uB3D9\uD560 \uB9CC\uD07C\uC740 \uB530\uB73B\uD55C\uAC78!#$e#\uB09C \uADF8\uAC70\uBA74 \uB410\uC5B4.",
  "fall_Mon": "\uD560\uBA38\uB2C8\uB294 \uB098\uB354\uB7EC \uACF5\uBD80\uD558\uB294\uB370 \uC2DC\uAC04\uC744 \uB354 \uB4E4\uC774\uB77C\uB358\uB370.#$e#\uADF8\uB798\uC11C \uB0B4\uAC00 \uB9D0\uD588\uC9C0, \u0027...\uD560\uB9E4, \uAC71\uC815 \uB9C8. \uB098 \uD504\uB85C\uAC00 \uB420 \uAC70\uC57C!\u0027$h#$e#\uACF5\uBD80\uB294 \uBA4D\uCCAD\uC774\uB098 \uD558\uB294 \uC9D3\uC778\uAC78, \uBB50.",
  "fall_Wed": "\uC57C, \uB098 \uBB3C\uC5B4\uBCF4\uACE0 \uC2F6\uC740 \uAC70 \uC788\uC5C8\uC5B4.^\uC57C, \uBB50\uD558\uB098 \uBB3C\uC5B4\uBD10\uB3C4 \uB3FC?#$e#$q 54/55 fall_Wed_01_old#\uC5EC\uC790\uB4E4\uC774 \uB0B4 \uBA38\uB9AC \uC2A4\uD0C0\uC77C \uC88B\uC544\uD560\uAE4C?^\uB0B4 \uBA38\uB9AC \uC2A4\uD0C0\uC77C \uC5B4\uB54C?#$r 54 30 fall_Wed_01_01#\uC720\uD589\uD558\uB294 \uC2A4\uD0C0\uC77C\uC778 \uAC83 \uAC19\uC544.#$r 55 -30 fall_Wed_01_02#\uBB34\uC2A8 \uACF0\uD321\uC774 \uBB49\uCE5C \uAC83 \uAC19\uC544.",
  "fall_Wed_01_old": "\uC624\uB298 \uBA38\uB9AC\uC5D0 \uC824 \uB108\uBB34 \uB9CE\uC774 \uBC1C\uB790\uC5B4. \uC880 \uC544\uD504\uB124.#$e#\uB9CC\uC9C0\uC9C0 \uB9C8!#$e#...\uBB50?",
  "fall_Wed_01_01": "\uADF8\uB798, \uB098\uB3C4 \uC54C\uC544. \uADF8\uB798\uC11C \uC774\uB807\uAC8C \uD55C \uAC70\uC57C.",
  "fall_Wed_01_02": "\uBB50\uB798. \uADF8\uB0E5 \uB0B4\uAC00 \uC798\uC0DD\uACA8\uC11C \uC9C8\uD22C\uD558\uB294 \uAC70\uC9C0.",
  "fall_Thu": "\uC640\uC379?#$e#\uB108 \uC774\uB984 \uBB50\uB354\uB77C, \uB9C9, %firstnameletter%name, \uC544\uB2CC\uAC00?#$e#\uC624. @(\uC774)\uB77C\uACE0? \uC54C\uC558\uC5B4. \uBBF8\uC548.",
  "fall_Fri": "\uC624\uB298 \uBC24\uC5D0 \uC717\uBAB8\uC77C\uC73C\uD0A4\uAE30 200\uBC88 \uD560 \uAC70\uC57C.#$b#\uB098 \uAF64 \uC5F4\uC2EC\uD788 \uD558\uC9C0, \uC548 \uADF8\uB798?$h#$e#\uB2E4\uB978 \uAC70 \uD544\uC694\uD55C \uAC70 \uC788\uC5B4?",
  "fall_Sat": "\uC774\uB9D8\uB54C\uCBE4 \uAC15\uC5D0\uC11C \uC5F0\uC5B4 \uB09A\uC744 \uC218 \uC788\uB294 \uAC78\uB85C \uC54C\uC544.#$e#\uC801\uC5B4\uB3C4 \uB4E3\uAE30\uB860 \uADF8\uB807\uB300.",
  "fall_Sun": "\uC57C, \uC624\uB298 \uADF8\uB9AC\uB4DC\uBCFC \uACBD\uAE30 \uC788\uC5B4!#$e#\uAC00\uC744\uCCA0 \uC77C\uC694\uC77C\uC740 \uAF64 \uBA4B\uC838.$u",
  "fall_Thu2": "\uC798 \uC9C0\uB0B4, @?",
  "fall_Fri6": "\uC624\uB298 \uBC24 \uC717\uBAB8\uC77C\uC73C\uD0A4\uAE30 \uC5C4\uCCAD \uB9CE\uC774 \uD560 \uAC70\uC57C.#$e#\uC7A0\uC7AC\uB825\uC744 \uCD5C\uB300\uB85C \uC774\uB8E8\uACE0 \uC2F6\uC73C\uBA74 \uC815\uB9D0 \uC5F4\uC2EC\uD788 \uB178\uB825\uD574\uC57C \uD574.",
  "fall_Mon4": "\uD560\uBA38\uB2C8\uAED8\uC11C \uB0B4\uAC00 \uC880 \uB354 \uACF5\uBD80\uD558\uB294 \uB370 \uC2DC\uAC04\uC744 \uB4E4\uC5EC\uC57C \uD55C\uB2E4 \uD558\uC168\uC5B4.#$e#\uB9DE\uB294 \uB9D0\uC500\uC77C \uC218\uB3C4 \uC788\uC5B4...$s",
  "fall_Wed8": "\uB4DC\uB514\uC5B4 \uACB0\uC2EC\uD588\uC5B4... \uBA38\uB9AC\uC5D0 \uC824 \uC548 \uBC14\uB974\uAE30\uB85C \uACB0\uC815\uD588\uC5B4.#$e#\uBA38\uB9AC\uC5D0 \uC824 \uBC1C\uB77C\uC57C\uB9CC \uB098\uB97C \uC88B\uC544\uD558\uB294 \uC0AC\uB78C\uD558\uACE0\uB294 \uCE5C\uAD6C\uAC00 \uB418\uACE0 \uC2F6\uC9C0 \uC54A\uC544.",
  "fall_Thu10": "@! \uC74C... \uC548\uB155.$l",
  "winter_1": "\uB0A0\uC528 \uC880 \uBCC4\uB85C\uB2E4. \uC7AC\uBC0C\uB294 \uAC78 \uD558\uC790\uB2C8 \uB208\uC774 \uB108\uBB34 \uB9CE\uC544.#$e#\uC88B\uC544\uD558\uB294 \uC0AC\uB78C\uB3C4 \uC788\uACA0\uC9C0.",
  "winter_Mon": "\uB208 \uC88B\uC544\uD574? \uB09C... \uB09C \uADF8\uB0E5 \uBD04\uC744 \uC624\uAE38 \uAE30\uB300\uD558\uACE0 \uC788\uC5B4.",
  "winter_Tue": "\uC57C, \uD639\uC2DC \uD5E4\uC77C\uB9AC \uCC3E\uC544\uAC00\uC11C \uB0B4\uAC00 \uC778\uC0AC\uD588\uB2E4\uACE0 \uC804\uD574\uC904 \uC218 \uC788\uC5B4?",
  "winter_Tue_inlaw_Haley": "\uC624, \uC57C. \uACB0\uD63C\uC0DD\uD65C\uC740 \uC880 \uC5B4\uB54C?$9",
  "winter_Wed": "\uC0AC\uB78C\uB4E4 \uACA8\uC6B8\uC5D4 \uBCF4\uD1B5 \uC2E4\uB0B4\uC5D0\uB9CC \uC788\uACE0, \uB530\uBD84\uD55C \uAC83\uB9CC \uD574.$s#$e#\uCC45\uC774\uB77C\uB3C4 \uC77D\uC73C\uBA74 \uB35C \uC9C0\uB8E8\uD558\uB824\uB098... \uC5D0\uC774, \uC544\uB0D0.",
  "winter_Thu": "\uD504\uB85C \uC120\uC218\uAC00 \uB418\uBA74, \uB3C8\uC774 \uB108\uBB34 \uB9CE\uC544\uC11C \uC5F4\uB300\uC9C0\uBC29\uC5D0 \uC788\uB294 \uBCC4\uC7A5\uB3C4 \uC0DD\uAE38 \uAC70\uC57C.#$e#\uADF8\uB7FC \uC774\uB7F0 \uC9C0\uB8E8\uD55C \uACA8\uC6B8\uC744 \uACAC\uB51C \uD544\uC694\uAC00 \uC5C6\uACA0\uC9C0.",
  "winter_Fri": "\uB098 \uBCF4\uB7EC \uB208\uC744 \uB6AB\uACE0 \uC5EC\uAE30\uAE4C\uC9C0 \uC628 \uAC70\uC57C?#$e#\uBB50 \uB9D0\uC774 \uB418\uAE34 \uD558\uB124.",
  "winter_Sat": "\uB9C8\uC744\uC5D0 \uC774\uC0C1\uD55C \uC0AC\uB78C\uB4E4\uC774 \uC880 \uC0B4\uACE0 \uC788\uC5B4.#$e#...\uC608\uB97C \uB4E4\uBA74 \uC138\uBC14\uC2A4\uCC2C. \uC65C \uD56D\uC0C1 \uAC80\uC740 \uC637\uB9CC \uC785\uC9C0?#$e#\uC774\uD574\uAC00 \uC548 \uB3FC.",
  "winter_Sun": "\uC57C, \uC624\uB298 \uADF8\uB9AC\uB4DC\uBCFC \uACBD\uAE30\uD55C\uB2E4!#$e#\uC77C\uC8FC\uC77C \uC911 \uC624\uB298\uC774 \uC81C\uC77C \uC88B\uC544.",
  "winter_Fri4": "\uB098 \uBCF4\uB7EC \uB208\uC744 \uB6AB\uACE0 \uC5EC\uAE30\uAE4C\uC9C0 \uC628 \uAC70\uC57C?#$e#\uACE0\uB9C8\uC6CC, \uB2E4\uC815\uD558\uB124.$h",
  "winter_Sat6": "\uC6B0\uB9AC\uB791 \uC644\uC804\uD788 \uB2E4\uB978 \uC0AC\uB78C\uB4E4\uC774 \uC788\uB2E4\uB294 \uAC8C \uC880 \uD765\uBBF8\uB85C\uC6B4 \uAC70 \uAC19\uC544, \uADF8\uCE58?#$b#\uD56D\uC0C1 \uB0A8\uB4E4\uC774 \uC65C \uADF8\uB807\uAC8C \uD589\uB3D9\uD558\uB294\uC9C0 \uC774\uD574\uD560 \uC21C \uC5C6\uC9C0\uB9CC, \uB098\uC058\uC9C0 \uC54A\uC544.",
  "winter_Tue4": "\uC57C, @. \uB098 \uBD80\uD0C1 \uD558\uB098 \uB4E4\uC5B4\uC904 \uC218 \uC788\uC5B4?$l#$b#\uD639\uC2DC \uD5E4\uC77C\uB9AC \uBCF4\uBA74, \uB098 \uBC14\uC058\uB2E4\uACE0 \uC598\uAE30\uD574\uC918.$l#$e#\uACE0\uB9C8\uC6CC.",
  "winter_Tue4_inlaw_Haley": "\uC778\uC815\uD560\uAC8C... \uB108\uB791 \uD5E4\uC77C\uB9AC\uAC00 \uACB0\uD63C\uD588\uC744 \uB54C \uC9C8\uD22C\uAC00 \uB098\uAE34 \uD588\uC5B4. \uADFC\uB370, \uBB50... \uB098 \uC790\uC2E0\uC5D0 \uB300\uD574 \uBB34\uC5B8\uAC00 \uBC30\uC6B8 \uAE30\uD68C\uC600\uC5B4.$9",
  "winter_Wed8": "\uADF8\uAC70 \uC54C\uC544? \uB098 \uCC45 \uC77D\uC73C\uB824\uACE0!",
  "winter_Thu6": "\uB0B4\uAC00 \uB0A0\uC528\uB97C \uC870\uC885\uD560 \uC218 \uC788\uC5C8\uC73C\uBA74 \uC88B\uACA0\uB2E4.",
  "winter_Thu10": "\uB0B4\uAC00 \uB9CC\uC57D \uB3C8\uC744 \uB9CE\uC774 \uBC88\uB2E4\uBA74, \uAC00\uC871\uB4E4\uC774\uB791 \uCE5C\uAD6C\uB4E4\uBD80\uD130 \uD655\uC2E4\uD788 \uCC59\uAE38 \uAC70\uC57C.#$e#\uADF8\uAC70 \uB108\uB3C4 \uD3EC\uD568\uC774\uB2E4.$h"
