{
  "Introduction": "\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E! \u042F \u2014 \u0414\u0435\u043C\u0435\u0442\u0440\u0438\u0443\u0441, \u0443\u0447\u0435\u043D\u044B\u0439 \u0438 \u043E\u0442\u0435\u0446. \u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E \u043F\u0440\u0438\u0448\u043B\u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044C\u0441\u044F!#$e#\u042F \u0438\u0437\u0443\u0447\u0430\u044E \u043C\u0435\u0441\u0442\u043D\u044B\u0435 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F \u0438 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445 \u0432 \u0441\u0432\u043E\u0435\u0439 \u0434\u043E\u043C\u0430\u0448\u043D\u0435\u0439 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438.#$b#\u0412\u044B \u0435\u0449\u0435 \u043D\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043B\u0438 \u043C\u043E\u044E \u0434\u043E\u0447\u044C, \u041C\u0430\u0440\u0443? \u041E\u043D\u0430 \u0445\u043E\u0442\u0435\u043B\u0430 \u0441 \u0432\u0430\u043C\u0438 \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u044C\u0441\u044F.",
  "AcceptGift_(O)StardropTea": "\u0423\u0445 \u0442\u044B, \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u0440\u0435\u0434\u043A\u0430\u044F \u0441\u0443\u0431\u0441\u0442\u0430\u043D\u0446\u0438\u044F. \u041D\u0443\u0436\u043D\u043E \u043E\u0442\u043D\u0435\u0441\u0442\u0438 \u0435\u0435 \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044E \u0434\u043B\u044F... \u044D\u043C... \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0435\u0433\u043E \u0430\u043D\u0430\u043B\u0438\u0437\u0430.",
  "AcceptBirthdayGift_Positive": "\u041F\u043E\u0434\u0430\u0440\u043E\u043A!.. \u0412 \u0441\u0430\u043C\u043E\u0435 \u043E\u043F\u0442\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F. \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0433\u043E\u0434\u043E\u0432\u0449\u0438\u043D\u0430 \u043C\u043E\u0435\u0433\u043E \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F. \u0421\u043F\u0430\u0441\u0438\u0431\u043E!$h",
  "AcceptBirthdayGift_Negative": "\u041F\u043E\u0434\u0430\u0440\u043E\u043A!.. \u0412 \u0441\u0430\u043C\u043E\u0435 \u043E\u043F\u0442\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F. \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0433\u043E\u0434\u043E\u0432\u0449\u0438\u043D\u0430 \u043C\u043E\u0435\u0433\u043E \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F.$h#$b#\u0427\u0442\u043E \u0436\u0435 \u0442\u0430\u043C... $h#$b#...\u0410.$s",
  "AcceptGift_(O)107": "\u0423\u0445 \u0442\u044B, \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u044F\u0439\u0446\u043E \u0434\u0438\u043D\u043E\u0437\u0430\u0432\u0440\u0430! \u041A\u0440\u0430\u0439\u043D\u0435 \u0440\u0435\u0434\u043A\u0438\u0439 \u044D\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440. \u0412\u043E\u0442 \u0431\u044B \u044F \u0441\u043C\u043E\u0433 \u0437\u0430\u0441\u0443\u043D\u0443\u0442\u044C \u0435\u0433\u043E \u0432 \u0438\u043D\u043A\u0443\u0431\u0430\u0442\u043E\u0440..",
  "Resort_Entering": "\u042F \u0443\u0436\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B \u043E\u0434\u043D\u043E\u0433\u043E \u0440\u0435\u0434\u043A\u043E\u0433\u043E \u043A\u0440\u0430\u0431\u0430. \u042D\u0442\u043E \u043C\u0435\u0441\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0432\u0435\u043B\u0438\u043A\u043E\u043B\u0435\u043F\u043D\u043E.$h",
  "GreenRain": "\u041D\u0430 \u043C\u0435\u043D\u044F \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F \u043D\u0435 \u043E\u0431\u0440\u0430\u0449\u0430\u0439, @. \u042F \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043E\u0431\u0438\u0440\u0430\u044E \u043E\u0431\u0440\u0430\u0437\u0446\u044B. \u0414\u0440\u0443\u0433\u043E\u0433\u043E \u0442\u0430\u043A\u043E\u0433\u043E \u0448\u0430\u043D\u0441\u0430 \u043C\u043E\u0436\u0435\u0442 \u0438 \u043D\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044C\u0441\u044F!$7#$e#\u042D\u0442\u043E... \u0415\u0441\u043B\u0438 \u0443\u0432\u0438\u0434\u0438\u0448\u044C \u043C\u043E\u044E \u0436\u0435\u043D\u0443, \u0441\u043A\u0430\u0436\u0435\u0448\u044C \u0435\u0439, \u0447\u0442\u043E \u044F \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435?$7",
  "GreenRain_2": "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u0437\u0435\u043B\u0435\u043D\u044B\u0439 \u0434\u043E\u0436\u0434\u044C \u043D\u0435 \u043E\u0441\u043E\u0431\u043E \u043E\u043F\u0430\u0441\u0435\u043D. \u0422\u0430\u043A \u0447\u0442\u043E \u0432 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u044F \u043D\u0435 \u043E\u0441\u043E\u0431\u043E \u043E\u0442 \u043D\u0435\u0433\u043E \u0437\u0430\u0449\u0438\u0449\u0430\u044E\u0441\u044C.",
  "firstVisit_Desert": "\u0421\u043B\u044B\u0448\u0430\u043B, \u0442\u0435\u0431\u0435 \u043D\u0435\u0434\u0430\u0432\u043D\u043E \u0434\u043E\u0432\u0435\u043B\u043E\u0441\u044C \u043F\u043E\u0431\u044B\u0432\u0430\u0442\u044C \u0432 \u041F\u0443\u0441\u0442\u044B\u043D\u0435 \u041A\u0430\u043B\u0438\u043A\u043E. \u041A\u0430\u043A \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E! \u0423\u0432\u0435\u0440\u0435\u043D, \u0442\u0435\u0431\u0435 \u0442\u0430\u043C \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u043E\u0441\u044C \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0445 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445 \u0438 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439.",
  "questComplete_104_memory_oneday": "\u041C\u043E\u0435 \u0434\u044B\u043D\u043D\u043E\u0435 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435? \u0414\u0430, \u044F... \u044D\u0442\u043E... \u0432\u0441\u0435 \u00AB\u043F\u0440\u043E\u0430\u043D\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043B\u00BB. \u0421\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 \u043C\u0430\u043A\u0440\u043E\u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432 \u0442\u0430\u043C \u043E\u043F\u0442\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435...",
  "purchasedAnimal_Dinosaur": "\u0427\u0442\u043E-\u0447\u0442\u043E?! \u0423 \u0442\u0435\u0431\u044F \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C \u0432\u044B\u0432\u0435\u0441\u0442\u0438 \u044F\u0439\u0446\u043E \u0434\u0438\u043D\u043E\u0437\u0430\u0432\u0440\u0430 \u0432 \u0438\u043D\u043A\u0443\u0431\u0430\u0442\u043E\u0440\u0435? \u042D\u0442\u043E \u0436\u0435 \u0431\u0435\u0441\u043F\u0440\u0435\u0446\u0435\u0434\u0435\u043D\u0442\u043D\u043E!$5#$e#\u0412\u043E\u0442, \u0432\u043E\u0437\u044C\u043C\u0438 \u043C\u043E\u0439 \u043A\u043E\u0444\u0435. \u042F \u0438 \u0431\u0435\u0437 \u043D\u0435\u0433\u043E \u0443\u0436\u0435 \u0432\u0435\u0441\u044C \u0434\u0440\u043E\u0436\u0443... \u041D\u0435 \u043C\u043E\u0433\u0443 \u0431\u043E\u043B\u044C\u0448\u0435 \u0435\u0433\u043E \u043F\u0438\u0442\u044C. [253]",
  "dating_Maru": "\u0414\u0430, \u041C\u0430\u0440\u0443 \u0441\u043E\u043E\u0431\u0449\u0438\u043B\u0430 \u043C\u043D\u0435 \u043D\u043E\u0432\u043E\u0441\u0442\u0438. \u041D\u0435 \u0441\u043A\u0430\u0436\u0443, \u0447\u0442\u043E \u044F \u0440\u0430\u0434, \u043D\u043E, \u043C\u043E\u0436\u0435\u0442, \u0442\u044B \u0441\u043C\u043E\u0436\u0435\u0448\u044C \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u0435.$u",
  "married_Maru": "*\u0432\u0437\u0434\u044B\u0445\u0430\u0435\u0442*... @, \u044F \u043F\u043E\u043D\u044F\u043B, \u0447\u0442\u043E \u043F\u0440\u0438\u0448\u043B\u0430 \u043F\u043E\u0440\u0430 \u043C\u043D\u0435 \u043F\u0440\u0438\u043D\u044F\u0442\u044C, \u0447\u0442\u043E \u043C\u043E\u044F \u00AB\u043C\u0430\u043B\u044B\u0448\u043A\u0430\u00BB \u0432\u044B\u0440\u043E\u0441\u043B\u0430. \u041F\u0440\u0438\u043C\u0438 \u043C\u043E\u0435 \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435.$s",
  "married_Sebastian": "\u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u044E \u0441\u043E \u0441\u0432\u0430\u0434\u044C\u0431\u043E\u0439. \u0420\u043E\u0431\u0438\u043D \u043F\u043B\u0430\u0447\u0435\u0442 \u0441 \u0441\u0430\u043C\u043E\u0439 \u0446\u0435\u0440\u0435\u043C\u043E\u043D\u0438\u0438. \u041E\u043D\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u0447\u0442\u043E \u044D\u0442\u043E \u00AB\u0441\u043B\u0435\u0437\u044B \u0441\u0447\u0430\u0441\u0442\u044C\u044F\u00BB! \u0414\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0435 \u043F\u043E\u043D\u044F\u0442\u0438\u0435...#$e#\u0425\u043C-\u043C, \u0440\u0430\u0437 \u0443 \u043C\u0435\u043D\u044F \u0432 \u043F\u043E\u0434\u0432\u0430\u043B\u0435 \u0442\u0435\u043F\u0435\u0440\u044C \u0435\u0441\u0442\u044C \u043B\u0438\u0448\u043D\u0435\u0435 \u043C\u0435\u0441\u0442\u043E, \u043F\u043E\u0440\u0430 \u0440\u0430\u0441\u0448\u0438\u0440\u0438\u0442\u044C \u043C\u043E\u044E \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044E...$u",
  "eventSeen_65_memory_oneweek": "$y \u0027\u041A\u0430\u043A \u0442\u0430\u043C \u0442\u043E\u0442 \u043F\u0435\u0449\u0435\u0440\u043D\u044B\u0439 \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442? \u0415\u0441\u0442\u044C \u043B\u0438 \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0435 \u0438\u0437\u044B\u0441\u043A\u0430\u043D\u0438\u044F?_\u0414\u0430_\u041E! \u0417\u043D\u0430\u0447\u0438\u0442, \u0442\u0435 \u0443\u0441\u043B\u043E\u0432\u0438\u044F \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C \u0431\u043E\u043B\u0435\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0438\u043C\u0438, \u0447\u0435\u043C \u044F \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u0430\u0433\u0430\u043B... \u0425\u043C-\u043C..._\u041D\u0435\u0442_\u0427\u0442\u043E \u0436, \u043D\u0435 \u0431\u0440\u043E\u0441\u0430\u0439 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438. \u0423\u0432\u0435\u0440\u0435\u043D, \u044D\u0442\u0438 \u043C\u0430\u043B\u044C\u0446\u044B \u043D\u0430\u043C \u0435\u0449\u0435 \u043F\u043E\u043A\u0430\u0436\u0443\u0442.\u0027",
  "eventSeen_65_memory_twoweeks": "\u041D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0442\u044C \u0444\u0435\u0440\u043C\u0443 \u0432 \u043F\u0435\u0449\u0435\u0440\u0435! \u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u0442\u0430\u043C \u0443\u0436\u0435 \u0432\u044B\u0440\u043E\u0441\u043B\u043E \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u043E\u043B\u0435\u0437\u043D\u043E\u0435.",
  "Resort_Leaving": "\u0423 \u043C\u0435\u043D\u044F \u0446\u0435\u043B\u044B\u0435 \u043C\u0435\u0441\u044F\u0446\u044B \u0443\u0439\u0434\u0443\u0442 \u043D\u0430 \u0430\u043D\u0430\u043B\u0438\u0437 \u044D\u0442\u0438\u0445 \u0434\u0430\u043D\u043D\u044B\u0445.",
  "Resort_Shore": "*\u0445\u0440\u0443\u0441\u0442\u044C*... \u043E\u0439, \u044D\u0442\u043E \u0431\u044B\u043B \u043A\u0440\u0430\u0441\u043D\u043E\u043A\u043D\u0438\u0436\u043D\u044B\u0439 \u0432\u0438\u0434 \u043A\u0440\u0430\u0431\u0430...$s#$b#...#$b#\u0410, \u043D\u0435\u0442, \u043D\u0438\u0447\u0435\u0433\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0433\u043E. \u041F\u0440\u043E\u0441\u0442\u043E \u043F\u0443\u0441\u0442\u043E\u0439 \u043F\u0430\u043D\u0446\u0438\u0440\u044C! \u0417\u043D\u0430\u0447\u0438\u0442, \u043C\u043E\u0436\u043D\u043E \u0441\u043F\u0430\u0442\u044C \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E.",
  "Resort_Chair": "\u0422\u0435\u0431\u0435 \u0442\u0443\u0442 \u0432\u0435\u0441\u0435\u043B\u043E, @? \u041F\u043E\u043C\u043D\u0438, \u0438\u043D\u043E\u0433\u0434\u0430 \u043D\u0443\u0436\u043D\u043E \u0438 \u043E\u0442\u0434\u044B\u0445\u0430\u0442\u044C!",
  "Resort_Bar": "\u041E\u0431\u044B\u0447\u043D\u043E \u044F \u043E\u0442 \u0442\u0430\u043A\u043E\u0433\u043E \u0434\u0435\u0440\u0436\u0443\u0441\u044C \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0435... \u041D\u043E \u0438 \u043D\u0430 \u0442\u0440\u043E\u043F\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043E\u0441\u0442\u0440\u043E\u0432\u0430\u0445 \u044F \u0442\u043E\u0436\u0435 \u043D\u0435 \u0442\u0430\u043A \u0447\u0430\u0441\u0442\u043E \u0431\u044B\u0432\u0430\u044E. \u0425\u0430-\u0445\u0430-\u0445\u0430.$h",
  "Resort": "\u0422\u044B \u0432\u043E\u043E\u0431\u0449\u0435 \u0432\u0435\u0440\u0438\u0448\u044C, \u0447\u0442\u043E \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E \u0440\u0435\u0430\u043B\u044C\u043D\u043E? \u0422\u0443\u0442 \u0442\u0430\u043A \u043C\u043D\u043E\u0433\u043E \u0432\u0441\u044F\u043A\u0438\u0445 \u044D\u043A\u0437\u043E\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0432\u0438\u0434\u043E\u0432!",
  "reject_869": "\u0425\u043E\u0440\u043E\u0448\u0438\u0439 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u044C, \u043D\u043E \u044D\u0442\u043E \u043D\u043E\u0440\u043C\u0430 \u0434\u043B\u044F \u0434\u0430\u043D\u043D\u043E\u0433\u043E \u0432\u0438\u0434\u0430. \u041C\u043E\u0436\u0435\u0448\u044C \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0441\u0435\u0431\u0435.",
  "reject_865": "\u0424\u0440\u0443\u043A\u0442 \u0438 \u0441\u043E\u043B\u044C? \u041A\u0430\u043A\u0430\u044F \u0441\u0442\u0440\u0430\u043D\u043D\u0430\u044F \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u044F...$s",
  "pamHouseUpgradeAnonymous": "\u0420\u043E\u0431\u0438\u043D \u0434\u0430\u0436\u0435 *\u043C\u043D\u0435* \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u043A\u0442\u043E \u043A\u0443\u043F\u0438\u043B \u041F\u044D\u043C \u043D\u043E\u0432\u044B\u0439 \u0434\u043E\u043C!#$e#\u042F \u0434\u0435\u043B\u0430\u044E \u0432\u0438\u0434, \u0447\u0442\u043E \u0441\u0435\u0440\u0436\u0443\u0441\u044C, \u043D\u043E \u043D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435 \u044F \u0440\u0430\u0434, \u0447\u0442\u043E \u043E\u043D\u0430 \u0434\u0435\u0440\u0436\u0438\u0442 \u0441\u043B\u043E\u0432\u043E...$h",
  "Mon": "\u041C\u0430\u0440\u0443 \u0438\u043D\u043E\u0433\u0434\u0430 \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u043C\u043D\u0435 \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438... \u041E\u043D\u0430 \u2014 \u0441\u043B\u0430\u0432\u043D\u044B\u0439 \u0440\u0435\u0431\u0435\u043D\u043E\u043A.",
  "Mon_inlaw_Maru": "\u0411\u0435\u0437 \u043F\u043E\u043C\u043E\u0449\u0438 \u041C\u0430\u0440\u0443 \u0441\u043B\u043E\u0436\u043D\u043E \u0437\u0430\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F \u043D\u0430\u0443\u043A\u043E\u0439...#$b#\u041D\u043E \u0435\u0435 \u0441\u0447\u0430\u0441\u0442\u044C\u0435 \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u0432\u0430\u0436\u043D\u0435\u0435 \u044D\u0442\u043E\u0433\u043E \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430!",
  "Tue": "\u0423 \u044D\u0442\u043E\u0439 \u0434\u043E\u043B\u0438\u043D\u044B \u043E\u0447\u0435\u043D\u044C \u043D\u0435\u0437\u0430\u0443\u0440\u044F\u0434\u043D\u0430\u044F \u0438 \u0440\u0430\u0437\u043D\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u0430\u044F \u044D\u043A\u043E\u0441\u0438\u0441\u0442\u0435\u043C\u0430. \u042D\u0442\u043E \u043E\u0434\u043D\u0430 \u0438\u0437 \u043F\u0440\u0438\u0447\u0438\u043D, \u043F\u043E \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u044F \u0431\u044B\u043B \u0440\u0430\u0434 \u0441\u044E\u0434\u0430 \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u0442\u044C.",
  "Wed": "\u0422\u044B, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u043C\u043D\u043E\u0433\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0445 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439 \u0432\u044B\u0440\u0430\u0449\u0438\u0432\u0430\u0435\u0448\u044C \u0443 \u0441\u0435\u0431\u044F \u043D\u0430 \u0444\u0435\u0440\u043C\u0435, \u0434\u0430?#$e#\u041C\u043E\u0436\u0435\u0442, \u044F \u043A\u0430\u043A-\u043D\u0438\u0431\u0443\u0434\u044C \u0437\u0430\u0433\u043B\u044F\u043D\u0443 \u043A \u0442\u0435\u0431\u0435 \u043D\u0430 \u0444\u0435\u0440\u043C\u0443 \u0438 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u044E \u0441\u0430\u043C.",
  "Thu": "\u041A\u0430\u043A \u0434\u0435\u043B\u0430 \u043D\u0430 \u0444\u0435\u0440\u043C\u0435? \u0421\u0435\u0439\u0447\u0430\u0441 \u0441\u0435\u0437\u043E\u043D \u043F\u0430\u0441\u0442\u0435\u0440\u043D\u0430\u043A\u0430, \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E?#$e#\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u044E, \u043A\u0430\u043A \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0432\u0435\u0441\u044C \u0434\u0435\u043D\u044C \u0441 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F\u043C\u0438 \u043D\u0430 \u0441\u0432\u0435\u0436\u0435\u043C \u0432\u043E\u0437\u0434\u0443\u0445\u0435.",
  "Fri": "\u0420\u043E\u0431\u0438\u043D \u0432\u0441\u043F\u044B\u043B\u044C\u0447\u0438\u0432\u0430\u044F. \u041B\u0443\u0447\u0448\u0435 \u0441 \u043D\u0435\u0439 \u043D\u0435 \u0441\u0441\u043E\u0440\u0438\u0442\u044C\u0441\u044F.#$e#\u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438 \u0435\u0439, \u0447\u0442\u043E \u044F \u044D\u0442\u043E \u0441\u043A\u0430\u0437\u0430\u043B.$h",
  "Sat": "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C... \u0415\u0441\u043B\u0438 \u0432 \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F\u0445 \u0438\u0437 \u0440\u0438\u0437\u043E\u0441\u0444\u0435\u0440\u044B \u0443\u0433\u043B\u0435\u0440\u043E\u0434-13 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0432 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E\u0439 \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0430\u0446\u0438\u0438, \u0442\u043E...$u#$b#\u041E\u0439! \u041F\u0440\u043E\u0441\u0442\u0438. \u042F \u0442\u0443\u0442 \u0440\u0430\u0437\u043C\u044B\u0448\u043B\u044F\u043B \u043D\u0430\u0434 \u0434\u0430\u043D\u043D\u044B\u043C\u0438 \u0438 \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B \u0442\u0435\u0431\u044F.#$e#\u0422\u0435\u0431\u0435 \u0447\u0442\u043E-\u0442\u043E \u043D\u0443\u0436\u043D\u043E?",
  "Sun": "\u041F\u043E\u043B\u0435\u0437\u043D\u043E \u0431\u044B\u0432\u0430\u0435\u0442 \u0438\u043D\u043E\u0433\u0434\u0430 \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043F\u0435\u0440\u0435\u0440\u044B\u0432 \u0432 \u0440\u0430\u0431\u043E\u0442\u0435.#$e#\u041F\u0440\u0430\u0432\u0434\u0430, \u043D\u0430 \u0444\u0435\u0440\u043C\u0435 \u044D\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u043D\u0435 \u0442\u0430\u043A-\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E.#$e#\u041D\u0443, \u0437\u0430\u0442\u043E \u0437\u0438\u043C\u043E\u0439 \u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442 \u0432\u043E\u043B\u043D\u043E\u0432\u0430\u0442\u044C\u0441\u044F \u043E\u0431 \u0443\u0440\u043E\u0436\u0430\u0435.",
  "Fri4": "\u0420\u043E\u0431\u0438\u043D \u0432\u0441\u043F\u044B\u043B\u044C\u0447\u0438\u0432\u0430\u044F. \u041B\u0443\u0447\u0448\u0435 \u0441 \u043D\u0435\u0439 \u043D\u0435 \u0441\u0441\u043E\u0440\u0438\u0442\u044C\u0441\u044F.#$e#... \u0415\u0441\u043B\u0438 \u0431\u044B \u044F \u043C\u043E\u0433 \u0432\u044B\u0440\u0430\u0437\u0438\u0442\u044C \u0435\u0435 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435 \u0432 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439 \u0444\u043E\u0440\u043C\u0435, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u044F \u0431\u044B \u0441\u043C\u043E\u0434\u0435\u043B\u0438\u0440\u043E\u0432\u0430\u043B \u043A\u043E\u043B\u0435\u0431\u0430\u043D\u0438\u044F \u0432 \u0435\u0435 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0438 \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0441\u0438\u043D\u0443\u0441\u043E\u0438\u0434\u044B...$u",
  "Wed6": "\u041F\u0440\u0438\u0432\u0435\u0442, @! \u041A\u0430\u043A \u0443 \u0442\u0435\u0431\u044F \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0434\u0435\u043B\u0430?#$e#\u0425\u043E\u0442\u0435\u043B\u043E\u0441\u044C \u0431\u044B \u043C\u043D\u0435 \u043A\u0430\u043A-\u043D\u0438\u0431\u0443\u0434\u044C \u043E\u0431\u043B\u0435\u0433\u0447\u0438\u0442\u044C \u0442\u0432\u043E\u044E \u0440\u0430\u0431\u043E\u0442\u0443 \u043D\u0430 \u0444\u0435\u0440\u043C\u0435.",
  "Event_tomato1": "\u041F\u0440\u0430\u0432\u0434\u0430? \u042F-\u0442\u043E \u0434\u0443\u043C\u0430\u043B, \u0447\u0442\u043E \u0444\u0435\u0440\u043C\u0435\u0440 \u0434\u043E\u043B\u0436\u0435\u043D \u0437\u043D\u0430\u0442\u044C \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442...$s",
  "Event_tomato2": "\u0412\u0438\u0434\u0438\u0448\u044C? @ \u0442\u043E\u0436\u0435 \u0442\u0430\u043A \u0441\u0447\u0438\u0442\u0430\u0435\u0442.",
  "Event_Lab_Silence": "\u0417\u043D\u0430\u0447\u0438\u0442, \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0441\u043A\u043E\u0440\u0435\u0435 \u043E\u0442\u0442\u0438\u0442\u0440\u043E\u0432\u0430\u0442\u044C \u0440\u0430\u0441\u0442\u0432\u043E\u0440, \u043F\u043E\u043A\u0430 \u043E\u043D \u043D\u0435 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u0438\u0437\u043E\u0432\u0430\u043B\u0441\u044F.",
  "Event_Lab_Rat": "\u042D\u0445... %fork$4",
  "summer_Mon": "#$e#%\u0414\u0435\u043C\u0435\u0442\u0440\u0438\u0443\u0441 \u0433\u043B\u0443\u0431\u043E\u043A\u043E \u0437\u0430\u0434\u0443\u043C\u0430\u043B\u0441\u044F.#$e#\u041F\u0440\u043E\u0441\u0442\u0438, \u044F \u043E\u0447\u0435\u043D\u044C \u0437\u0430\u043D\u044F\u0442.#$e#\u041C\u043D\u0435 \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0443\u0436\u043D\u043E \u0438\u0437\u0443\u0447\u0438\u0442\u044C \u0442\u0430\u043A \u043C\u043D\u043E\u0433\u043E \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439.",
  "summer_Tue": "\u041D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439 \u043F\u043E\u043B\u0438\u0432\u0430\u0442\u044C \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C.#$e#\u041F\u0440\u0430\u0432\u0434\u0430, \u0435\u0441\u043B\u0438 \u0442\u044B \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0448\u044C \u0432\u043B\u0430\u0433\u043E\u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0449\u0443\u044E \u043F\u043E\u0447\u0432\u0443, \u0442\u043E \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u043C\u0435\u043D\u044C\u0448\u0435 \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0438\u0442\u044C\u0441\u044F \u043E \u043F\u043E\u043B\u0438\u0432\u0435.#$e#\u041E\u0447\u0435\u043D\u044C \u0443\u0434\u043E\u0431\u043D\u043E.",
  "summer_Thu": "\u041A\u0430\u043A \u0434\u0435\u043B\u0430 \u043D\u0430 \u0444\u0435\u0440\u043C\u0435? \u0421\u0435\u0439\u0447\u0430\u0441 \u0441\u0435\u0437\u043E\u043D \u043F\u043E\u043C\u0438\u0434\u043E\u0440\u043E\u0432, \u0432\u0435\u0440\u043D\u043E?#$e#\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u044E, \u043A\u0430\u043A \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0432\u0435\u0441\u044C \u0434\u0435\u043D\u044C \u0441 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F\u043C\u0438 \u043D\u0430 \u0441\u0432\u0435\u0436\u0435\u043C \u0432\u043E\u0437\u0434\u0443\u0445\u0435.",
  "summer_Fri": "$p 40#\u042F \u0441\u043B\u044B\u0448\u0430\u043B, \u041C\u0430\u0440\u0443 \u0434\u0430\u043B\u0430 \u0442\u0435\u0431\u0435 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0432 \u0435\u0435 \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F \u043D\u0430 \u0437\u0430\u0434\u043D\u0435\u043C \u0434\u0432\u043E\u0440\u0435.|\u0415\u0441\u043B\u0438 \u0432\u044B \u0441 \u041C\u0430\u0440\u0443 \u043F\u043E\u0434\u0440\u0443\u0436\u0438\u0442\u0435\u0441\u044C, \u0442\u043E \u043E\u043D\u0430 \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430 \u043F\u043E\u043A\u0430\u0436\u0435\u0442 \u0442\u0435\u0431\u0435, \u043A\u0430\u043A \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F \u0435\u0435 \u0442\u0435\u043B\u0435\u0441\u043A\u043E\u043F\u043E\u043C, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0441\u0442\u043E\u0438\u0442 \u043D\u0430 \u0437\u0430\u0434\u043D\u0435\u043C \u0434\u0432\u043E\u0440\u0435.#$e#\u0417\u0430\u043C\u0430\u043D\u0447\u0438\u0432\u043E, \u043F\u0440\u0430\u0432\u0434\u0430?",
  "summer_Fri_inlaw_Maru": "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u043C\u043E\u044F \u0434\u043E\u0447\u043A\u0430 \u043D\u0435 \u0437\u0430\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442 \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0443 \u0441 \u0444\u0438\u0437\u0438\u043A\u043E\u0439!",
  "summer_Sat": "\u0425\u043C-\u043C... \u0415\u0441\u043B\u0438 \u0431\u044B \u043C\u043E\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0442\u044C \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u0441\u0442\u0440\u0438\u0433\u043E\u043B\u0430\u043A\u0442\u043E\u043D\u043E\u0432, \u043E\u043A\u0430\u0437\u0430\u043B\u043E \u0431\u044B \u044D\u0442\u043E \u043F\u0440\u043E\u043F\u043E\u0440\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439 \u044D\u0444\u0444\u0435\u043A\u0442 \u043D\u0430 \u0440\u043E\u0441\u0442 \u043C\u0438\u043A\u043E\u0440\u0438\u0437\u043D\u043E\u0433\u043E \u0433\u0440\u0438\u0431\u0430?$u#$b#\u041E\u0439! \u041F\u0440\u043E\u0441\u0442\u0438. \u042F \u0442\u0443\u0442 \u0440\u0430\u0437\u043C\u044B\u0448\u043B\u044F\u043B \u043D\u0430\u0434 \u0434\u0430\u043D\u043D\u044B\u043C\u0438 \u0438 \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B \u0442\u0435\u0431\u044F.#$e#\u0422\u0435\u0431\u0435 \u0447\u0442\u043E-\u0442\u043E \u043D\u0443\u0436\u043D\u043E?",
  "summer_Mon6": "\u042F \u0441\u0442\u0430\u043B \u0443\u0447\u0435\u043D\u044B\u043C, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u044F \u0445\u043E\u0442\u0435\u043B \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0441\u0432\u043E\u0439 \u0432\u043A\u043B\u0430\u0434 \u0432 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u043D\u0430\u0448\u0435\u0433\u043E \u0432\u0438\u0434\u0430.#$e#\u041A\u043E\u043D\u0435\u0447\u043D\u043E, \u0432\u0441\u0435 \u044D\u0442\u043E \u0431\u044B\u043B\u043E \u0431\u044B \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u0431\u0435\u0437 \u0444\u0435\u0440\u043C\u0435\u0440\u043E\u0432, \u0442\u0430\u043A\u0438\u0445, \u043A\u0430\u043A \u0442\u044B.$h",
  "fall_Mon": "\u0412 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u0433\u043E\u0434\u0430 \u044F \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u044E \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u043D\u0430 \u0433\u0440\u0438\u0431\u044B.",
  "fall_Tue": "\u041C\u044B \u043C\u043D\u043E\u0433\u043E\u0435 \u0437\u043D\u0430\u0435\u043C \u043E \u043F\u0440\u0438\u0440\u043E\u0434\u0435 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u043D\u0430\u0443\u043A\u0435.#$e#\u041D\u043E \u043C\u043D\u043E\u0433\u043E\u0435 \u0435\u0449\u0435 \u043E\u0441\u0442\u0430\u0435\u0442\u0441\u044F \u043D\u0435\u0438\u0437\u0432\u0435\u0434\u0430\u043D\u043D\u044B\u043C.",
  "fall_Thu": "\u041A\u0430\u043A \u0434\u0435\u043B\u0430 \u043D\u0430 \u0444\u0435\u0440\u043C\u0435? \u0421\u0435\u0439\u0447\u0430\u0441 \u0432\u0435\u0434\u044C \u0441\u0435\u0437\u043E\u043D \u043A\u0443\u043A\u0443\u0440\u0443\u0437\u044B, \u0434\u0430?#$e#\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u044E, \u043A\u0430\u043A \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0432\u0435\u0441\u044C \u0434\u0435\u043D\u044C \u0441 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F\u043C\u0438 \u043D\u0430 \u0441\u0432\u0435\u0436\u0435\u043C \u0432\u043E\u0437\u0434\u0443\u0445\u0435.",
  "fall_Fri": "\u041C\u0430\u0440\u0443 \u0442\u0430\u043A \u043C\u043D\u043E\u0433\u043E \u0432\u043E\u0437\u0438\u0442\u0441\u044F \u0441\u043E \u0441\u0432\u043E\u0438\u043C\u0438 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430\u043C\u0438.#$e#\u042F \u0440\u0430\u0434, \u0447\u0442\u043E \u043E\u043D\u0430 \u0442\u0430\u043A\u0430\u044F \u0446\u0435\u043B\u0435\u0443\u0441\u0442\u0440\u0435\u043C\u043B\u0435\u043D\u043D\u0430\u044F.",
  "fall_Fri_inlaw_Maru": "\u042F \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u043E\u0448\u0435\u043B\u043E\u043C\u043B\u0435\u043D \u0442\u0430\u0439\u043D\u044B\u043C \u0440\u043E\u0431\u043E\u0442\u043E\u043C \u041C\u0430\u0440\u0443... \u042D\u0442\u043E \u0442\u043E\u0447\u043D\u043E \u0431\u044B\u043B \u043D\u0435 \u0441\u043E\u043D?",
  "fall_Sat": "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C... \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043D\u0430 \u0443\u0441\u0432\u043E\u0435\u043D\u0438\u0435 \u0430\u0437\u043E\u0442\u0430 \u0432\u043B\u0438\u044F\u044E\u0442 \u0432\u044B\u0434\u0435\u043B\u0435\u043D\u0438\u044F \u043D\u0435\u043C\u0430\u0442\u043E\u0434...$u#$b#\u041E\u0439! \u041F\u0440\u043E\u0441\u0442\u0438. \u042F \u0442\u0443\u0442 \u0440\u0430\u0437\u043C\u044B\u0448\u043B\u044F\u043B \u043D\u0430\u0434 \u0434\u0430\u043D\u043D\u044B\u043C\u0438 \u0438 \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B \u0442\u0435\u0431\u044F.#$e#\u0422\u0435\u0431\u0435 \u0447\u0442\u043E-\u0442\u043E \u043D\u0443\u0436\u043D\u043E?",
  "fall_Wed6": "\u041F\u0440\u0438\u0432\u0435\u0442, @. \u042F \u0432\u0441\u0435\u0433\u0434\u0430 \u0440\u0430\u0434 \u0442\u0432\u043E\u0435\u043C\u0443 \u0432\u0438\u0437\u0438\u0442\u0443.#$e#\u041F\u0440\u0438\u044F\u0442\u043D\u043E \u043F\u043E\u0431\u044B\u0442\u044C \u0432 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 \u043F\u043E\u0441\u043B\u0435 \u043E\u0434\u0438\u043D\u043E\u043A\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438.",
  "winter_Mon": "\u042F \u0441\u0435\u0439\u0447\u0430\u0441 \u043E\u0442\u0434\u044B\u0445\u0430\u044E \u043E\u0442 \u0441\u0432\u043E\u0438\u0445 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439.",
  "winter_Tue": "\u0415\u0441\u043B\u0438 \u0445\u043E\u0447\u0435\u0448\u044C \u0440\u0430\u0441\u0448\u0438\u0440\u0438\u0442\u044C \u0434\u043E\u043C, \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438 \u043E\u0431 \u044D\u0442\u043E\u043C \u0441 \u043C\u043E\u0435\u0439 \u0436\u0435\u043D\u043E\u0439.",
  "winter_Wed": "\u0423 \u0442\u0435\u0431\u044F \u0432 \u0434\u043E\u043C\u0435 \u0443\u0436\u0435 \u0435\u0441\u0442\u044C \u043A\u0443\u0445\u043D\u044F?#$e#\u0413\u043E\u0442\u043E\u0432\u043A\u0430 \u0432 \u0447\u0435\u043C-\u0442\u043E \u0441\u0445\u043E\u0436\u0430 \u0441 \u0440\u0430\u0431\u043E\u0442\u043E\u0439 \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438.",
  "winter_Thu": "\u0423 \u0442\u0435\u0431\u044F \u043D\u0430 \u0444\u0435\u0440\u043C\u0435 \u0435\u0441\u0442\u044C \u043A\u0430\u043A\u0438\u0435-\u043D\u0438\u0431\u0443\u0434\u044C \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0435?",
  "winter_Fri": "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439.#$e#%\u041F\u043E\u0445\u043E\u0436\u0435, \u0414\u0435\u043C\u0435\u0442\u0440\u0438\u0443\u0441 \u0433\u043B\u0443\u0431\u043E\u043A\u043E \u0437\u0430\u0434\u0443\u043C\u0430\u043B\u0441\u044F.",
  "winter_Sat": "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C... \u0415\u0441\u043B\u0438 \u0441\u0435\u0437\u043E\u043D\u043D\u044B\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u0430\u0437\u043E\u0442\u0430 \u043C\u043E\u0436\u043D\u043E \u0432\u044B\u0440\u0430\u0437\u0438\u0442\u044C \u043A\u0443\u0441\u043E\u0447\u043D\u043E\u0439 \u0444\u0443\u043D\u043A\u0446\u0438\u0435\u0439, \u0442\u043E...$u#$b#\u041E\u0439! \u041F\u0440\u043E\u0441\u0442\u0438. \u042F \u0442\u0443\u0442 \u0440\u0430\u0437\u043C\u044B\u0448\u043B\u044F\u043B \u043D\u0430\u0434 \u0434\u0430\u043D\u043D\u044B\u043C\u0438 \u0438 \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B \u0442\u0435\u0431\u044F.#$e#\u0422\u0435\u0431\u0435 \u0447\u0442\u043E-\u0442\u043E \u043D\u0443\u0436\u043D\u043E?",
  "winter_Sun": "\u041C\u043E\u0436\u0435\u0448\u044C \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C \u0437\u0434\u0435\u0441\u044C \u043A\u0430\u043C\u0435\u043D\u044C \u0438 \u0434\u0440\u0435\u0432\u0435\u0441\u0438\u043D\u0443, \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0437\u0430\u0445\u043E\u0447\u0435\u0448\u044C.",
  "winter_Fri4": "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E \u0437\u0430\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0448\u044C. \u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043E\u0442\u0432\u043B\u0435\u0447\u044C\u0441\u044F \u043E\u0442 \u0431\u043E\u0431\u043E\u0432\u044B\u0445 \u043D\u0430 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C.#$e#\u0427\u0435\u043C \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0448\u044C\u0441\u044F \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0432\u0440\u0435\u043C\u044F?#$e#\u042D\u0442\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E."
}