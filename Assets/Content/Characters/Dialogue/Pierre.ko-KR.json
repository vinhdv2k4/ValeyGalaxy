  "winter_Wed": "$d joja#\uB4DC\uB514\uC5B4... \uD558\uB8E8 \uC880 \uC26C\uACA0\uB124.|\uC774\uC81C \uC870\uC790\uB3C4 \uC5C6\uC73C\uB2C8\uAE4C, \uB0B4\uAC00 \uCC45\uC784\uC9C0\uACE0 \uB9E4\uC77C \uAC00\uAC8C\uB97C \uC5F4\uC5B4\uC57C\uC9C0. \uC0AC\uB78C\uB4E4\uC740 \uC7A5\uC744 \uBD10\uC57C \uD55C\uB2E4\uACE0!",
  "winter_Thu": "#$1 pierreDin#\uC624\uB298\uC740 \uC800\uB141\uC744 \uC900\uBE44\uD558\uACE0 \uC2A4\uD0C0\uB4C0 \uB808\uB4DC \uD55C \uBCD1\uC73C\uB85C \uCE90\uB864\uB77C\uC778\uC5D0\uAC8C \uAE5C\uC9DD \uC120\uBB3C\uC744 \uC8FC\uB824\uACE0. \uC544\uBB34\uD55C\uD14C\uB3C4 \uB9D0\uD558\uC9C4 \uB9C8!$k#$e#\uC548\uB155. \uC1FC\uD551 \uC880 \uD574\uC57C \uB420 \uAE30\uBD84\uC774\uC57C?",
  "winter_Fri": "\uB09C \uC8FC\uB85C \uC2DD\uB8CC\uD488\uC744 \uB2E4\uB8E8\uB294 \uD3B8\uC774\uB77C, \uAD11\uC11D\uC774\uB098 \uBAA9\uC7AC\uAC00 \uC788\uB2E4\uBA74 \uB2E4\uB978 \uACF3\uC5D0 \uD30C\uB294 \uAC8C \uC88B\uC744 \uAC70\uC57C.",
  "winter_Sat": "\uB098\uB9CC \uCD94\uC6B4 \uAC74\uAC00? \uC5B4\uB514\uC11C \uCC2C\uBC14\uB78C\uC774 \uB4E4\uC5B4\uC624\uB294 \uAC74\uAC00?",
  "winter_Sun": "\uAC00\uAC8C \uC77C\uB9CC \uC544\uB2C8\uC5C8\uB2E4\uBA74 \uBC16\uC5D0 \uC788\uC744 \uD150\uB370.#$e#\uB208\uB369\uC774 \uB358\uC9C0\uB294 \uAC83\uB3C4 \uC7AC\uBC0C\uC744 \uD150\uB370.",
  "fall_Mon": "\uAC00\uC744\uCCA0 \uC528\uC557\uC774 \uB3C4\uCC29\uD588\uC5B4! \uACA8\uC6B8\uC5D0\uB294 \uC791\uBB3C\uC774 \uC790\uB77C\uB2C8 \uC54A\uC73C\uB2C8\uAE4C \uBD04\uAE4C\uC9C0 \uC774\uBC88\uC774 \uB9C8\uC9C0\uB9C9 \uAE30\uD68C\uC57C.#$b#\uC804\uB825\uC9C8\uC8FC\uD574\uC57C\uACA0\uB124, \uADF8\uCE58?",
  "fall_Thu": "\uBC16\uC774 \uC2AC\uC2AC \uC300\uC300\uD574\uC9C0\uACE0 \uC788\uC5B4...#$b#\uC0AC\uB78C\uB4E4\uC774 \uBAB8 \uC880 \uB370\uC6B0\uB7EC \uAC00\uAC8C \uC548\uC5D0 \uB4E4\uC5B4\uC624\uACE0 \uADF8\uB7EC\uC9C0... \uD5E4\uD5E4.",
  "fall_Fri": "#$1 pierreMEGA#\uB09C \uC815\uB9D0 \uBD80\uC720\uD574\uC9C8 \uB54C\uAE4C\uC9C0 \uACC4\uC18D \uC0C8\uB85C\uC6B4 \uAC00\uAC8C\uB97C \uC5EC\uB294 \uAC8C \uB0B4 \uAFC8\uC774\uC57C. \uD5E4\uD5E4\uD5E4.$k#$e#\uC548\uB155. \uB18D\uC7A5 \uC77C\uC740 \uC798 \uB418\uC5B4\uAC00?#$e#\uB0B4 \uC528\uC557 \uBA87 \uAC00\uC9C0\uBA74 \uC880 \uB2E4\uC591\uD55C \uC791\uBB3C\uC744 \uBCFC \uC218\uB3C4 \uC788\uC744 \uAC70\uC57C.$h",
  "fall_Sat": "\uB18D\uC7A5\uC5D0\uC11C \uD0A4\uC6B4 \uC791\uBB3C\uC740 \uC5B8\uC81C\uB77C\uB3C4 \uC0B4\uAC8C.#$e#\uADF8\uB798, \uAC00\uACA9\uC744 \uC880 \uBD99\uC5EC\uC11C \uB418\uD314\uAE34 \uD558\uC9C0\uB9CC... \uD655\uC2E4\uD788 \uC790\uB9AC \uC7A1\uC740 \uAC00\uAC8C \uC8FC\uC778\uC774 \uB204\uB9B4 \uC218 \uC788\uB294 \uD61C\uD0DD\uC774\uC9C0.#$e#\uC774\uC0C1\uD55C \uC0DD\uAC01\uD558\uC9C0 \uB9D0\uACE0...",
  "fall_Sun": "\uAC00\uAC8C \uC77C\uB9CC \uC544\uB2C8\uC5C8\uB2E4\uBA74 \uBC16\uC5D0 \uC788\uC744 \uD150\uB370...#$e#\uB2E8\uD48D\uB3C4 \uBA4B\uC9C0\uACE0 \uBC84\uC12F\uB3C4 \uC790\uB77C\uACE0 \uC788\uACE0.",
  "Event_naga1": "\uACE0\uB9C8\uC6CC. \uADF8\uB0E5 \uC774\uB7F0 \uAC78 \uBD24\uB2E4\uB294 \uC0AC\uC2E4\uC744 \uC78A\uC5B4\uC918, \uC54C\uC558\uC9C0?$h#$b#...\uADF8\uB7FC \uB098\uB3C4 \uB124\uAC00 \uB0B4 \uCE68\uC2E4\uC744 \uB9C8\uC74C\uB300\uB85C \uB46C\uC84C\uB2E4\uB294 \uAC83\uB3C4 \uC78A\uC744\uAC8C!",
  "Event_naga2": "\uC815\uB9D0 \uB098\uD55C\uD14C \uADF8\uB7F4 \uAC70\uC57C? \uD615\uD3B8\uC5C6\uB124.$s#$b#\uC560\uB2F9\uCD08 \uB0B4 \uCE68\uC2E4\uC744 \uAE30\uC6C3\uAC70\uB9AC\uC9C0 \uB9D0\uC558\uC5B4\uC57C\uC9C0! \uCC38\uACAC\uD558\uAE30 \uC88B\uC544\uD558\uB294 \uC774\uC6C3\uC740 \uC815\uB9D0 \uCD5C\uC545\uC774\uC57C.$3",
