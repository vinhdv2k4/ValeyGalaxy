{
  "Rainy_Day_0": "\uBE44\uAC00 \uC624\uBA74 \uB0A0\uBC8C\uB808\uB294 \uC5B4\uB514\uB85C \uAC00\uB294 \uAC78\uAE4C? \uBE57\uBC29\uC6B8\uC5D0 \uB9DE\uC9C0\uB294 \uC54A\uB098?",
  "Rainy_Day_1": "\uC774\uB7F0 \uB0A0\uC740 \uB300\uC790\uC5F0\uC774 \uB0B4\uB824\uC900 \uCD95\uBCF5\uC774\uC9C0.",
  "Rainy_Day_2": "\uC88B\uC740 \uC544\uCE68... \uB110 \uC704\uD55C \uC120\uBB3C\uC774 \uC788\uC5B4. \uAC71\uC815\uD558\uC9C4 \uB9C8, \uC138\uC774\uC9C0 \uD5A5\uC744 \uD53C\uC6CC\uC11C \uC815\uD654\uC2DC\uD0A8 \uAC70\uC57C. [428 440 444 338 207]",
  "Rainy_Day_3": "\uC575\uBB34\uC0C8\uB97C \uD480\uC5B4\uC904 \uC758\uB3C4\uC600\uB294\uB370, \uB0A0\uAC1C\uAC00 \uC644\uC804\uD788 \uB0AB\uC9C8 \uC54A\uC558\uC5B4. \uADF8\uB798\uB3C4 \uB9CC\uC871\uD558\uACE0 \uC788\uB294 \uAC83 \uAC19\uC544. \uB0B4\uAC00 \uAD00\uC2EC \uB9CE\uC774 \uC8FC\uAC70\uB4E0.#$e#\uB098\uD55C\uD14C \uC5EC\uAE30\uC11C \uC9C0\uB0B4\uB294 \uAC8C \uD589\uBCF5\uD558\uB2E4\uACE0 \uD588\uC5B4.",
  "Rainy_Day_4": "\uC598\uAE30\uD574\uC900 \uC801 \uC5C6\uC9C0\uB9CC... \uB124\uAC00 \uC5EC\uAE30 \uCC98\uC74C \uC774\uC0AC \uC654\uC744 \uB54C \uB124 \uAFC8\uC744 \uAFE8\uC5B4. \uADF8\uB54C \uC6B0\uB9AC \uC0B6\uC774 \uC5EE\uC77C \uAC70\uB780 \uAC78 \uBC14\uB85C \uC54C\uC558\uC9C0.$4",
  "Rainy_Night_0": "\uB9E4 \uC21C\uAC04\uC774 \uB3C5\uD2B9\uD558\uACE0 \uADC0\uC911\uD55C \uC544\uB984\uB2E4\uC6C0\uC744 \uAC00\uC9C0\uACE0 \uC788\uC5B4... \uD639\uC2DC \uC54C\uC544\uCC58\uC5B4? \uAC00\uB054\uC740 \uC78A\uAE30 \uC26C\uC6B4 \uAC83 \uAC19\uC544.",
  "patio_Emily": "\uB09C \uC5EC\uAE30\uC11C \uC544\uCE68 \uBA85\uC0C1\uC744 \uD558\uB294 \uAC8C \uC81C\uC77C \uC88B\uB354\uB77C.#$e#\uC774 \uC218\uC815 \uC815\uC6D0\uC758 \uC5D0\uB108\uC9C0\uAC00 \uB0B4 \uBAB8 \uC18D\uC73C\uB85C \uD750\uB974\uB294 \uAC83\uC744 \uB9C8\uC74C\uC18D\uC73C\uB85C \uADF8\uB824\uBCF4\uACE0 \uC788\uC5B4.",
  "Rainy_Night_1": "\uC2DD\uBB3C\uB4E4\uC774 \uC11C\uB85C \uC598\uAE30\uD558\uB294 \uAC8C \uB4E4\uB824... \uC624\uB298 \uBE44\uAC00 \uC640\uC11C \uD589\uBCF5\uD558\uB300!",
  "Rainy_Night_2": "\uC624\uB298 \uD558\uB8E8 \uC5B4\uB560\uC5B4, @? \uC880 \uCD95\uCD95\uD574 \uBCF4\uC778\uB2E4.",
  "Rainy_Night_3": "\uB098 \uC624\uB298 \uD558\uB8E8\uB294 \uD3C9\uD654\uB85C\uC6E0\uC5B4. \uB108\uB294 \uC5B4\uB560\uC5B4?",
  "Rainy_Night_4": "\uB514\uC800\uD2B8 \uC880 \uBA39\uC744\uB798? \uB0B4\uAC00 \uD2B9\uBCC4\uD788 \uB9CC\uB4E0 \uAC00\uACF5\uB418\uC9C0 \uC54A\uC740 \uC7AC\uB8CC\uB9CC \uC4F4, \uAE00\uB8E8\uD150 \uC5C6\uB294, \uC120\uC778\uC7A5 \uC2DC\uB7FD\uC73C\uB85C\uB9CC \uB2E8\uB9DB\uC744 \uB0B8 \uB514\uC800\uD2B8\uC57C.[232 234 223 220]$h",
  "Rainy_Night_5": "\uBE57\uC18C\uB9AC\uC5D0 \uD669\uD640\uD574\uC9C4 \uC801\uC774 \uC788\uB2C8?",
  "Indoor_Day_0": "%farm \uB18D\uC7A5\uC5D0\uC11C \uB610 \uC544\uB984\uB2E4\uC6B4 \uD558\uB8E8\uB97C \uBCF4\uB0BC \uC2DC\uAC04\uC774\uB124... \uC624\uB298 \uC88B\uC740 \uC77C\uC774 \uC788\uC744 \uAC83\uC774\uB77C\uACE0 \uBBFF\uC5B4!$h",
  "Indoor_Day_1": "\uC5EC\uAE30, \uC774\uAC70 \uAC00\uC838\uAC00. \uB108 \uC8FC\uB824\uB294 \uAC70\uC57C. [428 440 444 338 207 395 749]",
  "Indoor_Day_2": "\uC624, \uC7A0 \uC880 \uD479 \uC7A4\uB098 \uBCF4\uB124... \uC624\uB298 \uC544\uCE68 \uC0C1\uCF8C\uD574 \uBCF4\uC5EC.$h",
  "Indoor_Day_3": "\uC624\uB298 \uB098 \uBCC4\uC790\uB9AC \uC6B4\uC138\uAC00 \uBCC4\uB85C\uC57C... \uD558\uC9C0\uB9CC \uD56D\uC0C1 \uADF8\uB7AC\uB4EF \uCD5C\uC120\uC744 \uB2E4\uD574\uC57C\uC9C0. \uC77C\uD558\uB7EC \uAC00\uC790!",
  "Indoor_Day_4": "\uC5B4\uC73C... *\uAFB8\uB975*... \uC544\uCE68\uC73C\uB85C \uBC00\uAE30\uC6B8 \uBA38\uD540\uC744 \uB108\uBB34 \uB9CE\uC774 \uBA39\uC5C8\uC5B4.$s",
  "Indoor_Night_0": "\uC637\uC5D0 \uAD6C\uBA4D \uB09C \uAC70\uC57C? \uB0B4\uAC00 \uBC14\uB85C \uAE30\uC6CC\uC904\uAC8C.",
  "Indoor_Night_1": "\uC9D1\uC5D0 \uB3CC\uC544\uC628 \uAC78 \uD658\uC601\uD574, @. \uC624\uB298 \uBA4B\uC9C4 \uD558\uB8E8 \uBCF4\uB0C8\uC5B4?",
  "Indoor_Night_2": "\uBC8C\uC368 \uC798 \uC2DC\uAC04\uC774\uC57C? \uC5B4\uBA38, \uB0B4 \uD558\uB8E8\uAC00 \uB610 \uC774\uB807\uAC8C \uB5A0\uD758\uB7EC\uAC14\uB124.$u",
  "Indoor_Night_3": "\uC544, \uADF8 \uD5A5! \uC774\uAC74 \uBD84\uBA85 \uB124 \uD5A5\uAE30\uC57C.$h#$e#\uC88B\uC740 \uB0C4\uC0C8\uC57C.",
  "Indoor_Night_4": "\uC624\uB298 \uC9D1 \uB2E4 \uC4F8\uACE0, \uCC3D\uBB38 \uB2E6\uACE0, \uBA3C\uC9C0 \uD138\uACE0, \uB0C9\uC7A5\uACE0 \uCCAD\uC18C\uB3C4 \uD588\uC5B4. \uC544\uC8FC \uC0DD\uC0B0\uC801\uC778 \uD558\uB8E8\uC600\uC5B4!",
  "Outdoor_0": "\uC77C\uCC0D \uC77C\uC5B4\uB098\uB294 \uAC70 \uB108\uBB34 \uC88B\uC544. \uACF5\uAE30\uAC00 \uD2B9\uD788 \uB354 \uC0C1\uCF8C\uD558\uACE0 \uC57C\uC0DD\uB3D9\uBB3C\uB4E4\uB3C4 \uB354 \uD65C\uBC1C\uD55C \uC2DC\uAC04\uC774\uC57C.",
  "Outdoor_1": "\uC5EC\uBCF4, \uC624\uB298 \uC6B0\uB9AC \uD560 \uC77C\uC774 \uBB50\uC9C0?",
  "Outdoor_2": "\uC624\uC624! \uC624! \uD558\uB098 \uB354 \uBD24\uC5B4!$h#$e#\uB2E4\uB78C\uC950 \uC138\uACE0 \uC788\uC5B4.",
  "Outdoor_3": "\uD587\uBE5B\uC740 \uAC74\uAC15\uC5D0 \uC88B\uC9C0. \uADF8\uB807\uB2E4\uACE0 \uB108\uBB34 \uD0C0\uC9C4 \uB9D0\uACE0, \uC54C\uC558\uC9C0?",
  "Outdoor_4": "\uC88B\uC740 \uC544\uCE68\uC774\uC57C! \uB124\uAC00 \uC5B8\uC81C\uCBE4 \uCE68\uB300\uC5D0\uC11C \uB098\uC624\uB824\uB098 \uAD81\uAE08\uD574\uD558\uACE0 \uC788\uC5C8\uB294\uB370!$h#$e#\uAD1C\uCC2E\uC544, @... \uBC24\uC5D0\uB294 \uD479 \uC790\uC57C\uC9C0.",
  "OneKid_0": "%kid1(\uC774)\uAC00 \uB2E4\uC815\uD558\uACE0 \uBC30\uB824\uD560 \uC904 \uC544\uB294 \uC0AC\uB78C\uC774 \uB418\uC5C8\uC73C\uBA74 \uC88B\uACA0\uC5B4. \uD559\uAD50\uC5D0\uC11C \uC131\uC801\uC744 \uC798 \uBC1B\uB294 \uAC83\uBCF4\uB2E4 \uC911\uC694\uD574.",
  "OneKid_1": "\uC544\uC774 \uD55C \uBA85\uC774\uBA74 \uCDA9\uBD84\uD560\uAE4C, \uC544\uB2C8\uBA74 \uD55C \uBA85 \uB354 \uC788\uC73C\uBA74 \uC88B\uC744\uAE4C?#$e#\uC77C\uB2E8\uC740 \uC6B4\uBA85\uC774 \uC6B0\uB9AC\uB97C \uC5B4\uB514\uB85C \uC774\uB044\uB294\uC9C0 \uBD10\uC57C\uACA0\uC9C0.",
  "OneKid_3": "\uCC3D\uBC31\uD55C \uB179\uC0C9\uC744 \uCF1C\uACE0 %kid1(\uC774) \uBA38\uB9AC \uC704\uC5D0 \uC5B4\uB9B0 \uBBFC\uD2B8 \uC78E\uC744 \uD754\uB4E4\uC5C8\uC5B4. \uC774\uB7EC\uBA74 \uC704\uD5D8\uD55C \uC720\uB839\uC740 \uB9C9\uC544\uC904 \uAC70\uC57C.",
  "TwoKids_1": "\uD070 \uC9D1, \uC544\uC774 \uB458, \uC575\uBB34\uC0C8... \uBC14\uC060 \uC77C\uB85C \uAC00\uB4DD\uD558\uB124!",
  "TwoKids_2": "\uC624, %kid2(\uC774) \uBA38\uB9AC\uAC00 \uD655\uC2E4\uD788 \uB2F9\uC2E0 \uB2EE\uC558\uB124...$u",
  "TwoKids_3": "\uC544, \uC544\uC774\uB4E4\uD55C\uD14C \uBC8C\uC368 \uC5FC\uC18C\uC816\uC774\uB791 \uD034\uB178\uC544 \uC528\uB9AC\uC5BC \uC92C\uC5B4. \uC790\uAE30\uB294 \uB18D\uC7A5 \uC77C\uC5D0 \uC9D1\uC911\uD574\uB3C4 \uB3FC!",
  "Good_1": "\uAC19\uC774 \uC0AC\uB294 \uAC70 \uB108\uBB34 \uC7AC\uBC0C\uC5B4! \uB098 \uD3C9\uC0DD \uD63C\uC790\uC77C \uAC70\uB77C \uC0DD\uAC01\uD588\uB294\uB370.",
  "Good_2": "\uC6B0\uB9AC \uD568\uAED8\uD560 \uC6B4\uBA85\uC774\uC5C8\uC5B4... \uB0B4 \uC628 \uB9C8\uC74C\uC744 \uB2E4\uD574 \uBBFF\uC5B4!",
  "Good_3": "\uB098\uC640 \uD568\uAED8 \uD574\uC918\uC11C \uACE0\uB9C8\uC6CC. \uB098 \uB0B4 \uC0C8 \uC0B6\uC774 \uB108\uBB34 \uC0AC\uB791\uC2A4\uB7EC\uC6CC.$4",
  "Good_4": "\uC6B0\uB9AC\uC758 \uC9C4\uB3D9 \uC5D0\uB108\uC9C0\uAC00 \uC644\uBCBD\uD788 \uC870\uD654\uAC00 \uB9DE\uC544. \uB290\uAEF4\uC838?",
  "Good_5": "\uC6B0\uB9AC \uACB0\uD63C \uD39C\uB358\uD2B8 \uAC10\uC0C1\uD558\uACE0 \uC788\uC5C8\uC5B4... \uC815\uB9D0 \uC544\uB984\uB2E4\uC6CC! \uC21C\uC218\uD55C \uD478\uB978 \uC5D0\uB108\uC9C0\uAC00 \uBC1C\uC0B0\uB418\uB294 \uAC8C \uB290\uAEF4\uC838.$l",
  "Good_6": "\uC5B4\uC82F\uBC24\uC5D0 \uC6B0\uB9AC\uAC00 \uB098\uC624\uB294 \uAFC8\uC744 \uAFE8\uC5B4. \uC6B0\uB9AC\uAC00 \uC218\uC815\uC73C\uB85C \uB41C \uB098\uBB34\uC5D0 \uC62C\uB77C\uAC00\uC11C, \uADF8 \uBB34\uC5C7\uBCF4\uB2E4 \uC6B0\uAC70\uC9C0\uACE0 \uC544\uB984\uB2E4\uC6B4 \uCD08\uC6D0\uC744 \uBC14\uB77C\uBCF4\uACE0 \uC788\uC5C8\uC5B4. \uC694\uC998 \uACC4\uC18D \uC774 \uAFC8\uC744 \uAFD4.#$e#\uBB34\uC2A8 \uC758\uBBF8\uC778\uC9C0\uB294 \uBAA8\uB974\uACA0\uC9C0\uB9CC, \uC88B\uC740 \uC9D5\uC870\uB77C\uB294 \uAE30\uBD84\uC774 \uB4E4\uC5B4.",
  "Neutral_0": "\uB0B4\uAC00 \uB299\uACE0 \uBA38\uB9AC\uC0C9\uC774 \uCE59\uCE59\uD558\uAC8C \uBC14\uB79C \uCCA0\uC0C9\uC774 \uB418\uC5B4\uB3C4 \uB0A0 \uC88B\uC544\uD558\uAE38 \uBC14\uB77C.",
  "Neutral_8": "\uC624\uB298 \uB3D9\uAE30\uBD80\uC5EC\uAC00 \uC548\uB418\uB124.$s",
  "funLeave_Emily": "\uC624\uB298 \uB9C8\uC744\uC5D0 \uAC14\uB2E4\uAC00, \uB098\uC911\uC5D4 \uC8FC\uC810 \uC77C \uB3C4\uC640\uC8FC\uB824\uACE0. \uBC24\uC5D0 \uBCFC\uAC8C.",
  "funReturn_Emily": "\uC624\uB298 \uD558\uB8E8 \uC798 \uBCF4\uB0C8\uC5B4... \uB54C\uB54C\uB85C \uC9D1\uC744 \uB098\uC11C\uB294 \uAC83\uB3C4 \uC88B\uC9C0.",
  "spring_2": "\uB0B4 \uCE5C\uAD6C\uB4E4, \uC2DD\uBB3C\uB4E4\uC774, \uB2E4\uC2DC \uC0B4\uC544\uB0AC\uC5B4. \uB9CC\uC871\uC2A4\uB7EC\uC6CC.",
  "spring_1": "\uC0C8\uB85C\uC6B4 \uD55C \uD574\uC758 \uC2DC\uC791\uC774\uC57C, \uC5EC\uBCF4. \uC62C\uD574\uB97C \uD2B9\uBCC4\uD55C \uD574\uB85C \uB9CC\uB4E4\uC790.$4",
  "spring_22": "\uD760... \uC624\uB298 \uCC44\uC9D1\uD55C \uC2E0\uC120\uD55C \uC57C\uCC44\uB85C \uC0D0\uB7EC\uB4DC \uB9CC\uB4E4\uC5B4\uC11C \uC800\uB141\uC73C\uB85C \uBA39\uC744\uAE4C \uC0DD\uAC01 \uC911\uC774\uC57C.",
  "summer_20": "\uACC4\uC808\uCC98\uB7FC \uC6B0\uB9AC \uBAB8 \uC548\uC758 \uC5D0\uB108\uC9C0\uB3C4 \uBCC0\uB3D9\uC774 \uC788\uC5B4. \uB0B4\uBA74\uC758 \uD654\uD569\uC744 \uC774\uB8E8\uB824\uBA74 \uC790\uC2E0\uB9CC\uC758 \uB9AC\uB4EC\uC744 \uC774\uD574\uD558\uB294 \uAC8C \uC911\uC694\uD574.",
  "summer_2": "\uC624\uB298 \uAC19\uC774 \uC0AC\uB791\uC2A4\uB7EC\uC6B4 \uB0A0\uC5D0 \uC694\uBC14\uC758 \uCD95\uBCF5\uC774 \uC788\uAE30\uB97C.$7",
  "fall_1": "\uC62C\uD574\uAC00 \uBC8C\uC368 \uBC18\uC774 \uC9C0\uB0AC\uC5B4. \uBBFF\uC5B4\uC838?",
  "fall_25": "\uC6B0\uB9AC \uBAB8\uC740 \uC790\uC5F0\uC2A4\uB7FD\uAC8C \uACC4\uC808\uC5D0 \uC870\uC728\uB418\uC5B4 \uC788\uC5B4. \uAC00\uC744\uC758 \uBE5B\uACFC \uC0C9\uC774 \uD669\uB7C9\uD55C \uACA8\uC6B8\uC744 \uC900\uBE44\uD558\uAC8C \uB9CC\uB4E4\uC9C0.#$e#\uC6B0\uB9AC \uC870\uC0C1\uB4E4\uC740 \uC774 \uB290\uB08C\uC744 \uC628 \uC138\uC0C1\uC744 \uD1B5\uD574 \uB290\uB07C\uACE0 \uD544\uC218\uC801\uC774\uC5C8\uC5B4. \uC6B0\uB9AC\uB294 \uD604\uB300 \uC0DD\uD65C\uC758 \uC18C\uC74C \uB54C\uBB38\uC5D0 \uACA8\uC6B0 \uC54C\uC544\uCC28\uB9B4 \uC218 \uC788\uACE0.",
  "winter_15": "\uC624\uB298 \uAC19\uC740 \uB0A0\uC5D0\uB294 \uC2DC\uB098\uBAAC, \uB11B\uBA54\uADF8, \uD074\uB85C\uBE0C\uB791 \uCE74\uB974\uB2E4\uBAB8\uC774 \uBA39\uACE0\uC2F6\uC5B4.",
  "winter_5": "*\uD55C\uC228*... \uC65C \uC138\uC0C1\uC5D4 \uC804\uC7C1\uACFC \uC99D\uC624\uAC00 \uC788\uC5B4\uC57C \uD558\uB294 \uAC78\uAE4C?$s",
  "winter_2": "\uC800 \uBC16\uC5D0 \uC788\uC744 \uBD88\uC30D\uD55C, \uAF41\uAF41 \uC5BC\uC5B4\uC788\uC744 \uB2E4\uB78C\uC950\uB4E4\uC774 \uC790\uAFB8 \uC0DD\uAC01\uB098.$s",
  "spring_Emily": "@, \uD55C\uD574 \uB354 \uB18D\uC0AC\uC9C0\uC744 \uC0DD\uAC01\uD558\uB2C8 \uC2E0\uB098!$h",
