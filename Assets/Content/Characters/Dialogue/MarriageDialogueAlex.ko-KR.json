{
  "Rainy_Day_0": "\uACF5\uAC04\uC774 \uC6CC\uB099 \uB9CE\uC544\uC11C, \uC628\uBAB8\uC758 \uADFC\uC721\uC744 \uB2E4 \uC6B4\uB3D9\uD560 \uC218 \uC788\uC5B4.",
  "Rainy_Day_1": "\uC0AC\uC2E4 \uB098 \uC8FC\uBBFC\uB4E4 \uC911\uC5D0 \uCE5C\uAD6C\uAC00 \uB9CE\uC774 \uC5C6\uC5B4... \uB124\uAC00 \uC5EC\uAE30 \uC774\uC0AC \uC624\uC9C0 \uC54A\uC558\uB2E4\uBA74 \uC5B4\uB5BB\uAC8C \uB418\uC5C8\uC744\uAE4C \uBAA8\uB974\uACA0\uC5B4.$9",
  "Rainy_Day_2": "\uC544... \uBC16\uC5D0\uC11C \uC870\uAE45 \uC880 \uD558\uB824\uACE0 \uD588\uB294\uB370. \uB0A0\uC528\uAC00 \uC774\uB7EC\uBA74 \uC5B4\uCA54 \uC218 \uC5C6\uC9C0.",
  "Rainy_Day_3": "*\uAD81\uC2DC\uB801*... \uBC29\uAE08 \uC77C\uC5B4\uB0AC\uB294\uB370 \uB2E8\uBC31\uC9C8 \uC880 \uBA39\uC5B4\uC57C\uACA0\uC5B4.$9",
  "Rainy_Day_4": "\uB098 \uCC45 \uC880 \uC77D\uC73C\uB824\uACE0. \uACB0\uD63C\uD588\uB2E4\uACE0 \uD574\uC11C \uCE68\uCCB4\uB418\uBA74 \uC548 \uB418\uC9C0!",
  "patio_Alex": "\uC73C\uC73C... \uD558\uB098... \uC73C\uC73C\uC73C... \uB458... \uBC16\uC5D0\uC11C \uC6E8\uC774\uD2B8 \uD558\uB294 \uAC70 \uAE30\uBD84 \uCD5C\uACE0\uC57C!$6",
  "Rainy_Night_0": "\uC624\uB298 \uD558\uB8E8 \uAD1C\uCC2E\uC558\uC5B4? \uB0B4\uC77C\uC740 \uD6E8\uC52C \uB354 \uC88B\uC744 \uAC70\uC57C.$h",
  "Rainy_Night_1": "\uC694\uC998 \uC880 \uC5B4\uB54C? \uC624\uB298 \uB09C \uC885\uC77C \uB0A1\uC740 \uADF8\uB9AC\uB4DC\uBCFC\uC744 \uB4E4\uACE0 \uB2E4\uB154\uC5B4. \uCC99\uC774\uB77C\uB3C4 \uD558\uB824\uACE0...$u",
  "Rainy_Night_2": "\uC624... \uB0C4\uC0C8 \uB9D0\uC774\uC57C? \uB098 \uD558\uB8E8 \uC885\uC77C \uB9C8\uB298 \uBA39\uC5C8\uC5B4. \uB0A8\uC790\uB2E4\uC6C0\uC744 \uC720\uC9C0\uD558\uB824\uACE0... \uBBF8\uC548.$l",
  "Rainy_Night_3": "\uB354\uC2A4\uD2F0\uD55C\uD14C \uC8FC\uB824\uACE0 \uC74C\uC2DD \uC880 \uC77C\uBD80\uB7EC \uB0A8\uAE30\uACE0 \uC788\uC5C8\uC5B4. \uAC00\uB054 \uAC04\uC2DD\uB3C4 \uC8FC\uACE0 \uD574\uC57C\uC9C0.",
  "Rainy_Night_4": "\uB098 \uBC30\uACE0\uD30C\uC11C \uC800\uB141 \uBA3C\uC800 \uCC28\uB838\uC5B4. \uC5EC\uAE30, \uC790\uAE30 \uAC83\uB3C4 \uB9CC\uB4E4\uC5C8\uC5B4. [241 242 225 214 198]$h",
  "Indoor_Day_0": "\uC544... \uC5ED\uC2DC \uB0B4 \uB0A8\uD3B8 \uC606\uC5D0\uC11C \uD558\uB8FB\uBC24 \uD479 \uC790\uB294 \uAC83\uB9CC \uD55C\uAC8C \uC5C6\uC9C0!$h^\uC544... \uC5ED\uC2DC \uB0B4 \uC544\uB0B4 \uC606\uC5D0\uC11C \uD558\uB8FB\uBC24 \uD479 \uC790\uB294 \uAC83\uB9CC \uD55C\uAC8C \uC5C6\uC9C0!$h",
  "Indoor_Day_1": "\uC5B4, \uC5EC\uBCF4! \uC544\uCE68\uC2DD\uC0AC \uAC13 \uB9CC\uB4E4\uC5C8\uC5B4.[195 210 211]#$e#\uAC15\uD574\uC9C0\uACE0 \uC2F6\uC73C\uBA74, \uAC15\uD574\uC9C0\uACE0 \uC2F6\uC740 \uB9CC\uD07C \uBA39\uC5B4\uC57C \uD574!",
  "Indoor_Day_2": "\uC774\uB9AC \uC640\uBD10. *\uAF48\uC545*... \uC73C\uD760. \uB18D\uC7A5\uC77C \uD574\uC11C \uD0C4\uD0C4\uD574\uC9C0\uACE0 \uC788\uB124.",
  "Indoor_Day_3": "\uC544\uC9C1 \uC694\uB9AC\uD558\uACE0 \uBE68\uB798\uD558\uB294 \uAC74 \uC775\uC219\uD574\uC9C0\uACE0 \uC788\uC5B4... \uB0B4\uAC00 \uC88B\uC544\uD558\uB294 \uAC74 \uC544\uB2C8\uC9C0\uB9CC, \uACB0\uD63C\uD560 \uB54C \uC774\uB7F0 \uAC8C \uD544\uC694\uD558\uB2E4\uB294 \uAC83\uC744 \uC54C\uACE0 \uC788\uC5C8\uC73C\uB2C8\uAE4C.$h",
  "Indoor_Day_4": "\uC624\uB298 \uC9D1\uC5D0 \uD55C\uB450 \uAC00\uC9C0 \uACE0\uCCD0\uBCF4\uB824\uB294 \uAC8C \uC788\uC5B4. \uB09C \uAC71\uC815\uD558\uC9C0 \uB9C8, \uC2EC\uC2EC\uD558\uB2E4\uAC70\uB098 \uADF8\uB7EC\uC9C4 \uC54A\uC73C\uB2C8\uAE4C.",
  "Indoor_Night_0": "\uD55C\uACC4\uCE58\uAE4C\uC9C0 \uCD5C\uB300\uD55C \uB178\uB825\uD558\uB294 \uAC74 \uAE30\uBD84 \uC88B\uC9C0, \uC548 \uADF8\uB798? \uBC24\uC5D0 \uBD80\uB4DC\uB7EC\uC6B4 \uCE68\uB300\uC5D0 \uB204\uC6B8 \uAD8C\uB9AC\uB97C \uC5BB\uC5B4\uB0B8 \uAC83 \uAC19\uAC70\uB4E0.",
  "Indoor_Night_1": "\uD639\uC2DC \uBA38\uB9AC \uC798\uB790\uC5B4? \uC624\uB298 \uB9CE\uC774 \uAD1C\uCC2E\uC544 \uBCF4\uC774\uB124. \uC2E0\uC120\uD55C \uACF5\uAE30\uC758 \uC601\uD5A5\uC778\uAC00...$l",
  "Indoor_Night_2": "\uC624\uB298 \uD558\uB8E8 \uC5B4\uB560\uB294\uC9C0 \uC598\uAE30\uD574\uC918. \uC885\uC885 \uD130\uB193\uACE0 \uC598\uAE30\uD558\uB294 \uAC74 \uC88B\uC740 \uAC70\uC9C0.",
  "Indoor_Night_3": "\uC57C... \uB098 \uBC18\uBC14\uC9C0 \uC0C8\uB85C \uC0C0\uC5B4. \uC54C\uACE0 \uC2F6\uC5B4 \uD560\uAE4C \uBD10 \uC598\uAE30\uD574\uC8FC\uB294 \uAC70\uC57C...$l",
  "Indoor_Night_4": "\uD639\uC2DC \uD63C\uC790 \uC870\uC6A9\uD788 \uC788\uC744 \uC2DC\uAC04\uC774 \uD544\uC694\uD558\uB2E4\uBA74, \uB9D0\uB9CC \uD574.",
  "Outdoor_0": "\uC788\uC9C0. \uC5EC\uAE30 \uC11C\uC11C \uC6B0\uB9AC \uB18D\uC7A5\uC744 \uB458\uB7EC\uBCF4\uACE0 \uC788\uC73C\uBA74... \uC815\uB9D0 \uC790\uB791\uC2A4\uB7EC\uC6CC. \uC815\uB9D0 \uC798\uD588\uC5B4.",
  "Outdoor_1": "\uC5EC\uAE34 \uC544\uC774\uAC00 \uD06C\uAE30\uC5D0 \uC815\uB9D0 \uC88B\uC740 \uC7A5\uC18C\uC57C. \uB098\uB3C4 \uC774\uB7F0 \uACF3\uC5D0\uC11C \uC790\uB790\uC73C\uBA74 \uC815\uB9D0 \uB9C8\uC74C\uC5D0 \uB4E4\uC5B4 \uD588\uC744 \uAC70\uC57C. \uB6F0\uC5B4\uB2E4\uB2D0 \uACF5\uAC04\uC774 \uC774\uB807\uAC8C\uB098 \uB9CE\uC544!",
  "Outdoor_2": "\uB09C \uCD5C\uB300\uD55C \uB9CE\uC740 \uC2DC\uAC04\uC744 \uBC16\uC5D0\uC11C \uBCF4\uB0B4\uACE0 \uC2F6\uC5B4. \uADF8\uB0E5 \uBC16\uC5D0 \uB098\uC640\uC788\uB294 \uAC8C \uAE30\uBD84\uC774 \uB354 \uC88B\uC544.",
  "Outdoor_3": "\uC6B0\uB9AC \uBD10\uBD10, \uC791\uC740 \uB18D\uC7A5\uC5D0. \uC6B0\uB9AC \uC9C4\uC9DC \uADC0\uC5EC\uC6B4 \uCEE4\uD50C\uC774\uC9C0.$h^\uC788\uC9C0. \uD587\uBE5B\uC774 \uD669\uAE08\uBE5B\uC774\uB77C \uADF8\uB7F0 \uAC74\uC9C0 \uBAA8\uB974\uACA0\uB294\uB370, \uC624\uB298 \uC815\uB9D0 \uC544\uB984\uB2E4\uC6CC \uBCF4\uC5EC.$l",
  "Outdoor_4": "\uC544... \uBC16\uC5D0 \uB098\uC640\uC788\uC73C\uB2C8 \uC815\uB9D0 \uC88B\uB2E4. \uC2A4\uD0C0\uB4C0 \uBC38\uB9AC\uB294 \uC815\uB9D0 \uC544\uB984\uB2E4\uC6B4 \uACF3\uC774\uC57C...",
  "OneKid_0": "\uB098 \uC544\uC9C1\uC740 \uC9D1\uC5D0\uC11C \uBA38\uBB34\uB294 \uC544\uBE60\uB85C\uC11C\uC758 \uC5ED\uD560\uC5D0 \uC775\uC219\uD574\uC9C0\uACE0 \uC788\uB294 \uAC83 \uAC19\uC544.$h",
  "OneKid_1": "\uC6B0\uB9AC \uC791\uC740 %kid1, \uC798 \uD06C\uACE0 \uC788\uC5B4, \uC544\uBE60\uCC98\uB7FC \uAC15\uD558\uAC8C.",
  "OneKid_3": "\uC784\uC2E0\uD558\uB294 \uAC74 \uC5B4\uB5A4 \uAE30\uBD84\uC77C\uAE4C...?$h",
  "TwoKids_2": "\uD639\uC2DC %kid2(\uC774)\uAC00 \uD3A0\uB9AC\uCEE8 \uB9C8\uC744 \uCD9C\uC2E0\uC758 \uCCAB \uADF8\uB9AC\uB4DC\uBCFC \uC120\uC218\uAC00 \uB420\uAE4C?$h",
  "TwoKids_3": "\uB4DC\uB514\uC5B4 \uB0B4\uAC00 \uC5B4\uB824\uC11C \uACBD\uD5D8\uD558\uC9C0 \uBABB\uD55C \uAC00\uC871\uB2E4\uC6B4 \uC0B6\uC744 \uB290\uAEF4\uBCFC \uC218 \uC788\uC5B4... \uACE0\uB9C8\uC6CC.$l",
  "Good_0": "@... \uC5B8\uC81C\uAE4C\uC9C0\uB098 \uB110 \uC0AC\uB791\uD560 \uAC70\uC57C.$l",
  "Good_1": "\uB108 \uBB34\uCC99 \uC798\uC0DD\uACBC\uC5B4... \uB0B4\uAC00 \uC598\uAE30\uD574\uC900 \uC801 \uC788\uC5C8\uB098?$l^\uB108 \uC815\uB9D0 \uC544\uB984\uB2E4\uC6CC... \uB0B4\uAC00 \uC598\uAE30\uD574\uC900 \uC801 \uC788\uC5C8\uB098?$l",
  "Good_6": "\uB124\uAC00 \uAC15\uD558\uB2E4\uB294 \uAC74 \uC54C\uC9C0\uB9CC, \uAC00\uB054 \uB124\uAC00 \uC2AC\uB77C\uC784\uC5D0 \uC7A1\uC544\uBA39\uD788\uAC70\uB098... \uB354 \uB054\uCC0D\uD55C \uC77C\uC774 \uC788\uC744\uAE4C \uBD10 \uAC71\uC815\uB3FC. \uC870\uC2EC\uD574, \uC54C\uC558\uC9C0?$9",
  "funLeave_Alex": "\uB098 \uC624\uB298\uC740 \uB9C8\uC744\uC5D0 \uC880 \uAC14\uB2E4 \uC62C\uAC8C. \uB098\uC911\uC5D0 \uC800\uB141\uC5D0 \uBD10.",
  "funReturn_Alex": "\uC624\uB298 \uAD1C\uCC2E\uC740 \uD558\uB8E8\uB97C \uBCF4\uB0C8\uC5B4. \uD560\uBA38\uB2C8 \uD560\uC544\uBC84\uC9C0 \uC880 \uB354 \uC790\uC8FC \uBD10\uC57C\uACA0\uC5B4, \uB098\uC774\uB3C4 \uC810\uC810 \uB4DC\uC2DC\uB2C8.",
  "spring_1": "\uB4DC\uB514\uC5B4 \uB208\uC774 \uB179\uACE0 \uD574\uAC00 \uD658\uD558\uAC8C \uB5B4\uC5B4! \uCEE8\uB514\uC158 \uCD5C\uACE0\uC57C.$h",
  "spring_6": "\uBCC4\uBC29\uC6B8 \uAC00\uB8E8\uAC00 \uBC8C\uD06C\uC5C5 \uD558\uB294\uB370 \uB3C4\uC6C0\uC774 \uB418\uB824\uB098...",
  "spring_12": "\uB0B4\uC77C \uCD95\uC81C \uAE30\uB300\uD558\uACE0 \uC788\uC5B4? \uACF5\uC9DC\uB85C \uB2EC\uAC40 \uBC1B\uC544\uC624\uAE30\uC5D4 \uC88B\uACA0\uB2E4.",
  "spring_23": "\uC624... \uB0B4\uC77C \uBD04\uAF43 \uBB34\uB3C4\uD68C\uC9C0? \uC624\uB298 \uBC24\uC5D4 \uD314\uAD7D\uD600 \uD3B4\uAE30 \uC880 \uB354 \uD574\uC57C\uACA0\uB2E4.$9#$e#\uC637\uC774 \uC880 \uBD99\uB294 \uD3B8\uC774\uB77C... \uAC8C\uB2E4\uAC00 \uB2E4\uB4E4 \uC720\uC2EC\uD788 \uAD6C\uACBD\uD558\uACE0 \uC788\uC744 \uD14C\uACE0.",
  "summer_1": "\uC5EC\uB984\uC740 \uC77C \uB144 \uC911 \uC815\uB9D0 \uD65C\uB825 \uB118\uCE58\uB294 \uC2DC\uAE30\uC57C, \uBAB8\uC5D0\uC11C \uB290\uAEF4\uC838! \uB2E8\uB2E8\uD55C \uAE30\uBD84\uC774\uC57C.",
  "summer_10": "\uB0B4\uC77C \uB8E8\uC544\uC6B0 \uC2A4\uD504\uC5D0 \uBB58 \uB123\uC744\uC9C0 \uC0DD\uAC01\uD574\uBD24\uC5B4?#$e#\uB09C \uBB50\uAC00 \uC88B\uC740\uC9C0 \uC798 \uBAA8\uB974\uACA0\uC5B4... \uC5EC\uBCF4\uAC00 \uC694\uB9AC\uC0AC\uB2C8\uAE4C!$h",
  "summer_27": "\uC544... \uC5EC\uB984 \uAC70\uC758 \uB05D\uB0AC\uB124. \uADFC\uC721\uC774 \uC624\uBBC0\uB77C\uB4E0\uB2E4...$s",
  "fall_1": "\uBB50, \uC5EC\uB984\uC740 \uB05D\uB0AC\uC9C0\uB9CC... \uAE0D\uC815\uC801\uC778 \uD0DC\uB3C4\uB97C \uC720\uC9C0\uD558\uACA0\uC5B4. \uB530\uB73B\uD55C \uACC4\uC808\uC740 \uD56D\uC0C1 \uB3CC\uC544\uC624\uB2C8\uAE4C.",
  "fall_15": "\uB0B4\uC77C \uCD95\uC81C\uC778\uB370, \uC6B0\uB9AC \uAC00\uB294 \uAC70\uC57C?#$e#\uC0AC\uC2E4 \uC774\uB7EC\uB098\uC800\uB7EC\uB098 \uB09C \uAD1C\uCC2E\uC544.",
  "fall_26": "\uD560\uBA38\uB2C8 \uD560\uC544\uBC84\uC9C0 \uC798 \uACC4\uC2DC\uB098 \uAD81\uAE08\uD558\uB124. \uD560\uC544\uBC84\uC9C0\uAC00 \uC880 \uAD6C\uB450\uC1E0 \uC154\uC11C \uB9C8\uC9C0\uB9C9 \uC21C\uAC04\uAE4C\uC9C0 \uB09C\uBC29\uC744 \uC548 \uD2B8\uC154.",
  "winter_1": "\uC62C\uACA8\uC6B8 \uAF2D \uB530\uB73B\uD558\uAC8C \uC9C0\uB0B4\uACE0. \uB124 \uC5F0\uC57D\uD55C \uD53C\uBD80\uAC00 \uAC71\uC815\uC774\uC57C.",
  "winter_7": "\uB0B4\uC77C \uB09A\uC2DC \uB300\uD68C \uCC38\uAC00\uD560 \uAC70\uC57C? \uB108\uB77C\uBA74 \uC774\uAE38 \uC218 \uC788\uC744 \uAC70\uC57C!",
  "winter_28": "\uC62C\uD574 \uC815\uB9D0 \uC88B\uC740 \uD55C \uD574\uC600\uC5B4, @. \uB0B4\uB144\uB3C4 \uAE30\uB300\uB418\uB294\uAC78! \uC790, \uC774\uC81C \uAC00\uAE4C\uC774 \uC640\uBD10... $l"
}