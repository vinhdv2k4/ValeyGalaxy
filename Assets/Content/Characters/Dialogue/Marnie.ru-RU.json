  "GreenRain": "\u0422\u044B \u043D\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0435\u0448\u044C \u043D\u0430\u0441\u0447\u0435\u0442 \u0434\u043E\u0436\u0434\u044F? \u041C\u043D\u0435 \u043E\u0442 \u044D\u0442\u043E\u0433\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043B\u0435\u0433\u0447\u0435...#$e#\u041F\u0440\u043E\u0441\u0442\u043E \u043D\u0430\u0434\u0435\u044E\u0441\u044C, \u0447\u0442\u043E \u043A\u043E\u0440\u043E\u0432\u044B \u0437\u0430\u0448\u043B\u0438 \u0432 \u0445\u043B\u0435\u0432...$s",
  "GreenRainFinished": "\u0427\u0442\u043E \u0436, \u043F\u043E\u0445\u043E\u0436\u0435, \u043C\u044B \u0432\u0441\u0435 \u043F\u0435\u0440\u0435\u043F\u0443\u0433\u0430\u043B\u0438\u0441\u044C \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0430\u043A... \u0414\u043E\u0436\u0434\u044C \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u0432\u043E\u043E\u0431\u0449\u0435 \u043D\u0435 \u043E\u043F\u0430\u0441\u043D\u044B\u043C!",
  "GreenRain_2": "\u041F\u043E\u0445\u043E\u0436\u0435, \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u043C \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u044D\u0442\u043E\u0442 \u0434\u043E\u0436\u0434\u044C... \u0414\u0443\u043C\u0430\u044E, \u043E\u0442 \u043D\u0435\u0433\u043E \u0442\u0440\u0430\u0432\u0430 \u0441\u0442\u0430\u043B\u0430 \u0431\u043E\u043B\u0435\u0435 \u043F\u0438\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439.",
  "Wed": "\u041A\u043E\u0441\u043E\u0439 \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u043A\u043E\u0441\u0438\u0442\u044C \u0441\u0435\u043D\u0430 \u043D\u0430 \u043A\u043E\u0440\u043C \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u043C.#$e#\u041D\u0443, \u0438\u043B\u0438 \u043C\u043E\u0436\u0435\u0448\u044C \u043A\u0443\u043F\u0438\u0442\u044C \u0441\u0435\u043D\u043E \u0443 \u043C\u0435\u043D\u044F, \u043A\u043E\u043D\u0435\u0447\u043D\u043E!$h#$e#\u0414\u0435\u043D\u044C\u0433\u0438 \u043C\u043D\u0435 \u043F\u0440\u0438\u0433\u043E\u0434\u044F\u0442\u0441\u044F...$u#$e#\u0410\u0434\u0438\u043E\u0441.",
  "Thu": "\u041F\u0440\u0438\u0432\u0435\u0442. \u0427\u0442\u043E-\u0442\u043E \u043D\u0443\u0436\u043D\u043E?#$e#\u041C\u043E\u0436\u0435\u0442, \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043C \u044F \u0437\u0430\u0432\u0435\u0434\u0443 \u043D\u043E\u0432\u044B\u0445 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445.#$e#\u041F\u0440\u0430\u0432\u0434\u0430, \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0443\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442 \u0443\u0431\u0435\u0434\u0438\u0442\u044C\u0441\u044F, \u0447\u0442\u043E \u043D\u0430 \u043D\u0438\u0445 \u0435\u0441\u0442\u044C \u0441\u043F\u0440\u043E\u0441, \u0442\u0430\u043A \u0447\u0442\u043E \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F \u0442\u0435\u0431\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C, \u043A\u0430\u043A\u043E\u0439 \u0438\u0437 \u0442\u0435\u0431\u044F \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0432\u043E\u0434.#$e#\u041F\u0440\u043E\u0441\u0442\u043E \u0443\u0432\u0430\u0436\u0430\u0439 \u0436\u0438\u0432\u043E\u0442\u0438\u043D\u043A\u0443 \u0438 \u0431\u0443\u0434\u044C \u0441 \u043D\u0435\u0439 \u0434\u043E\u0431\u0440\u0435\u0435, \u0438 \u0432\u0441\u0435 \u0431\u0443\u0434\u0435\u0442 \u0445\u043E\u0440\u043E\u0448\u043E.",
  "Fri": "\u041F\u043E \u0432\u0435\u0447\u0435\u0440\u0430\u043C \u044F \u0447\u0430\u0441\u0442\u043E \u0431\u044B\u0432\u0430\u044E \u0432 \u0441\u0430\u043B\u0443\u043D\u0435.#$e#\u0416\u0438\u0432\u043E\u0442\u043D\u044B\u0435 \u2014 \u0445\u043E\u0440\u043E\u0448\u0430\u044F \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F, \u043D\u043E \u0438\u043D\u043E\u0433\u0434\u0430 \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0431\u044B\u0442\u044C \u0438 \u0441\u0440\u0435\u0434\u0438 \u043B\u044E\u0434\u0435\u0439.",
  "Fri6": "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u0431\u044B\u0432\u0430\u0435\u0442 \u043B\u0438 \u043C\u0438\u0441\u0442\u0435\u0440\u0443 \u041B\u044C\u044E\u0438\u0441\u0443 \u043E\u0434\u0438\u043D\u043E\u043A\u043E \u0432 \u0435\u0433\u043E \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u043C \u0434\u043E\u043C\u0435...$s#$e#\u0422\u0430\u043C \u0442\u0430\u043A \u043F\u0443\u0441\u0442\u043E, \u043F\u0440\u0430\u0432\u0434\u0430?",
  "Sat": "\u0422\u0435\u0431\u0435 \u0435\u0449\u0435 \u043D\u0435 \u0434\u043E\u0432\u043E\u0434\u0438\u043B\u043E\u0441\u044C \u0437\u0430\u0445\u043E\u0434\u0438\u0442\u044C \u0432 \u0441\u0442\u0440\u0430\u043D\u043D\u0443\u044E \u0431\u0430\u0448\u043D\u044E \u043A \u0437\u0430\u043F\u0430\u0434\u0443 \u043E\u0442 \u043C\u043E\u0435\u0433\u043E \u0434\u043E\u043C\u0430?#$e#\u041A\u0430\u043A-\u0442\u043E \u044F \u0441\u043B\u044B\u0448\u0430\u043B\u0430 \u043E\u0442\u0442\u0443\u0434\u0430 \u043A\u0430\u043A\u0438\u0435-\u0442\u043E \u0436\u0443\u0442\u043A\u0438\u0435, \u043F\u043E\u0442\u0443\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0435 \u0437\u0432\u0443\u043A\u0438.$s#$e#\u041D\u0430 \u0442\u0432\u043E\u0435\u043C \u043C\u0435\u0441\u0442\u0435 \u044F \u0431\u044B \u0438\u0437\u0431\u0435\u0433\u0430\u043B\u0430 \u044D\u0442\u043E\u0439 \u0431\u0430\u0448\u043D\u0438...",
  "Sun": "\u041F\u0440\u0438\u0432\u0435\u0442\u0438\u043A, \u0440\u0430\u0434\u0430 \u0442\u0435\u0431\u044F \u0432\u0438\u0434\u0435\u0442\u044C!#$e#\u0417\u0430\u0445\u043E\u0434\u0438 \u043A \u043D\u0430\u043C, \u0435\u0441\u043B\u0438 \u0437\u0430\u0445\u043E\u0447\u0435\u0448\u044C.",
  "Sun8": "\u041F\u0440\u0438\u0432\u0435\u0442, @!$h#$e#\u042F \u0440\u0430\u0434\u0430, \u0447\u0442\u043E \u043C\u044B \u0442\u0435\u043F\u0435\u0440\u044C \u0434\u0440\u0443\u0437\u044C\u044F. \u0423\u0436 \u0442\u0435\u0431\u0435-\u0442\u043E \u044F \u043C\u043E\u0433\u0443 \u0434\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043C\u043E\u0438\u0445 \u0434\u043E\u0440\u043E\u0433\u0438\u0445 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445.",
  "Fair_Judging": "\u0418\u0442\u0430\u043A...",
  "Fair_Judged": "\u041D\u0443 \u0434\u0430, \u044F \u043D\u0435 \u043F\u043E\u0431\u0435\u0434\u0438\u043B\u0430... \u041D\u043E \u0431\u044B\u043B\u043E \u043F\u0440\u0438\u044F\u0442\u043D\u043E \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u0432\u0441\u0435\u043C \u043F\u043B\u043E\u0434\u044B \u043C\u043E\u0438\u0445 \u0442\u0440\u0443\u0434\u043E\u0432!",
  "Fair_Judged_PlayerLost_PurpleShorts": "\u041A\u0430\u043A\u043E\u0439 \u0447\u0443\u0434\u043D\u043E\u0439 \u0443 \u0442\u0435\u0431\u044F \u0431\u044B\u043B \u0444\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u044B\u0439 \u043B\u0430\u0442\u0443\u043A \u0432 \u043B\u043E\u0442\u043A\u0435!$h#$b#\u0415\u0439-\u0431\u043E\u0433\u0443, \u0447\u0443\u0442\u044C \u043D\u0435 \u043F\u0435\u0440\u0435\u043F\u0443\u0442\u0430\u043B\u0430 \u2014 \u043C\u044D\u0440 \u043D\u0430\u0448, \u041B\u044C\u044E\u0438\u0441, \u043F\u043E \u043E\u0441\u043E\u0431\u044B\u043C \u0441\u043B\u0443\u0447\u0430\u044F\u043C \u043D\u0430\u0434\u0435\u0432\u0430\u0435\u0442 \u043F\u043E\u0445\u043E\u0436\u0438\u0435 \u043F\u043E\u0434\u0448\u0442\u0430\u043D-$3#$b#\u041E\u0439!.. \u0425\u0435-\u0445\u0435... \u041B\u0430\u0434\u043D\u043E, \u0437\u0430\u0431\u0443\u0434\u044C!$4"
}