  "summer_Sat6": "\uC774\uBC88 \uC5EC\uB984\uC740 \uC0AC\uC2E4 \uC798 \uC9C0\uB0B4\uACE0 \uC788\uC5B4.$h#$e#\uC0AC\uB78C \uAD00\uC810\uC774 \uC774\uB807\uAC8C \uBE68\uB9AC \uBC14\uB014 \uC218 \uC788\uB2E4\uB2C8, \uC6C3\uAE30\uC9C0.",
  "summer_Mon8": "\uD56D\uC0C1 \uD3A0\uB9AC\uCEE8 \uB9C8\uC744\uC774 \uC880 \uC7AC\uBBF8\uC5C6\uB2E4 \uC0DD\uAC01\uD588\uB294\uB370, \uC694\uC998 \uB4E4\uC5B4 \uB9C8\uC74C\uC5D0 \uB4DC\uB294 \uC810\uB4E4\uC774 \uC0DD\uAE30\uACE0 \uC788\uC5B4.$h",
  "summer_Thu10": "\uC6B0\uC640, \uC624\uB298 \uC88B\uC544 \uBCF4\uC5EC.#$e#\uC5EC\uB984 \uACF5\uAE30\uAC00 \uC548\uC0C9\uC5D0 \uB9CE\uC774 \uC88B\uC740\uAC00 \uBD10, \uADF8\uCE58?... \uD5E4...$l",
  "summer_Fri10": "\uB18D\uC7A5\uC5D0\uC11C \uC678\uB85C\uC6CC\uC9C8 \uB54C\uB294 \uC5C6\uC5B4?",
  "fall_1": "\uC544... \uAC00\uC744\uC774 \uC654\uC5B4!$h#$e#\uC5EC\uB984 \uC880 \uC2EB\uC99D \uB098\uB824\uACE0 \uD558\uB358 \uCC38\uC774\uC5C8\uB294\uB370.",
  "fall_Mon": "\uC624\uB298\uC740 \uB2E4\uB9AC \uC880 \uBED7\uACE0 \uC2E0\uC120\uD55C \uBC14\uB78C\uC744 \uC410\uC57C\uACA0\uC5B4.",
  "fall_Tue": "$d joja#\uD3C9\uC18C\uC5D4 \uAC00\uAC8C \uC77C\uC744 \uB3C4\uC640\uC8FC\uB294 \uD3B8\uC774\uC57C. \uC870\uC790 \uB9C8\uD2B8\uAC00 \uC5F4\uB9B0 \uD6C4\uB85C \uC190\uB2D8\uC774 \uB9CE\uC774 \uC5C6\uAE34 \uD574.|\uC870\uC790 \uB9C8\uD2B8\uAC00 \uBB38\uC744 \uB2EB\uC740 \uD6C4\uB85C \uAC00\uAC8C\uAC00 \uC815\uB9D0 \uC798\uB418\uACE0 \uC788\uC5B4!$h",
  "fall_Wed": "\uC5BC\uB978 \uC62C\uD574 \uD638\uBC15 \uBCF4\uACE0 \uC2F6\uB2E4.$h#$e#\uC774\uBC88 \uACC4\uC808 \uB9D0\uC5D0 \uC601\uB839\uC758 \uC804\uC57C\uC81C\uAC00 \uC788\uC5B4. \uC8FC\uC8FC \uC2DC\uD2F0\uC5D0\uC11C \uC5F4\uB9AC\uB294 \uCD95\uC81C\uC5D0 \uBE44\uD558\uBA74 \uBCC4\uAC70 \uC544\uB2C8\uC9C0\uB9CC, \uC774\uB7F0 \uC791\uC740 \uB9C8\uC744\uC5D0 \uC774 \uC815\uB3C4\uBA74 \uC815\uB9D0 \uC7AC\uBC0C\uC5B4.",
  "fall_Thu": "#$1 AbigailHAND#\uC5B4\uC82F\uBC24\uC5D0 \uC190\uC774 \uAC70\uB300\uD55C %noun\uC778 \uAFC8\uC744 \uAFE8\uC5B4. \uC5B4\uB5A4 \uAFC8\uC778\uC9C0 \uC54C\uC544?#$e#%\uC560\uBE44\uAC8C\uC77C\uC740 \uC9C0\uAE08 \uBCC4\uB85C \uC598\uAE30\uB97C \uD558\uACE0 \uC2F6\uC740 \uB208\uCE58\uAC00 \uC544\uB2C8\uB2E4.",
  "fall_Sat": "$d cc#\uADF8 \uB0A1\uC740 \uB9C8\uC744\uD68C\uAD00\uC744 \uD63C\uC790\uC11C \uC218\uB9AC\uD588\uB2E4\uB2C8, \uB180\uB77C\uC6CC. \uC815\uB9D0 \uC778\uC0C1 \uAE4A\uC740\uAC78.|\uB18D\uC7A5\uC5D0 \uD5C8\uC218\uC544\uBE44 \uC788\uC5B4 \uD639\uC2DC?",
  "fall_Sun": "\uD750\uC74C... \uC624\uB298 \uBC24\uC740 \uBB50 \uD558\uC9C0?#$q 27/28 fall_Sun_old#\uBA38\uB9AC\uB97C \uB2E4\uC2DC \uC5FC\uC0C9\uD560\uAE4C \uC0DD\uAC01\uD558\uACE0 \uC788\uC5C8\uC5B4... \uB124 \uC0DD\uAC01\uC740 \uC5B4\uB54C?#$r 27 10 Sun_27#\uAC80\uC740\uC0C9\uC73C\uB85C \uC5FC\uC0C9\uD574.#$r 27 10 Sun_27#\uAE08\uBC1C\uC740 \uC5B4\uB54C?#$r 27 20 Sun_WildColor#\uD551\uD06C\uC0C9\uC740 \uC5B4\uB54C?#$r 28 0 Sun_28#\uC9C0\uAE08 \uADF8\uB300\uB85C\uAC00 \uC81C\uC77C \uC88B\uC740 \uAC78!",
  "fall_Sun_old": "$p 27#\uBA38\uB9AC\uB97C \uC5FC\uC0C9\uD560\uAE4C \uD588\uB294\uB370 \uC548 \uD558\uAE30\uB85C \uACB0\uC815\uD588\uC5B4.|\uC751? \uBB34\uC2A8 \uC77C\uC774\uC57C?",
  "Sun_27": "\uADF8 \uC815\uB3C4\uBA74 \uAF64 \uAD1C\uCC2E\uC740 \uC120\uD0DD\uC774\uACA0\uC9C0?#$e#\uC0DD\uAC01\uD574\uBCFC\uAC8C.",
  "Sun_28": "\uC5ED\uC2DC \uB108\uB2E4\uC6B4 \uB300\uB2F5\uC774\uB2E4.$u",
  "Sun_WildColor": "\uB108 \uC9C4\uC9DC \uC6C3\uAE30\uB2E4\uB2C8\uAE4C.$h",
  "fall_Wed2": "\uC62C\uD574 \uB18D\uC7A5\uC5D0\uC11C \uD638\uBC15 \uAE30\uB97C \uAC70\uC57C?#$e#\uB098 \uD558\uB098 \uB0A8\uACA8\uC918!$h",
  "fall_Tue4": "\uBD80\uBAA8\uB2D8\uD558\uACE0 \uC790\uC8FC \uC2F8\uC6B0\uAE34 \uD558\uC9C0\uB9CC, \uB0B4 \uAC71\uC815 \uD574\uC11C \uADF8\uB7EC\uC2E0\uB2E4\uB294 \uAC70 \uC54C\uC544. \uCD5C\uC120\uC774\uB77C \uC0DD\uAC01\uD558\uB294 \uCABD\uC73C\uB85C \uD589\uB3D9\uD558\uC2DC\uB294 \uAC70\uACA0\uC9C0.$s#$b#\uC65C \uC774\uAC78 \uB108\uD55C\uD14C \uC598\uAE30\uD558\uB294\uC9C0 \uBAA8\uB974\uACA0\uB2E4. \uC544\uBB34\uD55C\uD14C\uB3C4 \uB9D0\uD558\uC9C0 \uB9C8.$8",
  "fall_Sat6": "\uC548\uB155.$h#$e#\uC624\uB298 \uBA38\uB9AC \uBA4B\uC788\uB2E4... \uBB54\uAC00 \uB2E4\uB978\uAC78 \uC2DC\uB3C4\uD574\uBCF8 \uAC70\uC57C?",
  "fall_Mon8": "\uADF8\uAC70 \uC54C\uC544? \uB18D\uBD80\uC778 \uB0B4 \uBAA8\uC2B5\uB3C4 \uC5B4\uC0C9\uD558\uC9C0 \uC54A\uC744 \uAC70 \uAC19\uC544...#$e#\uADFC\uB370 \uB0B4\uAC00 \uB18D\uBD80\uAC00 \uB420 \uC77C\uC774 \uC788\uC744\uAE4C? *\uC2F1\uAE0B*$l",
  "fall_Thu10": "\uC5B4\uC81C \uC2E0\uAE30\uD55C \uAFC8\uC744 \uAFE8\uC5B4, \uB108\uB3C4 \uB098\uC654\uACE0.#$e#\uC88B\uC740 \uAFC8\uC774\uC5C8\uC5B4.$h",
  "fall_Fri6": "\uAC00\uC744\uC774 \uC880 \uB354 \uAE38\uC5C8\uC73C\uBA74 \uC88B\uACA0\uB2E4.$8#$e#\uBC14\uB78C\uC774 \uB9CE\uC774 \uBD88\uB54C\uBA74, \uB2E4\uC2DC \uC5B4\uB9B0\uC544\uC774\uAC00 \uB41C \uAC83 \uAC19\uC544.",
  "fall_Fri10": "\uBCF4\uD1B5 \uC774\uB9D8\uB54C \uC678\uB85C\uC6B4 \uAE30\uBD84\uC774 \uB9CE\uC774 \uB4DC\uB294\uB370, \uC774\uC820 \uC548 \uADF8\uB7EC\uB124.$l#$e#@, \uB10C \uBBF8\uB798\uC5D0 \uC5B4\uB5A4 \uACC4\uD68D\uC774 \uC788\uC5B4?",
  "winter_1": "\uAC00\uC744\uC774 \uB2E4 \uC9C0\uB098\uAC14\uB124...$s#$e#\uADFC\uB370 \uACA8\uC6B8\uB3C4 \uC88B\uC544!$h",
  "winter_Mon": "\uBC16\uC5D0 \uC790\uC8FC \uB098\uAC00\uAE30\uC5D4 \uB108\uBB34 \uCD94\uC6CC.#$e#\uD558\uC9C0\uB9CC \uB208\uC0AC\uB78C \uB9CC\uB4DC\uB294 \uAC74 \uC88B\uC544.$h",
  "winter_Tue": "\uAE40 \uB098\uB294 \uB728\uAC70\uC6B4 \uCF54\uCF54\uC544 \uD55C\uC794 \uC9C0\uAE08 \uB531\uC77C \uAC70 \uAC19\uC9C0 \uC54A\uC544?",
  "winter_Wed": "\uC548\uB155. \uB18D\uBD80\uD55C\uD14C \uACA8\uC6B8\uC740 \uC880 \uC9C0\uB8E8\uD558\uC9C0 \uC54A\uC544?",
  "spring_12": "\uB09C \uB0B4\uC77C \uBC18\uB4DC\uC2DC \uB2EC\uAC40 \uC0AC\uB0E5\uC5D0 \uCC38\uAC00\uD560 \uAC70\uC57C. \uB108\uB3C4 \uD574?",
  "spring_23": "\uB0B4\uC77C \uBD04\uAF43 \uBB34\uB3C4\uD68C\uB124. \uCDA4\uCD94\uB294 \uAC74 \uAD1C\uCC2E\uC740\uB370, \uC774 \uBC14\uBCF4 \uAC19\uC740 \uD770 \uB4DC\uB808\uC2A4\uB97C \uC785\uC73C\uB798...$s",
  "winter_7": "\uB0B4\uC77C \uB208\uC0AC\uB78C \uB9CC\uB4DC\uB294 \uAC70 \uAE30\uB300\uD558\uACE0 \uC788\uC5B4.",
  "fall_26": "\uB0B4\uC77C \uC601\uB839\uC758 \uC804\uC57C\uC81C\uC5D0 \uC62C \uAC70\uC57C? \uADC0\uC2E0\uC758 \uBBF8\uB85C\uC5D0\uC11C \uB098 \uCC3E\uC544\uBD10\uBD10.$h",
  "summer_10": "\uB2E4\uB4E4 \uB0B4\uC77C \uB8E8\uC544 \uAE30\uB300\uD558\uACE0 \uC788\uC5B4. \uB2E4\uB4E4 \uC57D\uAC04 \uAE34\uC7A5\uD55C \uAC83\uB3C4 \uAC19\uC544, \uB3C4\uC9C0\uC0AC\uB2D8\uC774 \uC624\uC2E0\uB2E4\uB2C8\uAE4C.",
  "summer_27": "\uB0B4\uC77C \uCD95\uC81C\uB294 \uAF2D \uC640\uC57C \uD574. \uACC4\uACE1\uC5D0\uC11C \uC81C\uC77C \uC544\uB984\uB2F5\uACE0 \uC2E0\uBE44\uB85C\uC6B4 \uAD11\uACBD \uC911 \uD558\uB098\uC57C.",
  "winter_24": "\uB0B4\uC77C \uB098 \uD06C\uB79C\uBCA0\uB9AC \uC18C\uC2A4 \uC5C4\uCCAD \uBA39\uC744 \uAC70\uC57C.$h",
  "winter_Thu": "\uBC8C\uC368 \uC77C \uB144\uC774 \uAC70\uC758 \uB05D\uB0AC\uB124.#$e#\uC2DC\uAC04 \uCC38 \uBE68\uB9AC \uAC04\uB2E4, \uADF8\uCE58?$s",
  "winter_Fri": "\uC5EC\uAE30 \uC0B4\uBA74\uC11C \uBC30\uC6B4 \uAC70 \uD558\uB098\uAC00... \uB124\uAC00 \uC880 \uB2E4\uB974\uAC8C \uC0DD\uACBC\uC73C\uBA74 \uB2E4\uB4E4 \uCCD0\uB2E4\uBCF8\uB2E4\uB294 \uAC70\uC57C.",
  "winter_Sat": "\uC8FC\uB9D0\uC774\uB2E4!#$e#\uAC8C\uC784 \uC774\uC81C \uB450 \uBC30\uB85C \uB9CE\uC774 \uD560 \uC218 \uC788\uC5B4.$h#$e#\uC548\uB155.",
  "winter_Sun": "\uC624, \uC548\uB155.#$q 29/30 winter_Sun_old#\uADF8\uB9BC \uB450 \uAC1C \uADF8\uB824\uBD24\uC5B4. \uC5B4\uB5BB\uAC8C \uC0DD\uAC01\uD574?#$r 29 20 Sun_29#\uC815\uAE00 \uC12C\uC774\uB791 \uD638\uB791\uC774 \uADF8\uB9BC \uB9C8\uC74C\uC5D0 \uB4E0\uB2E4.#$r 30 5 Sun_30#\uC804\uD22C\uB3C4\uB07C \uB4E0 \uC624\uD06C \uADF8\uB9BC \uB9C8\uC74C\uC5D0 \uB4E0\uB2E4.#$r 29 -50 Sun_Bad#\uB458 \uB2E4 \uBCC4\uB85C\uC57C.",
  "winter_Sun_old": "$p 29#\uC800\uBC88\uC5D0 \uBCF4\uC5EC\uC900 \uADF8\uB9BC\uB4E4 \uAE30\uC5B5\uB098? \uC2E4\uC218\uB85C \uBC84\uB838\uC5B4.$s|\uC800\uBC88\uC5D0 \uBCF4\uC5EC\uC900 \uC624\uD06C \uADF8\uB9BC \uAE30\uC5B5\uB098? \uC628\uB77C\uC778 \uB300\uD68C\uC5D0 \uC81C\uCD9C\uD574\uC11C 50 \uACE8\uB4DC \uBC8C\uC5C8\uC5B4!$h",
  "Sun_29": "\uC624 \uADF8\uB798? \uD558\uAE34 \uADF8\uAC8C \uB9D0\uC774 \uB418\uB124.",
  "Sun_30": "\uAE30\uBED0. \uADF8\uB9BC \uB0A8\uB4E4\uD55C\uD14C \uBCF4\uC5EC\uC8FC\uB294 \uAC74 \uC880 \uBD80\uB044\uB7FD\uB354\uB77C\uACE0. \uADFC\uB370 \uB108\uB791 \uB098\uB294 \uBB54\uAC00 \uD1B5\uD558\uB294 \uAC83 \uAC19\uC544.",
  "Sun_Bad": "\uB098\uBE74\uC5B4! \uC5B4\uB5BB\uAC8C \uADF8\uB7F0 \uB9D0\uC744 \uD560 \uC218\uAC00 \uC788\uC5B4? \uB108\uBB34 \uB0A8\uC758 \uAE30\uBD84\uC5D0 \uB454\uAC10\uD574!$s",
  "winter_Wed2": "\uC548\uB155. \uD639\uC2DC \uC2EC\uC2EC\uD558\uBA74, \uB0B4 \uBC29\uC5D0 \uB180\uB7EC \uC640.#$e#\uB2F9\uC5F0\uD55C \uAC70\uC9C0\uB9CC, \uB0B4\uAC00 \uC637 \uAC08\uC544\uC785\uACE0 \uC788\uC744 \uB54C \uB9D0\uACE0!",
  "winter_Tue4": "\uB108\uBB34 \uCDA5\uB2E4, \uAC19\uC774 \uB9C8\uC2E4 \uB728\uAC70\uC6B4 \uCF54\uCF54\uC544 \uD55C\uC794 \uC788\uC73C\uBA74 \uC88B\uC744 \uD150\uB370.$h",
  "winter_Sat6": "\uC694\uC998 \uB534\uC0DD\uAC01\uC774 \uB108\uBB34 \uB9CE\uC544...#$e#\uC624! \uBB34\uC2A8 \uC0DD\uAC01\uC778\uC9C0 \uAD81\uAE08\uD574? \uADF8\uAC8C \uC788\uC9C0...$u#$b#...\uBE44\uBC00\uC774\uC57C.$h",
  "winter_Thu10": "\uD55C \uD574\uAC00 \uB610 \uB05D\uB098\uAC00\uB124...#$b#\uADFC\uB370 \uC62C\uD574 \uC815\uB9D0 \uAD1C\uCC2E\uC558\uC5B4, \uC548 \uADF8\uB798?$h",
  "winter_Wed6": "\uC694\uC998\uC740 \uC791\uBB3C \uAC71\uC815 \uC548 \uD574\uB3C4 \uB418\uB294 \uAC74 \uC88B\uACA0\uB2E4.#$e#\uADF8\uB9AC\uACE0 \uADF8\uB7FC \uB098\uB791 \uB180 \uC2DC\uAC04\uB3C4 \uB354 \uB9CE\uC744 \uD14C\uACE0!$h",
  "winter_Fri10": "@, \uB9D0\uD558\uACE0 \uC2F6\uC740 \uAC8C \uC788\uC5C8\uC5B4...#$e#\uADF8\uAC8C... \uC74C... \uADF8... \uB124 \uC2E0\uBC1C! \uADF8, \uC5B4... \uB418\uAC8C \uAE68\uB057\uD574 \uBCF4\uC5EC... *\uAFC0\uAEBD*#$e#\uADF8\uAC8C \uB2E4\uC57C... *\uD55C\uC228*$s",
  "Wed4": "\uB3D9\uBB3C \uC548 \uC88B\uC544\uD558\uB294 \uC0AC\uB78C\uC740 \uBABB \uBBFF\uACA0\uB354\uB77C...#$e#\uC544, \uAC71\uC815\uD558\uC9C4 \uB9C8! \uB124\uAC00 \uB3D9\uBB3C\uC744 \uC0AC\uB791\uD55C\uB2E4\uB294 \uAC74 \uC798 \uC54C\uC9C0!$h"
