{
  "Rainy_Day_0": "\uC5B4\uB461\uACE0... \uBE44 \uC624\uACE0... \uC774\uB7F0 \uB0A0\uC528\uBA74 \uB09C \uC88B\uC544.$l",
  "Rainy_Day_1": "\uC6B0\uB9AC \uD638\uC218 \uCABD\uC5D0\uC11C \uB4C0\uC5E3 \uC5F0\uC8FC\uD55C \uAC70 \uAE30\uC5B5\uB098? \uB0A0\uC528\uAC00 \uC774\uB7EC\uBA74 \uADF8\uB0A0 \uC0DD\uAC01\uC774 \uB098.#$e#\uBBF8\uB2C8 \uD558\uD504 \uC2E4\uB825\uC5D0 \uB180\uB790\uC5B4... \uC804\uD600 \uC608\uC0C1\uD558\uC9C0 \uBABB\uD588\uC5B4. \uADF8\uB798\uC11C \uB0B4\uAC00 \uB110 \uADF8\uB807\uAC8C \uC88B\uC544\uD558\uB294 \uAC70\uACA0\uC9C0.$l",
  "Rainy_Day_2": "\uC57C! \uC544\uCE68\uC5D0 \uC77C\uCC0D \uAE68\uC11C \uD63C\uC790 \uD0D0\uD5D8 \uC880 \uD588\uC5B4. \uC774\uAC70 \uCC3E\uC558\uB294\uB370 \uB108 \uC0DD\uAC01\uC774 \uB0AC\uC5B4. [768 767 769 66 82]#$e#\uB354 \uC88B\uC740 \uAC70 \uCC3E\uC744 \uC218 \uC788\uC744 \uAC70 \uAC19\uC544? \uC544\uB2D0 \uAC70 \uAC19\uC740\uB370!$h",
  "Rainy_Day_3": "\uB3D9\uAD74 \uD0D0\uD5D8\uD558\uB7EC \uAC00\uAE30 \uC88B\uC740 \uB0A0\uC774\uC57C, \uADF8\uCE58? \uAC00\uAC8C \uB418\uBA74 \uC870\uC2EC\uD558\uACE0.#$e#\uAC08 \uC0DD\uAC01\uC774\uBA74, \uC0DD\uBA85\uC758 \uC601\uC57D \uD55C\uB450 \uAC1C \uCC59\uACA8\uAC00.",
  "Rainy_Day_4": "\uC624\uB298 \uB300\uCD08\uC6D0\uC758 \uC655 \uC870\uAE08 \uD560\uAE4C \uBD10... \uC5B8\uC820\uAC00 \uAF2D \uD63C\uC790\uC11C \uAE70 \uAC70\uC57C.$h",
  "patio_Abigail": "%\uC560\uBE44\uAC8C\uC77C\uC740 \uC74C\uC545\uC5D0 \uC2EC\uCDE8\uD574\uC788\uC2B5\uB2C8\uB2E4.",
  "Rainy_Day_Abigail": "\uC774\uB7F0 \uB0A0 \uC2DC\uACE8 \uD48D\uACBD\uC774 \uB354 \uD765\uBBF8\uB86D\uC9C0 \uC54A\uC544?",
  "Rainy_Night_0": "\uBE44 \uB0B4\uB9AC\uB294 \uC232\uCABD\uC744 \uBC14\uB77C\uBCF4\uACE0\uC788\uC5C8\uB294\uB370... \uBD84\uBA85 \uC5C4\uCCAD\uB098\uAC8C \uAC80\uC740 \uD615\uCCB4\uAC00 \uB098\uBB34 \uC0AC\uC774\uB85C \uC6C0\uC9C1\uC774\uB294 \uAC78 \uBD24\uC5B4.$6",
  "Rainy_Night_1": "\uADC0\uC2E0 \uBCF4\uAE30 \uC88B\uC740 \uBC24\uC774\uB124...",
  "Rainy_Night_2": "\uB290\uAEF4\uC838? \uBE57\uC18D\uC5D0 \uC815\uC801\uC774 \uC788\uC5B4...",
  "Rainy_Night_3": "\uB098 \uC774\uB7F0 \uBC24\uC5D0\uB294 \uBD88\uC744 \uB044\uACE0 \uC870\uC6A9\uD788 \uC18C\uB9AC\uB97C \uB4E3\uB294 \uAC8C \uC88B\uB354\uB77C...$8",
  "Rainy_Night_4": "\uC800\uB141\uC73C\uB85C \uC2A4\uD504 \uB9CC\uB4E4\uC5B4\uBD24\uC5B4. \uB108\uBB34 \uB9DB\uC5C6\uC9C0 \uC54A\uC558\uC73C\uBA74 \uC88B\uACA0\uB124. [199 218 219 727 730]$h",
  "Rainy_Night_5": "\uC57C! \uC624\uB298 \uC5F4\uC2EC\uD788 \uC77C\uD588\uB098 \uBD10. \uAE34\uC7A5 \uC880 \uD480\uAC8C \uB3C4\uC640\uC904\uAE4C?^\uC624\uB298 \uC5F4\uC2EC\uD788 \uC77C\uD588\uC5B4? \uC880 \uC9C0\uCCE4\uC744 \uB54C \uB108 \uADC0\uC5EC\uC6CC \uBCF4\uC5EC.$h",
  "Rainy_Night_Abigail": "\uBE44 \uC624\uB294 \uC18C\uB9AC \uB4E3\uB2E4 \uBCF4\uBA74 \uC6B0\uB9AC \uD479 \uC7A0\uB4E4\uACA0\uB2E4.",
  "Indoor_Day_0": "\uB09C \uD56D\uC0C1 \uC5EC\uAE30\uAC00 \uC88B\uC558\uC5B4, \uB124\uAC00 \uC774\uC0AC \uC624\uAE30 \uC804\uBD80\uD130\uB3C4. \uC774\uC820 \uC5B8\uC81C\uB4E0 \uC6D0\uD558\uBA74 \uC774 \uB18D\uC7A5\uC744 \uB458\uB7EC\uBCFC \uC218 \uC788\uAC8C \uB410\uB124!$h",
  "Indoor_Day_1": "\uC57C, @. \uBAA8\uD5D8\uAC00\uB294 \uAC70\uC57C? \uC5EC\uAE30, \uC774\uAC70 \uAC00\uC838\uAC00...[286 287 205 732]#$e#\uD639\uC2DC \uC0C1\uD669\uC774 \uC704\uD5D8\uD574\uC9C0\uBA74 \uC368. \uADF8\uAC70\uBA74 \uC548\uC804\uD560 \uC218 \uC788\uC744 \uAC70\uC57C.",
  "Indoor_Day_2": "\uAD11\uC0B0 \uAC00\uB294 \uAC70\uC57C? \uC57C... \uD639\uC2DC \uB9DB\uC788\uB294 \uAC70 \uCC3E\uC73C\uBA74, \uB098\uB3C4 \uD55C \uC870\uAC01 \uB0A8\uACA8\uC918!$h",
  "Indoor_Day_3": "\uC548\uB155! \uC624\uB298 \uBB50 \uD560\uAE4C \uACE0\uBBFC \uC911\uC774\uC57C. \uC774\uB807\uAC8C \uC790\uC720\uB85C\uC6B4 \uAC74 \uC775\uC219\uD558\uC9C0 \uC54A\uC544\uC11C!",
  "Indoor_Day_4": "\uB0B4\uAC00 \uC9D1\uC548 \uC880 \uAFB8\uBA70\uB3C4 \uAD1C\uCC2E\uC9C0? \uB0B4\uAC00 \uAFB8\uBC00 \uC218 \uC788\uB294 \uACF3\uC774 \uC788\uB2E4\uB294 \uAC8C \uC544\uC9C1 \uB9CE\uC774 \uC124\uB808.",
  "Indoor_Day_Abigail": "\uB18D\uC7A5\uC5D4 \uD56D\uC0C1 \uC0C8\uB85C\uC6B4 \uC77C\uC774 \uC788\uB124... \uB108\uBB34 \uC88B\uC544.",
  "Indoor_Night_0": "\uC624\uB298 \uD558\uB8E8 \uC88B\uC558\uC5B4. \uC5EC\uAE30\uB294 \uC790\uC138\uD788 \uBCF4\uBA74 \uD56D\uC0C1 \uBB34\uC5B8\uAC00 \uD765\uBBF8\uB85C\uC6B4 \uC77C\uC774 \uBC8C\uC5B4\uC9C0\uACE0 \uC788\uC5B4.",
  "Indoor_Night_1": "\uC57C! \uC624\uB298 \uD558\uB8E8 \uC5B4\uB560\uC5B4? \uC7AC\uBC0C\uB294 \uC77C \uC788\uC5C8\uC5B4?$h",
  "Indoor_Night_2": "\uB0B4\uAC00 \uC608\uC804\uC5D4 \uC9C4\uC9DC \uC62C\uBE7C\uBBF8\uC600\uB294\uB370, \uC2AC\uC2AC \uB18D\uC7A5 \uC0DD\uD65C \uB9AC\uB4EC\uC774 \uC775\uC219\uD574\uC9C0\uB294 \uAC83 \uAC19\uC544. \uBB54\uAC00 \uC790\uC5F0\uC2A4\uB7EC\uC6CC.",
  "Indoor_Night_3": "*\uD558\uD488*... \uB098 \uACE7 \uC790\uB7EC \uAC08 \uAC70\uC57C.$h",
  "Indoor_Night_4": "\uBC24\uC5D0 \uB098\uB294 \uC18C\uB9AC\uAC00 \uC5EC\uAE30\uC120 \uB354 \uD06C\uAC8C \uB4E4\uB9AC\uB294 \uAC70 \uAC19\uC544. \uC815\uB9D0 \uB9C8\uC74C\uC5D0 \uB4E4\uC5B4.",
  "Indoor_Night_Abigail": "\uACE7 \uC7A0\uB4E4 \uC900\uBE44\uB418\uC5C8\uC5B4? \uC804\uAE30\uC7A5\uD310 \uCF1C\uB1A8\uC5B4...$l",
  "Outdoor_0": "\uC0B0\uB4E4\uBC14\uB78C\uC774 \uBD88\uC5B4\uC11C \uC0B0 \uB0C4\uC0C8\uAC00 \uACC4\uACE1 \uCABD\uC73C\uB85C \uD37C\uC9C0\uACE0 \uC788\uB124. \uC2E0\uC120\uD55C \uC18C\uB098\uBB34\uC640 \uC138\uC774\uC9C0 \uB0C4\uC0C8\uAC00 \uB098.",
  "Outdoor_1": "\uC74C... \uC2AC\uB77C\uC784 \uBAA9\uC7A5\uC744 \uC2DC\uC791\uD560 \uC815\uB3C4\uB85C \uACF5\uAC04\uC774 \uB9CE\uB124!",
  "Outdoor_2": "\uD560\uC544\uBC84\uC9C0 \uC0AC\uB2F9 \uC8FC\uBCC0 \uAF2D \uAE68\uB057\uD558\uAC8C \uC815\uB9AC\uD558\uACE0. \uBB54\uAC00 \uD2B9\uBCC4\uD55C \uC7A5\uC18C\uC57C, \uB290\uAEF4\uC838.",
  "Outdoor_3": "\uC6B0\uB9AC \uC0AC\uC720\uC9C0\uC5D0 \uB3D9\uAD74\uC774 \uC788\uB2E4\uB294 \uAC74 \uAF64 \uBA4B\uC9C4 \uAC70 \uAC19\uC544. \uD56D\uC0C1 \uC6D0\uD588\uB358 \uAC83 \uC911 \uD558\uB098\uC57C.$h",
  "Outdoor_4": "\uC8FC\uBA38\uB2C8\uC5D0 \uAC04\uC2DD \uC880 \uB4E4\uACE0 \uB2E4\uB140\uC57C \uD558\uB294\uB370 \uC790\uAFB8 \uAE4C\uBA39\uC5B4. *\uAF2C\uB974\uB975*$h",
  "Outdoor_Abigail": "\uB098 \uC5EC\uAE30\uC11C \uC880 \uC788\uC744\uAC8C, \uC54C\uC558\uC9C0?#$e#\uC5EC\uAE30 \uD765\uBBF8\uB85C\uC6B4 \uACE4\uCDA9\uC774 \uB9CE\uC544. *\uD5E4\uD5E4*$h",
  "funLeave_Abigail": "\uB098 \uC624\uB298 \uB9C8\uC744\uC5D0 \uC880 \uAC00\uB824\uACE0. \uC880 \uAC78\uC5B4 \uB2E4\uB140\uC57C\uACA0\uC5B4.",
  "funReturn_Abigail": "\uC548\uB155! \uC624\uB298 \uD558\uB8E8 \uC5B4\uB560\uC5B4? \uB09C \uC815\uB9D0 \uC88B\uC558\uC5B4. \uC624\uB79C\uB9CC\uC5D0 \uC0B0\uCC45\uD558\uB2C8\uAE4C \uC0C1\uCF8C\uD558\uB354\uB77C.$h",
  "OneKid_3": "\uB0B4\uAC00 \u0022\uC5C4\uB9C8\u0022\uB77C\uB294 \uAC8C \uBBFF\uAE30\uC9C0 \uC54A\uC544... \uC778\uC0DD\uC740 \uC774\uC0C1\uD574.$h",
  "TwoKids_0": "%kid1(\uC774)\uB791 %kid2(\uC774)\uD55C\uD14C \uBC8C\uC368 \uCD08\uCF5C\uB9BF \uC2DC\uB9AC\uC5BC \uC92C\uC5B4. \uC18C\uB9AC\uB97C \uC9C0\uB974\uB354\uB77C\uACE0!",
  "TwoKids_2": "%kid2(\uC774)\uAC00 \uCEE4\uC11C \uC720\uBA85\uD55C \uAD34\uBB3C \uC0AC\uB0E5\uAFBC\uC774 \uB418\uB294 \uAFC8\uC744 \uAFE8\uC5B4. \uBC8C\uC368 \uC791\uC740 \uAC11\uC637\uB3C4 \uD55C \uC138\uD2B8 \uAD6C\uC0C1\uD574\uB1A8\uC5B4.",
  "TwoKids_3": "\uBA4B\uC9C0\uACE0 \uC624\uB798\uB41C \uC9D1, \uC544\uC774\uB4E4 \uB450 \uBA85, \uADF8\uB9AC\uACE0 \uAD49\uC7A5\uD55C \uB18D\uC7A5. \uB0B4 \uC0B6\uC5D0 \uC774\uB807\uAC8C \uB9CE\uC740 \uC77C\uC774 \uC788\uC744 \uC904\uC740 \uBAB0\uB790\uC9C0... \uADFC\uB370 \uC544\uC9C1\uC774\uC57C! \uC6B0\uB9AC \uC0B6\uC740 \uC774\uC81C \uB9C9 \uC2DC\uC791\uB418\uACE0 \uC788\uB2E4\uACE0.$h",
  "Good_1": "\uB4E4\uB824? \uAC00\uB054 \uC9D1\uC5D0 \uADC0\uC2E0\uC774 \uC788\uB294 \uAC83 \uAC19\uC544.$u",
  "Good_2": "\uC6F0\uC705\uC758 \uBCC4\uC790\uB9AC \uC6B4\uC138 \uBCF4\uB2C8\uAE4C \uB098 \uC624\uB298 \uC5C4\uCCAD\uB09C \uC77C\uB4E4\uC774 \uC788\uC744 \uAC70\uB798. \uC624\uB298 \uC758\uC695\uC774 \uB118\uCE58\uB294 \uAC78!",
  "Good_3": "\uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC5B8\uC81C \uC5FC\uC0C9\uD588\uB294\uC9C0 \uAE30\uC5B5\uB3C4 \uC548 \uB098\uB124... \uC9C4\uC9DC, \uC774 \uC0C9\uC774 \uBE60\uC9C0\uC9C8 \uC54A\uC544...",
  "Good_4": "\uB0B4\uAC00 \uB450\uD130\uC6B4 \uC7A5\uD654 \uD55C \uCF24\uB808\uAC00 \uC788\uC5B4\uC11C \uC815\uB9D0 \uB2E4\uD589\uC774\uC57C. \uC6B4\uB3D9\uD654 \uC2E0\uACE0 \uC9C4\uD759 \uD53C\uD574\uB2E4\uB2C8\uB824\uBA74 \uB108\uBB34 \uD798\uB4E4\uAC83\uAC19\uC544.$h",
  "Good_5": "\uB124\uAC00 \uC900 \uC778\uC5B4\uC758 \uD39C\uB358\uD2B8 \uAC10\uC0C1\uD558\uACE0 \uC788\uC5C8\uC5B4... \uC774\uAC74 \uC8FD\uB294 \uB0A0\uAE4C\uC9C0 \uC790\uB791\uC2A4\uB7FD\uAC8C \uAC04\uC9C1\uD560 \uAC70\uC57C.$l",
  "Good_6": "\uB124\uAC00 \uBA38\uB9AC\uAC00 \uC88B\uC740 \uAC74 \uC54C\uC9C0\uB9CC, \uADF8\uB798\uB3C4 \uAC00\uB054 \uAC71\uC815\uB418\uB294\uAC78. \uC138\uC0C1\uC5D4 \uAD34\uBB3C\uC774 \uB9CE\uC544.$6#$e#\uC870\uC2EC\uD558\uACA0\uB2E4\uACE0 \uC57D\uC18D\uD574\uC918. \uB110 \uC783\uACE0 \uC2F6\uC9C0 \uC54A\uC544.",
  "Good_7": "@? \uB124\uAC00 \uC6B0\uB9AC\uB97C \uC704\uD574 \uD558\uB294 \uBAA8\uB4E0 \uC77C\uC5D0 \uAC10\uC0AC\uD558\uB2E4\uACE0 \uC598\uAE30\uD558\uACE0 \uC2F6\uC5C8\uC5B4. \uB124\uAC00 \uC815\uB9D0 \uC790\uB791\uC2A4\uB7EC\uC6CC.$l",
  "Neutral_0": "\uB0B4\uAC00 \uB299\uACE0 \uC8FC\uB984\uC838\uB3C4 \uB0A0 \uC88B\uC544\uD588\uC73C\uBA74 \uC88B\uACA0\uB2E4. \uC5B8\uC820\uAC00 \uC788\uC744 \uC77C\uC774\uC57C!",
  "Neutral_1": "\uC790\uAE30 \uD560\uC544\uBC84\uC9C0\uB3C4 \uC6B0\uB9AC\uB97C \uC790\uB791\uC2A4\uB7FD\uAC8C \uC0DD\uAC01\uD558\uC2E4\uAE4C?",
  "Neutral_6": "\uAC00\uAC8C\uB294 \uC694\uC998 \uC798 \uB418\uACE0 \uC788\uC73C\uB824\uB098 \uAD81\uAE08\uD558\uB124? \uACE7 \uBD80\uBAA8\uB2D8\uB3C4 \uCC3E\uC544\uBD48\uB7EC \uAC00\uC57C\uC9C0.",
  "Neutral_7": "\uB124\uAC00 \uC601\uB839\uC758 \uC138\uACC4\uB85C \uB5A0\uB098\uAC04\uB2E4\uBA74, \uD560\uC544\uBC84\uC9C0 \uC0AC\uB2F9 \uC606\uC5D0 \uC791\uC740 \uC0AC\uB2F9 \uD558\uB098 \uB354 \uB9CC\uB4E4 \uAC70\uC57C.",
  "Neutral_8": "\uC544\uBB34\uB9AC \uCCAD\uC18C\uB97C \uD574\uB3C4, \uC9D1\uC548\uC774 \uB2E4\uC2DC \uC9C0\uC800\uBD84\uD574\uC838.#$e#\uB18D\uC7A5\uC5D0\uC11C \uC9C0\uB0B4\uB2E4 \uBCF4\uBA74 \uADF8\uB7F4 \uC218 \uC788\uB294 \uAC70\uACA0\uC9C0.",
  "Neutral_9": "\uC6B0\uB9AC \uD3C9\uC0DD \uC5EC\uAE30\uC5D0 \uC0B4\uB824\uB098? \uB098 \uC2EC\uC2EC\uD574\uC9C8 \uC218\uB3C4 \uC788\uB294\uB370.",
  "Bad_7": "\uB09C \uB124\uAC8C \uD2B9\uBCC4\uD55C \uC874\uC7AC\uC600\uB294\uB370, \uC81C\uC77C \uCE5C\uD55C \uCE5C\uAD6C\uC5D0... \uC774\uC820 \uB0B4\uAC00 \uC800\uB141 \uC694\uB9AC\uD560 \uB54C\uB9CC \uCC38\uACE0 \uACAC\uB514\uB294 \uAC83 \uAC19\uC544.$s",
  "Bad_8": "\uC694\uC998 \uB098\uD55C\uD14C \uC65C \uADF8\uB807\uAC8C \uCC28\uAC00\uC6CC... \uC65C \uADF8\uB798? \uBB34\uC2A8 \uB2AA\uC9C0\uC758 \uC815\uB839 \uAC19\uC544...$s",
  "Bad_9": "\uB098\uD55C\uD14C \uB354 \uB098\uC740 \uC0B6\uC774 \uC788\uC5C8\uC744 \uC218\uB3C4 \uC788\uB294\uB370... \uC6B0\uB9AC \uB9CC\uB098\uAE30 \uC804\uC5D0 \uB098 \uC138\uBC14\uC2A4\uCC2C\uD558\uACE0 \uC0AC\uC774\uAC00 \uC88B\uC558\uB294\uB370. \uC544\uB9C8 \uADF8\uAC00 \uB0B4 \uC6B4\uBA85\uC774\uC5C8\uC744 \uC218\uB3C4 \uC788\uC5B4...$s",
  "spring_1": "\uADF8\uB798, \uC62C\uD574 \uC5B4\uB5A4 \uD070 \uACC4\uD68D\uC774 \uC788\uC5B4?",
  "spring_12": "\uC57C, \uB0B4\uC77C\uC774 \uB2EC\uAC40 \uCD95\uC81C\uC57C. \uBBF8\uC548\uD558\uC9C0\uB9CC, \uACB0\uD63C\uD588\uB2E4\uACE0 \uC27D\uAC8C \uC838\uC904 \uB0B4\uAC00 \uC544\uB2C8\uC9C0!$h#$e#\uB09C \uAF2D \uB2EC\uAC40 \uC0AC\uB0E5\uC5D0\uC11C 1\uB4F1\uD560 \uAC70\uC57C. \uC774\uAE30\uACE0 \uC2F6\uC73C\uBA74 \uD55C\uBC88 \uD574\uBD10.",
  "spring_2": "\uC62C\uD574 \uC774\uB8E8\uACE0 \uC2F6\uC740 \uAC70 \uC788\uC5B4? \uB09C \uBC43\uC0B4 \uC880 \uBE7C\uB824\uACE0.$h",
  "summer_1": "\uB098 \uB108\uBB34 \uC27D\uAC8C \uD0C0\uB294 \uD3B8\uC774\uB77C, \uC5EC\uB984\uC5D4 \uC880 \uC870\uC2EC\uD574\uC57C\uD574.#$e#\uB0B4\uAC00 \uCC3D\uBC31\uD55C \uAC8C \uB9C8\uC74C\uC5D0 \uB4E4\uC5B4\uC57C \uD560 \uD150\uB370!$h",
  "summer_4": "\uC5F4\uC0AC\uBCD1 \uC870\uC2EC\uD574, \uC5EC\uBCF4.#$e#\uBB3C \uB9CE\uC774 \uB9C8\uC2DC\uACE0 \uBB34\uB9AC\uD558\uC9C0 \uB9D0\uACE0.",
  "summer_8": "\uB098 \uD639\uC2DC \uB0C4\uC0C8\uB098\uBA74 \uBBF8\uC548\uD574... \uBC24\uC0C8 \uB354\uC6CC\uC11C \uACC4\uC18D \uB540\uB0AC\uC5B4.",
  "summer_15": "\uC5EC\uB984\uC774\uB124... \uC9D1\uC548\uC5D0 \uD30C\uB9AC\uAC00 \uB108\uBB34 \uB9CE\uC544.#$e#\uAC71\uC815\uD558\uC9C0 \uB9C8, \uB0B4\uAC00 \uB2E4 \uC7A1\uC744\uAC8C. \uC7AC\uBC0C\uC5B4!$h",
  "fall_6": "\uC544... \uAC00\uC744. \uC77C \uB144 \uC911 \uC774\uB54C\uAC00 \uC81C\uC77C \uC88B\uB354\uB77C. \uC774 \uACC4\uC808 \uC0C9\uAC10\uC774 \uB0B4 \uBA38\uB9AC\uC0C9\uD558\uACE0 \uC798 \uC5B4\uC6B8\uB9AC\uC9C0 \uC54A\uC544?",
  "fall_1": "\uC774 \uB0C4\uC0C8\uB294 \uBD84\uBA85\uD788... \uBC84\uC12F, \uC369\uC5B4\uAC00\uB294 \uB098\uBB47\uC78E, \uD638\uBC15. \uADF8\uB798, \uD655\uC2E4\uD788 \uAC00\uC744\uC774\uB124. \uC0AC\uB791\uC2A4\uB7FD\uC9C0 \uC54A\uC544?",
  "fall_2": "\uC6B0\uB9AC \uC62C\uAC00\uC744\uC5D0 \uD638\uBC15 \uAE30\uB974\uC790. \uAF2D \uAE38\uB7EC\uC918, \uC790\uAE30\uC57C.$h",
  "fall_20": "\uC790\uAE30\uC57C... \uB10C \uB098\uD55C\uD14C \uC11D\uC601 \uAC00\uB4DD\uD55C \uC0C1\uC790\uBCF4\uB2E4 \uAC00\uCE58\uAC00 \uCEE4.#$e#\uADFC\uB370, \uC790\uC218\uC815 \uAC00\uB4DD\uD55C \uC0C1\uC790\uB77C\uBA74? \uD760... \uADF8\uAC74 \uC598\uAE30\uAC00 \uB2EC\uB77C\uC9C0\uB294 \uAC78.$h",
  "winter_3": "\uB098 \uC0AC\uC2E4 \uCD94\uC6B4 \uB0A0\uC528\uAC00 \uC88B\uC544. \uC544\uB291\uD558\uAC8C \uC788\uC744 \uC774\uC720\uB97C \uC8FC\uAC70\uB4E0!$h",
  "winter_15": "\uACA8\uC6B8\uC5D0 \uACC4\uACE1\uC744 \uD0D0\uD5D8\uD558\uB294 \uAC74 \uC7AC\uBC0C\uC5B4! \uB208\uC73C\uB85C \uB36E\uC5EC\uC788\uC73C\uB2C8\uAE4C \uBAA8\uB4E0 \uAC8C \uB2EC\uB77C \uBCF4\uC5EC. \uB108\uBB34\uB098 \uC870\uC6A9\uD558\uACE0...",
  "spring_Abigail": "\uB0B4\uAC00 \uC544\uBB34\uB9AC \uCD94\uC6B4 \uACC4\uC808\uC774 \uC88B\uB2E4\uC9C0\uB9CC, \uADF8\uB798\uB3C4 \uACB0\uAD6D \uBD04\uC774 \uC624\uBA74 \uBC18\uAC11\uB354\uB77C.",
  "summer_Abigail": "\uC624... \uCD08\uCF5C\uB9BF \uCF00\uC774\uD06C \uC9C4\uC9DC \uBA39\uACE0 \uC2F6\uB2E4.",
  "fall_Abigail": "\uB108\uD55C\uD14C \uD638\uBC15 \uB0C4\uC0C8\uAC00 \uB098\uB294 \uAC70 \uAC19\uC544. \uADF8\uB0E5 \uB0B4\uAC00 \uAFC8\uAFB8\uACE0 \uC788\uB294 \uAC74\uAC00...$h",
  "winter_Abigail": "\uB0B4 \uBC29\uC5D0\uC11C \u0027\uB300\uCD08\uC6D0\uC758 \uC655\u0027 \uD558\uB358 \uB54C \uAE30\uC5B5\uB098? \uADF8 \uC2DC\uC808 \uC815\uB9D0 \uC7AC\uBC0C\uC5C8\uC5B4.$h",
  "spouseRoom_Abigail": "#$c .5#\uC870\uAE08 \uC77C\uCC0D \uC77C\uC5B4\uB098\uC11C \uB370\uC774\uBE44\uB4DC \uC8FC\uB2C8\uC5B4\uD55C\uD14C \uBC25 \uC92C\uC5B4. \uC624\uB298 \uC544\uCE68 \uB9CE\uC774 \uD65C\uBC1C\uD558\uB124.#$e#\uAE30\uB2C8\uD53C\uADF8 \uB0C4\uC0C8 \uB108\uBB34 \uC2E0\uACBD \uC4F0\uC9C0 \uB9D0\uACE0."
}