  "Mon8": "\uC774 \uB9C8\uC744\uC5D0 \uC815\uB9D0 \uC88B\uC740 \uC0AC\uB78C\uB4E4\uC774 \uD589\uBCF5\uC744 \uBABB \uCC3E\uB294 \uACBD\uC6B0\uAC00 \uC788\uC5B4. \uCC38 \uC2AC\uD508 \uC77C\uC774\uC57C.$u#$e#\uC220\uC9D1\uC5D0\uC11C \uC77C\uD558\uB2E4 \uBCF4\uB2C8, \uBAA8\uB4E0 \uC0AC\uB78C\uB4E4\uC758 \uBB38\uC81C\uB97C \uC9C1\uC811 \uB4E3\uAC8C \uB418\uB294 \uAC83 \uAC19\uC544.$u",
  "Tue": "\uAC70\uC2A4\uB124 \uC220\uC9D1\uC5D0\uC11C \uC544\uB974\uBC14\uC774\uD2B8\uB97C \uD558\uACE0 \uC788\uC5B4. \uADF8\uAC78\uB85C  \uC9C0\uBD88\uD558\uACE0 \uC788\uC9C0.",
  "Tue4": "\uAC70\uC2A4\uB124\uC11C \uC77C\uD574\uC11C \uBA39\uACE0\uC0B4\uAE34 \uD558\uC9C0\uB9CC... \uB0B4\uAC00 \uC9C4\uC9DC \uC5F4\uC815\uC744 \uAC00\uC9C0\uACE0 \uC788\uB294 \uC77C\uC740 \uC637\uC744 \uB9CC\uB4DC\uB294 \uC77C\uC774\uC57C.$u#$e#\uC774 \uC637\uB3C4 \uB2E4 \uB0B4\uAC00 \uC9C1\uC811 \uB9CC\uB4E0 \uAC70\uB2E4?",
  "Tue6": "\uC624, \uC548\uB155... \uC774\uB807\uAC8C \uBC29\uBB38\uD574\uC8FC\uB7EC \uC640\uC11C \uC88B\uB2E4.$h",
  "Tue8": "\uADF8\uAC70 \uC54C\uC544, @... \uB0B4 \uC0DD\uAC01\uC5D4 \uC6B0\uB9AC \uB458 \uB2E4 \uBBF8\uB798\uAC00 \uBC1D\uC544.",
  "Wed": "\uC774\uC81C\uB294 \uC78A\uD78C \uBB38\uBA85\uC774 \uC608\uC804\uC5D0 \uC81C\uC791\uD55C \uD76C\uADC0\uD558\uACE0 \uAC15\uB825\uD55C \uB9C8\uBC95 \uBC18\uC9C0\uC5D0 \uB300\uD55C \uC18C\uBB38\uC744 \uB4E4\uC740 \uC801 \uC788\uC5B4. \uB098\uB3C4 \uADF8\uAC8C \uC0AC\uC2E4\uC778\uC9C0 \uADF8\uC800 \uB3D9\uD654\uC778\uC9C0\uB294 \uC798 \uBAA8\uB974\uACA0\uC5B4.",
  "Wed4": "\uB09A\uC2DC\uD574? \uBD88\uC30D\uD55C \uAC83\uB4E4\uC744 \uC778\uB3C4\uC801\uC73C\uB85C \uB300\uD558\uB294 \uAC70\uC600\uC73C\uBA74 \uC88B\uACA0\uC5B4.$s#$e#\uBAA8\uB4E0 \uC0DD\uBB3C\uC740 \uC874\uC911\uD574\uC57C \uD574, \uBBF8\uB048\uBBF8\uB048\uD55C \uC0DD\uBB3C\uB4E4\uB3C4.",
  "Wed6": "\uBBFF\uC74C\uC744 \uAC00\uC838... \uB9E4\uC77C\uB9E4\uC77C \uC6B4\uBA85\uB41C \uAE38\uC744 \uB530\uB77C \uD55C \uAC78\uC74C\uC529 \uB354 \uAC00\uACE0 \uC788\uB294 \uAC70\uC57C.",
  "Wed8": "$query PLAYER_NPC_RELATIONSHIP current any married roommate#\uC548\uB155, @.#$e#\uB09C \uC6B0\uB9AC\uAC00 \uC88B\uC740 \uCE5C\uAD6C\uAC00 \uB420 \uAC70\uB780 \uAC78 \uC54C\uC558\uC5B4. \uBCC4\uB4E4\uC774 \uC54C\uB824\uC92C\uAC70\uB4E0!|\uC548\uB155, @.$u#$e#\uC6B0\uB9AC\uAC00 \uC774\uB807\uAC8C \uAC00\uAE4C\uC6CC\uC9C8 \uAC70\uB780 \uAC78 \uD56D\uC0C1 \uC54C\uC558\uC5B4...",
  "Thu": "\uC9C0\uC18D \uAC00\uB2A5\uD55C \uBC29\uC2DD\uC73C\uB85C \uB18D\uC0AC\uB97C \uC9D3\uACE0 \uC788\uAE38 \uBC14\uB77C. \uACC4\uACE1\uC758 \uC0DD\uD0DC\uACC4\uB294 \uC12C\uC138\uD574!#$e#\uC5B4\uB5BB\uAC8C \uC544\uB0D0\uACE0? \uC9C1\uAC10\uC801\uC73C\uB85C!",
  "Thu4": "\uAC00\uB054 \uAF43\uB4E4\uC774 \uB0B4\uAC8C \uB9D0\uC744 \uAC78\uC5B4... \uB2E4\uB4E4 \uAC01\uC790\uB9CC\uC758 \uC774\uC57C\uAE30\uAC00 \uC788\uC5B4!",
  "Fri": "\uC544, \uBD04. \uD30C\uC2A4\uD154 \uC0C9\uC758 \uACC4\uC808. \uB09C \uC0AC\uC2E4 \uBCF4\uC11D \uD1A4\uC774 \uB354 \uC88B\uC740\uB370.#$b#\uC624, \uBBF8\uC548! \uB0B4\uAC00 \uB610 \uD328\uC158 \uC598\uAE30 \uC911\uC5BC\uAC70\uB9AC\uACE0 \uC788\uC5C8\uC9C0?",
  "Sat": "\uB0B4 \uC637\uC744 \uB9CC\uB4DC\uB294 \uAC78 \uC88B\uC544\uD558\uC9C0\uB9CC, \uC637\uAC10\uC744 \uAD6C\uD558\uB294 \uAC8C \uC27D\uC9C0 \uC54A\uC544.#$e#\uB3C4\uC2DC\uAE4C\uC9C0 \uAC00\uB824\uBA74 \uB108\uBB34 \uBA3C \uAC70\uB9AC\uC57C.",
  "Sat6": "\uC9C1\uBB3C\uC758 \uCD09\uAC10\uC5D0 \uB300\uD574 \uC0DD\uAC01\uD574\uBCF8 \uC801 \uC788\uC5B4, @? \uCD09\uAC10\uB9C8\uB2E4 \uB69C\uB837\uD55C \uAC1C\uC131\uC774 \uC788\uC5B4... \uB0B4 \uB4DC\uB808\uC2A4 \uB9CC\uC838\uBD10... \uADF8\uCE58?",
  "Sun": "\uC548\uB155 @!#$e#\uC678\uC591\uAC04\uC5D0\uC11C \uC591 \uD0A4\uC6CC? \uC591\uD138\uB85C \uC815\uB9D0 \uC544\uB984\uB2E4\uC6B4 \uC637\uAC10\uC744 \uC9DC\uB0BC \uC218 \uC788\uC5B4!#$e#\uADFC\uB370 \uBCA0\uD2C0\uC774 \uD544\uC694\uD560 \uAC70\uC57C. \uC81C\uC791\uBC95\uB9CC \uC548\uB2E4\uBA74 \uC9C1\uC811 \uB9CC\uB4E4 \uC218\uB3C4 \uC788\uC5B4.",
  "Sun4": "\uBD80\uBAA8\uB2D8\uAED8\uC11C \uC774 \uC9D1\uC744 \uB0A8\uACA8\uC8FC\uC2DC\uACE0 \uAC00\uC168\uC5B4. \uC9C0\uB09C 2\uB144\uAC04 \uC138\uACC4 \uC77C\uC8FC \uC911\uC774\uC154.#$e#\uC5B8\uC81C \uB3CC\uC544\uC624\uC2E4\uC9C0\uB294 \uBAA8\uB974\uACA0\uC5B4.#$e#\uADF8\uB798\uB3C4, \uC5EC\uAE30\uC11C \uC9C0\uB0B4\uB294 \uAC74 \uC88B\uC544. \uACBD\uCE58\uB3C4 \uC544\uB984\uB2F5\uACE0 \uB9C8\uC744\uB3C4 \uBA4B\uC9C0\uACE0.",
  "event_dance1": "\uACE0\uB9C8\uC6CC!",
  "event_dance2": "\uC74C... \uADF8\uB798. \uB9C8\uC74C\uC5D0 \uC548 \uB4E4\uC5C8\uB2E4\uB2C8 \uC720\uAC10\uC774\uB124. 3\uB144 \uB3D9\uC548 \uC5F0\uC2B5\uD55C \uAC8C \uC644\uC804\uD788 \uC758\uBBF8\uAC00 \uC5C6\uC5C8\uAD6C\uB098...$s",
  "event_dance3": "\uC815\uB9D0 \uADF8\uB807\uAC8C \uC0DD\uAC01\uD574? \uB531 \uB0B4\uAC00 \uC6D0\uD558\uB358 \uB290\uB08C\uC774\uC57C!$h#$b#\uB9C8\uC74C\uC5D0 \uB4E0\uB2E4\uB2C8 \uB108\uBB34 \uAE30\uC058\uB2E4.",
  "summer_Mon": "\uD5E4\uC77C\uB9AC\uB294 \uC785\uB9DB\uC774 \uAE4C\uB2E4\uB85C\uC6CC. \uC694\uB9AC\uD574\uC8FC\uB294 \uAC8C \uB108\uBB34 \uD798\uB4E4\uC5B4.",
  "summer_Mon4": "\uB09C \uAC74\uAC15\uD55C \uC2DD\uB2E8\uC774 \uC544\uC8FC \uC911\uC694\uD558\uB2E4 \uC0DD\uAC01\uD574. \uC624\uB798\uB3C4\uB85D \uD65C\uB3D9\uC801\uC73C\uB85C \uC0B4\uACE0 \uC2F6\uC5B4.",
  "summer_Mon_inlaw_Haley": "\uD5E4\uC77C\uB9AC\uAC00 \uC774\uC0AC \uAC00\uACE0 \uB098\uC11C \uC0AC\uC774\uAC00 \uD6E8\uC52C \uC88B\uC544\uC84C\uC5B4. \uBC29\uBB38 \uC624\uB294 \uAC74 \uD658\uC601\uC774\uC57C!",
  "summer_Tue": "\uC548\uB155, @.#$e#\uC624\uB298\uC740 \uAC8C\uC73C\uB978 \uAE30\uBD84\uC774\uC57C.$u",
  "summer_Tue6": "\uB77C\uC774\uB108\uC2A4 \uB108\uBB34 \uC548\uB410\uC5B4. \uC0AC\uB78C\uB4E4\uC774 \uB9C8\uC74C\uB300\uB85C \uADF8\uB97C \uD3C9\uAC00\uD558\uB294\uB370, \uADF8\uB0E5 \uB2E4\uB978 \uB77C\uC774\uD504\uC2A4\uD0C0\uC77C\uC744 \uCD94\uAD6C\uD558\uB294 \uAC74\uB370.$u#$e#\uB2E4\uB4E4 \uC11C\uB85C\uB97C \uBC1B\uC544\uB4E4\uC77C \uC218 \uC788\uC73C\uBA74 \uC88B\uACA0\uC5B4.",
  "summer_Sun6": "\uC548\uB155, @! \uC6B0\uB9AC \uAD1C\uCC2E\uC740 \uCE5C\uAD6C\uAC00 \uB418\uC5C8\uC9C0, \uC548 \uADF8\uB798?$h#$e#\uB09C \uAD1C\uCC2E\uC544. \uB10C \uBA4B\uC9C4 \uC0AC\uB78C\uC774\uC57C.^\uAE30\uBED0.$h",
  "summer_Sun8": "\uC548\uB155, @! \uC6B0\uB9AC \uAD1C\uCC2E\uC740 \uCE5C\uAD6C\uAC00 \uB418\uC5C8\uC9C0, \uC548 \uADF8\uB798?$h#$e#\uC870\uAE08 \uC774\uC0C1\uD558\uAC8C \uB4E4\uB9B4 \uC218\uB3C4 \uC788\uACA0\uC9C0\uB9CC, \uC774\uB807\uAC8C \uB420 \uAC70\uB77C\uACE0 \uD56D\uC0C1 \uD655\uC2E0\uD588\uC5C8\uC5B4.",
  "summer_Wed": "\uC5EC\uB984\uC5D4 \uBE44\uAC00 \uB9CE\uC774 \uC548 \uB0B4\uB9AC\uB124?#$e#\uBB3C\uC744 \uB354 \uC790\uC8FC \uC918\uC57C \uD574\uC11C \uB124\uAC00 \uC77C\uC774 \uB9CE\uC544\uC9C0\uACA0\uB2E4.#$e#\uC544\uB2C8\uBA74 \uADF8\uB0E5 \uD654\uCC3D\uD55C \uB0A0\uC528\uB97C \uC990\uAE30\uB294 \uD3B8\uC774\uC57C?",
  "summer_Thu": "\uB09C \uBC8C\uACFC \uB098\uBE44\uAC00 \uB0B4 \uD2B9\uBCC4\uD55C \uCE5C\uAD6C\uB77C\uACE0 \uC0DD\uAC01\uD574!",
  "summer_Fri": "\uB0B4\uAC00 \uBC14\uC058\uC9C0\uB9CC \uC54A\uC558\uB354\uB77C\uBA74 \uB18D\uC7A5 \uC77C\uB3C4 \uB3C4\uC640\uC92C\uC744 \uD150\uB370!#$e#\uD558\uC9C0\uB9CC \uB0B4\uAC00 \uC77C\uC744 \uB354 \uB9E1\uC73C\uBA74 \uAC70\uC2A4\uAC00 \uC18D\uC0C1\uD574\uD560 \uAC70\uC57C...$s",
  "summer_Fri6": "\uADF8\uAC70 \uC54C\uC544, \uB0B4\uAC00 \uC5B4\uB290 \uB0A0 \uC220\uC9D1\uC744 \uB5A0\uB098\uACA0\uB2E4\uACE0 \uC598\uAE30\uD558\uBA74 \uAC70\uC2A4\uB3C4 \uC774\uD574\uD574\uC904 \uAC70\uC57C.#$b#\uC138\uC0C1\uC5D0\uB294 \uB108\uBB34\uB098 \uB2E4\uC591\uD55C \uAC83\uB4E4\uC774 \uC788\uC5B4\uC11C, \uC5B8\uC81C\uAE4C\uC9C0\uACE0 \uBC14\uD150\uB354\uB85C \uC9C0\uB0BC \uC21C \uC5C6\uC5B4.$u",
  "summer_Sat": "\uB108\uBB34 \uBB34\uB9AC\uD558\uC9C0 \uB9C8, \uADF8\uB7EC\uB2E4\uAC00 \uD558\uBE44\uB124 \uBCD1\uC6D0\uC5D0 \uC785\uC6D0\uD558\uB294 \uC218\uAC00 \uC788\uC5B4!",
  "summer_Sun": "\uC548\uB155 @!",
  "summer_Sun4": "\uC77C \uB144 \uC911 \uC774\uB9D8\uB54C \uB0B4 \uCE5C\uD55C \uCE5C\uAD6C\uB4E4\uC774 \uBC29\uBB38\uD558\uB7EC \uC640... \uBC14\uB85C \uC575\uBB34\uC0C8\uB4E4\uC774 \uC624\uB294 \uC2DC\uAE30\uC9C0!",
  "fall_1": "\uADF8\uB798, \uAC00\uC744\uC774 \uC654\uB124. \uC0C8\uB85C\uC6B4 \uC791\uBB3C\uC744 \uC2EC\uC744 \uC2DC\uAE30\uACA0\uB2E4, \uADF8\uCE58?",
  "fall_15": "$d bus#\uC624\uB298\uC740 \uC0CC\uB514 \uBCF4\uB7EC \uAC00\uB824\uACE0. \uC6B0\uB9B0 \uC808\uCE5C\uC774\uC57C!#$e#\uBC84\uC2A4\uAC00 \uC218\uB9AC\uB418\uC5B4\uC11C \uB108\uBB34 \uAE30\uBED0.|*\uD734*... \uBC84\uC2A4\uB9CC \uACE0\uC7A5 \uB098\uC9C0 \uC54A\uC558\uB2E4\uBA74 \uC624\uB298 \uC0CC\uB514\uB97C \uBCF4\uB7EC \uAC08 \uC218 \uC788\uC5C8\uC744 \uD150\uB370...$s",
  "fall_Mon": "\uC18C\uD48D \uAC00\uAE30 \uC88B\uC740 \uB0A0\uC528\uC9C0, \uC548 \uADF8\uB798?",
  "fall_Mon8": "\uB0B4\uAC00 \uC624\uB298 \uC77C\uD558\uB294 \uB0A0\uC774 \uC544\uB2C8\uC5C8\uB2E4\uBA74 \uC18C\uD48D \uAC00\uC790\uACE0 \uD588\uC744 \uD150\uB370!",
  "fall_Tue": "\uC548\uB155. \uC5EC\uB984\uC740 \uC798 \uBCF4\uB0C8\uC5B4?",
  "fall_Tue4": "\uC548\uB155 @! \uC9C0\uB09C\uC5EC\uB984 \uB3D9\uC548 \uB18D\uC7A5 \uC77C \uC815\uB9D0 \uC798 \uD480\uB838\uC744 \uAC70\uB77C \uC0DD\uAC01\uD574!#$e#\uB10C \uD6CC\uB96D\uD55C \uB18D\uBD80\uB2C8\uAE4C$h",
  "fall_Wed": "\uCE5C\uAD6C\uAC00 \uC0AC\uB9C9\uC5D0\uC11C \uAC00\uAC8C\uB97C \uD574. \uD639\uC2DC \uBC29\uBB38\uD558\uAC8C \uB418\uBA74 \uB0B4\uAC00 \uC548\uBD80 \uC804\uD55C\uB2E4\uACE0 \uC598\uAE30\uD574\uC918.#$e#\uC880 \uD76C\uADC0\uD55C \uBB3C\uD488\uC744 \uD30C\uB294 \uAC83 \uAC19\uB354\uB77C.",
  "fall_Thu": "\uD074\uB9B0\uD2B8\uB791 \uCE5C\uAD6C\uC57C? \uCE5C\uD574\uC838\uBCF4\uBA74 \uCC38 \uCC29\uD55C \uC0AC\uB78C\uC774\uC57C.#$e#\uD558\uB8E8 \uC885\uC77C \uD63C\uC790 \uC77C\uD574\uC11C \uC678\uB86D\uB098 \uBD10. \uADF8\uB7F0\uB370 \uC218\uC90D\uC74C\uB3C4 \uB9CE\uC544\uC11C \uC0C8 \uCE5C\uAD6C\uB97C \uC0AC\uADC0\uB294 \uC77C\uB3C4 \uC5B4\uB824\uC6B4\uAC00 \uBD10.",
  "fall_Thu8": "\uD074\uB9B0\uD2B8\uAC00 \uB098\uD55C\uD14C \uD654\uB09C \uAC70 \uAC19\uC544. \uC694\uC998 \uC2DC\uC120\uC744 \uD53C\uD558\uB294 \uB290\uB08C\uC774 \uB4E4\uC5B4...$u#$e#\uCE5C\uAD6C\uB77C\uACE0 \uC0DD\uAC01\uD588\uB294\uB370.$u",
  "fall_Fri": "\uC544\uB984\uB2E4\uC6B4 \uAC00\uC744 \uB0A0\uC774\uB124.#$e#\uACE7 \uB05D\uB0A0 \uAC70\uB77C\uB2C8, \uC560\uC11D\uD55C \uC77C\uC774\uC57C.",
  "fall_Fri6": "\uAE68\uB057\uD55C \uACF5\uAE30 \uB0C4\uC0C8 \uB9E1\uC544\uBD10. \uC0AC\uB791\uC2A4\uB7FD\uC9C0, \uADF8\uCE58?#$b#\uC138\uC0C1\uC758 \uC870\uC790 \uAE30\uC5C5 \uAC19\uC740 \uD68C\uC0AC\uB4E4\uC774 \uC774\uB7EC \uAC78 \uC557\uC544\uAC08\uAE4C \uBD10 \uB450\uB824\uC6CC.$u",
  "fall_Sat": "\uC5F4\uB9B0 \uB9C8\uC74C\uC73C\uB85C \uC9C0\uB0B4\uBA74 \uD765\uBBF8\uB85C\uC6B4 \uAC83\uB4E4\uC744 \uBC1C\uACAC\uD560 \uC218\uB3C4 \uC788\uC5B4.#$e#\uC5EC\uD558\uD2BC, \uC624\uB298 \uD558\uB8E8 \uC798 \uBCF4\uB0B4\uACE0 \uC788\uC5B4?",
  "fall_Sat6": "\uC778\uC0DD\uC5D0 \uD070 \uACC4\uD68D\uC740 \uC5C6\uC5B4. \uBBF8\uB798\uC5D0 \uB300\uD55C \uAC71\uC815 \uB54C\uBB38\uC5D0 \uC2A4\uD2B8\uB808\uC2A4\uBC1B\uACE0 \uC2F6\uC9C4 \uC54A\uC544.",
  "fall_Sun": "\uD654\uCC3D\uD55C \uC77C\uC694\uC77C\uB9CC\uD07C \uAE30\uC6B4 \uB098\uAC8C \uD558\uB294 \uAC83\uB3C4 \uC5C6\uC9C0!",
  "fall_Sun6": "\uC6B0\uB9AC\uB97C \uB9C9\uC544\uC11C\uB294 \uD22C\uBA85\uD55C \uBCBD\uC774 \uB108\uBB34 \uB9CE\uC544. \uC65C \uC0AC\uB78C\uB4E4\uC740 \uC880 \uB0B4\uB824\uB193\uACE0 \uC790\uC720\uB97C \uB9CC\uB07D\uD558\uC9C0 \uBABB\uD558\uB294 \uAC78\uAE4C?#$e#\uB098? \uC65C, \uADF8\uB7F0 \uC61B\uB9D0 \uC788\uC796\uC544... \u0027\uC57C\uC0DD \uC8FC\uB2C8\uBAA8\uB97C \uC6B0\uB9AC\uC5D0 \uAC00\uB458 \uC21C \uC5C6\uB2E4\u0027.",
  "fall_Sun10": "\uB10C \uC815\uB9D0 \uC88B\uC740 \uC0AC\uB78C\uC774\uC57C, @! \uCE5C\uAD6C\uAC00 \uB418\uC5B4\uC918\uC11C \uACE0\uB9C8\uC6CC.$h",
  "winter_Mon": "\uBA38\uB9AC\uC5D0 \uACE0\uB4DC\uB984 \uB5A8\uC5B4\uC9C0\uC9C0 \uC54A\uAC8C \uC870\uC2EC\uD574!",
  "winter_Mon10": "\uBA38\uB9AC\uC5D0 \uACE0\uB4DC\uB984 \uB5A8\uC5B4\uC9C0\uC9C0 \uC54A\uAC8C \uC870\uC2EC\uD574! \uB124\uAC00 \uB2E4\uCE58\uC9C0 \uC54A\uC558\uC73C\uBA74 \uC88B\uACA0\uC5B4!",
  "winter_Tue": "\uC624, \uC548\uB155 @!$h#$e#\uC774\uC81C \uB18D\uC7A5 \uC77C\uC740 \uC815\uB9D0 \uB9CE\uC774 \uC775\uC219\uD574\uC84C\uACA0\uB2E4, \uADF8\uCE58?",
  "winter_Tue2": "\uC9C0\uAE08\uAE4C\uC9C0 \uD574\uC628 \uAC8C \uB9CE\uC544\uC11C \uB10C \uC815\uB9D0 \uB6F0\uC5B4\uB09C \uB18D\uBD80\uC77C \uAC70\uC57C!",
  "winter_Tue4": "\uBA38\uB9AC\uCE74\uB77D\uC774 \uC5BC\uC5B4\uBC84\uB9B0 \uAC70 \uAC19\uC544...$s",
  "winter_Wed": "\uD5E4\uC77C\uB9AC\uB791 \uB098\uB791 \uB458\uC774 \uC774\uB807\uAC8C \uD070 \uC9D1\uC5D0\uC11C \uC9C0\uB0BC \uAC74 \uC5C6\uC5C8\uB294\uB370. \uCCAD\uC18C\uD558\uB294\uB370 \uB9CE\uC774 \uBC88\uAC70\uB85C\uC6CC.#$e#\uC5B4\uCA4C\uACA0\uC5B4. \uC0AC\uC2E4 \uBD88\uD3C9\uD560 \uC0C1\uD669\uC740 \uC544\uB2C8\uC9C0.#$e#\uB124 \uB18D\uAC00\uB3C4 \uC815\uB9D0 \uC544\uB291\uD558\uACE0 \uAD1C\uCC2E\uC544 \uBCF4\uC774\uB354\uB77C.$h",
  "winter_Thu": "\uBD88\uC30D\uD55C \uBB3C\uACE0\uAE30\uB4E4, \uC5BC\uB9C8\uB098 \uCD94\uC6B8\uAE4C.$s#$e#\uBB3C\uACE0\uAE30\uB3C4 \uB3D9\uBA74\uD558\uB098? \uB4DC\uBBF8\uD2B8\uB9AC\uC6B0\uC2A4\uD55C\uD14C \uBB3C\uC5B4\uBD10\uC57C\uACA0\uB2E4.",
  "winter_Fri": "\uB0B4\uAC00 \uBC14\uC058\uC9C0 \uC54A\uC558\uB2E4\uBA74 \uD638\uC218 \uC606\uC5D0 \uC788\uB294 \uADF8 \uB3D9\uAD74 \uC548\uC744 \uD0D0\uD5D8\uD558\uB294 \uAC78 \uB3C4\uC640\uC92C\uC744 \uD150\uB370.#$e#\uADF8 \uC548\uC5D0 \uBD84\uBA85 \uAC15\uB825\uD55C \uD798\uC774 \uAE43\uB4E0 \uC218\uC815\uC774 \uC788\uC744 \uAC70\uC57C.",
  "winter_Sat": "\uD639\uC2DC \u0027\uCF69 \uC2A4\uD29C\u0027 \uC694\uB9AC\uD560 \uC904 \uC54C\uC544?#$e#\uB098 \uADF8 \uC694\uB9AC \uC0C1\uB2F9\uD788 \uC88B\uC544\uD574.$h%revealtaste:Emily:207#$e#\uACA8\uC6B8\uC5D0 \uC2E0\uC120\uD55C \uC7AC\uB8CC\uB97C \uAD6C\uD558\uB294 \uAC8C \uAD00\uAC74\uC774\uC57C \uADFC\uB370, \uADF8\uCE58?",
  "winter_Sun": "\uC548\uB155!#$e#...\uC751?",
  "winter_Sun6": "\uC5EC\uB3D9\uC0DD\uC774\uB791 \uB098\uB791 \uAC00\uB054 \uC2F8\uC6B0\uAE34 \uD558\uC9C0\uB9CC, \uB9CC\uC57D \uB5A0\uB09C\uB2E4\uBA74 \uB9CE\uC774 \uBCF4\uACE0 \uC2F6\uC744 \uAC70\uC57C.#$e#\uC5B8\uC820\uAC00 \uC544\uC8FC \uC88B\uC740 \uC5B4\uB978\uC774 \uB420 \uAC70\uB77C \uC0DD\uAC01\uD558\uAE34 \uD574... \uB0B4\uAC00 \uC774\uB7F0 \uC598\uAE30 \uD588\uB2E4\uACE0 \uD558\uC9C4 \uB9D0\uACE0.$h#$e#\uADF8\uB7FC, \uD558\uACE0 \uC2F6\uC740 \uB2E4\uB978 \uC598\uAE30 \uC788\uC5B4?",
  "winter_Sun6_inlaw_Haley": "\uC5EC\uB3D9\uC0DD\uD55C\uD14C \uC548\uBD80 \uC804\uD574\uC918! \uADF8\uB9AC\uACE0 \uB0B4\uC77C \uCC3E\uC544\uC624\uB77C\uACE0 \uB9D0\uB3C4 \uC880 \uD574\uC918."
