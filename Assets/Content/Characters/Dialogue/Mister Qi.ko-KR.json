{
  "Mon": "\uC798\uD558\uACE0 \uC788\uC5B4, \uAF2C\uB9C8\uC57C. \uB0B4 \uC0DD\uAC01\uC5D4 \uB10C \uC5B8\uC820\uAC00 \uC2A4\uD0C0\uAC00 \uB420 \uAC70\uC57C.#$e#\uD544\uC694\uD55C \uAC8C \uC788\uC73C\uBA74 \uC5B8\uC81C\uB4E0 \uB098\uD55C\uD14C \uBB3C\uC5B4\uBD10.",
  "Tue": "\uB124\uAC00 \uC5B8\uC820\uAC04 \uC5EC\uAE30 \uC62C \uAC70\uB780 \uAC78 \uC54C\uACE0 \uC788\uC5C8\uC5B4. \uBB3C\uB860, \uB0B4\uAC00 \uC880 \uC5B4\uB835\uAC8C \uB9CC\uB4E4\uC5B4\uC57C \uC5C4\uCCAD\uB09C \uAC78 \uC774\uB8E8\uACE0 \uC2F6\uC740 \uB3D9\uAE30\uBD80\uC5EC\uAC00 \uB418\uC5C8\uACA0\uC9C0.",
  "Wed": "\uB09C \uD3C9\uBC94\uD55C \uC544\uC774\uB85C \uD0DC\uC5B4\uB0AC\uC9C0\uB9CC, \uC77C\uCC0D\uC774 \uBE44\uBC94\uD55C \uC0AC\uB78C\uC774 \uB418\uACA0\uB2E4\uACE0 \uACB0\uC815\uD588\uC9C0.",
  "Thu": "\uC57C. \uC544\uBB34\uD55C\uD14C\uB3C4 \uC774\uACF3\uC5D0 \uB300\uD574 \uC598\uAE30\uD558\uC9C0 \uB9C8, \uC54C\uC558\uC9C0? \uC5EC\uAE38... \uD2B9\uBCC4\uD55C \uACF3\uC73C\uB85C \uB0A8\uACA8\uB450\uACE0 \uC2F6\uC5B4.#$e#\uB124 \uCE5C\uAD6C \uBBF8\uC2A4\uD130 \uCE58\uB97C \uC704\uD574 \uBE44\uBC00 \uD558\uB098\uB294 \uC9C0\uCF1C\uC904 \uC218 \uC788\uC9C0, \uC548 \uADF8\uB798?",
  "Fri": "\uC644\uBCBD\uD568\uC744 \uC774\uB8E8\uB824\uBA74 \uBA48\uCD94\uC9C0 \uC54A\uACE0 \uBD84\uD22C\uD574\uC57C \uD574.#$e#\uB124\uAC00 \uD558\uB294 \uBAA8\uB4E0 \uC77C\uC744 \uCD5C\uACE0\uC758 \uC218\uC900\uC73C\uB85C\uB9CC \uD558\uACA0\uB2E4\uACE0 \uB2E4\uC9D0\uD574\uC57C \uD574.",
  "Sat": "\uC26C\uACE0 \uC2F6\uC744 \uB550 \uC5B8\uC81C\uB4E0\uC9C0 \uBC29\uBB38\uD574.",
  "Sun": "\uACC4\uC18D \uC5F4\uC2EC\uD788 \uB178\uB825\uD558\uBA74 \uC5B8\uC820\uAC04 \uB098\uCC98\uB7FC \uB420 \uC218 \uC788\uC744\uC9C0\uB3C4 \uBAB0\uB77C.",
  "married": "\uC0C1\uC11C\uB85C\uC6B4 \uACB0\uD63C\uC2DD\uC774\uC5C8\uC5B4, @.#$b#...\uBB50\uB77C\uACE0? \uAC70\uAE30\uC11C \uB09C \uBABB \uBD24\uB2E4\uACE0?#$b#\uD558\uD558\uD558... \uAF2C\uB9C8\uC57C... \uBBF8\uC2A4\uD130 \uCE58\uAC00 \uBAA8\uB974\uB294 \uBE44\uBC00\uC740 \uC5C6\uC5B4.",
  "QiNutRoom_Mon": "\uC774 \uC138\uC0C1\uC740 \uBCF4\uAE30\uC640 \uB2E4\uB978 \uBD80\uBD84\uB4E4\uC774 \uB9CE\uC544, \uAF2C\uB9C8\uC57C. \uC5B8\uC820\uAC04 \uB0B4 \uB9D0\uC744 \uC774\uD574\uD558\uAC8C \uB420 \uAC70\uC57C.#$b#\uC77C\uB2E8 \uC9C0\uAE08\uC740 \uB124\uAC00 \uD558\uB294 \uBAA8\uB4E0 \uC77C\uC744 \uCD5C\uACE0\uB85C \uD574\uB0B4\uB824\uACE0 \uB178\uB825\uD574\uC57C \uD574.",
  "QiNutRoom_Tue": "\uB09C \uC758\uC9C0\uB825 \uD558\uB098\uB85C \uC5EC\uAE30\uAE4C\uC9C0 \uC654\uC5B4, \uAF2C\uB9C8\uC57C.#$b#\uC788\uC9C0... \uB9C8\uC74C\uC774\uB780 \uC815\uB9D0 \uAC15\uB825\uD55C \uB3C4\uAD6C\uC57C.#$b#\uC0AC\uC2E4, \uAC00\uC7A5 \uAC15\uB825\uD55C \uB3C4\uAD6C\uC774\uC9C0... \uD604\uC2E4\uC5D0\uC11C, \uADF8\uB9AC\uACE0 \uADF8 \uB108\uBA38\uC5D0\uC11C\uB3C4.",
  "QiNutRoom_Wed": "\uB124 \uB048\uAE30\uAC00 \uCC38 \uC778\uC0C1 \uAE4A\uC5B4, \uAF2C\uB9C8\uC57C... \uC5EC\uAE30\uAE4C\uC9C0 \uC624\uB294\uB370 \uD638\uB450\uAC00 \uB9CE\uC774 \uB4E4\uC5C8\uC744 \uD150\uB370.",
  "QiNutRoom_Thu": "\uADF8 \uC5B4\uB514\uB97C \uAC00\uB4E0... \uD56D\uC0C1 \uB0B4 \uC601\uD5A5\uC774 \uB2FF\uC9C0, \uD765\uBBF8\uC9C4\uC9C4\uD55C \uC1FC\uB97C \uB9CC\uB4E4\uC5B4\uC8FC\uACE0 \uC788\uC5B4. \uD558\uD558\uD558...#$b#\uACFC\uC5F0... \uADF8\uB7F4\uAE4C?",
  "QiNutRoom_Fri": "\uAC00\uC7A5 \uBA3C \uBCC4\uC744 \uBC14\uB77C\uBCF4\uACE0, \uAC70\uAE30\uB97C \uBAA9\uD45C\uB85C \uC0BC\uC544.#$b#\uB124\uAC00 \uC0DD\uAC01\uD55C \uD55C\uACC4\uBCF4\uB2E4 \uD55C\uAC78\uC74C \uB354 \uB098\uC544\uAC08 \uD798\uC774 \uD56D\uC0C1 \uC788\uC9C0.",
  "QiNutRoom_Sat": "\uC2DC\uAC04\uACFC \uACF5\uAC04\uC744 \uCD08\uC6D4\uD558\uB294 \uAC83\uB4E4\uB3C4 \uC788\uC5B4, \uAF2C\uB9C8\uC57C. \uB9C8\uC74C\uC18D\uC5D0 \uD2B9\uC720\uC758 \uAE30\uBD84\uC774 \uB4E4\uC9C0... \uC800 \uB108\uBA38\uC5D0\uC11C \uB4E4\uB824\uC624\uB294 \uC18D\uC0AD\uC784.",
  "QiNutRoom_Sun": "\uC67C\uCABD\uC5D0\uB294 \uB0B4 \uD2B9\uBCC4\uD55C \uB3C4\uC804\uB4E4\uC774 \uC801\uD78C \uAC8C\uC2DC\uD310\uC774 \uC788\uC9C0... \uB108\uB97C \uC704\uD574 \uB9DE\uCDA4 \uC81C\uC791\uB418\uC5C8\uC5B4, \uAF2C\uB9C8\uC57C.#$b#\uC624\uB978\uCABD\uC5D0\uB294 \uB0B4 \uB3C4\uC804\uC744 \uC131\uACF5\uD55C \uC790\uB4E4\uC744 \uC704\uD55C \uD658\uC0C1\uC801\uC778 \uBCF4\uC0C1\uB4E4\uC774 \uC788\uACE0...#$b#\uD589\uC6B4\uC744 \uBE48\uB2E4, \uAF2C\uB9C8\uC57C."
